---
// src/components/inbound/InboundWhyUs.astro
const commitments = [
  {
    icon: "🛡️",
    title: "100% Private & Tailor-Made",
    desc: "No rigid tour bus crowds. You travel at your own comfortable rhythm with private air-conditioned vehicles, dedicated chauffeurs, and licensed local experts."
  },
  {
    icon: "🚫",
    title: "Zero Forced Shopping Guarantee",
    desc: "We strictly forbid commercial tourist commission traps, jade factories, or latex stores. Your valuable holiday time belongs entirely to genuine discovery."
  },
  {
    icon: "📞",
    title: "24/7 Dedicated Concierge",
    desc: "Direct WhatsApp communication with your personal travel architect throughout your journey in Vietnam for real-time adjustments and peace of mind."
  },
  {
    icon: "🌱",
    title: "Responsible & Sustainable Tourism",
    desc: "We directly employ ethnic minority guides, fund rural community schools, partner with eco-lodges, and adhere to leave-no-trace travel principles."
  }
];
---

<section class="py-20 lg:py-28 bg-brand-50 text-gray-900 relative overflow-hidden">
  <!-- Subtle Glow Background -->
  <div class="absolute top-0 right-1/4 w-96 h-96 bg-brand-200/40 rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute bottom-0 left-1/4 w-96 h-96 bg-white/60 rounded-full blur-3xl pointer-events-none"></div>

  <div class="max-w-[1440px] mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-white text-brand-700 border border-brand-200 text-xs font-bold uppercase tracking-widest mb-3 shadow-sm">
        The Rice Tour Distinction
      </div>
      <h2 class="font-serif text-3xl sm:text-4xl md:text-5xl font-bold tracking-tight text-gray-900">
        Why Discerning Travelers Choose Us
      </h2>
      <p class="text-gray-600 text-base sm:text-lg mt-3 font-light leading-relaxed">
        We bridge the gap between world-class boutique luxury and authentic Vietnamese hospitality.
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {commitments.map((c) => (
        <div class="bg-white border border-gray-100 rounded-3xl p-8 hover:border-brand-200 hover:shadow-xl transition-all duration-300 flex flex-col justify-between group shadow-sm">
          <div>
            <div class="text-3xl mb-6 p-4 rounded-2xl bg-brand-50 w-fit border border-brand-100 group-hover:scale-110 transition-transform shadow-sm">
              {c.icon}
            </div>
            <h3 class="font-serif text-xl font-bold text-gray-900 mb-3 group-hover:text-brand-600 transition-colors leading-snug">
              {c.title}
            </h3>
            <p class="text-sm text-gray-600 leading-relaxed font-normal">
              {c.desc}
            </p>
          </div>
          
          <div class="pt-6 mt-6 border-t border-gray-100 flex items-center gap-2 text-xs font-bold text-brand-600">
            <span>Verified Standard</span>
            <span class="text-green-500">✓</span>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
