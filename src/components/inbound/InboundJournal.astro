---
// src/components/inbound/InboundJournal.astro
import { env } from 'cloudflare:workers';

const canonicalArticles = [
  {
    title: "Vietnam Visa Guide 2026: 90-Day E-Visa, Exemptions & Entry Rules",
    slug: "vietnam-visa-guide-2026",
    category_name: "Visa & Essentials",
    readingTime: 5,
    featuredImage: "https://media.thericetour.com/uploads/girls-taking-selfie-waving-on-rowing-boat-mekong-canal.webp",
    excerpt: "Everything international travelers need to know about the 90-day Vietnam multiple-entry e-visa, visa-free countries, and international airport arrival tips."
  },
  {
    title: "Best Time to Visit Southern Vietnam: Cu Chi, Saigon & Mekong Waterways",
    slug: "best-time-to-visit-vietnam",
    category_name: "Travel Planning",
    readingTime: 6,
    featuredImage: "https://media.thericetour.com/uploads/seven-story-pagoda-tower-vinh-trang-temple-my-tho.webp",
    excerpt: "Understanding the dry and floating water seasons in the Mekong Delta. When to capture serene reflections and explore fruit orchards at their peak."
  },
  {
    title: "Southern Vietnamese Gastronomy: Crispy Banh Xeo, Fresh Spring Rolls & Elephant Ear Fish",
    slug: "hanoi-street-food-culture",
    category_name: "Gastronomy",
    readingTime: 6,
    featuredImage: "https://media.thericetour.com/uploads/man-making-rice-paper-steam-traditional-village-mekong.webp",
    excerpt: "Dine with authentic flavor. A deep dive into Southern herbs, traditional rice paper steaming, crispy savory pancakes, and Mekong river specialties."
  },
  {
    title: "Cu Chi Tunnels Historical Guide: Ben Dinh vs Ben Duoc Complete Walkthrough",
    slug: "cu-chi-tunnels-ben-dinh-ben-duoc",
    category_name: "Culture & Heritage",
    readingTime: 7,
    featuredImage: "https://media.thericetour.com/uploads/group-posing-secret-tunnel-entrance-leaves-cu-chi-1280x720.webp",
    excerpt: "An insider exploration comparing the guerrilla tunnel systems of Ben Dinh and Ben Duoc, war relics, and visiting logistics from Saigon."
  }
];

let articles: any[] = [];

try {
  const d1Db = env?.dulichcoguu_d1;
  if (d1Db) {
    const { results } = await d1Db.prepare(`
      SELECT p.id, p.slug, p.title, p.featuredImage, p.excerpt, p.readingTime, p.createdAt, c.name as category_name
      FROM Post p
      LEFT JOIN BlogCategory c ON p.categoryId = c.id
      WHERE p.status = 'published' AND (p.type = 'blog' OR p.type IS NULL)
      ORDER BY p.createdAt DESC
      LIMIT 8
    `).all<any>();

    if (results && results.length > 0) {
      articles = results;
    }
  }
} catch (e) {
  console.error("Error fetching latest blog articles for Journal:", e);
}

if (!articles || articles.length === 0) {
  articles = canonicalArticles;
}
---

<section class="py-20 lg:py-28 bg-white" id="travel-journal">
  <div class="max-w-[1440px] mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 gap-6">
      <div class="max-w-2xl">
        <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-brand-50 text-brand-700 border border-brand-200 text-xs font-bold uppercase tracking-widest mb-3 shadow-sm">
          Vietnam Travel Journal
        </div>
        <h2 class="font-serif text-3xl sm:text-4xl md:text-5xl font-bold text-gray-900 tracking-tight leading-tight">
          Insider Guides &amp; Inspiration
        </h2>
        <p class="text-gray-600 text-base sm:text-lg mt-3 font-light leading-relaxed">
          Expert practical advice, cultural nuances, and travel planning essentials penned by our in-house destination architects.
        </p>
      </div>

      <div class="flex items-center gap-3">
        <a href="/blog" class="inline-flex items-center gap-2 px-5 py-3 rounded-2xl bg-brand-50 hover:bg-brand-600 hover:text-white text-brand-700 font-bold text-xs uppercase tracking-wider transition-all duration-300 shadow-sm transform hover:-translate-y-0.5">
          <span>Read All Guides</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
        </a>

        <!-- Slider Nav Arrows -->
        <div class="flex items-center gap-2">
          <button 
            id="journal-slide-prev"
            aria-label="Previous articles"
            class="w-11 h-11 rounded-2xl border border-gray-200 bg-white hover:bg-brand-50 hover:border-brand-300 text-gray-700 hover:text-brand-600 flex items-center justify-center transition-all shadow-sm active:scale-95 cursor-pointer"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7"/></svg>
          </button>
          <button 
            id="journal-slide-next"
            aria-label="Next articles"
            class="w-11 h-11 rounded-2xl border border-gray-200 bg-white hover:bg-brand-50 hover:border-brand-300 text-gray-700 hover:text-brand-600 flex items-center justify-center transition-all shadow-sm active:scale-95 cursor-pointer"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"/></svg>
          </button>
        </div>
      </div>
    </div>

    <!-- Mobile Swipe Indicator -->
    <div class="flex sm:hidden items-center justify-between text-xs text-gray-500 font-medium -mt-6 mb-4 px-1">
      <span class="inline-flex items-center gap-1.5 text-brand-600 font-bold text-[11px] uppercase tracking-wider">
        <span>👈</span> Swipe guides
      </span>
      <span class="text-[11px] text-gray-400 font-semibold">{articles.length} Articles</span>
    </div>

    <!-- Articles Horizontal Carousel Track -->
    <div 
      id="journal-carousel-track"
      class="flex overflow-x-auto snap-x snap-mandatory gap-5 pb-6 pt-1 -mx-4 px-4 sm:-mx-6 sm:px-6 lg:-mx-8 lg:px-8 hide-scrollbar scroll-smooth select-none cursor-grab active:cursor-grabbing"
    >
      {articles.map((a: any) => (
        <article class="w-[82vw] max-w-[340px] sm:w-[340px] md:w-[360px] lg:w-[380px] shrink-0 snap-start group bg-gray-50 rounded-3xl overflow-hidden border border-gray-200 shadow-sm hover:shadow-xl hover:border-brand-200 transition-all duration-300 flex flex-col justify-between">
          <div>
            <div class="relative aspect-[16/10] overflow-hidden bg-gray-100">
              <img 
                src={a.featuredImage || "https://media.thericetour.com/uploads/girls-taking-selfie-waving-on-rowing-boat-mekong-canal.webp"} 
                alt={a.title} 
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 ease-out"
                loading="lazy"
              />
              <span class="absolute top-4 left-4 px-3 py-1 bg-white/95 backdrop-blur-md text-brand-600 text-[10.5px] font-extrabold rounded-full border border-gray-100 shadow-sm uppercase tracking-wider">
                {a.category_name || "Travel Guide"}
              </span>
            </div>

            <div class="p-6">
              <div class="flex items-center gap-2 text-gray-400 text-xs font-semibold mb-2">
                <span>⏱️ {a.readingTime ? `${a.readingTime} min read` : '5 min read'}</span>
              </div>

              <h3 class="font-serif text-lg sm:text-xl font-bold text-gray-900 group-hover:text-brand-600 transition-colors leading-snug mb-3 line-clamp-2">
                <a href={`/${a.slug}`}>
                  {a.title}
                </a>
              </h3>

              {a.excerpt && (
                <p class="text-xs sm:text-sm text-gray-600 line-clamp-3 leading-relaxed">
                  {a.excerpt}
                </p>
              )}
            </div>
          </div>

          <div class="p-6 pt-0">
            <a 
              href={`/${a.slug}`} 
              class="inline-flex items-center gap-1.5 text-xs font-bold text-gray-900 group-hover:text-brand-600 transition-colors uppercase tracking-wider"
            >
              <span>Read Full Guide</span>
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
            </a>
          </div>
        </article>
      ))}
    </div>

  </div>
</section>

<script is:inline>
  (function() {
    const track = document.getElementById('journal-carousel-track');
    const prevBtn = document.getElementById('journal-slide-prev');
    const nextBtn = document.getElementById('journal-slide-next');

    if (!track) return;

    const getScrollStep = () => {
      const card = track.querySelector('article');
      return card ? (card.offsetWidth + 20) * 1.5 : 400;
    };

    if (prevBtn) {
      prevBtn.addEventListener('click', () => {
        track.scrollBy({ left: -getScrollStep(), behavior: 'smooth' });
      });
    }

    if (nextBtn) {
      nextBtn.addEventListener('click', () => {
        track.scrollBy({ left: getScrollStep(), behavior: 'smooth' });
      });
    }

    // Mouse drag support for desktop
    let isDown = false;
    let startX = 0;
    let scrollLeft = 0;

    track.addEventListener('mousedown', (e) => {
      isDown = true;
      startX = e.pageX - track.offsetLeft;
      scrollLeft = track.scrollLeft;
    });

    track.addEventListener('mouseleave', () => {
      isDown = false;
    });

    track.addEventListener('mouseup', () => {
      isDown = false;
    });

    track.addEventListener('mousemove', (e) => {
      if (!isDown) return;
      e.preventDefault();
      const x = e.pageX - track.offsetLeft;
      const walk = (x - startX) * 1.2;
      track.scrollLeft = scrollLeft - walk;
    });
  })();
</script>
