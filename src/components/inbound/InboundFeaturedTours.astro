---
// src/components/inbound/InboundFeaturedTours.astro
import { env } from 'cloudflare:workers';

let tours: any[] = [];

try {
  const d1Db = env?.dulichcoguu_d1;
  if (d1Db) {
    const { results } = await d1Db.prepare(`
      SELECT t.id, t.slug, t.title, t.featuredImage, t.price_number, t.price_text, t.days, t.excerpt, t.country_slug, c.name as country_name
      FROM Tour t
      LEFT JOIN Country c ON t.country_slug = c.slug
      WHERE t.status = 'published'
      ORDER BY t.createdAt DESC
      LIMIT 6
    `).all<any>();
    tours = results || [];
  }
} catch (e) {
  console.error("Error fetching featured tours:", e);
}

// Fallback tours if DB query returns empty
if (!tours || tours.length === 0) {
  tours = [
    {
      slug: "grand-vietnam-discovery-14d",
      title: "Grand Vietnam Discovery: From North Karsts to Mekong Waters",
      days: "14 Days / 13 Nights",
      price_number: 2450,
      price_text: "$2,450 USD",
      featuredImage: "https://images.unsplash.com/photo-1528127269322-539801943592?auto=format&fit=crop&w=1000&q=80",
      excerpt: "The definitive cross-country expedition: Hanoi culinary street safari, Lan Ha Bay private junk cruise, Hue imperial tombs, lantern-lit Hoi An, and Mekong floating life.",
      country_name: "Grand Vietnam"
    },
    {
      slug: "sapa-tonkinese-alps-4d",
      title: "Sapa & Tonkinese Alps: Terraced Valleys & Ethnic Culture",
      days: "4 Days / 3 Nights",
      price_number: 580,
      price_text: "$580 USD",
      featuredImage: "https://images.unsplash.com/photo-1544644181-1484b3fdfc62?auto=format&fit=crop&w=1000&q=80",
      excerpt: "Hike through mist-shrouded rice terraces in Muong Hoa, stay in a boutique mountain lodge, and meet Hmong and Red Dao artisan weavers.",
      country_name: "North Highlands"
    },
    {
      slug: "mekong-waterways-floating-life-3d",
      title: "Mekong Waterways & Floating Life Private Explorer",
      days: "3 Days / 2 Nights",
      price_number: 390,
      price_text: "$390 USD",
      featuredImage: "https://images.unsplash.com/photo-1509042239860-f550ce710b93?auto=format&fit=crop&w=1000&q=80",
      excerpt: "Navigate emerald canals by traditional private wooden sampan, cycle along quiet island orchards, and witness sunrise at Cai Rang floating market.",
      country_name: "Mekong Delta"
    }
  ];
}

function formatUSD(num: number | null, text: string | null) {
  if (text && text.includes('$')) return text;
  if (num) return `$${num.toLocaleString('en-US')} USD`;
  return "Inquire for Pricing";
}
---

<section class="py-20 lg:py-28 bg-white" id="signature-tours">
  <div class="max-w-[1440px] mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-16 gap-6">
      <div class="max-w-2xl">
        <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-brand-50 text-brand-700 border border-brand-200 text-xs font-bold uppercase tracking-widest mb-3">
          Curated Private Itineraries
        </div>
        <h2 class="font-serif text-3xl sm:text-4xl md:text-5xl font-bold text-gray-900 tracking-tight leading-tight">
          Signature Expeditions Across Vietnam
        </h2>
        <p class="text-gray-600 text-base sm:text-lg mt-3 font-light leading-relaxed">
          Every itinerary is 100% private and customizable. Crafted with handpicked boutique lodges, licensed private guides, and genuine cultural interactions.
        </p>
      </div>

      <div class="flex items-center gap-4">
        <a 
          href="/tours" 
          class="inline-flex items-center gap-2 px-6 py-3.5 rounded-2xl bg-brand-600 hover:bg-brand-700 text-white font-bold text-xs uppercase tracking-wider transition-all duration-300 shadow-md"
        >
          <span>View All {tours.length}+ Journeys</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
        </a>
      </div>
    </div>

    <!-- Tour Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {tours.map((t: any) => (
        <article class="group bg-white rounded-3xl overflow-hidden border border-gray-200 shadow-sm hover:shadow-xl transition-all duration-500 flex flex-col justify-between">
          
          <!-- Image Header -->
          <div class="relative aspect-[16/10] overflow-hidden bg-gray-100">
            <img 
              src={t.featuredImage || "https://images.unsplash.com/photo-1528127269322-539801943592?auto=format&fit=crop&w=1000&q=80"} 
              alt={t.title} 
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 ease-out"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-gray-900/60 via-transparent to-black/10"></div>

            <!-- Badges -->
            <div class="absolute top-4 left-4 flex flex-wrap gap-2">
              {t.days && (
                <span class="px-3 py-1 bg-white/90 backdrop-blur-md text-gray-900 text-[11px] font-bold rounded-full border border-white shadow">
                  ⏱️ {t.days}
                </span>
              )}
            </div>

            {t.country_name && (
              <span class="absolute bottom-4 left-4 px-3 py-1 bg-brand-500 text-white text-[11px] font-extrabold rounded-lg shadow uppercase tracking-wide">
                📍 {t.country_name}
              </span>
            )}
          </div>

          <!-- Content Body -->
          <div class="p-6 sm:p-7 flex-1 flex flex-col justify-between">
            <div>
              <div class="flex items-center gap-1 text-brand-500 text-xs font-bold mb-2">
                <span>★★★★★</span>
                <span class="text-gray-500 text-[11px] ml-1">5.0 (48+ reviews)</span>
              </div>

              <h3 class="font-serif text-xl sm:text-2xl font-bold text-gray-900 group-hover:text-brand-600 transition-colors leading-snug mb-3">
                <a href={`/tour/${t.slug}`}>
                  {t.title}
                </a>
              </h3>

              {t.excerpt && (
                <p class="text-sm text-gray-600 line-clamp-3 leading-relaxed mb-6 font-normal">
                  {t.excerpt}
                </p>
              )}
            </div>

            <!-- Card Bottom: Price & Action -->
            <div class="pt-5 border-t border-gray-100 flex items-center justify-between">
              <div>
                <span class="block text-[10.5px] uppercase font-bold text-gray-400 tracking-wider">Starting from</span>
                <span class="font-serif text-xl font-bold text-gray-900">
                  {formatUSD(t.price_number, t.price_text)}
                </span>
                <span class="text-[10px] text-gray-500 block">/ person (private)</span>
              </div>

              <a 
                href={`/tour/${t.slug}`} 
                class="px-5 py-2.5 bg-brand-50 hover:bg-brand-600 hover:text-white text-brand-700 font-bold text-xs uppercase tracking-wider rounded-xl transition-all shadow-sm"
              >
                View Tour →
              </a>
            </div>

          </div>

        </article>
      ))}

      <!-- Tailor-Made CTA Card -->
      <div class="bg-brand-50 rounded-3xl p-8 text-gray-900 flex flex-col justify-between border border-brand-200 shadow-sm hover:shadow-md transition-shadow relative overflow-hidden">
        <div class="absolute -top-12 -right-12 w-40 h-40 bg-brand-200/50 rounded-full blur-3xl pointer-events-none"></div>

        <div class="relative z-10">
          <div class="w-12 h-12 rounded-2xl bg-brand-100 text-brand-600 flex items-center justify-center text-xl font-black mb-6 shadow-sm border border-brand-200">
            ✨
          </div>
          <span class="text-brand-600 text-xs font-bold uppercase tracking-widest block mb-2">Bespoke Travel Design</span>
          <h3 class="font-serif text-2xl sm:text-3xl font-bold text-gray-900 mb-4 leading-snug">
            Want a Custom Itinerary Crafted Just For You?
          </h3>
          <p class="text-gray-600 text-sm leading-relaxed mb-6 font-light">
            Share your travel dates, preferred pace, dream destinations, and dietary needs. Our local travel architects will design your dream trip in 24 hours.
          </p>
        </div>

        <div class="relative z-10">
          <a 
            href="/tailor-made" 
            class="block text-center w-full py-4 bg-brand-600 hover:bg-brand-700 text-white font-extrabold text-xs uppercase tracking-[0.15em] rounded-2xl shadow-md transition-all transform hover:-translate-y-0.5"
          >
            Design My Custom Trip →
          </a>
          <p class="text-[11px] text-center text-gray-500 mt-3 font-medium">
            ⚡ 100% Free · No Obligation Proposal
          </p>
        </div>
      </div>

    </div>

  </div>
</section>
