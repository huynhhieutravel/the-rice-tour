---
// src/components/inbound/InboundFeaturedTours.astro
import { env } from 'cloudflare:workers';

const canonicalTours = [
  {
    id: 'tour_cuchi_halfday',
    slug: 'half-day-cu-chi-tunnels-tour',
    title: 'Half-Day Cu Chi Tunnels Luxury Private Tour',
    days: 'Half Day (5 Hours)',
    price_number: 75,
    price_text: '$75 USD',
    featuredImage: 'https://media.thericetour.com/uploads/group-posing-secret-tunnel-entrance-leaves-cu-chi-1280x720.webp',
    excerpt: 'Explore authentic underground tunnel complexes, secret trapdoors, ventilation mounds, and historic battle sites with an expert historical guide. Chilled refreshments & VIP vehicle.',
    country_name: 'Cu Chi & Countryside',
    country_slug: 'south-vietnam',
    status: 'published'
  },
  {
    id: 'tour_cuchi_1day',
    slug: '1-day-premium-cu-chi-tunnels',
    title: '1-Day Premium Cu Chi Tunnels & Saigon Countryside Private Tour',
    days: 'Full Day (8 Hours)',
    price_number: 122,
    price_text: '$122 USD',
    featuredImage: 'https://media.thericetour.com/uploads/two-girls-posing-rusted-tank-cu-chi-tunnels-the-rice.webp',
    excerpt: 'Comprehensive exploration of Ben Dinh & Ben Duoc tunnel systems, local organic rubber plantations, rice paper workshops, and riverside lunch.',
    country_name: 'Cu Chi & Countryside',
    country_slug: 'south-vietnam',
    status: 'published'
  },
  {
    id: 'tour_mekong_fullday',
    slug: 'full-day-mekong-delta-tour-ben-tre-my-tho',
    title: 'Full-Day Mekong Delta Private Discovery (Ben Tre & My Tho Waterways)',
    days: 'Full Day (8–9 Hours)',
    price_number: 114,
    price_text: '$114 USD',
    featuredImage: 'https://media.thericetour.com/uploads/girls-smiling-red-polka-dress-rowing-boat-mekong-canal.webp',
    excerpt: 'Hand-rowed wooden sampan through tranquil water coconut canals, traditional honey bee farm, coconut candy workshop, horse carriage ride, and elephant ear fish lunch.',
    country_name: 'Mekong Delta',
    country_slug: 'south-vietnam',
    status: 'published'
  },
  {
    id: 'tour_mekong_2day',
    slug: '2-day-mekong-delta-tour',
    title: '2-Day 1-Night Mekong Delta Slow Living & Floating Market Private Journey',
    days: '2 Days / 1 Night',
    price_number: 197,
    price_text: '$197 USD',
    featuredImage: 'https://media.thericetour.com/uploads/seven-story-pagoda-tower-vinh-trang-temple-my-tho.webp',
    excerpt: 'Experience Cai Rang bustling floating market at sunrise, tranquil boutique riverside eco-resort stay, cycling island hamlets, and culinary home cooking.',
    country_name: 'Mekong Delta',
    country_slug: 'south-vietnam',
    status: 'published'
  },
  {
    id: 'tour_saigon_heritage',
    slug: 'ho-chi-minh-city-half-day-private-tour',
    title: 'Saigon Heritage & Hidden Alleys Half-Day Private Tour',
    days: 'Half Day (4–5 Hours)',
    price_number: 67,
    price_text: '$67 USD',
    featuredImage: 'https://media.thericetour.com/uploads/tour-group-listening-briefing-underground-hall-cu-chi-tunnels.webp',
    excerpt: 'Iconic Notre Dame Cathedral, Central Post Office, War Remnants Museum, hidden colonial cafe alleys, and Chinatown Binh Tay Market.',
    country_name: 'Ho Chi Minh City',
    country_slug: 'south-vietnam',
    status: 'published'
  },
  {
    id: 'tour_cooking_class',
    slug: 'cooking-class-local-market',
    title: 'Authentic Vietnamese Cooking Class & Local Market Cultural Experience',
    days: 'Half Day (4 Hours)',
    price_number: 59,
    price_text: '$59 USD',
    featuredImage: 'https://media.thericetour.com/uploads/man-making-rice-paper-steam-traditional-village-mekong.webp',
    excerpt: 'Chef-guided wet market ingredient tour, hands-on cooking of 4 signature Vietnamese dishes (Pho, Fresh Spring Rolls, Banh Xeo), and recipe booklet.',
    country_name: 'Saigon Culinary',
    country_slug: 'south-vietnam',
    status: 'published'
  }
];

let tours: any[] = [];

try {
  const d1Db = env?.dulichcoguu_d1;
  if (d1Db) {
    // Ensure all 6 canonical tours exist and are updated in D1
    for (const ct of canonicalTours) {
      try {
        const existing = await d1Db.prepare("SELECT id FROM Tour WHERE slug = ?").bind(ct.slug).first();
        if (!existing) {
          await d1Db.prepare(`
            INSERT INTO Tour (id, title, slug, status, featuredImage, price_number, price_text, days, excerpt, country_slug, createdAt, updatedAt)
            VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, CURRENT_TIMESTAMP, CURRENT_TIMESTAMP)
          `).bind(ct.id, ct.title, ct.slug, ct.status, ct.featuredImage, ct.price_number, ct.price_text, ct.days, ct.excerpt, ct.country_slug).run();
        } else {
          // Keep canonical image and price synchronized
          await d1Db.prepare(`
            UPDATE Tour 
            SET title = COALESCE(title, ?),
                featuredImage = COALESCE(featuredImage, ?),
                price_number = ?,
                price_text = ?,
                days = COALESCE(days, ?)
            WHERE slug = ?
          `).bind(ct.title, ct.featuredImage, ct.price_number, ct.price_text, ct.days, ct.slug).run();
        }
      } catch (seedErr) {
        console.error('Error auto-syncing tour:', ct.slug, seedErr);
      }
    }

    const { results } = await d1Db.prepare(`
      SELECT t.id, t.slug, t.title, t.featuredImage, t.price_number, t.price_text, t.days, t.excerpt, t.country_slug, c.name as country_name
      FROM Tour t
      LEFT JOIN Country c ON t.country_slug = c.slug
      WHERE t.status = 'published'
      ORDER BY t.price_number ASC
      LIMIT 6
    `).all<any>();
    
    if (results && results.length > 0) {
      tours = results;
    }
  }
} catch (e) {
  console.error("Error fetching featured tours:", e);
}

// Fallback to canonical authentic tours if needed
if (!tours || tours.length === 0) {
  tours = canonicalTours;
}

function formatUSD(num: number | null, text: string | null) {
  if (text && text.includes('$')) return text;
  if (num) {
    if (num > 1000) {
      const usd = Math.ceil(num / 25400);
      return `$${usd.toLocaleString('en-US')} USD`;
    }
    return `$${num.toLocaleString('en-US')} USD`;
  }
  return "Inquire for Pricing";
}

function formatLocationBadge(tour: any): string {
  const slug = tour?.slug?.toLowerCase() || '';
  if (slug.includes('cu-chi')) return 'Cu Chi';
  if (slug.includes('mekong')) return 'Mekong Delta';
  if (slug.includes('cooking')) return 'Saigon';
  if (slug.includes('ho-chi-minh') || slug.includes('saigon')) return 'Saigon';
  if (slug.includes('sapa')) return 'Sapa';
  if (slug.includes('ha-long') || slug.includes('halong') || slug.includes('lan-ha')) return 'Ha Long Bay';
  if (slug.includes('hoi-an') || slug.includes('hue') || slug.includes('da-nang')) return 'Central Vietnam';
  if (slug.includes('hanoi')) return 'Hanoi';

  const rawName = tour?.country_name || '';
  if (rawName) {
    return rawName.split('(')[0].trim();
  }
  return 'South Vietnam';
}
---

<section class="py-20 lg:py-28 bg-white" id="signature-tours">
  <div class="max-w-[1440px] mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header with Slider Controls -->
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 gap-6">
      <div class="max-w-2xl">
        <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-brand-50 text-brand-700 border border-brand-200 text-xs font-bold uppercase tracking-widest mb-3 shadow-sm">
          Curated Private Itineraries
        </div>
        <h2 class="font-serif text-3xl sm:text-4xl md:text-5xl font-bold text-gray-900 tracking-tight leading-tight">
          Signature Vietnam Journeys
        </h2>
        <p class="text-gray-600 text-base sm:text-lg mt-3 font-light leading-relaxed">
          Every journey is 100% private, slow-paced, and flexible. Enjoy luxury private vehicles (max 5 guests), dedicated licensed guides, and zero commission shopping traps.
        </p>
      </div>

      <div class="flex items-center gap-3">
        <a 
          href="/tours" 
          class="inline-flex items-center gap-2 px-5 py-3 rounded-2xl bg-brand-700 hover:bg-brand-800 text-white font-bold text-xs uppercase tracking-wider transition-all duration-300 shadow-md transform hover:-translate-y-0.5"
        >
          <span>View All Journeys</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
        </a>

        <!-- Slider Nav Arrows -->
        <div class="flex items-center gap-2">
          <button 
            id="tour-slide-prev"
            aria-label="Previous tours"
            class="w-11 h-11 rounded-2xl border border-gray-200 bg-white hover:bg-brand-50 hover:border-brand-300 text-gray-700 hover:text-brand-800 flex items-center justify-center transition-all shadow-sm active:scale-95 cursor-pointer"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7"/></svg>
          </button>
          <button 
            id="tour-slide-next"
            aria-label="Next tours"
            class="w-11 h-11 rounded-2xl border border-gray-200 bg-white hover:bg-brand-50 hover:border-brand-300 text-gray-700 hover:text-brand-800 flex items-center justify-center transition-all shadow-sm active:scale-95 cursor-pointer"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"/></svg>
          </button>
        </div>
      </div>
    </div>

    <!-- Tour Cards Horizontal Carousel Track -->
    <div 
      id="tour-carousel-track"
      class="flex overflow-x-auto snap-x snap-mandatory gap-5 pb-6 pt-1 -mx-4 px-4 sm:-mx-6 sm:px-6 lg:-mx-8 lg:px-8 hide-scrollbar scroll-smooth select-none cursor-grab active:cursor-grabbing"
    >
      {tours.map((t: any) => (
        <article class="w-[82vw] max-w-[320px] sm:w-[320px] md:w-[340px] lg:w-[350px] shrink-0 snap-start group bg-white rounded-3xl overflow-hidden border border-gray-200 shadow-sm hover:shadow-xl transition-all duration-500 flex flex-col justify-between">
          
          <!-- Image Header -->
          <div class="relative aspect-[16/9] overflow-hidden bg-gray-100">
            <img 
              src={t.featuredImage || "https://media.thericetour.com/uploads/girls-smiling-red-polka-dress-rowing-boat-mekong-canal.webp"} 
              alt={t.title} 
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 ease-out"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-gray-900/60 via-transparent to-black/10"></div>

            <!-- Badges -->
            <div class="absolute top-3.5 left-3.5 flex flex-wrap gap-2">
              {t.days && (
                <span class="px-2.5 py-1 bg-white/95 backdrop-blur-md text-gray-900 text-[10.5px] font-bold rounded-full border border-white shadow-sm">
                  ⏱️ {t.days}
                </span>
              )}
            </div>

            <span class="absolute bottom-3.5 left-3.5 px-2.5 py-0.5 bg-brand-700 text-white text-[10.5px] font-extrabold rounded-lg shadow uppercase tracking-wide">
              📍 {formatLocationBadge(t)}
            </span>
          </div>

          <!-- Content Body -->
          <div class="p-5 flex-1 flex flex-col justify-between">
            <div>
              <div class="flex items-center gap-1 text-amber-500 text-xs font-bold mb-2">
                <span>★★★★★</span>
                <span class="text-gray-500 text-[10.5px] ml-1">5.0 (48+ reviews)</span>
              </div>

              <h3 class="font-serif text-lg sm:text-xl font-bold text-gray-900 group-hover:text-brand-600 transition-colors leading-snug mb-2.5">
                <a href={`/tour/${t.slug}`}>
                  {t.title}
                </a>
              </h3>

              {t.excerpt && (
                <p class="text-xs text-gray-600 line-clamp-2 sm:line-clamp-3 leading-relaxed mb-4 font-normal">
                  {t.excerpt}
                </p>
              )}
            </div>

            <!-- Card Bottom: Price & Action -->
            <div class="pt-4 border-t border-gray-100 flex items-center justify-between gap-2">
              <div>
                <span class="block text-[10px] uppercase font-bold text-gray-600 tracking-wider">Starting from</span>
                <span class="font-serif text-lg font-bold text-gray-900">
                  {formatUSD(t.price_number, t.price_text)}
                </span>
                <span class="text-[9.5px] text-gray-600 block">/ guest (private vehicle)</span>
              </div>

              <a 
                href={`/tour/${t.slug}`} 
                class="px-3.5 py-2 bg-brand-50 hover:bg-brand-600 hover:text-white text-brand-700 font-bold text-xs uppercase tracking-wider rounded-xl transition-all shadow-sm shrink-0 whitespace-nowrap"
              >
                View →
              </a>
            </div>

          </div>

        </article>
      ))}

      <!-- Tailor-Made CTA Card -->
      <div class="w-[82vw] max-w-[320px] sm:w-[320px] md:w-[340px] lg:w-[350px] shrink-0 snap-start bg-brand-50 rounded-3xl p-6 text-gray-900 flex flex-col justify-between border border-brand-200 shadow-sm hover:shadow-md transition-shadow relative overflow-hidden">
        <div class="absolute -top-12 -right-12 w-40 h-40 bg-brand-200/50 rounded-full blur-3xl pointer-events-none"></div>

        <div class="relative z-10">
          <div class="w-10 h-10 rounded-2xl bg-brand-100 text-brand-700 flex items-center justify-center text-lg font-black mb-4 shadow-sm border border-brand-200">
            ✨
          </div>
          <span class="text-brand-800 text-[11px] font-bold uppercase tracking-widest block mb-1.5">Bespoke Concierge</span>
          <h3 class="font-serif text-xl font-bold text-gray-900 mb-2.5 leading-snug">
            Looking for a Tailor-Made Private Journey?
          </h3>
          <p class="text-gray-700 text-xs leading-relaxed mb-4 font-light">
            Share your travel dates, preferred pace, and special interests. Our local travel architects craft your customized itinerary within 24 hours.
          </p>
        </div>

        <div class="relative z-10 pt-4 border-t border-brand-200/60">
          <a 
            href="/tailor-made" 
            class="block text-center w-full py-3 bg-brand-600 hover:bg-brand-700 text-white font-extrabold text-xs uppercase tracking-wider rounded-xl shadow-md transition-all transform hover:-translate-y-0.5"
          >
            Design My Custom Trip →
          </a>
          <p class="text-[10px] text-center text-gray-600 mt-2 font-medium">
            ⚡ 100% Free · No Obligation Proposal
          </p>
        </div>
      </div>

    </div>

  </div>
</section>

<script is:inline>
  (function() {
    const track = document.getElementById('tour-carousel-track');
    const prevBtn = document.getElementById('tour-slide-prev');
    const nextBtn = document.getElementById('tour-slide-next');

    if (!track) return;

    const getScrollStep = () => {
      const card = track.querySelector('article');
      return card ? (card.offsetWidth + 20) * 1.5 : 400;
    };

    if (prevBtn) {
      prevBtn.addEventListener('click', () => {
        track.scrollBy({ left: -getScrollStep(), behavior: 'smooth' });
      });
    }

    if (nextBtn) {
      nextBtn.addEventListener('click', () => {
        track.scrollBy({ left: getScrollStep(), behavior: 'smooth' });
      });
    }

    // Mouse drag support for desktop
    let isDown = false;
    let startX = 0;
    let scrollLeft = 0;

    track.addEventListener('mousedown', (e) => {
      isDown = true;
      startX = e.pageX - track.offsetLeft;
      scrollLeft = track.scrollLeft;
    });

    track.addEventListener('mouseleave', () => {
      isDown = false;
    });

    track.addEventListener('mouseup', () => {
      isDown = false;
    });

    track.addEventListener('mousemove', (e) => {
      if (!isDown) return;
      e.preventDefault();
      const x = e.pageX - track.offsetLeft;
      const walk = (x - startX) * 1.2;
      track.scrollLeft = scrollLeft - walk;
    });
  })();
</script>
