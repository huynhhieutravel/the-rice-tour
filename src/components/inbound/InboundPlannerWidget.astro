---
// src/components/inbound/InboundPlannerWidget.astro
---
<section class="py-20 lg:py-28 bg-white text-gray-900 relative overflow-hidden" id="plan-trip">
  <div class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <div class="bg-white border border-gray-200 rounded-3xl p-8 sm:p-12 lg:p-16 shadow-2xl relative overflow-hidden">
      <!-- Decorative background accent -->
      <div class="absolute -top-40 -left-40 w-96 h-96 bg-brand-50 rounded-full blur-3xl pointer-events-none"></div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center relative z-10">
        
        <!-- Left Column: Value Proposition -->
        <div class="lg:col-span-5">
          <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-brand-50 text-brand-700 border border-brand-200 text-xs font-bold uppercase tracking-widest mb-4">
            Bespoke Trip Designer
          </div>
          
          <h2 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-gray-900 mb-6 leading-tight">
            Ready to Handcraft Your Vietnam Journey?
          </h2>

          <p class="text-gray-600 text-base leading-relaxed mb-8 font-light">
            Tell us your wishes and travel style. Our licensed destination specialists will design a personalized, day-by-day itinerary with verified boutique lodges within 24 hours.
          </p>

          <div class="space-y-4 text-sm text-gray-700">
            <div class="flex items-center gap-3">
              <div class="w-8 h-8 rounded-xl bg-brand-50 text-brand-600 flex items-center justify-center font-bold">✓</div>
              <span>100% Free Consultation &amp; Itinerary Proposal</span>
            </div>
            <div class="flex items-center gap-3">
              <div class="w-8 h-8 rounded-xl bg-brand-50 text-brand-600 flex items-center justify-center font-bold">✓</div>
              <span>Unlimited revisions until you are completely thrilled</span>
            </div>
            <div class="flex items-center gap-3">
              <div class="w-8 h-8 rounded-xl bg-brand-50 text-brand-600 flex items-center justify-center font-bold">✓</div>
              <span>Direct WhatsApp communication with your travel architect</span>
            </div>
          </div>
        </div>

        <!-- Right Column: Interactive Quick Inquiry Form -->
        <div class="lg:col-span-7 bg-gray-50 border border-gray-200 p-6 sm:p-8 rounded-3xl shadow-sm">
          <form id="home-inquiry-form" class="space-y-6">
            
            <input type="text" name="_hp" style="display:none !important;" tabindex="-1" autocomplete="off" />
            <input type="hidden" name="_ts" id="home-form-ts" value="" />

            <!-- Row 1: Destinations Selection -->
            <div>
              <label class="block text-xs font-bold uppercase tracking-wider text-brand-700 mb-2.5">
                1. Where do you want to explore? (Select multiple)
              </label>
              <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 text-xs text-gray-700">
                <label class="p-2.5 bg-white hover:bg-gray-50 border border-gray-200 rounded-xl cursor-pointer flex items-center gap-2 shadow-sm transition-colors">
                  <input type="checkbox" name="destinations" value="Hanoi & Halong Bay" class="rounded text-brand-600" checked />
                  <span>Hanoi &amp; Halong</span>
                </label>
                <label class="p-2.5 bg-white hover:bg-gray-50 border border-gray-200 rounded-xl cursor-pointer flex items-center gap-2 shadow-sm transition-colors">
                  <input type="checkbox" name="destinations" value="Sapa Terraces" class="rounded text-brand-600" checked />
                  <span>Sapa Terraces</span>
                </label>
                <label class="p-2.5 bg-white hover:bg-gray-50 border border-gray-200 rounded-xl cursor-pointer flex items-center gap-2 shadow-sm transition-colors">
                  <input type="checkbox" name="destinations" value="Hue & Hoi An" class="rounded text-brand-600" checked />
                  <span>Hue &amp; Hoi An</span>
                </label>
                <label class="p-2.5 bg-white hover:bg-gray-50 border border-gray-200 rounded-xl cursor-pointer flex items-center gap-2 shadow-sm transition-colors">
                  <input type="checkbox" name="destinations" value="Saigon & Mekong" class="rounded text-brand-600" checked />
                  <span>Saigon &amp; Mekong</span>
                </label>
              </div>
            </div>

            <!-- Row 2: Duration & Timing -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label class="block text-xs font-bold uppercase tracking-wider text-brand-700 mb-1.5">
                  2. Trip Duration
                </label>
                <select name="duration" class="w-full bg-white border border-gray-200 rounded-xl p-3 text-sm text-gray-900 shadow-sm focus:outline-none focus:border-brand-500 focus:ring-1 focus:ring-brand-500">
                  <option value="7-9 Days" class="bg-white">7 – 9 Days (Highlights)</option>
                  <option value="10-14 Days" class="bg-white" selected>10 – 14 Days (Grand Discovery)</option>
                  <option value="15+ Days" class="bg-white">15+ Days (In-Depth Adventure)</option>
                </select>
              </div>

              <div>
                <label class="block text-xs font-bold uppercase tracking-wider text-brand-700 mb-1.5">
                  3. Approximate Travel Dates
                </label>
                <input 
                  type="text" 
                  name="travelDates" 
                  placeholder="e.g. October 2026 or Spring 2027" 
                  class="w-full bg-white border border-gray-200 rounded-xl p-3 text-sm text-gray-900 placeholder-gray-400 shadow-sm focus:outline-none focus:border-brand-500 focus:ring-1 focus:ring-brand-500" 
                />
              </div>
            </div>

            <!-- Row 3: Contact Info -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label class="block text-xs font-bold uppercase tracking-wider text-brand-700 mb-1.5">
                  Your Full Name *
                </label>
                <input 
                  type="text" 
                  name="customerName" 
                  required 
                  placeholder="e.g. Eleanor Vance" 
                  class="w-full bg-white border border-gray-200 rounded-xl p-3 text-sm text-gray-900 placeholder-gray-400 shadow-sm focus:outline-none focus:border-brand-500 focus:ring-1 focus:ring-brand-500" 
                />
              </div>

              <div>
                <label class="block text-xs font-bold uppercase tracking-wider text-brand-700 mb-1.5">
                  Email Address *
                </label>
                <input 
                  type="email" 
                  name="customerEmail" 
                  required 
                  placeholder="e.g. eleanor@example.com" 
                  class="w-full bg-white border border-gray-200 rounded-xl p-3 text-sm text-gray-900 placeholder-gray-400 shadow-sm focus:outline-none focus:border-brand-500 focus:ring-1 focus:ring-brand-500" 
                />
              </div>
            </div>

            <div>
              <label class="block text-xs font-bold uppercase tracking-wider text-brand-700 mb-1.5">
                WhatsApp Phone Number (with Country Code)
              </label>
              <input 
                type="tel" 
                name="customerPhone" 
                placeholder="e.g. +44 7123 456789 or +1 555 123 4567" 
                class="w-full bg-white border border-gray-200 rounded-xl p-3 text-sm text-gray-900 placeholder-gray-400 shadow-sm focus:outline-none focus:border-brand-500 focus:ring-1 focus:ring-brand-500" 
              />
            </div>

            <!-- Submit Button -->
            <button 
              type="submit" 
              id="home-submit-btn" 
              class="w-full py-4 bg-brand-600 hover:bg-brand-700 text-white font-extrabold text-sm uppercase tracking-wider rounded-2xl shadow-lg transition-all transform hover:-translate-y-0.5 cursor-pointer"
            >
              Request My Free Custom Itinerary Proposal →
            </button>

            <p class="text-[11px] text-center text-gray-500">
              🔒 Privacy Guaranteed. No spam. Receive a detailed proposal within 24 hours.
            </p>

          </form>
        </div>

      </div>

    </div>
  </div>
</section>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const tsInput = document.getElementById('home-form-ts');
    if (tsInput) tsInput.value = Date.now().toString();

    const homeForm = document.getElementById('home-inquiry-form');
    const homeBtn = document.getElementById('home-submit-btn');

    if (homeForm) {
      homeForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        if (homeBtn) {
          homeBtn.disabled = true;
          homeBtn.textContent = 'Sending Your Inquiry...';
        }

        const formData = new FormData(homeForm);
        const selectedDests = [];
        homeForm.querySelectorAll('input[name="destinations"]:checked').forEach(c => selectedDests.push(c.value));

        const payload = {
          formType: 'tailor_made_homepage',
          customerName: formData.get('customerName'),
          customerEmail: formData.get('customerEmail'),
          customerPhone: formData.get('customerPhone'),
          tourName: 'Bespoke Custom Journey Inquiry',
          sourceUrl: window.location.href,
          _hp: formData.get('_hp'),
          _ts: formData.get('_ts'),
          options: {
            destinations: selectedDests.join(', '),
            duration: formData.get('duration'),
            travelDates: formData.get('travelDates')
          }
        };

        try {
          const res = await fetch('/api/submit-form', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
          });
          const data = await res.json();
          if (res.ok && data.success) {
            alert('🎉 Thank you for your inquiry! Our Vietnam travel designer will reach out via WhatsApp/Email with a customized itinerary within 24 hours.');
            homeForm.reset();
          } else {
            alert(data.error || 'Submission failed. Please WhatsApp us directly.');
          }
        } catch (err) {
          console.error(err);
          alert('Network error. Please chat with us on WhatsApp at +84 962 333 621.');
        } finally {
          if (homeBtn) {
            homeBtn.disabled = false;
            homeBtn.textContent = 'Request My Free Custom Itinerary Proposal →';
          }
        }
      });
    }
  });
</script>
