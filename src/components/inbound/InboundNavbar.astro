---
// src/components/inbound/InboundNavbar.astro
---
<header class="fixed top-0 left-0 w-full z-50 transition-all duration-300 font-sans" id="inbound-navbar">
  <div class="max-w-[1440px] mx-auto px-4 sm:px-6 lg:px-8 pt-4 pb-3">
    <div class="bg-white/95 backdrop-blur-xl border border-gray-200 rounded-2xl px-5 py-3.5 shadow-sm flex items-center justify-between transition-all">
      
      <!-- Brand Logo -->
      <a href="/" class="flex items-center gap-3 group" aria-label="The Rice Tour Home">
        <img src="https://media.thericetour.com/uploads/logo-the-rice.webp" alt="The Rice Tour" class="h-[52px] w-auto object-contain group-hover:scale-105 transition-transform duration-300" />
      </a>

      <!-- Desktop Nav Links -->
      <nav class="hidden lg:flex items-center gap-8 text-xs font-bold uppercase tracking-widest text-gray-600">
        <a href="/destinations" class="hover:text-brand-600 transition-colors py-1">Destinations</a>
        <a href="/#travel-styles" class="hover:text-brand-600 transition-colors py-1">Travel Styles</a>
        <a href="/tailor-made" class="text-brand-600 hover:text-brand-700 transition-colors py-1 flex items-center gap-1.5 font-extrabold">
          <span class="w-1.5 h-1.5 rounded-full bg-brand-600 animate-pulse"></span>
          Tailor-Made Trip
        </a>
        <a href="/about-us" class="hover:text-brand-600 transition-colors py-1">About Us</a>
        <a href="/blog" class="hover:text-brand-600 transition-colors py-1">Travel Guides</a>
        <a href="/contact" class="hover:text-brand-600 transition-colors py-1">Contact</a>
      </nav>

      <!-- Right Actions: WhatsApp + CTA -->
      <div class="hidden sm:flex items-center gap-3">
        <a 
          href="/whatsapp" 
          target="_blank" 
          rel="noopener noreferrer"
          class="flex items-center gap-2 px-3.5 py-2 rounded-xl bg-brand-50 hover:bg-brand-100 text-brand-700 border border-brand-200 text-xs font-bold tracking-wide transition-all"
          title="Chat with private concierge on WhatsApp"
        >
          <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M17.472 14.382c-.301-.15-1.78-.878-2.056-.979-.276-.1-.477-.15-.678.15-.201.301-.779.979-.955 1.18-.176.2-.351.226-.652.075-.301-.15-1.272-.469-2.424-1.496-.895-.798-1.5-1.784-1.676-2.085-.176-.301-.019-.464.132-.614.136-.135.301-.351.452-.527.15-.176.201-.301.301-.502.1-.201.05-.376-.025-.527-.075-.15-.678-1.635-.93-2.243-.245-.591-.494-.511-.678-.521-.176-.01-.376-.01-.577-.01-.201 0-.527.075-.803.376-.276.301-1.054 1.03-1.054 2.512 0 1.482 1.079 2.912 1.23 3.113.15.2 2.123 3.242 5.143 4.547.718.31 1.279.496 1.716.635.721.23 1.377.197 1.896.12.577-.087 1.78-.727 2.03-1.43.251-.703.251-1.305.176-1.43-.075-.125-.276-.201-.577-.351z"/></svg>
          <span class="hidden md:inline">WhatsApp 24/7</span>
        </a>

        <a 
          href="/tailor-made" 
          class="px-5 py-2 bg-gradient-to-r from-brand-500 to-brand-600 hover:from-brand-600 hover:to-brand-700 text-white font-extrabold text-xs uppercase tracking-wider rounded-xl shadow-lg shadow-brand-500/25 transition-all transform hover:-translate-y-0.5"
        >
          Plan My Trip
        </a>
      </div>

      <!-- Mobile Hamburger Button -->
      <button 
        id="inbound-mobile-toggle" 
        class="lg:hidden w-10 h-10 rounded-xl bg-gray-100 flex flex-col items-center justify-center gap-1 text-gray-600 hover:bg-gray-200 transition-all"
        aria-label="Toggle menu"
      >
        <span class="w-5 h-0.5 bg-gray-600 rounded-full transition-transform"></span>
        <span class="w-5 h-0.5 bg-gray-600 rounded-full transition-opacity"></span>
        <span class="w-5 h-0.5 bg-gray-600 rounded-full transition-transform"></span>
      </button>

    </div>
  </div>

  <!-- Mobile Overlay Menu -->
  <div id="inbound-mobile-menu" class="hidden lg:hidden fixed inset-x-4 top-20 bg-white border border-gray-200 rounded-3xl p-6 shadow-2xl backdrop-blur-2xl transition-all">
    <nav class="flex flex-col gap-4 text-sm font-bold uppercase tracking-wider text-gray-700">
      <a href="/destinations" class="py-2 border-b border-gray-100 hover:text-brand-600">Destinations</a>
      <a href="/#travel-styles" class="py-2 border-b border-gray-100 hover:text-brand-600">Travel Styles</a>
      <a href="/tailor-made" class="py-2 border-b border-gray-100 text-brand-600 font-extrabold">Plan Tailor-Made Trip →</a>
      <a href="/about-us" class="py-2 border-b border-gray-100 hover:text-brand-600">About Us</a>
      <a href="/blog" class="py-2 border-b border-gray-100 hover:text-brand-600">Travel Guides</a>
      <a href="/contact" class="py-2 border-b border-gray-100 hover:text-brand-600">Contact Us</a>
    </nav>
    <div class="mt-6 flex flex-col gap-3">
      <a href="/whatsapp" target="_blank" class="py-3 bg-brand-600 text-white text-center rounded-xl font-bold text-xs uppercase tracking-wider">
        Chat on WhatsApp 24/7
      </a>
    </div>
  </div>
</header>

<script is:inline>
  const toggleBtn = document.getElementById('inbound-mobile-toggle');
  const mobileMenu = document.getElementById('inbound-mobile-menu');

  if (toggleBtn && mobileMenu) {
    toggleBtn.addEventListener('click', () => {
      mobileMenu.classList.toggle('hidden');
    });

    mobileMenu.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', () => {
        mobileMenu.classList.add('hidden');
      });
    });
  }
</script>
