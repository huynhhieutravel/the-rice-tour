---
// src/components/inbound/InboundHero.astro
---
<section class="relative min-h-[92vh] flex items-center justify-center pt-28 pb-16 overflow-hidden bg-gray-50">
  
  <!-- Background Image with Cinematic Overlay -->
  <div class="absolute inset-0 z-0">
    <img 
      src="https://media.thericetour.com/uploads/girls-taking-selfie-waving-on-rowing-boat-mekong-canal.webp" 
      alt="Authentic Vietnam Private Tour Mekong Waterways" 
      class="w-full h-full object-cover object-center"
      fetchpriority="high"
      loading="eager"
      decoding="async"
      width="1920"
      height="1080"
    />
    <!-- Lighter overlay for a brighter feel, while keeping text readable -->
    <div class="absolute inset-0 bg-gradient-to-t from-gray-950/75 via-gray-950/40 to-gray-950/20"></div>
  </div>

  <!-- Hero Content -->
  <div class="relative z-10 w-full max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8 text-center mt-6">
    
    <!-- Top Pill Badge -->
    <div class="inline-flex items-center gap-2.5 px-4 py-1.5 rounded-full bg-white/20 border border-white/40 backdrop-blur-md mb-6 shadow-lg">
      <span class="w-2 h-2 rounded-full bg-amber-400"></span>
      <span class="text-xs uppercase tracking-[0.25em] font-bold text-white">
        The Rice Tour • Boutique Vietnam Inbound Specialist
      </span>
    </div>

    <!-- Editorial Main Headline -->
    <h1 class="font-serif text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-bold tracking-tight text-white max-w-5xl mx-auto leading-[1.1] mb-6 drop-shadow-lg">
      Authentic Vietnam Tours &amp; <br class="hidden sm:inline" />
      <span class="italic font-normal text-amber-300">Private Local Experiences</span>
    </h1>

    <p class="text-white/90 text-base sm:text-lg md:text-xl max-w-2xl mx-auto font-light leading-relaxed mb-10 drop-shadow-md">
      From authentic Cu Chi underground tunnels and serene Mekong sampan waterways to Saigon heritage and cooking masterclasses—travel with your 24/7 dedicated local concierge at The Rice Tour.
    </p>

    <!-- Quick Search Widget Container - Light Mode -->
    <div class="max-w-4xl mx-auto bg-white/95 backdrop-blur-2xl border border-gray-200 p-4 sm:p-5 rounded-3xl shadow-xl">
      <form action="/tours" method="GET" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-3 text-left">
        
        <!-- Keyword Search -->
        <div class="bg-gray-50 hover:bg-gray-100 border border-gray-200 rounded-2xl p-3 transition-colors">
          <label for="hero-search-q" class="block text-[10.5px] uppercase tracking-wider font-bold text-brand-800 mb-1">
            🔍 Keyword
          </label>
          <input 
            id="hero-search-q"
            type="text" 
            name="q" 
            placeholder="e.g. Cu Chi, Mekong..." 
            aria-label="Search tours by keyword"
            class="w-full bg-transparent text-gray-900 text-sm font-semibold placeholder-gray-400 focus:outline-none"
          />
        </div>

        <!-- Region Select -->
        <div class="bg-gray-50 hover:bg-gray-100 border border-gray-200 rounded-2xl p-3 transition-colors">
          <label for="hero-search-dest" class="block text-[10.5px] uppercase tracking-wider font-bold text-brand-800 mb-1">
            📍 Destination
          </label>
          <select id="hero-search-dest" name="country" aria-label="Select destination region" class="w-full bg-transparent text-gray-900 text-sm font-semibold focus:outline-none cursor-pointer">
            <option value="" class="bg-white text-gray-900">All Destinations</option>
            <option value="south-vietnam" class="bg-white text-gray-900">Cu Chi &amp; Countryside</option>
            <option value="south-vietnam" class="bg-white text-gray-900">Mekong Delta</option>
            <option value="south-vietnam" class="bg-white text-gray-900">Saigon Heritage</option>
          </select>
        </div>

        <!-- Duration Select -->
        <div class="bg-gray-50 hover:bg-gray-100 border border-gray-200 rounded-2xl p-3 transition-colors">
          <label for="hero-search-dur" class="block text-[10.5px] uppercase tracking-wider font-bold text-brand-800 mb-1">
            ⏱️ Duration
          </label>
          <select id="hero-search-dur" name="duration" aria-label="Select tour duration" class="w-full bg-transparent text-gray-900 text-sm font-semibold focus:outline-none cursor-pointer">
            <option value="" class="bg-white text-gray-900">Any Duration</option>
            <option value="half-day" class="bg-white text-gray-900">Half Day (4–5h)</option>
            <option value="full-day" class="bg-white text-gray-900">Full Day (8h)</option>
            <option value="multi-day" class="bg-white text-gray-900">2 Days / 1 Night</option>
          </select>
        </div>

        <!-- Submit Button -->
        <div class="flex items-end">
          <button 
            type="submit" 
            class="w-full h-full min-h-[52px] bg-brand-700 hover:bg-brand-800 text-white font-extrabold text-xs uppercase tracking-widest rounded-2xl shadow-md transition-all flex items-center justify-center gap-2 transform active:scale-98 cursor-pointer"
          >
            <span>Explore Tours</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
          </button>
        </div>

      </form>
    </div>

    <!-- Trust Metric Badges -->
    <div class="mt-8 flex flex-wrap items-center justify-center gap-6 sm:gap-10 text-xs font-semibold text-white/90 drop-shadow-md">
      <div class="flex items-center gap-2">
        <svg viewBox="0 0 32 32" class="w-6 h-6 text-[#00AF87]" fill="currentColor"><path d="M16 2c-7.732 0-14 6.268-14 14s6.268 14 14 14 14-6.268 14-14-6.268-14-14-14zm-4.707 20.301c-3.149 0-5.701-2.552-5.701-5.701s2.552-5.701 5.701-5.701 5.701 2.552 5.701 5.701-2.552 5.701-5.701 5.701zm11.758 0c-3.149 0-5.701-2.552-5.701-5.701s2.552-5.701 5.701-5.701 5.701 2.552 5.701 5.701-2.552 5.701-5.701 5.701zm-5.879-11.412h-2.344l1.172-2.344 1.172 2.344zM11.293 18.6a2 2 0 1 1 0-4 2 2 0 0 1 0 4zm11.758 0a2 2 0 1 1 0-4 2 2 0 0 1 0 4z"/></svg>
        <span class="font-bold text-white tracking-wide">Excellent 5.0/5</span>
      </div>
      <div class="flex items-center gap-2">
        <span>🛡️</span>
        <span>100% No Forced Shopping</span>
      </div>
      <div class="flex items-center gap-2">
        <span>🚐</span>
        <span>VIP Small Group (Max 5 Guests)</span>
      </div>
      <div class="flex items-center gap-2">
        <span>📸</span>
        <span>Included Travel Photography</span>
      </div>
    </div>

  </div>
</section>
