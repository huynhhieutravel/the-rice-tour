---
// src/components/inbound/InboundAsSeenOn.astro
const partners = [
  { name: "TripAdvisor", subtitle: "Certificate of Excellence" },
  { name: "VNAT", subtitle: "Licensed Operator" },
  { name: "Responsible Travel", subtitle: "Eco-Friendly Partner" },
  { name: "TrustPilot", subtitle: "5-Star Rated" }
];
---

<section class="border-b border-gray-100 bg-white py-8">
  <div class="max-w-[1440px] mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col items-center justify-center space-y-4 sm:space-y-0 sm:flex-row sm:justify-around transition-all duration-500">
      
      <!-- TripAdvisor -->
      <div class="flex items-center gap-2.5 group cursor-pointer transition-transform hover:scale-105">
        <svg viewBox="0 0 32 32" class="w-8 h-8 text-gray-700 group-hover:text-[#00AF87] transition-colors" fill="currentColor"><path d="M16 2c-7.732 0-14 6.268-14 14s6.268 14 14 14 14-6.268 14-14-6.268-14-14-14zm-4.707 20.301c-3.149 0-5.701-2.552-5.701-5.701s2.552-5.701 5.701-5.701 5.701 2.552 5.701 5.701-2.552 5.701-5.701 5.701zm11.758 0c-3.149 0-5.701-2.552-5.701-5.701s2.552-5.701 5.701-5.701 5.701 2.552 5.701 5.701-2.552 5.701-5.701 5.701zm-5.879-11.412h-2.344l1.172-2.344 1.172 2.344zM11.293 18.6a2 2 0 1 1 0-4 2 2 0 0 1 0 4zm11.758 0a2 2 0 1 1 0-4 2 2 0 0 1 0 4z"/></svg>
        <div class="flex flex-col">
          <span class="font-bold text-gray-900 group-hover:text-black leading-tight">TripAdvisor</span>
          <span class="text-[10.5px] uppercase tracking-wider text-gray-700 font-bold">Excellence 2026</span>
        </div>
      </div>

      <!-- VNAT -->
      <div class="flex items-center gap-2.5 group cursor-pointer transition-transform hover:scale-105 hidden sm:flex">
        <div class="w-8 h-8 rounded-full bg-gray-100 group-hover:bg-brand-100 flex items-center justify-center transition-colors border border-gray-200">
          <span class="text-gray-800 group-hover:text-brand-800 font-serif font-bold italic">V</span>
        </div>
        <div class="flex flex-col">
          <span class="font-bold text-gray-900 group-hover:text-black leading-tight">VNAT</span>
          <span class="text-[10.5px] uppercase tracking-wider text-gray-700 font-bold">Licensed Operator</span>
        </div>
      </div>

      <!-- Responsible Travel -->
      <div class="flex items-center gap-2.5 group cursor-pointer transition-transform hover:scale-105">
        <svg class="w-8 h-8 text-gray-700 group-hover:text-green-600 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/></svg>
        <div class="flex flex-col">
          <span class="font-bold text-gray-900 group-hover:text-black leading-tight">Responsible Travel</span>
          <span class="text-[10.5px] uppercase tracking-wider text-gray-700 font-bold">Eco-Friendly Partner</span>
        </div>
      </div>

      <!-- TrustPilot -->
      <div class="flex items-center gap-2.5 group cursor-pointer transition-transform hover:scale-105 hidden md:flex">
        <svg class="w-8 h-8 text-gray-700 group-hover:text-[#00B67A] transition-colors" fill="currentColor" viewBox="0 0 24 24"><path d="M12 17.27l-5.18 3.73 2-6.81-5.82-4.19h7.19L12 2l1.81 8h7.19l-5.82 4.19 2 6.81z"/></svg>
        <div class="flex flex-col">
          <span class="font-bold text-gray-900 group-hover:text-black leading-tight">TrustPilot</span>
          <span class="text-[10.5px] uppercase tracking-wider text-gray-700 font-bold">5-Star Rated</span>
        </div>
      </div>

    </div>
  </div>
</section>
