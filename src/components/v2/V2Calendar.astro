---
// src/components/v2/V2Calendar.astro

const months = [
  { m: "JAN", icon: "tent", title: "Mongolia\nWinter" },
  { m: "FEB", icon: "pagoda", title: "Harbin\nIce World" },
  { m: "MAR", icon: "mountain", title: "Bhutan\nSpring" },
  { m: "APR", icon: "mountain", title: "Pakistan\nKKH" },
  { m: "MAY", icon: "mountain", title: "Tibet\nDiscovery" },
  { m: "JUN", icon: "tent", title: "Ladakh\nClassic" },
  { m: "JUL", icon: "motor", title: "Ladakh\nMotor" },
  { m: "AUG", icon: "mountain", title: "Kailash\nPilgrimage" },
  { m: "SEP", icon: "camel", title: "Xinjiang\nAutumn" },
  { m: "OCT", icon: "mountain", title: "Pakistan\nAutumn" },
  { m: "NOV", icon: "tent", title: "Morocco\nDesert" },
  { m: "DEC", icon: "tent", title: "Mongolia\nWinter" }
];

// Simple SVG path mapping for icons
const icons = {
  tent: '<path d="M12 4L2 20h20L12 4z"/><path d="M12 4v16"/><path d="M8 20l4-6 4 6"/>',
  pagoda: '<path d="M12 2l3 4H9l3-4z"/><path d="M7 6h10l2 4H5l2-4z"/><path d="M5 10h14v10H5V10z"/><path d="M3 20h18v2H3v-2z"/><path d="M10 20v-4h4v4"/>',
  mountain: '<path d="M8 3l4 8 5-5 5 15H2L8 3z"/>',
  motor: '<circle cx="5" cy="18" r="3"/><circle cx="19" cy="18" r="3"/><path d="M5 15h4l3-6 4 1h3"/><path d="M12 9v6"/>',
  camel: '<path d="M4 14c0-2 2-4 4-4s2 2 4 4 2-4 4-4 4 2 4 4v4H4v-4z"/><path d="M4 14H2v-4s1-3 3-3 2 1 2 1"/>'
};
---

<section id="calendar" class="w-full bg-[#f2f0eb] py-16 text-[#0a0a0a]">
  <div class="max-w-[1600px] mx-auto px-6 md:px-12">
    
    <!-- Header -->
    <div class="flex items-center justify-between mb-8">
      <div class="flex items-center gap-6">
        <h2 class="font-serif text-xl md:text-2xl font-bold uppercase tracking-widest shrink-0">
          Expedition Calendar 2026
        </h2>
        <div class="hidden md:block h-px bg-black/20 w-64"></div>
      </div>
      <a href="/du-lich-nuoc-ngoai/" class="text-[10px] font-bold uppercase tracking-[0.2em] text-[#0a0a0a]/60 hover:text-[#0a0a0a] transition-colors whitespace-nowrap">
        View Full Calendar
      </a>
    </div>

    <!-- Grid -->
    <div class="grid grid-cols-3 sm:grid-cols-4 md:grid-cols-6 lg:grid-cols-12 border-x border-t border-black/10">
      {months.map((item, idx) => (
        <div class="group flex flex-col items-center justify-start pt-6 pb-8 border-b border-r border-black/10 hover:bg-black/5 transition-colors cursor-default text-center px-2">
          <span class="font-bold text-sm tracking-widest uppercase mb-4">{item.m}</span>
          
          <div class="h-8 mb-4 text-[#0a0a0a]/70 group-hover:text-[#c5a365] transition-colors flex items-center justify-center">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" set:html={icons[item.icon as keyof typeof icons]}></svg>
          </div>
          
          <span class="font-sans text-xs text-[#0a0a0a]/80 whitespace-pre-line leading-relaxed group-hover:text-[#0a0a0a] transition-colors font-medium">
            {item.title}
          </span>
        </div>
      ))}
    </div>

  </div>
</section>
