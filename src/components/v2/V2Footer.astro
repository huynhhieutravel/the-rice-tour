---
// src/components/v2/V2Footer.astro
import { COMPANY_INFO } from '@/config/company';
---

<footer class="w-full bg-[#0a0a0a] text-white pt-16 pb-12 border-t border-[#1a1d24] relative overflow-hidden font-sans">
  <div class="max-w-[1440px] mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <div class="grid grid-cols-1 md:grid-cols-4 gap-6 lg:gap-8 xl:gap-10 relative">
      
      <!-- Column 1: Brand & Intro -->
      <div class="col-span-1">
        <div class="flex items-center mb-2">
          <a href="/" class="group">
            <img src="https://media.thericetour.com/uploads/logo-the-rice-light.webp" alt="The Rice Tour" class="h-10 w-auto object-contain mb-3" />
          </a>
        </div>
        <p class="font-serif italic text-xs tracking-widest text-amber-400 mb-4">AUTHENTIC VIETNAM INBOUND EXPEDITIONS</p>
        <p class="text-xs text-white/70 leading-relaxed mb-6 font-light">
          Boutique inbound journeys across Vietnam. 100% private, bespoke itineraries with dedicated photography and zero shopping stops.
        </p>
        
        <ul class="space-y-1 text-sm text-white/70 font-medium">
          <li><a href="/about-us" class="inline-block py-1 hover:text-amber-400 transition-colors">About Our Story</a></li>
          <li><a href="/tailor-made" class="inline-block py-1 hover:text-amber-400 transition-colors">Tailor-Made Trip Planner</a></li>
          <li><a href="/tours" class="inline-block py-1 hover:text-amber-400 transition-colors">All Signature Tours</a></li>
          <li><a href="/destinations" class="inline-block py-1 hover:text-amber-400 transition-colors">Destinations Guide</a></li>
          <li><a href="/contact" class="inline-block py-1 hover:text-amber-400 transition-colors">Contact Our Specialists</a></li>
        </ul>
      </div>

      <!-- Column 2: Signature Tours -->
      <div class="col-span-1 flex flex-col gap-6">
        <div>
          <p class="font-serif text-amber-400 text-base font-bold uppercase tracking-wider mb-4">Signature Tours</p>
          <ul class="space-y-1.5 text-sm text-white/70 font-light">
            <li><a href="/tour/half-day-cu-chi-tunnels-tour" class="inline-block py-1 hover:text-amber-400 transition-colors">Half-Day Cu Chi Tunnels</a></li>
            <li><a href="/tour/1-day-premium-cu-chi-tunnels" class="inline-block py-1 hover:text-amber-400 transition-colors">1-Day Cu Chi &amp; Saigon</a></li>
            <li><a href="/tour/full-day-mekong-delta-tour-ben-tre-my-tho" class="inline-block py-1 hover:text-amber-400 transition-colors">Full-Day Mekong Delta (Ben Tre)</a></li>
            <li><a href="/tour/2-day-mekong-delta-tour" class="inline-block py-1 hover:text-amber-400 transition-colors">2-Day Mekong &amp; Cai Rang</a></li>
            <li><a href="/tour/ho-chi-minh-city-half-day-private-tour" class="inline-block py-1 hover:text-amber-400 transition-colors">Saigon Half-Day Private Tour</a></li>
            <li><a href="/tour/cooking-class-local-market" class="inline-block py-1 hover:text-amber-400 transition-colors">Cooking Class &amp; Local Market</a></li>
          </ul>
        </div>
      </div>

      <!-- Column 3: Destinations & Explore -->
      <div class="col-span-1">
        <p class="font-serif text-amber-400 text-base font-bold uppercase tracking-wider mb-4">Destinations &amp; Info</p>
        <ul class="space-y-1.5 text-sm text-white/70 font-light">
          <li><a href="/destination/south-vietnam" class="inline-block py-1 hover:text-amber-400 transition-colors">South Vietnam (Saigon &amp; Mekong)</a></li>
          <li><a href="/destination/mekong-delta" class="inline-block py-1 hover:text-amber-400 transition-colors">Mekong Delta Waterways</a></li>
          <li><a href="/destinations" class="inline-block py-1 hover:text-amber-400 transition-colors">All Vietnam Destinations</a></li>
          <li><a href="/tailor-made" class="inline-block py-1 hover:text-amber-400 transition-colors text-amber-300 font-medium">Plan Tailor-Made Trip →</a></li>
          <li><a href="/privacy-policy" class="inline-block py-1 hover:text-amber-400 transition-colors">Privacy Policy</a></li>
          <li><a href="/terms-of-service" class="inline-block py-1 hover:text-amber-400 transition-colors">Terms of Service</a></li>
        </ul>
      </div>

      <!-- Column 4: Contact & Concierge -->
      <div class="col-span-1 text-sm text-white/70 font-light leading-relaxed">
        <p class="font-serif text-amber-400 text-base font-bold uppercase tracking-wider mb-4">Private Concierge</p>
        
        <div class="flex flex-col gap-4">
          <a 
            href="/whatsapp" 
            target="_blank" 
            rel="noopener noreferrer"
            class="flex items-center gap-3 p-3 rounded-2xl bg-emerald-500/15 hover:bg-emerald-500/25 border border-emerald-500/30 text-white transition-all group"
          >
            <div class="w-8 h-8 rounded-xl bg-emerald-500 text-white flex items-center justify-center flex-shrink-0">
              <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24"><path d="M17.472 14.382c-.301-.15-1.78-.878-2.056-.979-.276-.1-.477-.15-.678.15-.201.301-.779.979-.955 1.18-.176.2-.351.226-.652.075-.301-.15-1.272-.469-2.424-1.496-.895-.798-1.5-1.784-1.676-2.085-.176-.301-.019-.464.132-.614.136-.135.301-.351.452-.527.15-.176.201-.301.301-.502.1-.201.05-.376-.025-.527-.075-.15-.678-1.635-.93-2.243-.245-.591-.494-.511-.678-.521-.176-.01-.376-.01-.577-.01-.201 0-.527.075-.803.376-.276.301-1.054 1.03-1.054 2.512 0 1.482 1.079 2.912 1.23 3.113.15.2 2.123 3.242 5.143 4.547.718.31 1.279.496 1.716.635.721.23 1.377.197 1.896.12.577-.087 1.78-.727 2.03-1.43.251-.703.251-1.305.176-1.43-.075-.125-.276-.201-.577-.351z"/></svg>
            </div>
            <div>
              <span class="text-[11px] font-bold uppercase tracking-wider text-emerald-400 block">WhatsApp 24/7 Concierge</span>
              <span class="font-bold text-sm text-white">{COMPANY_INFO.hotlineIntl}</span>
            </div>
          </a>

          <div>
            <span class="block text-xs uppercase font-bold text-white/50 mb-0.5">Email Support</span>
            <a href={`mailto:${COMPANY_INFO.email}`} class="text-white hover:text-amber-400 transition-colors font-medium">
              {COMPANY_INFO.email}
            </a>
          </div>

          <div class="text-xs text-white/50 space-y-1 pt-1">
            <p class="font-semibold text-white/80">{COMPANY_INFO.legalNameVi}</p>
            <p>{COMPANY_INFO.headquartersEn}</p>
            <p class="text-amber-400 font-medium">License: {COMPANY_INFO.licenseNumber}</p>
          </div>
        </div>
      </div>

    </div>

    <div class="mt-14 pt-8 border-t border-gray-800/80 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-white/50">
      <p>&copy; {new Date().getFullYear()} {COMPANY_INFO.brandName}. All rights reserved.</p>
      <div class="flex items-center gap-6">
        <a href="/about-us" class="hover:text-amber-400 transition-colors">About Us</a>
        <a href="/contact" class="hover:text-amber-400 transition-colors">Contact</a>
        <a href="/privacy-policy" class="hover:text-amber-400 transition-colors">Privacy Policy</a>
        <a href="/terms-of-service" class="hover:text-amber-400 transition-colors">Terms of Service</a>
      </div>
    </div>

  </div>
</footer>
