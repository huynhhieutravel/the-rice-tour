---
// src/components/v2/V2Hero.astro
---
<section class="relative w-full h-screen min-h-[800px] flex items-center justify-center overflow-hidden">
  
  <!-- Background Image with Overlay -->
  <div class="absolute inset-0 z-0">
    <img 
      src="https://images.unsplash.com/photo-1528127269322-539801943592?auto=format&fit=crop&w=1920&q=85" 
      alt="Vietnam Terraces and Karsts" 
      class="w-full h-full object-cover object-center"
      fetchpriority="high"
    />
    <!-- Gradient Overlay: darker at top for header, darker at bottom for next section -->
    <div class="absolute inset-0 bg-gradient-to-b from-[#0a0a0a]/80 via-black/40 to-[#0a0a0a]/95"></div>
  </div>

  <!-- Main Content -->
  <div class="relative z-10 w-full max-w-[1440px] mx-auto px-6 md:px-12 mt-20 flex flex-col justify-center h-full">
    
    <div class="max-w-3xl">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-amber-500/20 border border-amber-400/30 backdrop-blur-md mb-6">
        <span class="w-2 h-2 rounded-full bg-amber-400 animate-pulse"></span>
        <span class="text-xs uppercase tracking-[0.25em] font-semibold text-amber-300">Curated Vietnam Inbound Journeys</span>
      </div>

      <h1 class="font-serif text-white font-bold tracking-tight leading-[1.05] drop-shadow-xl uppercase">
        <span class="text-5xl sm:text-6xl md:text-7xl lg:text-8xl text-amber-400">THE RICE TOUR</span><br />
        <span class="text-xl sm:text-2xl md:text-3xl lg:text-[44px] whitespace-nowrap block mt-2 text-white">AUTHENTIC VIETNAM EXPEDITIONS</span>
      </h1>
      
      <p class="font-['Great_Vibes'] text-xl sm:text-2xl md:text-4xl lg:text-5xl text-amber-300 mt-3 md:mt-5 [text-shadow:_0_2px_8px_rgba(0,0,0,0.9),_0_0_20px_rgba(0,0,0,0.5)]">
        Hand-Crafted Itineraries &middot; Cultural Immersion &middot; 24/7 VIP Concierge
      </p>

      <div class="mt-10 flex flex-wrap items-center gap-4">
        <a href="/tours" class="px-8 py-4 bg-amber-500 hover:bg-amber-600 text-slate-950 font-extrabold text-xs uppercase tracking-[0.2em] rounded-xl shadow-lg transition-all transform hover:-translate-y-0.5">
          Explore Signature Tours
        </a>
        <a href="/tailor-made" class="px-8 py-4 bg-white/10 hover:bg-white/20 text-white font-bold text-xs uppercase tracking-[0.2em] rounded-xl backdrop-blur-md border border-white/20 transition-all">
          Design Custom Trip →
        </a>
      </div>
    </div>

  </div>

  <!-- Right Bottom Badge -->
  <div class="absolute right-8 md:right-16 bottom-24 z-10 hidden lg:flex items-center gap-4">
    <div class="w-20 h-20 relative animate-[spin_20s_linear_infinite]">
      <svg viewBox="0 0 100 100" class="w-full h-full text-amber-400">
        <path id="circlePath" d="M 50, 50 m -37, 0 a 37,37 0 1,1 74,0 a 37,37 0 1,1 -74,0" fill="none"></path>
        <text font-size="11" font-family="monospace" letter-spacing="2" fill="currentColor">
          <textPath href="#circlePath" startOffset="0%">
            ★ AUTHENTIC VIETNAM INBOUND ★
          </textPath>
        </text>
      </svg>
      <div class="absolute inset-0 flex items-center justify-center">
        <span class="font-serif text-xl font-bold text-amber-400">TRT</span>
      </div>
    </div>
    <div class="text-xs uppercase tracking-widest text-amber-400 font-bold max-w-[150px] leading-relaxed border-l border-amber-400/30 pl-4">
      Bespoke Vietnam<br />
      Inbound Travel<br />
      Specialists
    </div>
  </div>

  <!-- Bottom Scroll indicator -->
  <div class="absolute bottom-0 left-1/2 -translate-x-1/2 z-10 flex flex-col items-center pb-8 opacity-50">
    <div class="w-px h-16 bg-gradient-to-b from-transparent via-white to-transparent"></div>
  </div>
</section>
