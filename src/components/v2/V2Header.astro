---
// src/components/v2/V2Header.astro
---
<header class="absolute top-0 left-0 w-full z-50 px-6 py-5 border-b border-white/10 flex items-center justify-between">
  <!-- Left: Logo & Subtitle -->
  <div class="flex flex-col items-start">
    <a href="/" class="group flex flex-col" aria-label="The Rice Tour Home">
      <div class="flex items-center">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-amber-400 mr-2">
          <path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6" />
          <circle cx="12" cy="7" r="1.5" fill="currentColor" />
          <circle cx="15" cy="11" r="1.5" fill="currentColor" />
          <circle cx="9" cy="15" r="1.5" fill="currentColor" />
        </svg>
        <h1 class="font-serif text-2xl font-bold tracking-wider text-white uppercase leading-none mt-1">THE RICE TOUR</h1>
      </div>
      <span class="font-serif italic text-[10px] tracking-widest text-amber-400 mt-1 ml-9">Vietnam Inbound Journeys</span>
    </a>
  </div>

  <!-- Center: Navigation -->
  <nav class="hidden lg:flex items-center gap-8">
    <a href="/tours" class="text-xs font-bold uppercase tracking-widest text-white/90 hover:text-amber-400 transition-colors">Tours & Expeditions</a>
    <a href="#destinations" class="text-xs font-bold uppercase tracking-widest text-white/90 hover:text-amber-400 transition-colors">Destinations</a>
    <a href="/tailor-made" class="text-xs font-bold uppercase tracking-widest text-white/90 hover:text-amber-400 transition-colors">Tailor-Made Trips</a>
    <a href="/blog" class="text-xs font-bold uppercase tracking-widest text-white/90 hover:text-amber-400 transition-colors">Travel Guides</a>
    <a href="/about-us" class="text-xs font-bold uppercase tracking-widest text-white/90 hover:text-amber-400 transition-colors">About Us</a>
  </nav>

  <!-- Right: CTA, Search, Language -->
  <div class="hidden md:flex items-center gap-6">
    <a href="/tours" class="border border-[#c5a365]/60 px-6 py-2.5 rounded-sm text-[10px] font-bold uppercase tracking-[0.2em] text-[#c5a365] hover:bg-[#c5a365] hover:text-[#0a0a0a] transition-all">
      Start Your Journey
    </a>
    
    <button aria-label="Search" class="text-white/80 hover:text-white transition-colors">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="11" cy="11" r="8"></circle>
        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
      </svg>
    </button>
    
    <div class="flex items-center gap-1 cursor-pointer text-white/80 hover:text-white transition-colors">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="10"></circle>
        <line x1="2" y1="12" x2="22" y2="12"></line>
        <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
      </svg>
      <span class="text-xs font-bold">EN</span>
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="6 9 12 15 18 9"></polyline>
      </svg>
    </div>
  </div>
</header>
