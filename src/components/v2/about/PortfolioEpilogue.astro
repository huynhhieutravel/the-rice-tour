---
// src/components/v2/about/PortfolioEpilogue.astro
---

<section class="py-32 md:py-48 bg-white text-black relative transition-colors duration-1000">
  <div class="container mx-auto px-6 text-center">
    <span class="text-brand-600 font-sans tracking-widest text-xs uppercase mb-8 block">Epilogue</span>
    
    <h2 class="font-serif text-5xl md:text-7xl lg:text-8xl font-medium mb-12 max-w-5xl mx-auto leading-tight">
      Bức tranh tiếp theo.<br/>
      <span class="italic font-light text-neutral-400">Là của bạn.</span>
    </h2>

    <p class="font-sans text-neutral-600 text-xl md:text-2xl font-light max-w-2xl mx-auto mb-16">
      Hãy để chúng tôi lắng nghe "Guu" của bạn và bắt đầu điêu khắc một hành trình vượt ranh giới ngay hôm nay.
    </p>

    <a href="https://m.me/fittour.com.vn" target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center px-10 py-5 bg-black text-white font-sans text-sm tracking-[0.2em] uppercase hover:bg-neutral-800 transition-colors duration-300 rounded-sm group">
      <span>Bắt Đầu Hành Trình</span>
      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 ml-4 transform group-hover:translate-x-2 transition-transform duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 8l4 4m0 0l-4 4m4-4H3" />
      </svg>
    </a>
  </div>
</section>
