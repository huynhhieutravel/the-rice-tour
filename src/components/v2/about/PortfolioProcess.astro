---
// src/components/v2/about/PortfolioProcess.astro
---

<section class="bg-black text-white relative">
  <!-- Sticky container -->
  <div class="container mx-auto px-6 h-[300vh] relative" id="process-container">
    
    <!-- Title section (Sticky) -->
    <div class="sticky top-0 h-screen flex flex-col justify-center w-full md:w-1/2 pr-12 z-20">
      <span class="text-brand-500 font-sans tracking-widest text-xs uppercase mb-4 block">Chế tác</span>
      <h2 class="font-serif text-4xl md:text-6xl text-white mb-6 leading-tight">Quy trình<br/>Bespoke</h2>
      <p class="font-sans text-neutral-400 text-lg font-light max-w-md">
        Một hành trình có guu không sinh ra từ dây chuyền đại trà. Nó được điêu khắc thủ công qua 3 giai đoạn khắt khe.
      </p>
    </div>

    <!-- Scroll Content (Moves up beside the sticky title on Desktop, under on Mobile) -->
    <div class="absolute top-0 right-0 w-full md:w-1/2 h-full flex flex-col justify-between pt-[50vh] pb-[50vh] px-6 md:px-0 z-10">
      
      <!-- Step 1 -->
      <div class="h-screen flex items-center justify-start md:pl-12 opacity-30 transition-opacity duration-500 process-step">
        <div class="max-w-lg">
          <span class="font-serif text-6xl text-neutral-800 mb-4 block">01</span>
          <h3 class="font-serif text-3xl md:text-4xl text-white mb-4">Lắng nghe "Guu"</h3>
          <p class="font-sans text-neutral-300 font-light text-lg">
            Chúng tôi không bắt đầu bằng một lịch trình in sẵn. Mọi thứ bắt đầu bằng một cuộc trò chuyện. Bạn thích sự tĩnh lặng của thiền viện hay sự hưng phấn khi băng qua sa mạc?
          </p>
        </div>
      </div>

      <!-- Step 2 -->
      <div class="h-screen flex items-center justify-start md:pl-12 opacity-30 transition-opacity duration-500 process-step">
        <div class="max-w-lg">
          <span class="font-serif text-6xl text-neutral-800 mb-4 block">02</span>
          <h3 class="font-serif text-3xl md:text-4xl text-white mb-4">Điêu khắc Hành trình</h3>
          <p class="font-sans text-neutral-300 font-light text-lg">
            Những chuyên gia am tường địa phương của chúng tôi bắt tay vào việc "cắt may" lịch trình. Từng điểm đến, từng trạm dừng, từng món ăn đều được giám tuyển kỹ lưỡng để khớp với nhịp sinh học và sở thích của bạn.
          </p>
        </div>
      </div>

      <!-- Step 3 -->
      <div class="h-screen flex items-center justify-start md:pl-12 opacity-30 transition-opacity duration-500 process-step">
        <div class="max-w-lg">
          <span class="font-serif text-6xl text-neutral-800 mb-4 block">03</span>
          <h3 class="font-serif text-3xl md:text-4xl text-white mb-4">Vượt ngàn trùng khơi</h3>
          <p class="font-sans text-neutral-300 font-light text-lg">
            Khâu thực thi hoàn hảo là minh chứng cho đẳng cấp. Tour Leader của chúng tôi không chỉ là người dẫn đường, họ là những người bạn đồng hành, xử lý mượt mà mọi rủi ro để bạn toàn tâm đắm chìm vào không gian.
          </p>
        </div>
      </div>

    </div>
  </div>
</section>

<script>
  // Simple intersection observer to highlight steps
  const steps = document.querySelectorAll('.process-step');
  
  const stepObserver = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.remove('opacity-30');
        entry.target.classList.add('opacity-100');
      } else {
        entry.target.classList.add('opacity-30');
        entry.target.classList.remove('opacity-100');
      }
    });
  }, { 
    threshold: 0.5,
    rootMargin: "-20% 0px -20% 0px"
  });

  steps.forEach(step => stepObserver.observe(step));
</script>
