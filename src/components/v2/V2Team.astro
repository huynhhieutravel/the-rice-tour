---
// src/components/v2/V2Team.astro

const teamMembers = [
  {
    name: "Max Vũ",
    role: "CEO & Founder",
    experience: "10 năm",
    image: "https://media.fittour.vn/uploads/max-vu-founder-fit-tour.webp",
    link: "/max-vu"
  },
  {
    name: "Tiêu Văn Sang",
    role: "HDV Quốc tế",
    experience: "8 năm",
    image: "https://media.fittour.vn/uploads/2025/04/hdv-tieu-van-sang-fittour.webp",
    link: "/hdv-tieu-sang"
  },
  {
    name: "Võ Thị Hồng Trang",
    role: "Trip Planner & Guide",
    experience: "6 năm",
    image: "https://media.fittour.vn/uploads/huong-dan-vien-hong-trang-ao-dai-ben-bien.webp",
    link: "/hong-trang"
  },
  {
    name: "Ngô Ngọc Đăng Huy",
    role: "Trip Planner & Guide",
    experience: "5 năm",
    image: "https://media.fittour.vn/uploads/hdv-huy-ngo-fittour.webp",
    link: "/hdv-huy-ngo"
  },
  {
    name: "Trần Thịnh",
    role: "Trip Planner & Guide",
    experience: "8 năm",
    image: "https://media.fittour.vn/uploads/2024/05/trip-planner-tran-thinh.webp",
    link: "/tran-quoc-thinh"
  },
  {
    name: "Lê Thái Bình",
    role: "HDV Quốc tế",
    experience: "15 năm",
    image: "https://media.fittour.vn/uploads/2025/05/hdv-le-thai-binh-fittour.webp",
    link: "/le-thai-binh"
  }
];
---

<section id="team" class="w-full bg-[#0a0a0a] py-20 border-t border-white/5">
  <div class="max-w-[1600px] mx-auto px-6 md:px-12">
    
    <!-- Header -->
    <div class="flex flex-col md:flex-row items-start md:items-end justify-between mb-12 gap-4">
      <div>
        <p class="font-mono text-[10px] text-[#c5a365] uppercase tracking-[0.3em] mb-3 font-semibold">The People Behind The Journey</p>
        <h2 class="font-serif text-2xl md:text-3xl text-white tracking-widest uppercase">
          Our Team
        </h2>
      </div>
      <a href="/our-team/" class="text-[10px] font-bold uppercase tracking-[0.2em] text-[#c5a365] hover:text-white transition-colors flex items-center gap-2 group">
        Xem thêm
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="group-hover:translate-x-1 transition-transform"><polyline points="9 18 15 12 9 6"></polyline></svg>
      </a>
    </div>

    <!-- Team Grid -->
    <div class="flex md:grid md:grid-cols-3 lg:grid-cols-6 gap-5 overflow-x-auto snap-x snap-mandatory pb-6 md:pb-0" style="scrollbar-width: none;">
      {teamMembers.map((member) => (
        <a href={member.link || undefined} class="group block cursor-pointer shrink-0 w-[55vw] sm:w-[40vw] md:w-auto snap-center">
          <!-- Portrait Card -->
          <div class="relative aspect-[3/4] overflow-hidden rounded-xl border border-white/10 group-hover:border-[#c5a365]/40 transition-all duration-500">
            <img 
              src={member.image} 
              alt={member.name} 
              class="absolute inset-0 w-full h-full object-cover object-top group-hover:scale-105 transition-transform duration-700 brightness-[80%] group-hover:brightness-100"
              loading="lazy"
            />
            
            <!-- Gradient overlay -->
            <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/20 to-transparent"></div>
            
            <!-- Experience badge -->
            <div class="absolute top-3 right-3 px-2 py-1 bg-black/50 backdrop-blur-sm border border-white/15 rounded-full">
              <span class="font-mono text-[9px] text-[#c5a365] tracking-wider font-bold uppercase">{member.experience}</span>
            </div>

            <!-- Info overlay -->
            <div class="absolute bottom-0 inset-x-0 p-4 text-center">
              <h3 class="font-serif text-base text-white font-bold mb-0.5 leading-tight">
                {member.name}
              </h3>
              <p class="font-mono text-[9px] text-[#c5a365] uppercase tracking-[0.15em] font-bold">
                {member.role}
              </p>
            </div>
          </div>
        </a>
      ))}
    </div>

    <!-- Bottom tagline -->
    <div class="mt-10 text-center">
      <p class="text-sm text-white/40 font-sans leading-relaxed max-w-2xl mx-auto">
        Chúng tôi không chỉ tổ chức chuyến đi – chúng tôi đồng hành cùng quý khách trên từng bước hành trình khám phá thế giới.
      </p>
    </div>

  </div>
</section>
