---
// src/components/v2/V2Collections.astro
import DongAQuickViewModal from '@/components/dong-a/DongAQuickViewModal.astro';

const collections = [
  {
    title: "MAJESTIC\nCHINA",
    subtitle: "China Beyond\nThe Ordinary",
    image: "https://media.fittour.vn/uploads/nen-trung-quoc-standee.webp",
    locations: "BEIJING · SHANGHAI · XIAN · TIBET · XINJIANG · DAOCHENG",
    link: "/country/trung-quoc/",
    icon: "pagoda"
  },
  {
    title: "HIMALAYA",
    subtitle: "Gentle Himalaya\nDreamlike & Safe",
    image: "https://media.fittour.vn/uploads/2022/11/du-khach-chim-dam-voi-ve-dep-cua-nui-non-himalayas.webp",
    locations: "LADAKH · TIBET · BHUTAN · NEPAL · PAKISTAN",
    link: "/country/himalaya",
    icon: "mountain"
  },
  {
    title: "SILK ROAD",
    subtitle: "Across Deserts\nAcross Civilizations",
    image: "https://media.fittour.vn/uploads/mua-xuan-pakistan-poster.webp",
    locations: "MONGOLIA · KAZAKHSTAN · KYRGYZSTAN · TURKEY · IRAN",
    link: "/country/silkroad",
    icon: "camel"
  },
  {
    title: "AFRICAN BESPOKE",
    subtitle: "Beyond\nThe Wild",
    image: "https://media.fittour.vn/uploads/du-khach-tan-huong-safari-chau-phi.webp",
    locations: "EGYPT · MOROCCO · NAMIBIA · KENYA · SOUTH AFRICA",
    link: "/country/chau-phi",
    icon: "elephant"
  },
  {
    title: "ARCTIC",
    subtitle: "Chasing Light\nAcross The North",
    image: "https://media.fittour.vn/uploads/2024/04/doan-du-khach-fit-tour-don-cuc-quang-o-iceland.webp",
    locations: "MURMANSK · ICELAND · LAPLAND · ALASKA · SVALBARD · GREENLAND",
    link: "/country/bac-cuc",
    icon: "mountain"
  },
  {
    title: "EAST ASIA",
    subtitle: "Timeless Heritage.\nModern Soul.",
    image: "https://media.fittour.vn/uploads/2023/07/khung-canh-lang-tuyet-nhu-mot-bo-phim-han-quoc.webp",
    locations: "JAPAN · KOREA · TAIWAN",
    modalTarget: "dong-a",
    icon: "pagoda"
  }
];
---

<section id="collections" class="w-full bg-[#0a0a0a] py-24 relative overflow-hidden">
  <div class="max-w-[1600px] mx-auto px-6 md:px-12">
    
    <!-- Section Header -->
    <div class="flex flex-col items-center justify-center text-center mb-16 relative">
      <!-- Mountain Icon -->
      <svg width="40" height="20" viewBox="0 0 100 50" fill="none" stroke="#c5a365" stroke-width="2" class="mb-4">
        <path d="M10,50 L30,20 L40,35 L60,5 L80,35 L90,20 L100,50" />
      </svg>
      
      <div class="flex items-center gap-6 w-full max-w-4xl">
        <div class="h-px bg-white/10 flex-grow"></div>
        <h2 class="font-serif text-3xl md:text-4xl text-[#c5a365] tracking-widest uppercase">
          Explore Our Collections
        </h2>
        <div class="h-px bg-white/10 flex-grow"></div>
      </div>
      
      <p class="font-['Great_Vibes'] text-2xl text-white/80 mt-4 tracking-wide">
        Six Worlds. Endless Stories.
      </p>


    </div>

    <!-- Collections Grid / Carousel -->
    <div class="flex md:grid md:grid-cols-3 lg:grid-cols-6 gap-4 md:gap-6 overflow-x-auto snap-x snap-mandatory pb-6 md:pb-0" style="scrollbar-width: none;">
      {collections.map((item) => (
        item.modalTarget ? (
          <button data-tour-modal={item.modalTarget} class="group relative text-left shrink-0 w-[80vw] md:w-auto snap-center aspect-[3/5] rounded-xl overflow-hidden cursor-pointer block border border-white/10 hover:border-[#c5a365]/50 transition-colors duration-500">
            <!-- Background Image -->
            <img 
              src={item.image} 
              alt={item.title} 
              class="absolute inset-0 w-full h-full object-cover grayscale-[40%] group-hover:grayscale-0 group-hover:scale-105 transition-all duration-700 brightness-[80%]"
            />
            <!-- Gradient overlay -->
            <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/30 to-transparent"></div>
            <!-- Content -->
            <div class="absolute inset-0 p-6 flex flex-col justify-end text-center z-10">
              <h3 class="font-serif text-xl md:text-2xl text-white font-bold tracking-widest uppercase mb-1 whitespace-pre-line">
                {item.title}
              </h3>
              <p class="text-[10px] text-[#c5a365] uppercase tracking-[0.2em] mb-4 font-bold">Collection</p>
              <p class="font-serif italic text-white/80 text-sm mb-6 leading-relaxed whitespace-pre-line">
                {item.subtitle}
              </p>
              <div class="w-8 h-px bg-[#c5a365] mx-auto mb-6"></div>
              <p class="font-mono text-[9px] text-white/60 uppercase tracking-widest whitespace-pre-line leading-relaxed mb-6 group-hover:text-white transition-colors">
                {item.locations}
              </p>
              <div class="w-8 h-8 mx-auto rounded-full border border-white/30 flex items-center justify-center group-hover:bg-[#c5a365] group-hover:border-[#c5a365] transition-all">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-white group-hover:text-black transition-colors"><polyline points="9 18 15 12 9 6"></polyline></svg>
              </div>
            </div>
          </button>
        ) : (
          <a href={item.link} class="group relative shrink-0 w-[80vw] md:w-auto snap-center aspect-[3/5] rounded-xl overflow-hidden cursor-pointer block border border-white/10 hover:border-[#c5a365]/50 transition-colors duration-500">
            
            <!-- Background Image -->
            <img 
              src={item.image} 
              alt={item.title} 
              class="absolute inset-0 w-full h-full object-cover grayscale-[40%] group-hover:grayscale-0 group-hover:scale-105 transition-all duration-700 brightness-[80%]"
            />
            
            <!-- Gradient overlay -->
            <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/30 to-transparent"></div>

            <!-- Content -->
            <div class="absolute inset-0 p-6 flex flex-col justify-end text-center z-10">
              <!-- Icon placeholder - dynamically add based on item.icon if we have SVG paths -->
              
              <h3 class="font-serif text-xl md:text-2xl text-white font-bold tracking-widest uppercase mb-1 whitespace-pre-line">
                {item.title}
              </h3>
              <p class="text-[10px] text-[#c5a365] uppercase tracking-[0.2em] mb-4 font-bold">Collection</p>
              
              <p class="font-serif italic text-white/80 text-sm mb-6 leading-relaxed whitespace-pre-line">
                {item.subtitle}
              </p>

              <div class="w-8 h-px bg-[#c5a365] mx-auto mb-6"></div>

              <p class="font-mono text-[9px] text-white/60 uppercase tracking-widest whitespace-pre-line leading-relaxed mb-6 group-hover:text-white transition-colors">
                {item.locations}
              </p>

              <!-- Arrow button -->
              <div class="w-8 h-8 mx-auto rounded-full border border-white/30 flex items-center justify-center group-hover:bg-[#c5a365] group-hover:border-[#c5a365] transition-all">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-white group-hover:text-black transition-colors"><polyline points="9 18 15 12 9 6"></polyline></svg>
              </div>
            </div>
          </a>
        )
      ))}
    </div>


  </div>
</section>

<DongAQuickViewModal />
