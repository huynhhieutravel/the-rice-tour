---
// src/components/v2/V2Destinations.astro

const destinations = [
  { name: "LADAKH", country: "INDIA", image: "https://media.fittour.vn/uploads/tu-vien-cheo-leo-ladakh-poster.webp", link: "/country/ladakh" },
  { name: "TIBET", country: "CHINA", image: "https://media.fittour.vn/uploads/2023/03/ho-yamdrok.webp", link: "/country/tay-tang" },
  { name: "BHUTAN", country: "BHUTAN", image: "https://media.fittour.vn/uploads/2023/07/tu-vien-tigers-nest-tren-vach-da.webp", link: "/country/bhutan" },
  { name: "MONGOLIA", country: "MONGOLIA", image: "https://media.fittour.vn/uploads/2025/07/motor-trip-mong-co-chay-xuyen-doi-co-vang.webp", link: "/tour/tour-mong-co-8n7d" },
  { name: "JIANGNAN", country: "CHINA", image: "https://media.fittour.vn/uploads/2024/05/nhung-doa-hoa-no-ro-ven-cac-ngoi-nha-co-kinh-tao-nen-khung-canh-nen-tho-tai-o-tran.webp", link: "/country/trung-quoc" },
  { name: "ICELAND", country: "ICELAND", image: "https://media.fittour.vn/uploads/2024/04/cuc-quang-la-dieu-hap-dan-ma-doi-khi-ban-chi-nhin-thay-1-lan-trong-doi.webp", link: "/country/iceland" },
  { name: "EGYPT", country: "EGYPT", image: "https://media.fittour.vn/uploads/2023/01/du-khach-xem-xet-chi-tiet-cac-hinh-ve-ai-cap-co-dai.webp", link: "/country/ai-cap" }
];
---

<section id="destinations" class="w-full bg-[#0a0a0a] py-20 border-t border-white/5">
  <div class="max-w-[1600px] mx-auto px-6 md:px-12">
    
    <!-- Header -->
    <div class="flex items-end justify-between mb-10 pb-4 border-b border-white/10">
      <h2 class="font-serif text-2xl md:text-3xl text-white tracking-widest uppercase">
        Curated Experiences
      </h2>
      <a href="/tours/" class="text-[10px] font-bold uppercase tracking-[0.2em] text-[#c5a365] hover:text-white transition-colors">
        View All Destinations
      </a>
    </div>

    <!-- Grid -->
    <div class="flex md:grid md:grid-cols-4 lg:grid-cols-7 gap-4 overflow-x-auto snap-x snap-mandatory pb-4 md:pb-0" style="scrollbar-width: none;">
      {destinations.map((dest) => (
        <a href={dest.link} class="group relative shrink-0 w-[45vw] md:w-auto snap-center aspect-[4/5] md:aspect-square lg:aspect-[4/5] rounded-lg overflow-hidden block border border-white/5 hover:border-[#c5a365]/40 transition-all duration-500">
          
          <!-- Image -->
          <img 
            src={dest.image} 
            alt={dest.name} 
            class="absolute inset-0 w-full h-full object-cover group-hover:scale-110 transition-transform duration-700 brightness-[85%] grayscale-[20%] group-hover:grayscale-0"
          />
          
          <!-- Overlay -->
          <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/20 to-transparent opacity-80 group-hover:opacity-100 transition-opacity"></div>
          
          <!-- Content -->
          <div class="absolute inset-x-0 bottom-0 p-4 md:p-5 flex flex-col justify-end translate-y-2 group-hover:translate-y-0 transition-transform">
            <h3 class="font-serif text-lg md:text-xl text-white font-bold tracking-wider uppercase drop-shadow-md">
              {dest.name}
            </h3>
            <p class="font-mono text-[9px] text-[#c5a365] uppercase tracking-widest mt-1">
              {dest.country}
            </p>
          </div>
        </a>
      ))}
    </div>

  </div>
</section>
