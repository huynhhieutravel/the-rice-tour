---
import Button from './Button.astro';
import { getOptimizedImageUrl } from '@/lib/imageOptimization';

export interface ButtonType {
  label: string;
  href?: string;
  type?: 'primary' | 'secondary' | 'outline' | 'ghost';
  icon?: 'zalo' | 'messenger' | 'phone' | 'map';
}

export interface Props {
  layout?: 'split' | 'banner' | 'compact' | 'premium' | 'gallery_booking';
  intent?: 'lead' | 'info' | 'contact';
  preset?: 'contact' | 'tour';
  title?: string;
  subtitle?: string;
  content?: string;
  image?: {
    url: string;
    width?: number;
    height?: number;
    alt?: string;
  } | string; // Support old string format just in case
  buttons?: ButtonType[];
  hideOnMobile?: boolean;
  settings?: Record<string, any>;
  className?: string;
  isLcp?: boolean;
}

const {
  layout = 'split',
  intent,
  preset,
  title,
  subtitle,
  content,
  image,
  buttons: customButtons,
  hideOnMobile = false,
  settings = Astro.locals?.siteSettings || {},
  className = '',
  isLcp = false
} = Astro.props;

// Preset Logic: Automatically generate buttons if preset is used
let activeButtons = customButtons || [];
if (activeButtons.length === 0 && preset === 'contact') {
  activeButtons = [
    { label: 'Chat Zalo', type: 'primary', icon: 'zalo' },
    { label: 'Messenger', type: 'secondary', icon: 'messenger' },
    { label: 'Gọi Ngay', type: 'outline', icon: 'phone' }
  ];
} else if (activeButtons.length === 0 && preset === 'tour') {
  activeButtons = [
    { label: 'Nhận Tư Vấn', type: 'primary', icon: 'phone' },
    { label: 'Zalo', type: 'secondary', icon: 'zalo' }
  ];
}

// Fallback logic for buttons using settings
const ICON_TO_SETTING: Record<string, string> = {
  phone: 'contact.phone',
  zalo: 'contact.zalo',
  messenger: 'contact.facebook',
  map: 'contact.map'
};

function getSettingValue(path: string) {
  return path.split('.').reduce((acc, part) => acc && acc[part], settings) as string | undefined;
}

const resolvedButtons = activeButtons.map(btn => {
  let finalHref = btn.href;
  if (!finalHref && btn.icon && ICON_TO_SETTING[btn.icon]) {
    const settingValue = getSettingValue(ICON_TO_SETTING[btn.icon]);
    if (settingValue) {
      if (btn.icon === 'phone' && !settingValue.startsWith('tel:')) finalHref = `tel:${settingValue}`;
      else finalHref = settingValue;
    }
  }
  return { ...btn, href: finalHref || '#' };
});

// Image resolution
const imageUrl = typeof image === 'string' ? image : image?.url;
const optimizedImage = imageUrl ? getOptimizedImageUrl(imageUrl, 800) : null;

// Layout Classes
const layoutStyles = {
  split: "bg-surface rounded-2xl p-6 md:p-8 my-10 flex flex-col md:flex-row gap-8 items-center border border-border shadow-sm",
  banner: "w-full bg-brand-500 text-white rounded-xl p-8 my-12 flex flex-col items-center text-center shadow-lg relative overflow-hidden",
  compact: "bg-surface rounded-xl p-4 md:p-6 my-8 flex flex-col md:flex-row gap-4 items-center justify-between border border-border shadow-sm",
  premium: "cta-premium"
};

const displayClass = hideOnMobile ? "hidden md:flex" : "flex";
---

{layout === 'split' && (
  <div class:list={[layoutStyles.split, displayClass, className]}>
    <div class="w-full md:w-1/2 flex flex-col items-start text-left gap-4">
      {subtitle && <span class="text-xs font-bold uppercase tracking-wider text-brand-700">{subtitle}</span>}
      {title && <div class="!mt-0 !mb-2 text-2xl font-bold text-primary leading-snug">{title}</div>}
      {content && <div class="text-secondary text-sm prose prose-sm max-w-none" set:html={content} />}
      
      {resolvedButtons.length > 0 && (
        <div class="flex flex-wrap gap-3 mt-2 w-full">
          {resolvedButtons.map(btn => (
            <Button href={btn.href} type={btn.type} icon={btn.icon} data-cta={`${layout}-${btn.icon || 'btn'}`}>
              {btn.label}
            </Button>
          ))}
        </div>
      )}
    </div>
    
    {optimizedImage && (
      <div class="w-full md:w-1/2 aspect-video rounded-xl overflow-hidden shadow-sm flex-shrink-0">
        <img src={optimizedImage} alt={typeof image !== 'string' ? image?.alt || title : title} class="w-full h-full object-cover m-0 transition-transform duration-500 hover:scale-105" loading={isLcp ? undefined : "lazy"} fetchpriority={isLcp ? "high" : undefined} />
      </div>
    )}
  </div>
)}

{layout === 'banner' && (
  <div class:list={[layoutStyles.banner, displayClass, className]}>
    {/* Decorative blur */}
    <div class="absolute -right-10 -top-10 w-40 h-40 bg-white rounded-full blur-3xl opacity-10 pointer-events-none"></div>
    <div class="absolute -left-10 -bottom-10 w-40 h-40 bg-white rounded-full blur-3xl opacity-10 pointer-events-none"></div>

    <div class="z-10 flex flex-col items-center gap-4 max-w-2xl mx-auto">
      {title && <div class="!mt-0 !mb-0 text-3xl font-bold text-white leading-tight">{title}</div>}
      {content && <div class="text-white/80 text-base" set:html={content} />}
      
      {resolvedButtons.length > 0 && (
        <div class="flex flex-wrap justify-center gap-4 mt-4 w-full">
          {resolvedButtons.map(btn => (
            // Force secondary/ghost types to stand out on dark background
            <Button href={btn.href} type={btn.type === 'primary' ? 'secondary' : 'ghost'} icon={btn.icon} className={btn.type !== 'primary' ? 'bg-white/10 hover:bg-white/20 text-white' : ''} data-cta={`${layout}-${btn.icon || 'btn'}`}>
              {btn.label}
            </Button>
          ))}
        </div>
      )}
    </div>
  </div>
)}

{layout === 'compact' && (
  <div class:list={[layoutStyles.compact, displayClass, className]}>
    <div class="flex flex-col text-left gap-1">
      {title && <div class="!m-0 text-base font-bold text-primary">{title}</div>}
      {content && <span class="text-sm text-secondary" set:html={content} />}
    </div>
    
    {resolvedButtons.length > 0 && (
      <div class="flex flex-wrap items-center gap-3 shrink-0">
        {resolvedButtons.map(btn => (
          <Button href={btn.href} type={btn.type} icon={btn.icon} data-cta={`${layout}-${btn.icon || 'btn'}`}>
            {btn.label}
          </Button>
        ))}
      </div>
    )}
  </div>
)}

{layout === 'premium' && (
  <div class:list={[layoutStyles.premium, displayClass, className]}>
    <div class="cta-premium-bg">
      {optimizedImage && <img src={optimizedImage} alt={typeof image !== 'string' ? image?.alt || title : title} loading="lazy" />}
    </div>
    <div class="cta-premium-content">
      {subtitle && <div class="cta-premium-badge">{subtitle}</div>}
      
      {title && (
        <div class="cta-premium-title" set:html={title.replace(/Fit Tour/i, '<span>Fit Tour</span>')} />
      )}
      
      {content && <p class="cta-premium-subtitle" set:html={content} />}
      
      {settings?.['contact.zalo'] && settings?.['contact.phone'] && (
        <div class="cta-premium-features">
          <div class="cta-premium-feature">
            <div class="cta-premium-feature-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            </div>
            <div class="cta-premium-feature-text">
              <span class="cta-premium-feature-title">Hỗ trợ 24/7</span>
              <span class="cta-premium-feature-desc">{settings['contact.phone']}</span>
            </div>
          </div>
        </div>
      )}

      {resolvedButtons.length > 0 && (
        resolvedButtons.map((btn, i) => (
          i === 0 && (
             <a href={btn.href} class="cta-premium-btn" data-cta={`premium-${btn.icon || 'btn'}`}>
                {btn.label}
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
             </a>
          )
        ))
      )}
    </div>
  </div>
)}

{layout === 'gallery_booking' && (
  <div class:list={["grid grid-cols-1 md:grid-cols-2 gap-8 items-center bg-subtle rounded-[2rem] p-8 md:p-12 shadow-sm border border-border my-12", hideOnMobile ? "hidden md:grid" : "", className]}>
    <div class="space-y-8">
      <div>
        {title && <div class="text-primary font-bold text-xl mb-3">{title}</div>}
        {subtitle && <p class="text-text-main text-base mb-3 leading-relaxed">{subtitle}</p>}
        {content && <div class="text-text-muted text-sm mb-4 leading-relaxed max-w-none" set:html={content} />}
      </div>
      
      <div class="flex items-center gap-5">
        {settings?.['contact.facebook'] && (
          <a href={settings['contact.facebook']} class="btn-app-icon" title="Messenger">
            <img src="/images/icons/messenger.webp" alt="Messenger" />
          </a>
        )}
        {settings?.['contact.phone'] && (
          <a href={`tel:${settings['contact.phone']}`} class="btn-app-icon" title="Phone">
            <img src="/images/icons/phone.svg" alt="Phone" />
          </a>
        )}
        {settings?.['contact.map'] && (
          <a href={settings['contact.map']} class="btn-app-icon" title="Maps">
            <img src="/images/icons/maps.webp" alt="Maps" />
          </a>
        )}
      </div>
      
      {settings?.['contact.zalo'] && (
        <a href={settings['contact.zalo']} class="btn-primary btn-lg w-full sm:w-auto">
          <img src="/images/icons/zalo.webp" alt="Zalo" style="width: 32px; height: 32px; margin-right: 12px; border-radius: 8px; box-shadow: 0 1px 2px rgba(0,0,0,0.1);" />
          Nhắn Zalo Ngay
        </a>
      )}
    </div>
    
    {optimizedImage && (
      <div class="rounded-2xl overflow-hidden shadow-2xl ring-1 ring-slate-900/5 aspect-[4/3] md:aspect-auto h-full min-h-[300px]">
        <img src={optimizedImage} alt={typeof image !== 'string' ? image?.alt || title : title} class="w-full h-full object-cover hover:scale-105 transition-transform duration-700" loading={isLcp ? undefined : "lazy"} fetchpriority={isLcp ? "high" : undefined} />
      </div>
    )}
  </div>
)}
