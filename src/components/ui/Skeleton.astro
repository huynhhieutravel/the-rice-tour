---
// Component Skeleton Loading
const { type = 'text', className = '' } = Astro.props;

// predefined types: text, title, image, card, avatar
---

{type === 'text' && (
  <div class={`h-4 bg-subtle rounded w-full animate-pulse ${className}`}></div>
)}

{type === 'title' && (
  <div class={`h-8 bg-subtle rounded w-3/4 animate-pulse ${className}`}></div>
)}

{type === 'image' && (
  <div class={`bg-subtle rounded-xl animate-pulse ${className}`}></div>
)}

{type === 'avatar' && (
  <div class={`rounded-full bg-subtle animate-pulse ${className}`}></div>
)}

{type === 'card' && (
  <div class={`bg-surface border border-border rounded-2xl overflow-hidden shadow-sm animate-pulse ${className}`}>
    <div class="w-full h-48 bg-subtle"></div>
    <div class="p-5 space-y-4">
      <div class="h-6 bg-subtle rounded w-3/4"></div>
      <div class="space-y-2">
        <div class="h-4 bg-subtle rounded w-full"></div>
        <div class="h-4 bg-subtle rounded w-5/6"></div>
      </div>
      <div class="h-10 bg-subtle rounded-full w-full mt-4"></div>
    </div>
  </div>
)}
