---
export interface Props {
  href?: string;
  type?: 'primary' | 'secondary' | 'outline' | 'ghost';
  icon?: 'zalo' | 'messenger' | 'phone' | 'map';
  className?: string;
  target?: string;
  rel?: string;
  'data-cta'?: string;
}

const { 
  href, 
  type = 'primary', 
  icon, 
  className = '',
  target = '_blank',
  rel = 'noopener noreferrer',
  'data-cta': dataCta
} = Astro.props;

const Element = href ? 'a' : 'button';

const baseStyles = "inline-flex items-center justify-center gap-2 font-semibold transition-all duration-300 rounded-lg whitespace-nowrap shadow-sm";

const typeStyles = {
  primary: "bg-brand-500 hover:bg-brand-600 text-white border border-transparent",
  secondary: "bg-surface hover:bg-brand-50 text-brand-700 border border-brand-100",
  outline: "bg-transparent hover:bg-subtle text-primary border border-border",
  ghost: "bg-transparent hover:bg-subtle text-secondary shadow-none"
};

// Size mapping (can be extended)
const sizeStyles = "px-5 py-2.5 text-sm";

const iconMap = {
  zalo: `<svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M21.1 9.6c0-4.6-4.1-8.3-9.1-8.3-5.1 0-9.1 3.7-9.1 8.3 0 2.6 1.3 5 3.5 6.5l-1.3 3.8c-.1.3.1.5.3.6.1.1.2.1.3.1.1 0 .2 0 .3-.1l4.2-2.3c1.2.3 2.5.5 3.8.5 5 0 9.1-3.7 9.1-8.3M15.4 12c-.2 0-.3-.1-.3-.3v-1.6c0-.5-.4-.9-.9-.9s-.9.4-.9.9v1.6c0 .2-.1.3-.3.3-.2 0-.3-.1-.3-.3V10c0-.5-.4-.9-.9-.9s-.9.4-.9.9v1.8c0 .2-.1.3-.3.3-.2 0-.3-.1-.3-.3V8.8c0-.2.1-.3.3-.3s.3.1.3.3v2c0 .2.3.2.3 0v-2c0-.2.1-.3.3-.3s.3.1.3.3v2.8c0 .2.3.2.3 0v-2.8c0-.2.1-.3.3-.3s.3.1.3.3v2.8c0 .2.3.2.3 0v-2.8c0-.2.1-.3.3-.3s.3.1.3.3V11.7c0 .2-.1.3-.3.3z"/></svg>`,
  messenger: `<svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M12 2C6.477 2 2 6.14 2 11.25c0 2.898 1.458 5.462 3.738 7.152.261.194.428.513.43.844l.024 2.164a.823.823 0 001.314.622l2.368-1.74a.886.886 0 01.761-.141C11.085 20.306 11.537 20.5 12 20.5c5.523 0 10-4.14 10-9.25S17.523 2 12 2zm1.18 12.355l-2.617-2.793a.936.936 0 00-1.428-.016L5.59 15.6c-.463.465-1.168-.135-.805-.68l3.66-5.467a1.455 1.455 0 012.227-.225l2.607 2.784a.936.936 0 001.428.016l3.555-4.065c.463-.465 1.168.135.805.68l-3.66 5.467a1.455 1.455 0 01-2.227.225z"/></svg>`,
  phone: `<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>`,
  map: `<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>`
};
---

<Element 
  href={href} 
  target={href ? target : undefined}
  rel={href ? rel : undefined}
  class:list={[baseStyles, typeStyles[type], sizeStyles, className]}
  data-cta={dataCta || icon || 'button'}
>
  {icon && iconMap[icon] && <span class="flex-shrink-0" set:html={iconMap[icon]} />}
  <slot />
</Element>
