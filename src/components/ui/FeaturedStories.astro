---
import { Shield, MapPin, Quote } from 'lucide-react';

const STORIES = [
  {
    title: "CÔ MÂY - U70 ĐI LADAKH",
    vibe: "Gió Lạnh Tuyết Trắng — 5,359m",
    imageUrl: "https://media.fittour.vn/uploads/emagazine-u70-chinh-phuc-ladakh.webp",
    quote: "Ở độ cao nghẹt thở này, hơi thở tôi mỏng mảnh nhưng khát khao của tôi lại dày dặn hơn bao giờ hết. Khi gió quất lạnh buốt, tôi tự hào vì gối mình không quỵ ngã.",
    badge: "ACTIVE EXPLORER",
    coordinates: "34.2787° N, 77.6047° E",
    link: "/co-may",
    shortTitle: "Cô Mây",
    author: "Cloudy May • 1958",
    authorDesc: "Phượt thủ 68 tuổi"
  },
  {
    title: "KAILASH KORA - TÂM LINH",
    vibe: "Hành Hương Núi Tu Di — 6,638m",
    imageUrl: "https://media.fittour.vn/uploads/2024/07/hanh-trinh-kora-kailash-fittour.webp",
    quote: "Đứng trước vẻ đẹp hùng vĩ của ngọn núi thiêng Kailash, mọi mệt mỏi của chặng đường hành hương như tan biến, nhường chỗ cho sự bình yên tuyệt đối trong tâm hồn.",
    badge: "SPIRITUAL JOURNEY",
    coordinates: "31.0658° N, 81.3134° E",
    link: "/nhat-ky-hanh-trinh-hanh-huong-nui-kailash",
    shortTitle: "Kailash",
    author: "Hành Hương Kora",
    authorDesc: "Ghi chép tâm linh"
  },
  {
    title: "DU MỤC CÙNG ZANSKAR",
    vibe: "Thung lũng biệt lập băng giá",
    imageUrl: "https://media.fittour.vn/uploads/2023/06/emagazine-nhung-ngay-du-muc-zanskar.webp",
    quote: "Zanskar đón tôi bằng cái lạnh cắt da, những rặng núi hoang vu và những ánh nhìn tò mò nhưng ấm áp của người bản địa. Nơi này không dành cho những kẻ tìm kiếm sự vội vã.",
    badge: "NOMADIC SOUL",
    coordinates: "33.4687° N, 76.9678° E",
    link: "/emagazine-dang-thuy-duong-o-zanskar",
    shortTitle: "Zanskar",
    author: "Đặng Thùy Dương",
    authorDesc: "Ghi chép du mục"
  }
];

---

<section id="china-stories-centerpiece" class="relative bg-[#ece6dc] py-28 px-4 md:px-8 overflow-hidden font-sans border-y border-[#dcd2c4]">
  
  {/* Animated Background Wordmark */}
  <div class="absolute inset-0 flex items-center justify-center select-none pointer-events-none opacity-[0.03] z-0">
    <span class="font-serif text-[20vw] font-bold text-[#3d2f25] tracking-tighter uppercase whitespace-nowrap leading-none">
      E-MAGAZINE
    </span>
  </div>

  <div class="max-w-6xl mx-auto relative z-10" id="stories-wrapper">
    
    {/* Section Editorial Header */}
    <div class="grid grid-cols-1 md:grid-cols-12 gap-6 items-end mb-16 pb-8 border-b border-[#dcd2c4]">
      <div class="md:col-span-8">
        <span class="font-mono text-xs uppercase tracking-widest text-[#a84448] font-bold block mb-3 flex items-center gap-2">
          THE EDITORIAL SPREAD / NHẬT KÝ HÀNH TRÌNH
        </span>
        <h2 class="font-serif text-3xl md:text-5xl font-bold text-[#3d2f25] leading-none tracking-tight">
          "Cuộc Đời Là Một Cuốn Phim, Tôi Từ Chối Làm Khán Giả"
        </h2>
      </div>
      
      {/* Interactive Edition Selectors (01 / 02 / 03) */}
      <div class="md:col-span-4 flex md:justify-end gap-3">
        {STORIES.map((cover, idx) => (
          <button
            data-tab-idx={idx}
            class={`story-tab-btn flex flex-col items-start px-4 py-2.5 rounded-lg border text-left transition-all duration-300 min-w-[90px] cursor-pointer ${
              idx === 0
                ? 'border-[#a84448] bg-[#a84448]/10 text-[#8c3639] shadow-md active-tab'
                : 'border-[#dcd2c4] bg-[#f2ede6] text-[#7a6b61] hover:border-[#b8a693] hover:text-[#5a4d45] inactive-tab'
            }`}
          >
            <span class="font-mono text-xs font-bold block">0{idx + 1}</span>
            <span class="text-[10px] uppercase font-sans tracking-wider font-semibold">
              {cover.shortTitle}
            </span>
          </button>
        ))}
      </div>
    </div>

    {/* Core Central Layout */}
    <div class="grid grid-cols-1 items-center relative min-h-[500px]">
      
      {/* Container for all covers */}
      {STORIES.map((cover, idx) => (
        <div data-content-idx={idx} class={`story-content-item absolute inset-0 col-start-1 row-start-1 grid grid-cols-1 lg:grid-cols-12 gap-12 items-center transition-all duration-700 ${idx === 0 ? 'opacity-100 z-10 pointer-events-auto scale-100 relative' : 'opacity-0 z-0 pointer-events-none scale-95 absolute'}`}>
          
          {/* Left: Magazine Specs & Metadata */}
          <div class="lg:col-span-3 space-y-8 order-2 lg:order-1">
            <div class="space-y-1">
              <span class="font-mono text-[10px] text-[#7a6b61] uppercase tracking-widest block">CHÂN DUNG KHẮC HỌA</span>
              <p class="font-serif text-2xl font-semibold text-[#3d2f25] leading-tight">
                {cover.shortTitle}
              </p>
              <div class="h-0.5 w-12 bg-[#a84448] mt-2"></div>
            </div>

            <div class="space-y-3 font-mono text-xs text-[#5a4d45]">
              <div class="flex justify-between py-1.5 border-b border-[#e6decb]">
                <span>Bộ sưu tập</span>
                <span class="text-[#3d2f25] font-bold">FIT Tour 2026</span>
              </div>
              <div class="flex justify-between py-1.5 border-b border-[#e6decb]">
                <span>Hình thái</span>
                <span class="text-[#3d2f25] font-semibold">Tự truyện du ký</span>
              </div>
              <div class="flex justify-between py-1.5 border-b border-[#e6decb]">
                <span>Độ cao trung bình</span>
                <span class="text-[#3d2f25] font-semibold">{'>'} 3,500m</span>
              </div>
              <div class="flex justify-between py-1.5 border-b border-[#e6decb]">
                <span>Chuyên mục</span>
                <span class="text-[#3d2f25] font-semibold">E-Magazine</span>
              </div>
            </div>

            <div class="bg-[#f5f1ea] border border-[#dcd2c4] p-4 rounded-xl font-mono text-xs text-[#5a4d45] space-y-2">
              <div class="flex items-center gap-2 text-[#a84448] font-bold text-[10px]">
                <span class="w-1.5 h-1.5 bg-[#a84448] rounded-full animate-pulse"></span>
                BẢN ĐỒ TỌA ĐỘ
              </div>
              <div>
                <span class="text-[#7a6b61] text-[10px] uppercase block">GPS Point</span>
                <span class="text-[#3d2f25] font-bold">{cover.coordinates}</span>
              </div>
              <div>
                <span class="text-[#7a6b61] text-[10px] uppercase block">Định danh</span>
                <span class="text-[#5a4d45] italic">{cover.vibe}</span>
              </div>
            </div>
          </div>

          {/* Middle: Framed Magazine Portrait Cover */}
          <div class="lg:col-span-5 flex justify-center order-1 lg:order-2">
            <div
              class="relative aspect-3/4 w-full max-w-[370px] bg-[#3d2f25] border-4 border-[#dcd2c4] rounded-2xl shadow-xl p-4 overflow-hidden group"
            >
              <div class="absolute inset-2 border border-white/20 rounded-xl z-20 pointer-events-none"></div>

              <img
                src={cover.imageUrl}
                alt={cover.title}
                referrerpolicy="no-referrer"
                class="absolute inset-0 w-full h-full object-cover transition-all duration-700 brightness-[85%] scale-102 group-hover:scale-105"
              />

              <div class="absolute inset-0 bg-gradient-to-t from-stone-950 via-stone-950/20 to-transparent z-10"></div>
              
              <div class="absolute top-6 left-6 z-20 text-white font-serif pointer-events-none">
                <span class="font-mono text-[8px] uppercase tracking-widest text-[#e8cc99] block font-semibold drop-shadow-md">
                  FIT TOUR EXCLUSIVE
                </span>
                <h3 class="text-xl font-bold tracking-tight mt-0.5 drop-shadow">
                  DIARY
                </h3>
              </div>

              <div class="absolute top-6 right-6 z-20 text-right font-mono text-[8px] text-white/90 pointer-events-none drop-shadow-md">
                <span>ISSUE 0{idx + 1}</span>
                <span class="block mt-0.5 text-white font-bold bg-[#a84448]/80 px-1 py-0.5 rounded border border-white/20 uppercase backdrop-blur-sm">
                  {cover.badge}
                </span>
              </div>

              <div class="absolute bottom-6 inset-x-6 z-20 text-left pointer-events-none">
                <div class="flex items-center gap-1 text-[8px] text-[#e8cc99] font-mono tracking-widest block mb-1 drop-shadow-md">
                  <span>PORTRAIT SPREAD</span>
                  <span>•</span>
                  <span>STORY</span>
                </div>
                
                <h4 class="font-serif text-2xl font-bold leading-tight uppercase tracking-tight text-white drop-shadow-md">
                  {cover.title}
                </h4>
                
                <p class="font-sans text-[10px] text-stone-200 line-clamp-2 mt-1.5 italic font-medium leading-relaxed drop-shadow-md">
                  "{cover.quote}"
                </p>
              </div>

              <a href={cover.link} aria-label={`Đọc nhật ký hành trình ${cover.shortTitle}`} class="absolute inset-0 z-30 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity bg-[#3d2f25]/40 backdrop-blur-[2px]">
                  <span class="px-6 py-3 border border-white text-white font-mono text-xs uppercase tracking-widest bg-[#a84448]/90 hover:bg-[#8c3639] transition-colors rounded-full font-bold">
                    Đọc Nhật Ký Hành Trình
                  </span>
              </a>

              <div class="absolute inset-0 pointer-events-none opacity-10 bg-[radial-gradient(ellipse_at_center,_var(--tw-gradient-stops))] from-white via-transparent to-black z-15"></div>
            </div>
          </div>

          {/* Right: Poetic Big Quote & Signature */}
          <div class="lg:col-span-4 space-y-6 order-3">
            <div class="bg-white border border-[#dcd2c4] p-6 md:p-8 rounded-2xl relative shadow-sm">
              
              <h4 class="font-mono text-[9px] uppercase tracking-widest text-[#7a6b61] font-bold block mb-4">
                Trích Đoạn Hành Trình
              </h4>

              <div class="space-y-4">
                <p class="font-serif text-base sm:text-lg text-[#3d2f25] leading-relaxed italic">
                  "{cover.quote}"
                </p>
                
                <div class="pt-4 border-t border-[#f0eadd] flex items-center justify-between text-xs font-mono">
                  <span class="text-[#7a6b61]">Đọc toàn bộ bài viết</span>
                  <a href={cover.link} aria-label={`Đọc bài viết ${cover.shortTitle} tại đây`} class="text-[#a84448] hover:text-[#8c3639] underline font-bold block">Tại đây</a>
                </div>
              </div>
            </div>

            <div class="p-4 bg-white/50 rounded-xl border border-[#dcd2c4] flex items-center justify-between shadow-sm">
              <div>
                <span class="font-mono text-[9px] text-[#7a6b61] block">SIGNATURE OF MEMORY</span>
                <span class="font-serif text-lg font-bold italic text-[#3d2f25] font-medium tracking-wide">
                  {cover.author}
                </span>
              </div>
              <div class="text-[10px] font-mono text-[#5a4d45] border border-[#dcd2c4] rounded px-2.5 py-1 text-center bg-white">
                {cover.authorDesc}
              </div>
            </div>

          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const wrapper = document.getElementById('stories-wrapper');
    if (!wrapper) return;

    const btns = wrapper.querySelectorAll('.story-tab-btn');
    const contents = wrapper.querySelectorAll('.story-content-item');

    btns.forEach(btn => {
      btn.addEventListener('click', () => {
        const idx = btn.getAttribute('data-tab-idx');

        // Update buttons
        btns.forEach(b => {
          if (b.getAttribute('data-tab-idx') === idx) {
            b.classList.add('border-[#a84448]', 'bg-[#a84448]/10', 'text-[#8c3639]', 'shadow-md');
            b.classList.remove('border-[#dcd2c4]', 'bg-[#f2ede6]', 'text-[#7a6b61]');
          } else {
            b.classList.remove('border-[#a84448]', 'bg-[#a84448]/10', 'text-[#8c3639]', 'shadow-md');
            b.classList.add('border-[#dcd2c4]', 'bg-[#f2ede6]', 'text-[#7a6b61]');
          }
        });

        // Update contents
        contents.forEach(content => {
          if (content.getAttribute('data-content-idx') === idx) {
            content.classList.remove('opacity-0', 'z-0', 'pointer-events-none', 'scale-95', 'absolute');
            content.classList.add('opacity-100', 'z-10', 'pointer-events-auto', 'scale-100', 'relative');
          } else {
            content.classList.remove('opacity-100', 'z-10', 'pointer-events-auto', 'scale-100', 'relative');
            content.classList.add('opacity-0', 'z-0', 'pointer-events-none', 'scale-95', 'absolute');
          }
        });
      });
    });
  });
</script>
