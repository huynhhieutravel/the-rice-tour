---
// src/components/reviews/LiveGoogleReviews.astro
// Component lấy review từ ERP qua API public

let reviews = [];
try {
  // Tăng limit ban đầu lên 20 (lấy nhiều hơn theo yêu cầu)
  const response = await fetch('https://erp.fittour.vn/api/public/reviews?limit=20');
  if (response.ok) {
    const data = await response.json();
    if (data.success && data.data) {
      reviews = data.data;
    }
  }
} catch (e) {
  console.error("Error fetching reviews:", e);
}

// Hàm format ngày
const formatDate = (dateString) => {
  if (!dateString) return '';
  const d = new Date(dateString);
  return new Intl.DateTimeFormat('vi-VN', { year: 'numeric', month: 'long', day: 'numeric' }).format(d);
};
---

<section class="w-full bg-[#0a0a0a] py-20 px-4 md:px-8">
  <div class="max-w-[1400px] mx-auto">
    <div class="text-center mb-16 reveal-up">
      <h2 class="font-serif italic text-brand-500 text-2xl md:text-3xl mb-4">Real Experiences</h2>
      <h3 class="text-white text-4xl md:text-6xl font-serif font-bold uppercase tracking-widest drop-shadow-lg">
        Đánh Giá Khách Hàng
      </h3>
      <p class="text-gray-400 mt-6 max-w-2xl mx-auto text-lg">
        Những khoảnh khắc đáng nhớ và những lời nhận xét chân thực nhất từ du khách sau mỗi chuyến đi cùng FIT Tour.
      </p>
    </div>

    {reviews.length > 0 ? (
      <div class="columns-1 md:columns-2 lg:columns-3 gap-6" id="reviews-grid">
        {reviews.map((review) => (
          <div class="break-inside-avoid mb-6 bg-[#111318] border border-white/10 rounded-2xl p-8 hover:border-brand-500/50 hover:shadow-2xl hover:shadow-brand-500/10 transition-all duration-500 group relative overflow-hidden reveal-up">
            <!-- Glow effect -->
            <div class="absolute -top-24 -right-24 w-48 h-48 bg-brand-500/20 blur-[50px] rounded-full group-hover:bg-brand-500/30 transition-colors"></div>
            
            <div class="relative z-10">
              <div class="flex justify-between items-start mb-6">
                <div>
                  <h4 class="text-white font-bold text-lg">{review.reviewer_name || 'Khách Hàng'}</h4>
                  <div class="flex items-center gap-1 mt-2 text-brand-500">
                    {[...Array(5)].map((_, i) => (
                      <svg class={`w-4 h-4 ${i < (review.rating || 5) ? 'fill-current' : 'text-gray-600 fill-current'}`} viewBox="0 0 20 20">
                        <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                      </svg>
                    ))}
                  </div>
                </div>
                <div class="bg-white/5 px-3 py-1 rounded-full border border-white/10 text-xs text-gray-400 flex items-center gap-2">
                  {review.source === 'google' ? (
                    <svg class="w-4 h-4 text-white" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M21.35 11.1h-9.17v2.73h6.51c-.33 3.81-3.5 5.44-6.5 5.44C8.36 19.27 5 16.25 5 12c0-4.1 3.2-7.27 7.2-7.27 3.09 0 4.9 1.97 4.9 1.97L19 4.72S16.56 2 12.1 2C6.42 2 2.03 6.8 2.03 12c0 5.05 4.13 10 10.22 10 5.35 0 9.25-3.67 9.25-9.09 0-1.15-.15-1.81-.15-1.81z"/>
                    </svg>
                  ) : (
                    <svg class="w-4 h-4 text-[#1877F2]" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.469h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.469h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
                    </svg>
                  )}
                </div>
              </div>

              <div class="prose prose-invert prose-sm max-w-none text-gray-300 leading-relaxed mb-6">
                <p>"{review.comment}"</p>
              </div>

              {review.proof_url && (
                <div class="mt-4 rounded-xl overflow-hidden h-48 w-full border border-white/10 group-hover:border-white/20 transition-colors">
                  <img src={`https://erp.fittour.vn${review.proof_url}`} alt="Review Proof" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" loading="lazy" />
                </div>
              )}

              <div class="mt-6 pt-4 border-t border-white/10 text-xs text-gray-500 font-mono">
                {formatDate(review.review_date)}
              </div>
            </div>
          </div>
        ))}
      </div>
    ) : (
      <div class="text-center text-gray-500 py-12">
        Đang tải đánh giá mới nhất...
      </div>
    )}

    <!-- Load More Button -->
    <div class="mt-12 flex justify-center">
      <button id="load-more-btn" class="px-8 py-3 bg-white/5 border border-white/20 text-white rounded-full font-medium hover:bg-white/10 hover:border-brand-500 transition-colors flex items-center gap-2">
        <span>Xem thêm Đánh giá</span>
        <svg class="w-4 h-4 loading-spinner hidden animate-spin" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-opacity="0.25"></circle>
          <path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"></path>
        </svg>
      </button>
    </div>

    <!-- Template for JS injected reviews -->
    <template id="review-card-template">
      <div class="break-inside-avoid mb-6 bg-[#111318] border border-white/10 rounded-2xl p-8 hover:border-brand-500/50 hover:shadow-2xl hover:shadow-brand-500/10 transition-all duration-500 group relative overflow-hidden reveal-up opacity-0 translate-y-8">
        <div class="absolute -top-24 -right-24 w-48 h-48 bg-brand-500/20 blur-[50px] rounded-full group-hover:bg-brand-500/30 transition-colors"></div>
        <div class="relative z-10">
          <div class="flex justify-between items-start mb-6">
            <div>
              <h4 class="text-white font-bold text-lg reviewer-name"></h4>
              <div class="flex items-center gap-1 mt-2 text-brand-500 rating-stars"></div>
            </div>
            <div class="bg-white/5 px-3 py-1 rounded-full border border-white/10 text-xs text-gray-400 flex items-center gap-2 source-icon"></div>
          </div>
          <div class="prose prose-invert prose-sm max-w-none text-gray-300 leading-relaxed mb-6">
            <p class="review-comment"></p>
          </div>
          <div class="proof-container hidden mt-4 rounded-xl overflow-hidden h-48 w-full border border-white/10 group-hover:border-white/20 transition-colors">
            <img class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" loading="lazy" />
          </div>
          <div class="mt-6 pt-4 border-t border-white/10 text-xs text-gray-500 font-mono review-date"></div>
        </div>
      </div>
    </template>
  </div>
</section>

<script>
  // Simple intersection observer for reveal-up animation
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('opacity-100', 'translate-y-0');
        entry.target.classList.remove('opacity-0', 'translate-y-8');
      }
    });
  }, { threshold: 0.1 });

  document.querySelectorAll('.reveal-up').forEach((el) => {
    el.classList.add('opacity-0', 'translate-y-8', 'transition-all', 'duration-1000', 'ease-out');
    observer.observe(el);
  });

  // Load More Logic
  let currentOffset = 20; // Ban đầu đã tải 20
  const loadMoreBtn = document.getElementById('load-more-btn');
  const reviewsGrid = document.getElementById('reviews-grid');
  const template = document.getElementById('review-card-template');
  const spinner = loadMoreBtn?.querySelector('.loading-spinner');
  
  if (loadMoreBtn && reviewsGrid && template) {
    loadMoreBtn.addEventListener('click', async () => {
      // Show loading state
      loadMoreBtn.disabled = true;
      spinner.classList.remove('hidden');
      
      try {
        const res = await fetch(`https://erp.fittour.vn/api/public/reviews?limit=10&offset=${currentOffset}`);
        if (!res.ok) throw new Error('API Error');
        const json = await res.json();
        
        if (json.success && json.data && json.data.length > 0) {
          json.data.forEach(review => {
            const clone = template.content.cloneNode(true);
            
            // Fill data
            clone.querySelector('.reviewer-name').textContent = review.reviewer_name || 'Khách Hàng';
            clone.querySelector('.review-comment').textContent = `"${review.comment}"`;
            
            // Format date
            const d = new Date(review.review_date);
            clone.querySelector('.review-date').textContent = new Intl.DateTimeFormat('vi-VN', { year: 'numeric', month: 'long', day: 'numeric' }).format(d);
            
            // Rating
            const ratingContainer = clone.querySelector('.rating-stars');
            const rating = review.rating || 5;
            for(let i=0; i<5; i++) {
              ratingContainer.innerHTML += `<svg class="w-4 h-4 ${i < rating ? 'fill-current' : 'text-gray-600 fill-current'}" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" /></svg>`;
            }
            
            // Source icon
            const sourceIcon = clone.querySelector('.source-icon');
            if (review.source === 'google') {
              sourceIcon.innerHTML = `<svg class="w-4 h-4 text-white" viewBox="0 0 24 24" fill="currentColor"><path d="M21.35 11.1h-9.17v2.73h6.51c-.33 3.81-3.5 5.44-6.5 5.44C8.36 19.27 5 16.25 5 12c0-4.1 3.2-7.27 7.2-7.27 3.09 0 4.9 1.97 4.9 1.97L19 4.72S16.56 2 12.1 2C6.42 2 2.03 6.8 2.03 12c0 5.05 4.13 10 10.22 10 5.35 0 9.25-3.67 9.25-9.09 0-1.15-.15-1.81-.15-1.81z"/></svg>`;
            } else {
              sourceIcon.innerHTML = `<svg class="w-4 h-4 text-[#1877F2]" viewBox="0 0 24 24" fill="currentColor"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.469h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.469h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>`;
            }
            
            // Proof Image
            if (review.proof_url) {
              const proofContainer = clone.querySelector('.proof-container');
              proofContainer.classList.remove('hidden');
              proofContainer.querySelector('img').src = `https://erp.fittour.vn${review.proof_url}`;
            }
            
            // Add to DOM
            const newElement = clone.firstElementChild;
            reviewsGrid.appendChild(newElement);
            
            // Trigger animation immediately
            requestAnimationFrame(() => {
              newElement.classList.remove('opacity-0', 'translate-y-8');
              newElement.classList.add('opacity-100', 'translate-y-0');
            });
          });
          
          currentOffset += 10;
          
          // Hide button if no more data
          if (json.data.length < 10) {
            loadMoreBtn.style.display = 'none';
          }
        } else {
          // No more data
          loadMoreBtn.style.display = 'none';
        }
      } catch (err) {
        console.error("Failed to load more reviews:", err);
        alert("Lỗi kết nối, vui lòng thử lại sau.");
      } finally {
        loadMoreBtn.disabled = false;
        spinner.classList.add('hidden');
      }
    });
  }
</script>
