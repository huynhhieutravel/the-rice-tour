---
// src/components/reviews/CustomerStories.astro
// Lấy các bài viết từ danh mục "Câu Chuyện Du Lịch" (categoryId = 92)

import { env } from 'cloudflare:workers';
let envLocals: any = null;
try { envLocals = Astro.locals?.runtime?.env; } catch (_) {}

let stories = [];
try {
  const d1Db = env?.dulichcoguu_d1 || envLocals?.dulichcoguu_d1;
  if (d1Db) {
    const query = `
      SELECT p.id, p.title, p.slug, p.excerpt, p.featuredImage 
      FROM Post p
      JOIN PostCategory pc ON p.id = pc.postId
      JOIN BlogCategory bc ON pc.categoryId = bc.id
      WHERE bc.slug = 'cau-chuyen-du-lich' AND (p.status = 'published' OR p.status = 'publish') 
      ORDER BY p.publishedAt DESC 
      LIMIT 4
    `;
    const result = await d1Db.prepare(query).all();
    if (result.success && result.results) {
      stories = result.results;
    }
  }
} catch (e) {
  console.error("Error fetching stories:", e);
}
---

<section class="w-full py-16 px-4 md:px-8 bg-white">
  <div class="max-w-[1400px] mx-auto">
    <div class="text-center mb-10 reveal-up">
      <h2 class="text-2xl md:text-3xl font-bold text-gray-900">
        Những câu chuyện được kể lại từ Khách hàng của FIT Tour
      </h2>
    </div>

    {stories.length > 0 ? (
      <div class="flex overflow-x-auto snap-x snap-mandatory gap-4 pb-8 -mx-4 px-4 sm:mx-0 sm:px-0 sm:grid sm:grid-cols-2 lg:grid-cols-4 sm:gap-6 sm:overflow-visible hide-scrollbar mb-4">
        {stories.map((story) => (
          <div class="min-w-[85vw] max-w-[320px] sm:min-w-0 sm:max-w-none shrink-0 snap-center bg-white rounded-xl border border-gray-200 overflow-hidden flex flex-col h-full transform hover:-translate-y-1 hover:shadow-lg transition-all duration-300 reveal-up">
            <a href={`/${story.slug}`} class="block overflow-hidden relative aspect-video">
              <img 
                src={story.featuredImage} 
                alt={story.title} 
                class="w-full h-full object-cover transform hover:scale-105 transition-transform duration-700" 
                loading="lazy"
              />
            </a>
            
            <div class="p-5 flex flex-col flex-grow">
              <a href={`/${story.slug}`} class="hover:text-brand-600 transition-colors">
                <h3 class="font-bold text-gray-900 text-[16px] leading-snug mb-4 line-clamp-3">
                  {story.title}
                </h3>
              </a>
              
              <!-- Nút Xem Chi Tiết -->
              <div class="mt-auto pt-4 flex justify-center">
                <a href={`/${story.slug}`} class="text-[10px] font-bold tracking-widest uppercase text-gray-500 border border-gray-200 px-6 py-2 rounded-full hover:bg-brand-500 hover:text-white hover:border-brand-500 transition-all duration-300 w-full flex items-center justify-center gap-2">
                  XEM CHI TIẾT <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
                </a>
              </div>
            </div>
          </div>
        ))}
      </div>
    ) : (
      <div class="text-center text-gray-500 py-10">
        Đang tải các câu chuyện mới nhất...
      </div>
    )}

    <!-- Nút Xem thêm dạng tròn (Mũi tên hoặc text) -->
    <div class="flex justify-center reveal-up mt-8">
      <a href="/cau-chuyen-du-lich" class="group flex flex-col items-center gap-3 hover:opacity-80 transition-opacity">
        <div class="w-16 h-16 rounded-full border-2 border-brand-500 flex items-center justify-center text-brand-500 group-hover:bg-brand-500 group-hover:text-white transition-all">
          <svg class="w-6 h-6 transform group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </div>
        <span class="text-sm font-bold text-gray-600 uppercase tracking-wider">Xem thêm</span>
      </a>
    </div>
  </div>
</section>
