}
const { title = "Thông Tin Thêm" } = Astro.props;
---
<section class="tour-faq-section mb-12 mt-12">
  <h2 class="text-2xl font-bold text-slate-800 mb-6">{title}</h2>
  <div class="tour-faq-wrapper flex flex-col gap-4">
    <slot />
  </div>
</section>
