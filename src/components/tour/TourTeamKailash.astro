---

<section class="tour-team-section py-16 md:py-24 bg-[#fafafa]">
  <div class="max-w-[1200px] mx-auto px-4 sm:px-6">
    
    <!-- Part 1: Key People -->
    <div class="mb-24">
      <!-- Top Typography Art -->
      <div class="text-center mb-16 flex flex-col items-center">
         <div class="mb-6">
             <div class="text-[#CC0000] font-bold text-sm md:text-base tracking-widest mb-1">KORA KAILASH</div>
             <div class="flex justify-center gap-1">
                 <div class="w-3 h-5 bg-[#174895] border border-slate-800 transform rotate-12"></div>
                 <div class="w-3 h-5 bg-white border border-slate-800 transform rotate-6"></div>
                 <div class="w-3 h-5 bg-[#C00] border border-slate-800 transform -rotate-3"></div>
                 <div class="w-3 h-5 bg-[#008F45] border border-slate-800 transform -rotate-12"></div>
                 <div class="w-3 h-5 bg-[#FFD700] border border-slate-800 transform -rotate-12"></div>
             </div>
         </div>
         <div class="flex flex-col items-center justify-center">
             <div class="font-serif italic text-[3rem] md:text-[4rem] text-slate-900 leading-none mb-2">Key People</div>
             <div class="flex justify-center font-black uppercase text-[4rem] md:text-[6rem] leading-[0.85] tracking-tighter" style="font-family: 'Oswald', 'Impact', sans-serif;">
                 <span class="text-[#CC0000] scale-y-[1.1] origin-bottom">OUR</span>
                 <span class="text-slate-950 scale-y-[1.1] origin-bottom ml-3 lg:ml-5">TEAM</span>
             </div>
         </div>
      </div>

      <!-- 3 Columns Person Cards -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {keyPeople.map(person => (
          <a href={person.link} target="_blank" class="group bg-white rounded-2xl shadow-[0_4px_20px_rgb(0,0,0,0.04)] hover:shadow-[0_12px_40px_rgb(0,0,0,0.08)] transition-all duration-300 overflow-hidden border border-slate-100 flex flex-col">
            <div class="aspect-[4/3] w-full overflow-hidden">
              <img src={person.image} alt={person.name} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" loading="lazy" />
            </div>
            <div class="p-6 text-center flex-1 flex flex-col justify-center">
               <div class="text-[#CC0000] font-black text-xl lg:text-2xl uppercase tracking-wider mb-2">
                 {person.name}
               </div>
               <div class="text-slate-700 font-semibold text-xs lg:text-sm uppercase leading-relaxed" set:html={person.role}>
               </div>
            </div>
          </a>
        ))}
      </div>
    </div>

    <!-- Part 2: Tour Guides -->
    <div class="mt-20">
      
      <!-- Top Typography Art -->
      <div class="text-center mb-16 flex flex-col items-center">
          <div class="flex items-center gap-6 justify-center mb-6">
             <div class="w-12 h-12 md:w-14 md:h-14 bg-[#CC0000] rounded-xl flex items-center justify-center shadow-lg shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 md:h-8 md:w-8 text-[#FFD700]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                   <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
             </div>
             <div class="text-left">
                <div class="text-[#CC0000] font-bold text-sm tracking-widest mb-1">KORA KAILASH</div>
                <div class="flex justify-start gap-1">
                    <div class="w-2.5 h-4 bg-[#174895] border border-slate-800 transform rotate-12"></div>
                    <div class="w-2.5 h-4 bg-white border border-slate-800 transform rotate-6"></div>
                    <div class="w-2.5 h-4 bg-[#C00] border border-slate-800 transform -rotate-3"></div>
                    <div class="w-2.5 h-4 bg-[#008F45] border border-slate-800 transform -rotate-12"></div>
                    <div class="w-2.5 h-4 bg-[#FFD700] border border-slate-800 transform -rotate-12"></div>
                </div>
             </div>
          </div>
          
          <div class="flex flex-col uppercase font-black tracking-tighter" style="font-family: 'Oswald', 'Impact', sans-serif;">
              <span class="text-[2rem] md:text-[3rem] text-slate-950 scale-y-[1.1] origin-bottom leading-[1.05]">Our Tour Guide</span>
              <span class="text-[2.2rem] md:text-[3.5rem] text-[#CC0000] scale-y-[1.1] origin-bottom mt-2 lg:mt-3 leading-[1.05]">In't License</span>
              <span class="text-[2.5rem] md:text-[4rem] text-slate-950 scale-y-[1.1] origin-bottom mt-3 lg:mt-4 leading-[1]">5* REVIEWS</span>
          </div>
      </div>

      <!-- Tour Guides Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {tourGuides.map(guide => (
          <a href={guide.link} target="_blank" class="group bg-white rounded-[2rem] p-8 shadow-[0_8px_30px_rgb(0,0,0,0.05)] hover:shadow-[0_12px_40px_rgb(0,0,0,0.1)] transition-all duration-300 border border-slate-100 flex flex-col items-center text-center">
             <div class="w-36 h-36 lg:w-40 lg:h-40 rounded-full overflow-hidden mb-6 border-4 border-white shadow-[0_0_15px_rgb(0,0,0,0.1)] relative">
                <img src={guide.image} alt={guide.name} class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700" loading="lazy" />
             </div>
             
             <div class="text-[11px] lg:text-xs font-black text-slate-500 uppercase tracking-widest mb-3">{guide.role}</div>
             <div class="font-black text-xl lg:text-2xl text-slate-950 mb-1">{guide.name}</div>
             <div class="text-[13px] italic text-slate-500 mb-4">{guide.exp}</div>
             
             <div class="text-sm text-slate-600 leading-relaxed mb-8 flex-1">
                {guide.desc}
             </div>
             
             <div class="bg-black text-white text-xs lg:text-sm font-bold uppercase tracking-widest py-3 px-6 rounded-full group-hover:bg-[#CC0000] transition-colors w-full mt-auto text-center">
                {guide.linkText}
             </div>
          </a>
        ))}
      </div>
      
    </div>
  </div>
</section>
