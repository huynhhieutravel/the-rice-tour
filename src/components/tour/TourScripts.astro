<script is:inline>
  // === GLightbox Init for Tour Pages ===
  function initTourGalleryLightbox() {
    var container = document.querySelector('.elementor-tour-wrapper');
    if (!container) return;

    var gallerySelectors = ['.coguu-gallery-story', '.coguu-gallery', '.grid-fit-masonry', '.tiptap-gallery-block', '.zoomable-image', '.wp-block-gallery'];
    var lightboxData = [];
    var processedGalleries = new Set();

    gallerySelectors.forEach(function(selector) {
      var galleries = container.querySelectorAll(selector);
      galleries.forEach(function(gallery) {
        if (processedGalleries.has(gallery)) return;
        processedGalleries.add(gallery);
        
        var imgs = gallery.querySelectorAll('img.feature-image, img');
        if (imgs.length === 0) return;
        var elements = [];
        var validImgs = [];
        for (var i = 0; i < imgs.length; i++) {
          if (imgs[i].closest('.exclude-lightbox') || imgs[i].closest('a')) continue;
          elements.push({ href: imgs[i].getAttribute('src') || '', type: 'image', description: imgs[i].getAttribute('alt') || '' });
          validImgs.push(imgs[i]);
        }
        if (elements.length > 0) {
          var isGrouped = elements.length > 1;
          lightboxData.push({ elements: elements, imgs: validImgs, isGrouped: isGrouped });
        }
      });
    });

    if (lightboxData.length === 0) return;

    requestAnimationFrame(function() {
      lightboxData.forEach(function(lbData) {
        for (var i = 0; i < lbData.imgs.length; i++) {
          lbData.imgs[i].style.cursor = 'zoom-in';
          if (lbData.isGrouped) lbData.imgs[i].classList.add('lightbox-grouped');
        }

        var lightbox = GLightbox({
          elements: lbData.elements,
          touchNavigation: true,
          loop: true,
          zoomable: true,
          descPosition: 'bottom'
        });

        for (var j = 0; j < lbData.imgs.length; j++) {
          (function(index) {
            lbData.imgs[index].addEventListener('click', function(e) {
              e.preventDefault();
              e.stopPropagation();
              lightbox.openAt(index);
            });
          })(j);
        }
      });
    });
  }

  function loadGLightbox() {
    if (typeof GLightbox !== 'undefined') {
      requestAnimationFrame(initTourGalleryLightbox);
      return;
    }
    var link = document.createElement('link');
    link.rel = 'stylesheet';
    link.href = 'https://cdn.jsdelivr.net/npm/glightbox/dist/css/glightbox.min.css';
    link.media = 'print';
    link.onload = function() { link.media = 'all'; };
    document.head.appendChild(link);

    var script = document.createElement('script');
    script.src = 'https://cdn.jsdelivr.net/gh/mcstudios/glightbox/dist/js/glightbox.min.js';
    script.onload = function() { requestAnimationFrame(initTourGalleryLightbox); };
    document.head.appendChild(script);
  }

  const initScripts = () => {
    // Init Lightbox asynchronously
    if ('requestIdleCallback' in window) {
      requestIdleCallback(loadGLightbox);
    } else {
      setTimeout(loadGLightbox, 200);
    }

    // Form Đăng Ký Modal
    const bookingButtons = document.querySelectorAll('.js-open-booking-modal');
    if (bookingButtons.length === 0) return;

    const showComingSoonModal = (tourName) => {
      let modal = document.getElementById('booking-coming-soon-modal');
      if (!modal) {
        modal = document.createElement('div');
        modal.id = 'booking-coming-soon-modal';
        modal.style.cssText = 'position: fixed; inset: 0; z-index: 9999; display: flex; align-items: center; justify-content: center; background: rgba(0,0,0,0.5); padding: 20px; opacity: 0; transition: opacity 0.3s ease; pointer-events: none;';
        
        const modalContent = document.createElement('div');
        modalContent.style.cssText = 'background: #fff; padding: 32px; border-radius: 20px; max-width: 420px; width: 100%; text-align: center; box-shadow: 0 10px 40px rgba(0,0,0,0.2); transform: translateY(20px); transition: transform 0.3s ease;';
        
        const iconWrapper = document.createElement('div');
        iconWrapper.style.cssText = 'width: 56px; height: 56px; border-radius: 50%; background: #fff7ed; color: #ea580c; display: flex; align-items: center; justify-content: center; margin: 0 auto 20px;';
        iconWrapper.innerHTML = '<svg width="28" height="28" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"></path></svg>';
        
        const title = document.createElement('h3');
        title.style.cssText = 'font-size: 20px; font-weight: 800; color: #1e293b; margin-top: 0; margin-bottom: 12px;';
        title.id = 'booking-modal-title';
        
        const desc = document.createElement('p');
        desc.style.cssText = 'font-size: 15px; color: #64748b; margin-bottom: 28px; line-height: 1.6;';
        desc.innerHTML = 'Tính năng <strong>Biểu mẫu điền thông tin và gửi Email tự động</strong> đang được phát triển.<br><br>Trong lúc chờ đợi, Quý khách vui lòng liên hệ trực tiếp qua Zalo hoặc Messenger để được tư vấn nhanh nhất nhé!';
        
        const closeBtn = document.createElement('button');
        closeBtn.innerText = 'Đã hiểu';
        closeBtn.style.cssText = 'background: #ea580c; color: #fff; border: none; padding: 14px 32px; border-radius: 12px; font-weight: 700; cursor: pointer; font-size: 15px; width: 100%; transition: background 0.2s;';
        closeBtn.onmouseover = () => closeBtn.style.background = '#c2410c';
        closeBtn.onmouseout = () => closeBtn.style.background = '#ea580c';
        closeBtn.onclick = () => {
          modal.style.opacity = '0';
          modalContent.style.transform = 'translateY(20px)';
          setTimeout(() => { modal.style.pointerEvents = 'none'; }, 300);
        };
        
        modalContent.appendChild(iconWrapper);
        modalContent.appendChild(title);
        modalContent.appendChild(desc);
        modalContent.appendChild(closeBtn);
        modal.appendChild(modalContent);
        document.body.appendChild(modal);
      }
      
      document.getElementById('booking-modal-title').innerText = 'Đăng ký ' + tourName;
      
      modal.style.pointerEvents = 'auto';
      requestAnimationFrame(() => {
        modal.style.opacity = '1';
        modal.firstChild.style.transform = 'translateY(0)';
      });
    };

    bookingButtons.forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        const tourName = btn.getAttribute('data-tour-name') || 'Tour này';
        showComingSoonModal(tourName);
      });
    });
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initScripts);
  } else {
    initScripts();
  }
  document.addEventListener('astro:page-load', initScripts);
</script>
