---
// Business Component: TourCard
// Được lắp ghép từ các element cơ bản và Data Domain của ngành Du lịch.

import Button from '@/components/ui/Button.astro';
import { getOptimizedImageUrl, generateSrcSet } from '@/lib/imageOptimization';

interface Props {
  title: string;
  price: string;
  rating?: string;
  reviews?: string;
  duration?: string;
  image: string;
  url: string;
  description?: string;
}

const { title, price, duration = "5N4Đ", image, url, description = "" } = Astro.props;

// Pseudo-random generator based on title string for deterministic UI
const hashString = (str: string) => {
  let hash = 0;
  for (let i = 0; i < str.length; i++) {
    hash = str.charCodeAt(i) + ((hash << 5) - hash);
  }
  return Math.abs(hash);
};

const hash = hashString(title);

// Rating: 4.5 to 4.9
const rating = Astro.props.rating || (4.5 + (hash % 5) * 0.1).toFixed(1);
// Reviews: 15 to 85
const reviews = Astro.props.reviews || (15 + (hash % 70)).toString();
// Show Hot Badge for ~33% of tours
const showHotBadge = (hash % 3 === 0);

const defaultQuotes = [
  "Hành trình khám phá những vùng đất mới, nơi giao thoa của lịch sử, văn hóa và cảnh sắc thiên nhiên tuyệt mỹ.",
  "Đắm chìm trong vẻ đẹp nguyên sơ và trải nghiệm những khoảnh khắc đáng nhớ nhất cùng những người bạn đồng hành.",
  "Một chuyến đi không chỉ là điểm đến, mà là những câu chuyện tuyệt vời bạn sẽ mang theo suốt cuộc đời.",
  "Mở rộng tầm mắt và trái tim với những trải nghiệm văn hóa độc bản, chỉ có tại vùng đất diệu kỳ này.",
  "Đánh thức giác quan với những khung cảnh hùng vĩ, sắc màu văn hóa và nền ẩm thực địa phương bản sắc."
];

const fallbackQuote = defaultQuotes[hash % defaultQuotes.length];

// Strip HTML tags and inner scripts/styles from description
let cleanDesc = description
  .replace(/<script\b[^<]*(?:(?!<\/script>)<[^<]*)*<\/script>/gi, '')
  .replace(/<style\b[^<]*(?:(?!<\/style>)<[^<]*)*<\/style>/gi, '')
  .replace(/<[^>]*>/g, '')
  .replace(/\s+/g, ' ')
  .trim();
if (!cleanDesc || cleanDesc.includes('Đang cập nhật')) {
  cleanDesc = fallbackQuote;
} else if (cleanDesc.length > 120) {
  cleanDesc = cleanDesc.substring(0, 115) + '...';
}

const optimizedSrc = getOptimizedImageUrl(image, 800);
const srcset = generateSrcSet(image, [400, 800, 1200]);
---

<article class="bg-surface border border-border rounded-2xl overflow-hidden shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all duration-300 flex flex-col h-full group relative">
  <!-- Thumbnail -->
  <div class="relative overflow-hidden aspect-video bg-gray-100">
    <img 
      src={optimizedSrc} 
      srcset={srcset}
      sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw"
      alt={title} 
      class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500 ease-out" 
      loading="lazy"
      decoding="async"
      fetchpriority="low"
    />
    <!-- Conditional Badge -->
    {showHotBadge && (
      <div class="absolute top-3 left-3 bg-brand-500 text-white text-xs font-bold px-2 py-1 rounded-md shadow-sm">
        Hot
      </div>
    )}
  </div>

  <!-- Content -->
  <div class="p-5 flex flex-col flex-grow">
    <!-- Meta info -->
    <div class="flex items-center gap-4 text-sm text-secondary mb-3">
      <div class="flex items-center gap-1">
        <svg class="w-4 h-4 text-brand-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
        {duration}
      </div>
      <div class="flex items-center gap-1 text-yellow-500 font-medium">
        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
        <span class="text-secondary">{rating} ({reviews})</span>
      </div>
    </div>

    <!-- Title -->
    <div class="font-bold text-primary text-lg mb-2 leading-snug line-clamp-2 group-hover:text-brand-500 transition-colors">
      <a href={url} class="focus:outline-none">
        <!-- Span absolute to make the whole card clickable for better UX, but we use a real button below -->
        <span class="absolute inset-0 z-10" aria-hidden="true"></span>
        {title}
      </a>
    </div>

    <!-- Description -->
    {cleanDesc && (
      <p class="text-sm text-secondary line-clamp-2 mb-4">
        {cleanDesc}
      </p>
    )}

    <!-- Price & Action (Push to bottom) -->
    <div class="mt-auto pt-4 border-t border-border flex flex-col gap-3 z-20 relative">
      <div class="flex items-center gap-2">
        <span class="text-sm text-muted">Giá từ:</span>
        <span class="text-brand-500 font-extrabold text-xl">{price}</span>
      </div>
      
      <!-- Sử dụng Core UI Component -->
      <Button href={url} variant="primary" size="sm" class="w-full justify-center text-center">
        Xem chi tiết
      </Button>
    </div>
  </div>
</article>
