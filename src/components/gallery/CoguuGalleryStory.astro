---
export interface Props {
  images: {
    src: string;
    alt?: string;
    caption?: string;
  }[];
  columns?: 2 | 3 | 4;
  breakout?: boolean;
}

const { images = [], columns = 3, breakout = false } = Astro.props;

// Determine column class
let colsClass = "cols-3";
if (columns === 2) colsClass = "cols-2";
if (columns === 4) colsClass = "cols-4";

// Add breakout class if requested
const breakoutClass = breakout ? "gallery-breakout" : "";
---

{images.length > 0 && (
  <div class={`coguu-gallery-story ${colsClass} ${breakoutClass}`}>
    {images.map((img) => (
      <figure class="gallery-story-item">
        <div class="gallery-story-image-wrap">
          <img 
            src={img.src} 
            alt={img.alt || img.caption || "Gallery Image"} 
            class="gallery-story-image"
            loading="lazy"
          />
        </div>
        {img.caption && (
          <figcaption class="gallery-story-caption">
            {img.caption}
          </figcaption>
        )}
      </figure>
    ))}
  </div>
)}
