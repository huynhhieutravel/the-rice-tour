---
// Component BlogCardImage
// Renders 16:9 verified authentic photo OR luxury NatGeo-style Editorial Fallback graphic
import { getCanonicalMediaUrl, isTaintedImageUrl } from '@/lib/imageOptimization';

interface Props {
  src?: string | null;
  alt?: string;
  title?: string;
  category?: string;
  class?: string;
}

const { src, alt = '', title = '', category = 'Field Dispatch', class: className = '' } = Astro.props;

// Determine if we have a valid authentic image
const hasValidImage = src && !isTaintedImageUrl(src) && src.trim().length > 0;
const canonicalUrl = hasValidImage ? getCanonicalMediaUrl(src!) : null;

// Pick a deterministic subtle gradient tone based on title
const tones = [
  { bg: 'from-stone-900 via-[#1e2922] to-[#121c15]', accent: 'text-amber-400', border: 'border-amber-500/20' },
  { bg: 'from-stone-900 via-[#2a1d17] to-[#19110d]', accent: 'text-orange-400', border: 'border-orange-500/20' },
  { bg: 'from-stone-900 via-[#18232c] to-[#0f171d]', accent: 'text-sky-400', border: 'border-sky-500/20' },
  { bg: 'from-stone-900 via-[#261e2b] to-[#17111b]', accent: 'text-rose-400', border: 'border-rose-500/20' },
];

let toneIdx = 0;
if (title) {
  for (let i = 0; i < title.length; i++) {
    toneIdx = (toneIdx + title.charCodeAt(i)) % tones.length;
  }
}
const currentTone = tones[toneIdx];
---

<div class={`blog-card-img-container aspect-[16/9] w-full relative overflow-hidden bg-slate-900 select-none ${className}`}>
  {hasValidImage ? (
    <>
      <img 
        src={canonicalUrl} 
        alt={alt || title} 
        class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" 
        loading="lazy" 
        decoding="async"
        onerror="if(this.nextElementSibling){ this.nextElementSibling.classList.remove('hidden'); this.style.display='none'; }"
      />
      <!-- Hidden fallback if image fails on client network -->
      <div class={`editorial-fallback hidden absolute inset-0 bg-gradient-to-br ${currentTone.bg} p-6 flex flex-col justify-between items-start text-left`}>
        <div class="flex items-center justify-between w-full">
          <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-white/10 backdrop-blur-md text-[11px] font-mono tracking-widest uppercase text-white/90 border border-white/10">
            <span class="w-1.5 h-1.5 rounded-full bg-amber-400 animate-pulse"></span>
            {category}
          </span>
          <span class="text-[10px] font-mono text-white/40 tracking-wider">THE RICE TOUR</span>
        </div>
        <div class="relative z-10 my-auto">
          <p class="font-serif text-white/90 text-sm md:text-base font-medium leading-snug line-clamp-2">
            {title}
          </p>
        </div>
        <div class="flex items-center gap-2 text-[10px] font-mono text-white/40 uppercase tracking-widest">
          <span>Authentic Inbound Archive</span>
        </div>
        <!-- Decorative subtle background SVG grid -->
        <svg class="absolute -right-8 -bottom-8 w-40 h-40 text-white/[0.03] pointer-events-none" fill="currentColor" viewBox="0 0 24 24">
          <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"></path>
        </svg>
      </div>
    </>
  ) : (
    /* Direct bespoke 16:9 Editorial Card when no authentic image is assigned */
    <div class={`absolute inset-0 bg-gradient-to-br ${currentTone.bg} p-6 flex flex-col justify-between items-start text-left group-hover:brightness-110 transition-all duration-500`}>
      <div class="flex items-center justify-between w-full">
        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-white/10 backdrop-blur-md text-[11px] font-mono tracking-widest uppercase text-white/90 border border-white/10">
          <span class="w-1.5 h-1.5 rounded-full bg-amber-400"></span>
          {category}
        </span>
        <span class="text-[10px] font-mono text-white/50 tracking-wider">THE RICE TOUR</span>
      </div>
      <div class="relative z-10 my-auto">
        <p class="font-serif text-white/95 text-base md:text-lg font-medium leading-snug line-clamp-2">
          {title}
        </p>
      </div>
      <div class="flex items-center justify-between w-full text-[10px] font-mono text-white/50 uppercase tracking-widest">
        <span>Curated Field Guide</span>
        <span class="text-amber-400 font-bold group-hover:translate-x-1 transition-transform">Read →</span>
      </div>
      <!-- Decorative topographic / lacquer accent -->
      <svg class="absolute -right-6 -bottom-6 w-36 h-36 text-white/[0.04] pointer-events-none group-hover:scale-110 transition-transform duration-700" fill="currentColor" viewBox="0 0 24 24">
        <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"></path>
      </svg>
    </div>
  )}
</div>
