---
// Component ShareButtons (International Inbound)
const currentUrl = Astro.url.href;
const encodedUrl = encodeURIComponent(currentUrl);

const fbShareUrl = `https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}`;
const xShareUrl = `https://twitter.com/intent/tweet?url=${encodedUrl}`;
const waShareUrl = `https://api.whatsapp.com/send?text=${encodedUrl}`;
---

<div class="bg-surface rounded-2xl p-5 lg:p-6 shadow-sm border border-border">
  <div class="font-bold text-gray-900 uppercase tracking-wider text-sm mb-4 border-b border-border pb-3">Share Guide</div>
  <div class="flex gap-3">
    <!-- Facebook -->
    <a href={fbShareUrl} target="_blank" rel="noopener noreferrer" aria-label="Share on Facebook" class="w-10 h-10 rounded-full bg-[#1877f2] text-white flex items-center justify-center hover:bg-blue-700 transition-colors">
      <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
    </a>
    
    <!-- WhatsApp -->
    <a href={waShareUrl} target="_blank" rel="noopener noreferrer" aria-label="Share on WhatsApp" class="w-10 h-10 rounded-full bg-[#25D366] text-white flex items-center justify-center hover:bg-emerald-600 transition-colors font-bold text-xs">
      <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/></svg>
    </a>

    <!-- X / Twitter -->
    <a href={xShareUrl} target="_blank" rel="noopener noreferrer" aria-label="Share on X" class="w-10 h-10 rounded-full bg-slate-900 text-white flex items-center justify-center hover:bg-black transition-colors font-bold text-xs">
      <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
    </a>
    
    <!-- Copy Link -->
    <button type="button" aria-label="Copy link" class="btn-copy-link relative w-10 h-10 rounded-full bg-subtle text-secondary flex items-center justify-center hover:bg-brand-600 hover:text-white transition-colors group cursor-pointer">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"></path></svg>
      <span class="copy-tooltip absolute -top-8 left-1/2 -translate-x-1/2 bg-gray-800 text-white text-[10px] px-2 py-1 rounded opacity-0 transition-opacity whitespace-nowrap pointer-events-none">Copy link</span>
    </button>
  </div>
</div>

<script>
  document.querySelectorAll('.btn-copy-link').forEach(btn => {
    btn.addEventListener('click', async (e) => {
      e.preventDefault();
      try {
        await navigator.clipboard.writeText(window.location.href);
        const tooltip = btn.querySelector('.copy-tooltip');
        if (tooltip) {
          tooltip.textContent = 'Copied!';
          tooltip.classList.remove('opacity-0');
          setTimeout(() => {
            tooltip.classList.add('opacity-0');
            setTimeout(() => tooltip.textContent = 'Copy link', 300);
          }, 2000);
        }
      } catch (err) {
        console.error('Failed to copy', err);
      }
    });
  });
</script>
