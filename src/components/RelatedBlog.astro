---
import { getCanonicalMediaUrl } from '@/lib/imageOptimization';
import OptimizedImage from '@/components/ui/OptimizedImage.astro';

export interface Props {
  excludeId?: string | number;
  limit?: number;
  d1Db?: any;
}

const { excludeId, limit = 3, d1Db: propDb } = Astro.props;

import { env } from 'cloudflare:workers';
let envLocals: any = null;
try { envLocals = Astro.locals?.runtime?.env; } catch (_) {}

const d1Db = propDb || env?.dulichcoguu_d1 || envLocals?.dulichcoguu_d1;
let latestBlogs: any[] = [];

async function fetchBlogs() {
  let blogs: any[] = [];
  if (d1Db) {
    try {
      let excludeCondition = excludeId ? `AND p.id != ?` : '';
      let query = `
        SELECT p.id, p.slug, p.title, p.excerpt, p.featuredImage 
        FROM Post p
        JOIN PostCategory pc ON (CAST(p.id AS TEXT) = pc.postId OR p.id = pc.postId)
        JOIN BlogCategory bc ON pc.categoryId = bc.id
        WHERE (p.status = 'published' OR p.status = 'publish')
        AND bc.slug = 'blog'
        ${excludeCondition}
        ORDER BY p.createdAt DESC LIMIT ?
      `;
      
      let statement = d1Db.prepare(query);
      if (excludeId) {
        statement = statement.bind(excludeId, limit);
      } else {
        statement = statement.bind(limit);
      }
      
      const blogRes = await statement.all();
      if (blogRes && blogRes.results && blogRes.results.length > 0) {
        blogs = blogRes.results as any[];
      }
    } catch(e) {
      console.error("Failed to fetch blog posts from D1", e);
    }
  }
  return blogs;
}

latestBlogs = await fetchBlogs();

if (latestBlogs.length === 0) {
  latestBlogs = [
    {
      id: 'b1',
      slug: 'tour/half-day-cu-chi-tunnels-tour',
      title: 'Cu Chi Tunnels: The Complete Insider Guide to Underground History (2026)',
      excerpt: 'Explore secret trapdoors, subterranean tunnels, and battle heritage with expert local guides on a VIP small-group expedition.',
      featuredImage: 'https://media.thericetour.com/uploads/group-posing-secret-tunnel-entrance-leaves-cu-chi-1280x720.webp'
    },
    {
      id: 'b2',
      slug: 'tour/full-day-mekong-delta-tour-ben-tre-my-tho',
      title: 'Mekong Delta Discovery: Navigating Coconut Riverways & Local Heritage',
      excerpt: 'Hand-rowed sampans through shaded palm canals, traditional rice paper workshops, and authentic river cuisine.',
      featuredImage: 'https://media.thericetour.com/uploads/girls-taking-selfie-waving-on-rowing-boat-mekong-canal.webp'
    },
    {
      id: 'b3',
      slug: 'tour/cooking-class-local-market',
      title: 'Vietnamese Culinary Masterclass: Morning Wet Market & Traditional Flavors',
      excerpt: 'Handpick fresh regional herbs with a senior chef and prepare iconic Vietnamese delicacies in an immersive private kitchen.',
      featuredImage: 'https://media.thericetour.com/uploads/man-making-rice-paper-steam-traditional-village-mekong.webp'
    }
  ].slice(0, limit);
}
---

<section class="py-16 md:py-24 bg-white">
  <div class="max-w-[1200px] mx-auto px-4 md:px-8">
    <div class="text-center mb-12 lg:mb-16">
      <h2 class="text-4xl md:text-5xl lg:text-6xl font-black text-slate-900 tracking-tight">Blog</h2>
    </div>
    
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 lg:gap-10 mb-16">
      {latestBlogs.map((post) => (
        <a href={`/${post.slug}`} class="group block">
          <div class="overflow-hidden mb-6 bg-slate-50 rounded-lg aspect-video">
            <OptimizedImage 
              src={post.featuredImage || '/placeholder-image.jpg'} 
              alt={post.title} 
              class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" 
              sizes="(max-width: 768px) 100vw, 33vw"
              loading="lazy"
              qualityRole="card"
            />
          </div>
          <h3 class="text-lg md:text-xl font-bold text-[#ea580c] mb-3 group-hover:text-[#c2410c] transition-colors leading-snug line-clamp-3">{post.title}</h3>
          <p class="text-slate-600 text-[15px] leading-relaxed line-clamp-3">{post.excerpt}</p>
        </a>
      ))}
    </div>
    
    <div class="text-center pb-8">
      <a href="/blog" class="inline-block px-12 py-4 bg-[#333333] text-white font-bold text-sm tracking-wider rounded-lg hover:bg-black transition-colors uppercase shadow-md hover:-translate-y-1">
        XEM THÊM
      </a>
    </div>
  </div>
</section>
