---
import { getCanonicalMediaUrl } from '@/lib/imageOptimization';
import OptimizedImage from '@/components/ui/OptimizedImage.astro';

export interface Props {
  excludeId?: string | number;
  limit?: number;
  d1Db?: any;
}

const { excludeId, limit = 3, d1Db: propDb } = Astro.props;

import { env } from 'cloudflare:workers';
let envLocals: any = null;
try { envLocals = Astro.locals?.runtime?.env; } catch (_) {}

const d1Db = propDb || env?.dulichcoguu_d1 || envLocals?.dulichcoguu_d1;
let latestBlogs: any[] = [];

async function fetchBlogs() {
  let blogs: any[] = [];
  if (d1Db) {
    try {
      let excludeCondition = excludeId ? `AND p.id != ?` : '';
      let query = `
        SELECT p.id, p.slug, p.title, p.excerpt, p.featuredImage 
        FROM Post p
        JOIN PostCategory pc ON (CAST(p.id AS TEXT) = pc.postId OR p.id = pc.postId)
        JOIN BlogCategory bc ON pc.categoryId = bc.id
        WHERE (p.status = 'published' OR p.status = 'publish')
        AND bc.slug = 'blog'
        ${excludeCondition}
        ORDER BY p.createdAt DESC LIMIT ?
      `;
      
      let statement = d1Db.prepare(query);
      if (excludeId) {
        statement = statement.bind(excludeId, limit);
      } else {
        statement = statement.bind(limit);
      }
      
      const blogRes = await statement.all();
      if (blogRes && blogRes.results && blogRes.results.length > 0) {
        blogs = blogRes.results as any[];
      }
    } catch(e) {
      console.error("Failed to fetch blog posts from D1", e);
    }
  }
  return blogs;
}

latestBlogs = await fetchBlogs();

if (latestBlogs.length === 0) {
  latestBlogs = [
    {
      id: 'b1',
      slug: 'fit-tour-x-dai-hoc-van-hien',
      title: 'FIT TOUR x Đại học Văn Hiến: Mô hình đào tạo sinh viên du lịch từ thực tế',
      excerpt: 'Trong bối cảnh doanh nghiệp du lịch và dịch vụ ngày càng thiếu hụt nhân sự có kinh nghiệm thực tế, bài toán đào tạo “đúng người – đúng năng lực ...',
      featuredImage: 'https://media.fittour.vn/uploads/2024/06/nhom-du-khach-tai-ho-pangong-motor-adventures-ladakh-fit-tour.webp'
    },
    {
      id: 'b2',
      slug: 'company-trip-phan-thiet-cung-y-viet',
      title: 'Company Trip Phan Thiết cùng Y Việt với hành trình Elite FIT Tour',
      excerpt: 'Company trip Phan Thiết của Y Việt cùng FIT TOUR: hành trình 2 ngày kết hợp morning run, team building và gala dinner, giúp tăng kết nối đội...',
      featuredImage: 'https://media.fittour.vn/uploads/2023/01/du-khach-cuoi-lac-da-ngam-kim-tu-thap-ai-cap.webp'
    },
    {
      id: 'b3',
      slug: 'qbi-group-trong-chuyen-di-le-giang-shangrila',
      title: 'QBI Group trong chuyến đi Lệ Giang – Shangrila cùng FIT Tour',
      excerpt: 'Hành trình Lệ Giang – Shangrila của QBI Group cùng FIT TOUR: chuyến đi doanh nghiệp riêng tư, kết hợp trải nghiệm và gắn kết đội ngũ hiệu quả.',
      featuredImage: 'https://media.fittour.vn/uploads/2024/05/nhung-doa-hoa-no-ro-ven-cac-ngoi-nha-co-kinh-tao-nen-khung-canh-nen-tho-tai-o-tran.webp'
    }
  ].slice(0, limit);
}
---

<section class="py-16 md:py-24 bg-white">
  <div class="max-w-[1200px] mx-auto px-4 md:px-8">
    <div class="text-center mb-12 lg:mb-16">
      <h2 class="text-4xl md:text-5xl lg:text-6xl font-black text-slate-900 tracking-tight">Blog</h2>
    </div>
    
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 lg:gap-10 mb-16">
      {latestBlogs.map((post) => (
        <a href={`/${post.slug}`} class="group block">
          <div class="overflow-hidden mb-6 bg-slate-50 rounded-lg aspect-video">
            <OptimizedImage 
              src={post.featuredImage || '/placeholder-image.jpg'} 
              alt={post.title} 
              class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" 
              sizes="(max-width: 768px) 100vw, 33vw"
              loading="lazy"
              qualityRole="card"
            />
          </div>
          <h3 class="text-lg md:text-xl font-bold text-[#ea580c] mb-3 group-hover:text-[#c2410c] transition-colors leading-snug line-clamp-3">{post.title}</h3>
          <p class="text-slate-600 text-[15px] leading-relaxed line-clamp-3">{post.excerpt}</p>
        </a>
      ))}
    </div>
    
    <div class="text-center pb-8">
      <a href="/blog" class="inline-block px-12 py-4 bg-[#333333] text-white font-bold text-sm tracking-wider rounded-lg hover:bg-black transition-colors uppercase shadow-md hover:-translate-y-1">
        XEM THÊM
      </a>
    </div>
  </div>
</section>
