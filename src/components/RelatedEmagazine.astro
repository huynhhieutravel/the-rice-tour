---
import { getCanonicalMediaUrl } from '@/lib/imageOptimization';
import OptimizedImage from '@/components/ui/OptimizedImage.astro';

export interface Props {
  excludeId?: string | number;
  limit?: number;
  d1Db?: any;
}

const { excludeId, limit = 3, d1Db: propDb } = Astro.props;

import { env } from 'cloudflare:workers';
let envLocals: any = null;
try { envLocals = Astro.locals?.runtime?.env; } catch (_) {}

const d1Db = propDb || env?.dulichcoguu_d1 || envLocals?.dulichcoguu_d1;
let latestEmagazine: any[] = [];

if (d1Db) {
  try {
    let excludeCondition = excludeId ? `AND p.id != ?` : '';
    let query = `
      SELECT p.id, p.slug, p.title, p.excerpt, p.featuredImage 
      FROM Post p
      JOIN PostCategory pc ON (CAST(p.id AS TEXT) = pc.postId OR p.id = pc.postId)
      JOIN BlogCategory bc ON pc.categoryId = bc.id
      WHERE (p.status = 'published' OR p.status = 'publish')
      AND (bc.slug = 'emagazine' OR bc.slug = 'tap-chi-du-lich' OR bc.slug = 'e-magazine' OR bc.slug = 'emegazine')
      ${excludeCondition}
      ORDER BY p.createdAt DESC LIMIT ?
    `;
    
    let statement = d1Db.prepare(query);
    if (excludeId) {
      statement = statement.bind(excludeId, limit);
    } else {
      statement = statement.bind(limit);
    }
    
    const emaRes = await statement.all();
    if (emaRes && emaRes.results && emaRes.results.length > 0) {
      latestEmagazine = emaRes.results as any[];
    }
  } catch(e) {
    console.error("Failed to fetch emagazine posts from D1", e);
  }
}

if (latestEmagazine.length === 0) {
  latestEmagazine = [
    {
      id: 'e1',
      slug: 'fit-tour-thang-giai-bespoke-tour',
      title: 'FIT Tour thắng giải Bespoke Tour năm thứ 2 liên tiếp – HOTLIST Travellive 2025',
      excerpt: 'Năm thứ 2 liên tiếp FIT Tour giữ ngôi vương Bespoke Tour tại HOTLIST Travellive 2025. Cam kết hành trình đi chậm, đi kỹ, an toàn và đậm chất bản sắc.',
      featuredImage: 'https://media.fittour.vn/wp-content/uploads/2023/06/z4408643196947_1ab880e66d5b03f0b2f0a1d4715f36df.jpg'
    },
    {
      id: 'e2',
      slug: 'vung-dat-caucasus',
      title: 'Vùng đất Caucasus – Nơi Con Đường Tơ Lụa Chờ Số Phận & Đức Tin',
      excerpt: 'Vùng đất Caucasus huyền thoại, nơi giao lộ giữa Azerbaijan, Georgia và Armenia. Không chỉ là cảnh đẹp, đây là nơi lưu giữ Con Đường Tơ Lụa.',
      featuredImage: 'https://media.fittour.vn/wp-content/uploads/2024/02/tour-du-lich-giang-nam-trung-quoc.jpg'
    },
    {
      id: 'e3',
      slug: 'dao-thanh-a-dinh',
      title: '1 Ngày Không Sóng, Không Wi-Fi ở Đạo Thành Á Đinh',
      excerpt: 'Trải nghiệm hành trình đến vùng đất thuần khiết Đạo Thành Á Đinh, nơi không sóng, hay Wi-Fi, nhưng đầy kết nối. Núi tuyết, hồ xanh và tĩnh lặng.',
      featuredImage: 'https://media.fittour.vn/wp-content/uploads/2023/12/tour-du-lich-mong-co-fit-tour-2.jpg'
    }
  ].slice(0, limit);
}
---

<section class="py-16 md:py-24 bg-slate-50 border-t border-slate-100">
  <div class="max-w-[1200px] mx-auto px-4 md:px-8">
    <div class="text-center mb-12 lg:mb-16">
      <span class="text-[#ea580c] font-bold tracking-wider uppercase text-sm mb-3 block">Tạp chí du lịch</span>
      <h2 class="text-4xl md:text-5xl lg:text-6xl font-black text-slate-900 tracking-tight">Emagazine</h2>
    </div>
    
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 lg:gap-10">
      {latestEmagazine.map((post) => (
        <a href={`/${post.slug}`} class="group block">
          <div class="overflow-hidden mb-6 bg-slate-50 rounded-lg aspect-video">
            <OptimizedImage 
              src={post.featuredImage || '/placeholder-image.jpg'} 
              alt={post.title} 
              class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" 
              sizes="(max-width: 768px) 100vw, 33vw"
              loading="lazy"
              qualityRole="card"
            />
          </div>
          <h3 class="text-lg md:text-xl font-bold text-slate-900 mb-4 group-hover:text-[#ea580c] transition-colors leading-tight line-clamp-3">{post.title}</h3>
          <p class="text-slate-600 text-[15px] leading-relaxed line-clamp-3">{post.excerpt}</p>
        </a>
      ))}
    </div>
    
    <div class="text-center mt-10 pb-4">
      <a href="/emagazine" class="inline-block px-12 py-4 bg-[#333333] text-white font-bold text-sm tracking-wider rounded-lg hover:bg-black transition-colors uppercase shadow-md hover:-translate-y-1">
        Xem thêm tạp chí
      </a>
    </div>
  </div>
</section>
