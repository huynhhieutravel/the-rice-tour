---
// src/components/system/footer/sections/FooterBottom.astro
export interface Props {
  company?: { name: string; tax?: string };
}
const { company } = Astro.props;
const currentYear = new Date().getFullYear();
---
<div class="flex flex-col md:flex-row items-center justify-between gap-6 text-sm text-white/60">
  
  <div class="flex items-center gap-4">
    <a href="/" class="flex items-center gap-2 text-white font-serif font-bold text-base">
      <span class="w-6 h-6 rounded bg-brand-600 flex items-center justify-center text-xs font-sans text-white font-black">🌾</span>
      The Rice Tour
    </a>
    <span class="border-l border-white/20 pl-4">Authentic Vietnam Inbound Expeditions</span>
  </div>

  <div class="text-center md:text-right">
    <p>Copyright © {currentYear} {company?.name || 'The Rice Tour'}. All rights reserved.</p>
  </div>

</div>
