---
// src/components/system/footer/sections/FooterContact.astro
export interface Props {
  contact?: { address?: string; email?: string; phone?: string; hotline2?: string; hotline3?: string };
}
const { contact } = Astro.props;
---
<div class="flex flex-col gap-6">
  <h3 class="text-brand-500 font-bold text-lg">Liên hệ</h3>
  
  <div class="flex flex-col gap-4">
    <h4 class="text-white font-bold text-md">Địa chỉ</h4>
    <ul class="space-y-3 text-sm text-gray-300">
      <li class="flex items-start gap-3">
        <svg class="w-4 h-4 text-gray-400 mt-1 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
        </svg>
        <span>{contact?.address || '180 Bùi Viện, Phường Bến Thành, Quận 1, TP.HCM'}</span>
      </li>
      <li class="flex items-center gap-3">
        <svg class="w-4 h-4 text-gray-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
        </svg>
        <a href={`mailto:${contact?.email || 'info@fittour.com.vn'}`} class="hover:text-white transition-colors">{contact?.email || 'info@fittour.com.vn'}</a>
      </li>
    </ul>
  </div>

  <div class="flex flex-col gap-4">
    <h4 class="text-white font-bold text-md">Hotline</h4>
    <ul class="space-y-3 text-sm text-gray-300">
      <li class="flex items-center gap-3">
        <svg class="w-4 h-4 text-gray-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
        </svg>
        <a href="tel:02888887888" class="hover:text-white transition-colors">Hotline 1: 028.8888.7888</a>
      </li>
      <li class="flex items-center gap-3">
        <svg class="w-4 h-4 text-gray-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
        </svg>
        <a href="tel:0962333621" class="hover:text-white transition-colors">Hotline 2: 0962.333.621</a>
      </li>
    </ul>
  </div>

  <div class="flex flex-col gap-4">
    <h4 class="text-white font-bold text-md">Tư vấn Tour Riêng & Doanh Nghiệp</h4>
    <ul class="space-y-3 text-sm text-gray-300">
      <li class="flex items-center gap-3">
        <svg class="w-4 h-4 text-gray-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
        </svg>
        <a href="https://wa.me/0962333621" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors text-[#25D366] font-bold">WhatsApp: 0962.333.621</a>
      </li>
    </ul>
  </div>

  {/* Badges & QR Code - Tạm ẩn theo yêu cầu */}
  {/* <div class="flex flex-col gap-4 mt-2">
    <a rel="nofollow" href="#" title="DMCA.com Protection Status" class="block w-[120px]">
      <img src="https://images.dmca.com/Badges/dmca_protected_1_120.png?ID=fbd66997-2cca-4504-981f-05a220d0bf20" alt="DMCA.com Protection Status" class="w-full h-auto" loading="lazy" />
    </a>
    <div class="w-[150px] bg-white p-2 rounded-lg">
      <img src="https://media.fittour.vn/uploads/2021/08/qr-code-dulichcoguu.webp" alt="QR Code" class="w-full h-auto rounded" loading="lazy" />
    </div>
  </div> */}

</div>
