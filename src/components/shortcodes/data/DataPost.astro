---
import { env } from 'cloudflare:workers';
import OptimizedImage from '@/components/ui/OptimizedImage.astro';

export interface Props {
  source?: 'tag' | 'category' | 'slugs';
  slug?: string;
  limit?: string | number;
  layout?: 'grid' | 'carousel';
  title?: string;
  dataMap?: Record<string, any>;
  cols?: string | number;
  exclude_current?: string;
}

const { source, slug, limit = '6', layout = 'carousel', title, dataMap, cols, exclude_current } = Astro.props;
const numLimit = parseInt(String(limit), 10) || 6;
const numCols = parseInt(String(cols), 10) || 3;

let envLocals: any = null;
try { envLocals = Astro.locals?.runtime?.env; } catch (_) {}
const d1Db = env?.dulichcoguu_d1 || envLocals?.dulichcoguu_d1;

let posts: any[] = [];

if (d1Db) {
  try {
    let query = `
      SELECT p.id, p.slug, p.title, p.excerpt, p.featuredImage 
      FROM Post p
    `;
    
    let bindArgs: any[] = [];
    
    if (source === 'tag' && slug) {
      query += `
        JOIN PostTag pt ON (CAST(p.id AS TEXT) = pt.postId OR p.id = pt.postId)
        JOIN Tag t ON pt.tagId = t.id
        WHERE (p.status = 'published' OR p.status = 'publish')
        AND t.slug = ?
      `;
      bindArgs.push(slug);
    } else if (source === 'category' && slug) {
      query += `
        JOIN PostCategory pc ON (CAST(p.id AS TEXT) = pc.postId OR p.id = pc.postId)
        JOIN BlogCategory bc ON pc.categoryId = bc.id
        WHERE (p.status = 'published' OR p.status = 'publish')
        AND bc.slug = ?
      `;
      bindArgs.push(slug);
    } else if (source === 'slugs' && slug) {
      const slugsArray = slug.split(',').map(s => s.trim());
      const placeholders = slugsArray.map(() => '?').join(',');
      query += `
        WHERE (p.status = 'published' OR p.status = 'publish')
        AND p.slug IN (${placeholders})
      `;
      bindArgs.push(...slugsArray);
    } else {
      // Fallback: Just latest posts
      query += ` WHERE (p.status = 'published' OR p.status = 'publish') `;
    }

    if (exclude_current === 'true') {
      const currentPath = Astro.url.pathname;
      const currentSlug = currentPath.split('/').filter(Boolean).pop();
      if (currentSlug) {
        query += ` AND p.slug != ? `;
        bindArgs.push(currentSlug);
      }
    }

    query += ` ORDER BY p.createdAt DESC LIMIT ?`;
    bindArgs.push(numLimit);

    let statement = d1Db.prepare(query);
    statement = statement.bind(...bindArgs);

    const res = await statement.all();
    if (res && res.results) {
      posts = res.results as any[];
    }
  } catch (e) {
    console.error("[DataPost] DB Error:", e);
  }
}

// If no data, return nothing (prevent blank space layout break)
if (!posts || posts.length === 0) {
  return null;
}
---

<div class="data-block-wrapper my-12 relative group" data-carousel-id={slug || 'latest'}>
  {title && (
    <div class="flex items-center justify-between mb-8">
      <div class="flex items-center gap-3">
        <div class="w-1.5 h-8 bg-[#ea580c] rounded-full"></div>
        <h3 class="text-2xl md:text-[28px] font-serif font-bold text-slate-900">{title}</h3>
      </div>
    </div>
  )}

  {layout === 'grid' ? (
    <div class={`flex md:grid overflow-x-auto md:overflow-x-visible snap-x snap-mandatory md:snap-none grid-cols-1 md:grid-cols-2 ${numCols === 2 ? 'lg:grid-cols-2 max-w-5xl mx-auto' : (numCols === 1 ? 'lg:grid-cols-1 max-w-3xl mx-auto' : 'lg:grid-cols-3')} gap-6 md:gap-8 pb-6 md:pb-0 hide-scrollbar`}>
      {posts.map((post) => {
        let displayTitle = post.title;
        let badgeText = null;
        const partMatch = post.title.match(/Phần\s*\d+/i);
        if (partMatch) {
          badgeText = partMatch[0];
          displayTitle = post.title.replace(/\s*(?:-|–)\s*Phương Thanh x FIT Tour\s*Phần\s*\d+/i, '');
          displayTitle = displayTitle.replace(/\s*\?\s*Phương Thanh x FIT Tour\s*Phần\s*\d+/i, '?');
          displayTitle = displayTitle.replace(/\s*(?:-|–)\s*Phần\s*\d+/i, '');
          displayTitle = displayTitle.trim();
        }

        return (
        <a href={`/${post.slug}`} class={`!no-underline snap-start shrink-0 ${numCols === 2 ? 'w-[70vw] sm:w-[380px]' : (numCols === 1 ? 'w-[85vw] sm:w-[500px]' : 'w-[70vw] sm:w-[320px]')} md:w-auto md:shrink group flex flex-col h-full bg-white border border-slate-200/60 rounded-2xl overflow-hidden hover:shadow-xl hover:shadow-sky-900/5 hover:-translate-y-1 transition-all duration-300`}>
          <div class="relative aspect-[16/9] overflow-hidden bg-slate-100">
            {badgeText && (
              <span class="absolute top-3 left-3 bg-amber-700 text-white text-[10px] md:text-xs font-bold uppercase tracking-wider px-2.5 py-1 rounded-full z-10 shadow-lg">
                {badgeText}
              </span>
            )}
            <OptimizedImage 
              src={post.featuredImage || '/placeholder-image.jpg'} 
              alt={post.title} 
              class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
              sizes="(max-width: 768px) 100vw, 33vw"
              loading="lazy"
              qualityRole="card"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
          </div>
          <div class="p-5 md:p-6 flex flex-col flex-1">
            <h4 class="font-bold text-[17px] md:text-lg text-slate-900 mb-3 md:mb-4 line-clamp-2 leading-snug group-hover:text-sky-700 transition-colors">
              {displayTitle}
            </h4>
            <p class="text-slate-500 text-sm leading-relaxed line-clamp-3 md:line-clamp-4">
              {post.excerpt}
            </p>
          </div>
          <div class="px-5 md:px-6 pb-6 mt-auto">
            <span class="text-[#c2410c] font-semibold text-[13px] md:text-sm flex items-center group-hover:translate-x-1 transition-transform">
              Xem chi tiết <svg class="w-4 h-4 ml-1" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
            </span>
          </div>
        </a>
      )})}
    </div>
  ) : (
    /* Carousel/Scroll Snap layout */
    <div class="relative w-full">
      <div class="carousel-track flex overflow-x-auto snap-x snap-mandatory gap-5 md:gap-6 pb-6 hide-scrollbar scroll-smooth">
        {posts.map((post) => {
          let displayTitle = post.title;
          let badgeText = null;
          const partMatch = post.title.match(/Phần\s*\d+/i);
          if (partMatch) {
            badgeText = partMatch[0];
            displayTitle = post.title.replace(/\s*(?:-|–)\s*Phương Thanh x FIT Tour\s*Phần\s*\d+/i, '');
            displayTitle = displayTitle.replace(/\s*\?\s*Phương Thanh x FIT Tour\s*Phần\s*\d+/i, '?');
            displayTitle = displayTitle.replace(/\s*(?:-|–)\s*Phần\s*\d+/i, '');
            displayTitle = displayTitle.trim();
          }
          
          return (
          <a href={`/${post.slug}`} class="!no-underline snap-start shrink-0 w-[85vw] sm:w-[280px] md:w-[295px] group flex flex-col h-full bg-white border border-slate-200/60 rounded-2xl overflow-hidden hover:shadow-xl hover:shadow-sky-900/5 hover:-translate-y-1 transition-all duration-300">
            <div class="relative aspect-[16/9] overflow-hidden bg-slate-100">
              {badgeText && (
                <span class="absolute top-3 left-3 bg-amber-700 text-white text-[10px] md:text-xs font-bold uppercase tracking-wider px-2.5 py-1 rounded-full z-10 shadow-lg">
                  {badgeText}
                </span>
              )}
              <OptimizedImage 
                src={post.featuredImage || '/placeholder-image.jpg'} 
                alt={post.title} 
                class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                loading="lazy"
                qualityRole="card"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
            </div>
            <div class="p-5 flex flex-col flex-1">
              <h4 class="text-base md:text-[17px] font-bold text-slate-900 mb-3 group-hover:text-[#c2410c] transition-colors leading-snug line-clamp-2">{post.title}</h4>
              <div class="mt-auto pt-4 border-t border-slate-100 flex items-center justify-between">
                <span class="text-[13px] font-bold text-[#c2410c] flex items-center gap-1.5 group-hover:text-sky-700 transition-colors">
                  Xem chi tiết
                  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="transition-transform duration-300 group-hover:translate-x-1"><path d="m9 18 6-6-6-6"/></svg>
                </span>
              </div>
            </div>
          </a>
        )})}
      </div>
      
      {/* Navigation Buttons placed on sides */}
      <button aria-label="Previous" class="carousel-prev absolute left-1 md:-left-5 top-[40%] -translate-y-1/2 z-10 w-10 h-10 md:w-12 md:h-12 rounded-full bg-white shadow-[0_8px_30px_rgb(0,0,0,0.12)] border border-slate-100 flex items-center justify-center text-slate-600 hover:text-sky-600 hover:scale-110 disabled:opacity-0 transition-all">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="md:w-[22px] md:h-[22px]"><path d="m15 18-6-6 6-6"/></svg>
      </button>
      <button aria-label="Next" class="carousel-next absolute right-1 md:-right-5 top-[40%] -translate-y-1/2 z-10 w-10 h-10 md:w-12 md:h-12 rounded-full bg-white shadow-[0_8px_30px_rgb(0,0,0,0.12)] border border-slate-100 flex items-center justify-center text-slate-600 hover:text-sky-600 hover:scale-110 disabled:opacity-0 transition-all">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="md:w-[22px] md:h-[22px]"><path d="m9 18 6-6-6-6"/></svg>
      </button>
    </div>
  )}
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const carousels = document.querySelectorAll('.data-block-wrapper');
    
    carousels.forEach(container => {
      const track = container.querySelector('.carousel-track') as HTMLElement;
      const prevBtn = container.querySelector('.carousel-prev') as HTMLButtonElement;
      const nextBtn = container.querySelector('.carousel-next') as HTMLButtonElement;
      
      if (!track || !prevBtn || !nextBtn) return;
      
      // Card width + gap
      const getScrollAmount = () => {
        const card = track.querySelector('a');
        if (!card) return 330;
        const style = window.getComputedStyle(card);
        const gap = parseInt(window.getComputedStyle(track).gap) || 24;
        return card.offsetWidth + gap;
      };
      
      const updateButtons = () => {
        const isAtStart = track.scrollLeft <= 5;
        const isAtEnd = track.scrollLeft + track.clientWidth >= track.scrollWidth - 5;
        
        prevBtn.disabled = isAtStart;
        nextBtn.disabled = isAtEnd;
      };
      
      track.addEventListener('scroll', updateButtons);
      window.addEventListener('resize', updateButtons);
      
      prevBtn.addEventListener('click', () => {
        track.scrollBy({ left: -getScrollAmount(), behavior: 'smooth' });
      });
      
      nextBtn.addEventListener('click', () => {
        track.scrollBy({ left: getScrollAmount(), behavior: 'smooth' });
      });
      
      // Init buttons
      setTimeout(updateButtons, 100);
    });
  });
</script>

<style>
  /* Auto-scoped CSS */
  .hide-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .hide-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>
