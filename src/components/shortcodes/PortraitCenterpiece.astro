const pathname = Astro.url.pathname;
let coversToRender = pathname.includes('/co-may') ? CO_MAY_LOCATIONS : 
                     pathname.includes('/tay-tang') ? TAY_TANG_COVERS : 
                     pathname.includes('/bhutan') ? BHUTAN_COVERS : 
                     pathname.includes('/nepal') ? NEPAL_COVERS : 
                     pathname.includes('/sikkim') ? SIKKIM_COVERS : 
                     pathname.includes('/silkroad') ? SILKROAD_COVERS : 
                     pathname.includes('/china') ? CHINA_COVERS : 
                     pathname.includes('/chau-phi') ? AFRICA_COVERS : 
                     pathname.includes('/arctic') ? ARCTIC_COVERS : 
                     pathname.includes('/motor') ? MOTOR_COVERS : 
                     pathname.includes('/kailash') ? KAILASH_COVERS : SERIES_COVERS;

let backgroundWordmark = pathname.includes('/tay-tang') ? "TÂY TẠNG 2026" : 
                         pathname.includes('/bhutan') ? "BHUTAN 2026" : 
                         pathname.includes('/nepal') ? "NEPAL 2026" : 
                         pathname.includes('/sikkim') ? "SIKKIM 2026" : 
                         pathname.includes('/silkroad') ? "SILK ROAD" : 
                         pathname.includes('/china') ? "CHINA HERITAGE" : 
                         pathname.includes('/chau-phi') ? "AFRICAN BESPOKE" : 
                         pathname.includes('/arctic') ? "ARCTIC VOYAGE" : 
                         pathname.includes('/motor') ? "MOTOR ADVENTURE" : 
                         pathname.includes('/kailash') ? "KAILASH 2026" : "CÔ MÂY U70";
let collectionName = pathname.includes('/tay-tang') ? "Tây Tạng 2026" : 
                     pathname.includes('/bhutan') ? "Bhutan 2026" : 
                     pathname.includes('/nepal') ? "Nepal 2026" : 
                     pathname.includes('/sikkim') ? "Sikkim 2026" : 
                     pathname.includes('/silkroad') ? "Silk Road" : 
                     pathname.includes('/china') ? "China Heritage" : 
                     pathname.includes('/chau-phi') ? "African Bespoke" : 
                     pathname.includes('/arctic') ? "Arctic Collection" : 
                     pathname.includes('/motor') ? "Motor Adventure" : 
                     pathname.includes('/kailash') ? "Kailash 2026" : "Ladakh 2026";
let gpsLabel = pathname.includes('/tay-tang') ? "Tibet GPS Point" : 
               pathname.includes('/bhutan') ? "Bhutan GPS Point" : 
               pathname.includes('/nepal') ? "Nepal GPS Point" : 
               pathname.includes('/sikkim') ? "Sikkim GPS Point" : 
               pathname.includes('/silkroad') ? "Silk Road GPS Point" : 
               pathname.includes('/china') ? "China GPS Point" : 
               pathname.includes('/chau-phi') ? "Africa GPS Point" : 
               pathname.includes('/arctic') ? "Arctic GPS Point" : 
               pathname.includes('/motor') ? "Motor GPS Point" : 
               pathname.includes('/kailash') ? "Kailash GPS Point" : "Ladakh GPS Point";
let sectionTitle = pathname.includes('/tay-tang') ? "\"Chạm Vào Cõi Linh Thiêng Trên Nóc Nhà Thế Giới\"" : 
                   pathname.includes('/bhutan') ? "\"Chạm Vào Vương Quốc Của Sự Hạnh Phúc\"" : 
                   pathname.includes('/nepal') ? "\"Nơi Thử Thách Giới Hạn Bản Thân Và Chữa Lành Tâm Hồn\"" : 
                   pathname.includes('/sikkim') ? "\"Vương Quốc Của Những Rặng Núi Tuyết Vĩnh Cửu\"" : 
                   pathname.includes('/silkroad') ? "\"Dấu Ấn Của Những Nền Văn Minh Cổ Đại\"" : 
                   pathname.includes('/china') ? "\"Những Mảnh Ghép Vĩ Đại Của Lịch Sử\"" : 
                   pathname.includes('/chau-phi') ? "\"Nơi Khởi Nguồn Của Sự Sống\"" : 
                   pathname.includes('/arctic') ? "\"Chasing Light Across The North\"" : 
                   pathname.includes('/motor') ? "\"Ride Beyond Boundaries\"" : 
