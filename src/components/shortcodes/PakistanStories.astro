---
---
<section class="py-24 lg:py-32 bg-[#050505] border-t border-white/5 font-sans" id="stories">
  <div class="max-w-[1400px] mx-auto px-6 lg:px-12">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-12">
      <h2 class="text-3xl md:text-4xl font-serif text-white uppercase tracking-wide">Kinh nghiệm du lịch Pakistan</h2>
      <a class="inline-flex items-center gap-4 text-[10px] font-bold tracking-[0.2em] uppercase text-gray-400 hover:text-white transition-colors group" href="/blog/cam-nang-du-lich-pakistan">
        XEM TẤT CẢ
        <span class="text-base leading-none transition-transform group-hover:translate-x-1">→</span>
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      
      <!-- Article 1 -->
      <a href="/cao-toc-karakoram" class="group/story flex flex-col border border-white/10 bg-[#0a0a0a] hover:border-white/30 transition-colors">
        <div class="relative w-full aspect-video overflow-hidden bg-[#111]">
          <img src="https://media.fittour.vn/uploads/2022/12/doan-duong-cao-toc-Karakoram.webp" alt="Đường cao tốc Karakoram" class="w-full h-full object-cover opacity-80 group-hover/story:opacity-100 group-hover/story:scale-105 transition-all duration-700 ease-out" loading="lazy">
        </div>
        <div class="p-6 md:p-8 flex flex-col flex-grow">
          <p class="text-[#4caf50] text-[10px] font-bold tracking-[0.2em] uppercase mb-4">CẨM NANG</p>
          <h3 class="text-white font-serif text-xl lg:text-[22px] leading-snug mb-8">Đường Cao Tốc Karakoram - Con Đường Cao Nhất Thế Giới</h3>
          <span class="inline-flex items-center gap-3 text-[10px] font-bold tracking-[0.2em] uppercase text-[#4caf50] hover:text-white transition-colors mt-auto">
            ĐỌC BÀI VIẾT
            <span class="text-base leading-none transition-transform group-hover/story:translate-x-1">→</span>
          </span>
        </div>
      </a>

      <!-- Article 2 -->
      <a href="/nha-tho-hoi-giao-shah-faisal" class="group/story flex flex-col border border-white/10 bg-[#0a0a0a] hover:border-white/30 transition-colors">
        <div class="relative w-full aspect-video overflow-hidden bg-[#111]">
          <img src="https://media.fittour.vn/uploads/2022/12/du-khach-chup-anh-o-nha-tho-hoi-giao-Shah-Faisal.webp" alt="Nhà thờ Hồi giáo Shah Faisal" class="w-full h-full object-cover opacity-80 group-hover/story:opacity-100 group-hover/story:scale-105 transition-all duration-700 ease-out" loading="lazy">
        </div>
        <div class="p-6 md:p-8 flex flex-col flex-grow">
          <p class="text-[#4caf50] text-[10px] font-bold tracking-[0.2em] uppercase mb-4">KINH NGHIỆM</p>
          <h3 class="text-white font-serif text-xl lg:text-[22px] leading-snug mb-8">Nhà Thờ Hồi Giáo Shah Faisal - Biểu Tượng Của Pakistan</h3>
          <span class="inline-flex items-center gap-3 text-[10px] font-bold tracking-[0.2em] uppercase text-[#4caf50] hover:text-white transition-colors mt-auto">
            ĐỌC BÀI VIẾT
            <span class="text-base leading-none transition-transform group-hover/story:translate-x-1">→</span>
          </span>
        </div>
      </a>

      <!-- Article 3 -->
      <a href="/thung-lung-hopper" class="group/story flex flex-col border border-white/10 bg-[#0a0a0a] hover:border-white/30 transition-colors">
        <div class="relative w-full aspect-video overflow-hidden bg-[#111]">
          <img src="https://media.fittour.vn/uploads/2022/03/Hopper-Valley-3.webp" alt="Thung lũng Hopper" class="w-full h-full object-cover opacity-80 group-hover/story:opacity-100 group-hover/story:scale-105 transition-all duration-700 ease-out" loading="lazy">
        </div>
        <div class="p-6 md:p-8 flex flex-col flex-grow">
          <p class="text-[#4caf50] text-[10px] font-bold tracking-[0.2em] uppercase mb-4">KHÁM PHÁ</p>
          <h3 class="text-white font-serif text-xl lg:text-[22px] leading-snug mb-8">Khám Phá Thung Lũng Hopper - Điểm Nhấn Đặc Biệt</h3>
          <span class="inline-flex items-center gap-3 text-[10px] font-bold tracking-[0.2em] uppercase text-[#4caf50] hover:text-white transition-colors mt-auto">
            ĐỌC BÀI VIẾT
            <span class="text-base leading-none transition-transform group-hover/story:translate-x-1">→</span>
          </span>
        </div>
      </a>

    </div>
  </div>
</section>
