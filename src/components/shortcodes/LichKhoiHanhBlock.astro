---
export interface Props {
  product_code?: string;
  type?: string; // 'b2b' (Đại lý) hoặc 'b2c' (Khách hàng lẻ)
  dataMap?: Record<string, any>;
  limit?: number; // Random pick N departures (dùng cho "Các lịch khởi hành khác")
  exactTitle?: string; // Exact match for title
}

const { product_code, type = 'b2c', limit, exactTitle } = Astro.props;

let departures: any[] = [];
let error: string | null = null;
let allTours: any[] = [];

// Safely get env for KV cache
let env: any = null;
try { env = Astro.locals?.runtime?.env; } catch (_) {}

const CACHE_TTL = 300 * 1000; // 5 minutes cache to prevent ERP overload
if (!(globalThis as any).lkhCache) {
  (globalThis as any).lkhCache = {};
}

async function loadData() {
  const cacheKey = `tours_cache_${type}`;
  const now = Date.now();

  // 1. Check in-memory global cache first
  if ((globalThis as any).lkhCache[cacheKey]) {
    const { promise, timestamp } = (globalThis as any).lkhCache[cacheKey];
    if (now - timestamp < CACHE_TTL) {
      try {
        return await promise;
      } catch (e) {
        // Fallback to retry if promise was rejected
      }
    }
  }

  // 2. Wrap the fetch logic in a promise and cache it immediately so concurrent calls await the SAME promise
  const fetchPromise = (async () => {
    let tours: any[] = [];
    let loadError: string | null = null;
    try {
      const apiUrl = `https://erp.fittour.vn/api/op-tours/${type}`;
      const response = await fetch(apiUrl, {
        headers: { 'Accept': 'application/json' },
        signal: AbortSignal.timeout(15000)
      });

      if (response.ok) {
        const json = await response.json();
        const isArray = Array.isArray(json);
        const hasData = Array.isArray(json?.data);
        tours = isArray ? json : (hasData ? json.data : []);

        // Cache to KV for fallback
        if (env?.SESSION) {
          env.SESSION.put(cacheKey, JSON.stringify(tours)).catch(() => {});
        }
      } else {
        throw new Error(`API returned ${response.status}`);
      }
    } catch (e: any) {
      console.error("[LichKhoiHanhBlock] Fetch error:", e);
      // Fallback to KV cache
      if (env?.SESSION) {
        try {
          const cached = await env.SESSION.get(cacheKey, "json");
          if (cached && Array.isArray(cached)) {
            tours = cached;
          } else {
            loadError = `Không thể kết nối hệ thống: ${e.message}`;
          }
        } catch (_) {
          loadError = `Không thể kết nối hệ thống: ${e.message}`;
        }
      } else {
        loadError = `Không thể kết nối hệ thống: ${e.message}`;
      }
    }
    
    // If there is an error, remove this promise from the global cache so the next request can retry
    if (loadError) {
      delete (globalThis as any).lkhCache[cacheKey];
    }
    
    return { tours, loadError };
  })();

  (globalThis as any).lkhCache[cacheKey] = { promise: fetchPromise, timestamp: now };
  return fetchPromise;
}

try {
  const data = await loadData();
  allTours = data.tours;
  if (data.loadError) {
    error = data.loadError;
  }

  // Filter: remove past dates and empty dates
  if (!error && allTours.length > 0) {
    const today = new Date();
    today.setHours(0, 0, 0, 0);

    const validTours = allTours.filter((t: any) => {
      if (!t || !t.departureDate) return false;
      const safeDate = typeof t.departureDate === 'string' ? t.departureDate.replace(' ', 'T') : t.departureDate;
      const d = new Date(safeDate);
      if (isNaN(d.getTime())) return false;
      return d >= today;
    });

      if (product_code) {
      const pcs = product_code.toUpperCase().split(',').map((s: string) => s.trim());
      departures = validTours.filter((t: any) => {
        const tCode = (t.code || '').toUpperCase().trim();
        const tSlug = (t.slug || '').toUpperCase().trim();
        const tDest = (t.destinationSlug || '').toUpperCase().trim();
        const tTitle = (t.title || '').trim();
        
        if (exactTitle && tTitle !== exactTitle) return false;

        // Exact match or Substring match for slug and dest
        if (pcs.includes(tSlug) || pcs.includes(tDest)) return true;
        if (pcs.some((p: string) => tDest.includes(p) || tSlug.includes(p))) return true;
        // Exact or Prefix match for code (e.g. 'TÂN CƯƠNG 8N7Đ' matches 'TÂN CƯƠNG 8N7Đ-20261023')
        if (pcs.includes(tCode)) return true;
        if (pcs.some((p: string) => tCode.startsWith(p + '-') || tCode.startsWith(p + ' '))) return true;
        
        return false;
      });
    } else {
      departures = validTours;
      if (exactTitle) {
        departures = departures.filter((t: any) => (t.title || '').trim() === exactTitle);
      }
    }

    // Random shuffle + limit (for "Các lịch khởi hành khác" sections)
    if (limit && limit > 0 && departures.length > limit) {
      // Fisher-Yates shuffle
      const shuffled = [...departures];
      for (let i = shuffled.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [shuffled[i], shuffled[j]] = [shuffled[j], shuffled[i]];
      }
      departures = shuffled.slice(0, limit);
      // Re-sort by departure date after random pick
      departures.sort((a: any, b: any) => {
        const da = new Date(a.departureDate || 0).getTime();
        const db = new Date(b.departureDate || 0).getTime();
        return da - db;
      });
    }
  }
} catch (globalErr: any) {
  error = `Fatal: ${globalErr.message || String(globalErr)}`;
}

// Helpers
const formatDate = (dateStr: string) => {
  if (!dateStr) return '';
  const safeDate = typeof dateStr === 'string' ? dateStr.replace(' ', 'T') : dateStr;
  const d = new Date(safeDate);
  if (isNaN(d.getTime())) return dateStr;
  const vnTime = new Date(d.getTime() + 7 * 60 * 60 * 1000);
  return `${vnTime.getUTCDate().toString().padStart(2, '0')}/${(vnTime.getUTCMonth() + 1).toString().padStart(2, '0')}/${vnTime.getUTCFullYear()}`;
};

const formatPrice = (price: any) => {
  if (!price && price !== 0) return 'Liên hệ';
  if (typeof price === 'number') {
    return price.toLocaleString('vi-VN') + ' VNĐ';
  }
  return String(price);
};

// Get airline name: prefer API field, fallback to parsing from string
const getAirlineName = (airline: any, direction: 'departure' | 'return'): string => {
  if (!airline) return '';
  // Use dedicated name field from API (added in opTourService.js)
  const nameField = direction === 'departure' ? airline.departureName : airline.returnName;
  if (nameField) return nameField;
  // Fallback: parse from full string (for cached/old data)
  const raw = airline[direction];
  if (!raw) return '';
  const line = raw.split('\n')[0].trim();
  const match = line.match(/^(.+?)\s+(?:[A-Z]{2}\s*\d|\d{1,2}[A-Z]{3}|\d+\.\s)/i);
  if (match) return match[1].trim();
  const fallback = line.match(/^([^0-9]+)/i);
  return fallback ? fallback[1].trim() : line;
};

// Zalo & Messenger links (short redirects)
const ZALO_URL = '/zalo';
const MESSENGER_URL = '/msg';

// Market Group Taxonomy (mirrors CRM constants/markets.js)
const MARKET_GROUPS: { label: string; children: string[] }[] = [
  { label: 'Trung Quốc', children: ['Trung Quốc','Bắc Kinh','Cáp Nhĩ Tân','Cửu Trại Câu','Giang Nam','Giang Tây','Lệ Giang','Tân Cương','Tây An','Tây Tạng','Vân Nam','Á Đinh','Trương Gia Giới','Phượng Hoàng Cổ Trấn','Thượng Hải','Hàng Châu','Tô Châu','Trùng Khánh','Thành Đô'] },
  { label: 'Đông Bắc Á', children: ['Hàn Quốc','Nhật Bản','Đài Loan','Mông Cổ'] },
  { label: 'Đông Nam Á', children: ['Đông Nam Á','Bali','Indonesia','Bromo','Campuchia','Thái Lan','Singapore','Malaysia','Lào','Philippines'] },
  { label: 'Nam Á & Himalayas', children: ['Bhutan','Himalayas','Kailash','Kashmir','Ladakh','Nepal','Pakistan'] },
  { label: 'Con Đường Tơ Lụa', children: ['Trung Á','Caucasus','Silk Road'] },
  { label: 'Châu Âu & Nga', children: ['Châu Âu','Nga - Murmansk'] },
  { label: 'Trung Đông & Châu Phi', children: ['Trung Đông','Thổ Nhĩ Kỳ','Dubai','Ai Cập','Morocco','Châu Phi','Ả Rập'] },
  { label: 'Châu Mỹ', children: ['Mỹ'] },
];

// Build active groups: only groups that have tours in data (Case Insensitive Match)
const allDests = new Set(departures.map((d: any) => (d.destination || '').trim()).filter(Boolean));

const normalizeStr = (s: string) => s.toLowerCase().trim();

const activeGroups = MARKET_GROUPS
  .map(g => {
    return {
      label: g.label,
      children: g.children.filter(c => {
        // Only keep this child if it exists in allDests (use .includes for comma-separated or partial matches)
        const normC = normalizeStr(c);
        for (let d of allDests) {
          if (normalizeStr(d).includes(normC)) return true;
        }
        return false;
      })
    };
  })
  .filter(g => g.children.length > 0);

// Destinations not in any group
const mappedDestsNorm = new Set(MARKET_GROUPS.flatMap(g => g.children).map(normalizeStr));
const unmapped = [...allDests].filter(d => {
  const normD = normalizeStr(d);
  // If normD contains any of the mapped categories, it is mapped
  for (let md of mappedDestsNorm) {
    if (normD.includes(md)) return false;
  }
  return true;
});
if (unmapped.length > 0) {
  activeGroups.push({ label: 'Khác', children: unmapped });
}
const totalDestCount = departures.length;

// Collect unique months for dropdown
const uniqueMonthsSet = new Set<string>();
departures.forEach((t: any) => {
  if (!t || !t.departureDate) return;
  const safeDate = typeof t.departureDate === 'string' ? t.departureDate.replace(' ', 'T') : t.departureDate;
  const d = new Date(safeDate);
  if (isNaN(d.getTime())) return;
  const yyyy = d.getFullYear();
  const mm = String(d.getMonth() + 1).padStart(2, '0');
  uniqueMonthsSet.add(`${yyyy}-${mm}`);
});
const availableMonths = Array.from(uniqueMonthsSet).sort();
---

<div class={`lich-khoi-hanh-wrapper font-sans ${!product_code ? 'my-8' : ''}`}>

  {!product_code && (
    <div class="flex items-center gap-3 mb-6">
      <div class="w-10 h-10 rounded-full bg-brand-50 flex items-center justify-center text-brand-700">
        <svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
      </div>
      <div class="text-2xl font-bold text-slate-800 m-0">Lịch Khởi Hành &amp; Bảng Giá</div>
    </div>
  )}

  {/* Filter Bar */}
  {departures.length > 0 && !product_code && (
    <div id="lkh-filter-bar" class="mb-6 space-y-3">
      {/* Row 1: Search + Date */}
      <div class="flex flex-wrap gap-3 items-end">
        <div class="flex-1 min-w-[180px]">
          <label class="block text-xs font-semibold text-slate-500 mb-1">Tìm kiếm:</label>
          <input id="lkh-search" type="text" placeholder="Mã, tên tour.." class="w-full px-3 py-2 text-sm border border-slate-200 rounded-lg bg-white focus:outline-none focus:ring-2 focus:ring-brand-500/30 focus:border-brand-500 transition-colors" />
        </div>
        <div class="min-w-[180px] relative lkh-month-wrap">
          <label class="block text-xs font-semibold text-slate-500 mb-1">Tháng khởi hành:</label>
          <div class="relative">
            <button id="lkh-month-btn" class="w-full px-3 py-2 text-sm border border-slate-200 rounded-lg bg-white flex justify-between items-center focus:outline-none focus:ring-2 focus:ring-brand-500/30 focus:border-brand-500 transition-colors cursor-pointer text-slate-700">
              <span id="lkh-month-btn-text" class="truncate">Tất cả các tháng</span>
              <svg class="h-4 w-4 text-slate-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
            </button>
            <div id="lkh-month-menu" class="hidden absolute top-full left-0 mt-1 w-full bg-white border border-slate-200 rounded-lg shadow-lg z-50 max-h-[240px] overflow-y-auto py-1">
              {availableMonths.map((m) => {
                const [year, month] = m.split('-');
                return (
                  <label class="flex items-center gap-2 px-3 py-2 hover:bg-slate-50 cursor-pointer text-sm transition-colors">
                    <input type="checkbox" value={m} class="lkh-month-cb rounded border-slate-300 text-brand-700 focus:ring-brand-500 w-4 h-4 cursor-pointer" />
                    <span class="text-slate-700">Tháng {month}/{year}</span>
                  </label>
                );
              })}
            </div>
          </div>
        </div>
        <button id="lkh-reset" class="px-4 py-2 text-sm font-semibold text-slate-500 bg-slate-100 rounded-lg hover:bg-slate-200 transition-colors" title="Xoá bộ lọc">✕ Xoá lọc</button>
      </div>
      {/* Row 2: Market Group Tabs */}
      {activeGroups.length > 0 && (
        <div class="flex flex-wrap gap-2 items-start" id="lkh-market-groups">
          <button data-group="" class="lkh-group-tab active" data-children="">Tất cả</button>
          {activeGroups.map((g) => (
            <div class="lkh-group-wrap">
              <button
                class="lkh-group-tab uppercase-tab"
                data-group={g.label}
                data-children={JSON.stringify(g.children)}
              >
                {g.label}
                {g.children.length > 1 && <span class="lkh-arrow">▼</span>}
              </button>
              {g.children.length > 1 && (
                <div class="lkh-dropdown">
                  <button class="lkh-dropdown-item active-sub" data-sub="">
                    Tất cả {g.label}
                  </button>
                  {g.children.map((child: string) => (
                    <button class="lkh-dropdown-item" data-sub={child}>
                      {child}
                    </button>
                  ))}
                </div>
              )}
            </div>
          ))}
        </div>
      )}
      <div id="lkh-result-count" class="text-xs text-slate-400"></div>
    </div>
  )}

  {error ? (
    <div class="p-4 bg-red-50 text-red-600 rounded-xl border border-red-200">
      <p class="m-0 text-sm font-medium">{error}</p>
      <p class="m-0 text-xs mt-1 text-red-500">Quý khách vui lòng liên hệ hotline để nhận lịch trình mới nhất.</p>
    </div>
  ) : departures.length === 0 ? (
    <div class="p-8 bg-slate-50 text-slate-600 rounded-3xl border border-border text-center">
      <div class="w-16 h-16 bg-white rounded-full flex items-center justify-center mx-auto mb-4 shadow-sm border border-slate-100 text-slate-400">
        <svg width="32" height="32" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
      </div>
      <p class="m-0 text-slate-700 font-medium">Lịch khởi hành đang được cập nhật</p>
      <p class="m-0 mt-2 text-sm text-slate-500 max-w-md mx-auto">Vui lòng liên hệ trực tiếp với chuyên viên tư vấn để nhận thông tin chi tiết về các tour sắp tới.</p>
      <a href="/lien-he/" class="inline-block mt-6 px-6 py-2.5 bg-brand-600 text-white font-bold rounded-full hover:bg-brand-700 transition-colors no-underline text-sm shadow-sm hover:shadow-md">Nhận tư vấn ngay</a>
    </div>
  ) : (
    <div class="departures-container">
      {/* Desktop Table */}
      <div class={`hidden md:block overflow-x-auto ${!product_code ? 'rounded-2xl border border-border shadow-sm' : ''}`}>
        <table class="w-full text-left border-collapse m-0">
          <thead>
            <tr class="bg-slate-50">
              <th class="p-4 font-bold text-slate-700 border-b border-border text-sm">Điểm đến</th>
              <th class="p-4 font-bold text-slate-700 border-b border-border text-sm">Hành trình bay</th>
              <th class="p-4 font-bold text-slate-700 border-b border-border text-sm">Khởi hành</th>
              <th class="p-4 font-bold text-slate-700 border-b border-border text-sm">Giá / Khách</th>
              <th class="p-4 font-bold text-slate-700 border-b border-border text-sm text-center">Tình trạng</th>
              {!product_code && <th class="p-4 font-bold text-slate-700 border-b border-border text-sm text-center">Lịch trình</th>}
            </tr>
          </thead>
          <tbody class="bg-white">
            {departures.map((dep: any) => {
              const seatCount = dep.seatsRemaining ?? null;
              const isFull = seatCount !== null && seatCount === 0;
              const isNearFull = !isFull && seatCount !== null && seatCount > 0 && 4 > seatCount;

              let statusText = dep.status || 'Mở bán';
              let statusClass = 'text-green-700 bg-green-50 border-green-200';
              if (isFull) {
                statusText = 'Hết chỗ';
                statusClass = 'text-red-700 bg-red-50 border-red-200';
              } else if (isNearFull) {
                statusText = `Còn ${seatCount} chỗ`;
                statusClass = 'text-orange-700 bg-orange-50 border-orange-200';
              }

              const hasAirline = dep.airline && (dep.airline.departure || dep.airline.return);

              return (
                <tr class="lkh-row border-b border-border hover:bg-slate-50/80 transition-colors last:border-b-0" data-title={dep.title} data-code={dep.code} data-dest={dep.destination || ''} data-date={dep.departureDate || ''}>
                  <td class="p-4">
                    <div class="font-bold text-slate-800 text-sm leading-snug">{dep.title}</div>
                    <span class="font-mono text-[10px] text-slate-500 mt-1 inline-block">{dep.code}</span>
                  </td>
                  <td class="p-4 text-xs text-slate-600 space-y-1.5">
                    {hasAirline ? (
                      <div class="space-y-1.5">
                        {dep.airline.departure && (
                          <div class="flex items-center gap-1.5">
                            <span class="text-brand-500 shrink-0">✈</span>
                            <span class="font-semibold text-slate-700">{getAirlineName(dep.airline, 'departure')}</span>
                          </div>
                        )}
                        {dep.airline.return && getAirlineName(dep.airline, 'return') !== getAirlineName(dep.airline, 'departure') && (
                          <div class="flex items-center gap-1.5">
                            <span class="text-emerald-500 shrink-0">✈</span>
                            <span class="font-semibold text-slate-700">{getAirlineName(dep.airline, 'return')}</span>
                          </div>
                        )}
                        {dep.pickup && <div class="text-[11px] text-slate-500 mt-0.5">{dep.pickup}</div>}
                      </div>
                    ) : (
                      <span class="text-slate-500 italic">Đang cập nhật</span>
                    )}
                  </td>
                  <td class="p-4">
                    <div class="font-bold text-slate-800">{formatDate(dep.departureDate)}</div>
                    {dep.returnDate && <div class="text-xs text-slate-500 mt-0.5">Về: {formatDate(dep.returnDate)}</div>}
                  </td>
                  <td class="p-4 font-bold text-brand-700 whitespace-nowrap">{formatPrice(dep.price)}</td>
                  <td class="p-4 text-center">
                    <span class={`inline-block px-3 py-1 rounded-full text-xs font-bold border ${statusClass}`}>
                      {statusText}
                    </span>
                  </td>
                  {!product_code && (
                    <td class="p-4 text-center">
                      {dep.websiteUrl ? (
                        <a href={dep.websiteUrl} class="inline-flex items-center gap-1 px-3 py-1.5 text-xs font-bold text-brand-700 bg-brand-50 border border-brand-200 rounded-lg hover:bg-brand-100 hover:text-brand-800 transition-colors no-underline whitespace-nowrap">
                          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path></svg>
                          Xem
                        </a>
                      ) : (
                        <span class="text-slate-300 text-xs">—</span>
                      )}
                    </td>
                  )}
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>

      {/* Mobile Cards */}
      <div class="md:hidden space-y-4">
        {departures.map((dep: any) => {
          const seatCount = dep.seatsRemaining ?? null;
          const isFull = seatCount !== null && seatCount === 0;
          const isNearFull = !isFull && seatCount !== null && seatCount > 0 && 4 > seatCount;

          let statusText = dep.status || 'Mở bán';
          let statusClass = 'text-green-700 bg-green-50 border-green-200';
          if (isFull) {
            statusText = 'Hết chỗ';
            statusClass = 'text-red-700 bg-red-50 border-red-200';
          } else if (isNearFull) {
            statusText = `Còn ${seatCount} chỗ`;
            statusClass = 'text-orange-700 bg-orange-50 border-orange-200';
          }

          const hasAirline = dep.airline && (dep.airline.departure || dep.airline.return);

          return (
            <div class={`lkh-card bg-white ${!product_code ? 'p-5 rounded-2xl border border-border shadow-[0_2px_10px_rgba(0,0,0,0.02)]' : 'py-4 border-b border-border last:border-0'}`} data-title={dep.title} data-code={dep.code} data-dest={dep.destination || ''} data-date={dep.departureDate || ''}>
              <div class="flex justify-between items-start mb-3">
                <div class="flex-1 pr-3">
                  <div class="font-bold text-slate-800 text-sm leading-snug mb-1">{dep.title}</div>
                  <span class="font-mono text-[10px] text-slate-500">{dep.code}</span>
                </div>
                <span class={`px-2.5 py-1 rounded-md text-[11px] font-bold border whitespace-nowrap ${statusClass}`}>
                  {statusText}
                </span>
              </div>

              {/* Airline Info — Mobile */}
              {hasAirline && (
                <div class="bg-slate-50 rounded-lg p-3 mb-3 space-y-1.5 text-xs">
                  {dep.airline.departure && (
                    <div class="flex items-center gap-1.5">
                      <span class="text-brand-500 shrink-0">✈</span>
                      <span class="font-semibold text-slate-700">{getAirlineName(dep.airline, 'departure')}</span>
                    </div>
                  )}
                  {dep.airline.return && getAirlineName(dep.airline, 'return') !== getAirlineName(dep.airline, 'departure') && (
                    <div class="flex items-center gap-1.5">
                      <span class="text-emerald-500 shrink-0">✈</span>
                      <span class="font-semibold text-slate-700">{getAirlineName(dep.airline, 'return')}</span>
                    </div>
                  )}
                  {dep.pickup && <div class="text-[11px] text-slate-500">{dep.pickup}</div>}
                </div>
              )}

              <div class="flex items-center gap-2 text-sm text-slate-600 mb-1">
                <span>🛫 {formatDate(dep.departureDate)}</span>
                {dep.returnDate && <span class="text-slate-500">→ {formatDate(dep.returnDate)}</span>}
              </div>

              <div class="h-px bg-slate-100 w-full my-3"></div>

              <div class="flex flex-col gap-3">
                <div class="flex justify-between items-center">
                  <span class="text-sm text-slate-500">Giá trọn gói</span>
                  <span class="font-bold text-brand-700 text-lg">{formatPrice(dep.price)}</span>
                </div>
                {dep.websiteUrl && !product_code && (
                  <a href={dep.websiteUrl} class="mt-3 flex items-center justify-center gap-1.5 w-full py-2 text-sm font-bold text-brand-700 bg-brand-50 border border-brand-200 hover:bg-brand-100 hover:text-brand-800 transition-colors no-underline rounded-lg">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path></svg>
                    Xem lịch trình
                  </a>
                )}
              </div>
            </div>
          );
        })}
      </div>
    </div>
  )}
</div>

<style>
  /* Group tabs matching CRM */
  .lkh-group-tab {
    display: inline-flex; align-items: center; gap: 6px;
    padding: 6px 12px; font-size: 13px; font-weight: 600;
    border: 1px solid #d1d5db; border-radius: 4px;
    background: #ffffff; color: #374151; cursor: pointer;
    transition: all 0.15s ease; white-space: nowrap;
  }
  .lkh-group-tab.uppercase-tab {
    text-transform: uppercase;
  }
  .lkh-group-tab:hover { background: #f9fafb; border-color: #9ca3af; }
  .lkh-group-tab.active { background: #ff4d4f; border-color: #ff4d4f; color: #fff; font-weight: 700; }
  .lkh-group-tab.active .lkh-arrow { color: #fff; }
  .lkh-arrow { font-size: 10px; color: #6b7280; transition: transform 0.2s; }
  .lkh-group-tab.active .lkh-arrow { color: #ffffff; }
  /* When open, arrow points up */
  .lkh-group-wrap.open .lkh-arrow { transform: rotate(180deg); }

  /* Dropdown matching CRM */
  .lkh-group-wrap { position: relative; display: inline-block; }
  .lkh-dropdown {
    display: none; position: absolute; top: calc(100% + 4px); left: 0;
    min-width: 180px; background: #fff; border: 1px solid #e5e7eb;
    border-radius: 6px; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1), 0 2px 4px -1px rgba(0,0,0,0.06);
    z-index: 50; padding: 4px 0; max-height: 320px; overflow-y: auto;
  }
  .lkh-group-wrap.open .lkh-dropdown { display: block; }
  .lkh-dropdown-item {
    display: block; width: 100%; text-align: left; padding: 10px 16px;
    font-size: 14px; color: #111827; background: none; border: none;
    cursor: pointer; transition: background 0.1s;
  }
  .lkh-dropdown-item:hover { background: #f3f4f6; }
  .lkh-dropdown-item.active { color: #ff4d4f; font-weight: 600; background: #fffaf9; }
  .lkh-dropdown-item.active-sub { color: #ff4d4f; font-weight: 600; background: #fffaf9; }
</style>

<script is:inline>
(function() {
  function initLKH() {
    const search = document.getElementById('lkh-search');
    const resetBtn = document.getElementById('lkh-reset');
    const resultCount = document.getElementById('lkh-result-count');
    
    // Prevent double-binding in Astro View Transitions
    if (!search || search.dataset.initialized) return;
    search.dataset.initialized = 'true';

    let allowedDests = []; // empty = show all
    let selectedMonths = []; // empty = show all

    function runFilter() {
      const q = (search.value || '').toLowerCase().trim();
      const items = document.querySelectorAll('.lkh-row, .lkh-card');
      let shown = 0;
      items.forEach(el => {
        const title = (el.dataset.title || '').toLowerCase();
        const code = (el.dataset.code || '').toLowerCase();
        const dest = (el.dataset.dest || '').toLowerCase().trim();
        const date = el.dataset.date || '';
        let ok = true;
        
        if (q && !title.includes(q) && !code.includes(q)) ok = false;
        
        if (selectedMonths.length > 0) {
          const matchMonth = selectedMonths.some(sm => date.startsWith(sm));
          if (!matchMonth) ok = false;
        }
        
        if (allowedDests.length) {
          const hasDestMatch = allowedDests.some(ad => dest.includes(ad.toLowerCase().trim()));
          if (!hasDestMatch) ok = false;
        }
        
        el.style.display = ok ? '' : 'none';
        if (ok) shown++;
      });
      if (resultCount) {
        const total = items.length;
        resultCount.textContent = (q || selectedMonths.length || allowedDests.length) ? 'Hiển thị ' + shown + '/' + total + ' tour' : '';
      }
    }

    search.addEventListener('input', runFilter);

    // Month Dropdown Logic
    const monthWrap = document.querySelector('.lkh-month-wrap');
    const monthBtn = document.getElementById('lkh-month-btn');
    const monthBtnText = document.getElementById('lkh-month-btn-text');
    const monthMenu = document.getElementById('lkh-month-menu');
    const monthCbs = document.querySelectorAll('.lkh-month-cb');

    if (monthBtn && monthMenu) {
      monthBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        monthMenu.classList.toggle('hidden');
      });

      document.addEventListener('click', (e) => {
        if (!monthMenu.classList.contains('hidden') && !monthWrap.contains(e.target)) {
          monthMenu.classList.add('hidden');
        }
      });

      monthCbs.forEach(cb => {
        cb.addEventListener('change', () => {
          selectedMonths = Array.from(monthCbs).filter(c => c.checked).map(c => c.value);
          if (selectedMonths.length === 0) {
            monthBtnText.textContent = 'Tất cả các tháng';
          } else if (selectedMonths.length === 1) {
            const [y, m] = selectedMonths[0].split('-');
            monthBtnText.textContent = `Tháng ${m}/${y}`;
          } else {
            monthBtnText.textContent = `Đã chọn ${selectedMonths.length} tháng`;
          }
          runFilter();
        });
      });
    }

    // Group tabs
    const groupTabs = document.querySelectorAll('.lkh-group-tab');
    const groupWraps = document.querySelectorAll('.lkh-group-wrap');

    function closeAllDropdowns() {
      groupWraps.forEach(w => w.classList.remove('open'));
    }

    function setActiveGroup(tab) {
      groupTabs.forEach(t => t.classList.remove('active'));
      tab.classList.add('active');
      // Reset dropdown item highlights
      document.querySelectorAll('.lkh-dropdown-item').forEach(di => di.classList.remove('active'));
    }

    groupTabs.forEach(tab => {
      tab.addEventListener('click', (e) => {
        e.stopPropagation();
        const wrap = tab.closest('.lkh-group-wrap');
        const childrenStr = tab.dataset.children || '';
        let children = [];
        try { children = JSON.parse(childrenStr); } catch(_) {}

        // If "Tất cả" button (no group)
        if (!tab.dataset.group) {
          closeAllDropdowns();
          setActiveGroup(tab);
          allowedDests = [];
          runFilter();
          return;
        }

        // If group has only 1 child, act as direct filter
        if (children.length <= 1) {
          closeAllDropdowns();
          setActiveGroup(tab);
          allowedDests = children;
          runFilter();
          return;
        }

        // Toggle dropdown
        const isOpen = wrap && wrap.classList.contains('open');
        closeAllDropdowns();
        if (!isOpen && wrap) {
          wrap.classList.add('open');
        }
        // Select entire group
        setActiveGroup(tab);
        allowedDests = children;
        runFilter();
      });
    });

    // Sub-destination items
    document.querySelectorAll('.lkh-dropdown-item').forEach(item => {
      item.addEventListener('click', (e) => {
        e.stopPropagation();
        const wrap = item.closest('.lkh-group-wrap');
        const groupTab = wrap.querySelector('.lkh-group-tab');
        const childrenStr = groupTab.dataset.children || '';
        let children = [];
        try { children = JSON.parse(childrenStr); } catch(_) {}

        // Highlight
        setActiveGroup(groupTab);
        wrap.querySelectorAll('.lkh-dropdown-item').forEach(di => {
          di.classList.remove('active');
          di.classList.remove('active-sub');
        });
        item.classList.add('active');

        const sub = item.dataset.sub || '';
        if (!sub) {
          // "Tất cả [Group]" 
          allowedDests = children;
        } else {
          allowedDests = [sub];
        }
        closeAllDropdowns();
        runFilter();
      });
    });

    // Close dropdowns when clicking outside
    document.addEventListener('click', () => closeAllDropdowns());

    // Reset button
    if (resetBtn) {
      resetBtn.addEventListener('click', () => {
        search.value = '';
        allowedDests = [];
        selectedMonths = [];
        if (monthCbs) monthCbs.forEach(cb => cb.checked = false);
        if (monthBtnText) monthBtnText.textContent = 'Tất cả các tháng';
        
        closeAllDropdowns();
        groupTabs.forEach(t => t.classList.remove('active'));
        document.querySelectorAll('.lkh-dropdown-item').forEach(di => {
          di.classList.remove('active');
          di.classList.remove('active-sub');
          // Re-add active-sub to the "Tất cả" dropdown item
          if (!di.dataset.sub) di.classList.add('active-sub');
        });
        const allBtn = document.querySelector('.lkh-group-tab[data-group=""]');
        if (allBtn) allBtn.classList.add('active');
        runFilter();
      });
    }
    
    // Auto-run filter initially just in case values are pre-filled by browser
    setTimeout(runFilter, 100);
  }

  // Chạy initLKH khi trang load lần đầu
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initLKH);
  } else {
    initLKH();
  }
  // Chạy lại initLKH nếu dùng Astro View Transitions
  document.addEventListener('astro:page-load', initLKH);
})();
</script>
