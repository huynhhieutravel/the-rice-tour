<section class="relative py-32 lg:py-40 flex items-center justify-center overflow-hidden font-sans">
  <!-- Background Image -->
  <div class="absolute inset-0 w-full h-full">
    <img src="https://media.fittour.vn/uploads/dinh-nui-tuyet-karakoram-binh-minh.webp" alt="Pakistan Karakoram" class="w-full h-full object-cover" loading="lazy">
    <div class="absolute inset-0 bg-gradient-to-b from-[#050505]/70 via-[#050505]/50 to-[#050505]/70"></div>
    <div class="absolute inset-0 bg-black/30"></div>
  </div>
  
  <!-- Content -->
  <div class="relative z-10 w-full max-w-3xl mx-auto px-6 text-center">
    <h2 class="text-4xl md:text-5xl lg:text-6xl font-serif text-white leading-tight mb-8 uppercase tracking-wide italic">
      Sẵn Sàng Khám Phá<br/>Pakistan?
    </h2>
    <p class="text-gray-300 font-sans font-light text-base md:text-lg leading-relaxed mb-12 max-w-lg mx-auto">
      Hãy để FIT Tour kiến tạo nên một hành trình hoàn mỹ đến vùng đất của những đỉnh núi tuyết và cung đường huyền thoại Karakoram.
    </p>
    <a href="/lien-he" class="inline-flex items-center gap-3 px-8 py-4 bg-[#4caf50] text-white font-bold text-xs tracking-[0.2em] uppercase hover:bg-[#388e3c] transition-colors">
      LIÊN HỆ TƯ VẤN
      <span class="text-base leading-none">→</span>
    </a>
  </div>
</section>
