---
import type { ASTNode } from '../../utils/shortcodes/parser';
import TestimonialBlock from './TestimonialBlock.astro';
import SnippetBlock from './SnippetBlock.astro';
import CtaBlock from '../ui/CtaBlock.astro';
import YoutubeEmbed from './YoutubeEmbed.astro';
import RelatedBlog from '../RelatedBlog.astro';
import AuthorCard from './AuthorCard.astro';
import DataPost from './data/DataPost.astro';
import DataTour from './data/DataTour.astro';
import DataCountry from './data/DataCountry.astro';

interface Props {
  node: ASTNode;
  dataMap: Record<string, any>;
}

const { node, dataMap } = Astro.props;

// Component Registry Mapping
const SHORTCODE_MAP: Record<string, any> = {
  'testimonial': TestimonialBlock,
  'snippet': SnippetBlock,
  'cta': CtaBlock,
  'youtube': YoutubeEmbed,
  'blog-related': RelatedBlog,
  'author-card': AuthorCard,
  'data_post': DataPost,
  'data_tour': DataTour,
  'data_country': DataCountry,
};

const Component = node.type === 'shortcode' ? SHORTCODE_MAP[node.name] : null;

// Enforce strict component props + data
const componentProps = node.type === 'shortcode' ? { 
  ...node.props, 
  dataMap 
} : {};
---

{node.type === 'html' ? (
  <Fragment set:html={node.content} />
) : (
  Component ? <Component {...componentProps} /> : null
)}
