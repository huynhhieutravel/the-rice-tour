---
import { Shield, MapPin, Quote } from 'lucide-react';

const PORTRAIT_COVERS = [
  {
    title: "MÙA THU THUNG LŨNG HUNZA",
    vibe: "Cổ tích giữa đời thực — 2,500m",
    imageUrl: "https://media.fittour.vn/uploads/song-hunza-xanh-ngoc-pakistan.webp",
    quote: "Lạc bước giữa thung lũng Hunza ngày thu, khi rặng cây chuyển sắc vàng rực rỡ dưới nền núi tuyết vĩnh cửu, tôi ngỡ mình đang sống trong một giấc mơ cổ tích huyền thoại.",
    badge: "NATURE LOVER",
    coordinates: "36.3167° N, 74.6500° E",
    link: "/blog/cam-nang-du-lich-pakistan",
    shortTitle: "Hunza",
    author: "Traveler • 1990",
    authorDesc: "Người kể chuyện"
  },
  {
    title: "ĐƯỜNG CAO TỐC KỲ VĨ NHẤT",
    vibe: "Kỹ thuật điêu luyện — Khunjerab 4,693m",
    imageUrl: "https://media.fittour.vn/uploads/2022/12/doan-duong-cao-toc-Karakoram.webp",
    quote: "Lái xe trên con đường Karakoram huyền thoại, xuyên qua những hẻm núi sâu thẳm và sông băng kỳ vĩ, là trải nghiệm tự do và choáng ngợp nhất cuộc đời.",
    badge: "ROADTRIPPER",
    coordinates: "36.8488° N, 75.4338° E",
    link: "/blog/cam-nang-du-lich-pakistan",
    shortTitle: "Karakoram",
    author: "Biker • 1985",
    authorDesc: "Kẻ mộng mơ"
  },
  {
    title: "BÌNH MINH NANGA PARBAT",
    vibe: "Khu rừng thần tiên — 3,300m",
    imageUrl: "https://media.fittour.vn/uploads/dinh-nui-tuyet-karakoram-binh-minh.webp",
    quote: "Tỉnh giấc giữa rừng thông Fairy Meadows, ngắm nhìn ngọn núi Sát Thủ Nanga Parbat bừng sáng trong bình minh, tâm hồn tôi chưa bao giờ bình yên đến thế.",
    badge: "MOUNTAINEER",
    coordinates: "35.2344° N, 74.5828° E",
    link: "/blog/cam-nang-du-lich-pakistan",
    shortTitle: "Fairy Meadows",
    author: "Hiker • 1995",
    authorDesc: "Người yêu núi"
  }
];
---

<section id="vogue-portrait-centerpiece-pak" class="relative bg-stone-950 py-28 px-4 md:px-8 overflow-hidden border-y border-stone-900 font-sans">
  
  {/* Animated Background Serif Wordmark */}
  <div class="absolute inset-0 flex items-center justify-center select-none pointer-events-none opacity-5 z-0">
    <span class="font-serif text-[18vw] font-bold text-white tracking-tighter uppercase whitespace-nowrap leading-none">
      PAKISTAN
    </span>
  </div>

  {/* Ambient colored background lights */}
  <div class="absolute top-1/4 left-1/3 w-80 h-80 rounded-full bg-[#1b5e20]/20 blur-3xl pointer-events-none"></div>
  <div class="absolute bottom-1/4 right-1/4 w-80 h-80 rounded-full bg-amber-500/10 blur-3xl pointer-events-none"></div>

  <div class="max-w-6xl mx-auto relative z-10" id="pak-portrait-wrapper">
    
    {/* Section Editorial Header */}
    <div class="grid grid-cols-1 md:grid-cols-12 gap-6 items-end mb-16 pb-8 border-b border-stone-800">
      <div class="md:col-span-8">
        <span class="font-mono text-xs uppercase tracking-widest text-[#4caf50] font-bold block mb-3 flex items-center gap-2">
          THE EDITORIAL SPREAD / NHẬT KÝ HÀNH TRÌNH
        </span>
        <h2 class="font-serif text-3xl md:text-5xl font-bold text-white leading-none tracking-tight">
          "Khám Phá Vẻ Đẹp Ngoạn Mục Của Dãy Karakoram"
        </h2>
      </div>
      
      {/* Interactive Edition Selectors (01 / 02 / 03) */}
      <div class="md:col-span-4 flex md:justify-end gap-3">
        {PORTRAIT_COVERS.map((cover, idx) => (
          <button
            data-tab-idx={idx}
            class={`pak-portrait-tab-btn flex flex-col items-start px-4 py-2.5 rounded-lg border text-left transition-all duration-300 min-w-[90px] cursor-pointer ${
              idx === 0
                ? 'border-[#4caf50] bg-[#4caf50]/10 text-white shadow-lg'
                : 'border-stone-800 bg-stone-900/40 text-stone-500 hover:border-stone-700 hover:text-stone-300'
            }`}
          >
            <span class="font-mono text-xs font-bold block">0{idx + 1}</span>
            <span class="text-[10px] uppercase font-sans tracking-wider font-semibold">
              {cover.shortTitle}
            </span>
          </button>
        ))}
      </div>
    </div>

    {/* Core Central Layout */}
    <div class="grid grid-cols-1 items-center relative">
      
      {/* Container for all covers (they will stack on top of each other via CSS Grid) */}
      {PORTRAIT_COVERS.map((cover, idx) => (
        <div data-content-idx={idx} class={`pak-portrait-content-item col-start-1 row-start-1 grid grid-cols-1 lg:grid-cols-12 gap-12 items-center transition-all duration-700 ${idx === 0 ? 'opacity-100 z-10 pointer-events-auto scale-100' : 'opacity-0 z-0 pointer-events-none scale-95'}`}>
          
          {/* Left: Magazine Specs & Metadata */}
          <div class="lg:col-span-3 space-y-8 order-2 lg:order-1">
            <div class="space-y-1">
              <span class="font-mono text-[10px] text-stone-500 uppercase tracking-widest block">CHÂN DUNG KHẮC HỌA</span>
              <p class="font-serif text-2xl font-semibold text-white leading-tight">
                {cover.shortTitle}
              </p>
              <div class="h-0.5 w-12 bg-[#4caf50] mt-2"></div>
            </div>

            <div class="space-y-3 font-mono text-xs text-stone-400">
              <div class="flex justify-between py-1.5 border-b border-stone-900">
                <span>Bộ sưu tập</span>
                <span class="text-white font-bold">Pakistan 2026</span>
              </div>
              <div class="flex justify-between py-1.5 border-b border-stone-900">
                <span>Hình thái</span>
                <span class="text-white font-semibold">Tự truyện du ký</span>
              </div>
              <div class="flex justify-between py-1.5 border-b border-stone-900">
                <span>Độ cao trung bình</span>
                <span class="text-white font-semibold">{'>'} 2,500m</span>
              </div>
              <div class="flex justify-between py-1.5 border-b border-stone-900">
                <span>Chuyên mục</span>
                <span class="text-white font-semibold">Nhật ký FIT Tour</span>
              </div>
            </div>

            <div class="bg-stone-900/60 border border-stone-800 p-4 rounded-xl font-mono text-xs text-stone-300 space-y-2">
              <div class="flex items-center gap-2 text-[#4caf50] font-bold text-[10px]">
                <span class="w-1.5 h-1.5 bg-[#4caf50] rounded-full animate-pulse"></span>
                BẢN ĐỒ TỌA ĐỘ
              </div>
              <div>
                <span class="text-stone-500 text-[10px] uppercase block">Pakistan GPS Point</span>
                <span class="text-white font-bold">{cover.coordinates}</span>
              </div>
              <div>
                <span class="text-stone-500 text-[10px] uppercase block">Định danh</span>
                <span class="text-stone-300 italic">{cover.vibe}</span>
              </div>
            </div>
          </div>

          {/* Middle: Golden Framed Magazine Portrait Cover */}
          <div class="lg:col-span-5 flex justify-center order-1 lg:order-2">
            <div
              class="relative aspect-3/4 w-full max-w-[370px] bg-stone-900 border-4 border-[#4caf50]/20 rounded-2xl shadow-2xl p-4 overflow-hidden group"
              style="box-shadow: 0 25px 50px -12px rgba(76, 175, 80, 0.15);"
            >
              <div class="absolute inset-2 border border-[#4caf50]/30 rounded-xl z-20 pointer-events-none"></div>

              <img
                src={cover.imageUrl}
                alt={cover.title}
                referrerpolicy="no-referrer"
                class="absolute inset-0 w-full h-full object-cover grayscale-[20%] group-hover:grayscale-0 transition-all duration-700 brightness-[85%] scale-102 group-hover:scale-105"
              />

              <div class="absolute inset-0 bg-gradient-to-t from-stone-950 via-stone-950/20 to-transparent z-10"></div>
              
              <div class="absolute top-6 left-6 z-20 text-white font-serif pointer-events-none">
                <span class="font-mono text-[8px] uppercase tracking-widest text-[#81c784] block font-semibold">
                  FIT TOUR EXCLUSIVE
                </span>
                <h3 class="text-xl font-bold tracking-tight mt-0.5 drop-shadow">
                  DIARY
                </h3>
              </div>

              <div class="absolute top-6 right-6 z-20 text-right font-mono text-[8px] text-white/70 pointer-events-none">
                <span>ISSUE 0{idx + 1}</span>
                <span class="block mt-0.5 text-[#81c784] font-bold bg-[#81c784]/10 px-1 py-0.5 rounded border border-[#81c784]/20 uppercase">
                  {cover.badge}
                </span>
              </div>

              <div class="absolute bottom-6 inset-x-6 z-20 text-left pointer-events-none">
                <div class="flex items-center gap-1 text-[8px] text-[#81c784] font-mono tracking-widest block mb-1">
                  <span>PORTRAIT SPREAD</span>
                  <span>•</span>
                  <span>STORY</span>
                </div>
                
                <h4 class="font-serif text-2xl font-bold leading-tight uppercase tracking-tight text-white drop-shadow-md">
                  {cover.title}
                </h4>
                
                <p class="font-sans text-[10px] text-stone-300 line-clamp-2 mt-1.5 italic font-medium leading-relaxed opacity-95">
                  "{cover.quote}"
                </p>
              </div>

              <a href={cover.link} aria-label={`Đọc nhật ký hành trình ${cover.shortTitle}`} class="absolute inset-0 z-30 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity bg-black/40 backdrop-blur-[2px]">
                  <span class="px-6 py-3 border border-[#4caf50] text-[#81c784] font-mono text-xs uppercase tracking-widest bg-stone-900/80 hover:bg-[#4caf50] hover:text-stone-900 transition-colors rounded-full font-bold">
                    Đọc Nhật Ký Hành Trình
                  </span>
              </a>

              <div class="absolute inset-0 pointer-events-none opacity-5 bg-[radial-gradient(ellipse_at_center,_var(--tw-gradient-stops))] from-white via-stone-900 to-black z-15"></div>
            </div>
          </div>

          {/* Right: Poetic Big Quote & Signature */}
          <div class="lg:col-span-4 space-y-6 order-3">
            <div class="bg-stone-900/40 border border-stone-850 p-6 md:p-8 rounded-2xl relative">
              
              <h4 class="font-mono text-[9px] uppercase tracking-widest text-stone-500 font-bold block mb-4">
                Trích Đoạn Hành Trình
              </h4>

              <div class="space-y-4">
                <p class="font-serif text-base sm:text-lg text-stone-200 leading-relaxed italic">
                  "{cover.quote}"
                </p>
                
                <div class="pt-4 border-t border-stone-800 flex items-center justify-between text-xs font-mono">
                  <span class="text-stone-400">Đọc toàn bộ bài viết</span>
                  <a href={cover.link} aria-label={`Đọc bài viết ${cover.shortTitle} tại đây`} class="text-[#4caf50] hover:text-[#81c784] underline font-bold block">Tại đây</a>
                </div>
              </div>
            </div>

            <div class="p-4 bg-[#4caf50]/5 rounded-xl border border-[#4caf50]/10 flex items-center justify-between">
              <div>
                <span class="font-mono text-[9px] text-stone-500 block">SIGNATURE OF MEMORY</span>
                <span class="font-serif text-lg font-bold italic text-[#81c784] font-medium tracking-wide">
                  {cover.author}
                </span>
              </div>
              <div class="text-[10px] font-mono text-stone-400 border border-stone-800/80 rounded px-2.5 py-1 text-center bg-stone-900">
                {cover.authorDesc}
              </div>
            </div>

          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const wrapper = document.getElementById('pak-portrait-wrapper');
    if (!wrapper) return;

    const btns = wrapper.querySelectorAll('.pak-portrait-tab-btn');
    const contents = wrapper.querySelectorAll('.pak-portrait-content-item');

    btns.forEach(btn => {
      btn.addEventListener('click', () => {
        const idx = btn.getAttribute('data-tab-idx');

        // Update buttons
        btns.forEach(b => {
          if (b.getAttribute('data-tab-idx') === idx) {
            b.classList.add('border-[#4caf50]', 'bg-[#4caf50]/10', 'text-white', 'shadow-lg');
            b.classList.remove('border-stone-800', 'bg-stone-900/40', 'text-stone-500');
          } else {
            b.classList.remove('border-[#4caf50]', 'bg-[#4caf50]/10', 'text-white', 'shadow-lg');
            b.classList.add('border-stone-800', 'bg-stone-900/40', 'text-stone-500');
          }
        });

        // Update contents
        contents.forEach(content => {
          if (content.getAttribute('data-content-idx') === idx) {
            content.classList.remove('opacity-0', 'z-0', 'pointer-events-none', 'scale-95');
            content.classList.add('opacity-100', 'z-10', 'pointer-events-auto', 'scale-100');
          } else {
            content.classList.remove('opacity-100', 'z-10', 'pointer-events-auto', 'scale-100');
            content.classList.add('opacity-0', 'z-0', 'pointer-events-none', 'scale-95');
          }
        });
      });
    });
  });
</script>
