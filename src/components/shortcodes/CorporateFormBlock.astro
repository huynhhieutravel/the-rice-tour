<div id="form-dang-ky" class="my-16 scroll-mt-24">
  <div class="container mx-auto px-4">
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-5xl font-serif text-gray-900 mb-4">Nhận Báo Giá & Ý Tưởng Demo</h2>
      <p class="text-lg text-gray-600 max-w-2xl mx-auto">Chỉ cần 30 giây để lại thông tin, đội ngũ của chúng tôi sẽ phác thảo ý tưởng chương trình dành riêng cho văn hoá công ty bạn.</p>
    </div>
    <CorporateRegistrationForm client:load />
  </div>
</div>
