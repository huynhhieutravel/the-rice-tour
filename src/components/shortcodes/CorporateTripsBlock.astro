---
interface Props {
  location?: string;
  dataMap?: {
    corporateTrips?: Record<string, any[]>;
  };
}

const { location = '', dataMap } = Astro.props;
const trips = (dataMap?.corporateTrips && location) ? (dataMap.corporateTrips[location] || []).slice(0, 3) : [];
---

{trips.length > 0 && (
  <section id="real-trips" class="py-20 bg-white">
    <div class="max-w-[1200px] mx-auto px-4">
      <div class="text-center mb-16">
        <p class="text-sm font-bold text-gray-500 uppercase tracking-widest mb-3">Nhật ký thực tế</p>
        <h2 class="font-bold text-gray-900 mb-4" style="font-size: clamp(1.75rem, 3.5vw, 2.25rem); line-height: 1.3;">Hành Trình Thực Tế tại {location} cùng FIT Tour</h2>
        <div class="w-24 h-1 bg-[#c2410c] mx-auto"></div>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mobile-scroll-row">
        {trips.map((trip: any) => (
          <div class="bg-white rounded-2xl overflow-hidden shadow-md hover:shadow-xl border border-gray-100 transition-all duration-300 flex flex-col group trip-card">
            <div class="aspect-video overflow-hidden bg-gray-100">
              <img 
                src={trip.featuredImage} 
                alt={trip.title} 
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" 
                loading="lazy" 
                decoding="async"
              />
            </div>
            <div class="p-6 flex-1 flex flex-col justify-between">
              <div class="mb-6">
                <h3 class="text-xl font-bold text-gray-900 mb-3 group-hover:text-[#c2410c] transition-colors line-clamp-2 leading-snug">
                  {trip.title.split('|')[0].trim()}
                </h3>
                <p class="text-gray-600 text-sm line-clamp-3 leading-relaxed">
                  {trip.excerpt || `${trip.title.split('|')[0].trim()} - Nhật ký hành trình du lịch doanh nghiệp thực tế được tổ chức bởi chuyên gia du lịch FIT Tour.`}
                </p>
              </div>
              <a 
                href={`/${trip.slug}`} 
                class="inline-flex items-center justify-center w-full px-6 py-3 border border-gray-900 rounded-full text-sm font-bold text-gray-900 hover:bg-gray-900 hover:text-white transition-all duration-300"
              >
                Xem Chi Tiết
              </a>
            </div>
          </div>
        ))}
      </div>
      <div class="text-center mt-12">
        <a 
          href="/hanh-trinh-doanh-nghiep/" 
          class="inline-flex items-center justify-center px-8 py-3.5 bg-[#c2410c] hover:bg-[#9a3412] text-white font-bold rounded-full shadow-md hover:shadow-lg transition-all duration-300 !no-underline"
        >
          Xem thêm các hành trình khác
        </a>
      </div>
    </div>
  </section>
)}

<style>
  @media (max-width: 768px) {
    .mobile-scroll-row {
      display: flex !important;
      overflow-x: auto !important;
      scroll-snap-type: x mandatory !important;
      scrollbar-width: none !important; /* Firefox */
      -ms-overflow-style: none !important; /* IE/Edge */
      padding-bottom: 20px !important;
      margin-left: -1rem !important;
      margin-right: -1rem !important;
      padding-left: 1rem !important;
      padding-right: 1rem !important;
    }
    .mobile-scroll-row::-webkit-scrollbar {
      display: none !important;
    }
    .trip-card {
      flex: 0 0 auto !important;
      width: 75vw !important;
      max-width: 320px !important;
      scroll-snap-align: center !important;
    }
  }
</style>
