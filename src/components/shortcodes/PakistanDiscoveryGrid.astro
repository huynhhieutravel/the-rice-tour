---
---
<section class="relative py-32 lg:py-48 flex items-center overflow-hidden border-t border-b border-white/5 font-sans"> 
  <!-- Background Image --> 
  <div class="absolute inset-0 w-full h-full"> 
    <img alt="Pakistan Landscape" class="w-full h-full object-cover" loading="lazy" src="https://media.fittour.vn/uploads/song-hunza-xanh-ngoc-pakistan.webp"/> 
    <div class="absolute inset-0 bg-gradient-to-r from-[#050505] via-[#050505]/70 to-transparent"></div> 
    <div class="absolute inset-0 bg-black/20"></div> 
  </div> 
  
  <!-- Content --> 
  <div class="relative z-10 w-full max-w-[1400px] mx-auto px-6 lg:px-12"> 
    <div class="max-w-xl"> 
      <h2 class="text-4xl md:text-5xl lg:text-[4.5rem] font-serif text-white leading-[1.15] mb-8 uppercase tracking-wide">
        CÓ NHỮNG NƠI<br/>
        VẺ ĐẸP VƯỢT QUÁ <span class="text-[#4caf50]">SỰ TƯỞNG TƯỢNG</span><br/>
        CỦA CHÚNG TA.
      </h2> 
      <p class="text-gray-300 font-sans font-light text-base md:text-lg leading-relaxed mb-12 max-w-md">
        Giữa những đỉnh núi tuyết Karakoram kỳ vĩ, vạn vật hiện lên mạnh mẽ nhưng cũng thật bình yên. Đó là nơi thiên nhiên khắc tạc nên những tuyệt tác vĩ đại nhất.
      </p> 
      <a class="inline-flex items-center gap-4 text-[10px] md:text-xs font-bold tracking-[0.2em] uppercase text-[#4caf50] hover:text-white transition-colors group" href="#destinations">
        DISCOVER PAKISTAN
        <span class="w-12 h-[1px] bg-[#4caf50] group-hover:bg-white transition-colors relative"> 
          <span class="absolute right-0 top-1/2 -translate-y-1/2 w-2 h-2 border-t border-r border-current rotate-45"></span> 
        </span> 
      </a> 
    </div> 
  </div> 
</section> 

<section class="py-24 lg:py-32 bg-[#0a0a0a] font-sans" id="destinations"> 
  <div class="max-w-[1400px] mx-auto px-6 lg:px-12 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6"> 
    
    <div class="group/hl flex flex-col border border-white/10 bg-[#050505] hover:border-[#4caf50]/50 transition-colors"> 
      <div class="relative w-full aspect-video overflow-hidden bg-[#111]"> 
        <img alt="THUNG LŨNG HUNZA" class="w-full h-full object-cover opacity-80 group-hover/hl:opacity-100 group-hover/hl:scale-105 transition-all duration-700 ease-out" loading="lazy" src="https://media.fittour.vn/uploads/song-hunza-xanh-ngoc-pakistan.webp"/> 
      </div> 
      <div class="p-6 flex flex-col flex-grow"> 
        <h3 class="text-[#4caf50] text-[15px] font-serif font-normal uppercase tracking-[0.15em] mb-4">THUNG LŨNG HUNZA</h3> 
        <p class="text-gray-400 font-light text-sm leading-relaxed mb-8 flex-grow">Sắc thu rực rỡ bên dòng sông xanh ngọc, một bức tranh thần tiên giữa đời thực.</p> 
      </div> 
    </div>

    <div class="group/hl flex flex-col border border-white/10 bg-[#050505] hover:border-[#4caf50]/50 transition-colors"> 
      <div class="relative w-full aspect-video overflow-hidden bg-[#111]"> 
        <img alt="CAO TỐC KARAKORAM" class="w-full h-full object-cover opacity-80 group-hover/hl:opacity-100 group-hover/hl:scale-105 transition-all duration-700 ease-out" loading="lazy" src="https://media.fittour.vn/uploads/2022/12/doan-duong-cao-toc-Karakoram.webp"/> 
      </div> 
      <div class="p-6 flex flex-col flex-grow"> 
        <h3 class="text-[#4caf50] text-[15px] font-serif font-normal uppercase tracking-[0.15em] mb-4">CAO TỐC KARAKORAM</h3> 
        <p class="text-gray-400 font-light text-sm leading-relaxed mb-8 flex-grow">Chinh phục kỳ quan kỹ thuật vĩ đại, con đường huyết mạch nối liền những đỉnh núi tuyết.</p> 
      </div> 
    </div>

    <div class="group/hl flex flex-col border border-white/10 bg-[#050505] hover:border-[#4caf50]/50 transition-colors"> 
      <div class="relative w-full aspect-video overflow-hidden bg-[#111]"> 
        <img alt="BÌNH MINH TRÊN NÚI TUYẾT" class="w-full h-full object-cover opacity-80 group-hover/hl:opacity-100 group-hover/hl:scale-105 transition-all duration-700 ease-out" loading="lazy" src="https://media.fittour.vn/uploads/dinh-nui-tuyet-karakoram-binh-minh.webp"/> 
      </div> 
      <div class="p-6 flex flex-col flex-grow"> 
        <h3 class="text-[#4caf50] text-[15px] font-serif font-normal uppercase tracking-[0.15em] mb-4">BÌNH MINH NÚI TUYẾT</h3> 
        <p class="text-gray-400 font-light text-sm leading-relaxed mb-8 flex-grow">Tỉnh giấc trước vẻ đẹp kỳ vĩ của Nanga Parbat và dãy Karakoram trong ánh ban mai.</p> 
      </div> 
    </div>

    <div class="group/hl flex flex-col border border-white/10 bg-[#050505] hover:border-[#4caf50]/50 transition-colors"> 
      <div class="relative w-full aspect-video overflow-hidden bg-[#111]"> 
        <img alt="NHỮNG NỤ CƯỜI HUNZA" class="w-full h-full object-cover opacity-80 group-hover/hl:opacity-100 group-hover/hl:scale-105 transition-all duration-700 ease-out" loading="lazy" src="https://media.fittour.vn/uploads/giao-luu-tre-em-hunza-pakistan.webp"/> 
      </div> 
      <div class="p-6 flex flex-col flex-grow"> 
        <h3 class="text-[#4caf50] text-[15px] font-serif font-normal uppercase tracking-[0.15em] mb-4">NHỮNG NỤ CƯỜI HUNZA</h3> 
        <p class="text-gray-400 font-light text-sm leading-relaxed mb-8 flex-grow">Gặp gỡ những đứa trẻ hồn nhiên và trải nghiệm lòng hiếu khách nồng hậu của người dân bản địa.</p> 
      </div> 
    </div>

  </div> 
</section>
