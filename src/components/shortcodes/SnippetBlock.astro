---
import { getGlobalSettings } from '@/lib/settingsHelper';
import { replaceTokens } from '@/lib/contentTokens';

import { autoScopeCSS } from '@/lib/cssAutoScope';

interface Props {
  name?: string;
  dataMap?: Record<string, any>;
}

const { name, dataMap } = Astro.props;

const snippetData = name ? dataMap?.snippets?.[name] : null;

let htmlWithTokens = '';
let scopedCss = '';

if (snippetData) {
  const { settings } = await getGlobalSettings();
  htmlWithTokens = replaceTokens(snippetData.html_content || '', settings);
  
  // Scope CSS dynamically at render time if raw CSS exists and scoped is not provided
  if (snippetData.css_content_raw && !snippetData.css_content_scoped) {
    scopedCss = autoScopeCSS(snippetData.css_content_raw, `.snippet-${snippetData.slug}`);
  } else if (snippetData.css_content_scoped) {
    scopedCss = snippetData.css_content_scoped;
  }

  // Smart Filter: Hide links inside the snippet that point to the current page
  const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
  scopedCss += `\n.snippet-${snippetData.slug} a[href="${currentPath}"], .snippet-${snippetData.slug} a[href="${currentPath}/"] { display: none !important; }\n`;
}
---

{name === 'corporate-tours' ? (
  <div class="bg-slate-50 py-16 md:py-24 border-y border-slate-200 mt-16 gallery-breakout">
    <div class="max-w-6xl mx-auto px-4 md:px-6">
      <div class="text-center mb-12">
        <h2 class="text-3xl font-bold text-slate-900 mb-4">Các Hành Trình Doanh Nghiệp Khác</h2>
        <a href="/hanh-trinh-doanh-nghiep/" class="inline-block px-8 py-3 bg-brand-700 font-bold rounded-full hover:bg-brand-800 shadow-sm hover:shadow-md transition-all text-white !no-underline mt-2">
          Xem Tất Cả Hành Trình
        </a>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {(dataMap?.corporateTours || []).map((r: any) => (
          <a href={`/${r.slug}`} class="group block bg-white rounded-2xl overflow-hidden shadow-sm hover:shadow-xl transition-all duration-300 border border-slate-100 !no-underline">
            <div class="aspect-[16/9] w-full overflow-hidden">
              <img src={r.featuredImage ? (r.featuredImage.startsWith('http') ? r.featuredImage : `https://media.fittour.vn${r.featuredImage}`) : '/placeholder.jpg'} alt={r.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 m-0" loading="lazy" />
            </div>
            <div class="p-6">
              <h3 class="text-xl font-bold text-slate-900 group-hover:text-[#c2410c] transition-colors leading-snug line-clamp-3 mt-0 mb-3">{r.title}</h3>
              <p class="text-sm text-slate-500 line-clamp-2">{r.excerpt || ''}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </div>
) : snippetData ? (
  <div class={`snippet-wrapper snippet-${snippetData.slug}`}>
    {scopedCss && (
      <style set:html={scopedCss} />
    )}
    <Fragment set:html={htmlWithTokens} />
  </div>
) : null}
