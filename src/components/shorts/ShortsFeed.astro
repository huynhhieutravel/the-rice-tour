---
export interface Props {
  shorts: any[];
  toursMap: Record<string, string>;
  topicInfo?: any;
}

const { shorts, toursMap, topicInfo } = Astro.props;
---
<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>{topicInfo ? `Chủ đề: ${topicInfo.title}` : 'Khám Phá Video Ngắn'}</title>
  <style>
    body, html { 
      margin: 0; padding: 0; width: 100%; height: 100%; 
      background: #000; color: #fff; 
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif; 
      overflow: hidden; 
    }
    
    .shorts-container {
      width: 100%;
      height: 100dvh;
      overflow-y: scroll;
      scroll-snap-type: y mandatory;
      scroll-behavior: smooth;
      -webkit-overflow-scrolling: touch;
      position: relative;
    }
    
    /* Hide scrollbar */
    .shorts-container::-webkit-scrollbar { display: none; }
    .shorts-container { -ms-overflow-style: none; scrollbar-width: none; }

    .short-item {
      width: 100%;
      height: 100dvh;
      scroll-snap-align: start;
      scroll-snap-stop: always;
      position: relative;
      display: flex;
      align-items: center;
      justify-content: center;
      background: #111;
      overflow: hidden;
    }

    .video-wrapper {
      width: 100%;
      height: 100%;
      position: absolute;
      top: 0; left: 0;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    /* Override TikTok embed padding/margins */
    .video-wrapper blockquote { margin: 0 !important; padding: 0 !important; width: 100% !important; height: 100% !important; max-width: 100% !important; border-radius: 0 !important; }
    .video-wrapper iframe, .video-wrapper video { width: 100% !important; height: 100% !important; object-fit: cover; }

    .thumbnail {
      width: 100%;
      height: 100%;
      object-fit: cover;
      position: absolute;
      inset: 0;
      opacity: 0.5;
      filter: blur(20px);
      transition: opacity 0.3s;
      transform: scale(1.1);
    }

    .overlay {
      position: absolute;
      bottom: 0;
      left: 0;
      width: 100%;
      padding: 20px;
      padding-bottom: 40px; /* Safe area */
      background: linear-gradient(transparent, rgba(0,0,0,0.8));
      pointer-events: none; /* Let clicks pass to video unless it's on a button */
      z-index: 10;
      box-sizing: border-box;
    }

    .overlay-content {
      pointer-events: auto;
    }

    .short-title { font-size: 18px; font-weight: 700; margin: 0 0 8px 0; text-shadow: 1px 1px 2px rgba(0,0,0,0.8); }
    .short-desc { font-size: 14px; margin: 0 0 16px 0; opacity: 0.9; text-shadow: 1px 1px 2px rgba(0,0,0,0.8); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
    
    .cta-btn {
      display: inline-flex;
      align-items: center;
      background: #f59e0b;
      color: #fff;
      padding: 10px 20px;
      border-radius: 24px;
      font-weight: 700;
      font-size: 14px;
      text-decoration: none;
      box-shadow: 0 4px 12px rgba(245, 158, 11, 0.4);
      animation: pulse 2s infinite;
    }

    @keyframes pulse {
      0% { box-shadow: 0 0 0 0 rgba(245, 158, 11, 0.7); }
      70% { box-shadow: 0 0 0 10px rgba(245, 158, 11, 0); }
      100% { box-shadow: 0 0 0 0 rgba(245, 158, 11, 0); }
    }

    .back-btn {
      position: absolute;
      top: 20px;
      left: 20px;
      z-index: 20;
      width: 40px;
      height: 40px;
      background: rgba(0,0,0,0.5);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #fff;
      text-decoration: none;
      backdrop-filter: blur(4px);
    }

    .topic-badge {
      position: absolute;
      top: 20px;
      left: 70px;
      z-index: 20;
      background: rgba(255,255,255,0.2);
      backdrop-filter: blur(8px);
      padding: 8px 16px;
      border-radius: 20px;
      font-weight: 600;
      font-size: 14px;
      text-shadow: 1px 1px 2px rgba(0,0,0,0.5);
    }
    
    .loading-spinner {
      position: absolute;
      width: 40px;
      height: 40px;
      border: 3px solid rgba(255,255,255,0.2);
      border-radius: 50%;
      border-top-color: #fff;
      animation: spin 1s ease-in-out infinite;
      z-index: 1;
    }
    
    @keyframes spin {
      to { transform: rotate(360deg); }
    }
  </style>
</head>
<body>

  <a href="/shorts" class="back-btn">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 18l-6-6 6-6"/></svg>
  </a>

  {topicInfo && (
    <div class="topic-badge">📺 {topicInfo.title}</div>
  )}

  <div class="shorts-container" id="shortsContainer">
    {shorts.length === 0 && (
      <div style="display:flex; height:100%; align-items:center; justify-content:center; color:#94a3b8;">
        Chưa có video nào đang hiển thị.
      </div>
    )}
    
    {shorts.map((short, index) => (
      <div class="short-item" data-id={short.id} data-videourl={short.platform === 'local' ? short.videoUrl : short.videoId} data-platform={short.platform} data-index={index}>
        
        {short.thumbnailUrl ? (
          <img src={short.thumbnailUrl} class="thumbnail" />
        ) : (
          <div class="thumbnail" style="background: #1e293b; opacity: 1;"></div>
        )}
        
        <div class="loading-spinner"></div>
        <div class="video-wrapper"></div>
        
        <div class="overlay">
          <div class="overlay-content">
            {short.title && <h2 class="short-title">{short.title}</h2>}
            {short.description && <p class="short-desc">{short.description}</p>}
            
            {short.tourSlug && (
              <a href={`/tour/${short.tourSlug}`} class="cta-btn">
                MUA NGAY: {toursMap[short.tourSlug] || 'Xem Tour'}
              </a>
            )}
          </div>
        </div>
      </div>
    ))}
  </div>

  <script is:inline>
    const items = document.querySelectorAll('.short-item');
    
    // --- Store Instances ---
    let ytPlayers = {}; // YouTube API instances
    let localPlayers = {}; // Native HTML5 Video elements
    let isYtApiReady = false;

    // Load YouTube Iframe API
    const tag = document.createElement('script');
    tag.src = "https://www.youtube.com/iframe_api";
    const firstScriptTag = document.getElementsByTagName('script')[0];
    firstScriptTag.parentNode.insertBefore(tag, firstScriptTag);

    window.onYouTubeIframeAPIReady = function() {
      isYtApiReady = true;
      items.forEach(item => {
        if (item.classList.contains('is-visible') && item.dataset.platform === 'youtube') {
          initOrPlay(item);
        }
      });
    };

    function initOrPlay(item, forcePlay = true) {
      const platform = item.dataset.platform;
      const id = item.dataset.id;
      const videoValue = item.dataset.videourl; // URL for local, ID for youtube
      
      const wrapper = item.querySelector('.video-wrapper');
      const spinner = item.querySelector('.loading-spinner');

      if (platform === 'local') {
        if (localPlayers[id]) {
          if (forcePlay) localPlayers[id].play().catch(e => console.error("Autoplay prevented:", e));
        } else {
          // Khởi tạo thẻ video
          const video = document.createElement('video');
          video.src = videoValue;
          video.loop = true;
          video.muted = true;
          video.playsInline = true;
          video.style.width = '100%';
          video.style.height = '100%';
          video.style.objectFit = 'cover';
          if (forcePlay) {
            video.autoplay = true;
          }
          
          video.addEventListener('canplay', () => {
             if(spinner) spinner.style.display = 'none';
          });
          
          wrapper.appendChild(video);
          localPlayers[id] = video;
          
          if (forcePlay) {
            video.play().catch(e => console.error(e));
          }
        }
      } 
      else if (platform === 'youtube') {
        if (!isYtApiReady) return; 
        
        if (ytPlayers[id]) {
          if (forcePlay && typeof ytPlayers[id].playVideo === 'function') {
            ytPlayers[id].playVideo();
          }
        } else {
          const playerDiv = document.createElement('div');
          playerDiv.id = 'yt-' + id;
          wrapper.appendChild(playerDiv);

          ytPlayers[id] = new YT.Player(playerDiv.id, {
            videoId: videoValue,
            width: '100%',
            height: '100%',
            playerVars: {
              'autoplay': forcePlay ? 1 : 0,
              'mute': 1, 
              'controls': 0,
              'rel': 0,
              'modestbranding': 1,
              'loop': 1,
              'playlist': videoValue,
              'playsinline': 1, 
              'enablejsapi': 1
            },
            events: {
              'onReady': (event) => {
                const iframe = event.target.getIframe();
                if (iframe) {
                  iframe.style.position = 'absolute';
                  iframe.style.top = '0';
                  iframe.style.left = '0';
                  iframe.style.width = '100%';
                  iframe.style.height = '100%';
                  iframe.style.pointerEvents = 'none'; 
                }

                if(spinner) spinner.style.display = 'none';
                if (item.classList.contains('is-visible')) {
                  event.target.playVideo();
                } else {
                  event.target.pauseVideo();
                }
              }
            }
          });
        }
      }
    }

    function pauseVideo(item) {
      const platform = item.dataset.platform;
      const id = item.dataset.id;
      
      if (platform === 'local' && localPlayers[id]) {
        localPlayers[id].pause();
      } else if (platform === 'youtube' && ytPlayers[id] && typeof ytPlayers[id].pauseVideo === 'function') {
        ytPlayers[id].pauseVideo();
      }
    }

    function destroyVideo(item) {
      const platform = item.dataset.platform;
      const id = item.dataset.id;
      
      if (platform === 'local' && localPlayers[id]) {
        localPlayers[id].pause();
        localPlayers[id].removeAttribute('src'); // free memory
        localPlayers[id].load();
        delete localPlayers[id];
      } else if (platform === 'youtube' && ytPlayers[id]) {
        if (typeof ytPlayers[id].destroy === 'function') {
          ytPlayers[id].destroy();
        }
        delete ytPlayers[id];
      }
      
      const wrapper = item.querySelector('.video-wrapper');
      if (wrapper) wrapper.innerHTML = '';
      const spinner = item.querySelector('.loading-spinner');
      if (spinner) spinner.style.display = 'flex';
    }

    // --- Intersection Observer for Scroll Virtualization ---
    let activeIndex = 0;
    const itemsArray = Array.from(items);
    
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        const itemIndex = itemsArray.indexOf(entry.target);
        
        if (entry.isIntersecting) {
          activeIndex = itemIndex;
          entry.target.classList.add('is-visible');
          initOrPlay(entry.target, true);
          
          itemsArray.forEach((otherItem, i) => {
            if (Math.abs(i - activeIndex) > 2) {
              destroyVideo(otherItem);
            } else if (i !== activeIndex) {
              initOrPlay(otherItem, false);
            }
          });
        } else {
          entry.target.classList.remove('is-visible');
          pauseVideo(entry.target);
        }
      });
    }, {
      root: document.getElementById('shortsContainer'),
      threshold: 0.6 
    });

    items.forEach(item => observer.observe(item));

    // --- Tap to Unmute / Play/Pause ---
    items.forEach(item => {
      item.addEventListener('click', (e) => {
        if (e.target.closest('.cta-btn') || e.target.closest('.back-btn')) return;

        const platform = item.dataset.platform;
        const id = item.dataset.id;
        
        if (platform === 'local' && localPlayers[id]) {
          const video = localPlayers[id];
          if (video.muted) {
            video.muted = false;
            video.currentTime = 0;
            video.play();
          } else {
            if (video.paused) {
              video.play();
            } else {
              video.pause();
            }
          }
        } 
        else if (platform === 'youtube' && ytPlayers[id]) {
          const player = ytPlayers[id];
          if (typeof player.getPlayerState === 'function') {
            const state = player.getPlayerState();
            if (player.isMuted()) {
              player.unMute();
              player.seekTo(0);
            } else {
              if (state === 1) {
                player.pauseVideo();
              } else {
                player.playVideo();
              }
            }
          }
        }
      });
    });
  </script>
</body>
</html>
