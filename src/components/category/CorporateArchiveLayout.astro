<style>
  /* Group tabs matching CRM */
  .lkh-group-tab {
    display: inline-flex; align-items: center; gap: 6px;
    padding: 6px 12px; font-size: 13px; font-weight: 600;
    border: 1px solid #d1d5db; border-radius: 4px;
    background: #ffffff; color: #374151; cursor: pointer;
    transition: all 0.15s ease; white-space: nowrap; text-decoration: none;
  }
  .lkh-group-tab.uppercase-tab {
    text-transform: uppercase;
  }
  .lkh-group-tab:hover { background: #f9fafb; border-color: #9ca3af; }
  .lkh-group-tab.active { background: #d32f2f; border-color: #d32f2f; color: #fff; font-weight: 700; }
  .lkh-arrow { font-size: 10px; color: #6b7280; transition: transform 0.2s; }
  .lkh-group-tab.active .lkh-arrow { color: #ffffff; }
  .lkh-group-wrap.open .lkh-arrow { transform: rotate(180deg); }
  .lkh-group-wrap.open .lkh-dropdown { display: block !important; }
</style>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    
    // 1. Toggle Dropdowns (Event Delegation)
    document.addEventListener('click', (e) => {
      // Handle Toggle button click
      const toggleBtn = e.target.closest('.toggle-dropdown');
      if (toggleBtn) {
        e.preventDefault();
        e.stopPropagation();
        const wrap = toggleBtn.closest('.lkh-group-wrap');
        const isOpen = wrap.classList.contains('open');
        document.querySelectorAll('.lkh-group-wrap').forEach(w => w.classList.remove('open'));
        if (!isOpen) {
          wrap.classList.add('open');
        }
        return;
      }

      // Close dropdowns if clicking outside
      if (!e.target.closest('.lkh-group-wrap')) {
        document.querySelectorAll('.lkh-group-wrap').forEach(w => w.classList.remove('open'));
      }
    });

    // 2. AJAX SPA Filtering
    document.addEventListener('click', async (e) => {
      // Find if clicked element is a filter link
      const filterLink = e.target.closest('#lkh-market-groups a');
      if (filterLink) {
        e.preventDefault();
        const url = filterLink.getAttribute('href');
        
        // Update browser URL silently
        window.history.pushState({}, '', url);
        
        const filterContainer = document.getElementById('corporate-filter-bar');
        const showcaseGrid = document.getElementById('corporate-showcase-grid');
        
        if (showcaseGrid && filterContainer) {
          // Visual feedback
          showcaseGrid.style.opacity = '0.4';
          showcaseGrid.style.transition = 'opacity 0.2s ease-in-out';
          showcaseGrid.style.pointerEvents = 'none';
          
          try {
            const res = await fetch(url);
            if (!res.ok) throw new Error('Network response was not ok');
            const html = await res.text();
            
            // Parse new HTML
            const parser = new DOMParser();
            const doc = parser.parseFromString(html, 'text/html');
            
            const newFilterContainer = doc.getElementById('corporate-filter-bar');
            const newShowcaseGrid = doc.getElementById('corporate-showcase-grid');
            
            if (newFilterContainer && newShowcaseGrid) {
              // Replace DOM content
              filterContainer.innerHTML = newFilterContainer.innerHTML;
              showcaseGrid.innerHTML = newShowcaseGrid.innerHTML;
            } else {
              window.location.href = url; // Fallback if structure changes
            }
          } catch (err) {
            console.error('AJAX Filter Error:', err);
            window.location.href = url; // Fallback on error
          } finally {
            // Restore visual state
            showcaseGrid.style.opacity = '1';
            showcaseGrid.style.pointerEvents = 'auto';
          }
        } else {
          window.location.href = url;
        }
      }
    });
    
    // 3. Handle browser Back/Forward buttons
    window.addEventListener('popstate', () => {
      window.location.reload();
    });
  });
</script>
