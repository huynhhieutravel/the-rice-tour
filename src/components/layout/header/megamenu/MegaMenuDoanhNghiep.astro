---
// src/components/layout/header/megamenu/MegaMenuDoanhNghiep.astro
---

<div class="w-full flex items-stretch">
  {/* Left Column: Intro */}
  <div class="w-[260px] shrink-0 bg-slate-50 p-6 flex flex-col justify-between border-r border-slate-100/50">
    <div>
      <h3 class="text-[17px] font-extrabold text-gray-900 leading-snug mb-2">
        Giải pháp Du lịch Doanh Nghiệp Trọn gói
      </h3>
      <p class="text-[13px] text-gray-600 leading-relaxed font-medium">
        Khẳng định văn hoá doanh nghiệp qua từng chuyến đi. Thiết kế độc bản, tối ưu ngân sách 24/7.
      </p>
    </div>
    
    <div class="mt-6">
      <a href="/tour-doanh-nghiep/" class="inline-flex items-center text-[14px] font-bold text-brand-600 hover:text-brand-700 transition-colors">
        Khám phá ngay
        <svg class="w-4 h-4 ml-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>
    </div>
  </div>

  {/* Middle Column: 4 Core Services */}
  <div class="w-[280px] shrink-0 p-6 py-7 flex flex-col justify-center gap-4 bg-white border-r border-gray-100">
    <a href="/tour-incentive-travel-doanh-nghiep/" class="flex items-center group">
      <div class="w-9 h-9 rounded-full border border-gray-100 bg-white text-gray-800 flex items-center justify-center mr-3 shrink-0 transition-all duration-300 group-hover:border-brand-200 group-hover:text-brand-600 shadow-sm group-hover:shadow-md">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z" />
        </svg>
      </div>
      <h4 class="text-[14px] font-bold text-gray-900 group-hover:text-brand-600 transition-colors whitespace-nowrap">Incentive Travel</h4>
    </a>
    
    <a href="/company-trip/" class="flex items-center group">
      <div class="w-9 h-9 rounded-full border border-gray-100 bg-white text-gray-800 flex items-center justify-center mr-3 shrink-0 transition-all duration-300 group-hover:border-brand-200 group-hover:text-brand-600 shadow-sm group-hover:shadow-md">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
        </svg>
      </div>
      <h4 class="text-[14px] font-bold text-gray-900 group-hover:text-brand-600 transition-colors whitespace-nowrap">Company Trip</h4>
    </a>
    
    <a href="/corporate-retreat/" class="flex items-center group">
      <div class="w-9 h-9 rounded-full border border-gray-100 bg-white text-gray-800 flex items-center justify-center mr-3 shrink-0 transition-all duration-300 group-hover:border-brand-200 group-hover:text-brand-600 shadow-sm group-hover:shadow-md">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" />
        </svg>
      </div>
      <h4 class="text-[14px] font-bold text-gray-900 group-hover:text-brand-600 transition-colors whitespace-nowrap">Corporate Retreat</h4>
    </a>
    
    <a href="/to-chuc-su-kien-cong-ty-cho-doanh-nghiep/" class="flex items-center group">
      <div class="w-9 h-9 rounded-full border border-gray-100 bg-white text-gray-800 flex items-center justify-center mr-3 shrink-0 transition-all duration-300 group-hover:border-brand-200 group-hover:text-brand-600 shadow-sm group-hover:shadow-md">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
        </svg>
      </div>
      <h4 class="text-[14px] font-bold text-gray-900 group-hover:text-brand-600 transition-colors whitespace-nowrap">MICE & Events</h4>
    </a>
  </div>

  {/* Right Column: Case Study Feature */}
  <div class="flex-1 p-6 py-7 bg-white flex flex-col justify-center">
    <div class="flex items-center justify-between mb-4">
      <h3 class="text-[12px] font-bold text-gray-400 uppercase tracking-wider">Hành trình tiêu biểu</h3>
      <a href="/hanh-trinh-doanh-nghiep/" class="text-[12px] font-semibold text-brand-500 hover:underline flex items-center">
        Xem tất cả
        <svg class="w-3 h-3 ml-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </a>
    </div>
    
    <div class="grid grid-cols-2 gap-4">
      {/* Case 1 */}
      <a href="/case-study-incentive-travel-samsung-vietnam/" class="block group relative rounded-[14px] overflow-hidden shadow-sm aspect-video">
        <img src="https://media.fittour.vn/uploads/2025/12/case-study-du-lich-samsung-phapxthuysi.webp" alt="Samsung Vietnam" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" loading="lazy">
        
        {/* Badge Overlay */}
        <div class="absolute top-2.5 left-2.5 bg-white/95 backdrop-blur-md px-2 py-1 rounded-full text-[10px] font-bold text-gray-800 flex items-center shadow-sm">
          <svg class="w-2.5 h-2.5 text-brand-500 mr-1" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M11.3 1.046A12.014 12.014 0 0010 1a11.996 11.996 0 00-8.083 3.17A10.01 10.01 0 001 10c0 5.068 3.864 9.248 8.784 9.94a1.999 1.999 0 002.432-2.432C9.52 16.51 9 15.319 9 14c0-2.761 2.239-5 5-5a5.955 5.955 0 014.28 1.637 10.01 10.01 0 00-6.98-9.591zM10 5a2 2 0 100 4 2 2 0 000-4z" clip-rule="evenodd"></path></svg>
          Samsung
        </div>
        
        {/* Content overlay */}
        <div class="absolute inset-0 bg-gradient-to-t from-[#1d1d1f]/95 via-[#1d1d1f]/30 to-transparent opacity-90 group-hover:opacity-100 transition-opacity"></div>
        <div class="absolute bottom-0 left-0 w-full p-3">
          <h4 class="text-white text-[13px] font-bold leading-tight group-hover:text-brand-300 transition-colors line-clamp-2">
            Chiến lược gắn kết nhân sự với Incentive Châu Âu
          </h4>
        </div>
      </a>

      {/* Case 2 */}
      <a href="/fpt-telecom-380-thanh-vien-phan-thiet/" class="block group relative rounded-[14px] overflow-hidden shadow-sm aspect-video">
        <img src="https://media.fittour.vn/uploads/du-lich-doanh-nghiep-fpt-telecom-phan-thiet.webp" alt="FPT Telecom" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" loading="lazy">
        
        {/* Badge Overlay */}
        <div class="absolute top-2.5 left-2.5 bg-white/95 backdrop-blur-md px-2 py-1 rounded-full text-[10px] font-bold text-gray-800 flex items-center shadow-sm">
          <svg class="w-2.5 h-2.5 text-orange-500 mr-1" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M11.3 1.046A12.014 12.014 0 0010 1a11.996 11.996 0 00-8.083 3.17A10.01 10.01 0 001 10c0 5.068 3.864 9.248 8.784 9.94a1.999 1.999 0 002.432-2.432C9.52 16.51 9 15.319 9 14c0-2.761 2.239-5 5-5a5.955 5.955 0 014.28 1.637 10.01 10.01 0 00-6.98-9.591zM10 5a2 2 0 100 4 2 2 0 000-4z" clip-rule="evenodd"></path></svg>
          FPT Telecom
        </div>
        
        {/* Content overlay */}
        <div class="absolute inset-0 bg-gradient-to-t from-[#1d1d1f]/95 via-[#1d1d1f]/30 to-transparent opacity-90 group-hover:opacity-100 transition-opacity"></div>
        <div class="absolute bottom-0 left-0 w-full p-3">
          <h4 class="text-white text-[13px] font-bold leading-tight group-hover:text-brand-300 transition-colors line-clamp-2">
            Đoàn 380 khách FPT Telecom bùng nổ tại Phan Thiết
          </h4>
        </div>
      </a>
    </div>
  </div>
</div>
