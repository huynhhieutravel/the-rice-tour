---
import type { MegaMenuSection } from '@/config/navigation/default';

export interface Props {
  columns: MegaMenuSection[][];
}

const { columns } = Astro.props;
---

<div class="w-full p-10">
  <h3 class="text-3xl font-bold text-gray-900 tracking-tight mb-8">Tours</h3>
  
  <div class="grid grid-cols-1 md:grid-cols-4 gap-x-12 gap-y-0">
    {columns.map((col) => (
      <div class="flex flex-col gap-10">
        {col.map((section) => (
          <div class="flex flex-col">
            {section.title && (
              <h4 class="text-gray-900 font-semibold mb-5 text-base tracking-wide">{section.title}</h4>
            )}
            <ul class="space-y-4">
              {section.links.map((link) => (
                <li>
                  <a 
                    href={link.href} 
                    class={`flex items-center text-[15px] font-medium transition-colors duration-200 group/link ${
                      link.isHighlight ? 'text-brand-600 hover:text-brand-700' : 'text-gray-600 hover:text-brand-600'
                    }`}
                  >
                    {/* Orange Circle with white chevron right */}
                    {link.isHighlight ? (
                       <svg class={`w-4 h-4 mr-2.5 shrink-0 transition-transform duration-200 group-hover/link:translate-x-1 ${link.isHighlight ? 'text-brand-600' : 'text-brand-500'}`} fill="none" viewBox="0 0 24 24" stroke="currentColor">
                         <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
                       </svg>
                    ) : (
                      <svg class="w-4 h-4 mr-2.5 shrink-0 text-brand-500 opacity-80 group-hover/link:opacity-100 transition-opacity" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <circle cx="12" cy="12" r="10" fill="currentColor"/>
                        <path d="M10 8L14 12L10 16" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    )}
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    ))}
  </div>
</div>
