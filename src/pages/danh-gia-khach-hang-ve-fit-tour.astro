---
import BaseLayout from '@/layouts/BaseLayout.astro';
import LiveGoogleReviews from '@/components/reviews/LiveGoogleReviews.astro';
import CustomerStories from '@/components/reviews/CustomerStories.astro';

const seoData = {
  title: 'Đánh giá khách hàng về FIT Tour',
  description: 'Những đánh giá chân thực từ khách hàng về chất lượng dịch vụ của FIT Tour.',
  image: 'https://media.fittour.vn/uploads/2026/01/default-share.jpg',
  type: 'website'
};
---

<BaseLayout 
  title={seoData.title}
  description={seoData.description}
  image={seoData.image}
  type={seoData.type}
  isFullWidth={true}
>
  <main class="w-full bg-[#F9F7F0]">
    
    <!-- Hero Section: 2-Column Layout -->
    <section class="w-full py-16 md:py-24 px-4 overflow-hidden">
      <div class="max-w-[1200px] mx-auto grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-8 items-center">
        
        <!-- Left Column: Content -->
        <div class="reveal-up space-y-6">
          <!-- Breadcrumb -->
          <nav class="flex text-sm text-gray-500 font-medium mb-4">
            <a href="/" class="hover:text-brand-600 transition-colors">Trang chủ</a>
            <span class="mx-2">/</span>
            <span class="text-gray-900">Đánh giá khách hàng</span>
          </nav>
          
          <h1 class="text-4xl md:text-5xl font-serif font-bold text-gray-900 leading-tight max-w-[90%]">
            Đánh giá khách hàng về <span class="text-brand-600 whitespace-nowrap">FIT Tour</span>
          </h1>
          
          <div class="text-lg text-gray-600 space-y-4 font-light">
            <p><strong>Đánh giá khách hàng về FIT Tour</strong> là những lời kể chân thành sau chuyến đi. Họ đã cười, xúc động và quay lại những lần sau.</p>
            <p>Những khoảnh khắc tự nhiên và chân thật nhất được ghi lại từ những vị khách đồng hành cùng chúng tôi. Cùng xem các đánh giá thật, từ người thật chia sẻ!</p>
          </div>
        </div>

        <!-- Right Column: Video -->
        <div class="reveal-up relative flex justify-center lg:justify-end">
          <div class="w-full max-w-[420px] rounded-[16px] shadow-2xl overflow-hidden relative transform hover:scale-[1.02] transition-transform duration-300 z-10 border-4 border-white">
            <iframe 
              src="https://www.facebook.com/plugins/video.php?height=476&href=https%3A%2F%2Fwww.facebook.com%2Freel%2F1361299168977575%2F&show_text=false&t=0" 
              width="100%" 
              height="476" 
              style="border:none;overflow:hidden;display:block;margin:0 auto;background:#000;" 
              scrolling="no" 
              frameborder="0" 
              allowfullscreen="true" 
              allow="autoplay; clipboard-write; encrypted-media; picture-in-picture; web-share"
            ></iframe>
          </div>
          <!-- Decorative Glow -->
          <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[120%] h-[120%] bg-brand-500/15 blur-[80px] rounded-full z-0 pointer-events-none"></div>
        </div>
        
      </div>
    </section>

    <!-- Section 2: Customer Stories (Blog Category 92) -->
    <CustomerStories />

    <!-- Section 3: Live Google Reviews -->
    <LiveGoogleReviews />
  </main>
</BaseLayout>
