---
import { env } from 'cloudflare:workers';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { safeQueryCritical } from '@/lib/db-client';
import { getGlobalSettings } from '@/lib/settingsHelper';
import { MapPin, Info, Users, Clock, Calendar, Compass, Share2, Link as LinkIcon, ChevronRight, CheckCircle2 } from 'lucide-react';

const d1Db = env?.dulichcoguu_d1;
if (!d1Db) return Astro.rewrite("/500");

// Fetch CMS Data for SEO and Metadata
let post;
try {
  post = await safeQueryCritical(
    d1Db.prepare("SELECT * FROM Post WHERE slug = ? AND (status = 'published' OR status = 'publish')").bind('tu-vien-ladakh').first<any>(),
    { route: Astro.url.pathname, slug: 'tu-vien-ladakh', queryType: "fetch_post_by_slug" }
  );
} catch (e) {
  return Astro.rewrite("/500");
}

if (!post) {
  return Astro.rewrite("/404");
}

const { settings } = await getGlobalSettings();

const seoTitle = post.seoTitle || post.title || 'Top 18 Tu Viện Nổi Tiếng Nhất Ladakh';
const seoDesc = post.seoDesc || post.excerpt || 'Khám phá 18 tu viện Phật giáo Tây Tạng linh thiêng và nổi tiếng nhất tại Ladakh, Ấn Độ.';
const seoImage = post.seoImage || post.featuredImage || 'https://media.fittour.vn/uploads/thiksey-monastery-ladakh.webp';

// --- DATE LOGIC ---
const createdAtStr = post.createdAt || post.publishedAt || new Date().toISOString();
const updatedAtStr = post.updatedAt || createdAtStr;

const createdAt = new Date(createdAtStr.replace(' ', 'T'));
const updatedAt = new Date(updatedAtStr.replace(' ', 'T'));

// Nếu ngày cập nhật sau ngày tạo hơn 1 ngày (86400000ms), coi như là bài được update
const isUpdated = updatedAt.getTime() - createdAt.getTime() > 86400000; 
const displayDate = isUpdated ? updatedAt : createdAt;
const datePrefix = isUpdated ? "Cập nhật:" : "Xuất bản:";

const formattedDate = displayDate.toLocaleDateString('vi-VN', { day: '2-digit', month: '2-digit', year: 'numeric' });
// ------------------

const adminEditUrl = `/admin/posts/edit?id=${post.id}`;

// List of monasteries based on the content
const monasteries = [
  { id: "hemis", name: "Tu viện Hemis", location: "Khu vực Leh", sect: "Drukpa Kagyu", festival: "Hemis Festival", festivalLink: "/hinh-anh-le-hoi-hemis", alt: "3.710m", time: "1 - 2 giờ", img: "https://media.fittour.vn/uploads/2023/06/tu-vien-hemis-ladakh-fittour.webp", desc: "Là tu viện lớn và có ảnh hưởng nhất Ladakh, Tu viện Hemis thuộc dòng Drukpa Kagyu và được thành lập vào thế kỷ XVII. Đây là trung tâm tôn giáo quan trọng bậc nhất của vùng đất này.<br/><br/>Hemis nổi tiếng với Hemis Festival – lễ hội Phật giáo lớn nhất Ladakh. Hàng năm, các vị Lạt Ma thực hiện những điệu múa Cham truyền thống trong trang phục và mặt nạ đầy màu sắc nhằm tái hiện các câu chuyện tâm linh của Phật giáo Tây Tạng.", link: "/tu-vien-giau-co-nhat-ladakh-hemis" },
  { id: "thiksey", name: "Tu viện Thiksey", location: "Khu vực Leh", sect: "Gelug", festival: "Thiksey Gustor", alt: "3.600m", time: "1.5 - 2 giờ", img: "https://media.fittour.vn/uploads/2022/05/tu-vien-thiksey.webp", desc: "Nằm trên một ngọn đồi cao nhìn xuống thung lũng Indus, Thiksey thường được ví như 'Potala Palace thu nhỏ của Ladakh'. Đây là một trong những hình ảnh biểu tượng nhất của vùng đất Himalaya này.<br/><br/>Tu viện thuộc dòng Gelug và nổi tiếng với bức tượng Đức Phật Di Lặc cao 15 mét. Vào mỗi buổi sáng, tiếng tụng kinh vang vọng giữa núi non tạo nên bầu không khí đặc biệt khiến nhiều du khách nhớ mãi.", link: "/tu-vien-thiksey" },
  { id: "shey", name: "Tu viện Shey", location: "Khu vực Leh", sect: "Gelug", festival: "Shey Doo Lhoo", alt: "3.415m", time: "1 giờ", img: "https://media.fittour.vn/uploads/shey-palace-ladakh.webp", desc: "Trước khi Leh trở thành thủ phủ của Ladakh, Shey từng là kinh đô mùa hè của các vị vua Ladakh. Vì vậy, nơi đây không chỉ mang giá trị tôn giáo mà còn có ý nghĩa lịch sử quan trọng.<br/><br/>Điểm nổi bật nhất của Shey là bức tượng Đức Phật Thích Ca bằng đồng mạ vàng khổng lồ, được xem là một trong những tượng Phật lớn nhất Ladakh." },
  { id: "spituk", name: "Tu viện Spituk", location: "Khu vực Leh", sect: "Gelug", festival: "Spituk Gustor", alt: "3.307m", time: "1 giờ", img: "https://media.fittour.vn/uploads/spituk-monastery.webp", desc: "Chỉ cách Leh khoảng 8 km, Spituk là một trong những tu viện dễ tiếp cận nhất đối với du khách mới đến Ladakh.<br/><br/>Tu viện nổi tiếng với lễ hội Spituk Gustor diễn ra vào mùa đông, nơi các vị Lạt Ma thực hiện các điệu múa mặt nạ truyền thống nhằm xua đuổi tà khí và cầu mong bình an." },
  { id: "chemrey", name: "Tu viện Chemrey", location: "Thung lũng Indus", sect: "Drukpa Kagyu", festival: "Chemrey Festival", alt: "3.650m", time: "1 giờ", img: "https://media.fittour.vn/uploads/2024/06/tu-vien-Chemrey-ladakh.webp", desc: "Được xây dựng vào thế kỷ XVII, Chemrey là một trong những tu viện đẹp nhất vùng thung lũng Indus. Kiến trúc màu trắng nổi bật trên sườn núi tạo nên khung cảnh rất đặc trưng của Ladakh.<br/><br/>So với Hemis hay Thiksey, Chemrey ít đông đúc hơn và mang lại cảm giác yên bình cho du khách muốn tìm hiểu đời sống tu viện.", link: "/tu-vien-chemrey" },
  { id: "phyang", name: "Tu viện Phyang", location: "Khu vực Leh", sect: "Drikung Kagyu", festival: "Phyang Tsedup", alt: "3.600m", time: "1.5 giờ", img: "https://media.fittour.vn/uploads/2023/01/tu-vien-Phyang-ladakh.webp", desc: "Phyang được biết đến như một trong những trung tâm quan trọng của dòng Drikung Kagyu tại Ladakh. Tu viện lưu giữ nhiều hiện vật quý, bao gồm tượng Phật, kinh sách cổ và tranh thangka.<br/><br/>Từ vị trí của tu viện, du khách có thể ngắm nhìn toàn cảnh thung lũng rộng lớn phía dưới, đặc biệt đẹp vào mùa hè.", link: "/tu-vien-phyang" },
  { id: "matho", name: "Tu viện Matho", location: "Thung lũng Indus", sect: "Sakya", festival: "Matho Nagrang", alt: "3.500m", time: "1.5 giờ", img: "https://media.fittour.vn/uploads/2024/06/tu-vien-matho-ladakh.webp", desc: "Matho là tu viện duy nhất tại Ladakh thuộc dòng Sakya của Phật giáo Tây Tạng. Tu viện nổi tiếng với lễ hội Matho Nagrang, nơi các nhà sư nhập thất thực hiện những nghi lễ tiên tri độc đáo.<br/><br/>Đây là một trong những tu viện mang màu sắc huyền bí nhất Ladakh và thu hút nhiều người quan tâm đến văn hóa tâm linh Tây Tạng.", link: "/tu-vien-matho" },
  { id: "stakna", name: "Tu viện Stakna", location: "Thung lũng Indus", sect: "Drukpa Kagyu", festival: "Truyền thống", alt: "3.350m", time: "1 giờ", img: "https://media.fittour.vn/uploads/stakna-monastery.webp", desc: "Nằm trên một ngọn đồi có hình dáng giống mũi hổ bên bờ sông Indus, Tu viện Stakna sở hữu vị trí vô cùng ấn tượng.<br/><br/>Tu viện được thành lập vào thế kỷ XVI và nổi tiếng với khung cảnh thanh bình cùng những bức tranh thangka cổ được bảo tồn tốt." },
  { id: "alchi", name: "Tu viện Alchi", location: "Tây Ladakh", sect: "Phật giáo sơ kỳ", festival: "Truyền thống", alt: "3.100m", time: "2 giờ", img: "https://media.fittour.vn/uploads/2024/06/tu-vien-alchi-ladakh.webp", desc: "Khác với hầu hết các tu viện Ladakh được xây dựng trên đỉnh đồi, Alchi nằm dưới thung lũng bên dòng sông Indus. Chính vị trí này giúp nơi đây bảo tồn được nhiều tác phẩm nghệ thuật quý giá qua nhiều thế kỷ.<br/><br/>Alchi nổi tiếng với các bích họa và tác phẩm nghệ thuật Phật giáo từ thế kỷ XI. Đây được xem là kho tàng nghệ thuật Tây Tạng cổ quan trọng nhất tại Himalaya.", link: "/tu-vien-alchi" },
  { id: "lamayuru", name: "Tu viện Lamayuru", location: "Tây Ladakh", sect: "Drikung Kagyu", festival: "Yuru Kabgyat", alt: "3.510m", time: "2 giờ", img: "https://media.fittour.vn/uploads/2024/06/toan-canh-tu-vien-lamayuru.webp", desc: "Lamayuru là một trong những tu viện cổ nhất Ladakh và nổi tiếng với vùng địa hình được gọi là 'Moonland' nhờ những dãy núi có hình dạng giống bề mặt Mặt Trăng.<br/><br/>Theo truyền thuyết, khu vực này từng là một hồ nước lớn trước khi được các bậc thầy Phật giáo khai phá thành nơi tu hành. Sự kết hợp giữa cảnh quan độc đáo và lịch sử lâu đời khiến Lamayuru trở thành điểm đến đặc biệt đối với du khách.", link: "/tu-vien-lamayuru" },
  { id: "likir", name: "Tu viện Likir", location: "Tây Ladakh", sect: "Gelug", festival: "Dosmoche", alt: "3.700m", time: "1.5 giờ", img: "https://media.fittour.vn/uploads/2022/04/tu-vien-likir.webp", desc: "Likir nổi tiếng với bức tượng Đức Phật Di Lặc mạ vàng cao hơn 20 mét nhìn ra toàn bộ thung lũng phía dưới. Đây là một trong những hình ảnh dễ nhận biết nhất của Ladakh.<br/><br/>Bên trong tu viện còn lưu giữ nhiều bản kinh cổ, tượng Phật và hiện vật tôn giáo có giá trị lịch sử cao.", link: "/tu-vien-likir" },
  { id: "rizong", name: "Tu viện Rizong", location: "Tây Ladakh", sect: "Gelug", festival: "Truyền thống", alt: "3.450m", time: "1.5 giờ", img: "https://media.fittour.vn/uploads/rizong-monastery.webp", desc: "Rizong thường được gọi là 'thiên đường thiền định' của Ladakh nhờ vị trí biệt lập giữa các hẻm núi đá.<br/><br/>Tu viện nổi tiếng với kỷ luật tu hành nghiêm ngặt và môi trường yên tĩnh, rất phù hợp cho những ai muốn tìm hiểu sâu hơn về đời sống của các nhà sư Tây Tạng." },
  { id: "diskit", name: "Tu viện Diskit", location: "Nubra Valley", sect: "Gelug", festival: "Dosmoche", alt: "3.144m", time: "1.5 giờ", img: "https://media.fittour.vn/uploads/legacy/tu-vien-diskit-gompa.webp", desc: "Là tu viện lớn nhất Nubra Valley, Diskit giữ vai trò trung tâm tôn giáo của khu vực phía bắc Ladakh. Từ đây, du khách có thể phóng tầm mắt ra toàn bộ thung lũng Nubra.<br/><br/>Bức tượng Đức Phật Di Lặc khổng lồ phía trước tu viện đã trở thành biểu tượng của Nubra Valley và là điểm dừng chân quen thuộc trên hành trình qua đèo Khardung La.", link: "/tu-vien-diskit" },
  { id: "samstanling", name: "Tu viện Samstanling", location: "Nubra Valley", sect: "Gelug", festival: "Truyền thống", alt: "3.200m", time: "1 giờ", img: "https://media.fittour.vn/uploads/samstanling.webp", desc: "Nằm gần làng Sumur, Samstanling là một trong những tu viện đẹp nhất Nubra Valley với kiến trúc truyền thống và những bức tranh tường đầy màu sắc.<br/><br/>Không gian yên bình cùng khung cảnh núi non bao quanh khiến nơi đây trở thành điểm dừng chân lý tưởng cho du khách." },
  { id: "ensa", name: "Tu viện Ensa", location: "Nubra Valley", sect: "Gelug", festival: "Truyền thống", alt: "3.300m", time: "1 giờ", img: "https://media.fittour.vn/uploads/ensa-monastery.webp", desc: "Ensa là một tu viện cổ nằm trên sườn núi cao nhìn xuống Nubra Valley. Mặc dù hiện nay chỉ còn lại một phần công trình ban đầu, nơi đây vẫn mang giá trị lịch sử và khảo cổ đáng kể.<br/><br/>Từ tu viện, du khách có thể chiêm ngưỡng toàn cảnh thung lũng tuyệt đẹp." },
  { id: "karsha", name: "Tu viện Karsha", location: "Zanskar", sect: "Gelug", festival: "Karsha Gustor", alt: "3.800m", time: "2 giờ", img: "https://media.fittour.vn/uploads/karsha-monastery.webp", desc: "Karsha là tu viện lớn nhất Zanskar với hàng trăm nhà sư đang sinh sống và tu học.<br/><br/>Tu viện nằm trên sườn núi nhìn xuống thung lũng rộng lớn, tạo nên một trong những khung cảnh ngoạn mục nhất khu vực." },
  { id: "phuktal", name: "Tu viện Phuktal", location: "Zanskar", sect: "Gelug", festival: "Truyền thống", alt: "4.000m", time: "Nửa ngày", img: "https://media.fittour.vn/uploads/2023/06/du-khach-chup-anh-ben-tu-vien-Phugtal.webp", desc: "Phuktal là một trong những tu viện độc đáo nhất Himalaya khi được xây dựng bên trong một hang động tự nhiên trên vách núi.<br/><br/>Do không có đường xe đến tận nơi, du khách phải trekking nhiều giờ để tiếp cận. Chính điều này giúp Phuktal giữ được vẻ nguyên sơ và linh thiêng hiếm có.", link: "/tu-vien-phugtal" },
  { id: "stongde", name: "Tu viện Stongde", location: "Zanskar", sect: "Gelug", festival: "Stongde Gustor", alt: "3.900m", time: "1.5 giờ", img: "https://media.fittour.vn/uploads/2023/06/khong-gian-ben-trong-yen-tinh-tu-vien-Stongdey-Zanskar-ladakh.webp", desc: "Stongde là tu viện lớn thứ hai tại Zanskar sau Karsha. Nằm trên đỉnh đồi cao, tu viện mang đến tầm nhìn tuyệt đẹp ra toàn bộ thung lũng.<br/><br/>Nơi đây nổi tiếng với các bức tranh tường cổ, tượng Phật và kiến trúc truyền thống Tây Tạng được bảo tồn tốt.", link: "/tu-vien-stongdey" }
];

---

<BaseLayout 
  title={seoTitle} 
  description={seoDesc} 
  image={seoImage}
  adminEditUrl={adminEditUrl}
>
  <div class="bg-[#F8F9FA] text-[#1E293B] font-sans antialiased selection:bg-[#c89845] selection:text-white">

    {/* ================= HERO SECTION ================= */}
    <section class="relative w-full h-[600px] lg:h-[650px] overflow-hidden">
      <div class="absolute inset-0 z-0 bg-slate-900">
        <img src={seoImage} alt="Tu viện Ladakh" class="w-full h-full object-cover object-center opacity-80" fetchpriority="high" loading="eager" />
        <div class="absolute inset-0 bg-gradient-to-r from-black/80 via-black/50 to-transparent"></div>
        <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-transparent to-transparent"></div>
      </div>

      {/* Removed Torn Paper Effect because of 404 and low contrast skew */}
      <div class="relative z-10 max-w-[1600px] mx-auto px-4 sm:px-6 lg:px-12 h-full flex flex-col justify-center pt-20 pb-16">
        
        {/* Breadcrumb */}
        <div class="flex items-center gap-2 text-[13px] text-white/70 font-medium mb-6">
          <a href="/" class="hover:text-white transition-colors">Trang chủ</a>
          <ChevronRight class="w-3 h-3" />
          <a href="/blog" class="hover:text-white transition-colors">Blog</a>
          <ChevronRight class="w-3 h-3" />
          <span class="text-white">Ladakh</span>
        </div>

        {/* Titles */}
        <h1 class="font-serif text-4xl sm:text-5xl lg:text-6xl font-bold text-white mb-4 leading-[1.1] drop-shadow-lg max-w-4xl">
          Top 18 tu viện Ladakh tuyệt vời mà bạn nên ghé thăm
        </h1>
        <h2 class="font-serif text-xl sm:text-3xl text-amber-400 italic mb-10 max-w-3xl drop-shadow-md">
          Khám Phá Di Sản Phật Giáo Giữa Dãy Himalaya
        </h2>
        <p class="text-white/90 text-base sm:text-lg max-w-2xl leading-relaxed mb-8 hidden md:block drop-shadow-md font-medium">
          Hành trình khám phá <strong class="text-amber-400 font-bold">những tu viện Ladakh</strong> linh thiêng và hùng vĩ nhất – nơi lưu giữ trọn vẹn tinh hoa văn hóa, lịch sử và tinh thần Phật giáo Tây Tạng nguyên thủy trải qua hàng trăm năm.
        </p>

        {/* Author Meta */}
        <div class="flex flex-wrap items-center gap-6 text-sm text-white/80 border-t border-white/20 pt-6 max-w-3xl">
          <a href="/huynh-hieu" class="flex items-center gap-3 group">
            <img src="https://media.fittour.vn/uploads/huynhhieutravel.webp" alt="Huynh Hieu" class="w-10 h-10 rounded-full border-2 border-white/30 object-cover object-top group-hover:border-amber-400 transition-colors" />
            <span class="font-bold text-white group-hover:text-amber-400 transition-colors flex items-center gap-1">
              {post.author || 'Huynh Hieu Travel'} 
              <CheckCircle2 class="w-4 h-4 text-blue-400" />
            </span>
          </a>
          <div class="flex items-center gap-2 bg-white/10 px-4 py-2 rounded-full backdrop-blur-sm border border-white/10">
            <Calendar class="w-4 h-4 opacity-70" />
            <span>{datePrefix} {formattedDate}</span>
          </div>
          <div class="flex items-center gap-2 bg-black/20 px-3 py-1.5 rounded-full backdrop-blur-sm">
            <Clock class="w-4 h-4 text-amber-400" />
            <span>12 phút đọc</span>
          </div>
        </div>

        {/* Badges Line */}
        <div class="flex flex-wrap items-center gap-4 mt-8 pt-6">
          <div class="flex items-center gap-2 text-sm text-white font-medium bg-black/60 backdrop-blur-md px-4 py-2 border border-white/10 rounded-lg shadow-xl">
            <span class="text-amber-400 text-lg">⛰️</span> 18 Tu viện
          </div>
          <div class="flex items-center gap-2 text-sm text-white font-medium bg-black/60 backdrop-blur-md px-4 py-2 border border-white/10 rounded-lg shadow-xl">
            <span class="text-amber-400 text-lg">🪷</span> 5 Dòng Phật giáo
          </div>
          <div class="flex items-center gap-2 text-sm text-white font-medium bg-black/60 backdrop-blur-md px-4 py-2 border border-white/10 rounded-lg shadow-xl">
            <span class="text-amber-400 text-lg">🎭</span> 7 Lễ hội nổi tiếng
          </div>
          <div class="flex items-center gap-2 text-sm text-white font-medium bg-black/60 backdrop-blur-md px-4 py-2 border border-white/10 rounded-lg shadow-xl">
            <span class="text-amber-400 text-lg">🧭</span> Hướng dẫn tham quan
          </div>
        </div>

      </div>
    </section>

    {/* ================= MAIN CONTENT GRID ================= */}
    <div class="max-w-[1600px] mx-auto px-4 sm:px-6 lg:px-12 py-12 lg:py-16">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-start">

        {/* ---------------- LEFT SIDEBAR (TOC) ---------------- */}
        <aside class="hidden lg:block lg:col-span-3 sticky top-24">
          <div class="bg-white rounded-2xl shadow-sm border border-slate-200/60 p-6 overflow-hidden">
            <div class="flex items-center gap-2 font-bold text-slate-800 mb-6 border-l-4 border-amber-500 pl-3 text-sm tracking-wide uppercase">
              Mục lục bài viết
            </div>
            
