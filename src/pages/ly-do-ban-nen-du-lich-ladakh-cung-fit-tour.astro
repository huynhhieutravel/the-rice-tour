---
import BaseLayout from '../layouts/BaseLayout.astro';
import LyDoChonFitTourLadakh from '../components/ReactApp/LyDoChonFitTourLadakh/LyDoChonFitTourLadakh.tsx';
import '../styles/ly-do-chon-fit-tour-ladakh.css';

// Lấy dữ liệu SEO từ Database (nếu Admin có tạo bài viết với slug này)
import { env } from 'cloudflare:workers';
const d1Db = env?.dulichcoguu_d1;

let seoTitle = "Lý do bạn nên du lịch Ladakh cùng Fit Tour | FIT Tour";
let seoDesc = "Đồng hành cùng chuyên gia lữ hành Fit Tour để tận hưởng trọn vẹn hành trình Himalaya hùng vĩ một cách an toàn và chất lượng nhất.";
let ogImage = "";
let adminEditUrl = "";

if (d1Db) {
  try {
    const stmt = d1Db.prepare(`SELECT id, title, seoTitle as metaTitle, seoDescription as metaDescription, featuredImage FROM Post WHERE slug = 'ly-do-ban-nen-du-lich-ladakh-cung-fit-tour' LIMIT 1`);
    const postData = await stmt.first();
    if (postData) {
      seoTitle = postData.metaTitle || postData.title || seoTitle;
      seoDesc = postData.metaDescription || seoDesc;
      ogImage = postData.featuredImage || ogImage;
      if (postData.id) {
        adminEditUrl = `/admin/posts/edit?id=${postData.id}`;
      }
    }
  } catch (e) {
    console.error("Lỗi lấy SEO data cho trang ly-do-ban-nen-du-lich-ladakh-cung-fit-tour:", e);
  }
}
---
<BaseLayout
  title={seoTitle}
  description={seoDesc}
  image={ogImage}
  canonical="https://thericetour.com/ly-do-ban-nen-du-lich-ladakh-cung-fit-tour"
  adminEditUrl={adminEditUrl}
>
  <Fragment slot="head">
    <meta property="og:type" content="article" />
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&family=JetBrains+Mono:wght@400;500;700&display=swap">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&family=JetBrains+Mono:wght@400;500;700&display=swap" media="print" onload="this.media='all'">
    <noscript>
      <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&family=JetBrains+Mono:wght@400;500;700&display=swap">
    </noscript>
  </Fragment>

  <main class="w-full pb-12 lg:pb-20">
    <div class="max-w-6xl mx-auto px-4 lg:px-8 mt-8 lg:mt-12">
      <nav class="flex text-sm text-secondary mb-8" aria-label="Breadcrumb">
        <ol class="inline-flex items-center space-x-1 md:space-x-2">
          <li class="inline-flex items-center">
            <a href="/" class="text-secondary hover:text-brand-700 font-medium transition-colors">Trang chủ</a>
          </li>
          <li>
            <div class="flex items-center">
              <svg class="w-3 h-3 text-muted mx-1" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 6 10">
                <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 9 4-4-4-4"/>
              </svg>
              <a href="/category/blog" class="text-secondary hover:text-brand-700 font-medium transition-colors ml-1 md:ml-2">Blog</a>
            </div>
          </li>
          <li aria-current="page">
            <div class="flex items-center">
              <svg class="w-3 h-3 text-muted mx-1" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 6 10">
                <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 9 4-4-4-4"/>
              </svg>
              <span class="text-primary font-medium ml-1 md:ml-2 truncate max-w-[200px] sm:max-w-xs">{seoTitle}</span>
            </div>
          </li>
        </ol>
      </nav>

      {ogImage && (
        <figure class="mb-10 rounded-2xl overflow-hidden shadow-sm aspect-[16/9] bg-slate-100 relative">
          <img src={ogImage} alt={seoTitle} class="absolute inset-0 w-full h-full object-cover" fetchpriority="high" loading="eager" decoding="async" />
        </figure>
      )}
    </div>

    <!-- Giao diện React cực mượt -->
    <LyDoChonFitTourLadakh client:load seoDescription={seoDesc} />
  </main>
</BaseLayout>
