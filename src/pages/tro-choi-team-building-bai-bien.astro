import { env } from 'cloudflare:workers';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { safeQueryCritical } from '@/lib/db-client';
import { getGlobalSettings } from '@/lib/settingsHelper';
import { MapPin, Info, Users, Clock, Calendar, Compass, Share2, Link as LinkIcon, ChevronRight, CheckCircle2, Target, Activity, Star, Map, Lightbulb, Package, BarChart2, AlertTriangle } from 'lucide-react';

const d1Db = env?.dulichcoguu_d1;
if (!d1Db) return Astro.rewrite("/500");

// Fetch CMS Data for SEO and Metadata
let post;
try {
  post = await safeQueryCritical(
    d1Db.prepare("SELECT * FROM Post WHERE slug = ? AND (status = 'published' OR status = 'publish')").bind('tro-choi-team-building-bai-bien').first<any>(),
    { route: Astro.url.pathname, slug: 'tro-choi-team-building-bai-bien', queryType: "fetch_post_by_slug" }
  );
} catch (e) {
  return Astro.rewrite("/500");
}

if (!post) {
  // If user hasn't created the post in CMS yet, we rewrite to 404 as per standard
  return Astro.rewrite("/404");
}

const { settings } = await getGlobalSettings();

const seoTitle = post.seoTitle || post.title || '8 Concept Tổ Chức Team Building Bãi Biển Khác Biệt Cho Doanh Nghiệp';
const seoDesc = post.seoDesc || post.excerpt || 'Vì sao nhiều chương trình Team Building vẫn "vui nhưng không đọng lại"? Khám phá 8 concept tổ chức Team Building độc đáo giúp truyền tải trọn vẹn thông điệp.';
const seoImage = post.seoImage || post.featuredImage || 'https://media.fittour.vn/uploads/2023/06/team-building-bai-bien-fittour.webp';

// --- DATE LOGIC ---
const createdAtStr = post.createdAt || post.publishedAt || new Date().toISOString();
const updatedAtStr = post.updatedAt || createdAtStr;

const createdAt = new Date(createdAtStr.replace(' ', 'T'));
const updatedAt = new Date(updatedAtStr.replace(' ', 'T'));

// Nếu ngày cập nhật sau ngày tạo hơn 1 ngày (86400000ms), coi như là bài được update
const isUpdated = updatedAt.getTime() - createdAt.getTime() > 86400000; 
const displayDate = isUpdated ? updatedAt : createdAt;
const datePrefix = isUpdated ? "Cập nhật:" : "Xuất bản:";

const formattedDate = displayDate.toLocaleDateString('vi-VN', { day: '2-digit', month: '2-digit', year: 'numeric' });
