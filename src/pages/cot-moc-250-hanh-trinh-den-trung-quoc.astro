---
import BaseLayout from '../layouts/BaseLayout.astro';
import { env } from 'cloudflare:workers';
import { safeQueryCritical } from '../lib/db-client';
import NoShoppingPhilosophy from '../components/ReactApp/Milestone250/NoShoppingPhilosophy.tsx';
import TeamChina from '../components/ReactApp/Milestone250/TeamChina.tsx';
import SnippetBlock from '../components/shortcodes/SnippetBlock.astro';
import TourGallery from '../components/tour/TourGallery.astro';

let postData = null;
let adminEditUrl = "/admin/posts/edit?id=1781570000035";

const d1Db = env?.dulichcoguu_d1;
let chinaEmagazineSnippet = null;

if (d1Db) {
  try {
    postData = await safeQueryCritical(
      d1Db.prepare("SELECT * FROM Post WHERE id = ?").bind("1781570000035").first(),
      { route: Astro.url.pathname, slug: "cot-moc-250", queryType: "fetch_landing_post" }
    );
    if (postData && postData.id) {
        adminEditUrl = `/admin/posts/edit?id=${postData.id}`;
    }

    chinaEmagazineSnippet = await safeQueryCritical(
      d1Db.prepare("SELECT * FROM Snippet WHERE slug = 'china-emagazine'").first(),
      { route: Astro.url.pathname, slug: "china-emagazine", queryType: "fetch_snippet" }
    );
  } catch (e) {
    console.log("Could not fetch metadata from D1:", e);
  }
}

const dataMap = {
  snippets: {
    'china-emagazine': chinaEmagazineSnippet
  }
};

const featuredImage = postData?.featuredImage || "/placeholder-image.jpg";
---
<BaseLayout
  title={postData?.title || "Cột mốc 250+ Hành Trình Đến Trung Quốc Của FIT Tour"}
  description={postData?.description || "Hơn 250 hành trình là minh chứng cho quá trình trưởng thành của FIT TOUR. Khám phá sự khác biệt qua các tuyến Đạo Thành Á Đinh, Kailash, Silk Road và Tân Cương."}
  image={featuredImage}
  canonical="https://thericetour.com/cot-moc-250-hanh-trinh-den-trung-quoc"
  adminEditUrl={adminEditUrl}
>
  <Fragment slot="head">
    <meta property="og:type" content="article" />
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" media="print" onload="this.media='all'">
    <style>
      .font-sans { font-family: 'Inter', sans-serif; }
    </style>
  </Fragment>

  <div class="min-h-screen font-sans bg-[#F9F8F6] text-stone-900 selection:bg-amber-100 selection:text-amber-900 overflow-x-hidden antialiased">
    
    {/* 1. HERO SECTION */}
    <header class="relative bg-[#F9F8F6] border-b border-stone-200 py-20 px-4 sm:px-12">
      <div class="max-w-6xl mx-auto space-y-10">
        <nav class="flex flex-wrap items-center gap-2 text-stone-500 font-mono text-[10px] uppercase tracking-wider">
          <a href="/" class="hover:text-stone-900 transition-colors">TRANG CHỦ</a>
          <span>/</span>
          <a href="/blog" class="hover:text-stone-900 transition-colors">BLOG</a>
          <span>/</span>
          <span class="text-stone-900 font-semibold uppercase">Cột mốc 250+ Hành Trình Đến Trung Quốc</span>
        </nav>

        <div class="space-y-8 text-left">
          <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-red-900/10 border border-red-900/20 text-red-900 font-mono text-[9px] uppercase tracking-wider font-bold">
            MINH CHỨNG CHO MỘT HÀNH TRÌNH TRƯỞNG THÀNH
          </div>
          
          <h1 class="text-5xl sm:text-7xl md:text-8xl lg:text-[100px] font-black text-stone-950 leading-[1] tracking-tight uppercase">
            CỘT MỐC 250+ <br />
            <span class="font-light italic text-5xl sm:text-7xl md:text-8xl lg:text-[100px] text-red-900 capitalize">Hành Trình</span><br />
            <span class="text-3xl sm:text-5xl lg:text-6xl text-stone-500 tracking-normal">KHÁM PHÁ TRUNG HOA</span>
          </h1>

          <div class="space-y-6 pt-6 max-w-4xl">
            <p class="text-stone-700 text-lg sm:text-xl leading-relaxed text-justify">
              Trung Quốc không phải là nơi để đi một lần cho biết. Hơn 250 chuyến đi trong 4 năm qua là quá trình chúng tôi liên tục đi, liên tục học và hiểu rõ hơn về địa hình, văn hóa của từng vùng đất để tinh chỉnh lại dịch vụ của mình.
            </p>
            <p class="text-stone-700 text-lg sm:text-xl leading-relaxed text-justify">
              Từ những cổ trấn Giang Nam nhẹ nhàng, Con Đường Tơ Lụa trải dài qua hoang mạc, cho đến không khí loãng của Tây Tạng hay vẻ đẹp khắc nghiệt của Đạo Thành Á Đinh — mỗi cung đường đều dạy cho đội ngũ cách tổ chức những chuyến đi ngày một an toàn và trọn vẹn hơn.
            </p>
          </div>

          {/* Quick Stats Grid */}
          <div class="grid grid-cols-2 md:grid-cols-4 gap-6 mt-16 pt-10 border-t border-stone-200 text-left">
            <div class="space-y-2">
              <span class="text-4xl sm:text-6xl font-black text-stone-950 block">250<span class="text-2xl text-stone-500 font-light">+</span></span>
              <span class="font-mono text-[10px] uppercase tracking-wider text-stone-500 block">Hành trình thiết kế riêng</span>
            </div>
            <div class="space-y-2">
              <span class="text-4xl sm:text-6xl font-black text-stone-950 block">4<span class="text-2xl text-stone-500 font-light"> năm</span></span>
              <span class="font-mono text-[10px] uppercase tracking-wider text-stone-500 block">Liên tục phát triển sau mở cửa</span>
            </div>
            <div class="space-y-2">
              <span class="text-4xl sm:text-6xl font-black text-stone-950 block">0</span>
              <span class="font-mono text-[10px] uppercase tracking-wider text-stone-500 block">Triết lý no-shopping</span>
            </div>
            <div class="space-y-2">
              <span class="text-4xl sm:text-6xl font-black text-stone-950 block">100<span class="text-2xl text-stone-500 font-light">%</span></span>
              <span class="font-mono text-[10px] uppercase tracking-wider text-stone-500 block">Trải nghiệm chiều sâu</span>
            </div>
          </div>
          {/* FEATURED IMAGE INSIDE HEADER */}
          <div class="mt-16">
            <div class="w-full rounded-3xl overflow-hidden relative shadow-2xl group border border-stone-200">
              <img 
                src={featuredImage} 
                alt="Cột mốc 250 hành trình khám phá Trung Quốc" 
                class="w-full h-auto object-contain transition-transform duration-1000 group-hover:scale-105"
              />
            </div>
          </div>
        </div>
      </div>
    </header>

    {/* 2. TIMELINE SECTION (EXPANDED) */}
    <section class="py-24 px-4 sm:px-12 bg-white">
      <div class="max-w-7xl mx-auto">
        <div class="text-center mb-20 max-w-3xl mx-auto">
          <span class="font-mono text-xs uppercase tracking-widest text-red-900 font-bold block mb-4">HÀNH TRÌNH CHINH PHỤC</span>
          <h2 class="text-4xl md:text-6xl font-bold text-stone-900">Bốn Năm Nhìn Lại</h2>
          <p class="mt-6 text-stone-600 italic text-xl">Bốn năm qua, thứ tăng lên không chỉ là số lượng đoàn khách, mà là độ khó của những cung đường và kinh nghiệm xử lý thực địa của đội ngũ.</p>
        </div>

        <div class="relative grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 lg:gap-10 before:hidden lg:before:block lg:before:absolute lg:before:top-[1.4rem] lg:before:left-12 lg:before:right-12 lg:before:h-[2px] lg:before:bg-gradient-to-r lg:before:from-transparent lg:before:via-stone-200 lg:before:to-transparent">
          {[
            { year: "2023", title: "Khởi Động Lại Giữa Những Ngỡ Ngàng", desc: "Sau đại dịch, mọi thứ gần như phải bắt đầu lại. Suốt năm 2023, chúng tôi liên tục bay sang để đi khảo sát lại từng tuyến đường, kiểm tra từng nhà hàng, khách sạn để chắc chắn chất lượng vẫn đúng như cam kết ban đầu." },
            { year: "2024", title: "Bước Ra Khỏi Vùng An Toàn", desc: "Thay vì làm các tour giá rẻ kèm mua sắm, chúng tôi chọn đi ngược lại: Tổ chức những tuyến khó hơn. Đạo Thành Á Đinh hay Con Đường Tơ Lụa được mở ra, mang đến những trải nghiệm khác biệt nhưng cũng là bài toán lớn về khâu vận hành." },
            { year: "2025", title: "Vượt Mốc Độ Cao 5.000m", desc: "Kailash, Thanh Tạng, Tân Cương bắt đầu trở thành những cái tên quen thuộc. Đưa khách lên độ cao trên 5.000m, sự chuyên nghiệp lúc này không chỉ nằm ở nụ cười phục vụ, mà là kỹ năng xử lý say độ cao, bình oxy dự phòng và sự theo dõi sức khỏe sát sao." },
            { year: "2026", title: "Chiều Sâu Của Trải Nghiệm", desc: "2026 – Những hành trình không còn được đo bằng số lượng đoàn, mà bằng chiều sâu của trải nghiệm. Một chuyến đi thành công là những cuộc trò chuyện thật với dân bản xứ, những đêm lều giữa thảo nguyên hoang sơ, và sự thấu cảm văn hóa địa phương một cách chân thực nhất." }
          ].map((item, index) => (
            <div class="relative flex flex-col items-center text-center group">
              <div class="flex items-center justify-center w-12 h-12 rounded-full border-4 border-white bg-red-900 text-white font-mono text-[12px] font-bold shrink-0 shadow-[0_0_0_4px_rgba(127,29,29,0.05)] z-10 mb-8 transition-transform duration-300 group-hover:scale-110">
                {item.year}
              </div>
              <div class="w-full p-8 rounded-3xl bg-[#F9F8F6] border border-stone-100 shadow-sm transition-all duration-300 hover:shadow-lg hover:-translate-y-2 h-full flex flex-col relative z-10">
                <h3 class="font-bold text-xl text-stone-900 mb-4">{item.title}</h3>
                <p class="text-stone-600 leading-relaxed text-[15px] flex-grow">{item.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <div class="px-4 sm:px-12 -mt-12 mb-12 relative z-20">
      <TourGallery
        title=""
        columns={4}
        images={[
          { src: "https://media.fittour.vn/uploads/2023/07/du-khach-chup-anh-cung-cac-la-co-lungta-o-tay-tang.webp" },
          { src: "https://media.fittour.vn/uploads/2023/09/doan-khach-tay-tang-thang-9-2023-tham-quan-chua-dai-chieu-tay-tang.webp" },
          { src: "https://media.fittour.vn/uploads/2023/12/doan-fit-tour-tham-quan-cuu-trai-cau.webp" },
          { src: "https://media.fittour.vn/uploads/2023/12/du-khach-chup-anh-truoc-cua-vao-cuu-trai-cau.webp" },
          { src: "https://media.fittour.vn/uploads/2023/12/du-khach-chup-hinh-o-cuu-trai-cau.webp" },
          { src: "https://media.fittour.vn/uploads/2023/12/tuyet-roi-o-khu-vuc-cuu-trai-cau.webp" },
          { src: "https://media.fittour.vn/uploads/2024/04/doan-company-trip-le-giang-den-moc-phu-pho-co-le-giang.webp" },
          { src: "https://media.fittour.vn/uploads/2024/07/dinh-nui-kailash-sung-sung-tu-xa.webp" },
          { src: "https://media.fittour.vn/uploads/2024/07/doan-khach-tour-kailash-chup-anh-o-cot-moc-cao-toc-g318.webp" },
          { src: "https://media.fittour.vn/uploads/2024/07/du-khach-check-in-truoc-cung-dien-potala-tay-tang.webp" },
          { src: "https://media.fittour.vn/uploads/2024/07/du-khach-chuan-bi-hanh-trinh-kora-o-kailash.webp" },
          { src: "https://media.fittour.vn/uploads/2024/07/khung-canh-xanh-tuoi-cac-ngon-doi-trong-hanh-trinh-kailash.webp" },
          { src: "https://media.fittour.vn/uploads/2025/08/road-trip-tan-cuong-cuoi-ngua-nui-bang-fit-tour.webp" },
          { src: "https://media.fittour.vn/uploads/2025/08/road-trip-tan-cuong-cuoi-yak-ho-bach-sa-fit-tour.webp" },
          { src: "https://media.fittour.vn/uploads/chi-ly-voi-kailash-luc-binh-minh.webp" },
          { src: "https://media.fittour.vn/uploads/han-phuc-hanh-lang-tu-cam-thanh-bac-kinh.webp" }
        ]}
      />
    </div>

    {/* EXCLUSIVE BLOCK: THE PRICE OF NO SHOPPING */}
    <NoShoppingPhilosophy client:visible />

    {/* 3. MAP SECTION (EXPANDED) */}
    <section class="py-24 px-4 sm:px-12 bg-stone-900 text-stone-100 overflow-hidden relative">
      <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 2px 2px, white 1px, transparent 0); background-size: 32px 32px;"></div>
      <div class="max-w-7xl mx-auto relative z-10">
        <div class="max-w-3xl mb-20">
          <span class="font-mono text-xs uppercase tracking-widest text-amber-500 font-bold block mb-4">Khám Phá Chiều Sâu</span>
          <h2 class="text-4xl md:text-6xl lg:text-7xl font-bold text-white leading-tight">Một Trung Hoa <br/><span class="italic font-light text-stone-400">Nhiều Thế Giới Khác Nhau</span></h2>
          <p class="mt-8 text-stone-400 text-xl italic">Khách của FIT TOUR hiếm khi đi Trung Quốc một lần. Đa phần họ quay lại lần hai, lần ba, bởi Trung Quốc quá rộng lớn và mỗi vùng đất lại mang một màu sắc văn hóa, địa hình hoàn toàn khác biệt.</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
          {[
            { tag: "Trung Hoa Cổ Điển", desc: "Không chỉ là việc check-in <a href='/tour/tour-bac-kinh-tu-ha-noi' class='text-amber-500 hover:text-amber-400 transition-colors underline underline-offset-4'>Tử Cấm Thành</a> hay Bến Thượng Hải. Đó là trải nghiệm thưởng trà tĩnh lặng trong những viên lâm <a href='/tour/tour-trung-quoc-giang-nam' class='text-amber-500 hover:text-amber-400 transition-colors underline underline-offset-4'>Giang Nam</a>, hay lắng nghe nhịp sống chậm rãi dưới mái ngói âm dương của <a href='/tour/tour-le-giang-6n5d' class='text-amber-500 hover:text-amber-400 transition-colors underline underline-offset-4'>Lệ Giang</a>.", places: ["Bắc Kinh", "Giang Nam", "Lệ Giang"] },
            { tag: "Trung Hoa Di Sản", desc: "Những lăng tẩm trầm mặc của Thiểm Tây, những pho tượng Phật tạc thẳng vào vách núi ở Sơn Tây. Nơi mà mỗi tấc đất đều chôn vùi một di sản, một câu chuyện của các triều đại huy hoàng xa xưa.", places: ["Thiểm Tây", "Sơn Tây", "Giang Tây"] },
            { tag: "Trung Hoa Biên Viễn", desc: "Những vùng sa mạc trải dài vô tận, những hồ nước mặn xanh ngắt như ngọc, và sự giao thoa văn hóa rực rỡ của người bản địa. Một Trung Hoa hoang dã, khoáng đạt và tự do.", places: ["Tân Cương", "Thanh Hải", "Cam Túc"] },
            { tag: "Trung Hoa Himalaya", desc: "Nơi không khí loãng đặc trưng nhưng tâm hồn lại cảm thấy trọn vẹn nhất. Những tu viện bám chênh vênh trên vách núi, những ngọn cờ luân xa bay trong gió tuyết, và một hành trình thanh tẩy tâm hồn.", places: ["Tây Tạng", "Kailash", "Đạo Thành Á Đinh"] }
          ].map((zone) => (
            <div class="group flex flex-col border border-stone-700/50 hover:border-amber-500/50 bg-stone-800/30 p-8 rounded-3xl transition-all duration-300 hover:bg-stone-800/60">
              <h3 class="text-3xl font-bold text-amber-50 mb-4">{zone.tag}</h3>
              <p class="text-stone-400 text-sm leading-relaxed mb-8 flex-grow" set:html={zone.desc}></p>
              <ul class="space-y-3 mt-auto border-t border-stone-700/50 pt-6">
                {zone.places.map((place) => (
                  <li class="flex items-center gap-3 text-stone-200 font-mono text-sm uppercase font-bold tracking-wider">
                    <div class="w-1.5 h-1.5 rounded-full bg-amber-500"></div>
                    {place}
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </section>

    {/* 4. THE MASTERPIECE BLOCK (DEEP DIVE INTO OPERATIONS) */}
    <section class="py-24 px-4 sm:px-12 bg-[#F9F8F6]">
      <div class="max-w-6xl mx-auto">
        <div class="text-center mb-20">
          <span class="font-mono text-xs uppercase tracking-widest text-red-900 font-bold block mb-4">Giá Trị Của Sự Chuyên Sâu</span>
          <h2 class="text-4xl md:text-5xl lg:text-6xl font-bold text-stone-900">Khía Cạnh Hậu Cần Phía Sau <br/>Những Cột Mốc</h2>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-20">
          <div class="bg-white p-10 rounded-3xl border border-stone-200 shadow-sm flex flex-col justify-center">
            <div class="text-red-900 text-6xl font-black mb-6">10</div>
            <h3 class="text-3xl font-bold text-stone-900 mb-4">Hành trình <a href="/tour/tour-dao-thanh-a-dinh" class="hover:text-amber-700 underline decoration-amber-500/30 underline-offset-4 transition-colors">Đạo Thành Á Đinh</a></h3>
            <p class="text-stone-600 leading-relaxed text-lg">Đạo Thành mùa thu đẹp lộng lẫy, nhưng khắc nghiệt. Ở độ cao trên 4.000m, sự chuyên nghiệp không nằm ở nụ cười, mà ở bình oxy dự phòng, nhịp độ di chuyển chậm rãi để cơ thể thích nghi, và sự tính toán chính xác từng tuần của thời tiết.</p>
          </div>
          <div class="bg-white p-10 rounded-3xl border border-stone-200 shadow-sm flex flex-col justify-center">
            <div class="text-red-900 text-6xl font-black mb-6">4</div>
            <h3 class="text-3xl font-bold text-stone-900 mb-4">Hành trình <a href="/tour/tour-hanh-huong-nui-kailash-12n11d" class="hover:text-amber-700 underline decoration-amber-500/30 underline-offset-4 transition-colors">Kailash</a></h3>
            <p class="text-stone-600 leading-relaxed text-lg">Hành hương nhiễu Phật (Kora) dài 52km quanh ngọn núi thiêng ở độ cao trên 5.000m. Một chuyến đi không dành cho số đông. Đòi hỏi sự rèn luyện thể lực hàng tháng trời từ khách hàng, cùng quy trình xin giấy phép đặc biệt, chuẩn bị vật tư y tế khẩn cấp và đội ngũ sherpa khuân vác chuyên nghiệp từ phía FIT TOUR.</p>
          </div>
          <div class="bg-white p-10 rounded-3xl border border-stone-200 shadow-sm flex flex-col justify-center">
            <div class="text-red-900 text-6xl font-black mb-6">10</div>
            <h3 class="text-3xl font-bold text-stone-900 mb-4">Hành trình <a href="/tour/tour-con-duong-to-lua-22n" class="hover:text-amber-700 underline decoration-amber-500/30 underline-offset-4 transition-colors">Silk Road</a></h3>
            <p class="text-stone-600 leading-relaxed text-lg">Chia làm 2 lộ trình chuyên biệt. Hành trình trải dài hàng ngàn kilomet xuyên qua các hoang mạc. Ở đây, một người Hướng dẫn viên không chỉ giỏi tổ chức, mà còn phải là một "nhà sử học" để kể lại sống động bối cảnh giao thương của các triều đại, giúp khách hàng nhìn thấy văn minh đằng sau những tàn tích cát bụi.</p>
          </div>
          <div class="bg-white p-10 rounded-3xl border border-stone-200 shadow-sm flex flex-col justify-center">
            <div class="text-red-900 text-6xl font-black mb-6">8</div>
            <h3 class="text-3xl font-bold text-stone-900 mb-4">Hành trình <a href="/tour/tour-tan-cuong-mua-thu" class="hover:text-amber-700 underline decoration-amber-500/30 underline-offset-4 transition-colors">Tân Cương</a></h3>
            <p class="text-stone-600 leading-relaxed text-lg">Diện tích Tân Cương bằng 1/6 toàn bộ Trung Quốc. Việc phải di chuyển hàng trăm kilomet mỗi ngày đòi hỏi chất lượng xe phải là loại tốt nhất, tài xế phải là người bản địa thuộc nằm lòng từng khúc cua, và các trạm dừng chân phải được tiền trạm kỹ càng để đảm bảo sức khỏe cho khách.</p>
          </div>
        </div>

        {/* The Golden Block */}
        <div class="bg-stone-900 text-stone-50 rounded-[3rem] p-10 md:p-16 lg:p-20 relative overflow-hidden shadow-2xl">
          <div class="absolute top-0 right-0 p-8 opacity-5 pointer-events-none">
            <svg width="300" height="300" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2L2 22h20L12 2zm0 3.8l7.2 14.2H4.8L12 5.8z"/></svg>
          </div>
          <blockquote class="relative z-10 max-w-4xl mx-auto text-center">
            <p class="text-3xl md:text-5xl lg:text-6xl leading-tight font-serif italic text-stone-100 mb-10">
              "Cùng là 10 chuyến đi, nhưng giá trị tích lũy không bao giờ giống nhau. Một hành trình vùng cao sẽ luôn dạy nhiều hơn một hành trình bằng phẳng."
            </p>
            <footer>
              <p class="text-lg md:text-xl text-stone-400 font-light leading-relaxed max-w-3xl mx-auto">
                Mười chuyến đi đến một thành phố đô thị sẽ khác hoàn toàn với mười chuyến đi lên bình nguyên tuyết phủ — nơi mọi trải nghiệm đều phụ thuộc vào năng lực thực địa vững vàng và bản lĩnh của người dẫn đường.
              </p>
            </footer>
          </blockquote>
        </div>
      </div>
    </section>

    {/* 5. CONCLUSION */}
    <section class="py-32 px-4 sm:px-12 bg-white border-t border-stone-200">
      <div class="max-w-4xl mx-auto text-center space-y-12">
        <h2 class="text-5xl md:text-6xl lg:text-7xl font-black text-stone-900 leading-tight">
          Điều Trung Hoa Dạy Chúng Tôi <br/>Sau 250 Hành Trình
        </h2>
        
        <div class="prose prose-stone prose-lg md:prose-xl mx-auto text-left text-stone-700 leading-relaxed">
          <p>
            Sau hơn 250 hành trình, điều FIT TOUR nhận ra không phải là mình đã hiểu hết Trung Quốc. Ngược lại. Mỗi lần quay trở lại, chúng tôi lại phát hiện thêm một mùa đẹp hơn, một cung đường khác hơn, một câu chuyện chưa từng được kể.
          </p>
          <p>
            Vẫn còn đó một Giang Nam dịu dàng nép mình bên dòng nước, một Con Đường Tơ Lụa giấu kín những nền văn minh cổ, một <a href="/tour/tour-tay-tang" class="font-medium text-stone-900 underline decoration-amber-500/30 hover:decoration-amber-500 underline-offset-4 transition-all">Tây Tạng</a> thiêng liêng tĩnh lặng, và một Tân Cương hoang dã đến mức mỗi chuyến đi đều mang đến một sự ngỡ ngàng mới.
          </p>
          <p class="font-bold text-stone-900 text-2xl md:text-3xl mt-12 text-center border-t border-stone-200 pt-12">
            Có lẽ vì vậy mà 250 hành trình không phải là đích đến. Nó chỉ là điểm khởi đầu cho những hành trình tiếp theo.
          </p>
        </div>
      </div>
    </section>

