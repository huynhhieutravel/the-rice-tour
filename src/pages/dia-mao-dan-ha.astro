---
import { env } from 'cloudflare:workers';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { safeQueryCritical } from '@/lib/db-client';
import { getGlobalSettings } from '@/lib/settingsHelper';
import { MapPin, Info, Users, Clock, Calendar, Compass, Share2, Link as LinkIcon, ChevronRight, CheckCircle2 } from 'lucide-react';

const d1Db = env?.dulichcoguu_d1;
if (!d1Db) return Astro.rewrite("/500");

// Fetch CMS Data for SEO and Metadata
let post;
try {
  post = await safeQueryCritical(
    d1Db.prepare("SELECT * FROM Post WHERE slug = ? AND (status = 'published' OR status = 'publish')").bind('dia-mao-dan-ha').first<any>(),
    { route: Astro.url.pathname, slug: 'dia-mao-dan-ha', queryType: "fetch_post_by_slug" }
  );
} catch (e) {
  // It's possible the post doesn't exist yet, we can mock it for now or rely on the query
}

// Fallback if post not in DB, since this is a hardcoded page
if (!post) {
  post = {
    title: 'Địa Mạo Đan Hà Trương Dịch: Kỳ Quan Núi Cầu Vồng 135 Triệu Năm Tuổi Ở Cam Túc',
    excerpt: 'Địa Mạo Đan Hà Trương Dịch là những dãy đồi đỏ, cam, vàng, nâu và xám uốn lượn như từng lớp màu được vẽ lên mặt đất, tạo nên khung cảnh hiếm thấy.',
    featuredImage: 'https://media.fittour.vn/uploads/2023/10/dia-mao-dan-ha.webp', // Default image fallback
    id: 999, // fallback id
    author: 'Huynh Hieu Travel',
    createdAt: new Date().toISOString()
  };
}

const { settings } = await getGlobalSettings();

const seoTitle = post.seoTitle || post.title || 'Địa Mạo Đan Hà Trương Dịch: Kỳ Quan Núi Cầu Vồng Ở Cam Túc';
const seoDesc = post.seoDesc || post.excerpt || 'Khám phá Địa Mạo Đan Hà Trương Dịch (Qicai Danxia) - Kỳ quan núi cầu vồng 135 triệu năm tuổi tuyệt đẹp ở Cam Túc, Trung Quốc dọc con đường tơ lụa.';
const seoImage = post.seoImage || post.featuredImage || 'https://media.fittour.vn/uploads/2023/10/dia-mao-dan-ha.webp';

// --- DATE LOGIC ---
const createdAtStr = post.createdAt || post.publishedAt || new Date().toISOString();
const updatedAtStr = post.updatedAt || createdAtStr;

const createdAt = new Date(createdAtStr.replace(' ', 'T'));
const updatedAt = new Date(updatedAtStr.replace(' ', 'T'));

const isUpdated = updatedAt.getTime() - createdAt.getTime() > 86400000; 
const displayDate = isUpdated ? updatedAt : createdAt;
const datePrefix = isUpdated ? "Cập nhật:" : "Xuất bản:";

const formattedDate = displayDate.toLocaleDateString('vi-VN', { day: '2-digit', month: '2-digit', year: 'numeric' });
// ------------------

const adminEditUrl = post.id !== 999 ? `/admin/posts/edit?id=${post.id}` : '#';

// TOC Data
const toc = [
  { id: "gioi-thieu", title: "Giới thiệu", icon: "🏠" },
  { id: "dia-mao-dan-ha-o-dau", title: "Địa Mạo Đan Hà Ở Đâu?" },
  { id: "vi-sao-goi-la-nui-cau-vong", title: "Vì Sao Gọi Là \"Núi Cầu Vồng\"?" },
  { id: "dieu-gi-tao-nen-dai-mau", title: "Điều Gì Tạo Nên Dải Màu Này?" },
  { id: "khong-phai-moi-dan-ha-deu-giong-nhau", title: "Không Phải Đan Hà Nào Cũng Giống Nhau" },
  { id: "qicai-va-binggou", title: "Qicai Danxia Và Binggou Danxia" },
  { id: "de-cu-unesco", title: "Đang Được Đề Cử UNESCO" },
  { id: "thoi-diem-dep-nhat", title: "Thời Điểm Đẹp Nhất" },
  { id: "thoi-gian-trong-ngay", title: "Thời Gian Trong Ngày" },
  { id: "nhung-dai-quan-sat", title: "Những Đài Quan Sát Đẹp Nhất" },
  { id: "dan-ha-va-yardang", title: "Đan Hà Và Yardang Khác Nhau Gì?" },
  { id: "dieu-it-nguoi-biet", title: "Điều Ít Người Biết Về Đan Hà" },
  { id: "huong-dan-tham-quan", title: "Hướng Dẫn Tham Quan" },
  { id: "cau-hoi-thuong-gap", title: "Câu Hỏi Thường Gặp" },
  { id: "ket-luan", title: "Kết Luận" }
];

---

<BaseLayout 
  title={seoTitle} 
  description={seoDesc} 
  image={seoImage}
  adminEditUrl={adminEditUrl}
>
  <div class="bg-[#F8F9FA] text-[#1E293B] font-sans antialiased selection:bg-[#c89845] selection:text-white">

    {/* ================= HERO SECTION ================= */}
    <section class="relative w-full h-[600px] lg:h-[650px] overflow-hidden">
      <div class="absolute inset-0 z-0 bg-slate-900">
        <img src={seoImage} alt="Địa Mạo Đan Hà Trương Dịch" class="w-full h-full object-cover object-center opacity-80" fetchpriority="high" loading="eager" />
        <div class="absolute inset-0 bg-gradient-to-r from-black/80 via-black/50 to-transparent"></div>
        <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-transparent to-transparent"></div>
      </div>

      <div class="relative z-10 max-w-[1600px] mx-auto px-4 sm:px-6 lg:px-12 h-full flex flex-col justify-center pt-20 pb-16">
        
        {/* Breadcrumb */}
        <div class="flex items-center gap-2 text-[13px] text-slate-200 font-medium mb-6">
          <a href="/" class="hover:text-white transition-colors">Trang chủ</a>
          <ChevronRight class="w-3 h-3" />
          <a href="/blog" class="hover:text-white transition-colors">Blog</a>
          <ChevronRight class="w-3 h-3" />
          <span class="text-white">Con Đường Tơ Lụa</span>
        </div>

        {/* Titles */}
        <h1 class="font-serif text-4xl sm:text-5xl lg:text-6xl font-bold text-white mb-4 leading-[1.1] drop-shadow-lg max-w-4xl">
          Địa Mạo Đan Hà Trương Dịch: Kỳ Quan Núi Cầu Vồng Ở Cam Túc
        </h1>
        <h2 class="font-serif text-xl sm:text-3xl text-amber-400 italic mb-10 max-w-3xl drop-shadow-md">
          Tuyệt Tác 135 Triệu Năm Tuổi Trên Con Đường Tơ Lụa
        </h2>
        <p class="text-white/90 text-base sm:text-lg max-w-2xl leading-relaxed mb-8 hidden md:block drop-shadow-md font-medium">
          Khám phá những dãy đồi đỏ, cam, vàng, nâu và xám uốn lượn như từng lớp màu được vẽ lên mặt đất, tạo nên khung cảnh hiếm thấy ở bất kỳ nơi nào trên thế giới.
        </p>

        {/* Author Meta */}
        <div class="flex flex-wrap items-center gap-6 text-sm text-white/80 border-t border-white/20 pt-6 max-w-3xl">
          <a href="/huynh-hieu" class="flex items-center gap-3 group">
            <img src="https://media.fittour.vn/uploads/huynhhieutravel.webp" alt="Huynh Hieu" class="w-10 h-10 rounded-full border-2 border-white/30 object-cover object-top group-hover:border-amber-400 transition-colors" />
            <span class="font-bold text-white group-hover:text-amber-400 transition-colors flex items-center gap-1">
              {post.author || 'Huynh Hieu Travel'} 
              <CheckCircle2 class="w-4 h-4 text-blue-400" />
            </span>
          </a>
          <div class="flex items-center gap-2 bg-white/10 px-4 py-2 rounded-full backdrop-blur-sm border border-white/10">
            <Calendar class="w-4 h-4 opacity-70" />
            <span>{datePrefix} {formattedDate}</span>
          </div>
          <div class="flex items-center gap-2 bg-black/20 px-3 py-1.5 rounded-full backdrop-blur-sm">
            <Clock class="w-4 h-4 text-amber-400" />
            <span>10 phút đọc</span>
          </div>
        </div>

        {/* Badges Line */}
        <div class="flex flex-wrap items-center gap-4 mt-8 pt-6">
          <div class="flex items-center gap-2 text-sm text-white font-medium bg-black/60 backdrop-blur-md px-4 py-2 border border-white/10 rounded-lg shadow-xl">
            <span class="text-amber-400 text-lg">🌈</span> Đan Hà Bảy Màu
          </div>
          <div class="flex items-center gap-2 text-sm text-white font-medium bg-black/60 backdrop-blur-md px-4 py-2 border border-white/10 rounded-lg shadow-xl">
            <span class="text-amber-400 text-lg">⏳</span> 135 Triệu Năm
          </div>
          <div class="flex items-center gap-2 text-sm text-white font-medium bg-black/60 backdrop-blur-md px-4 py-2 border border-white/10 rounded-lg shadow-xl">
            <span class="text-amber-400 text-lg">🏆</span> Đề cử UNESCO
          </div>
          <div class="flex items-center gap-2 text-sm text-white font-medium bg-black/60 backdrop-blur-md px-4 py-2 border border-white/10 rounded-lg shadow-xl">
            <span class="text-amber-400 text-lg">🐫</span> Cam Túc
          </div>
        </div>

      </div>
    </section>

    {/* ================= MAIN CONTENT GRID ================= */}
    <div class="max-w-[1600px] mx-auto px-4 sm:px-6 lg:px-12 py-12 lg:py-16">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-start">

        {/* ---------------- LEFT SIDEBAR (TOC) ---------------- */}
        <aside class="hidden lg:block lg:col-span-3 sticky top-24">
          <div class="bg-white rounded-2xl shadow-sm border border-slate-200/60 p-6 overflow-hidden">
            <div class="flex items-center gap-2 font-bold text-slate-800 mb-6 border-l-4 border-amber-500 pl-3 text-sm tracking-wide uppercase">
              Mục lục bài viết
            </div>
            
            <nav class="space-y-1 text-[13.5px] font-medium">
              <a href="#gioi-thieu" class="flex items-center gap-2 text-amber-700 bg-amber-50 px-3 py-2.5 rounded-lg transition-colors font-bold">
                <span class="text-amber-500 text-base">🏠</span> Giới thiệu
              </a>
              
              <div class="pt-2 pb-1">
                <div class="pl-3 pr-3 space-y-1.5 mt-1 border-l border-slate-100 ml-[12px] max-h-[600px] overflow-y-auto custom-scrollbar">
                  {toc.slice(1).map((m, i) => (
                    <a href={`#${m.id}`} class="block text-slate-600 hover:text-amber-600 text-[13.5px] py-1.5 transition-colors leading-tight border-b border-slate-50 last:border-0">
                      {m.title}
                    </a>
                  ))}
                </div>
              </div>
            </nav>
          </div>
        </aside>

        {/* ---------------- CENTER COLUMN (MAIN CONTENT) ---------------- */}
        <main class="col-span-1 lg:col-span-6 space-y-10">
          
          {/* Quick Overview Stats Bar */}
          <div class="bg-white rounded-2xl shadow-sm border border-slate-200/60 p-6 flex flex-wrap lg:flex-nowrap items-center justify-between gap-4">
            
            <div class="w-full flex items-center justify-between gap-4 mb-2 lg:hidden">
              <span class="font-bold text-slate-800 text-sm border-l-4 border-emerald-500 pl-2 uppercase">Tổng Quan Nhanh</span>
            </div>

            <div class="flex items-center gap-3 w-[48%] lg:w-auto">
              <div class="w-10 h-10 rounded-full bg-emerald-50 flex items-center justify-center text-emerald-600 text-xl border border-emerald-100 shrink-0">📍</div>
              <div>
                <div class="text-[11px] text-slate-500 font-medium">Vị trí</div>
                <div class="text-[13px] font-bold text-slate-800">Trương Dịch, Cam Túc</div>
              </div>
            </div>

            <div class="hidden lg:block w-px h-8 bg-slate-200"></div>

            <div class="flex items-center gap-3 w-[48%] lg:w-auto">
              <div class="w-10 h-10 rounded-full bg-amber-50 flex items-center justify-center text-amber-600 text-xl border border-amber-100 shrink-0">🌈</div>
              <div>
                <div class="text-[11px] text-slate-500 font-medium">Nổi bật</div>
                <div class="text-[13px] font-bold text-slate-800">Đồi núi cầu vồng</div>
              </div>
            </div>

            <div class="hidden lg:block w-px h-8 bg-slate-200"></div>

            <div class="flex items-center gap-3 w-[48%] lg:w-auto mt-2 lg:mt-0">
              <div class="w-10 h-10 rounded-full bg-rose-50 flex items-center justify-center text-rose-600 text-xl border border-rose-100 shrink-0">📅</div>
              <div>
                <div class="text-[11px] text-slate-500 font-medium">Thời điểm đẹp nhất</div>
                <div class="text-[13px] font-bold text-slate-800">Tháng 6 - Tháng 10</div>
              </div>
            </div>

            <div class="hidden lg:block w-px h-8 bg-slate-200"></div>

            <div class="flex items-center gap-3 w-[48%] lg:w-auto mt-2 lg:mt-0">
              <div class="w-10 h-10 rounded-full bg-blue-50 flex items-center justify-center text-blue-600 text-xl border border-blue-100 shrink-0">📸</div>
              <div>
                <div class="text-[11px] text-slate-500 font-medium">Giờ vàng nhiếp ảnh</div>
                <div class="text-[13px] font-bold text-slate-800">Bình minh & Hoàng hôn</div>
              </div>
            </div>
          </div>

          {/* Main Article Content */}
          <div class="prose prose-slate max-w-none prose-p:leading-relaxed prose-p:text-[16px] prose-p:text-slate-700 prose-headings:font-serif prose-headings:text-slate-900 prose-strong:text-slate-900">
            
            <div id="gioi-thieu" class="scroll-mt-28">
              <p>Có những nơi khiến người ta phải nghi ngờ vào chính đôi mắt mình, và Địa Mạo Đan Hà Trương Dịch là một trong số đó. Những dãy đồi đỏ, cam, vàng, nâu và xám uốn lượn như từng lớp màu được vẽ lên mặt đất, tạo nên khung cảnh hiếm thấy ở bất kỳ nơi nào trên thế giới. Điều đặc biệt là tất cả đều hoàn toàn tự nhiên, được hình thành qua hơn một trăm triệu năm vận động địa chất.</p>
              <p>Là điểm nhấn nổi bật trên Con đường Tơ Lụa cổ, Địa Mạo Đan Hà ngày nay không chỉ thu hút hàng triệu du khách mỗi năm mà còn là một trong những công viên địa chất quan trọng của Trung Quốc, thuộc <a href="https://www.unesco.org/en/iggp/geoparks/about" target="_blank" rel="noopener noreferrer">UNESCO Global Geopark</a> và đang được đề cử trở thành Di sản Thế giới UNESCO.</p>
            </div>

            <div id="dia-mao-dan-ha-o-dau" class="scroll-mt-28 mt-8">
              <h2 class="text-2xl lg:text-[28px] font-bold border-b-2 border-amber-500 pb-2 inline-block mb-6 !mt-0">Địa Mạo Đan Hà Ở Đâu?</h2>
              <p>Địa Mạo Đan Hà Trương Dịch nằm tại thành phố Trương Dịch (Zhangye), tỉnh Cam Túc, phía Tây Bắc Trung Quốc. Khu vực này thuộc Hành lang Hà Tây (Hexi Corridor) – tuyến giao thương quan trọng nhất trên Con đường Tơ Lụa suốt hơn 2.000 năm.</p>
              <p>Từ trung tâm Trương Dịch, du khách chỉ mất khoảng 40 km để đến khu thắng cảnh Qicai Danxia, nơi nổi tiếng với những dãy "Núi Cầu Vồng". Nếu có nhiều thời gian hơn, nhiều du khách còn kết hợp tham quan Binggou Danxia, khu vực sở hữu các cột đá và vách núi kỳ vĩ được tạo tác bởi thiên nhiên.</p>
              
              <div class="my-6 p-4 bg-slate-50 rounded-xl border border-slate-200 border-l-4 !border-l-amber-500">
                <span class="text-slate-600 font-bold text-sm uppercase tracking-wide mr-2">Đọc thêm:</span>
                <a href="/tac-dong-con-duong-to-lua-den-van-hoa" target="_blank" class="font-bold !text-slate-800 hover:!text-amber-700 transition-colors no-underline hover:underline">Tác động của Con đường Tơ Lụa đến văn hóa Đông Tây</a>
              </div>
              
              <p>Nhờ hệ thống cao tốc và đường sắt cao tốc phát triển, Trương Dịch hiện là điểm dừng phổ biến trong các hành trình khám phá Cam Túc, Gia Dục Quan và Đôn Hoàng.</p>
            </div>

            <div id="vi-sao-goi-la-nui-cau-vong" class="scroll-mt-28 mt-8">
              <h2 class="text-2xl lg:text-[28px] font-bold border-b-2 border-amber-500 pb-2 inline-block mb-6 !mt-0">Vì Sao Địa Mạo Đan Hà Được Gọi Là "Núi Cầu Vồng"?</h2>
              <p>Thực tế, tên gọi Rainbow Mountains không phải là tên chính thức mà là cách truyền thông quốc tế dùng để mô tả những dãy đồi nhiều màu của Trương Dịch. Trong tiếng Trung, khu vực nổi tiếng nhất mang tên Qicai Danxia (七彩丹霞), nghĩa là Đan Hà Bảy Màu.</p>
              <p>Tuy nhiên, "bảy màu" chỉ là một cách gọi mang tính biểu tượng.</p>
              <p>Theo tài liệu của Công viên Địa chất Trương Dịch và hồ sơ đề cử UNESCO, khu vực này sở hữu hơn 30 sắc độ khác nhau, từ đỏ gạch, đỏ sẫm, cam, vàng đất, nâu, xám đến những dải xanh nhạt và tím, tùy thuộc vào thành phần khoáng chất và điều kiện ánh sáng.</p>
              <p>Đó cũng là lý do hai du khách đứng cùng một đài quan sát nhưng vào hai thời điểm khác nhau trong ngày sẽ nhìn thấy những gam màu hoàn toàn khác.</p>
            </div>

            <div id="dieu-gi-tao-nen-dai-mau" class="scroll-mt-28 mt-8">
              <h2 class="text-2xl lg:text-[28px] font-bold border-b-2 border-amber-500 pb-2 inline-block mb-6 !mt-0">Điều Gì Tạo Nên Những Dải Màu Rực Rỡ Này?</h2>
              <p>Nhiều người lầm tưởng những mảng màu rực rỡ của Đan Hà là sản phẩm của phần mềm chỉnh sửa ảnh, nhưng đó hoàn toàn là kiệt tác của thiên nhiên.</p>
              <p>Khoảng 135–96 triệu năm trước, khu vực Trương Dịch là một vùng hồ và đồng bằng rộng lớn. Qua hàng triệu năm, cát, bùn và các khoáng chất được các dòng sông cổ bồi đắp thành những lớp trầm tích dày.</p>
              <p>Sau khi các lớp trầm tích hóa đá, sự va chạm giữa mảng kiến tạo Ấn Độ và Á – quá trình cũng góp phần hình thành <a href="/himalaya/" target="_blank">dãy Himalaya</a> – đã nâng toàn bộ khu vực lên khỏi mặt đất.</p>
              <p>Mưa, gió và sự chênh lệch nhiệt độ tiếp tục bào mòn những lớp đá mềm hơn, để lộ ra từng lớp địa chất với thành phần khoáng vật khác nhau.</p>
              <ul>
                <li><strong>Màu đỏ</strong> chủ yếu đến từ oxit sắt.</li>
                <li><strong>Màu vàng và nâu</strong> hình thành do các hợp chất sắt bị oxy hóa.</li>
                <li><strong>Màu xám</strong> là những lớp đá chứa ít khoáng sắt hơn.</li>
                <li>Một số <strong>dải xanh hoặc tím</strong> xuất hiện nhờ sự hiện diện của mangan và các khoáng vật hiếm.</li>
              </ul>
              <p>Những lớp màu này không nằm trên bề mặt mà xuyên suốt trong cấu trúc đá. Chính vì vậy, dù chịu mưa gió hàng triệu năm, cảnh quan vẫn giữ được vẻ đẹp đặc trưng.</p>
              
              <figure class="my-8">
                <img src="https://media.fittour.vn/uploads/dia-mao-dan-ha-truong-dich-cam-tuc.webp" alt="Khung cảnh Địa Mạo Đan Hà trải dài tại Trương Dịch, Cam Túc" loading="lazy" class="w-full rounded-xl shadow-sm border border-slate-200">
                <figcaption class="text-center text-sm text-slate-500 mt-3 font-medium">Khung cảnh kỳ vĩ của Địa Mạo Đan Hà trải dài tại Trương Dịch, Cam Túc.</figcaption>
              </figure>
            </div>

            <div id="khong-phai-moi-dan-ha-deu-giong-nhau" class="scroll-mt-28 mt-8">
              <h2 class="text-2xl lg:text-[28px] font-bold border-b-2 border-amber-500 pb-2 inline-block mb-6 !mt-0">Không Phải Mọi "Địa Mạo Đan Hà" Đều Giống Nhau</h2>
              <p>"Địa Mạo Đan Hà" không phải tên của một điểm du lịch mà là một loại địa hình. Trung Quốc hiện có nhiều khu vực mang địa mạo Đan Hà như Quảng Đông, Phúc Kiến, Hồ Nam hay Giang Tây.</p>
              <p>Điều khiến Đan Hà Trương Dịch trở nên đặc biệt là sự kết hợp hiếm có giữa:</p>
              <ul>
                <li>Quy mô hàng trăm km².</li>
                <li>Màu sắc địa chất phong phú.</li>
                <li>Địa hình uốn nếp rõ rệt.</li>
                <li>Khả năng quan sát toàn cảnh từ các đài ngắm.</li>
              </ul>
              <p>Chính sự kết hợp này đã giúp Trương Dịch trở thành hình ảnh quen thuộc khi thế giới nhắc đến "Rainbow Mountains of China".</p>
            </div>

            <div id="qicai-va-binggou" class="scroll-mt-28 mt-8">
              <h2 class="text-2xl lg:text-[28px] font-bold border-b-2 border-amber-500 pb-2 inline-block mb-6 !mt-0">Qicai Danxia Và Binggou Danxia Khác Nhau Như Thế Nào?</h2>
              
              <h3 class="text-xl font-bold mt-6">Qicai Danxia</h3>
              <p>Đây là khu vực nổi tiếng nhất và cũng là nơi xuất hiện trong hầu hết các bức ảnh quảng bá.</p>
              <p>Điểm nổi bật là những dãy đồi nhiều màu, các đường vân địa chất rõ nét và hệ thống đài quan sát được bố trí trên cao để ngắm toàn cảnh.</p>
              <p>Nếu chỉ có nửa ngày ở Trương Dịch, đây là nơi nên ưu tiên.</p>
              
              <h3 class="text-xl font-bold mt-6">Binggou Danxia</h3>
              <p>Trong khi đó, Binggou Danxia lại mang một vẻ đẹp hoàn toàn khác.</p>
              <p>Các cột đá, tháp đá và vách núi dựng đứng tạo cảm giác như một thành phố cổ bị bỏ quên giữa sa mạc. Nhiều nhà địa chất đánh giá đây mới là nơi thể hiện rõ nhất quá trình phong hóa của địa mạo Đan Hà.</p>
              <p>Du khách quốc tế thường dành trọn một ngày để khám phá cả hai khu vực, bởi mỗi nơi mang đến một góc nhìn khác nhau về cùng một hệ thống địa chất.</p>
            </div>

            <div id="de-cu-unesco" class="scroll-mt-28 mt-8 bg-amber-50 p-6 rounded-xl border border-amber-100">
              <h2 class="text-2xl lg:text-[28px] font-bold border-b-2 border-amber-500 pb-2 inline-block mb-6 !mt-0">Cập Nhật Mới Nhất: Địa Mạo Đan Hà Đang Được Đề Cử UNESCO</h2>
              <p>Một thông tin đáng chú ý mà nhiều bài viết tiếng Việt vẫn chưa cập nhật là Zhangye Colorful Hills đã được Trung Quốc đưa vào Danh sách Dự kiến Di sản Thế giới UNESCO trong năm 2025.</p>
              <p>Điều này không đồng nghĩa nơi đây đã là Di sản Thế giới, nhưng là bước quan trọng trong quá trình đánh giá quốc tế.</p>
              <p>Song song đó, toàn bộ khu vực Zhangye <a href="https://www.unesco.org/en/iggp/geoparks/about" target="_blank" rel="noopener noreferrer">UNESCO Global Geopark</a> vẫn tiếp tục được UNESCO công nhận là Công viên Địa chất Toàn cầu nhờ giá trị nổi bật về địa chất, nghiên cứu khoa học và giáo dục cộng đồng.</p>
              <p>Sự khác biệt này khá quan trọng, bởi nhiều bài viết hiện nay thường nhầm lẫn giữa hai danh hiệu.</p>
            </div>

            <div id="thoi-diem-dep-nhat" class="scroll-mt-28 mt-8">
              <h2 class="text-2xl lg:text-[28px] font-bold border-b-2 border-amber-500 pb-2 inline-block mb-6 !mt-0">Thời Điểm Đẹp Nhất Để Khám Phá Địa Mạo Đan Hà</h2>
              <p>Địa Mạo Đan Hà mở cửa quanh năm, nhưng mỗi mùa lại mang đến một vẻ đẹp khác nhau. Nếu chỉ có một lần ghé thăm, khoảng thời gian từ tháng 6 đến tháng 10 thường được xem là lý tưởng nhất nhờ thời tiết khô ráo, bầu trời trong và ánh sáng đẹp.</p>
              
              <h3 class="text-xl font-bold mt-6">Mùa xuân (Tháng 4 – Tháng 5)</h3>
              <p>Đây là thời điểm lượng khách chưa quá đông. Nhiệt độ dao động khoảng 15–25°C, khá dễ chịu để tham quan và chụp ảnh.</p>
              <p>Sau những cơn mưa đầu mùa, màu sắc của các lớp đá thường trở nên đậm hơn, tạo cảm giác tương phản rõ nét giữa các dải màu.</p>
              
              <h3 class="text-xl font-bold mt-6">Mùa hè (Tháng 6 – Tháng 8)</h3>
              <p>Đây là mùa cao điểm du lịch tại Cam Túc. Ban ngày trời nắng mạnh nhưng độ ẩm thấp nên không quá oi bức như nhiều nơi ở miền Nam Trung Quốc.</p>
              <p>Những ngày trời quang là thời điểm lý tưởng để ngắm toàn cảnh các dãy Đan Hà dưới bầu trời xanh trong.</p>
              
              <h3 class="text-xl font-bold mt-6">Mùa thu (Tháng 9 – Tháng 10)</h3>
              <p>Đây là mùa được nhiều nhiếp ảnh gia lựa chọn nhất.</p>
              <p>Ánh nắng dịu hơn mùa hè, không khí mát mẻ và bầu trời thường rất trong sau các đợt gió mùa. Khi ánh sáng cuối ngày phủ lên các sườn đồi, những gam đỏ, cam và vàng hiện lên rõ rệt hơn, tạo nên khung cảnh được ví như một bức tranh sơn dầu khổng lồ.</p>
              <p>Đây cũng là thời điểm nhiều hành trình Con đường Tơ Lụa và Cam Túc của FIT TOUR khởi hành.</p>
              
              <div class="my-6 p-4 bg-slate-50 rounded-xl border border-slate-200 border-l-4 !border-l-amber-500">
                <span class="text-slate-600 font-bold text-sm uppercase tracking-wide mr-2">Câu chuyện khách hàng:</span>
                <a href="/cu-ba-u80-kham-pha-con-duong-to-lua" target="_blank" class="font-bold !text-slate-800 hover:!text-amber-700 transition-colors no-underline hover:underline">Cụ bà U80 khám phá Con đường tơ lụa Trung Á cùng FIT TOUR</a>
              </div>
              
              <h3 class="text-xl font-bold mt-6">Mùa đông (Tháng 11 – Tháng 3)</h3>
              <p>Mùa đông mang đến một vẻ đẹp hoàn toàn khác. Tuyết mỏng phủ lên các dải đá nhiều màu tạo nên sự tương phản khá đặc biệt, nhưng nhiệt độ có thể xuống dưới 0°C và một số dịch vụ du lịch hoạt động hạn chế.</p>
              <p>Nếu ưu tiên trải nghiệm cảnh quan và chụp ảnh, mùa thu vẫn là lựa chọn cân bằng nhất.</p>
            </div>

            <div id="thoi-gian-trong-ngay" class="scroll-mt-28 mt-8">
              <h2 class="text-2xl lg:text-[28px] font-bold border-b-2 border-amber-500 pb-2 inline-block mb-6 !mt-0">Thời Gian Trong Ngày Quyết Định 50% Vẻ Đẹp Của Đan Hà</h2>
              <p>Không chỉ mùa trong năm, thời điểm trong ngày cũng ảnh hưởng rất lớn đến trải nghiệm tại Địa Mạo Đan Hà.</p>
              <p>Ánh sáng thay đổi liên tục sẽ mang đến những mảng màu sắc khác nhau, do đó không nên ghé thăm vào giữa trưa nếu bạn muốn có ảnh đẹp.</p>
              
              <ul class="space-y-4 mt-6">
                <li><strong>Bình minh:</strong> Khoảng một giờ sau khi mặt trời mọc, ánh sáng còn dịu và chiếu ngang các sườn đồi, giúp những đường vân địa chất nổi bật hơn. Đây là thời điểm thích hợp để chụp ảnh phong cảnh với màu sắc tự nhiên.</li>
                <li><strong>Giữa trưa:</strong> Ánh sáng gần như chiếu thẳng từ trên xuống. Các lớp màu vẫn rõ nhưng độ tương phản giảm, ảnh dễ bị gắt và ít chiều sâu hơn. Nếu đi vào mùa hè, đây cũng là khoảng thời gian nóng nhất trong ngày.</li>
                <li><strong>Hoàng hôn:</strong> Đây là "giờ vàng" của Địa Mạo Đan Hà. Ánh nắng thấp tạo nên những mảng sáng tối rõ ràng trên từng sườn đồi, khiến các lớp màu trở nên sâu và rực rỡ hơn. Nhiều bức ảnh nổi tiếng về Trương Dịch được chụp trong khoảng một giờ trước khi mặt trời lặn. Nếu có thời gian, hãy dành ít nhất nửa ngày tại công viên để không bỏ lỡ khoảnh khắc này.</li>
              </ul>
            </div>

            <div id="nhung-dai-quan-sat" class="scroll-mt-28 mt-8">
              <h2 class="text-2xl lg:text-[28px] font-bold border-b-2 border-amber-500 pb-2 inline-block mb-6 !mt-0">Những Đài Quan Sát Đẹp Nhất Tại Qicai Danxia</h2>
              <p>Khu thắng cảnh được thiết kế với hệ thống xe buýt nội khu kết nối các đài quan sát chính. Mỗi điểm đều mang đến một góc nhìn khác nhau về địa mạo Đan Hà.</p>
              
              <ul class="space-y-4 mt-6">
                <li><strong>Đài Quan Sát Số 1:</strong> Đây là nơi phù hợp để có cái nhìn tổng quan về các dãy đồi nhiều màu. Địa hình không quá cao nên khá dễ tiếp cận với mọi lứa tuổi.</li>
                <li><strong>Đài Quan Sát Số 2:</strong> Nổi bật với những đường vân địa chất chạy song song như sóng biển. Đây là một trong những góc được các nhiếp ảnh gia yêu thích vào buổi sáng.</li>
                <li><strong>Đài Quan Sát Số 4:</strong> Được xem là điểm ngắm hoàng hôn đẹp nhất của toàn khu. Từ đây có thể quan sát những dãy Đan Hà trải dài đến tận đường chân trời, đặc biệt ấn tượng khi ánh nắng cuối ngày phủ lên các lớp đá đỏ.</li>
              </ul>
              <p class="font-medium mt-4">Nếu chỉ có vài giờ tham quan, nhiều du khách thường ưu tiên đài số 2 và số 4.</p>
            </div>

            <div id="dan-ha-va-yardang" class="scroll-mt-28 mt-8">
              <h2 class="text-2xl lg:text-[28px] font-bold border-b-2 border-amber-500 pb-2 inline-block mb-6 !mt-0">Địa Mạo Đan Hà Và Yardang Có Gì Khác Nhau?</h2>
              <p>Cả hai đều là những cảnh quan địa chất nổi tiếng của Tây Bắc Trung Quốc, nhưng quá trình hình thành hoàn toàn khác nhau.</p>
              
              <div class="overflow-x-auto my-6">
                <table class="w-full text-left border-collapse min-w-[600px]">
                  <thead>
                    <tr class="bg-slate-100 text-slate-800">
                      <th class="p-4 border border-slate-200">Địa Mạo Đan Hà</th>
                      <th class="p-4 border border-slate-200">Yardang</th>
                    </tr>
                  </thead>
                  <tbody>
                    <tr>
                      <td class="p-4 border border-slate-200">Hình thành từ đá sa thạch và đá trầm tích đỏ</td>
                      <td class="p-4 border border-slate-200">Hình thành từ đất sét, bùn và trầm tích mềm</td>
                    </tr>
                    <tr>
                      <td class="p-4 border border-slate-200">Màu sắc phong phú</td>
                      <td class="p-4 border border-slate-200">Chủ yếu xám, nâu hoặc vàng nhạt</td>
                    </tr>
                    <tr>
                      <td class="p-4 border border-slate-200">Địa hình uốn nếp, nhiều lớp màu</td>
                      <td class="p-4 border border-slate-200">Địa hình bị gió bào mòn thành các sống đá và "thành phố ma"</td>
                    </tr>
                    <tr>
                      <td class="p-4 border border-slate-200">Chịu tác động của vận động kiến tạo và phong hóa</td>
                      <td class="p-4 border border-slate-200">Chủ yếu do gió và cát bào mòn trong thời gian dài</td>
                    </tr>
                  </tbody>
                </table>
              </div>
              
              <p>Nếu Địa Mạo Đan Hà được ví như một bức tranh nhiều màu của thiên nhiên, thì Yardang lại giống những công trình điêu khắc khổng lồ được tạo nên bởi gió giữa sa mạc Gobi.</p>
              <p>Chính vì vậy, nhiều hành trình khám phá Cam Túc thường kết hợp cả hai điểm đến để du khách cảm nhận rõ sự đa dạng của cảnh quan địa chất nơi đây.</p>
            </div>

            <div id="dieu-it-nguoi-biet" class="scroll-mt-28 mt-8">
              <h2 class="text-2xl lg:text-[28px] font-bold border-b-2 border-amber-500 pb-2 inline-block mb-6 !mt-0">Một Điều Ít Người Biết Về Địa Mạo Đan Hà</h2>
              <p>Nhiều du khách thường chỉ dừng chân hai đến ba giờ tại Qicai Danxia. Tuy nhiên, nếu đam mê nhiếp ảnh hoặc địa chất, bạn nên dành ít nhất nửa ngày hoặc kết hợp tham quan thêm Binggou Danxia.</p>
              <p>Hai khu vực này tuy cùng thuộc hệ thống Địa Mạo Đan Hà Trương Dịch nhưng mang hai vẻ đẹp hoàn toàn khác nhau. Một bên nổi bật bởi những dải màu rực rỡ, trong khi bên còn lại gây ấn tượng với các cột đá, tháp đá và hẻm núi được điêu khắc qua hàng triệu năm.</p>
              <p>Đó cũng là lý do nhiều người cho rằng chỉ ghé Qicai Danxia là vẫn chưa khám phá trọn vẹn vẻ đẹp của Địa Mạo Đan Hà.</p>
            </div>

            <div id="huong-dan-tham-quan" class="scroll-mt-28 mt-8">
              <h2 class="text-2xl lg:text-[28px] font-bold border-b-2 border-amber-500 pb-2 inline-block mb-6 !mt-0">Hướng Dẫn Tham Quan Địa Mạo Đan Hà Trương Dịch</h2>
              <p>Nhờ hệ thống giao thông ngày càng phát triển ở Cam Túc, việc đến Địa Mạo Đan Hà hiện nay thuận tiện hơn nhiều so với trước đây. Phần lớn du khách sẽ bắt đầu từ Lan Châu, Gia Dục Quan hoặc Đôn Hoàng, sau đó di chuyển bằng tàu cao tốc hoặc ô tô đến thành phố Trương Dịch.</p>
              <p>Từ trung tâm Trương Dịch, khu thắng cảnh Qicai Danxia chỉ cách khoảng 40 km, tương đương 40–60 phút di chuyển bằng xe.</p>
              <p>Nếu đi theo tour, xe sẽ đưa đón tận nơi. Còn với khách du lịch tự túc, có thể lựa chọn xe buýt du lịch hoặc taxi từ ga tàu cao tốc Zhangye West.</p>

              <h3 class="text-xl font-bold mt-6">Nên Dành Bao Nhiêu Thời Gian?</h3>
              <p>Nếu chỉ muốn ngắm cảnh và chụp một vài bức ảnh, khoảng 2–3 giờ là đủ để tham quan các đài quan sát chính của Qicai Danxia. Tuy nhiên, nếu yêu thích nhiếp ảnh hoặc muốn cảm nhận trọn vẹn sự thay đổi của ánh sáng, nên dành ít nhất nửa ngày.</p>
              <p>Trong trường hợp có một ngày trọn vẹn tại Trương Dịch, nhiều du khách lựa chọn kết hợp:</p>
              <ul class="space-y-2 mt-4">
                <li><strong>Buổi sáng</strong> tham quan Binggou Danxia.</li>
                <li><strong>Buổi chiều</strong> khám phá Qicai Danxia và đợi đến hoàng hôn.</li>
              </ul>
              <p>Đây cũng là lịch trình được nhiều nhiếp ảnh gia quốc tế đánh giá là hợp lý nhất.</p>

              <h3 class="text-xl font-bold mt-6">Có Nên Ghé Binggou Danxia Không?</h3>
              <p>Câu trả lời là có, nếu bạn có thêm thời gian.</p>
              <p>Rất nhiều người nghĩ Binggou chỉ là "phiên bản nhỏ" của Qicai Danxia, nhưng thực tế hai nơi gần như không giống nhau.</p>
              <p>Nếu Qicai gây ấn tượng bởi màu sắc thì Binggou lại nổi bật với những cột đá, hẻm núi và các khối đá bị phong hóa thành nhiều hình dạng kỳ lạ. Đây cũng là khu vực yên tĩnh hơn, ít khách hơn và phù hợp với những ai thích khám phá địa chất thay vì chỉ chụp ảnh check-in.</p>

              <h3 class="text-xl font-bold mt-6">Mặc Gì Để Chụp Ảnh Đẹp?</h3>
              <p>Một trong những ưu điểm của Địa Mạo Đan Hà là màu nền rất mạnh. Chỉ cần lựa chọn trang phục phù hợp, bức ảnh sẽ nổi bật hơn đáng kể.</p>
              <p>Những gam màu được nhiều nhiếp ảnh gia lựa chọn gồm: Trắng, Kem, Đỏ rượu, Xanh navy, Đen đơn sắc.</p>
              <p>Ngược lại, nên hạn chế các màu vàng neon hoặc xanh lá cây quá sáng vì dễ hòa lẫn với màu sắc của địa hình.</p>
              <p>Ngoài ra, giày thể thao hoặc giày đi bộ vẫn là lựa chọn phù hợp nhất vì du khách sẽ phải di chuyển giữa các đài quan sát và leo một số đoạn cầu thang.</p>

              <figure class="my-8">
                <img src="https://media.fittour.vn/uploads/gia-dinh-check-in-dia-mao-dan-ha-truong-dich.webp" alt="Gia đình du khách check-in tại Địa Mạo Đan Hà Trương Dịch" loading="lazy" class="w-full rounded-xl shadow-sm border border-slate-200">
                <figcaption class="text-center text-sm text-slate-500 mt-3 font-medium">Gia đình du khách check-in tại một trong những đài quan sát của Địa Mạo Đan Hà Trương Dịch.</figcaption>
              </figure>

              <h3 class="text-xl font-bold mt-6">Có Được Bay Flycam Không?</h3>
              <p>Hiện nay, việc sử dụng flycam tại Địa Mạo Đan Hà được quản lý khá chặt chẽ.</p>
              <p>Một số khu vực cấm hoàn toàn, trong khi những khu vực khác yêu cầu xin phép trước với ban quản lý hoặc cơ quan địa phương.</p>
              <p>Nếu mang theo thiết bị bay không người lái, du khách nên kiểm tra quy định mới nhất trước chuyến đi thay vì tự ý cất cánh để tránh bị xử phạt hoặc tịch thu thiết bị.</p>

              <h3 class="text-xl font-bold mt-6">Một Số Lưu Ý Khi Tham Quan</h3>
              <p>Địa Mạo Đan Hà là khu vực được bảo tồn nghiêm ngặt.</p>
              <p>Du khách chỉ được tham quan trên hệ thống lối đi và đài quan sát đã được xây dựng sẵn. Việc bước xuống các sườn đồi hoặc đi vào khu vực cấm không chỉ ảnh hưởng đến cảnh quan mà còn có thể bị xử phạt.</p>
              <p>Ngoài ra, thời tiết tại Cam Túc có biên độ nhiệt khá lớn giữa ngày và đêm. Ngay cả vào mùa hè, buổi tối vẫn có thể se lạnh, vì vậy một chiếc áo khoác mỏng luôn là vật dụng nên mang theo. Đừng quên chuẩn bị nước uống, kem chống nắng, kính râm và mũ rộng vành, đặc biệt nếu tham quan vào khoảng giữa trưa.</p>

              <h3 class="text-xl font-bold mt-6">Có Nên Ghé Địa Mạo Đan Hà Khi Đi Con Đường Tơ Lụa?</h3>
              <p>Nếu chỉ có thể chọn một thắng cảnh thiên nhiên trên hành trình khám phá Cam Túc, Địa Mạo Đan Hà gần như luôn nằm trong danh sách ưu tiên.</p>
              <p>Khác với Đôn Hoàng nổi bật bởi lịch sử và nghệ thuật Phật giáo, hay Gia Dục Quan gắn liền với Vạn Lý Trường Thành, Trương Dịch mang đến một góc nhìn hoàn toàn khác về miền Tây Bắc Trung Quốc – nơi thiên nhiên đã âm thầm tạo nên một "bảo tàng địa chất ngoài trời" trong suốt hơn 100 triệu năm.</p>
              <p>Chính sự đa dạng đó khiến nhiều hành trình Con đường Tơ Lụa ngày nay không còn chỉ là chuyến đi khám phá lịch sử, mà còn là hành trình cảm nhận những biến đổi kỳ vĩ của Trái Đất qua hàng triệu năm.</p>
              
