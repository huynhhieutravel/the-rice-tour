---
import { env } from 'cloudflare:workers';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { safeQueryCritical } from '@/lib/db-client';
import { getGlobalSettings } from '@/lib/settingsHelper';
import { Clock, Calendar, ChevronRight, CheckCircle2, Shield, Check, Info, AlertTriangle, MapPin, Ticket, Landmark, Compass, Flag, ShieldCheck, Footprints, Sun, Users } from 'lucide-react';
import DataPost from '@/components/shortcodes/data/DataPost.astro';

const d1Db = env?.dulichcoguu_d1;
let post;
try {
  if (d1Db) post = await safeQueryCritical(
    d1Db.prepare("SELECT * FROM Post WHERE slug = ? AND (status = 'published' OR status = 'publish')").bind('thien-an-mon').first<any>(),
    { route: Astro.url.pathname, slug: 'thien-an-mon', queryType: "fetch_post_by_slug" }
  );
} catch (e) {
  // Gracefully fallback if DB error or not created yet
}

// Fallback metadata if post is not yet populated in CMS
if (!post) {
  post = {
    id: 997,
    title: 'Quảng Trường Thiên An Môn Bắc Kinh: Đặt Chỗ, Khung Giờ & Kinh Nghiệm Tham Quan',
    excerpt: 'Kinh nghiệm tham quan Quảng trường Thiên An Môn Bắc Kinh: Hướng dẫn đặt chỗ tên thật qua WeChat mini program, 4 khung giờ tham quan, quy trình an ninh và tuyến kết hợp Tử Cấm Thành.',
    featuredImage: 'https://media.fittour.vn/uploads/duong-pho-bac-kinh-mua-xuan.webp',
    author: 'Huynh Hieu Travel',
    createdAt: '2026-08-19T08:00:00.000Z',
    updatedAt: '2026-08-19T08:00:00.000Z',
    readingTime: 12
  };
}

const { settings } = await getGlobalSettings();

const seoTitle = post.seoTitle || post.title || 'Quảng Trường Thiên An Môn Bắc Kinh: Đặt Chỗ, Khung Giờ & Kinh Nghiệm Tham Quan';
const seoDesc = post.seoDesc || post.excerpt || 'Kinh nghiệm tham quan Quảng trường Thiên An Môn Bắc Kinh: Hướng dẫn đặt chỗ tên thật qua WeChat mini program, 4 khung giờ tham quan, quy trình an ninh và tuyến kết hợp Tử Cấm Thành.';
const seoImage = post.seoImage || post.featuredImage || 'https://media.fittour.vn/uploads/duong-pho-bac-kinh-mua-xuan.webp';

// --- DATE LOGIC ---
const createdAtStr = post.createdAt || post.publishedAt || '2026-08-19T08:00:00.000Z';
const updatedAtStr = post.updatedAt || createdAtStr;

const createdAt = new Date(createdAtStr.replace(' ', 'T'));
const updatedAt = new Date(updatedAtStr.replace(' ', 'T'));

const isUpdated = updatedAt.getTime() - createdAt.getTime() > 86400000; 
const displayDate = isUpdated ? updatedAt : createdAt;
const datePrefix = isUpdated ? "Cập nhật:" : "Xuất bản:";

const formattedDate = displayDate.toLocaleDateString('vi-VN', { day: '2-digit', month: '2-digit', year: 'numeric' });
// ------------------

// --- AUTHOR LOGIC ---
const authorMap: Record<string, any> = {
  "Max Vũ": {
    name: "Max Vũ",
    url: "/max-vu",
    img: "https://media.fittour.vn/uploads/max-vu-founder-fit-tour.webp"
  },
  "Huy Ngô": {
    name: "Huy Ngô",
    url: "/hdv-huy-ngo",
    img: "https://media.fittour.vn/uploads/hdv-huy-ngo-fittour.webp"
  },
  "Huynh Hieu Travel": {
    name: "Huynh Hieu Travel",
    url: "/huynh-hieu",
    img: "https://media.fittour.vn/uploads/huynhhieutravel.webp"
  }
};
const authorData = authorMap[post.author] || authorMap["Huynh Hieu Travel"];
// ------------------

const adminEditUrl = post.id && post.id !== 997 && post.id !== 998 && post.id !== 999 ? `/admin/posts/edit?id=${post.id}` : '#';

// TOC Navigation Structure
const toc = [
  { id: "gioi-thieu", title: "Giới thiệu", icon: "🏠" },
  { id: "thien-an-mon-la-gi", title: "Quảng Trường Thiên An Môn Là Gì?" },
  { id: "thien-an-mon-co-gi", title: "Thiên An Môn Có Gì?" },
  { id: "thap-thien-an-mon", title: "• Tháp Thiên An Môn", indent: true },
  { id: "dai-tuong-niem", title: "• Đài Tưởng Niệm Anh Hùng Nhân Dân", indent: true },
  { id: "nha-tuong-niem-mao-trach-dong", title: "• Nhà Tưởng Niệm Mao Trạch Đông", indent: true },
  { id: "bao-tang-quoc-gia", title: "• Bảo Tàng Quốc Gia Trung Quốc", indent: true },
  { id: "dai-le-duong-nhan-dan", title: "• Đại Lễ Đường Nhân Dân", indent: true },
  { id: "co-can-dat-cho-khong", title: "Có Cần Đặt Chỗ Vào Quảng Trường Không?" },
  { id: "nguoi-viet-nam-dat-cho", title: "Người Việt Nam Đặt Chỗ Thế Nào?" },
  { id: "khong-can-dat-rieng", title: "Trường Hợp Không Cần Đặt Riêng Thiên An Môn" },
  { id: "checkpoint-thien-an-mon", title: "Checkpoint Thiên An Môn: Đi Đúng Cổng" },
  { id: "kiem-tra-an-ninh", title: "Kiểm Tra An Ninh Tại Thiên An Môn" },
  { id: "tu-thien-an-mon-den-tu-cam-thanh", title: "Tuyến Từ Thiên An Môn Đến Tử Cấm Thành" },
  { id: "co-nen-di-cung-ngay", title: "Thiên An Môn & Tử Cấm Thành: Có Nên Đi Cùng Ngày?" },
  { id: "sau-tu-cam-thanh-nen-di-dau", title: "Sau Tử Cấm Thành Nên Đi Đâu? (Núi Cảnh Sơn)" },
  { id: "le-thuong-co", title: "Lễ Thượng Cờ Thiên An Môn Có Đáng Xem?" },
  { id: "thoi-diem-tham-quan", title: "Nên Đi Thiên An Môn Vào Thời Điểm Nào?" },
  { id: "gio-mo-cua", title: "Thiên An Môn Mở Cửa Lúc Mấy Giờ?" },
  { id: "can-mang-gi", title: "Cần Mang Gì Khi Đi Thiên An Môn?" },
  { id: "bao-tang-quoc-gia-co-nen-ket-hop", title: "Bảo Tàng Quốc Gia Có Nên Kết Hợp Không?" },
  { id: "co-dang-di-khong", title: "Quảng Trường Thiên An Môn Có Đáng Đi Không?" },
  { id: "goi-y-lich-trinh", title: "Gợi Ý Lịch Trình Theo Quỹ Thời Gian" },
  { id: "7-dieu-can-nho", title: "7 Điều Cần Nhớ Trước Khi Đi" },
  { id: "faq", title: "Câu Hỏi Thường Gặp (FAQ)" },
  { id: "hanh-trinh-fit-tour", title: "Hành Trình Thiên An Môn Cùng FIT TOUR" }
];
---

<BaseLayout 
  title={seoTitle} 
  description={seoDesc} 
  image={seoImage}
  preloadImages={[seoImage]}
  adminEditUrl={adminEditUrl}
>
  <div class="bg-[#F8F9FA] text-[#1E293B] font-sans antialiased selection:bg-[#F7931E] selection:text-white">

    {/* ================= HERO SECTION ================= */}
    <section class="relative w-full min-h-[580px] lg:min-h-[660px] overflow-hidden flex flex-col justify-center pt-32 pb-20">
      <div class="absolute inset-0 z-0 bg-slate-950">
        <img 
          src={seoImage} 
          alt="Quảng trường Thiên An Môn Bắc Kinh Trung Quốc" 
          class="w-full h-full object-cover object-center opacity-75" 
          width="1920" 
          height="1080"
          fetchpriority="high" 
          loading="eager" 
          decoding="async" 
        />
        <div class="absolute inset-0 bg-gradient-to-r from-black/90 via-black/65 to-black/35"></div>
        <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-transparent to-transparent"></div>
      </div>

      <div class="relative z-10 max-w-[1600px] mx-auto px-4 sm:px-6 lg:px-12 w-full">
        
        {/* Breadcrumb */}
        <div class="flex items-center gap-2 text-[13px] text-white/70 font-medium mb-6">
          <a href="/" class="hover:text-white transition-colors">Trang chủ</a>
          <ChevronRight class="w-3 h-3" />
          <a href="/blog" class="hover:text-white transition-colors">Blog</a>
          <ChevronRight class="w-3 h-3" />
          <span class="text-white font-semibold line-clamp-1">Quảng trường Thiên An Môn</span>
        </div>

        {/* Titles */}
        <h1 class="font-serif text-3xl sm:text-4xl lg:text-5xl xl:text-6xl font-bold text-white mb-4 leading-[1.15] drop-shadow-lg max-w-5xl">
          {post.title}
        </h1>
        <h2 class="font-serif text-lg sm:text-2xl lg:text-3xl text-amber-400 italic mb-8 max-w-4xl drop-shadow-md font-medium">
          Kinh nghiệm đặt chỗ, quy trình an ninh và hướng dẫn kết hợp Tử Cấm Thành
        </h2>
        <p class="text-white/90 text-base sm:text-lg max-w-3xl leading-relaxed mb-8 hidden md:block drop-shadow-md font-normal">
          Quảng trường Thiên An Môn là không gian công cộng mang tính biểu tượng tại trung tâm thủ đô Bắc Kinh, <a href="/country/trung-quoc" class="text-amber-400 hover:text-amber-300 underline underline-offset-4" title="Du lịch Trung Quốc">Trung Quốc</a>. Nơi đây là điểm xuất phát lý tưởng cho tuyến tham quan trục lịch sử Nam – Bắc nối liền với Tử Cấm Thành và Núi Cảnh Sơn.
        </p>

        {/* Author Meta */}
        <div class="flex flex-wrap items-center gap-4 sm:gap-6 text-sm text-white/80 border-t border-white/20 pt-6 max-w-3xl">
          <a href={authorData.url} class="flex items-center gap-3 group">
            <img 
              src={authorData.img} 
              alt={authorData.name} 
              width="40" 
              height="40" 
              class="w-10 h-10 rounded-full border-2 border-white/30 object-cover object-top group-hover:border-amber-400 transition-colors" 
            />
            <span class="font-bold text-white group-hover:text-amber-400 transition-colors flex items-center gap-1">
              {authorData.name} 
              <CheckCircle2 class="w-4 h-4 text-blue-400" />
            </span>
          </a>
          <div class="flex items-center gap-2 bg-white/10 px-4 py-2 rounded-full backdrop-blur-sm border border-white/10">
            <Calendar class="w-4 h-4 opacity-70" />
            <span>{datePrefix} {formattedDate}</span>
          </div>
          <div class="flex items-center gap-2 bg-black/30 px-3 py-1.5 rounded-full backdrop-blur-sm">
            <Clock class="w-4 h-4 text-amber-400" />
            <span>{post.readingTime || 12} phút đọc</span>
          </div>
        </div>

        {/* Badges Line */}
        <div class="flex flex-wrap items-center gap-3 mt-8 pt-4">
          <div class="flex items-center gap-2 text-xs sm:text-sm text-white font-medium bg-black/60 backdrop-blur-md px-3.5 py-2 border border-white/10 rounded-lg shadow-xl">
            <span class="text-amber-400 text-base">📍</span> Trung Tâm Bắc Kinh
          </div>
          <div class="flex items-center gap-2 text-xs sm:text-sm text-white font-medium bg-black/60 backdrop-blur-md px-3.5 py-2 border border-white/10 rounded-lg shadow-xl">
            <span class="text-amber-400 text-base">📐</span> Diện Tích ~440.000 m²
          </div>
          <div class="flex items-center gap-2 text-xs sm:text-sm text-white font-medium bg-black/60 backdrop-blur-md px-3.5 py-2 border border-white/10 rounded-lg shadow-xl">
            <span class="text-amber-400 text-base">🎫</span> Đặt Chỗ Tên Thật Trước 1–9 Ngày
          </div>
          <div class="flex items-center gap-2 text-xs sm:text-sm text-white font-medium bg-black/60 backdrop-blur-md px-3.5 py-2 border border-white/10 rounded-lg shadow-xl">
            <span class="text-amber-400 text-base">🚩</span> Lễ Thượng Cờ & Hạ Cờ Hàng Ngày
          </div>
        </div>

      </div>
    </section>

    {/* ================= MAIN CONTENT GRID ================= */}
    <div class="max-w-[1600px] mx-auto px-4 sm:px-6 lg:px-12 py-12 lg:py-16">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-start">

        {/* ---------------- LEFT SIDEBAR (TOC) ---------------- */}
        <aside class="hidden lg:block lg:col-span-3 sticky top-24">
          <div class="bg-white rounded-2xl shadow-sm border border-slate-200/60 p-6 overflow-hidden">
            <div class="flex items-center gap-2 font-bold text-slate-900 mb-5 border-l-4 border-amber-500 pl-3 text-sm tracking-wide uppercase">
              Mục lục bài viết
            </div>
            
            <nav class="space-y-1 text-[13.5px] font-medium max-h-[calc(100vh-200px)] overflow-y-auto pr-1">
              <a href="#gioi-thieu" class="flex items-center gap-2 text-amber-900 bg-amber-50/80 px-3 py-2 rounded-lg transition-colors font-bold">
                <span class="text-amber-600 text-base">🏠</span> Giới thiệu
              </a>
              
              <div class="pt-1.5 space-y-1 border-l border-slate-200 ml-3 pl-3">
                {toc.slice(1).map((item) => (
                  <a 
                    href={`#${item.id}`} 
                    class={`block transition-colors leading-tight py-1.5 text-slate-600 hover:text-amber-800 ${item.indent ? 'pl-2 text-[12.5px] border-l border-transparent hover:border-amber-400' : 'font-semibold text-[13px]'}`}
                  >
                    {item.title}
                  </a>
                ))}
              </div>
            </nav>
          </div>
        </aside>

        {/* ---------------- CENTER COLUMN (MAIN CONTENT) ---------------- */}
        <main class="col-span-1 lg:col-span-6 space-y-10">
          
          {/* Quick Overview Stats Bar */}
          <div class="bg-white rounded-2xl shadow-sm border border-slate-200/60 p-6 flex flex-wrap lg:flex-nowrap items-center justify-between gap-4">
            
            <div class="w-full flex items-center justify-between gap-4 mb-2 lg:hidden">
              <span class="font-bold text-slate-900 text-sm border-l-4 border-amber-500 pl-2 uppercase">Tổng Quan Nhanh</span>
            </div>

            <div class="flex items-center gap-3 w-[48%] lg:w-auto">
              <div class="w-10 h-10 rounded-full bg-amber-50 flex items-center justify-center text-amber-700 text-xl border border-amber-200/60 shrink-0">📍</div>
              <div>
                <div class="text-[11px] text-slate-500 font-medium">Vị trí</div>
                <div class="text-[13px] font-bold text-slate-900">Trung tâm Bắc Kinh</div>
              </div>
            </div>

            <div class="hidden lg:block w-px h-8 bg-slate-200"></div>

            <div class="flex items-center gap-3 w-[48%] lg:w-auto">
              <div class="w-10 h-10 rounded-full bg-blue-50 flex items-center justify-center text-blue-700 text-xl border border-blue-200/60 shrink-0">📐</div>
              <div>
                <div class="text-[11px] text-slate-500 font-medium">Kích thước</div>
                <div class="text-[13px] font-bold text-slate-900">880m × 500m (~44ha)</div>
              </div>
            </div>

            <div class="hidden lg:block w-px h-8 bg-slate-200"></div>

            <div class="flex items-center gap-3 w-[48%] lg:w-auto mt-2 lg:mt-0">
              <div class="w-10 h-10 rounded-full bg-emerald-50 flex items-center justify-center text-emerald-700 text-xl border border-emerald-200/60 shrink-0">🎫</div>
              <div>
                <div class="text-[11px] text-slate-500 font-medium">Vé vào cửa</div>
                <div class="text-[13px] font-bold text-slate-900">Miễn phí (Cần đặt chỗ)</div>
              </div>
            </div>

            <div class="hidden lg:block w-px h-8 bg-slate-200"></div>

            <div class="flex items-center gap-3 w-[48%] lg:w-auto mt-2 lg:mt-0">
              <div class="w-10 h-10 rounded-full bg-rose-50 flex items-center justify-center text-rose-700 text-xl border border-rose-200/60 shrink-0">🛂</div>
              <div>
                <div class="text-[11px] text-slate-500 font-medium">Giấy tờ</div>
                <div class="text-[13px] font-bold text-slate-900">Hộ chiếu bản gốc</div>
              </div>
            </div>
          </div>

          {/* Intro Text */}
          <div id="gioi-thieu" class="prose prose-slate max-w-none prose-p:leading-relaxed prose-p:text-[16px] prose-p:text-slate-700 space-y-4">
            <p>
              Nhắc tới Bắc Kinh, <strong>Quảng trường Thiên An Môn</strong> gần như là cái tên đầu tiên xuất hiện trong đầu bất kỳ ai. Trái tim của thủ đô Trung Quốc này không chỉ là một khoảng sân khổng lồ, mà còn là "trạm trung chuyển" đưa bạn bước vào trục lịch sử xuyên suốt: từ lầu tháp Thiên An Môn, qua <a href="/tu-cam-thanh" class="text-brand-700 hover:text-brand-800 underline font-medium">Tử Cấm Thành</a> và tiến thẳng đến núi Cảnh Sơn hùng vĩ.
            </p>
            <p>
              Nhưng hãy quên đi khái niệm "thích thì tạt vào" như các quảng trường công cộng khác. Việc đặt chân vào Thiên An Môn hiện nay được vận hành với kỷ luật thép: <strong>đặt vé theo tên thật</strong>, đi đúng <strong>khung giờ</strong>, đúng <strong>cổng an ninh (checkpoint)</strong> và kiểm tra hộ chiếu gắt gao từng bước. Đối với khách quốc tế, nếu không nắm rõ quy trình, bạn rất dễ bị lạc giữa các hàng rào thép hoặc thậm chí bị từ chối vào cửa.
            </p>
            <p>
              Mỗi ngày, hệ thống chia làm 4 khung giờ tham quan khác nhau. Nếu chịu khó dậy sớm, bạn còn có thể săn được suất xem lễ thượng cờ nức tiếng.
            </p>
          </div>

          {/* Image Banner */}
          <figure class="my-8">
            <img 
              src="https://media.fittour.vn/uploads/so-do-quang-truong-thien-an-mon.webp" 
              alt="Sơ đồ Quảng trường Thiên An Môn Bắc Kinh" 
              class="w-full h-auto rounded-2xl shadow-md border border-slate-200 object-cover" 
              width="1280" 
              height="720" 
              loading="lazy" 
            />
            <figcaption class="text-center text-sm text-slate-500 mt-3 italic">
              Sơ đồ tổng quan Quảng trường Thiên An Môn và các công trình xung quanh
            </figcaption>
          </figure>

          {/* Section 1: Quảng Trường Thiên An Môn Là Gì */}
          <section id="thien-an-mon-la-gi" class="scroll-mt-28 space-y-4">
            <div class="border-l-4 border-amber-500 pl-4 mb-4">
              <h2 class="font-serif text-2xl lg:text-[26px] font-bold text-slate-900 leading-tight">
                Quảng Trường Thiên An Môn Là Gì?
              </h2>
            </div>
            
            <div class="text-slate-700 text-[15.5px] leading-relaxed space-y-4">
              <p>
                Nằm chễm chệ ngay đại lộ Trường An giữa lòng Bắc Kinh, Thiên An Môn là một khoảng không gian khổng lồ trải dài <strong>880m từ Bắc xuống Nam</strong> và rộng <strong>500m</strong>. Theo <a href="https://english.beijing.gov.cn/travellinginbeijing/attractions/202603/t20260325_4566110.html" target="_blank" rel="noopener nofollow" class="text-brand-700 hover:text-brand-800 underline font-medium">thông tin chính thức về Quảng trường Thiên An Môn</a> từ chính quyền thành phố, diện tích toàn khu vực lên tới <strong>440.000 m²</strong> (44 hecta). Nơi đây mở cửa <strong>miễn phí</strong> (từ 05:00 đến 22:00 hàng ngày) và rất dễ dàng kết nối qua tuyến Metro Line 1.
              </p>
              <p>
                Quảng trường được bao bọc bởi những công trình bề thế nhất: Tháp Thiên An Môn ở hướng Bắc, Bảo tàng Quốc gia phía Đông và Đại lễ đường Nhân dân ở phía Tây.
              </p>
              <p>
                Đứng giữa quảng trường, bạn giống như đang đứng ở giao lộ của nhiều thời đại. Ngước nhìn về phía Bắc là Tử Cấm Thành cổ kính; quay lưng lại phía Nam là nhịp sống ồn ào của khu phố Tiền Môn; trong khi hai bên Đông – Tây lại là nhịp thở của một Trung Quốc hiện đại.
              </p>
              <p>
                Tuy rộng lớn, nhưng bạn không cần phải dành cả ngày chỉ để quanh quẩn ở đây. Điểm ăn tiền nhất của Thiên An Môn chính là việc nó đóng vai trò "tiền sảnh" hoàn hảo trước khi bạn bước vào cung điện nguy nga của các triều đại Minh – Thanh.
              </p>
            </div>
          </section>

          <hr class="border-slate-200 my-8" />

          {/* Section 2: Thiên An Môn Có Gì */}
          <section id="thien-an-mon-co-gi" class="scroll-mt-28 space-y-6">
            <div class="border-l-4 border-amber-500 pl-4">
              <h2 class="font-serif text-2xl lg:text-[26px] font-bold text-slate-900 leading-tight">
                Thiên An Môn Có Gì? Các Công Trình Xung Quanh Quảng Trường
              </h2>
            </div>

