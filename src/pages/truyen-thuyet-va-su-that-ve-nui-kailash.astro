---
import { env } from 'cloudflare:workers';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { safeQueryCritical } from '@/lib/db-client';
import { getGlobalSettings } from '@/lib/settingsHelper';
import { MapPin, Info, Users, Clock, Calendar, Compass, Share2, Link as LinkIcon, ChevronRight, CheckCircle2 } from 'lucide-react';

const d1Db = env?.dulichcoguu_d1;
if (!d1Db) return Astro.rewrite("/500");

// Fetch CMS Data for SEO and Metadata
let post;
try {
  post = await safeQueryCritical(
    d1Db.prepare(`
      SELECT p.*, u.url as authorUrl, u.avatar as authorAvatar 
      FROM Post p 
      LEFT JOIN "User" u ON p.authorId = u.id 
      WHERE p.slug = ? AND (p.status = 'published' OR p.status = 'publish')
    `).bind('truyen-thuyet-va-su-that-ve-nui-kailash').first<any>(),
    { route: Astro.url.pathname, slug: 'truyen-thuyet-va-su-that-ve-nui-kailash', queryType: "fetch_post_by_slug" }
  );
} catch (e) {
  return Astro.rewrite("/500");
}

if (!post) {
  return Astro.rewrite("/404");
}

const { settings } = await getGlobalSettings();

const seoTitle = post.seoTitle || post.title;
const seoDesc = post.seoDesc || post.excerpt;
const seoImage = post.seoImage || post.featuredImage || 'https://media.fittour.vn/uploads/2025/04/truyen-thuyet-va-su-that-ve-nui-kailash.webp';

// --- DATE LOGIC ---
const createdAtStr = post.createdAt || post.publishedAt || new Date().toISOString();
const updatedAtStr = post.updatedAt || createdAtStr;

const createdAt = new Date(createdAtStr.replace(' ', 'T'));
const updatedAt = new Date(updatedAtStr.replace(' ', 'T'));

const isUpdated = updatedAt.getTime() - createdAt.getTime() > 86400000; 
const displayDate = isUpdated ? updatedAt : createdAt;
const datePrefix = isUpdated ? "Cập nhật:" : "Xuất bản:";

const formattedDate = displayDate.toLocaleDateString('vi-VN', { day: '2-digit', month: '2-digit', year: 'numeric' });
// ------------------

const adminEditUrl = `/admin/posts/edit?id=${post.id}`;
---

<BaseLayout 
  title={seoTitle} 
  description={seoDesc} 
  image={seoImage}
  adminEditUrl={adminEditUrl}
>
  <div class="bg-[#F8F9FA] text-[#1E293B] font-sans antialiased selection:bg-[#c89845] selection:text-white">

    {/* ================= HERO SECTION ================= */}
    <section class="relative w-full h-[600px] lg:h-[650px] overflow-hidden">
      <div class="absolute inset-0 z-0 bg-slate-900">
        <img src={seoImage} alt="Núi Kailash" class="w-full h-full object-cover object-center opacity-80" fetchpriority="high" loading="eager" />
        <div class="absolute inset-0 bg-gradient-to-r from-black/80 via-black/50 to-transparent"></div>
        <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-transparent to-transparent"></div>
      </div>

      <div class="relative z-10 max-w-[1600px] mx-auto px-4 sm:px-6 lg:px-12 h-full flex flex-col justify-center pt-20 pb-16">
        
        {/* Breadcrumb */}
        <div class="flex items-center gap-2 text-[13px] text-white/70 font-medium mb-6">
          <a href="/" class="hover:text-white transition-colors">Trang chủ</a>
          <ChevronRight class="w-3 h-3" />
          <a href="/blog" class="hover:text-white transition-colors">Blog</a>
          <ChevronRight class="w-3 h-3" />
          <span class="text-white">Tây Tạng</span>
        </div>

        {/* Titles */}
        <h1 class="font-serif text-4xl sm:text-5xl lg:text-6xl font-bold text-white mb-4 leading-[1.1] drop-shadow-lg max-w-4xl">
          {post.title}
        </h1>
        <h2 class="font-serif text-xl sm:text-3xl text-amber-400 italic mb-10 max-w-3xl drop-shadow-md">
          {post.excerpt.replace(/<[^>]+>/g, '')}
        </h2>

        {/* Author Meta */}
        <div class="flex flex-wrap items-center gap-6 text-sm text-white/80 border-t border-white/20 pt-6 max-w-3xl">
          <a href={post.authorUrl || "/huynh-hieu"} class="flex items-center gap-3 group">
            <img src={post.authorAvatar || "https://media.fittour.vn/uploads/huynhhieutravel.webp"} alt={post.author || 'Huynh Hieu Travel'} class="w-10 h-10 rounded-full border-2 border-white/30 object-cover object-top group-hover:border-amber-400 transition-colors" />
            <span class="font-bold text-white group-hover:text-amber-400 transition-colors flex items-center gap-1">
              {post.author || 'Huynh Hieu Travel'} 
              <CheckCircle2 class="w-4 h-4 text-blue-400" />
            </span>
          </a>
          <div class="flex items-center gap-2 bg-white/10 px-4 py-2 rounded-full backdrop-blur-sm border border-white/10">
            <Calendar class="w-4 h-4 opacity-70" />
            <span>{datePrefix} {formattedDate}</span>
          </div>
          <div class="flex items-center gap-2 bg-black/20 px-3 py-1.5 rounded-full backdrop-blur-sm">
            <Clock class="w-4 h-4 text-amber-400" />
            <span>10 phút đọc</span>
          </div>
        </div>

        {/* Badges Line */}
        <div class="flex flex-wrap items-center gap-4 mt-8 pt-6">
          <div class="flex items-center gap-2 text-sm text-white font-medium bg-black/60 backdrop-blur-md px-4 py-2 border border-white/10 rounded-lg shadow-xl">
            <span class="text-amber-400 text-lg">🕉️</span> 4 tôn giáo tôn kính
          </div>
          <div class="flex items-center gap-2 text-sm text-white font-medium bg-black/60 backdrop-blur-md px-4 py-2 border border-white/10 rounded-lg shadow-xl">
            <span class="text-amber-400 text-lg">🪷</span> Biểu tượng tâm linh
          </div>
          <div class="flex items-center gap-2 text-sm text-white font-medium bg-black/60 backdrop-blur-md px-4 py-2 border border-white/10 rounded-lg shadow-xl">
            <span class="text-amber-400 text-lg">🏔️</span> Ngọn núi bất khả xâm phạm
          </div>
          <div class="flex items-center gap-2 text-sm text-white font-medium bg-black/60 backdrop-blur-md px-4 py-2 border border-white/10 rounded-lg shadow-xl">
            <span class="text-amber-400 text-lg">📜</span> Hàng nghìn năm truyền thuyết
          </div>
        </div>

      </div>
    </section>

    {/* ================= MAIN CONTENT GRID ================= */}
    <div class="max-w-[1600px] mx-auto px-4 sm:px-6 lg:px-12 py-12 lg:py-16">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-start">

        {/* ---------------- LEFT SIDEBAR (TOC) ---------------- */}
        <aside class="hidden lg:block lg:col-span-3 sticky top-24">
          <div class="bg-white rounded-2xl shadow-sm border border-slate-200/60 p-6 overflow-hidden">
            <div class="flex items-center gap-2 font-bold text-slate-800 mb-6 border-l-4 border-amber-500 pl-3 text-sm tracking-wide uppercase">
              Mục lục bài viết
            </div>
            
            <nav class="space-y-1 text-[13.5px] font-medium max-h-[70vh] overflow-y-auto custom-scrollbar">
              <a href="#an-do-giao" class="flex items-center gap-2 text-slate-700 hover:text-amber-600 px-3 py-2 rounded-lg transition-colors font-bold">
                1. Trong Ấn Độ giáo
              </a>
              <a href="#phat-giao-tay-tang" class="flex items-center gap-2 text-slate-700 hover:text-amber-600 px-3 py-2 rounded-lg transition-colors font-bold mt-1">
                2. Phật giáo Tây Tạng
              </a>
              <a href="#dao-bon" class="flex items-center gap-2 text-slate-700 hover:text-amber-600 px-3 py-2 rounded-lg transition-colors font-bold mt-1">
                3. Trong đạo Bon
              </a>
              
              <a href="#ky-na-giao" class="flex items-center gap-2 text-slate-700 hover:text-amber-600 px-3 py-2 rounded-lg transition-colors font-bold mt-3">
                4. Kỳ Na giáo (Jainism)
              </a>

              <a href="#vi-sao-thieng-lieng" class="flex items-center gap-2 text-slate-700 hover:text-amber-600 px-3 py-2 rounded-lg transition-colors font-bold mt-3 border-t border-slate-100 pt-3">
                5. Vì sao Kailash trở thành ngọn núi thiêng?
              </a>

              <a href="#diem-giao-thoa" class="flex items-center gap-2 text-slate-700 hover:text-amber-600 px-3 py-2 rounded-lg transition-colors font-bold mt-3 border-t border-slate-100 pt-3">
                6. Điểm giao thoa kỳ diệu
              </a>
              
              <a href="#nhung-gia-thuyet" class="flex items-center gap-2 text-slate-700 hover:text-amber-600 px-3 py-2 rounded-lg transition-colors font-bold mt-3">
                7. Những giả thuyết và hiện tượng
              </a>

              <a href="#ket-luan" class="flex items-center gap-2 text-slate-700 hover:text-amber-600 px-3 py-2 rounded-lg transition-colors font-bold mt-3 border-t border-slate-100 pt-3">
                Kết luận
              </a>
            </nav>
          </div>
        </aside>

        {/* ---------------- CENTER COLUMN (MAIN CONTENT) ---------------- */}
        <main class="col-span-1 lg:col-span-6 space-y-10">
          {/* Quick Overview Stats Bar */}
          <div class="bg-white rounded-2xl shadow-sm border border-slate-200/60 p-6 flex flex-wrap lg:flex-nowrap items-center justify-between gap-4">
            <div class="w-full flex items-center justify-between gap-4 mb-2 lg:hidden">
              <span class="font-bold text-slate-800 text-sm border-l-4 border-emerald-500 pl-2 uppercase">Tổng Quan Nhanh</span>
            </div>

            <div class="flex items-center gap-3 w-[48%] lg:w-auto">
              <div class="w-10 h-10 rounded-full bg-amber-50 flex items-center justify-center text-amber-600 text-xl border border-amber-100 shrink-0">🕉️</div>
              <div>
                <div class="text-[13px] font-bold text-slate-800">4 Tôn giáo thiêng liêng</div>
              </div>
            </div>

            <div class="hidden lg:block w-px h-10 bg-slate-200"></div>

            <div class="flex items-center gap-3 w-[48%] lg:w-auto">
              <div class="w-10 h-10 rounded-full bg-blue-50 flex items-center justify-center text-blue-600 text-xl border border-blue-100 shrink-0">🧘</div>
              <div>
                <div class="text-[13px] font-bold text-slate-800">Thần Shiva thiền định</div>
              </div>
            </div>

            <div class="hidden lg:block w-px h-10 bg-slate-200"></div>

            <div class="flex items-center gap-3 w-[48%] lg:w-auto mt-2 lg:mt-0">
              <div class="w-10 h-10 rounded-full bg-rose-50 flex items-center justify-center text-rose-600 text-xl border border-rose-100 shrink-0">🏔️</div>
              <div>
                <div class="text-[13px] font-bold text-slate-800">Trục xoay năng lượng</div>
              </div>
            </div>

            <div class="hidden lg:block w-px h-10 bg-slate-200"></div>

            <div class="flex items-center gap-3 w-[48%] lg:w-auto mt-2 lg:mt-0">
              <div class="w-10 h-10 rounded-full bg-emerald-50 flex items-center justify-center text-emerald-600 text-xl border border-emerald-100 shrink-0">💫</div>
              <div>
                <div class="text-[13px] font-bold text-slate-800">Điểm giao thoa vũ trụ</div>
              </div>
            </div>
          </div>

          <article class="bg-white rounded-3xl p-6 lg:p-10 shadow-sm border border-slate-200/60 relative overflow-hidden">

            <div class="prose prose-slate max-w-none prose-p:leading-relaxed prose-p:text-[15.5px] prose-p:text-slate-700 
                        prose-headings:font-serif prose-headings:text-slate-900 
                        prose-h2:text-[28px] prose-h2:mt-12 prose-h2:mb-6 prose-h2:pb-2 prose-h2:border-b-2 prose-h2:border-amber-500 prose-h2:inline-block
                        prose-h3:text-2xl prose-h3:mt-8 prose-h3:mb-4
                        prose-p:mb-5
                        prose-a:text-amber-600 prose-a:font-semibold prose-a:no-underline hover:prose-a:text-amber-700 hover:prose-a:underline
                        prose-ul:my-6 prose-li:my-2 prose-li:text-slate-700
                        prose-img:rounded-2xl prose-img:shadow-md prose-img:my-10
                        prose-figure:my-10 prose-figcaption:text-center prose-figcaption:text-slate-500 prose-figcaption:italic prose-figcaption:mt-3
                        custom-content">

            <p><strong><a href="/nui-kailash-la-gi" title="Núi Kailash là gì?">Núi Kailash</a></strong> không chỉ nổi tiếng vì vẻ hùng vĩ và kỳ bí, mà còn là <strong>trung tâm tâm linh tối thượng</strong> trong truyền thống của nhiều tôn giáo cổ đại. Mỗi tôn giáo lại nhìn núi Kailash qua một lăng kính riêng – nhưng tất cả đều công nhận đây là <strong>nơi hội tụ giữa con người và thần thánh, giữa đất và trời</strong>.</p>
            
            <figure>
              <img src="https://media.fittour.vn/uploads/2024/07/nui-kailash-mang-y-nghia-tam-linh-lon-voi-nguoi-tay-tang.webp" alt="Núi Kailash mang ý nghĩa tâm linh cực kỳ to lớn với người Tây Tạng" class="w-full h-auto aspect-video object-cover" />
              <figcaption>Núi Kailash mang ý nghĩa tâm linh cực kỳ to lớn với người Tây Tạng</figcaption>
            </figure>
            
            <p>Dưới đây là những <strong>truyền thuyết và sự thật</strong> đáng kinh ngạc về Kailash trong các tôn giáo lớn.</p>

            <h2 id="an-do-giao" class="scroll-mt-28">1. Trong Ấn Độ giáo: Nơi thần Shiva thiền định vĩnh cửu</h2>
            
            <p><strong>Theo truyền thống Hindu</strong>, <strong>núi Kailash</strong> được xem là <strong>nơi ngự trị của <a href="https://vi.wikipedia.org/wiki/Shiva" target="_blank" rel="noreferrer noopener">Thần Shiva</a></strong> – vị thần Hủy diệt và Tái sinh trong bộ 3 quyền lực Trimurti (Brahma – Vishnu – Shiva). Truyền thuyết kể rằng:</p>
            
            <ul>
              <li>Shiva ngồi <strong>thiền định bất động trên đỉnh Kailash</strong>, cùng vợ là <strong><a href="https://vi.wikipedia.org/wiki/Parvati" target="_blank" rel="noreferrer noopener">nữ thần Parvati</a></strong>.</li>
              <li>Đây là nơi phát sinh <strong>dòng năng lượng thiêng liêng</strong> (Shakti) chảy vào thế giới.</li>
              <li>Người Hindu tin rằng <strong><a href="/vi-sao-kora-kailash-lam-thay-doi-cuoc-doi" title="Vì sao Kora Kailash có thể làm thay đổi cuộc đời bạn?">đi vòng quanh Kailash (Parikrama)</a></strong> sẽ giúp rửa sạch nghiệp xấu và đưa linh hồn đến gần moksha – sự giải thoát tối thượng.</li>
            </ul>
            
            <div class="bg-amber-50 border-l-4 border-amber-500 p-4 rounded-r-xl my-6 text-[15px] text-slate-800">
              <strong>Sự thật thú vị:</strong> Đỉnh núi có hình chóp cân xứng tự nhiên thường được ví như biểu tượng <strong>Shiva Linga</strong>, đồng thời cũng mang ý nghĩa tâm linh tượng trưng cho chiếc <strong>trống damaru</strong> – nhạc cụ đánh thức vũ trụ của thần Shiva.
            </div>
            
            <figure>
              <img src="https://media.fittour.vn/uploads/2024/07/nhung-duong-may-phu-tren-dinh-nui.webp" alt="Những đường mây phủ trên đỉnh núi Kailash tựa như năng lượng thiêng liêng" class="w-full h-auto aspect-video object-cover" />
              <figcaption>Những đường mây phủ trên đỉnh núi Kailash tựa như dòng năng lượng thiêng liêng</figcaption>
            </figure>

            <h2 id="phat-giao-tay-tang" class="scroll-mt-28">2. Trong Phật giáo Tây Tạng: Trụ xứ của Phật Đại Lạc</h2>
            
            <p><strong>Theo truyền thống Phật giáo Tây Tạng</strong>, đặc biệt là <strong>Kim Cương thừa</strong>, Kailash được gọi là <strong>Khang Rinpoche</strong>, nghĩa là "Viên ngọc tuyết thiêng".</p>
            
            <ul>
              <li>Đây là <strong>nơi ngự của <a href="https://drukpavietnam.org/chakrasamvara" target="_blank" rel="noreferrer noopener">Phật Chakrasamvara</a> (Cakrasamvara / Demchok)</strong> – biểu tượng của phúc lạc và trí tuệ tối thượng.</li>
              <li>Theo truyền thuyết, <strong>Milarepa</strong>, đại hành giả Tây Tạng, từng thi triển thần lực để chiến thắng các pháp sư Bon giáo tại Kailash, qua đó khẳng định tầm ảnh hưởng của Phật pháp tại vùng đất này.</li>
            </ul>
            
            <div class="bg-amber-50 border-l-4 border-amber-500 p-4 rounded-r-xl my-6 text-[15px] text-slate-800">
              <strong>Sự thật thú vị:</strong> Bản đồ Mạn-đà-la của vũ trụ trong Phật giáo Tây Tạng đặt <strong>núi Kailash ở trung tâm</strong>, như biểu tượng của <strong>trí tuệ giác ngộ tuyệt đối</strong>.
            </div>
            
            <figure>
              <img src="https://media.fittour.vn/uploads/2024/07/nhung-la-co-lungta-duoc-treo-nhieu-noi-tren-duong-hanh-huong.webp" alt="Những lá cờ Lungta đầy sắc màu rực rỡ treo trên dọc đường hành hương" class="w-full h-auto aspect-video object-cover" />
              <figcaption>Những lá cờ Lungta đầy sắc màu rực rỡ tung bay dọc đường hành hương</figcaption>
            </figure>

            <h2 id="dao-bon" class="scroll-mt-28">3. Trong đạo Bon: Núi Kailash có trước cả Phật giáo</h2>
            
            <p>Đạo <strong>Bon</strong> là tín ngưỡng bản địa Tây Tạng, có trước Phật giáo. <strong>Theo tín ngưỡng Bon</strong>:</p>
            
            <ul>
              <li>Kailash là <strong>nơi cư ngụ của thần Sipaimen</strong> – vị thần chiến tranh và linh hồn.</li>
              <li>Người Bon thực hiện nghi lễ <strong>Kora vòng ngược chiều kim đồng hồ</strong>, khác với các tín ngưỡng khác.</li>
            </ul>
            
            <div class="bg-amber-50 border-l-4 border-amber-500 p-4 rounded-r-xl my-6 text-[15px] text-slate-800">
              <strong>Sự thật thú vị:</strong> Nhiều nhà nghiên cứu văn hóa cho rằng truyền thống <strong>đi vòng quanh núi (Kora)</strong> có thể bắt nguồn từ các nghi lễ của tín ngưỡng Bon bản địa, xuất hiện từ rất lâu trước khi Phật giáo truyền vào Tây Tạng.
            </div>
            
            <figure>
              <img src="https://media.fittour.vn/uploads/2024/07/nhung-vien-da-duoc-dieu-khac-cac-ky-hieu-rieng-biet-cua-nguoi-tay-tang.webp" alt="Những viên đá Mani được điêu khắc linh thiêng dọc đường Kora" class="w-full h-auto aspect-video object-cover" />
              <figcaption>Những viên đá Mani được điêu khắc linh thiêng mang lời nguyện cầu của tín đồ</figcaption>
            </figure>
            
            <h2 id="ky-na-giao" class="scroll-mt-28">4. Trong Kỳ Na giáo (Jainism): Nơi đạt giải thoát đầu tiên</h2>
            
            <p><strong>Theo truyền thống Kỳ Na giáo</strong>, <strong>Tirthankara Rishabhdev</strong> – vị thầy đầu tiên trong 24 vị tôn sư – đã <strong>đạt giác ngộ và moksha tại Kailash</strong>, nơi gọi là <strong>Ashtapada</strong>.</p>
            
            <ul>
              <li>Tín đồ Kỳ Na giáo tin rằng Kailash là <strong>đỉnh thiêng tối cao</strong>, nơi <strong>cắt đứt mọi ràng buộc vật chất</strong>.</li>
            </ul>
            
            <div class="bg-amber-50 border-l-4 border-amber-500 p-4 rounded-r-xl my-6 text-[15px] text-slate-800">
              <strong>Sự thật thú vị:</strong> Đỉnh núi từng được ghi lại trong các văn bản cổ Kỳ Na giáo như nơi đầu tiên con người đạt giải thoát thực sự.
            </div>
            
            <figure>
              <img src="https://media.fittour.vn/uploads/2024/07/du-khach-dung-chan-chup-anh-cung-cac-chu-ngua-nui-tu-di.webp" alt="Du khách nghỉ chân cùng những chú ngựa thồ trên cung đường Kora khắc nghiệt" class="w-full h-auto aspect-video object-cover" />
              <figcaption>Du khách nghỉ chân cùng những chú ngựa thồ trên cung đường Kora khắc nghiệt</figcaption>
            </figure>
            
            <h2 id="vi-sao-thieng-lieng" class="scroll-mt-28">5. Vì sao Kailash trở thành ngọn núi thiêng của nhiều tôn giáo?</h2>
            
            <p>Việc 4 tôn giáo lớn cùng tôn kính chung một ngọn núi không phải là sự ngẫu nhiên. Kailash hội tụ những yếu tố địa lý và văn hóa đặc biệt để trở thành trung tâm tâm linh:</p>
            
            <ul>
              <li><strong>Vị trí đầu nguồn bốn con sông lớn:</strong> Kailash là khởi nguồn của 4 dòng sông huyết mạch châu Á là Brahmaputra, Indus, Sutlej và Karnali. Trong quan niệm cổ đại, ngọn núi sinh ra nguồn nước tự nhiên chính là Mẹ của sự sống.</li>
              <li><strong>Nổi bật giữa cao nguyên:</strong> Với hình chóp cân xứng hoàn hảo, đứng sừng sững đơn độc giữa cao nguyên Tây Tạng bao la, Kailash tựa như một cầu nối tự nhiên giữa mặt đất và bầu trời.</li>
              <li><strong>Trung tâm giao thương cổ:</strong> Khu vực quanh núi từng là ngã tư đường của những tuyến đường giao thương cổ đại giữa Ấn Độ, Nepal và Tây Tạng, giúp giao thoa các luồng tư tưởng tôn giáo và văn hóa.</li>
              <li><strong>Biểu tượng vũ trụ học:</strong> Hình dáng núi Kailash khớp hoàn hảo với khái niệm <a href="/nui-kailash-la-gi" class="text-amber-600 hover:text-amber-700 font-semibold" title="Núi Kailash là gì? Vì sao nơi đây được gọi là Trục vũ trụ của thế giới">"Trục vũ trụ" (Axis Mundi) hay núi Tu Di (Mount Meru)</a> trong vũ trụ học cổ đại của phương Đông.</li>
            </ul>

            <figure>
              <img src="https://media.fittour.vn/uploads/2024/07/nhung-chu-bo-yak-an-co-tren-thao-nguyen-tren-duong-kora-kailash.webp" alt="Những chú bò Yak thong dong trên thảo nguyên dưới chân núi Kailash" class="w-full h-auto aspect-video object-cover" />
              <figcaption>Những chú bò Yak thong dong trên thảo nguyên hùng vĩ dưới chân núi Kailash</figcaption>
            </figure>

            <h2 id="diem-giao-thoa" class="scroll-mt-28">6. Những điểm giao thoa kỳ diệu giữa các tôn giáo</h2>
            
            <p>Dù mỗi tôn giáo có quan niệm khác nhau, <strong>có một số điểm kỳ lạ trùng hợp</strong>:</p>
            
            <ul>
              <li>Tất cả đều xem <strong>núi Kailash là trung tâm vũ trụ tâm linh</strong>.</li>
              <li>Các nghi lễ đi vòng quanh núi đều nhằm <strong>giải nghiệp, đạt sự thanh lọc và giác ngộ</strong>.</li>
              <li>Không ai dám hoặc được phép <strong>chinh phục đỉnh Kailash</strong> – như một <strong>biểu tượng của sự bất khả xâm phạm</strong>.</li>
            </ul>
            
            <figure>
              <img src="https://media.fittour.vn/uploads/2024/08/ban-do-cung-duong-kora-nui-kailash-tay-tang.webp" alt="Bản đồ cung đường Kora Kailash Tây Tạng" class="w-full h-auto aspect-video object-cover" />
              <figcaption>Bản đồ cung đường Kora quanh núi Kailash dài 52km mà mọi tôn giáo đều đi qua</figcaption>
            </figure>

            <h2 id="nhung-gia-thuyet" class="scroll-mt-28">7. Những giả thuyết và hiện tượng thường được nhắc đến</h2>
            
            <p>Một số giả thuyết trên internet cho rằng xung quanh ngọn núi này có những bí ẩn chưa thể lý giải, tuy nhiên <strong>cho đến nay chưa có bằng chứng khoa học được chấp nhận rộng rãi xác nhận những giả thuyết này:</strong></p>

            <p><strong>Trục xoay năng lượng</strong>: Một số giả thuyết phổ biến cho rằng Kailash nằm tại giao điểm của các dòng năng lượng Trái Đất, tạo nên từ trường bất thường.</p>
            
            <p><strong>Hiện tượng “thời gian khác biệt”</strong>: Một số người hành hương kể lại rằng họ cảm thấy <strong>mất khái niệm về thời gian</strong>, thậm chí cảm thấy tóc và móng tay mọc nhanh hơn bình thường sau <a href="/nhat-ky-hanh-trinh-hanh-huong-nui-kailash" title="Nhật ký hành trình hành hương núi Kailash Tây Tạng">hành trình quanh Kailash</a>.</p>
            
            <figure>
              <img src="https://media.fittour.vn/uploads/2024/07/hanh-trinh-hanh-huong-bang-qua-nhieu-dia-hinh-khac-nhau.webp" alt="Hành trình hành hương băng qua nhiều địa hình khác nhau" class="w-full h-auto aspect-video object-cover" />
              <figcaption>Hành trình hành hương băng qua nhiều địa hình khác nhau</figcaption>
            </figure>

            <h2 id="ket-luan" class="scroll-mt-28">Kết luận: Huyền thoại sống giữa đời thực</h2>
            
            <p>Dù tiếp cận dưới góc độ tôn giáo, lịch sử hay văn hóa, <strong>Kailash vẫn là một trong số rất ít địa danh trên thế giới được nhiều truyền thống tín ngưỡng cùng tôn kính qua hàng nghìn năm</strong>.</p>
            
            <p><strong>Núi Kailash không chỉ là một địa điểm địa lý</strong>, mà còn là <strong>biểu tượng sống động của đức tin, của điều thiêng liêng vượt qua mọi biên giới tôn giáo</strong>. Những truyền thuyết và sự thật bao quanh ngọn núi này vẫn là ẩn số – nhưng với hàng triệu <a href="/thong-tin-can-biet-hanh-huong-nui-kailash" title="Thông tin cần biết khi hành hương núi Kailash">người hành hương</a>, <strong>Kailash là nơi con người chạm đến linh hồn vũ trụ</strong>.</p>
            
            <figure>
              <img src="https://media.fittour.vn/uploads/2024/07/doan-dung-chan-o-cot-moc-duong-cao-toc-219-tam-biet-kailash.webp" alt="Đoàn hành hương check-in tại cột mốc quốc lộ 219, đánh dấu chặng đường thiêng liêng" class="w-full h-auto aspect-video object-cover" />
              <figcaption>Đoàn hành hương check-in tại cột mốc quốc lộ 219, đánh dấu một chặng đường thiêng liêng trọn vẹn</figcaption>
            </figure>

