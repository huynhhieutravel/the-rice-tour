---
import V2Layout from '@/layouts/V2Layout.astro';
import Header from '@/components/layout/header/default/Header.astro';
import V2Footer from '@/components/v2/V2Footer.astro';
import { env } from 'cloudflare:workers';

const slug = '800-hanh-trinh-cung-fit-tour';
let postData: any = null;
let adminEditUrl = "";

try {
  const d1Db = env?.dulichcoguu_d1 || (Astro.locals as any)?.runtime?.env?.dulichcoguu_d1;
  if (d1Db) {
    postData = await d1Db.prepare("SELECT * FROM Post WHERE slug = ? LIMIT 1").bind(slug).first();
    if (postData && postData.id) {
      adminEditUrl = `/admin/posts/edit?id=${postData.id}`;
    } else {
      const pageData: any = await d1Db.prepare("SELECT * FROM Page WHERE slug = ? LIMIT 1").bind(slug).first();
      if (pageData && pageData.id) {
        postData = pageData;
        adminEditUrl = `/admin/pages/edit?id=${pageData.id}`;
      }
    }
  }
} catch (err) {
  console.log("CMS fetch error:", err);
}

const seoTitle = postData?.seoTitle || postData?.title || "800+ Hành Trình Cùng FIT TOUR | 6 Năm Đi, Trải Nghiệm Và Không Ngừng Hoàn Thiện";
const seoDesc = postData?.seoDescription || postData?.excerpt || postData?.description || "6 năm qua, FIT TOUR không ngừng khảo sát, thử nghiệm và quay trở lại những vùng đất đã đi qua. Mỗi hành trình được điều chỉnh từ những trải nghiệm thực tế.";
const featuredImage = postData?.featuredImage || "https://media.fittour.vn/uploads/2022/09/binh-minh-tren-day-nui-himalayas.webp";
---

<V2Layout 
  title={seoTitle} 
  description={seoDesc} 
  image={featuredImage} 
  canonical="https://thericetour.com/800-hanh-trinh-cung-fit-tour"
  adminEditUrl={adminEditUrl}
>
  <Fragment slot="header">
    <Header />
  </Fragment>

  <main class="bg-[#0a0a0a] text-white overflow-hidden">
    
    <!-- ==============================================
         ACT I - WHY
         ============================================== -->
    
    <!-- SECTION 01: HERO -->
    <section class="relative w-full min-h-screen flex items-center justify-center pt-32 pb-20">
      <div class="absolute inset-0 z-0">
        <img src="https://media.fittour.vn/uploads/2022/02/nui-himalaya.webp" alt="800+ Journeys" width="1920" height="1080" class="w-full h-full object-cover opacity-40 mix-blend-overlay" />
        <div class="absolute inset-0 bg-gradient-to-b from-[#0a0a0a] via-[#0a0a0a]/60 to-[#0a0a0a]"></div>
      </div>
      
      <div class="relative z-10 w-full max-w-[1200px] mx-auto px-6 md:px-12 text-center">
        <div class="font-mono text-[10px] md:text-xs text-[#c5a365] tracking-[0.3em] uppercase font-bold mb-8">
          ★ 6 YEARS OF CRAFTING JOURNEYS ★
        </div>
        <h1 class="font-serif text-white text-4xl sm:text-5xl md:text-7xl lg:text-8xl font-bold tracking-wider uppercase mb-6 drop-shadow-xl leading-tight">
          800+ Hành Trình<br/>Cùng FIT TOUR
        </h1>
        <h2 class="font-sans text-lg sm:text-xl md:text-2xl text-white/90 font-light tracking-widest uppercase mb-10">
          6 Năm Đi, Trải Nghiệm Và Không Ngừng Hoàn Thiện
        </h2>
        <p class="font-sans text-white/70 text-sm sm:text-base md:text-lg max-w-3xl mx-auto leading-relaxed mb-12 text-justify md:text-center">
          6 năm qua, FIT TOUR không ngừng khảo sát, thử nghiệm và quay trở lại những vùng đất đã đi qua. Mỗi hành trình được điều chỉnh từ những trải nghiệm thực tế, để mỗi chuyến đi không chỉ khác biệt trên giấy, mà khác biệt khi bạn thực sự đặt chân đến.
        </p>
        
        <div class="font-['Great_Vibes'] text-[#c5a365] text-4xl md:text-6xl mb-16 [text-shadow:_0_2px_8px_rgba(0,0,0,0.9)]">
          Beyond Ordinary Journeys.
        </div>
        
        <div class="flex flex-col sm:flex-row items-center justify-center gap-6">
          <a href="#triet-ly" class="px-8 py-4 bg-[#c5a365] text-black font-bold uppercase tracking-widest text-xs hover:bg-white transition-colors duration-300 w-full sm:w-auto">
            Khám Phá Hành Trình
          </a>
          <a href="/tour" class="px-8 py-4 border border-[#c5a365] text-[#c5a365] font-bold uppercase tracking-widest text-xs hover:bg-[#c5a365] hover:text-black transition-colors duration-300 w-full sm:w-auto">
            Xem Hành Trình Đã Đi Qua
          </a>
        </div>
      </div>
    </section>

    <!-- SECTION 02: THE PROOF (NHỮNG CON SỐ KỂ CHUYỆN) -->
    <section class="py-24 border-t border-white/5 relative">
      <div class="max-w-[1440px] mx-auto px-6 md:px-12 text-center">
        <h2 class="font-serif text-2xl md:text-4xl text-white tracking-widest uppercase mb-6">
          6 NĂM ĐƯỢC ĐO BẰNG NHỮNG HÀNH TRÌNH
        </h2>
        <p class="text-white/60 text-sm md:text-base max-w-2xl mx-auto mb-16">
          Không phải những con số để làm đẹp một brochure. Đây là những cột mốc được tạo nên từ những chuyến đi thực tế.
        </p>

        <div class="grid grid-cols-2 md:grid-cols-4 gap-8 md:gap-12 mb-16">
          <div class="flex flex-col items-center">
            <span class="font-serif text-5xl md:text-7xl text-[#c5a365] mb-4">800+</span>
            <span class="font-bold text-xs tracking-widest uppercase mb-2">Hành Trình Đã Thực Hiện</span>
            <span class="text-white/50 text-[10px] md:text-xs">Những hành trình FIT TOUR trực tiếp tổ chức và vận hành.</span>
          </div>
          <div class="flex flex-col items-center">
            <span class="font-serif text-5xl md:text-7xl text-[#c5a365] mb-4">13K+</span>
            <span class="font-bold text-xs tracking-widest uppercase mb-2">Travel Mates</span>
            <span class="text-white/50 text-[10px] md:text-xs">Những người đã đồng hành trên nhiều cung đường.</span>
          </div>
          <div class="flex flex-col items-center">
            <span class="font-serif text-5xl md:text-7xl text-[#c5a365] mb-4">53+</span>
            <span class="font-bold text-xs tracking-widest uppercase mb-2">Vùng & Quốc Gia</span>
            <span class="text-white/50 text-[10px] md:text-xs">Từ điểm đến quen thuộc đến vùng đất hẻo lánh.</span>
          </div>
          <div class="flex flex-col items-center">
            <span class="font-serif text-5xl md:text-7xl text-[#c5a365] mb-4">6</span>
            <span class="font-bold text-xs tracking-widest uppercase mb-2">Năm Lên Đường</span>
            <span class="text-white/50 text-[10px] md:text-xs">Kinh nghiệm tích lũy từ thực địa, không từ catalogue.</span>
          </div>
        </div>

        <div class="inline-block border border-[#c5a365]/30 px-8 py-4 bg-[#c5a365]/5 mb-12">
          <p class="font-serif italic text-lg text-[#c5a365]">
            "Con số lớn nhất không nằm trên bảng thống kê. Nó nằm trong kinh nghiệm được tích lũy sau mỗi lần lên đường."
          </p>
        </div>

        <!-- Horizontal Scroll Journey Gallery -->
        <div class="relative group/slider mt-4">
          <!-- Navigation buttons for desktop -->
          <button id="galleryPrevBtn" aria-label="Xem trước" class="absolute -left-4 md:-left-6 top-1/2 -translate-y-1/2 z-20 w-12 h-12 rounded-full bg-[#111]/90 backdrop-blur-md border border-white/20 text-white hover:border-[#c5a365] hover:text-[#c5a365] transition-all hidden md:flex items-center justify-center shadow-2xl hover:scale-105 active:scale-95">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
          </button>
          
          <button id="galleryNextBtn" aria-label="Xem tiếp theo" class="absolute -right-4 md:-right-6 top-1/2 -translate-y-1/2 z-20 w-12 h-12 rounded-full bg-[#111]/90 backdrop-blur-md border border-white/20 text-white hover:border-[#c5a365] hover:text-[#c5a365] transition-all hidden md:flex items-center justify-center shadow-2xl hover:scale-105 active:scale-95">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
          </button>

          <div id="journeyGallerySlider" class="flex overflow-x-auto snap-x snap-mandatory gap-5 pb-6 pt-2 hide-scrollbar cursor-grab active:cursor-grabbing text-left scroll-smooth select-none" style="-ms-overflow-style: none; scrollbar-width: none;">
            
            <div class="shrink-0 w-[280px] sm:w-[320px] md:w-[360px] snap-start bg-[#111] rounded-2xl overflow-hidden border border-white/10 group cursor-pointer hover:border-[#c5a365]/50 transition-all duration-500 flex flex-col">
              <div class="relative aspect-[16/10] overflow-hidden">
                <img src="https://media.fittour.vn/uploads/fit-tour-chinh-phuc-song-bang-bang-truc-thang-alaska.webp" alt="Alaska" width="600" height="375" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 pointer-events-none" loading="lazy" />
                <div class="absolute top-3 left-3 bg-black/80 backdrop-blur-md px-3 py-1 text-[10px] text-white font-mono font-bold uppercase tracking-widest rounded-full border border-white/10">ALASKA • BẮC MỸ</div>
              </div>
              <div class="p-5 flex-grow flex flex-col justify-between">
                <h3 class="text-white/90 text-sm font-bold leading-snug group-hover:text-[#c5a365] transition-colors">Chinh phục sông băng bằng trực thăng tại Alaska</h3>
              </div>
            </div>

            <div class="shrink-0 w-[280px] sm:w-[320px] md:w-[360px] snap-start bg-[#111] rounded-2xl overflow-hidden border border-white/10 group cursor-pointer hover:border-[#c5a365]/50 transition-all duration-500 flex flex-col">
              <div class="relative aspect-[16/10] overflow-hidden">
                <img src="https://media.fittour.vn/uploads/2024/04/doan-du-khach-fit-tour-don-cuc-quang-o-iceland.webp" alt="Iceland" width="600" height="375" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 pointer-events-none" loading="lazy" />
                <div class="absolute top-3 left-3 bg-black/80 backdrop-blur-md px-3 py-1 text-[10px] text-white font-mono font-bold uppercase tracking-widest rounded-full border border-white/10">ICELAND • CHÂU ÂU</div>
              </div>
              <div class="p-5 flex-grow flex flex-col justify-between">
                <h3 class="text-white/90 text-sm font-bold leading-snug group-hover:text-[#c5a365] transition-colors">Đoàn du khách FIT Tour săn cực quang huyền diệu ở Iceland</h3>
              </div>
            </div>

            <div class="shrink-0 w-[280px] sm:w-[320px] md:w-[360px] snap-start bg-[#111] rounded-2xl overflow-hidden border border-white/10 group cursor-pointer hover:border-[#c5a365]/50 transition-all duration-500 flex flex-col">
              <div class="relative aspect-[16/10] overflow-hidden">
                <img src="https://media.fittour.vn/uploads/2023/01/doan-khach-fit-tour-check-in-o-luxor.webp" alt="Luxor" width="600" height="375" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 pointer-events-none" loading="lazy" />
                <div class="absolute top-3 left-3 bg-black/80 backdrop-blur-md px-3 py-1 text-[10px] text-white font-mono font-bold uppercase tracking-widest rounded-full border border-white/10">LUXOR • AI CẬP</div>
              </div>
              <div class="p-5 flex-grow flex flex-col justify-between">
                <h3 class="text-white/90 text-sm font-bold leading-snug group-hover:text-[#c5a365] transition-colors">Đoàn khách FIT Tour khám phá đền thờ cổ kính Luxor</h3>
              </div>
            </div>

            <div class="shrink-0 w-[280px] sm:w-[320px] md:w-[360px] snap-start bg-[#111] rounded-2xl overflow-hidden border border-white/10 group cursor-pointer hover:border-[#c5a365]/50 transition-all duration-500 flex flex-col">
              <div class="relative aspect-[16/10] overflow-hidden">
                <img src="https://media.fittour.vn/uploads/toan-canh-ekip-fit-tour-an-mung-ky-luc-guinness-tai-deo-umling-la.webp" alt="Umling La" width="600" height="375" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 pointer-events-none" loading="lazy" />
                <div class="absolute top-3 left-3 bg-black/80 backdrop-blur-md px-3 py-1 text-[10px] text-white font-mono font-bold uppercase tracking-widest rounded-full border border-white/10">UMLING LA • 5883M</div>
              </div>
              <div class="p-5 flex-grow flex flex-col justify-between">
                <h3 class="text-white/90 text-sm font-bold leading-snug group-hover:text-[#c5a365] transition-colors">Ăn mừng kỷ lục Guinness tại đèo cao nhất thế giới Umling La</h3>
              </div>
            </div>

            <div class="shrink-0 w-[280px] sm:w-[320px] md:w-[360px] snap-start bg-[#111] rounded-2xl overflow-hidden border border-white/10 group cursor-pointer hover:border-[#c5a365]/50 transition-all duration-500 flex flex-col">
              <div class="relative aspect-[16/10] overflow-hidden">
                <img src="https://media.fittour.vn/uploads/doan-khach-check-in-ho-pangong.webp" alt="Pangong" width="600" height="375" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 pointer-events-none" loading="lazy" />
                <div class="absolute top-3 left-3 bg-black/80 backdrop-blur-md px-3 py-1 text-[10px] text-white font-mono font-bold uppercase tracking-widest rounded-full border border-white/10">PANGONG TSO • LADAKH</div>
              </div>
              <div class="p-5 flex-grow flex flex-col justify-between">
                <h3 class="text-white/90 text-sm font-bold leading-snug group-hover:text-[#c5a365] transition-colors">Check-in hồ xanh ngọc bích Pangong Tso giữa tuyết sơn</h3>
              </div>
            </div>

            <div class="shrink-0 w-[280px] sm:w-[320px] md:w-[360px] snap-start bg-[#111] rounded-2xl overflow-hidden border border-white/10 group cursor-pointer hover:border-[#c5a365]/50 transition-all duration-500 flex flex-col">
              <div class="relative aspect-[16/10] overflow-hidden">
                <img src="https://media.fittour.vn/uploads/2024/08/doan-khach-fit-tour-tham-quan-hanh-trinh-bhutan-trong-chuyen-bay-thang.webp" alt="Bhutan" width="600" height="375" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 pointer-events-none" loading="lazy" />
                <div class="absolute top-3 left-3 bg-black/80 backdrop-blur-md px-3 py-1 text-[10px] text-white font-mono font-bold uppercase tracking-widest rounded-full border border-white/10">PARO • BHUTAN</div>
              </div>
              <div class="p-5 flex-grow flex flex-col justify-between">
                <h3 class="text-white/90 text-sm font-bold leading-snug group-hover:text-[#c5a365] transition-colors">Trải nghiệm chuyến bay thẳng độc quyền đến vương quốc Bhutan</h3>
              </div>
            </div>

            <div class="shrink-0 w-[280px] sm:w-[320px] md:w-[360px] snap-start bg-[#111] rounded-2xl overflow-hidden border border-white/10 group cursor-pointer hover:border-[#c5a365]/50 transition-all duration-500 flex flex-col">
              <div class="relative aspect-[16/10] overflow-hidden">
                <img src="https://media.fittour.vn/uploads/2024/07/doan-khach-fit-tour-check-in-tu-vien-ganden.webp" alt="Lhasa" width="600" height="375" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 pointer-events-none" loading="lazy" />
                <div class="absolute top-3 left-3 bg-black/80 backdrop-blur-md px-3 py-1 text-[10px] text-white font-mono font-bold uppercase tracking-widest rounded-full border border-white/10">LHASA • TÂY TẠNG</div>
              </div>
              <div class="p-5 flex-grow flex flex-col justify-between">
                <h3 class="text-white/90 text-sm font-bold leading-snug group-hover:text-[#c5a365] transition-colors">Khám phá tu viện Ganden - đại tu viện Phật giáo Mật Tông Tây Tạng</h3>
              </div>
            </div>

            <div class="shrink-0 w-[280px] sm:w-[320px] md:w-[360px] snap-start bg-[#111] rounded-2xl overflow-hidden border border-white/10 group cursor-pointer hover:border-[#c5a365]/50 transition-all duration-500 flex flex-col">
              <div class="relative aspect-[16/10] overflow-hidden">
                <img src="https://media.fittour.vn/uploads/2025/07/motor-trip-mong-co-doan-xe-tu-dinh-doi-do-xuong.webp" alt="Mongolia" width="600" height="375" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 pointer-events-none" loading="lazy" />
                <div class="absolute top-3 left-3 bg-black/80 backdrop-blur-md px-3 py-1 text-[10px] text-white font-mono font-bold uppercase tracking-widest rounded-full border border-white/10">THẢO NGUYÊN • MÔNG CỔ</div>
              </div>
              <div class="p-5 flex-grow flex flex-col justify-between">
                <h3 class="text-white/90 text-sm font-bold leading-snug group-hover:text-[#c5a365] transition-colors">Motor trip xuyên thảo nguyên bao la và sa mạc Gobi Mông Cổ</h3>
              </div>
            </div>

          </div>
        </div>
      </div>
    </section>

    <!-- SECTION 03: BEYOND ORDINARY JOURNEYS (TRIẾT LÝ) -->
    <section id="triet-ly" class="py-24 bg-[#050505] relative border-t border-white/5">
      <div class="max-w-[1200px] mx-auto px-6 md:px-12 text-center mb-20">
        <div class="font-mono text-[10px] text-[#c5a365] uppercase tracking-[0.3em] mb-4">THE FIT TOUR PHILOSOPHY</div>
        <h2 class="font-serif text-4xl md:text-6xl text-white tracking-widest uppercase mb-8">
          BEYOND ORDINARY JOURNEYS
        </h2>
        <p class="text-white/80 text-base md:text-lg max-w-3xl mx-auto leading-relaxed mb-6 font-serif italic">
          Một chuyến đi bình thường đưa bạn đến một nơi. Một hành trình đáng nhớ thay đổi cách bạn cảm nhận nơi đó.
        </p>
        <p class="text-white/60 text-sm md:text-base max-w-4xl mx-auto leading-relaxed text-justify md:text-center">
          Với FIT TOUR, “Beyond Ordinary” không có nghĩa là cố làm mọi thứ thật khác biệt. Nó đơn giản hơn. Là biết khi nào nên đi nhanh, khi nào nên chậm lại. Biết điểm nào đáng để dành thêm thời gian. Biết điều gì nên có trong hành trình — và điều gì nên được loại bỏ.
        </p>
      </div>

      <div class="max-w-[1440px] mx-auto px-6 md:px-12 grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-16">
        
        <div class="flex flex-col border-l border-[#c5a365]/30 pl-6">
          <div class="font-serif text-2xl text-[#c5a365] mb-2 tracking-widest uppercase">01. Beyond The Itinerary</div>
          <h3 class="text-xl text-white font-bold mb-4">Không chỉ là một lịch trình.</h3>
          <p class="text-white/60 text-sm leading-relaxed text-justify">
            Một lịch trình tốt không phải là lịch trình có nhiều điểm đến nhất. FIT TOUR quan tâm đến toàn bộ hành trình: cách di chuyển, thời gian nghỉ, nhịp độ, nơi lưu trú, trải nghiệm địa phương và những khoảng thời gian để bạn thực sự cảm nhận nơi mình đang đứng.
          </p>
        </div>

        <div class="flex flex-col border-l border-[#c5a365]/30 pl-6">
          <div class="font-serif text-2xl text-[#c5a365] mb-2 tracking-widest uppercase">02. Beyond The Checklist</div>
          <h3 class="text-xl text-white font-bold mb-4">Không đi để chỉ có thêm dấu tick.</h3>
          <p class="text-white/60 text-sm leading-relaxed text-justify">
            Thay vì chạy qua thật nhiều điểm check-in, FIT TOUR tìm kiếm những khoảnh khắc có ý nghĩa hơn. Một buổi sáng đẹp. Một con phố vắng. Một bữa ăn đúng tinh thần địa phương. Một cuộc trò chuyện không có trong catalogue. Đó là những thứ không thể đo bằng số lượng điểm đến.
          </p>
        </div>

        <div class="flex flex-col border-l border-[#c5a365]/30 pl-6">
          <div class="font-serif text-2xl text-[#c5a365] mb-2 tracking-widest uppercase">03. Beyond Ordinary</div>
          <h3 class="text-xl text-white font-bold mb-4">Hiểu sâu hơn về vùng đất.</h3>
          <p class="text-white/60 text-sm leading-relaxed text-justify">
            Mỗi vùng đất có một nhịp sống khác. Mỗi nhóm khách có một nhu cầu khác. Vì vậy FIT TOUR không bắt đầu bằng câu hỏi: "Tour này đang bán như thế nào?" Mà bắt đầu bằng: "Làm thế nào để hành trình này thực sự phù hợp với những người sẽ đi?"
          </p>
        </div>

        <div class="flex flex-col border-l border-[#c5a365]/30 pl-6">
          <div class="font-serif text-2xl text-[#c5a365] mb-2 tracking-widest uppercase">04. Beyond The Journey</div>
