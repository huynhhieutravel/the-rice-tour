              <img src="https://media.fittour.vn/uploads/zalo-icon.webp" alt="Zalo" style="width: 20px; height: 20px; object-fit: contain; flex-shrink: 0; border-radius: 4px;">
              <span style="white-space: nowrap;">Gửi Zalo ngay</span>
              <div style="width: 20px; height: 20px;"></div>
          </a>
        </div>
    </div>
</div>

<!-- STATS SNIPPET -->
<div class="snippet-wrapper snippet-stats-doanh-nghiep"><style>.snippet-stats-doanh-nghiep .sdn-bar {
