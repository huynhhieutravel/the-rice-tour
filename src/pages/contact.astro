---
import BaseLayout from '@/layouts/BaseLayout.astro';
import JsonLdSchema from '@/components/seo/JsonLdSchema.astro';
import { COMPANY_INFO } from '@/config/company';

const title = "Contact Us | The Rice Tour — 24/7 Dedicated Inbound Concierge";
const description = "Connect with The Rice Tour specialists. Inquire about bespoke private Vietnam tours, 24/7 WhatsApp assistance, customized itineraries, and travel advice.";
const canonicalUrl = "https://thericetour.com/contact";

const breadcrumbSchema = {
  items: [
    { name: "Home", url: "https://thericetour.com/" },
    { name: "Contact Us", url: canonicalUrl }
  ]
};

const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "TravelAgency",
  "name": COMPANY_INFO.brandName,
  "alternateName": COMPANY_INFO.legalNameEn,
  "description": COMPANY_INFO.brandSlogan,
  "url": "https://thericetour.com",
  "telephone": COMPANY_INFO.phoneIntl,
  "email": COMPANY_INFO.email,
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "180 Bui Vien Street, Ben Thanh Ward",
    "addressLocality": "District 1",
    "addressRegion": "Ho Chi Minh City",
    "addressCountry": "VN"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": "10.7665673",
    "longitude": "106.691962"
  },
  "openingHoursSpecification": [
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"],
      "opens": "00:00",
      "closes": "23:59"
    }
  ],
  "sameAs": [
    "https://maps.app.goo.gl/edrxP7cFszb5Pdck7"
  ]
};
---

<BaseLayout title={title} description={description} canonical={canonicalUrl}>
  <JsonLdSchema type="breadcrumb" data={breadcrumbSchema} />
  <script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />

  <!-- Hero Header -->
  <section class="bg-slate-950 text-white py-14 sm:py-20 lg:py-24 relative overflow-hidden">
    <div class="absolute inset-0 bg-[radial-gradient(#d97706_1px,transparent_1px)] [background-size:24px_24px] opacity-15"></div>
    <div class="max-w-4xl mx-auto px-4 text-center relative z-10">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-amber-500/15 border border-amber-400/30 mb-6 backdrop-blur-sm">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        <span class="text-xs uppercase tracking-[0.2em] font-semibold text-amber-300">24/7 Inbound Concierge</span>
      </div>
      <h1 class="font-serif text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-bold tracking-tight text-white mb-4 leading-tight">
        Let’s Plan Your Vietnam Journey
      </h1>
      <p class="text-slate-300 text-base sm:text-lg max-w-2xl mx-auto leading-relaxed">
        Have questions or looking for insider recommendations? Message our private tour architects via WhatsApp, call directly, or send an inquiry below.
      </p>
    </div>
  </section>

  <!-- Quick Action Cards -->
  <section class="py-10 bg-slate-100 border-b border-slate-200">
    <div class="max-w-6xl mx-auto px-4">
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-5">
        
        <!-- WhatsApp -->
        <a 
          href={`https://wa.me/${COMPANY_INFO.whatsapp.replace(/[^0-9]/g, '')}`} 
          target="_blank" 
          rel="noopener noreferrer"
          class="group bg-white p-6 rounded-2xl border border-slate-200 shadow-xs hover:shadow-lg hover:border-emerald-300 transition-all flex items-center gap-4"
        >
          <div class="w-12 h-12 rounded-xl bg-emerald-500 text-white flex items-center justify-center shrink-0 shadow-sm group-hover:scale-105 transition-transform">
            <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.301-.15-1.78-.878-2.056-.979-.276-.1-.477-.15-.678.15-.201.301-.779.979-.955 1.18-.176.2-.351.226-.652.075-.301-.15-1.272-.469-2.424-1.496-.895-.798-1.5-1.784-1.676-2.085-.176-.301-.019-.464.132-.614.136-.135.301-.351.452-.527.15-.176.201-.301.301-.502.1-.201.05-.376-.025-.527-.075-.15-.678-1.635-.93-2.243-.245-.591-.494-.511-.678-.521-.176-.01-.376-.01-.577-.01-.201 0-.527.075-.803.376-.276.301-1.054 1.03-1.054 2.512 0 1.482 1.079 2.912 1.23 3.113.15.2 2.123 3.242 5.143 4.547.718.31 1.279.496 1.716.635.721.23 1.377.197 1.896.12.577-.087 1.78-.727 2.03-1.43.251-.703.251-1.305.176-1.43-.075-.125-.276-.201-.577-.351z"/></svg>
          </div>
          <div>
            <span class="text-xs uppercase tracking-wider font-bold text-emerald-600 block">Instant Chat</span>
            <span class="font-bold text-slate-900 text-sm group-hover:text-emerald-700 transition-colors">WhatsApp 24/7</span>
            <span class="text-xs text-slate-500 block mt-0.5">{COMPANY_INFO.whatsapp}</span>
          </div>
        </a>

        <!-- Email -->
        <a 
          href={`mailto:${COMPANY_INFO.email}`}
          class="group bg-white p-6 rounded-2xl border border-slate-200 shadow-xs hover:shadow-lg hover:border-amber-300 transition-all flex items-center gap-4"
        >
          <div class="w-12 h-12 rounded-xl bg-amber-500 text-white flex items-center justify-center shrink-0 shadow-sm group-hover:scale-105 transition-transform">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
          </div>
          <div>
            <span class="text-xs uppercase tracking-wider font-bold text-amber-600 block">Email Inquiries</span>
            <span class="font-bold text-slate-900 text-sm group-hover:text-amber-700 transition-colors">{COMPANY_INFO.email}</span>
            <span class="text-xs text-slate-500 block mt-0.5">Replies within 24 hours</span>
          </div>
        </a>

        <!-- Phone / Hotline -->
        <a 
          href={`tel:${COMPANY_INFO.hotline.replace(/[^0-9]/g, '')}`}
          class="group bg-white p-6 rounded-2xl border border-slate-200 shadow-xs hover:shadow-lg hover:border-blue-300 transition-all flex items-center gap-4"
        >
          <div class="w-12 h-12 rounded-xl bg-slate-900 text-amber-400 flex items-center justify-center shrink-0 shadow-sm group-hover:scale-105 transition-transform">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" /></svg>
          </div>
          <div>
            <span class="text-xs uppercase tracking-wider font-bold text-slate-600 block">Direct Hotline</span>
            <span class="font-bold text-slate-900 text-sm group-hover:text-slate-700 transition-colors">{COMPANY_INFO.hotline}</span>
            <span class="text-xs text-slate-500 block mt-0.5">Office: {COMPANY_INFO.phone}</span>
          </div>
        </a>

      </div>
    </div>
  </section>

  <!-- Main Content: Form & Office Details -->
  <section class="py-14 sm:py-20 bg-slate-50">
    <div class="max-w-6xl mx-auto px-4">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12">
        
        <!-- Left Column: Contact / Inquiry Form (7 cols) -->
        <div class="lg:col-span-7">
          <div class="bg-white rounded-3xl p-6 sm:p-10 border border-slate-200 shadow-sm">
            <div class="mb-6">
              <span class="text-xs font-bold uppercase tracking-widest text-amber-600">Send an Inquiry</span>
              <h2 class="font-serif text-2xl sm:text-3xl font-bold text-slate-900 mt-1">
                Tell Us About Your Trip
              </h2>
              <p class="text-slate-500 text-sm mt-2">
                Fill in the details below and our travel concierge will reach out with a personalized proposal and pricing.
              </p>
            </div>

            <form id="contact-inquiry-form" class="space-y-4">
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                  <label for="contact-name" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">
                    Your Full Name <span class="text-red-500">*</span>
                  </label>
                  <input 
                    type="text" 
                    id="contact-name" 
                    name="customerName" 
                    required 
                    placeholder="e.g. Michael Smith" 
                    class="w-full px-4 py-3 rounded-xl border border-slate-200 bg-slate-50/50 text-slate-900 text-sm focus:outline-none focus:ring-2 focus:ring-amber-500 focus:bg-white transition-all"
                  />
                </div>
                <div>
                  <label for="contact-email" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">
                    Email Address <span class="text-red-500">*</span>
                  </label>
                  <input 
                    type="email" 
                    id="contact-email" 
                    name="customerEmail" 
                    required 
                    placeholder="michael@example.com" 
                    class="w-full px-4 py-3 rounded-xl border border-slate-200 bg-slate-50/50 text-slate-900 text-sm focus:outline-none focus:ring-2 focus:ring-amber-500 focus:bg-white transition-all"
                  />
                </div>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                  <label for="contact-phone" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">
                    WhatsApp / Phone Number <span class="text-red-500">*</span>
                  </label>
                  <input 
                    type="tel" 
                    id="contact-phone" 
                    name="customerPhone" 
                    required 
                    placeholder="+1 234 567 8900" 
                    class="w-full px-4 py-3 rounded-xl border border-slate-200 bg-slate-50/50 text-slate-900 text-sm focus:outline-none focus:ring-2 focus:ring-amber-500 focus:bg-white transition-all"
                  />
                </div>
                <div>
                  <label for="contact-tour" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">
                    Journey of Interest
                  </label>
                  <select 
                    id="contact-tour" 
                    name="tourName" 
                    class="w-full px-4 py-3 rounded-xl border border-slate-200 bg-slate-50/50 text-slate-900 text-sm focus:outline-none focus:ring-2 focus:ring-amber-500 focus:bg-white transition-all"
                  >
                    <option value="General Inquiry">General Inbound Inquiry</option>
                    <option value="1-Day Premium Cu Chi Tunnels & Saigon">1-Day Premium Cu Chi Tunnels & Saigon</option>
                    <option value="Half-Day Premium Cu Chi Tunnels">Half-Day Premium Cu Chi Tunnels</option>
                    <option value="Full-Day Mekong Delta (Ben Tre & My Tho)">Full-Day Mekong Delta (Ben Tre & My Tho)</option>
                    <option value="2-Day Mekong Delta Tour with Cai Rang">2-Day Mekong Delta Tour with Cai Rang</option>
                    <option value="Ho Chi Minh City Half-Day Private Tour">Ho Chi Minh City Half-Day Private Tour</option>
                    <option value="Authentic Vietnamese Cooking Class">Authentic Vietnamese Cooking Class</option>
                    <option value="Bespoke Multi-Day Custom Tour">Bespoke Multi-Day Custom Tour</option>
                  </select>
                </div>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                  <label for="contact-dates" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">
                    Estimated Travel Dates
                  </label>
                  <input 
                    type="text" 
                    id="contact-dates" 
                    name="travelDates" 
                    placeholder="e.g. October 2026 or DD/MM/YYYY" 
                    class="w-full px-4 py-3 rounded-xl border border-slate-200 bg-slate-50/50 text-slate-900 text-sm focus:outline-none focus:ring-2 focus:ring-amber-500 focus:bg-white transition-all"
                  />
                </div>
                <div>
                  <label for="contact-guests" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">
                    Number of Guests
                  </label>
                  <input 
                    type="text" 
                    id="contact-guests" 
                    name="groupSize" 
                    placeholder="e.g. 2 Adults, 1 Child" 
                    class="w-full px-4 py-3 rounded-xl border border-slate-200 bg-slate-50/50 text-slate-900 text-sm focus:outline-none focus:ring-2 focus:ring-amber-500 focus:bg-white transition-all"
                  />
                </div>
              </div>

              <div>
                <label for="contact-message" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">
                  Your Message & Special Wishes
                </label>
                <textarea 
                  id="contact-message" 
                  name="message" 
                  rows="4" 
                  placeholder="Tell us about your interests (culture, photography, food, slow travel), dietary restrictions, or specific pickup requirements..." 
                  class="w-full px-4 py-3 rounded-xl border border-slate-200 bg-slate-50/50 text-slate-900 text-sm focus:outline-none focus:ring-2 focus:ring-amber-500 focus:bg-white transition-all resize-y"
                ></textarea>
              </div>

              <div id="form-feedback" class="hidden p-4 rounded-xl text-sm font-medium"></div>

              <button 
                type="submit" 
                id="submit-btn" 
                class="w-full py-4 rounded-xl bg-amber-600 hover:bg-amber-700 text-white font-bold text-sm uppercase tracking-wider transition-all shadow-md hover:shadow-lg flex items-center justify-center gap-2 cursor-pointer"
              >
                <span>Send Inquiry to Specialist</span>
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
              </button>

              <p class="text-center text-xs text-slate-400 mt-2">
                🔒 We respect your privacy. No spam. 100% tailor-made private tours.
              </p>
            </form>
          </div>
        </div>

        <!-- Right Column: Office, Legal & Guarantees (5 cols) -->
        <div class="lg:col-span-5 space-y-6">
          
          <!-- Headquarters Box -->
          <div class="bg-white rounded-3xl p-6 sm:p-8 border border-slate-200 shadow-sm">
            <div class="flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-emerald-700 bg-emerald-50 px-3 py-1 rounded-full w-fit mb-4">
              <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
              Official Head Office
            </div>
            
            <h3 class="font-serif text-xl font-bold text-slate-900 mb-1">
              {COMPANY_INFO.brandName}
            </h3>
            <p class="text-xs text-slate-500 mb-4 uppercase tracking-wider font-semibold">
              {COMPANY_INFO.legalNameEn}
            </p>

            <div class="space-y-3.5 text-sm text-slate-600">
              <div class="flex items-start gap-3">
                <span class="text-lg">📍</span>
                <div>
                  <strong class="text-slate-800 block text-xs uppercase tracking-wider">Address:</strong>
                  <span>{COMPANY_INFO.headquartersEn}</span>
                  <div class="text-xs text-slate-400 mt-0.5">({COMPANY_INFO.headquarters})</div>
                </div>
              </div>

              <div class="flex items-start gap-3">
                <span class="text-lg">⏰</span>
                <div>
                  <strong class="text-slate-800 block text-xs uppercase tracking-wider">Office Hours:</strong>
                  <span>Mon – Sun: 07:00 AM – 10:00 PM (ICT)</span>
                  <div class="text-xs text-emerald-600 font-semibold mt-0.5">WhatsApp Concierge: 24/7 Available</div>
                </div>
              </div>

              <div class="flex items-start gap-3">
                <span class="text-lg">📞</span>
                <div>
                  <strong class="text-slate-800 block text-xs uppercase tracking-wider">Hotline & Concierge:</strong>
                  <a href={`tel:${COMPANY_INFO.phone.replace(/[^0-9]/g, '')}`} class="text-amber-600 font-bold hover:underline">{COMPANY_INFO.phone}</a>
                  <span class="text-slate-400 mx-1">•</span>
                  <a href={`tel:${COMPANY_INFO.hotline.replace(/[^0-9]/g, '')}`} class="text-amber-600 font-bold hover:underline">{COMPANY_INFO.hotline}</a>
                </div>
              </div>

              <div class="flex items-start gap-3">
                <span class="text-lg">✉️</span>
                <div>
                  <strong class="text-slate-800 block text-xs uppercase tracking-wider">Official Email:</strong>
                  <a href={`mailto:${COMPANY_INFO.email}`} class="text-amber-600 font-bold hover:underline">{COMPANY_INFO.email}</a>
                </div>
              </div>
            </div>

            <div class="mt-6 pt-6 border-t border-slate-100 flex items-center justify-between">
              <a 
                href={COMPANY_INFO.mapsUrl}
                target="_blank" 
                rel="noopener noreferrer" 
                class="inline-flex items-center gap-1.5 text-xs font-bold text-amber-700 hover:text-amber-800 uppercase tracking-wider"
              >
                <span>🗺️ Open in Google Maps</span>
                <span>↗</span>
              </a>
              <span class="text-xs text-slate-400">District 1 Center</span>
            </div>
          </div>

          <!-- Accreditations & Trust -->
          <div class="bg-white rounded-3xl p-6 sm:p-8 border border-slate-200 shadow-sm">
            <h4 class="font-serif text-lg font-bold text-slate-900 mb-4 flex items-center gap-2">
              <span>🏛️</span> Accreditations & Standards
            </h4>

            <ul class="space-y-3 text-xs text-slate-700">
              <li class="flex items-start gap-2.5">
                <span class="w-5 h-5 rounded-full bg-emerald-100 text-emerald-700 font-bold flex items-center justify-center shrink-0 mt-0.5">✓</span>
                <div>
                  <strong class="text-slate-900">Tour Operator License:</strong>
                  <div class="font-mono text-slate-600">{COMPANY_INFO.licenseNumber}</div>
                </div>
              </li>
              <li class="flex items-start gap-2.5">
                <span class="w-5 h-5 rounded-full bg-emerald-100 text-emerald-700 font-bold flex items-center justify-center shrink-0 mt-0.5">✓</span>
                <div>
                  <strong class="text-slate-900">100% No Forced Shopping Guarantee:</strong>
                  <div class="text-slate-500">Purely cultural, historical, and culinary experiences.</div>
                </div>
              </li>
              <li class="flex items-start gap-2.5">
                <span class="w-5 h-5 rounded-full bg-emerald-100 text-emerald-700 font-bold flex items-center justify-center shrink-0 mt-0.5">✓</span>
                <div>
                  <strong class="text-slate-900">TripAdvisor 5.0 Rating:</strong>
                  <div class="text-slate-500">Top-rated inbound private tours in Southern Vietnam.</div>
                </div>
              </li>
            </ul>
          </div>

        </div>

      </div>

      <!-- Google Maps Embed Section -->
      <div class="mt-12 bg-white rounded-3xl p-6 sm:p-8 border border-slate-200 shadow-sm">
        <div class="flex items-center justify-between mb-4">
          <h3 class="font-serif text-xl font-bold text-slate-900">
            Visit Our Operations Hub
          </h3>
          <span class="text-xs text-slate-500">180 Bui Vien, District 1, Ho Chi Minh City</span>
        </div>
        <div class="w-full h-[380px] rounded-2xl overflow-hidden border border-slate-200">
          <iframe 
            src={COMPANY_INFO.mapsEmbedSrc} 
            width="100%" 
            height="100%" 
            style="border:0;" 
            allowfullscreen="" 
            loading="lazy" 
            referrerpolicy="strict-origin-when-cross-origin"
            title="The Rice Tour Headquarters Location"
            aria-label="Google Maps location of The Rice Tour"
          ></iframe>
        </div>
      </div>

    </div>
  </section>

  <!-- Client-side Script for Form Handling -->
  <script>
    const form = document.getElementById('contact-inquiry-form') as HTMLFormElement;
    const feedback = document.getElementById('form-feedback');
    const submitBtn = document.getElementById('submit-btn');

    if (form && feedback && submitBtn) {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        
        const originalBtnText = submitBtn.innerHTML;
        submitBtn.setAttribute('disabled', 'true');
        submitBtn.innerHTML = `
          <svg class="animate-spin -ml-1 mr-2 h-4 w-4 text-white inline-block" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
          </svg>
          Sending Inquiry...
        `;
        feedback.className = 'hidden';

        const formData = new FormData(form);
        const payload = {
          customerName: formData.get('customerName'),
          customerEmail: formData.get('customerEmail'),
          customerPhone: formData.get('customerPhone'),
          tourName: formData.get('tourName'),
          sourceUrl: window.location.href,
          options: {
            travelDates: formData.get('travelDates'),
            groupSize: formData.get('groupSize'),
            notes: formData.get('message'),
            contactChannel: 'Website Contact Page Form'
          }
        };

        try {
          const res = await fetch('/api/submit-form', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
          });
          const json = await res.json();

          if (res.ok && json.success) {
            feedback.className = 'block p-4 rounded-xl text-sm font-medium bg-emerald-50 text-emerald-800 border border-emerald-200';
            feedback.innerHTML = `
              🎉 <strong>Thank you!</strong> Your inquiry has been received. Our concierge will connect with you via WhatsApp/Email shortly.
            `;
            form.reset();
          } else {
            throw new Error(json.message || 'Submission failed');
          }
        } catch (err: any) {
          feedback.className = 'block p-4 rounded-xl text-sm font-medium bg-red-50 text-red-800 border border-red-200';
          feedback.innerHTML = `⚠️ Could not submit at this moment. Please reach out to us directly on WhatsApp at <strong>+84 962 333 621</strong>.`;
        } finally {
          submitBtn.removeAttribute('disabled');
          submitBtn.innerHTML = originalBtnText;
        }
      });
    }
  </script>
</BaseLayout>
