---
import { env } from 'cloudflare:workers';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { safeQueryCritical } from '@/lib/db-client';
import { getGlobalSettings } from '@/lib/settingsHelper';
import { MapPin, Info, Users, Clock, Calendar, Compass, Share2, Link as LinkIcon, ChevronRight, CheckCircle2 } from 'lucide-react';

const d1Db = env?.dulichcoguu_d1;
if (!d1Db) return Astro.rewrite("/500");

// Fetch CMS Data for SEO and Metadata
let post;
try {
  post = await safeQueryCritical(
    d1Db.prepare(`
      SELECT p.*, u.url as authorUrl, u.avatar as authorAvatar 
      FROM Post p 
      LEFT JOIN "User" u ON p.authorId = u.id 
      WHERE p.slug = ? AND (p.status = 'published' OR p.status = 'publish')
    `).bind('nui-kailash-la-gi').first<any>(),
    { route: Astro.url.pathname, slug: 'nui-kailash-la-gi', queryType: "fetch_post_by_slug" }
  );
} catch (e) {
  return Astro.rewrite("/500");
}

if (!post) {
  return Astro.rewrite("/404");
}

const { settings } = await getGlobalSettings();

const seoTitle = post.seoTitle || post.title || 'Núi Kailash là gì? Hành hương Kora & Bí ẩn Tâm linh';
const seoDesc = post.seoDesc || post.excerpt || 'Khám phá Núi Kailash - trung tâm tâm linh của Ấn Độ giáo, Phật giáo, Kỳ Na giáo. Giải mã Kora Kailash, bí ẩn chưa có lời giải và kinh nghiệm hành hương thực tế.';
const seoImage = post.seoImage || post.featuredImage || 'https://pub-fe90037727604a2586cc601e6a3c6575.r2.dev/wp-content/uploads/2024/07/du-khach-chuan-bi-hanh-trinh-kora-kailash.jpg';

// --- DATE LOGIC ---
const createdAtStr = post.createdAt || post.publishedAt || new Date().toISOString();
const updatedAtStr = post.updatedAt || createdAtStr;

const createdAt = new Date(createdAtStr.replace(' ', 'T'));
const updatedAt = new Date(updatedAtStr.replace(' ', 'T'));

const isUpdated = updatedAt.getTime() - createdAt.getTime() > 86400000; 
const displayDate = isUpdated ? updatedAt : createdAt;
const datePrefix = isUpdated ? "Cập nhật:" : "Xuất bản:";

const formattedDate = displayDate.toLocaleDateString('vi-VN', { day: '2-digit', month: '2-digit', year: 'numeric' });
// ------------------

const adminEditUrl = `/admin/posts/edit?id=${post.id}`;
---

<BaseLayout 
  title={seoTitle} 
  description={seoDesc} 
  image={seoImage}
  adminEditUrl={adminEditUrl}
>
  <div class="bg-[#F8F9FA] text-[#1E293B] font-sans antialiased selection:bg-[#c89845] selection:text-white">

    {/* ================= HERO SECTION ================= */}
    <section class="relative w-full h-[600px] lg:h-[650px] overflow-hidden">
      <div class="absolute inset-0 z-0 bg-slate-900">
        <img src={seoImage} alt="Núi Kailash" class="w-full h-full object-cover object-center opacity-80" fetchpriority="high" loading="eager" />
        <div class="absolute inset-0 bg-gradient-to-r from-black/80 via-black/50 to-transparent"></div>
        <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-transparent to-transparent"></div>
      </div>

      <div class="relative z-10 max-w-[1600px] mx-auto px-4 sm:px-6 lg:px-12 h-full flex flex-col justify-center pt-20 pb-16">
        
        {/* Breadcrumb */}
        <div class="flex items-center gap-2 text-[13px] text-white/70 font-medium mb-6">
          <a href="/" class="hover:text-white transition-colors">Trang chủ</a>
          <ChevronRight class="w-3 h-3" />
          <a href="/blog" class="hover:text-white transition-colors">Blog</a>
          <ChevronRight class="w-3 h-3" />
          <span class="text-white">Tây Tạng</span>
        </div>

        {/* Titles */}
        <h1 class="font-serif text-4xl sm:text-5xl lg:text-6xl font-bold text-white mb-4 leading-[1.1] drop-shadow-lg max-w-4xl">
          Núi Kailash: Hành trình giải mã "Trục Vũ Trụ" linh thiêng
        </h1>
        <h2 class="font-serif text-xl sm:text-3xl text-amber-400 italic mb-10 max-w-3xl drop-shadow-md">
          Nơi Giao Thoa Giữa Thế Giới Vật Chất Và Tâm Linh
        </h2>
        <p class="text-white/90 text-base sm:text-lg max-w-2xl leading-relaxed mb-8 hidden md:block drop-shadow-md font-medium">
          Khám phá <strong class="text-amber-400 font-bold">Núi Kailash</strong> cao 6.638 mét, ngọn núi bí ẩn chưa ai chinh phục và là trung tâm tâm linh lớn nhất của phương Đông.
        </p>

        {/* Author Meta */}
        <div class="flex flex-wrap items-center gap-6 text-sm text-white/80 border-t border-white/20 pt-6 max-w-3xl">
          <a href={post.authorUrl || "/huynh-hieu"} class="flex items-center gap-3 group">
            <img src={post.authorAvatar || "https://media.fittour.vn/uploads/huynhhieutravel.webp"} alt={post.author || 'Huynh Hieu Travel'} class="w-10 h-10 rounded-full border-2 border-white/30 object-cover object-top group-hover:border-amber-400 transition-colors" />
            <span class="font-bold text-white group-hover:text-amber-400 transition-colors flex items-center gap-1">
              {post.author || 'Huynh Hieu Travel'} 
              <CheckCircle2 class="w-4 h-4 text-blue-400" />
            </span>
          </a>
          <div class="flex items-center gap-2 bg-white/10 px-4 py-2 rounded-full backdrop-blur-sm border border-white/10">
            <Calendar class="w-4 h-4 opacity-70" />
            <span>{datePrefix} {formattedDate}</span>
          </div>
          <div class="flex items-center gap-2 bg-black/20 px-3 py-1.5 rounded-full backdrop-blur-sm">
            <Clock class="w-4 h-4 text-amber-400" />
            <span>10 phút đọc</span>
          </div>
        </div>

        {/* Badges Line */}
        <div class="flex flex-wrap items-center gap-4 mt-8 pt-6">
          <div class="flex items-center gap-2 text-sm text-white font-medium bg-black/60 backdrop-blur-md px-4 py-2 border border-white/10 rounded-lg shadow-xl">
            <span class="text-amber-400 text-lg">⛰️</span> Đỉnh 6.638m
          </div>
          <div class="flex items-center gap-2 text-sm text-white font-medium bg-black/60 backdrop-blur-md px-4 py-2 border border-white/10 rounded-lg shadow-xl">
            <span class="text-amber-400 text-lg">🪷</span> Đất Thánh 4 Tôn giáo
          </div>
          <div class="flex items-center gap-2 text-sm text-white font-medium bg-black/60 backdrop-blur-md px-4 py-2 border border-white/10 rounded-lg shadow-xl">
            <span class="text-amber-400 text-lg">🚶</span> Hành hương Kora 52km
          </div>
          <div class="flex items-center gap-2 text-sm text-white font-medium bg-black/60 backdrop-blur-md px-4 py-2 border border-white/10 rounded-lg shadow-xl">
            <span class="text-amber-400 text-lg">🧭</span> Vị trí: Ngari Prefecture
          </div>
        </div>

      </div>
    </section>

    {/* ================= MAIN CONTENT GRID ================= */}
    <div class="max-w-[1600px] mx-auto px-4 sm:px-6 lg:px-12 py-12 lg:py-16">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-start">

        {/* ---------------- LEFT SIDEBAR (TOC) ---------------- */}
        <aside class="hidden lg:block lg:col-span-3 sticky top-24">
          <div class="bg-white rounded-2xl shadow-sm border border-slate-200/60 p-6 overflow-hidden">
            <div class="flex items-center gap-2 font-bold text-slate-800 mb-6 border-l-4 border-amber-500 pl-3 text-sm tracking-wide uppercase">
              Mục lục bài viết
            </div>
            
            <nav class="space-y-1 text-[13.5px] font-medium max-h-[70vh] overflow-y-auto custom-scrollbar">
              <a href="#nui-kailash-la-gi" class="flex items-center gap-2 text-slate-700 hover:text-amber-600 px-3 py-2 rounded-lg transition-colors font-bold">
                <span class="text-slate-400 text-base">🏔️</span> Núi Kailash là gì?
              </a>
              <a href="#nui-kailash-o-dau" class="flex items-center gap-2 text-slate-700 hover:text-amber-600 px-3 py-2 rounded-lg transition-colors font-bold mt-1">
                <span class="text-slate-400 text-base">🗺️</span> Núi Kailash ở đâu?
              </a>
              <a href="#nui-kailash-cao-bao-nhieu" class="flex items-center gap-2 text-slate-700 hover:text-amber-600 px-3 py-2 rounded-lg transition-colors font-bold mt-1">
                <span class="text-slate-400 text-base">📏</span> Cao bao nhiêu mét?
              </a>
              
              <a href="#tru-cot-vu-tru" class="flex items-center gap-2 text-slate-700 hover:text-amber-600 px-3 py-2 rounded-lg transition-colors font-bold mt-3">
                <span class="text-slate-400 text-base">🌌</span> Vì sao là "Trục vũ trụ"?
              </a>
              <div class="pl-9 pr-3 space-y-1.5 mt-1 border-l border-slate-100 ml-[18px]">
                  <a href="#y-nghia-ton-giao" class="block text-slate-500 hover:text-amber-600 text-[13px] py-1 transition-colors leading-tight">Ý nghĩa trong các tôn giáo</a>
              </div>

              <a href="#co-leo-duoc-khong" class="flex items-center gap-2 text-slate-700 hover:text-amber-600 px-3 py-2 rounded-lg transition-colors font-bold mt-3">
                <span class="text-slate-400 text-base">🧗</span> Có leo được không?
              </a>
              
              <a href="#kora-kailash" class="flex items-center gap-2 text-slate-700 hover:text-amber-600 px-3 py-2 rounded-lg transition-colors font-bold mt-3">
                <span class="text-slate-400 text-base">🚶</span> Kora Kailash là gì?
              </a>
              <div class="pl-9 pr-3 space-y-1.5 mt-1 border-l border-slate-100 ml-[18px]">
                  <a href="#kora-co-kho-khong" class="block text-slate-500 hover:text-amber-600 text-[13px] py-1 transition-colors leading-tight">Độ cao mới là thử thách</a>
                  <a href="#thich-nghi-do-cao" class="block text-slate-500 hover:text-amber-600 text-[13px] py-1 transition-colors leading-tight">Thích nghi độ cao</a>
                  <a href="#hanh-huong-dac-biet" class="block text-slate-500 hover:text-amber-600 text-[13px] py-1 transition-colors leading-tight">Có gì đặc biệt?</a>
              </div>

              <a href="#everest-vs-kailash" class="flex items-center gap-2 text-slate-700 hover:text-amber-600 px-3 py-2 rounded-lg transition-colors font-bold mt-3">
                <span class="text-slate-400 text-base">⚖️</span> Khác với Everest thế nào?
              </a>

              <a href="#nen-di-mua-nao" class="flex items-center gap-2 text-slate-700 hover:text-amber-600 px-3 py-2 rounded-lg transition-colors font-bold mt-3">
                <span class="text-slate-400 text-base">🌦️</span> Nên đi mùa nào?
              </a>

              <a href="#nui-tu-di" class="flex items-center gap-2 text-slate-700 hover:text-amber-600 px-3 py-2 rounded-lg transition-colors font-bold mt-3">
                <span class="text-slate-400 text-base">🪷</span> Có phải núi Tu Di?
              </a>

              <a href="#bi-an" class="flex items-center gap-2 text-slate-700 hover:text-amber-600 px-3 py-2 rounded-lg transition-colors font-bold mt-3">
                <span class="text-slate-400 text-base">👁️</span> Những bí ẩn
              </a>

              <a href="#faq" class="flex items-center gap-2 text-slate-700 hover:text-amber-600 px-3 py-2 rounded-lg transition-colors font-bold mt-3">
                <span class="text-slate-400 text-base">❓</span> Câu hỏi thường gặp
              </a>
            </nav>
          </div>
        </aside>

        {/* ---------------- CENTER COLUMN (MAIN CONTENT) ---------------- */}
        <main class="col-span-1 lg:col-span-6 space-y-10">
                    {/* Quick Overview Stats Bar */}
          <div class="bg-white rounded-2xl shadow-sm border border-slate-200/60 p-6 flex flex-wrap lg:flex-nowrap items-center justify-between gap-4">
            <div class="w-full flex items-center justify-between gap-4 mb-2 lg:hidden">
              <span class="font-bold text-slate-800 text-sm border-l-4 border-emerald-500 pl-2 uppercase">Tổng Quan Nhanh</span>
            </div>

            <div class="flex items-center gap-3 w-[48%] lg:w-auto">
              <div class="w-10 h-10 rounded-full bg-amber-50 flex items-center justify-center text-amber-600 text-xl border border-amber-100 shrink-0">🌤️</div>
              <div>
                <div class="text-[11px] text-slate-500 font-medium">Mùa lý tưởng</div>
                <div class="text-[13px] font-bold text-slate-800">Tháng 5 - Tháng 10</div>
              </div>
            </div>

            <div class="hidden lg:block w-px h-8 bg-slate-200"></div>

            <div class="flex items-center gap-3 w-[48%] lg:w-auto">
              <div class="w-10 h-10 rounded-full bg-rose-50 flex items-center justify-center text-rose-600 text-xl border border-rose-100 shrink-0">🛑</div>
              <div>
                <div class="text-[11px] text-slate-500 font-medium">Khả năng leo</div>
                <div class="text-[13px] font-bold text-slate-800">Cấm leo vĩnh viễn</div>
              </div>
            </div>

            <div class="hidden lg:block w-px h-8 bg-slate-200"></div>

            <div class="flex items-center gap-3 w-[48%] lg:w-auto mt-2 lg:mt-0">
              <div class="w-10 h-10 rounded-full bg-emerald-50 flex items-center justify-center text-emerald-600 text-xl border border-emerald-100 shrink-0">💪</div>
              <div>
                <div class="text-[11px] text-slate-500 font-medium">Yêu cầu</div>
                <div class="text-[13px] font-bold text-slate-800">Thể lực & Thích nghi</div>
              </div>
            </div>

            <div class="hidden lg:block w-px h-8 bg-slate-200"></div>

            <div class="flex items-center gap-3 w-[48%] lg:w-auto mt-2 lg:mt-0">
              <div class="w-10 h-10 rounded-full bg-blue-50 flex items-center justify-center text-blue-600 text-xl border border-blue-100 shrink-0">🎫</div>
              <div>
                <div class="text-[11px] text-slate-500 font-medium">Giấy phép</div>
                <div class="text-[13px] font-bold text-slate-800">Bắt buộc (3 loại)</div>
              </div>
            </div>
          </div>

          <div id="nui-kailash-la-gi" class="scroll-mt-28">
            <h2 class="font-serif text-2xl lg:text-[28px] font-bold text-slate-900 border-b-2 border-amber-500 pb-2 inline-block mb-6">Núi Kailash là gì?</h2>
            <div class="prose prose-slate max-w-none prose-p:leading-relaxed prose-p:text-[15.5px] prose-p:text-slate-700">
                <p><strong>Núi Kailash</strong> (hay còn gọi là <strong>Kangrinboqê</strong> theo tiếng Tây Tạng) là một ngọn núi thuộc dãy <strong>Gangdise Range</strong>, nằm ở khu vực phía Tây của <a href="/blog/huong-dan-du-lich-tay-tang/" target="_blank" class="text-amber-600 font-medium hover:underline">Tây Tạng</a>. Với hàng triệu tín đồ, Kailash không đơn thuần là một ngọn núi tuyết. Đây là một vùng đất thiêng bất khả xâm phạm và là cái nôi tâm linh huyền thoại.</p>
                <p>Nơi đây là điểm giao thoa tín ngưỡng của 4 tôn giáo lớn: <strong>Ấn Độ giáo (Hinduism), Phật giáo (Buddhism), Kỳ Na giáo (Jainism) và đạo Bon (Bonpo)</strong> bản địa của người Tây Tạng.</p>
            </div>
            <figure class="mt-6 mb-8 relative aspect-video w-full rounded-2xl overflow-hidden bg-slate-100 shadow-sm border border-slate-200/60">
                <img src="https://media.fittour.vn/uploads/2024/07/dinh-nui-kailash-sung-sung-tu-xa.webp" alt="Đỉnh núi Kailash sừng sững từ xa" class="w-full h-full object-cover object-bottom" loading="lazy" />
                <figcaption class="absolute bottom-0 inset-x-0 bg-black/60 backdrop-blur-md text-white/90 text-[13px] px-4 py-2 text-center">Đỉnh núi Kailash sừng sững được phủ tuyết trắng quanh năm</figcaption>
            </figure>
          </div>

          <div id="nui-kailash-o-dau" class="scroll-mt-28">
            <h2 class="font-serif text-2xl lg:text-[28px] font-bold text-slate-900 border-b-2 border-amber-500 pb-2 inline-block mb-6">Núi Kailash ở đâu?</h2>
            
            <div class="bg-slate-50 border border-slate-200 rounded-xl p-5 mb-6">
                <h3 class="text-sm font-bold text-slate-500 uppercase tracking-wide mb-3">Thông tin địa lý cấu trúc</h3>
                <ul class="space-y-2 text-[14px] text-slate-700">
                    <li><strong class="text-slate-900">Tên:</strong> Mount Kailash (Kangrinboqê)</li>
                    <li><strong class="text-slate-900">Độ cao:</strong> 6.638m</li>
                    <li><strong class="text-slate-900">Khu vực:</strong> Ngari Prefecture</li>
                    <li><strong class="text-slate-900">Quốc gia:</strong> Trung Quốc (Khu tự trị Tây Tạng)</li>
                    <li><strong class="text-slate-900">Thuộc dãy:</strong> Gangdise Range</li>
                    <li><strong class="text-slate-900">UNESCO:</strong> Không</li>
                </ul>
            </div>

            <div class="prose prose-slate max-w-none prose-p:leading-relaxed prose-p:text-[15.5px] prose-p:text-slate-700">
                <p>Kailash nằm cô lập ở cao nguyên thuộc <strong>Ngari Prefecture, Tây Tạng</strong>, rất gần với đường biên giới của <a href="/blog/kinh-nghiem-du-lich-nepal/" target="_blank" class="text-amber-600 font-medium hover:underline">Nepal</a> và Ấn Độ. Xung quanh chân núi là hai hồ thiêng vô cùng nổi tiếng: <strong>Manasarovar</strong> (Hồ tinh khiết) và <strong>Rakshastal</strong> (Hồ quỷ).</p>
                <p>Vị trí địa lý của ngọn núi này cũng vô cùng đặc biệt khi nó là <strong>nguồn cung cấp nước cho 4 con sông lớn nhất châu Á</strong>, chảy về 4 hướng khác nhau:</p>
                <ul>
                    <li>Sông Indus (chảy về Ấn Độ và Pakistan)</li>
                    <li>Sông Sutlej (phụ lưu của sông Indus)</li>
                    <li>Sông Brahmaputra (chảy về Ấn Độ, Bangladesh)</li>
                    <li>Sông Karnali (phụ lưu chính của sông Hằng)</li>
                </ul>
            </div>
          </div>

          <div id="nui-kailash-cao-bao-nhieu" class="scroll-mt-28">
            <h2 class="font-serif text-2xl lg:text-[28px] font-bold text-slate-900 border-b-2 border-amber-500 pb-2 inline-block mb-6">Núi Kailash cao bao nhiêu mét?</h2>
            <div class="prose prose-slate max-w-none prose-p:leading-relaxed prose-p:text-[15.5px] prose-p:text-slate-700">
                <p>Đỉnh núi Kailash có <strong>độ cao chính thức là 6.638 mét</strong> (khoảng 21.778 feet) so với mực nước biển. Mặc dù không nằm trong danh sách những đỉnh núi cao nhất thuộc dãy Himalaya (như Everest cao 8.848m), nhưng chính hình dáng kỳ lạ và ý nghĩa tôn giáo to lớn đã mang lại cho Kailash một vị thế "độc tôn".</p>
            </div>
          </div>

          <div id="tru-cot-vu-tru" class="scroll-mt-28">
            <h2 class="font-serif text-2xl lg:text-[28px] font-bold text-slate-900 border-b-2 border-amber-500 pb-2 inline-block mb-6">Vì sao Kailash được gọi là "Trục vũ trụ"?</h2>
            <div class="prose prose-slate max-w-none prose-p:leading-relaxed prose-p:text-[15.5px] prose-p:text-slate-700">
                <p>Từ hàng nghìn năm nay, trong nhiều nền văn hóa và hệ thống tín ngưỡng cổ đại, Kailash được xem là <strong>“Axis Mundi” - Trục vũ trụ</strong> hay <strong>Cột chống trời</strong>. Nó được coi là điểm trung tâm, nơi nối liền trần gian với thiên giới.</p>
                <p>Điều này xuất phát từ địa thế đặc biệt của ngọn núi: nguồn cội của bốn dòng sông lớn chảy về bốn hướng, mang nguồn nước và sự sống cho cả tiểu lục địa Ấn Độ và Tây Tạng.</p>
            </div>

            <div id="y-nghia-ton-giao" class="scroll-mt-28 mt-8 prose prose-slate max-w-none prose-p:leading-relaxed prose-p:text-[15.5px] prose-p:text-slate-700">
                <h3 class="font-serif text-xl lg:text-2xl font-bold text-slate-800 mb-4">Ý nghĩa của Kailash trong các tôn giáo</h3>
                <ul>
                    <li><strong>Trong Ấn Độ giáo (Hinduism)</strong>: Kailash là ngai vàng ngự trị của thần <strong>Shiva</strong>, vị thần Hủy diệt và Tái sinh. Ngài ngồi thiền định tuyệt đối trên đỉnh núi cùng với vợ ngài là nữ thần Parvati.</li>
                    <li><strong>Trong Phật giáo Tây Tạng</strong>: Núi Kailash <strong>được xem là trung tâm của năng lượng giác ngộ theo quan niệm Phật giáo Tây Tạng</strong>, là ngôi nhà của Phật Cổ Lỗn Đôn (Chakrasamvara / Demchok).</li>
                    <li><strong>Kỳ Na giáo (Jainism)</strong>: Đây là nơi Tirthankara đầu tiên, ngài Rishabhanatha, đạt được <strong>giác ngộ tối thượng</strong> (Moksha) và giải thoát khỏi vòng luân hồi. Ngọn núi được người Jain gọi là đỉnh Ashtapada.</li>
                    <li><strong>Đạo Bon (Tín ngưỡng bản địa Tây Tạng)</strong>: Trước khi Phật giáo du nhập vào thế kỷ thứ 7, Kailash đã là một ngọn núi thiêng của đạo Bon. Họ gọi đây là "Ngọn núi Chữ vạn" bao trùm linh hồn của vùng đất.</li>
                </ul>

                {/* Góc nhìn văn hoá */}
                <div class="mt-6 bg-slate-50 border-l-4 border-amber-500 p-5 rounded-r-lg">
                    <p class="mb-2"><strong class="text-amber-700">Góc nhìn Văn hoá (Cultural Insight):</strong> Sự giao thoa tôn giáo thú vị nhất ở đây được thể hiện rõ qua nghi thức đi vòng quanh núi. Trong khi tín đồ Phật giáo và Ấn Độ giáo đi Kora <strong>theo chiều kim đồng hồ</strong>, thì tín đồ của đạo Bon lại thực hiện vòng Kora <strong>ngược chiều kim đồng hồ</strong>. Đây là cách phân biệt rất độc đáo và thú vị nếu bạn có cơ hội quan sát trực tiếp các đoàn hành hương trên núi.</p>
                </div>
