            </figure>

            <div id="hanh-huong-dac-biet" class="scroll-mt-28 mt-8 prose prose-slate max-w-none prose-p:leading-relaxed prose-p:text-[15.5px] prose-p:text-slate-700">
                <h3 class="font-serif text-xl lg:text-2xl font-bold text-slate-800 mb-4">Hành hương Kailash có gì đặc biệt?</h3>
                
                {/* EEAT Block */}
                <div class="my-6 bg-emerald-50 border border-emerald-100 rounded-xl p-6 italic text-slate-700 relative overflow-hidden">
                    <div class="absolute -right-4 -top-4 text-emerald-200/50 rotate-12">
