---
import BaseLayout from '../layouts/BaseLayout.astro';
import App from '../components/ReactApp/Milestone150/App';
import SnippetBlock from '../components/shortcodes/SnippetBlock.astro';
import { env } from 'cloudflare:workers';
import { safeQueryCritical } from '../lib/db-client';

let postData: any = null;
let adminEditUrl = "";
let himalayaToursSnippet = null;

const d1Db = env?.dulichcoguu_d1;
if (d1Db) {
  try {
    // 1. Kiểm tra bảng Post
    postData = await safeQueryCritical(
      d1Db.prepare("SELECT * FROM Post WHERE slug = ? LIMIT 1").bind("cot-moc-150-chuyen-di-himalaya").first(),
      { route: Astro.url.pathname, slug: "cot-moc-150-chuyen-di-himalaya", queryType: "fetch_landing_post" }
    );
    if (postData && postData.id) {
      adminEditUrl = `/admin/posts/edit?id=${postData.id}`;
    } else {
      // 2. Kiểm tra bảng Page (nếu user tạo dưới dạng Page)
      const pageData: any = await safeQueryCritical(
        d1Db.prepare("SELECT * FROM Page WHERE slug = ? LIMIT 1").bind("cot-moc-150-chuyen-di-himalaya").first(),
        { route: Astro.url.pathname, slug: "cot-moc-150-chuyen-di-himalaya", queryType: "fetch_landing_page" }
      );
      if (pageData && pageData.id) {
        postData = pageData;
        adminEditUrl = `/admin/pages/edit?id=${pageData.id}`;
      }
    }
    
    // Fetch Snippet for Tours
    himalayaToursSnippet = await safeQueryCritical(
      d1Db.prepare("SELECT * FROM Snippet WHERE slug = 'himalaya-tours'").first(),
      { route: Astro.url.pathname, slug: "himalaya-tours", queryType: "fetch_snippet" }
    );
  } catch (e) {
    console.log("Could not fetch post metadata from D1:", e);
  }
}

const dataMap = {
  snippets: {
    'himalaya-tours': himalayaToursSnippet
  }
};

const featuredImage = postData?.featuredImage || "";
const seoTitle = postData?.seoTitle || postData?.title || "Cột mốc 150+ Hành trình Himalaya | FIT TOUR";
const seoDesc = postData?.seoDescription || postData?.excerpt || postData?.description || "Hơn 150 hành trình Himalaya là kết quả của quá trình khảo sát, vận hành, lắng nghe và điều chỉnh để mỗi hành trình sau tốt hơn hành trình trước. Cùng FIT TOUR nhìn lại cột mốc đặc biệt này.";
---

<BaseLayout 
  title={seoTitle}
  description={seoDesc}
  image={featuredImage || "https://media.fittour.vn/uploads/2022/09/binh-minh-tren-day-nui-himalayas.webp"}
  isFullWidth={true}
  canonical="https://thericetour.com/cot-moc-150-chuyen-di-himalaya"
  adminEditUrl={adminEditUrl}
  schemaType="Article"
>
  <Fragment slot="head">
    <meta property="og:type" content="article" />
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400;1,600;1,700&display=swap">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400;1,600;1,700&display=swap" media="print" onload="this.media='all'">
  </Fragment>

  <App client:load featuredImage={featuredImage}>
    <div slot="toursSnippet">
      <SnippetBlock name="himalaya-tours" dataMap={dataMap} />
    </div>
  </App>
  
  <script is:inline>
    // Generic logic for draggable snippets (like emagazine slider style)
    function initSnippetDrag() {
      const sliders = document.querySelectorAll('.snippet-wrapper .overflow-x-auto, .snippet-wrapper [id^="slider-"]');
      sliders.forEach(slider => {
        let isDown = false;
        let startX = 0;
        let scrollLeft = 0;
        slider.addEventListener('mousedown', (e) => {
          isDown = true;
          slider.style.cursor = 'grabbing';
          startX = e.pageX - slider.offsetLeft;
          scrollLeft = slider.scrollLeft;
        });
        slider.addEventListener('mouseleave', () => {
          isDown = false;
          slider.style.cursor = 'grab';
        });
        slider.addEventListener('mouseup', () => {
          isDown = false;
          slider.style.cursor = 'grab';
        });
        slider.addEventListener('mousemove', (e) => {
          if (!isDown) return;
          e.preventDefault();
          const x = e.pageX - slider.offsetLeft;
          const walk = (x - startX) * 2;
          slider.scrollLeft = scrollLeft - walk;
        });
      });
    }
    document.addEventListener("DOMContentLoaded", initSnippetDrag);
    document.addEventListener("astro:page-load", initSnippetDrag);
  </script>
</BaseLayout>
