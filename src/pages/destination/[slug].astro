---
import { env } from 'cloudflare:workers';
import BaseLayout from '@/layouts/BaseLayout.astro';
import JsonLdSchema from '@/components/seo/JsonLdSchema.astro';
import { safeQueryCritical, safeQueryOptional } from '@/lib/db-client';

const { slug } = Astro.params;
const d1Db = env?.dulichcoguu_d1;

if (!d1Db) {
  return Astro.rewrite("/500");
}

// Fetch Destination
let destination;
try {
  destination = await safeQueryCritical(
    d1Db.prepare("SELECT * FROM Country WHERE slug = ?").bind(slug).first<any>(),
    { route: Astro.url.pathname, slug, queryType: "fetch_destination_by_slug" }
  );
} catch (e) {
  return Astro.rewrite("/500");
}

if (!destination) {
  return new Response("Destination not found", { status: 404 });
}

// Fetch Linked Tours
let linkedTours: any[] = [];
try {
  const res = await safeQueryOptional(
    d1Db.prepare(`
      SELECT t.* FROM Tour t
      JOIN TourCountry tc ON t.id = tc.tour_id
      WHERE tc.country_slug = ? AND t.status = 'published' AND (t.badge IS NULL OR t.badge != 'inactive')
      ORDER BY tc.display_order ASC, t.createdAt DESC
    `).bind(slug).all<any>(),
    { results: [] },
    { route: Astro.url.pathname, slug, queryType: "fetch_destination_linked_tours" }
  );
  linkedTours = res?.results || [];
} catch (e) {
  console.error('TourCountry query error:', e);
}

// Other Destinations
let otherDestinations: any[] = [];
try {
  const res = await safeQueryOptional(
    d1Db.prepare(`
      SELECT slug, name, featuredImage, continent FROM Country
      WHERE slug != ? AND featuredImage IS NOT NULL AND featuredImage != ''
      ORDER BY display_order ASC, name ASC LIMIT 4
    `).bind(slug).all<any>(),
    { results: [] },
    { route: Astro.url.pathname, slug, queryType: "fetch_other_destinations" }
  );
  otherDestinations = res?.results || [];
} catch (e) {
  console.error('Other destinations query error:', e);
}

const title = destination.metaTitle || `${destination.name} Tours & Expeditions | The Rice Tour`;
const description = destination.metaDescription || `Explore bespoke journeys and authentic travel experiences in ${destination.name} with The Rice Tour.`;
const image = destination.featuredImage || 'https://images.unsplash.com/photo-1528127269322-539801943592?auto=format&fit=crop&w=1200&q=80';
---

<BaseLayout title={title} description={description} image={image}>
  <JsonLdSchema 
    type="custom"
    data={{
      "@context": "https://schema.org",
      "@type": "Place",
      name: destination.name,
      description: description,
      image: image,
      url: `https://thericetour.com/destination/${destination.slug}`
    }}
  />

  <main class="destination-detail bg-gray-50 text-gray-900 min-h-screen">
    <!-- Hero Banner -->
    <section class="relative h-[60vh] min-h-[440px] flex items-end pb-14 overflow-hidden border-b border-gray-200">
      <img 
        src={image} 
        alt={destination.name} 
        class="absolute inset-0 w-full h-full object-cover object-center scale-105" 
      />
      <div class="absolute inset-0 bg-gradient-to-t from-gray-950/80 via-gray-950/40 to-gray-950/20"></div>

      <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full z-10 text-white">
        <nav class="flex items-center gap-2 text-xs font-bold uppercase tracking-widest text-brand-300 mb-4">
          <a href="/" class="hover:underline">Home</a>
          <span>/</span>
          <a href="/destinations" class="hover:underline">Destinations</a>
          <span>/</span>
          <span class="text-white/80">{destination.name}</span>
        </nav>

        <h1 class="text-4xl md:text-6xl font-serif font-bold text-white tracking-tight mb-4 drop-shadow-lg">
          {destination.name}
        </h1>

        <div class="flex flex-wrap gap-3 text-xs sm:text-sm text-white/90">
          <span class="px-3.5 py-1 rounded-full bg-white/20 backdrop-blur-md border border-white/30 font-semibold">
            📍 Region: <strong class="text-brand-300">{destination.continent || 'Vietnam'}</strong>
          </span>
          {destination.bestTimeToVisit && (
            <span class="px-3.5 py-1 rounded-full bg-white/20 backdrop-blur-md border border-white/30 font-semibold">
              ☀️ Best Season: <strong class="text-brand-300">{destination.bestTimeToVisit}</strong>
            </span>
          )}
          <span class="px-3.5 py-1 rounded-full bg-white/20 backdrop-blur-md border border-white/30 font-semibold">
            ✈️ Featured Journeys: <strong class="text-brand-300">{linkedTours.length} {linkedTours.length === 1 ? 'Tour' : 'Tours'}</strong>
          </span>
        </div>
      </div>
    </section>

    <!-- Overview Section -->
    {destination.description && (
      <section class="py-14 border-b border-gray-200 bg-white">
        <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
          <div class="prose prose-lg max-w-none text-gray-700 leading-relaxed font-light font-sans" set:html={destination.description}>
          </div>
        </div>
      </section>
    )}

    <!-- Linked Tours Section -->
    <section class="py-16 md:py-24 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-12">
        <div>
          <span class="text-xs font-bold uppercase tracking-widest text-brand-600">Curated Itineraries</span>
          <h2 class="text-3xl md:text-4xl font-serif font-bold text-gray-900 mt-2">
            Signature Journeys in {destination.name}
          </h2>
        </div>
        <p class="text-gray-600 text-sm mt-2 md:mt-0 max-w-md">
          Private, flexible, and all-inclusive guided experiences crafted by local insiders.
        </p>
      </div>

      {linkedTours.length === 0 ? (
        <div class="bg-white rounded-3xl p-12 text-center border border-gray-200 shadow-sm">
          <div class="text-4xl mb-4">🌾</div>
          <h3 class="text-xl font-serif font-bold text-gray-900 mb-2">Bespoke Expeditions Available</h3>
          <p class="text-gray-600 max-w-lg mx-auto mb-6">
            We are designing new public itineraries for {destination.name}. In the meantime, our private concierges can tailor a fully customized journey for your group.
          </p>
          <a href="/tailor-made" class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-brand-600 text-white font-bold hover:bg-brand-700 transition-colors shadow-md">
            Design Tailor-Made Trip ➔
          </a>
        </div>
      ) : (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {linkedTours.map((tour) => (
            <article class="group bg-white rounded-3xl overflow-hidden border border-gray-200 hover:border-brand-200 transition-all duration-300 shadow-sm hover:shadow-xl flex flex-col">
              <div class="relative h-60 overflow-hidden bg-gray-100">
                <img 
                  src={tour.featuredImage || 'https://images.unsplash.com/photo-1528127269322-539801943592?w=800'} 
                  alt={tour.title} 
                  loading="lazy" 
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" 
                />
                <div class="absolute inset-0 bg-gradient-to-t from-gray-900/60 via-transparent to-transparent"></div>
                {tour.days && (
                  <div class="absolute bottom-3 left-4">
                    <span class="px-3 py-1 rounded-full text-xs font-bold bg-white/90 backdrop-blur-md text-gray-900 shadow-sm">
                      ⏱️ {tour.days}
                    </span>
                  </div>
                )}
                {tour.price_text && (
                  <div class="absolute bottom-3 right-4">
                    <span class="px-3 py-1 rounded-full text-xs font-bold bg-brand-600 text-white shadow-sm">
                      From {tour.price_text}
                    </span>
                  </div>
                )}
              </div>
              <div class="p-6 flex-1 flex flex-col justify-between">
                <div>
                  <h3 class="text-xl font-serif font-bold text-gray-900 group-hover:text-brand-600 transition-colors mb-3">
                    <a href={`/tour/${tour.slug}`}>
                      {tour.title}
                    </a>
                  </h3>
                  <p class="text-gray-600 text-sm line-clamp-3 mb-4 leading-relaxed">
                    {tour.excerpt || 'An authentic journey through picturesque landscapes and rich local culture.'}
                  </p>
                </div>
                <div class="pt-4 border-t border-gray-100 flex items-center justify-between">
                  <span class="text-xs text-gray-500 font-medium">100% Private Tour</span>
                  <a href={`/tour/${tour.slug}`} class="text-brand-600 font-bold text-sm hover:underline flex items-center gap-1">
                    View Details ➔
                  </a>
                </div>
              </div>
            </article>
          ))}
        </div>
      )}
    </section>

    <!-- Other Destinations -->
    {otherDestinations.length > 0 && (
      <section class="py-16 border-t border-gray-200 bg-white">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <h2 class="text-2xl font-serif font-bold text-gray-900 mb-8">
            Explore More Vietnam Destinations
          </h2>
          <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
            {otherDestinations.map((od) => (
              <a href={`/destination/${od.slug}`} class="group relative rounded-2xl overflow-hidden h-40 border border-gray-200 hover:border-brand-300 shadow-sm hover:shadow-lg transition-all block">
                <img src={od.featuredImage} alt={od.name} class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" />
                <div class="absolute inset-0 bg-gradient-to-t from-gray-950/80 via-gray-950/30 to-transparent"></div>
                <div class="absolute bottom-3 left-3 right-3">
                  <div class="text-sm font-serif font-bold text-white group-hover:text-brand-300 transition-colors truncate">{od.name}</div>
                  <div class="text-xs text-white/80">{od.continent || 'Vietnam'}</div>
                </div>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}
  </main>
</BaseLayout>
