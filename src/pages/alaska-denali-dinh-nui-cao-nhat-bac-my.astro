---
import BaseLayout from '@/layouts/BaseLayout.astro';
import '@/styles/alaska-app.css';
import App from '@/components/ReactApp/AlaskaApp/App.tsx';
import { PART3_CONFIG } from '@/components/ReactApp/AlaskaApp/data/alaskaData.ts';

import { env } from 'cloudflare:workers';
import { safeQueryCritical } from '@/lib/db-client';
import { getCanonicalMediaUrl } from '@/lib/imageOptimization';

let postData: any = null;
let adminEditUrl = "/admin/posts";

try {
  const d1Db = env?.dulichcoguu_d1;
  if (d1Db) {
    postData = await safeQueryCritical(
      d1Db.prepare("SELECT * FROM Post WHERE slug = ?").bind("alaska-denali-dinh-nui-cao-nhat-bac-my").first<any>(),
      { route: Astro.url.pathname, slug: "alaska-denali-dinh-nui-cao-nhat-bac-my", queryType: "fetch_post_by_slug" }
    );
    if (postData) {
      adminEditUrl = `/admin/posts/edit?id=${postData.id}`;
    }
  }
} catch (e) {
  console.log("Could not fetch post metadata:", e);
}

const rawFeaturedImage = postData?.featuredImage || "https://media.fittour.vn/uploads/song-bang-va-day-nui-tuyet-alaska.webp";
const featuredImage = rawFeaturedImage.startsWith('http') ? rawFeaturedImage : getCanonicalMediaUrl(rawFeaturedImage);
---
<BaseLayout
  title={postData?.title || "Alaska: Denali – Đỉnh Núi Cao Nhất Bắc Mỹ Và Biểu Tượng Của Vùng Đất Hoang Dã (Phần 3)"}
  description={postData?.description || "Khám phá Denali - Đỉnh núi cao nhất Bắc Mỹ, biểu tượng của vùng hoang dã Alaska, nơi thiên nhiên vẫn là nhân vật chính giữa băng hà và núi tuyết."}
  image={featuredImage}
  canonical="https://thericetour.com/alaska-denali-dinh-nui-cao-nhat-bac-my"
  adminEditUrl={adminEditUrl}
 preloadImages={[featuredImage]}
>
  <Fragment slot="head">
    <meta property="og:type" content="article" />
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400;1,500&family=Montserrat:wght@100;200;300;400;500;600;700&family=Space+Grotesk:wght@300;400;500;600;700&family=JetBrains+Mono:wght@300;400;500&family=Prata&display=swap">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400;1,500&family=Montserrat:wght@100;200;300;400;500;600;700&family=Space+Grotesk:wght@300;400;500;600;700&family=JetBrains+Mono:wght@300;400;500&family=Prata&display=swap" media="print" onload="this.media='all'">
    
    <style is:global>
        @import "tailwindcss";
    </style>
    <style>
      body {
        margin: 0;
        padding: 0;
      }
    </style>
  </Fragment>

  <App client:idle featuredImage={featuredImage} config={PART3_CONFIG} />

  <section class="w-full bg-[#f8fafc] py-20 lg:py-32 font-sans overflow-hidden">
    <div class="max-w-[1000px] mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center mb-20">
        <p class="text-sky-600 uppercase tracking-[0.2em] font-bold text-sm mb-3">Across Time & Tundra</p>
        <h2 class="font-serif text-3xl md:text-[42px] font-bold text-slate-900 leading-tight uppercase">Denali <br/><span class="text-2xl md:text-3xl text-slate-600 mt-2 block capitalize">Hành Trình Hơn 100 Năm Lịch Sử</span></h2>
        <div class="w-24 h-1 bg-sky-500 mx-auto mt-8"></div>
      </div>

      <div class="relative">
        <!-- Vertical line -->
        <div class="absolute left-[28px] md:left-1/2 top-0 bottom-0 w-px bg-slate-200 md:-translate-x-1/2"></div>

        <!-- Event: Thời đại của người bản địa -->
        <div class="relative flex flex-col md:flex-row md:items-center justify-between mb-16 md:mb-20 group">
          <div class="md:w-5/12 pl-20 md:pl-0 md:pr-14 md:text-right order-2 md:order-1 mt-2 md:mt-0">
            <h3 class="text-[22px] font-bold text-slate-900 mb-3 font-serif leading-snug">Thời đại của người bản địa</h3>
            
            
            <ul class="text-slate-600 space-y-2 list-none md:flex md:flex-col md:items-end">
              
                <li class="relative pl-5 md:pl-0 md:pr-5 text-[15px] leading-relaxed">
                  <span class="absolute left-0 md:left-auto md:right-0 top-[8px] w-1.5 h-1.5 bg-sky-400 rounded-full"></span>
                  Người Koyukon Athabascan sinh sống quanh dãy Alaska từ hàng nghìn năm.
                </li>
              
                <li class="relative pl-5 md:pl-0 md:pr-5 text-[15px] leading-relaxed">
                  <span class="absolute left-0 md:left-auto md:right-0 top-[8px] w-1.5 h-1.5 bg-sky-400 rounded-full"></span>
                  Họ gọi ngọn núi là Denali – nghĩa là The Great One (Ngọn Núi Vĩ Đại).
                </li>
              
                <li class="relative pl-5 md:pl-0 md:pr-5 text-[15px] leading-relaxed">
                  <span class="absolute left-0 md:left-auto md:right-0 top-[8px] w-1.5 h-1.5 bg-sky-400 rounded-full"></span>
                  Sống bằng săn bắn caribou, moose, cừu Dall và đánh cá hồi.
                </li>
              
            </ul>
            
          </div>
          <div class="absolute left-[20px] md:left-1/2 md:-translate-x-1/2 w-[18px] h-[18px] rounded-full bg-white border-[5px] border-sky-500 z-10 top-1.5 md:top-auto group-hover:scale-125 group-hover:bg-sky-100 transition-all duration-300 shadow-sm"></div>
          <div class="md:w-5/12 pl-20 md:pl-14 order-1 md:order-2">
            <div class="text-sky-600 font-bold tracking-wider uppercase text-sm mb-1">Hàng nghìn năm trước</div>
          </div>
        </div>

        <!-- Event: Cơn sốt vàng Alaska -->
        <div class="relative flex flex-col md:flex-row md:items-center justify-between mb-16 md:mb-20 group">
          <div class="md:w-5/12 pl-20 md:pl-0 md:pr-14 md:text-left order-2 md:order-2 mt-2 md:mt-0">
            <h3 class="text-[22px] font-bold text-slate-900 mb-3 font-serif leading-snug">Cơn sốt vàng Alaska</h3>
            
            
            <ul class="text-slate-600 space-y-2 list-none ">
              
                <li class="relative pl-5 md:pl-0 pl-5 text-[15px] leading-relaxed">
                  <span class="absolute left-0 top-[8px] w-1.5 h-1.5 bg-sky-400 rounded-full"></span>
                  Hàng nghìn người đổ về Cantishna tìm vàng.
                </li>
              
                <li class="relative pl-5 md:pl-0 pl-5 text-[15px] leading-relaxed">
                  <span class="absolute left-0 top-[8px] w-1.5 h-1.5 bg-sky-400 rounded-full"></span>
                  Những khu định cư nhỏ xuất hiện.
                </li>
              
                <li class="relative pl-5 md:pl-0 pl-5 text-[15px] leading-relaxed">
                  <span class="absolute left-0 top-[8px] w-1.5 h-1.5 bg-sky-400 rounded-full"></span>
                  Thiên nhiên bắt đầu chịu áp lực từ săn bắn và khai thác.
                </li>
              
            </ul>
            
          </div>
          <div class="absolute left-[20px] md:left-1/2 md:-translate-x-1/2 w-[18px] h-[18px] rounded-full bg-white border-[5px] border-sky-500 z-10 top-1.5 md:top-auto group-hover:scale-125 group-hover:bg-sky-100 transition-all duration-300 shadow-sm"></div>
          <div class="md:w-5/12 pl-20 md:pr-14 md:pl-0 md:text-right order-1 md:order-1">
            <div class="text-sky-600 font-bold tracking-wider uppercase text-sm mb-1">Cuối thế kỷ 19</div>
          </div>
        </div>

        <!-- Event: Charles Sheldon và giấc mơ bảo tồn -->
        <div class="relative flex flex-col md:flex-row md:items-center justify-between mb-16 md:mb-20 group">
          <div class="md:w-5/12 pl-20 md:pl-0 md:pr-14 md:text-right order-2 md:order-1 mt-2 md:mt-0">
            <h3 class="text-[22px] font-bold text-slate-900 mb-3 font-serif leading-snug">Charles Sheldon và giấc mơ bảo tồn</h3>
            <p class="text-slate-600 text-[15.5px] leading-relaxed mb-4">Nhà tự nhiên học Charles Sheldon dành nhiều năm nghiên cứu cừu Dall. Ông nhận ra: nếu không bảo vệ, động vật sẽ biến mất, Alaska sẽ mất vùng hoang dã quý giá nhất. Suốt gần 10 năm, Sheldon vận động Quốc hội thành lập công viên quốc gia.</p>
            
          </div>
          <div class="absolute left-[20px] md:left-1/2 md:-translate-x-1/2 w-[18px] h-[18px] rounded-full bg-white border-[5px] border-sky-500 z-10 top-1.5 md:top-auto group-hover:scale-125 group-hover:bg-sky-100 transition-all duration-300 shadow-sm"></div>
          <div class="md:w-5/12 pl-20 md:pl-14 order-1 md:order-2">
            <div class="text-sky-600 font-bold tracking-wider uppercase text-sm mb-1">Khoảng 1906–1916</div>
          </div>
        </div>

        <!-- Event: Mount McKinley National Park ra đời -->
        <div class="relative flex flex-col md:flex-row md:items-center justify-between mb-16 md:mb-20 group">
          <div class="md:w-5/12 pl-20 md:pl-0 md:pr-14 md:text-left order-2 md:order-2 mt-2 md:mt-0">
            <h3 class="text-[22px] font-bold text-slate-900 mb-3 font-serif leading-snug">Mount McKinley National Park ra đời</h3>
            <p class="text-slate-600 text-[15.5px] leading-relaxed mb-4">Quốc hội Hoa Kỳ thông qua đạo luật thành lập công viên. Mục tiêu: Preserve wildlife & Enjoyment of the public. Đây là triết lý bảo tồn nổi tiếng của hệ thống National Park Hoa Kỳ: Bảo tồn thiên nhiên nhưng vẫn để con người được trải nghiệm.</p>
            
            <ul class="text-slate-600 space-y-2 list-none ">
              
                <li class="relative pl-5 md:pl-0 pl-5 text-[15px] leading-relaxed">
                  <span class="absolute left-0 top-[8px] w-1.5 h-1.5 bg-sky-400 rounded-full"></span>
                  Harry Karstens trở thành Superintendent đầu tiên.
                </li>
              
            </ul>
            
          </div>
          <div class="absolute left-[20px] md:left-1/2 md:-translate-x-1/2 w-[18px] h-[18px] rounded-full bg-white border-[5px] border-sky-500 z-10 top-1.5 md:top-auto group-hover:scale-125 group-hover:bg-sky-100 transition-all duration-300 shadow-sm"></div>
          <div class="md:w-5/12 pl-20 md:pr-14 md:pl-0 md:text-right order-1 md:order-1">
            <div class="text-sky-600 font-bold tracking-wider uppercase text-sm mb-1">1917</div>
          </div>
        </div>

        <!-- Event: Những năm đầu gian khổ -->
        <div class="relative flex flex-col md:flex-row md:items-center justify-between mb-16 md:mb-20 group">
          <div class="md:w-5/12 pl-20 md:pl-0 md:pr-14 md:text-right order-2 md:order-1 mt-2 md:mt-0">
            <h3 class="text-[22px] font-bold text-slate-900 mb-3 font-serif leading-snug">Những năm đầu gian khổ</h3>
            <p class="text-slate-600 text-[15.5px] leading-relaxed mb-4">Harry Karstens gần như làm tất cả. Ông phải đối mặt với:</p>
            
            <ul class="text-slate-600 space-y-2 list-none md:flex md:flex-col md:items-end">
              
                <li class="relative pl-5 md:pl-0 md:pr-5 text-[15px] leading-relaxed">
                  <span class="absolute left-0 md:left-auto md:right-0 top-[8px] w-1.5 h-1.5 bg-sky-400 rounded-full"></span>
                  Săn trộm và nấu rượu lậu.
                </li>
              
                <li class="relative pl-5 md:pl-0 md:pr-5 text-[15px] leading-relaxed">
                  <span class="absolute left-0 md:left-auto md:right-0 top-[8px] w-1.5 h-1.5 bg-sky-400 rounded-full"></span>
                  Thời tiết -40°C và núi non hiểm trở.
                </li>
              
                <li class="relative pl-5 md:pl-0 md:pr-5 text-[15px] leading-relaxed">
                  <span class="absolute left-0 md:left-auto md:right-0 top-[8px] w-1.5 h-1.5 bg-sky-400 rounded-full"></span>
                  Vùng đất gần như không có đường.
                </li>
              
                <li class="relative pl-5 md:pl-0 md:pr-5 text-[15px] leading-relaxed">
                  <span class="absolute left-0 md:left-auto md:right-0 top-[8px] w-1.5 h-1.5 bg-sky-400 rounded-full"></span>
                  Park Headquarters chỉ là một cabin gỗ nhỏ.
                </li>
              
            </ul>
            
          </div>
          <div class="absolute left-[20px] md:left-1/2 md:-translate-x-1/2 w-[18px] h-[18px] rounded-full bg-white border-[5px] border-sky-500 z-10 top-1.5 md:top-auto group-hover:scale-125 group-hover:bg-sky-100 transition-all duration-300 shadow-sm"></div>
          <div class="md:w-5/12 pl-20 md:pl-14 order-1 md:order-2">
            <div class="text-sky-600 font-bold tracking-wider uppercase text-sm mb-1">1917–1922</div>
          </div>
        </div>

        <!-- Event: Chỉ có 7 du khách -->
        <div class="relative flex flex-col md:flex-row md:items-center justify-between mb-16 md:mb-20 group">
          <div class="md:w-5/12 pl-20 md:pl-0 md:pr-14 md:text-left order-2 md:order-2 mt-2 md:mt-0">
            <h3 class="text-[22px] font-bold text-slate-900 mb-3 font-serif leading-snug">Chỉ có 7 du khách</h3>
            <p class="text-slate-600 text-[15.5px] leading-relaxed mb-4">Sau 5 năm thành lập, toàn bộ công viên chỉ đón 7 khách. Karstens viết thư: 'Điều Denali cần nhất là một con đường.'</p>
            
          </div>
          <div class="absolute left-[20px] md:left-1/2 md:-translate-x-1/2 w-[18px] h-[18px] rounded-full bg-white border-[5px] border-sky-500 z-10 top-1.5 md:top-auto group-hover:scale-125 group-hover:bg-sky-100 transition-all duration-300 shadow-sm"></div>
          <div class="md:w-5/12 pl-20 md:pr-14 md:pl-0 md:text-right order-1 md:order-1">
            <div class="text-sky-600 font-bold tracking-wider uppercase text-sm mb-1">1922</div>
          </div>
        </div>

        <!-- Event: Xây dựng Denali Park Road -->
        <div class="relative flex flex-col md:flex-row md:items-center justify-between mb-16 md:mb-20 group">
          <div class="md:w-5/12 pl-20 md:pl-0 md:pr-14 md:text-right order-2 md:order-1 mt-2 md:mt-0">
            <h3 class="text-[22px] font-bold text-slate-900 mb-3 font-serif leading-snug">Xây dựng Denali Park Road</h3>
            <p class="text-slate-600 text-[15.5px] leading-relaxed mb-4">Alaska Road Commission cùng National Park Service bắt đầu mở đường. Khó khăn chồng chất:</p>
            
            <ul class="text-slate-600 space-y-2 list-none md:flex md:flex-col md:items-end">
              
                <li class="relative pl-5 md:pl-0 md:pr-5 text-[15px] leading-relaxed">
                  <span class="absolute left-0 md:left-auto md:right-0 top-[8px] w-1.5 h-1.5 bg-sky-400 rounded-full"></span>
                  Mùa hè chỉ kéo dài vài tháng.
                </li>
              
                <li class="relative pl-5 md:pl-0 md:pr-5 text-[15px] leading-relaxed">
                  <span class="absolute left-0 md:left-auto md:right-0 top-[8px] w-1.5 h-1.5 bg-sky-400 rounded-full"></span>
                  Thiếu ngân sách (mùa xây dựng chưa hết đã hết tiền).
                </li>
              
                <li class="relative pl-5 md:pl-0 md:pr-5 text-[15px] leading-relaxed">
                  <span class="absolute left-0 md:left-auto md:right-0 top-[8px] w-1.5 h-1.5 bg-sky-400 rounded-full"></span>
                  Địa hình cực kỳ hiểm trở với băng tan, sông lớn và núi đá.
                </li>
              
            </ul>
            
          </div>
          <div class="absolute left-[20px] md:left-1/2 md:-translate-x-1/2 w-[18px] h-[18px] rounded-full bg-white border-[5px] border-sky-500 z-10 top-1.5 md:top-auto group-hover:scale-125 group-hover:bg-sky-100 transition-all duration-300 shadow-sm"></div>
          <div class="md:w-5/12 pl-20 md:pl-14 order-1 md:order-2">
            <div class="text-sky-600 font-bold tracking-wider uppercase text-sm mb-1">1922–1938</div>
          </div>
        </div>

        <!-- Event: Alaska Railroad hoàn thành -->
        <div class="relative flex flex-col md:flex-row md:items-center justify-between mb-16 md:mb-20 group">
          <div class="md:w-5/12 pl-20 md:pl-0 md:pr-14 md:text-left order-2 md:order-2 mt-2 md:mt-0">
            <h3 class="text-[22px] font-bold text-slate-900 mb-3 font-serif leading-snug">Alaska Railroad hoàn thành</h3>
            <p class="text-slate-600 text-[15.5px] leading-relaxed mb-4">Lần đầu tiên Seward, Anchorage, Interior Alaska và Fairbanks được nối bằng đường sắt. Du khách xuống tại McKinley Station để vào công viên. McKinley Station trở thành một cộng đồng nhỏ gồm:</p>
            
            <ul class="text-slate-600 space-y-2 list-none ">
              
                <li class="relative pl-5 md:pl-0 pl-5 text-[15px] leading-relaxed">
                  <span class="absolute left-0 top-[8px] w-1.5 h-1.5 bg-sky-400 rounded-full"></span>
                  Thợ săn, người tìm vàng, người đặt bẫy thú.
                </li>
              
                <li class="relative pl-5 md:pl-0 pl-5 text-[15px] leading-relaxed">
                  <span class="absolute left-0 top-[8px] w-1.5 h-1.5 bg-sky-400 rounded-full"></span>
                  Công nhân đường sắt và những người thích cuộc sống hoang dã.
                </li>
              
            </ul>
            
          </div>
          <div class="absolute left-[20px] md:left-1/2 md:-translate-x-1/2 w-[18px] h-[18px] rounded-full bg-white border-[5px] border-sky-500 z-10 top-1.5 md:top-auto group-hover:scale-125 group-hover:bg-sky-100 transition-all duration-300 shadow-sm"></div>
          <div class="md:w-5/12 pl-20 md:pr-14 md:pl-0 md:text-right order-1 md:order-1">
            <div class="text-sky-600 font-bold tracking-wider uppercase text-sm mb-1">1923</div>
          </div>
        </div>

        <!-- Event: 12 dặm đường đầu tiên và Savage Camp -->
        <div class="relative flex flex-col md:flex-row md:items-center justify-between mb-16 md:mb-20 group">
          <div class="md:w-5/12 pl-20 md:pl-0 md:pr-14 md:text-right order-2 md:order-1 mt-2 md:mt-0">
            <h3 class="text-[22px] font-bold text-slate-900 mb-3 font-serif leading-snug">12 dặm đường đầu tiên và Savage Camp</h3>
            <p class="text-slate-600 text-[15.5px] leading-relaxed mb-4">Đến cuối mùa hè mới mở được 12 miles (~19 km). Xe bus và xe Studebaker bắt đầu chở khách. Khách nghỉ tại Savage Camp với giá 25 USD bao gồm xe đón, 3 bữa ăn, chỗ ngủ và tour. Camp có sức chứa khoảng 100 khách.</p>
            
            <ul class="text-slate-600 space-y-2 list-none md:flex md:flex-col md:items-end">
              
                <li class="relative pl-5 md:pl-0 md:pr-5 text-[15px] leading-relaxed">
                  <span class="absolute left-0 md:left-auto md:right-0 top-[8px] w-1.5 h-1.5 bg-sky-400 rounded-full"></span>
                  Cuộc sống: ngủ trên da Caribou, ăn đậu hầm, thịt Caribou, bacon và cà phê.
                </li>
              
                <li class="relative pl-5 md:pl-0 md:pr-5 text-[15px] leading-relaxed">
                  <span class="absolute left-0 md:left-auto md:right-0 top-[8px] w-1.5 h-1.5 bg-sky-400 rounded-full"></span>
                  Mọi người đều làm mọi việc. Horse Wrangler cũng rửa chén, dựng lều, nấu ăn.
                </li>
              
            </ul>
            
          </div>
          <div class="absolute left-[20px] md:left-1/2 md:-translate-x-1/2 w-[18px] h-[18px] rounded-full bg-white border-[5px] border-sky-500 z-10 top-1.5 md:top-auto group-hover:scale-125 group-hover:bg-sky-100 transition-all duration-300 shadow-sm"></div>
          <div class="md:w-5/12 pl-20 md:pl-14 order-1 md:order-2">
            <div class="text-sky-600 font-bold tracking-wider uppercase text-sm mb-1">1924</div>
          </div>
        </div>

        <!-- Event: Những du khách đầu tiên & Big Game Drive -->
        <div class="relative flex flex-col md:flex-row md:items-center justify-between mb-16 md:mb-20 group">
          <div class="md:w-5/12 pl-20 md:pl-0 md:pr-14 md:text-left order-2 md:order-2 mt-2 md:mt-0">
            <h3 class="text-[22px] font-bold text-slate-900 mb-3 font-serif leading-snug">Những du khách đầu tiên & Big Game Drive</h3>
            <p class="text-slate-600 text-[15.5px] leading-relaxed mb-4">Từ Savage Camp, xe ngựa hoặc xe hơi đưa khách đi sâu hơn. Thường gặp Dall Sheep, Caribou, Moose, Fox. Đây là tiền thân của Wildlife Tour ngày nay. Từng có ba cô giáo từ Montana lên Alaska chỉ để được nhìn thấy Mount McKinley. Họ gọi đó là Adventure of a Lifetime.</p>
            
          </div>
          <div class="absolute left-[20px] md:left-1/2 md:-translate-x-1/2 w-[18px] h-[18px] rounded-full bg-white border-[5px] border-sky-500 z-10 top-1.5 md:top-auto group-hover:scale-125 group-hover:bg-sky-100 transition-all duration-300 shadow-sm"></div>
