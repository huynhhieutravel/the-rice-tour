---
import { env } from 'cloudflare:workers';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { safeQueryCritical } from '@/lib/db-client';
import { getGlobalSettings } from '@/lib/settingsHelper';
import { MapPin, Info, Users, Clock, Calendar, Compass, Share2, Link as LinkIcon, ChevronRight, CheckCircle2 } from 'lucide-react';
import DataPost from '@/components/shortcodes/data/DataPost.astro';

const d1Db = env?.dulichcoguu_d1;
if (!d1Db) return Astro.rewrite("/500");

// Fetch CMS Data for SEO and Metadata
let post;
try {
  post = await safeQueryCritical(
    d1Db.prepare("SELECT * FROM Post WHERE id = ?").bind('1781570000031').first<any>(),
    { route: Astro.url.pathname, slug: '1781570000031', queryType: "fetch_post_by_id" }
  );
} catch (e) {
  // Ignore
}

if (!post) {
  post = {
    title: 'Seward Highway: Cung Đường Đẹp Nhất Alaska',
    excerpt: 'Được công nhận là All-American Road, Seward Highway là hành trình đưa du khách băng qua những hồ nước xanh ngọc, rừng thông bất tận và dãy núi phủ tuyết.',
    featuredImage: 'https://media.fittour.vn/uploads/alaska-cover.webp',
    id: 1781570000031,
    author: 'Huynh Hieu Travel',
    createdAt: new Date().toISOString()
  };
}

const { settings } = await getGlobalSettings();

const seoTitle = post.seoTitle || post.title || 'Seward Highway: Cung Đường Đẹp Nhất Alaska';
const seoDesc = post.seoDesc || post.excerpt || 'Được công nhận là All-American Road, Seward Highway là hành trình đưa du khách băng qua những hồ nước xanh ngọc, rừng thông bất tận và dãy núi phủ tuyết.';
const seoImage = post.seoImage || post.featuredImage || 'https://media.fittour.vn/uploads/alaska-cover.webp';

// --- DATE LOGIC ---
const createdAtStr = post.createdAt || post.publishedAt || new Date().toISOString();
const updatedAtStr = post.updatedAt || createdAtStr;

const createdAt = new Date(createdAtStr.replace(' ', 'T'));
const updatedAt = new Date(updatedAtStr.replace(' ', 'T'));

const isUpdated = updatedAt.getTime() - createdAt.getTime() > 86400000; 
const displayDate = isUpdated ? updatedAt : createdAt;
const datePrefix = isUpdated ? "Cập nhật:" : "Xuất bản:";

const formattedDate = displayDate.toLocaleDateString('vi-VN', { day: '2-digit', month: '2-digit', year: 'numeric' });

const adminEditUrl = `/admin/posts/edit?id=1781570000031`;

// TOC Data
const toc = [
  { id: "gioi-thieu", title: "Giới thiệu", icon: "🏠" },
  { id: "co-gi-dac-biet", title: "Seward Highway Có Gì Đặc Biệt?" },
  { id: "kenai-lake", title: "Kenai Lake – Viên Ngọc Xanh" },
  { id: "kenai-mountains", title: "Kenai Mountains – Dãy Núi Không Rời" },
  { id: "turnagain-arm", title: "Turnagain Arm – Nơi Núi Và Biển Gặp Nhau" },
  { id: "diem-dung", title: "Những Điểm Dừng Không Thể Bỏ Qua" },
  { id: "vi-sao-fit-tour", title: "Vì Sao FIT TOUR Luôn Dành Thời Gian?" },
  { id: "ket-luan", title: "Không Chỉ Là Một Tuyến Đường" },
  { id: "cau-hoi-thuong-gap", title: "Những Câu Hỏi Thường Gặp Về Seward Highway" }
];

const faqs = [
  {
    question: "Nên đi Seward Highway vào thời gian nào?",
    answer: "<p>Mùa hè (từ tháng 5 đến tháng 9) là thời điểm tuyệt vời nhất để trải nghiệm tuyến đường này. Tuyết đã tan trên đường, cây cối xanh tươi, động vật hoang dã hoạt động mạnh và ngày dài hơn. Tuy nhiên, thời tiết có thể thay đổi nhanh nên bạn vẫn cần mang áo khoác mỏng.</p>"
  },
  {
    question: "Có dễ dàng dừng xe để ngắm cảnh không?",
    answer: "<p>Rất dễ dàng. Dọc tuyến đường có rất nhiều điểm quan sát an toàn (pull-outs) được thiết kế đặc biệt để du khách có thể tấp xe vào, chụp ảnh và ngắm cảnh mà không cản trở giao thông.</p>"
  },
  {
    question: "Nên dành bao nhiêu thời gian cho cung đường này?",
    answer: "<p>Mặc dù chỉ dài khoảng 200km và mất chưa tới 3 tiếng lái xe liên tục, nhưng FIT TOUR khuyên bạn nên dành trọn một ngày hoặc ít nhất là nửa ngày cho Seward Highway để có thể thong thả tận hưởng các điểm dừng như Turnagain Arm, Beluga Point và Kenai Lake.</p>"
  },
  {
    question: "Seward Highway có sóng điện thoại không?",
    answer: "<p>Tín hiệu có thể bị chập chờn hoặc hoàn toàn không có sóng ở một số đoạn khi đi sâu vào vùng núi Kenai. Bạn nên tải sẵn bản đồ offline hoặc đi theo đoàn có hệ thống liên lạc tốt như FIT TOUR.</p>"
  }
];

---

<BaseLayout 
  title={seoTitle} 
  description={seoDesc} 
  image={seoImage}
  adminEditUrl={adminEditUrl}
>
  <div class="bg-[#F8F9FA] text-[#1E293B] font-sans antialiased selection:bg-[#0284c7] selection:text-white">

    {/* ================= HERO SECTION ================= */}
    <section class="relative w-full h-[600px] lg:h-[650px] overflow-hidden">
      <div class="absolute inset-0 z-0 bg-slate-900">
        <img src={seoImage} alt="Seward Highway" class="w-full h-full object-cover object-center opacity-80" fetchpriority="high" loading="eager" />
        <div class="absolute inset-0 bg-gradient-to-r from-black/80 via-black/50 to-transparent"></div>
        <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-transparent to-transparent"></div>
      </div>

      <div class="relative z-10 max-w-[1600px] mx-auto px-4 sm:px-6 lg:px-12 h-full flex flex-col justify-center pt-20 pb-16">
        
        {/* Breadcrumb */}
        <div class="flex items-center gap-2 text-[13px] text-slate-200 font-medium mb-6">
          <a href="/" class="hover:text-white transition-colors">Trang chủ</a>
          <ChevronRight class="w-3 h-3" />
          <a href="/blog" class="hover:text-white transition-colors">Blog</a>
          <ChevronRight class="w-3 h-3" />
          <span class="text-white">Alaska</span>
        </div>

        {/* Titles */}
        <h1 class="font-serif text-4xl sm:text-5xl lg:text-6xl font-bold text-white mb-4 leading-[1.1] drop-shadow-lg max-w-4xl">
          Seward Highway: Cung Đường Đẹp Nhất Alaska
        </h1>
        <h2 class="font-serif text-xl sm:text-3xl text-sky-400 italic mb-10 max-w-3xl drop-shadow-md">
          Hành trình All-American Road băng qua rừng, núi, và biển băng
        </h2>
        <p class="text-white/90 text-base sm:text-lg max-w-2xl leading-relaxed mb-8 hidden md:block drop-shadow-md font-medium">
          Từ thị trấn cảng Seward yên bình đến thành phố Anchorage sôi động, băng qua hồ nước xanh ngọc, rừng thông bất tận và vịnh biển kỳ vĩ nơi cá voi Beluga bơi lội sát bờ.
        </p>

        {/* Author Meta */}
        <div class="flex flex-wrap items-center gap-6 text-sm text-white/80 border-t border-white/20 pt-6 max-w-3xl">
          <a href="/huynh-hieu" class="flex items-center gap-3 group">
            <img src="https://media.fittour.vn/uploads/huynhhieutravel.webp" alt="Huynh Hieu" class="w-10 h-10 rounded-full border-2 border-white/30 object-cover object-top group-hover:border-sky-400 transition-colors" />
            <span class="font-bold text-white group-hover:text-sky-400 transition-colors flex items-center gap-1">
              {post?.author || 'Huynh Hieu Travel'} 
              <CheckCircle2 class="w-4 h-4 text-blue-400" />
            </span>
          </a>
          <div class="flex items-center gap-2 bg-white/10 px-4 py-2 rounded-full backdrop-blur-sm border border-white/10">
            <Calendar class="w-4 h-4 opacity-70" />
            <span>{datePrefix} {formattedDate}</span>
          </div>
          <div class="flex items-center gap-2 bg-black/20 px-3 py-1.5 rounded-full backdrop-blur-sm">
            <Clock class="w-4 h-4 text-sky-400" />
            <span>5 phút đọc</span>
          </div>
        </div>

        {/* Badges Line */}
        <div class="flex flex-wrap items-center gap-4 mt-8 pt-6">
          <div class="flex items-center gap-2 text-sm text-white font-medium bg-black/60 backdrop-blur-md px-4 py-2 border border-white/10 rounded-lg shadow-xl">
            <span class="text-sky-400 text-lg">🛣️</span> All-American Road
          </div>
          <div class="flex items-center gap-2 text-sm text-white font-medium bg-black/60 backdrop-blur-md px-4 py-2 border border-white/10 rounded-lg shadow-xl">
            <span class="text-sky-400 text-lg">🐋</span> Turnagain Arm
          </div>
          <div class="flex items-center gap-2 text-sm text-white font-medium bg-black/60 backdrop-blur-md px-4 py-2 border border-white/10 rounded-lg shadow-xl">
            <span class="text-sky-400 text-lg">🏔️</span> Kenai Mountains
          </div>
          <div class="flex items-center gap-2 text-sm text-white font-medium bg-black/60 backdrop-blur-md px-4 py-2 border border-white/10 rounded-lg shadow-xl">
            <span class="text-sky-400 text-lg">🌲</span> Rừng Taiga
          </div>
        </div>

      </div>
    </section>

    {/* ================= MAIN CONTENT GRID ================= */}
    <div class="max-w-[1600px] mx-auto px-4 sm:px-6 lg:px-12 py-12 lg:py-16">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-start">

        {/* ---------------- LEFT SIDEBAR (TOC) ---------------- */}
        <aside class="hidden lg:block lg:col-span-3 sticky top-24">
          <div class="bg-white rounded-2xl shadow-sm border border-slate-200/60 p-6 overflow-hidden">
            <div class="flex items-center gap-2 font-bold text-slate-800 mb-6 border-l-4 border-sky-500 pl-3 text-sm tracking-wide uppercase">
              Mục lục bài viết
            </div>
            
            <nav class="space-y-1 text-[13.5px] font-medium">
              <a href="#gioi-thieu" class="flex items-center gap-2 text-sky-700 bg-sky-50 px-3 py-2.5 rounded-lg transition-colors font-bold">
                <span class="text-sky-500 text-base">🏠</span> Giới thiệu
              </a>
              
              <div class="pt-2 pb-1">
                <div class="pl-3 pr-3 space-y-1.5 mt-1 border-l border-slate-100 ml-[12px] max-h-[600px] overflow-y-auto custom-scrollbar">
                  {toc.slice(1).map((m) => (
                    <a href={`#${m.id}`} class="block text-slate-600 hover:text-sky-600 text-[13.5px] py-1.5 transition-colors leading-tight border-b border-slate-50 last:border-0">
                      {m.title}
                    </a>
                  ))}
                </div>
              </div>
            </nav>
          </div>
        </aside>

        {/* ---------------- CENTER COLUMN (MAIN CONTENT) ---------------- */}
        <main class="col-span-1 lg:col-span-6 space-y-10">
          
          {/* Quick Overview Stats Bar */}
          <div class="bg-white rounded-2xl shadow-sm border border-slate-200/60 p-6 flex flex-wrap lg:flex-nowrap items-center justify-between gap-4">
            
            <div class="w-full flex items-center justify-between gap-4 mb-2 lg:hidden">
              <span class="font-bold text-slate-800 text-sm border-l-4 border-sky-500 pl-2 uppercase">Tổng Quan Nhanh</span>
            </div>

            <div class="flex items-center gap-3 w-[48%] lg:w-auto">
              <div class="w-10 h-10 rounded-full bg-emerald-50 flex items-center justify-center text-emerald-600 text-xl border border-emerald-100 shrink-0">📍</div>
              <div>
                <div class="text-[11px] text-slate-500 font-medium">Lộ trình</div>
                <div class="text-[13px] font-bold text-slate-800">Seward – Anchorage</div>
              </div>
            </div>

            <div class="hidden lg:block w-px h-8 bg-slate-200"></div>

            <div class="flex items-center gap-3 w-[48%] lg:w-auto">
              <div class="w-10 h-10 rounded-full bg-sky-50 flex items-center justify-center text-sky-600 text-xl border border-sky-100 shrink-0">📏</div>
              <div>
                <div class="text-[11px] text-slate-500 font-medium">Độ dài</div>
                <div class="text-[13px] font-bold text-slate-800">Khoảng 200 km</div>
              </div>
            </div>

            <div class="hidden lg:block w-px h-8 bg-slate-200"></div>

            <div class="flex items-center gap-3 w-[48%] lg:w-auto mt-2 lg:mt-0">
              <div class="w-10 h-10 rounded-full bg-rose-50 flex items-center justify-center text-rose-600 text-xl border border-rose-100 shrink-0">🏆</div>
              <div>
                <div class="text-[11px] text-slate-500 font-medium">Danh hiệu</div>
                <div class="text-[13px] font-bold text-slate-800">All-American Road</div>
              </div>
            </div>

            <div class="hidden lg:block w-px h-8 bg-slate-200"></div>

            <div class="flex items-center gap-3 w-[48%] lg:w-auto mt-2 lg:mt-0">
              <div class="w-10 h-10 rounded-full bg-amber-50 flex items-center justify-center text-amber-600 text-xl border border-amber-100 shrink-0">📸</div>
              <div>
                <div class="text-[11px] text-slate-500 font-medium">Điểm nhấn</div>
                <div class="text-[13px] font-bold text-slate-800">Hồ băng & Vịnh biển</div>
              </div>
            </div>
          </div>

          {/* Main Article Content */}
          <div class="prose prose-slate max-w-none prose-p:leading-relaxed prose-p:text-[16px] prose-p:text-slate-700 prose-headings:font-serif prose-headings:text-slate-900 prose-strong:text-slate-900">
            
            <div id="gioi-thieu" class="scroll-mt-28">
              <p>Nối liền thị trấn cảng Seward và thành phố Anchorage, Seward Highway kéo dài khoảng 200 km, băng qua những hồ nước xanh ngọc, rừng thông bạt ngàn, núi tuyết và các vịnh biển nơi thỉnh thoảng có cá voi Beluga xuất hiện sát bờ.</p>
              
              <figure class="my-8">
                <img src="https://media.fittour.vn/uploads/2025/11/Map-tour-alaska-fittour.webp" alt="Seward Highway Alaska" loading="lazy" class="w-full rounded-xl shadow-sm border border-slate-200" />
                <figcaption class="text-center text-sm text-slate-500 mt-3 font-medium">Bản đồ tuyến đường Seward Highway chạy dọc bán đảo Kenai.</figcaption>
              </figure>
              
              <p>Mang danh hiệu <strong>All-American Road</strong> – mức xếp hạng cao nhất cho các tuyến đường phong cảnh tại Mỹ, Seward Highway luôn nằm trong danh sách những cung đường đẹp nhất Bắc Mỹ.</p>
              <p>Trên các hành trình của FIT TOUR, quãng đường này thường mang lại nhiều cảm xúc bởi mỗi khúc cua lại mở ra một góc nhìn mới lạ về thiên nhiên hoang dã.</p>
            </div>

            <div id="co-gi-dac-biet" class="scroll-mt-28 mt-8">
              <h2 class="text-2xl lg:text-[28px] font-bold border-b-2 border-sky-500 pb-2 inline-block mb-6 !mt-0">Seward Highway Có Gì Đặc Biệt?</h2>
              <p>Sự thú vị của tuyến đường này nằm ở sự thay đổi cảnh quan liên tục. Chỉ trong vài giờ lái xe, bạn sẽ lần lượt đi qua:</p>
              <ul>
                <li>Bờ biển <strong>Turnagain Arm</strong> trải dài;</li>
                <li>Dãy núi <strong>Kenai Mountains</strong> sừng sững;</li>
                <li>Hồ băng <strong>Kenai Lake</strong> xanh trong;</li>
                <li>Rừng thông Taiga đặc trưng;</li>
                <li>Những dòng sông băng tan chảy từ đỉnh núi;</li>
                <li>Các thị trấn nhỏ yên bình.</li>
              </ul>
            </div>

            <div id="kenai-lake" class="scroll-mt-28 mt-8">
              <h2 class="text-2xl lg:text-[28px] font-bold border-b-2 border-sky-500 pb-2 inline-block mb-6 !mt-0">Kenai Lake – Viên Ngọc Xanh Của Bán Đảo Kenai</h2>
              
              <figure class="my-6">
                <img src="https://media.fittour.vn/uploads/kenai-lake-alaska.webp" alt="Kenai Lake Alaska" loading="lazy" class="w-full rounded-xl shadow-sm border border-slate-200" />
                <figcaption class="text-center text-sm text-slate-500 mt-3 font-medium">Mặt hồ xanh ngọc phẳng lặng như gương tại Kenai Lake.</figcaption>
              </figure>
              
              <p>Một trong những điểm dừng ấn tượng nhất là <strong>Kenai Lake</strong>.</p>
              <p>Hồ nước dài hơn 35 km này hình thành từ các dòng sông băng cổ đại, mang màu xanh ngọc lấp lánh nhờ lớp bột đá băng (glacial flour). Những ngày lặng gió, dãy núi tuyết in bóng rõ nét trên mặt hồ tạo nên khung cảnh tuyệt đẹp.</p>
            </div>

            <div id="kenai-mountains" class="scroll-mt-28 mt-8">
              <h2 class="text-2xl lg:text-[28px] font-bold border-b-2 border-sky-500 pb-2 inline-block mb-6 !mt-0">Kenai Mountains – Những Dãy Núi Bám Sát Mặt Đường</h2>
              
              <figure class="my-6">
                <img src="https://media.fittour.vn/uploads/seward-highway-kenai-mountains.webp" alt="Kenai Mountains Seward Highway" loading="lazy" class="w-full rounded-xl shadow-sm border border-slate-200" />
                <figcaption class="text-center text-sm text-slate-500 mt-3 font-medium">Dãy Kenai hùng vĩ chạy dọc theo Seward Highway.</figcaption>
              </figure>

              <p>Dãy Kenai Mountains gần như luôn đồng hành cùng bạn suốt chuyến đi. Ngay cả giữa mùa hè, nhiều đỉnh núi vẫn còn đọng tuyết trắng.</p>
            </div>

            <div id="turnagain-arm" class="scroll-mt-28 mt-8">
              <h2 class="text-2xl lg:text-[28px] font-bold border-b-2 border-sky-500 pb-2 inline-block mb-6 !mt-0">Turnagain Arm – Nơi Núi Và Biển Giao Nhau</h2>
              <p>Tiến gần về Anchorage, Seward Highway sẽ chạy bám theo mép <strong>Turnagain Arm</strong> – một nhánh vịnh hẹp cực kỳ nổi tiếng.</p>
              <p>Một bên là vách đá dựng đứng, một bên là mặt biển rộng với những đợt thủy triều dâng cao thuộc hàng mạnh nhất Bắc Mỹ.</p>
              <p>Đây là khu vực bạn có cơ hội ngắm nhìn động vật hoang dã ngay từ cửa xe, như:</p>
              <ul>
                <li>Cá voi Beluga bơi theo dòng nước;</li>
                <li>Đại bàng đầu trắng chao lượn;</li>
                <li>Cừu Dall lang thang trên sườn núi;</li>
                <li>Nai sừng tấm thỉnh thoảng băng qua đường.</li>
              </ul>
            </div>

            <div id="diem-dung" class="scroll-mt-28 mt-8">
              <h2 class="text-2xl lg:text-[28px] font-bold border-b-2 border-sky-500 pb-2 inline-block mb-6 !mt-0">Những Trạm Dừng Chân Lý Tưởng</h2>
              
              <h3 class="text-xl font-bold mt-6 text-sky-800">Beluga Point</h3>
              <p>Điểm ngắm cảnh nổi bật nhất Turnagain Arm. Vào mùa hè, du khách thường tấp xe vào đây để chờ xem đàn cá voi Beluga theo thủy triều bơi sát bờ.</p>
              
              <h3 class="text-xl font-bold mt-6 text-sky-800">Bird Point</h3>
              <p>Cung cấp góc nhìn toàn cảnh thoáng đãng hơn về vịnh, lý tưởng để quan sát thủy triều dâng và các đàn chim biển.</p>

              <h3 class="text-xl font-bold mt-6 text-sky-800">Thị trấn Girdwood</h3>
              <p>Nép mình dưới chân núi Chugach, Girdwood mang nhịp sống chậm rãi với những quán cà phê nhỏ và khu nghỉ dưỡng Alyeska Resort. Rất thích hợp để nhâm nhi đồ uống ấm trước khi đi tiếp.</p>
            </div>

            <div id="vi-sao-fit-tour" class="scroll-mt-28 mt-8 bg-sky-50 p-6 rounded-xl border border-sky-100">
              <h2 class="text-2xl lg:text-[28px] font-bold border-b-2 border-sky-500 pb-2 inline-block mb-6 !mt-0">Lịch Trình Tối Ưu Cùng FIT TOUR</h2>
              <p>Thay vì chỉ chạy xe một mạch cho xong đoạn đường nối giữa hai thành phố, FIT TOUR luôn thiết kế đủ thời gian để đoàn dừng lại tại các điểm quan sát đẹp nhất.</p>
              <p>Bạn sẽ có cơ hội hít thở không khí trong veo của rừng Taiga, chụp ảnh bên hồ Kenai và cảm nhận thực tế độ hùng vĩ của vùng đất phương Bắc thay vì chỉ ngắm qua cửa kính.</p>
            </div>

