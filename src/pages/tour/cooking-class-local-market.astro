  <!-- Client-side Interactive Scripts -->
  <script>
    function initTourInteractions() {
      // 1. Slider Accommodation & Vehicles
      document.querySelectorAll(".tour-accommodation-section").forEach(sec => {
        const track = sec.querySelector(".tour-slider-track") as HTMLElement;
        const slides = sec.querySelectorAll(".tour-slide");
        const prevBtn = sec.querySelector(".tour-slider-prev");
        const nextBtn = sec.querySelector(".tour-slider-next");
        const dots = sec.querySelectorAll(".tour-slider-dot");
        const counter = sec.querySelector(".tour-slider-counter");

        if (!track || slides.length === 0) return;

        let currentIndex = 0;
        const total = slides.length;

        function updateSlider(idx: number) {
          currentIndex = (idx + total) % total;
          track.style.transform = `translateX(-${currentIndex * 100}%)`;
          dots.forEach((d, i) => d.classList.toggle("active", i === currentIndex));
          if (counter) counter.textContent = `${currentIndex + 1} / ${total}`;
        }

        if (prevBtn) prevBtn.addEventListener("click", () => updateSlider(currentIndex - 1));
        if (nextBtn) nextBtn.addEventListener("click", () => updateSlider(currentIndex + 1));
        dots.forEach((dot, idx) => dot.addEventListener("click", () => updateSlider(idx)));
      });

      // 2. Customer Gallery Slider
      document.querySelectorAll(".tour-gallery-section").forEach(sec => {
        const slider = sec.querySelector(".tour-gallery-slider") as HTMLElement;
        const prev = sec.querySelector(".tour-gallery-prev");
        const next = sec.querySelector(".tour-gallery-next");
        if (!slider) return;

        const scrollAmount = 340;
        if (prev) prev.addEventListener("click", () => slider.scrollBy({ left: -scrollAmount, behavior: "smooth" }));
        if (next) next.addEventListener("click", () => slider.scrollBy({ left: scrollAmount, behavior: "smooth" }));
      });

      // 3. Journeys Carousel
      document.querySelectorAll("[data-component='tour-carousel']").forEach(slider => {
        const container = slider.parentElement?.parentElement;
        if (!container) return;
        const prev = container.querySelector("[data-action='carousel-prev']");
        const next = container.querySelector("[data-action='carousel-next']");
        if (prev) prev.addEventListener("click", () => slider.scrollBy({ left: -380, behavior: "smooth" }));
        if (next) next.addEventListener("click", () => slider.scrollBy({ left: 380, behavior: "smooth" }));
      });

      // 4. Mobile Bottom Nav Handlers
      const btnMobileItinerary = document.getElementById("btn-mobile-itinerary");
      if (btnMobileItinerary) {
        btnMobileItinerary.addEventListener("click", (e) => {
          e.preventDefault();
          const target = document.getElementById("itinerary") || document.querySelector(".tour-itinerary-section");
          if (target) {
            target.scrollIntoView({ behavior: "smooth", block: "start" });
          }
        });
      }

      const btnMobileOffice = document.getElementById("btn-mobile-office");
      const officeModal = document.getElementById("office-trust-modal");
      const closeOfficeBtn = document.getElementById("close-office-modal");
      const closeOfficeBtnBottom = document.getElementById("btn-close-office-modal-bottom");
      if (btnMobileOffice && officeModal) {
        btnMobileOffice.addEventListener("click", (e) => {
          e.preventDefault();
          officeModal.style.display = "flex";
        });
        if (closeOfficeBtn) {
          closeOfficeBtn.addEventListener("click", () => {
            officeModal.style.display = "none";
          });
        }
        if (closeOfficeBtnBottom) {
          closeOfficeBtnBottom.addEventListener("click", () => {
            officeModal.style.display = "none";
          });
        }
        officeModal.addEventListener("click", (e) => {
          if (e.target === officeModal) officeModal.style.display = "none";
        });
      }

      // 5. Guest Count & Price Calculation
      const minusBtn = document.getElementById("guest-minus-btn");
      const plusBtn = document.getElementById("guest-plus-btn");
      const countDisplay = document.getElementById("guest-count-display");
      const priceDisplay = document.getElementById("total-price-display");

      if (minusBtn && plusBtn && countDisplay && priceDisplay) {
        let currentGuests = 1;
        const maxGuests = 5;
        const basePrice = parseInt(priceDisplay.getAttribute("data-base-price") || "1490000", 10);

        function updateGuests(delta: number) {
          const newGuests = Math.min(Math.max(1, currentGuests + delta), maxGuests);
          if (newGuests === currentGuests) return;
          currentGuests = newGuests;
          countDisplay.textContent = currentGuests.toString();

          const total = basePrice * currentGuests;
          priceDisplay.textContent = total.toLocaleString("vi-VN") + " VND";
        }

        minusBtn.onclick = () => updateGuests(-1);
        plusBtn.onclick = () => updateGuests(1);
      }

      // 6. Booking Consultation Modal
      function initBookingModal() {
        const bookingButtons = document.querySelectorAll('.js-open-booking-modal');
        if (bookingButtons.length === 0) return;

        let modal = document.getElementById('booking-consult-modal');
        if (!modal) {
          modal = document.createElement('div');
          modal.id = 'booking-consult-modal';
          modal.style.cssText = 'position: fixed; inset: 0; z-index: 9999; display: flex; align-items: center; justify-content: center; background: rgba(0,0,0,0.6); padding: 20px; opacity: 0; transition: opacity 0.3s ease; pointer-events: none; backdrop-filter: blur(6px);';

          const modalContent = document.createElement('div');
          modalContent.style.cssText = 'background: #ffffff; padding: 32px 28px; border-radius: 24px; max-width: 440px; width: 100%; text-align: center; box-shadow: 0 20px 50px rgba(0,0,0,0.25); transform: translateY(20px); transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);';

          const iconWrapper = document.createElement('div');
          iconWrapper.style.cssText = 'width: 64px; height: 64px; border-radius: 50%; background: #fff7ed; color: #ea580c; display: flex; align-items: center; justify-content: center; margin: 0 auto 16px; font-size: 29.5px;';
          iconWrapper.innerHTML = '👩‍🍳';

          const title = document.createElement('h3');
          title.id = 'booking-modal-tour-title';
          title.style.cssText = 'font-size: 20.5px; font-weight: 800; color: #0f172a; margin: 0 0 8px 0; line-height: 1.35;';

          const desc = document.createElement('p');
          desc.style.cssText = 'font-size: 15.5px; color: #64748b; margin: 0 0 24px 0; line-height: 1.6;';
          desc.innerHTML = 'Register for a direct 1:1 consultation with <strong>The Rice Travel Group</strong> to book your cooking class session & custom preferences!';

          const actionGroup = document.createElement('div');
          actionGroup.style.cssText = 'display: flex; flex-direction: column; gap: 10px; margin-bottom: 16px;';

          const waBtn = document.createElement('a');
          waBtn.href = 'https://wa.me/84962333621';
          waBtn.target = '_blank';
          waBtn.rel = 'noopener noreferrer';
          waBtn.innerHTML = '💬 Chat on WhatsApp 24/7';
          waBtn.style.cssText = 'background: #25D366; color: #ffffff; text-decoration: none; padding: 13px 20px; border-radius: 12px; font-weight: 700; font-size: 15.5px; display: flex; align-items: center; justify-content: center; gap: 8px; box-shadow: 0 4px 12px rgba(37, 211, 102, 0.25);';

          const zaloBtn = document.createElement('a');
          zaloBtn.href = 'https://zalo.me/0962333641';
          zaloBtn.target = '_blank';
          zaloBtn.rel = 'noopener noreferrer';
          zaloBtn.innerHTML = '💬 Chat Zalo for Consult';
          zaloBtn.style.cssText = 'background: #0068FF; color: #ffffff; text-decoration: none; padding: 13px 20px; border-radius: 12px; font-weight: 700; font-size: 15.5px; display: flex; align-items: center; justify-content: center; gap: 8px;';

          const hotlineBtn = document.createElement('a');
          hotlineBtn.href = 'tel:0962333621';
          hotlineBtn.innerHTML = '📞 Call Hotline: 0962.333.621';
          hotlineBtn.style.cssText = 'background: #ea580c; color: #ffffff; text-decoration: none; padding: 13px 20px; border-radius: 12px; font-weight: 700; font-size: 15.5px; display: flex; align-items: center; justify-content: center; gap: 8px;';

          const closeBtn = document.createElement('button');
          closeBtn.type = 'button';
          closeBtn.innerText = 'Close';
          closeBtn.style.cssText = 'background: #f1f5f9; color: #64748b; border: none; padding: 11px 20px; border-radius: 12px; font-weight: 600; cursor: pointer; font-size: 14.5px; width: 100%; transition: background 0.2s;';

          function closeBookingModal() {
            if (!modal) return;
            modal.style.opacity = '0';
            if (modalContent) modalContent.style.transform = 'translateY(20px)';
            setTimeout(() => { if (modal) modal.style.pointerEvents = 'none'; }, 300);
          }

          closeBtn.addEventListener('click', closeBookingModal);
          modal.addEventListener('click', (e) => {
            if (e.target === modal) closeBookingModal();
          });

          actionGroup.appendChild(waBtn);
          actionGroup.appendChild(zaloBtn);
          actionGroup.appendChild(hotlineBtn);

          modalContent.appendChild(iconWrapper);
          modalContent.appendChild(title);
          modalContent.appendChild(desc);
          modalContent.appendChild(actionGroup);
          modalContent.appendChild(closeBtn);
          modal.appendChild(modalContent);
          document.body.appendChild(modal);
        }

        bookingButtons.forEach(btn => {
          btn.addEventListener('click', (e) => {
            e.preventDefault();
            const currentTourName = btn.getAttribute('data-tour-name') || document.querySelector('h1')?.textContent || 'Authentic Vietnamese Cooking Class & Local Market Discovery';
            const titleEl = document.getElementById('booking-modal-tour-title');
            if (titleEl) titleEl.innerText = currentTourName;

            if (modal) {
              modal.style.pointerEvents = 'auto';
              requestAnimationFrame(() => {
                modal.style.opacity = '1';
                const firstChild = modal.firstElementChild as HTMLElement;
                if (firstChild) {
                  firstChild.style.transform = 'translateY(0)';
                }
              });
            }
          });
        });
      }

      initBookingModal();
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initTourInteractions);
    } else {
      initTourInteractions();
    }
    document.addEventListener("astro:page-load", initTourInteractions);
  </script>
</BaseLayout>
