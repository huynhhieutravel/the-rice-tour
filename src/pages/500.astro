---
import BaseLayout from '@/layouts/BaseLayout.astro';

// Force 500 status code for SEO and Cloudflare correctness
Astro.response.status = 500;
Astro.response.statusText = "Internal Server Error";

const seoData = {
  title: "Service Temporarily Unavailable (500) | The Rice Tour",
  description: "Our servers are experiencing temporary high load. Please try again in a few moments.",
  noindex: true
};
---

<BaseLayout 
  title={seoData.title} 
  description={seoData.description} 
  noindex={seoData.noindex}
>
  <div class="min-h-[75vh] bg-white flex flex-col items-center justify-center px-4 py-20 relative overflow-hidden">
    
    <!-- Background Decor -->
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[500px] h-[500px] bg-red-50 rounded-full blur-3xl opacity-60 pointer-events-none z-0"></div>

    <div class="relative z-10 text-center max-w-lg">
      <span class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-red-50 border border-red-200 text-red-700 text-xs font-bold uppercase tracking-widest mb-4">
        ⚠️ High Traffic Detected
      </span>

      <h1 class="text-8xl md:text-9xl font-black text-gray-200 leading-none select-none tracking-tighter mb-2">
        500
      </h1>
      
      <div class="mb-8">
        <h2 class="text-2xl md:text-3xl font-serif font-bold text-gray-900 mb-3">System Busy</h2>
        <p class="text-base text-gray-500 font-normal leading-relaxed">
          Our servers are currently busy processing requests or undergoing maintenance. Please reload in a moment.
        </p>
      </div>

      <div class="flex flex-col sm:flex-row justify-center items-center gap-3">
        <button onclick="window.location.reload()" class="w-full sm:w-auto px-6 py-3.5 bg-gray-900 text-white rounded-xl font-bold text-sm hover:bg-brand-600 transition-all shadow-sm flex items-center justify-center gap-2 cursor-pointer">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path></svg>
          Reload Page
        </button>
        <a href="/" class="w-full sm:w-auto px-6 py-3.5 bg-gray-100 text-gray-700 hover:bg-gray-200 rounded-xl font-bold text-sm transition-all">
          Return Home
        </a>
      </div>

    </div>

  </div>
</BaseLayout>
