---
import { env } from 'cloudflare:workers';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { safeQueryCritical } from '@/lib/db-client';
import { getGlobalSettings } from '@/lib/settingsHelper';
import { MapPin, Info, Users, Clock, Calendar, Compass, Share2, Link as LinkIcon, ChevronRight, CheckCircle2 } from 'lucide-react';
import DataPost from '@/components/shortcodes/data/DataPost.astro';

const d1Db = env?.dulichcoguu_d1;
if (!d1Db) return Astro.rewrite("/500");

// Fetch CMS Data for SEO and Metadata
let post;
try {
  post = await safeQueryCritical(
    d1Db.prepare("SELECT * FROM Post WHERE id = ?").bind('1781570000032').first<any>(),
    { route: Astro.url.pathname, slug: '1781570000032', queryType: "fetch_post_by_id" }
  );
} catch (e) {
  // Ignore
}

if (!post) {
  post = {
    title: 'Talkeetna: Thị Trấn Nhỏ Giữ Linh Hồn Alaska',
    excerpt: 'Không sở hữu sông băng khổng lồ hay cực quang rực rỡ, nhưng Talkeetna lại là nơi giúp hiểu rõ nhất câu chuyện về con người đã khai phá Alaska.',
    featuredImage: 'https://media.fittour.vn/uploads/alaska-cover.webp',
    id: 1781570000032,
    author: 'Huynh Hieu Travel',
    createdAt: new Date().toISOString()
  };
}

const { settings } = await getGlobalSettings();

const seoTitle = post.seoTitle || post.title || 'Talkeetna: Thị Trấn Nhỏ Giữ Linh Hồn Alaska';
const seoDesc = post.seoDesc || post.excerpt || 'Không sở hữu sông băng khổng lồ hay cực quang rực rỡ, nhưng Talkeetna lại là nơi giúp hiểu rõ nhất câu chuyện về con người đã khai phá Alaska.';
const seoImage = post.seoImage || post.featuredImage || 'https://media.fittour.vn/uploads/alaska-cover.webp';

// --- DATE LOGIC ---
const createdAtStr = post.createdAt || post.publishedAt || new Date().toISOString();
const updatedAtStr = post.updatedAt || createdAtStr;

const createdAt = new Date(createdAtStr.replace(' ', 'T'));
const updatedAt = new Date(updatedAtStr.replace(' ', 'T'));

const isUpdated = updatedAt.getTime() - createdAt.getTime() > 86400000; 
const displayDate = isUpdated ? updatedAt : createdAt;
const datePrefix = isUpdated ? "Cập nhật:" : "Xuất bản:";

const formattedDate = displayDate.toLocaleDateString('vi-VN', { day: '2-digit', month: '2-digit', year: 'numeric' });

const adminEditUrl = `/admin/posts/edit?id=1781570000032`;

// TOC Data
const toc = [
  { id: "gioi-thieu", title: "Giới thiệu", icon: "🏠" },
  { id: "khong-giau-nho-vang", title: "Talkeetna Không Giàu Nhờ Vàng" },
  { id: "khong-thanh-thi-tran-ma", title: "Vì Sao Talkeetna Không Trở Thành Thị Trấn Ma?" },
  { id: "o-lai-lau-hon", title: "Điều Khiến Nhiều Người Muốn Ở Lại Talkeetna Lâu Hơn Dự Định" },
  { id: "pho-co", title: "Một Phố Cổ Không Được Xây Dựng Cho Khách Du Lịch" },
  { id: "dung-chi-cho-denali", title: "Đừng Chỉ Chờ Denali Xuất Hiện" },
  { id: "qua-nhung-con-so", title: "Talkeetna Qua Những Con Số" },
  { id: "chua-biet", title: "Những Điều Có Thể Bạn Chưa Biết" },
  { id: "vi-sao-fit-tour", title: "Vì Sao FIT TOUR Luôn Dành Thời Gian?" }
];

---

<BaseLayout 
  title={seoTitle} 
  description={seoDesc} 
  image={seoImage}
  adminEditUrl={adminEditUrl}
>
  <div class="bg-[#F8F9FA] text-[#1E293B] font-sans antialiased selection:bg-[#0284c7] selection:text-white">

    {/* ================= HERO SECTION ================= */}
    <section class="relative w-full h-[600px] lg:h-[650px] overflow-hidden">
      <div class="absolute inset-0 z-0 bg-slate-900">
        <img src={seoImage} alt="Talkeetna Alaska" class="w-full h-full object-cover object-center opacity-80" fetchpriority="high" loading="eager" />
        <div class="absolute inset-0 bg-gradient-to-r from-black/80 via-black/50 to-transparent"></div>
        <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-transparent to-transparent"></div>
      </div>

      <div class="relative z-10 max-w-[1600px] mx-auto px-4 sm:px-6 lg:px-12 h-full flex flex-col justify-center pt-20 pb-16">
        
        {/* Breadcrumb */}
        <div class="flex items-center gap-2 text-[13px] text-slate-200 font-medium mb-6">
          <a href="/" class="hover:text-white transition-colors">Trang chủ</a>
          <ChevronRight class="w-3 h-3" />
          <a href="/blog" class="hover:text-white transition-colors">Blog</a>
          <ChevronRight class="w-3 h-3" />
          <span class="text-white">Alaska</span>
        </div>

        {/* Titles */}
        <h1 class="font-serif text-4xl sm:text-5xl lg:text-6xl font-bold text-white mb-4 leading-[1.1] drop-shadow-lg max-w-4xl">
          {post.title}
        </h1>
        <h2 class="font-serif text-xl sm:text-3xl text-sky-400 italic mb-10 max-w-3xl drop-shadow-md">
          Thị Trấn Nhỏ Giữ Linh Hồn Alaska
        </h2>
        <p class="text-white/90 text-base sm:text-lg max-w-2xl leading-relaxed mb-8 hidden md:block drop-shadow-md font-medium">
          {post.excerpt}
        </p>

        {/* Author Meta */}
        <div class="flex flex-wrap items-center gap-6 text-sm text-white/80 border-t border-white/20 pt-6 max-w-3xl">
          <a href="/huynh-hieu" class="flex items-center gap-3 group">
            <img src="https://media.fittour.vn/uploads/huynhhieutravel.webp" alt="Huynh Hieu" class="w-10 h-10 rounded-full border-2 border-white/30 object-cover object-top group-hover:border-sky-400 transition-colors" />
            <span class="font-bold text-white group-hover:text-sky-400 transition-colors flex items-center gap-1">
              {post?.author || 'Huynh Hieu Travel'} 
              <CheckCircle2 class="w-4 h-4 text-blue-400" />
            </span>
          </a>
          <div class="flex items-center gap-2 bg-white/10 px-4 py-2 rounded-full backdrop-blur-sm border border-white/10">
            <Calendar class="w-4 h-4 opacity-70" />
            <span>{datePrefix} {formattedDate}</span>
          </div>
          <div class="flex items-center gap-2 bg-black/20 px-3 py-1.5 rounded-full backdrop-blur-sm">
            <Clock class="w-4 h-4 text-sky-400" />
            <span>5 phút đọc</span>
          </div>
        </div>

        {/* Badges Line */}
        <div class="flex flex-wrap items-center gap-4 mt-8 pt-6">
          <div class="flex items-center gap-2 text-sm text-white font-medium bg-black/60 backdrop-blur-md px-4 py-2 border border-white/10 rounded-lg shadow-xl">
            <span class="text-sky-400 text-lg">🚂</span> Đường sắt Alaska
          </div>
          <div class="flex items-center gap-2 text-sm text-white font-medium bg-black/60 backdrop-blur-md px-4 py-2 border border-white/10 rounded-lg shadow-xl">
            <span class="text-sky-400 text-lg">🏔️</span> Đỉnh Denali
          </div>
          <div class="flex items-center gap-2 text-sm text-white font-medium bg-black/60 backdrop-blur-md px-4 py-2 border border-white/10 rounded-lg shadow-xl">
            <span class="text-sky-400 text-lg">🐈</span> Mèo Stubbs
          </div>
        </div>
      </div>
    </section>

    {/* ================= MAIN CONTENT GRID ================= */}
    <div class="max-w-[1600px] mx-auto px-4 sm:px-6 lg:px-12 py-12 lg:py-16">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-start">

        {/* ---------------- LEFT SIDEBAR (TOC) ---------------- */}
        <aside class="hidden lg:block lg:col-span-3 sticky top-24">
          <div class="bg-white rounded-2xl shadow-sm border border-slate-200/60 p-6 overflow-hidden">
            <div class="flex items-center gap-2 font-bold text-slate-800 mb-6 border-l-4 border-sky-500 pl-3 text-sm tracking-wide uppercase">
              Mục lục bài viết
            </div>
            
            <nav class="space-y-1 text-[13.5px] font-medium">
              <a href="#gioi-thieu" class="flex items-center gap-2 text-sky-700 bg-sky-50 px-3 py-2.5 rounded-lg transition-colors">
                <span class="text-sky-500 text-base">🏠</span> Giới thiệu
              </a>
              {toc.slice(1).map((m) => (
                <a href={`#${m.id}`} class="flex items-center gap-2 text-slate-600 hover:text-sky-700 hover:bg-slate-50 px-3 py-2.5 rounded-lg transition-colors group">
                  <span class="w-1.5 h-1.5 rounded-full bg-slate-300 group-hover:bg-sky-400 transition-colors"></span>
                  {m.title}
                </a>
              ))}
            </nav>
          </div>
        </aside>

        {/* ---------------- CENTER COLUMN (MAIN CONTENT) ---------------- */}
        <main class="col-span-1 lg:col-span-6 space-y-10">
          
          {/* Quick Overview Stats Bar */}
          <div class="bg-white rounded-2xl shadow-sm border border-slate-200/60 p-6 flex flex-wrap lg:flex-nowrap items-center justify-between gap-4">
            
            <div class="w-full flex items-center justify-between gap-4 mb-2 lg:hidden">
              <span class="font-bold text-slate-800 text-sm border-l-4 border-sky-500 pl-2 uppercase">Tổng Quan Nhanh</span>
            </div>

            <div class="flex items-center gap-3 w-[48%] lg:w-auto">
              <div class="w-10 h-10 rounded-full bg-emerald-50 flex items-center justify-center text-emerald-600 text-xl border border-emerald-100 shrink-0">📍</div>
              <div>
                <div class="text-[11px] text-slate-500 font-medium">Vị trí</div>
                <div class="text-[13px] font-bold text-slate-800">Giữa Anchorage & Denali</div>
              </div>
            </div>

            <div class="hidden lg:block w-px h-8 bg-slate-200"></div>

            <div class="flex items-center gap-3 w-[48%] lg:w-auto">
              <div class="w-10 h-10 rounded-full bg-sky-50 flex items-center justify-center text-sky-600 text-xl border border-sky-100 shrink-0">👥</div>
              <div>
                <div class="text-[11px] text-slate-500 font-medium">Dân số</div>
                <div class="text-[13px] font-bold text-slate-800">~1.100 người</div>
              </div>
            </div>

            <div class="hidden lg:block w-px h-8 bg-slate-200"></div>

            <div class="flex items-center gap-3 w-[48%] lg:w-auto mt-2 lg:mt-0">
              <div class="w-10 h-10 rounded-full bg-rose-50 flex items-center justify-center text-rose-600 text-xl border border-rose-100 shrink-0">🚂</div>
              <div>
                <div class="text-[11px] text-slate-500 font-medium">Đặc trưng</div>
                <div class="text-[13px] font-bold text-slate-800">Tuyến đường sắt Alaska</div>
              </div>
            </div>

            <div class="hidden lg:block w-px h-8 bg-slate-200"></div>

            <div class="flex items-center gap-3 w-[48%] lg:w-auto mt-2 lg:mt-0">
              <div class="w-10 h-10 rounded-full bg-amber-50 flex items-center justify-center text-amber-600 text-xl border border-amber-100 shrink-0">🏔️</div>
              <div>
                <div class="text-[11px] text-slate-500 font-medium">Điểm nhấn</div>
                <div class="text-[13px] font-bold text-slate-800">Bay ngắm đỉnh Denali</div>
              </div>
            </div>
          </div>

          {/* Main Article Content */}
          <div class="text-slate-700 text-[15.5px] leading-relaxed mb-6 font-medium [&>div>p]:mb-4 [&>div>ul]:mb-4 [&>div>ul]:list-disc [&>div>ul]:pl-6 [&>div>ul>li]:mb-1.5">
            
            <div id="gioi-thieu" class="scroll-mt-28">
              <p>Nằm lọt thỏm giữa <a href="/anchorage" class="text-sky-600 hover:text-sky-700 hover:underline transition-colors font-medium">Anchorage</a> và <a href="/alaska-denali-dinh-nui-cao-nhat-bac-my" class="text-sky-600 hover:text-sky-700 hover:underline transition-colors font-medium">Vườn quốc gia Denali</a>, Talkeetna chỉ là một chấm nhỏ trên bản đồ với khoảng hơn một nghìn dân cư. Nơi đây không có <a href="/alaska-glacier-nhung-dong-song-bang" class="text-sky-600 hover:text-sky-700 hover:underline transition-colors font-medium">dòng sông băng</a> đồ sộ như Seward hay ánh sáng cực quang rực rỡ như Fairbanks. Dù vậy, Talkeetna lại luôn có mặt trong mọi lịch trình khám phá Alaska, từ tour tuyến chuyên nghiệp đến khách đi road trip tự túc. Người ta ghé lại để nhâm nhi tách cà phê, lên máy bay ngắm đỉnh Denali, hay để tập kết trước chuyến leo núi dài ngày.</p>
              
              <figure class="my-8">
                <img src="https://media.fittour.vn/uploads/2025/11/Map-tour-alaska-fittour.webp" alt="Bản đồ Talkeetna" loading="lazy" class="w-full rounded-xl shadow-sm border border-slate-200" />
                <figcaption class="text-center text-sm text-slate-500 mt-3 font-medium">Talkeetna - Nằm khiêm tốn giữa những trung tâm du lịch lớn của Alaska.</figcaption>
              </figure>
              
              <p>Giá trị của Talkeetna không nằm ở cảnh quan kỳ vĩ, mà ở vị trí lịch sử. Từ thời kỳ <a href="/alaska-con-sot-vang-klondike" class="text-sky-600 hover:text-sky-700 hover:underline transition-colors font-medium">cơn sốt vàng</a> đầu thế kỷ 20, quá trình xây dựng tuyến đường sắt xuyên bang, cho đến những cuộc chinh phục Denali hiện đại, thị trấn này luôn là điểm trung chuyển không thể thiếu. Khách du lịch thường truyền tai nhau: Nếu Denali đại diện cho thiên nhiên hoang dã, thì Talkeetna chính là nơi lưu giữ linh hồn của những con người đã khai phá Alaska.</p>
            </div>

            <div id="khong-giau-nho-vang" class="scroll-mt-28 mt-8">
              <div class="mb-6 border-l-4 border-sky-500 pl-4"><h2 class="font-serif text-2xl lg:text-[26px] font-bold text-slate-900 leading-tight">Talkeetna Không Giàu Nhờ Vàng</h2></div>
              <p>Gắn liền với thời kỳ đầu thế kỷ 20 là cơn sốt vàng Alaska, khi hàng nghìn người đổ về phương Bắc mong đổi đời. Khắp nơi mọc lên những khu trại quanh mỏ quặng, và nhiều người lầm tưởng Talkeetna cũng hình thành từ đó. Thực ra, nơi này hoàn toàn không có mỏ vàng nào lớn như Nome hay Dawson.</p>
              <p>Thế mạnh duy nhất của Talkeetna là vị trí đắc địa - nơi ngã ba sông Susitna, Chulitna và Talkeetna hợp lưu. Trước khi có đường bộ, đây là cửa ngõ đường thủy huyết mạch tiến sâu vào đất liền. Dân đào vàng thường tấp vào Talkeetna để mua thêm lương thực, tiếp nhiên liệu, sửa chữa đồ nghề và thuê người dẫn đường. Từ đó, thị trấn sống khỏe nhờ làm dịch vụ hậu cần cho dân tìm vàng, thay vì trực tiếp đi khai thác. Chính hướng đi khác biệt này đã giúp Talkeetna tồn tại lâu dài hơn hẳn các thị trấn mỏ lân cận.</p>
            </div>

            
            
            
            <div id="khong-thanh-thi-tran-ma" class="scroll-mt-28 mt-8">
              <div class="mb-6 border-l-4 border-sky-500 pl-4"><h2 class="font-serif text-2xl lg:text-[26px] font-bold text-slate-900 leading-tight">Vì Sao Talkeetna Không Trở Thành "Thị Trấn Ma"?</h2></div>
              <p>Khi các mỏ khai thác cạn kiệt, vô số điểm dừng chân tại Alaska bị bỏ hoang, biến thành những "thị trấn ma" (ghost town) chìm vào quên lãng. Nhưng Talkeetna đã may mắn bắt kịp một cơ hội mới: tuyến đường sắt <strong>Alaska Railroad</strong>.</p>
              
              <figure class="my-8">
                <img src="https://media.fittour.vn/uploads/ho-va-day-nui-alaska-tren-duong-den-talkeetna.webp" alt="Hồ và dãy núi Alaska trên đường đến Talkeetna" loading="lazy" class="w-full rounded-xl shadow-sm border border-slate-200" />
                <figcaption class="text-center text-sm text-slate-500 mt-3 font-medium">Phong cảnh ngoạn mục với hồ nước và dãy núi tuyết trên đường đến Talkeetna.</figcaption>
              </figure>

              <p>Dự án khổng lồ nối liền <a href="/seward-highway" class="text-sky-600 hover:text-sky-700 hover:underline transition-colors font-medium">Seward</a>, <a href="/anchorage" class="text-sky-600 hover:text-sky-700 hover:underline transition-colors font-medium">Anchorage</a> và Fairbanks hoàn thành năm 1923, và Talkeetna nghiễm nhiên trở thành một ga dừng chân chiến lược ở giữa tuyến. Người dân thị trấn nhanh chóng chuyển đổi sang phục vụ hành khách và vận tải hàng hóa. Hơn một thế kỷ trôi qua, những đoàn tàu Alaska Railroad huyền thoại vẫn đều đặn cập ga Talkeetna mỗi dịp hè, mang theo hàng nghìn du khách háo hức ngắm nhìn lịch sử vẫn đang tiếp diễn nơi đây.</p>
            </div>

            <div id="o-lai-lau-hon" class="scroll-mt-28 mt-8">
              <div class="mb-6 border-l-4 border-sky-500 pl-4"><h2 class="font-serif text-2xl lg:text-[26px] font-bold text-slate-900 leading-tight">Điều Khiến Du Khách Níu Chân Ở Talkeetna</h2></div>
              <p>Khu trung tâm Talkeetna chỉ quanh quẩn vài con phố ngắn, vắng bóng các trung tâm thương mại hay khách sạn cao tầng. Ấy vậy mà rất nhiều du khách lại "cố tình" kẹt lại đây lâu hơn dự kiến.</p>

              <figure class="my-8">
                <img src="https://media.fittour.vn/uploads/canh-sac-tren-duong-ve-talkeetna.webp" alt="Cảnh sắc trên đường về Talkeetna" loading="lazy" class="w-full rounded-xl shadow-sm border border-slate-200" />
                <figcaption class="text-center text-sm text-slate-500 mt-3 font-medium">Vẻ đẹp thanh bình của thiên nhiên dọc hai bên đường dẫn vào thị trấn nhỏ Talkeetna.</figcaption>
              </figure>

              <p>Sức hút của thị trấn đến từ nhịp sống chậm rãi đặc trưng. Bạn có thể hòa mình vào buổi sáng bình yên khi người địa phương rảo bước mua bánh mì, nhâm nhi tách cà phê ấm và ngắm nhìn chuyến tàu lăn bánh vào ga. Talkeetna không gồng mình "diễn" để chiều lòng du khách; nó mộc mạc, chân thật, mang lại một trải nghiệm dễ chịu khác xa sự hối hả của những tụ điểm du lịch ồn ào.</p>
            </div>

            <div id="pho-co" class="scroll-mt-28 mt-8">
              <div class="mb-6 border-l-4 border-sky-500 pl-4"><h2 class="font-serif text-2xl lg:text-[26px] font-bold text-slate-900 leading-tight">Khu Phố Cổ "Hàng Thật Giá Thật"</h2></div>
              <p>Dọc theo con đường <strong>Main Street</strong>, hầu hết các ngôi nhà gỗ từ đầu thế kỷ 20 vẫn còn được giữ lại nguyên vẹn và đang hoạt động. Nơi từng là văn phòng vận tải hay trạm dừng chân thuở trước nay đã hóa thành các phòng tranh nhỏ, tiệm sách độc lập hay quán cà phê mộc mạc.</p>
              <p>Thị trấn không hề bị thương mại hóa hay cố ý "phục dựng" để làm màu. Từng góc phố, từng món đồ thủ công đều toát lên cá tính riêng của cộng đồng dân cư yêu thiên nhiên và nghệ thuật. Sự mộc mạc đó khiến du khách có cảm giác đang đi dạo trong một xóm núi thân thuộc hơn là một khu du lịch xa lạ.</p>
            </div>
            
            <div id="dung-chi-cho-denali" class="scroll-mt-28 mt-8">
              <div class="mb-6 border-l-4 border-sky-500 pl-4"><h2 class="font-serif text-2xl lg:text-[26px] font-bold text-slate-900 leading-tight">Đừng Đến Talkeetna Chỉ Để Chờ Denali</h2></div>
              <p>Mục đích chính của đa số người đến đây là để nhìn ngắm đỉnh <a href="/alaska-denali-dinh-nui-cao-nhat-bac-my" class="text-sky-600 hover:text-sky-700 hover:underline transition-colors font-medium">Denali</a>. Tuy nhiên, thời tiết dãy núi này khá đỏng đảnh và việc mây mù che khuất tầm nhìn là chuyện như cơm bữa.</p>
              
              <figure class="my-8">
