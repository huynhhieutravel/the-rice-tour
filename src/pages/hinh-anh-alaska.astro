<script is:inline src="https://cdn.jsdelivr.net/gh/mcstudios/glightbox/dist/js/glightbox.min.js"></script>
<script is:inline>
  document.addEventListener('DOMContentLoaded', function() {
    if (typeof GLightbox === 'undefined') return;
    
    var gallerySelectors = ['.coguu-gallery', '.grid-fit-masonry', '.coguu-gallery-story', '.wp-block-gallery'];
    var allData = [];
    var done = [];
    gallerySelectors.forEach(function(s) {
      var els = document.querySelectorAll(s);
      els.forEach(function(el) {
        if (done.indexOf(el) !== -1) return;
        done.push(el);
        var imgs = el.querySelectorAll('img');
        if (!imgs.length) return;
        var items = [];
        var valid = [];
        for (var i = 0; i < imgs.length; i++) {
          if (imgs[i].closest('.exclude-lightbox') || imgs[i].closest('a')) continue;
          var imgUrl = imgs[i].getAttribute('src') || imgs[i].getAttribute('data-src') || '';
          items.push({href: imgUrl, type: 'image', description: imgs[i].getAttribute('data-caption') || imgs[i].getAttribute('alt') || ''});
          valid.push(imgs[i]);
        }
        if (items.length > 0) allData.push({items: items, imgs: valid});
      });
    });
    if (!allData.length) return;

    requestAnimationFrame(function() {
      allData.forEach(function(d) {
        var lb = GLightbox({elements: d.items, touchNavigation: true, loop: true, zoomable: true, descPosition: 'bottom'});
        for (var j = 0; j < d.imgs.length; j++) {
          d.imgs[j].style.cursor = 'zoom-in';
          (function(idx) {
            d.imgs[idx].addEventListener('click', function(e) {
              e.preventDefault();
              e.stopPropagation();
              // Update href before opening if it was lazy loaded
              var currentSrc = d.imgs[idx].getAttribute('src');
              if (currentSrc) {
                lb.elements[idx].href = currentSrc;
              }
              lb.openAt(idx);
            });
          })(j);
        }
      });
    });
  });
</script>

