---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/ui/Button.astro';
import TourCard from '@/components/tour/TourCard.astro';
import ThemeToggle from '@/components/ui/ThemeToggle.astro';

const tourSample = {
  title: "Tour VIP Mông Cổ 8N7Đ - Ngủ Lều Yurt Giữa Thảo Nguyên",
  image: "https://images.unsplash.com/photo-1542051841857-5f90071e7989?q=80&w=400&auto=format&fit=crop",
  duration: "8 Ngày 7 Đêm",
  price: "45.900.000đ",
  tag: "Bestseller",
  url: "/tour/mong-co"
};
---

<BaseLayout title="Design Playground | FIT Tour" description="Internal design system preview" noindex={true}>
  <div class="max-w-7xl mx-auto px-4 py-12">
    <div class="border-b border-border pb-6 mb-12 flex justify-between items-end">
      <div>
        <h1 class="text-4xl font-black text-primary mb-2">Design Playground 🎨</h1>
        <p class="text-secondary text-lg">Hệ thống Component chuẩn hóa cho dự án FIT Tour.</p>
      </div>
      <ThemeToggle />
    </div>

    <div class="space-y-20">
      
      <!-- Typography Section -->
      <section>
        <h2 class="text-2xl font-bold text-brand-500 mb-6 border-b border-border pb-2">1. Typography</h2>
        <div class="bg-surface p-8 rounded-2xl shadow-sm space-y-6">
          <h1 class="text-4xl font-black text-primary">Heading 1: Khám phá Thế giới</h1>
          <h2 class="text-3xl font-bold text-primary">Heading 2: Trải nghiệm Văn hóa</h2>
          <h3 class="text-2xl font-bold text-primary">Heading 3: Ẩm thực Địa phương</h3>
          <h4 class="text-xl font-bold text-primary">Heading 4: Lịch trình Tour</h4>
          <h5 class="text-lg font-bold text-primary">Heading 5: Thông tin Chung</h5>
          <h6 class="text-base font-bold text-primary">Heading 6: Lưu ý Nhỏ</h6>
          <div class="mt-8 space-y-4">
            <p class="text-base text-secondary"><strong>Paragraph (Default):</strong> Du Lịch Có Guu tự hào mang đến những hành trình khác biệt, nơi mỗi chuyến đi không chỉ là những điểm đến, mà là những trải nghiệm sâu sắc chạm đến trái tim.</p>
            <p class="text-sm text-muted"><strong>Paragraph (Small/Muted):</strong> Giá tour chưa bao gồm thuế VAT và các chi phí cá nhân phát sinh ngoài chương trình.</p>
          </div>
        </div>
      </section>

      <!-- Buttons Section -->
      <section>
        <h2 class="text-2xl font-bold text-brand-500 mb-6 border-b border-border pb-2">2. Buttons Matrix</h2>
        <div class="bg-surface p-8 rounded-2xl shadow-sm">
          <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            <!-- Primary -->
            <div class="space-y-4">
              <h3 class="font-bold text-primary mb-4">Primary Variant</h3>
              <div class="flex flex-col gap-4 items-start">
                <Button variant="primary" size="large">Primary Large</Button>
                <Button variant="primary" size="medium">Primary Medium</Button>
                <Button variant="primary" size="small">Primary Small</Button>
                <Button variant="primary" size="medium" disabled>Primary Disabled</Button>
              </div>
            </div>
            <!-- Secondary -->
            <div class="space-y-4">
              <h3 class="font-bold text-primary mb-4">Secondary / Outline Variant</h3>
              <div class="flex flex-col gap-4 items-start">
                <Button variant="outline" size="large">Outline Large</Button>
                <Button variant="outline" size="medium">Outline Medium</Button>
                <Button variant="outline" size="small">Outline Small</Button>
                <Button variant="outline" size="medium" disabled>Outline Disabled</Button>
              </div>
            </div>
            <!-- Special / Brand -->
            <div class="space-y-4">
              <h3 class="font-bold text-primary mb-4">Special Variants</h3>
              <div class="flex flex-col gap-4 items-start">
                <Button variant="primary" size="medium" class="w-full">Full Width Button</Button>
                <button class="bg-black dark:bg-white text-white dark:text-black px-6 py-3 rounded-full font-bold hover:scale-105 transition-transform">Inverted Action</button>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Cards Section -->
      <section>
        <h2 class="text-2xl font-bold text-brand-500 mb-6 border-b border-border pb-2">3. Business Cards (Tour)</h2>
        <div class="bg-surface p-8 rounded-2xl shadow-sm">
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
            <TourCard {...tourSample} />
            <TourCard {...tourSample} tag="Hot Sale" price="35.900.000đ" url="/tour/hot" />
          </div>
        </div>
      </section>

      <!-- Modals Section -->
      <section>
        <h2 class="text-2xl font-bold text-brand-500 mb-6 border-b border-border pb-2">4. Modals & Forms</h2>
        <div class="bg-stone-100/50 p-8 rounded-2xl shadow-inner border border-stone-200/60 flex items-center justify-center">
          
          <div class="bg-white rounded-[24px] max-w-lg w-full shadow-2xl overflow-hidden border border-stone-200/80">
            <div class="bg-stone-950 p-6 flex items-start justify-between relative overflow-hidden">
              <div class="absolute -right-10 -top-10 w-32 h-32 bg-amber-500/20 rounded-full blur-2xl"></div>
              <div class="relative z-10 flex gap-3">
                <div class="w-8 h-8 rounded-full bg-amber-500/20 flex items-center justify-center shrink-0 mt-1">
                  <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-compass w-4 h-4 text-amber-500"><circle cx="12" cy="12" r="10"/><polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"/></svg>
                </div>
                <div>
                  <span class="text-[10px] font-mono font-bold text-amber-500 uppercase tracking-widest block mb-0.5">FIT TOUR CHUYÊN NGHIỆP</span>
                  <h3 class="font-serif font-black text-white text-xl leading-tight">Đăng Ký Tư Vấn & Đặt Vé Chuyên Sâu</h3>
                </div>
              </div>
              <button class="relative z-10 w-8 h-8 flex items-center justify-center rounded-full bg-white/10 text-white/70 hover:bg-white/20 hover:text-white transition">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-x w-4 h-4"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
              </button>
            </div>

            <div class="p-6">
              <div class="bg-amber-50 border border-amber-900/10 rounded-xl p-4 mb-6">
                <span class="font-mono text-[9px] uppercase font-bold tracking-wider text-amber-800 block mb-1">CHƯƠNG TRÌNH LỰA CHỌN:</span>
                <h4 class="font-serif font-black text-stone-900 text-[17px] leading-tight mb-2">
                  Hành Trình Ladakh An Toàn - Tư Vấn Vấn Đề Sức khỏe số 1
                </h4>
                <div class="text-[11px] font-sans text-stone-600 flex items-center gap-1.5 opacity-90 mt-1">
                  <span class="flex items-center gap-1"><span class="w-1 h-1 rounded-full bg-amber-600"></span> Thời lượng: <strong class="text-stone-900 font-bold">Phản hồi trong 15 phút</strong></span>
                  <span class="text-stone-300">|</span>
                  <span class="flex items-center gap-1"><span class="w-1 h-1 rounded-full bg-emerald-600"></span> Giá trọn gói từ: <strong class="text-amber-800 font-bold">Tư vấn miễn phí bởi Bác Sĩ</strong></span>
                </div>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-4">
                <div>
                  <label class="block font-mono text-[9px] text-stone-500 uppercase font-bold mb-1">Họ & Tên Hành Khách</label>
                  <input type="text" placeholder="Ví dụ: Nguyễn Thị Hoa" class="w-full text-xs bg-stone-50 border border-stone-200 rounded-lg p-2.5 outline-none" />
                </div>
                <div>
                  <label class="block font-mono text-[9px] text-stone-500 uppercase font-bold mb-1">Số điện thoại liên hệ</label>
                  <input type="tel" placeholder="Ví dụ: 0903348XXX" class="w-full text-xs bg-stone-50 border border-stone-200 rounded-lg p-2.5 outline-none" />
                </div>
              </div>
              
              <div class="mb-4">
                <label class="block font-mono text-[9px] text-stone-500 uppercase font-bold mb-1">Địa chỉ Email</label>
                <input type="email" placeholder="Ví dụ: hoa.nguyen@gmail.com" class="w-full text-xs bg-stone-50 border border-stone-200 rounded-lg p-2.5 outline-none" />
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-4">
                <div>
                  <label class="block font-mono text-[9px] text-stone-500 uppercase font-bold mb-1">Tháng đi mong muốn</label>
                  <select class="w-full text-xs bg-stone-50 border border-stone-200 rounded-lg p-2.5 outline-none text-stone-700">
                    <option>Tháng 9/2026 - Mùa Thu Vàng</option>
                  </select>
                </div>
                <div>
                  <label class="block font-mono text-[9px] text-stone-500 uppercase font-bold mb-1">Độ Tuổi Khách Hàng</label>
                  <select class="w-full text-xs bg-stone-50 border border-stone-200 rounded-lg p-2.5 outline-none font-semibold text-amber-900">
                    <option>Khách lớn tuổi U70 (Trên 65 tuổi)</option>
                  </select>
                </div>
              </div>

              <div class="space-y-1.5 border-t border-stone-100 pt-3 mb-4">
                <label class="flex items-start gap-2 cursor-pointer select-none">
                  <input type="checkbox" checked class="mt-0.5 accent-amber-700 scale-95" />
                  <span class="text-[10px] text-stone-600 leading-normal">
                    Tôi cam kết sức khỏe ổn định và đồng ý kiểm tra sàng lọc y khoa về thích nghi độ cao với Fit Tour (Miễn phí đo chỉ số tim & huyết áp trước xuất hành).
                  </span>
                </label>
                <label class="flex items-start gap-2 cursor-pointer select-none">
                  <input type="checkbox" class="mt-0.5 accent-amber-700 scale-95" />
                  <span class="text-[10px] text-stone-600 leading-normal">
                    Tôi yêu cầu tư vấn kỹ thuật thở oxy chuyên dùng do xe SUV y tế cung hành để đảm bảo an toàn tuyệt đối tại Leh và Pangong.
                  </span>
                </label>
              </div>

              <button class="w-full bg-stone-950 hover:bg-amber-800 text-white font-mono text-xs font-bold py-3.5 px-6 rounded-xl transition shadow-md hover:shadow-lg flex items-center justify-center gap-2">
                <span>GỬI ĐĂNG KÝ HỖ TRỢ Y TẾ & GIỮ HÀNH TRÌNH CHỐNG AMS</span>
              </button>
            </div>
          </div>

        </div>
      </section>

    </div>
  </div>
</BaseLayout>
