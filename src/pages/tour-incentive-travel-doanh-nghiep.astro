</section></div>

<!-- SECTION 2: CÁC CHƯƠNG TRÌNH INCENTIVE -->
<section class="it-section" style="background-color: #f8fafc; padding: 80px 0;">
  <div class="site-container max-w-6xl mx-auto px-4">
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-extrabold text-slate-900 tracking-tight">
        Các chương trình Incentive Travel Doanh nghiệp tại FIT Tour
      </h2>
