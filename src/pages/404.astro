---
import BaseLayout from '@/layouts/BaseLayout.astro';

const seoData = {
  title: "Page Not Found (404) | The Rice Tour",
  description: "The page you are looking for does not exist or has been moved.",
  noindex: true
};
---

<BaseLayout 
  title={seoData.title} 
  description={seoData.description} 
  noindex={seoData.noindex}
>
  <div class="min-h-[75vh] bg-white flex flex-col items-center justify-center px-4 py-20 relative overflow-hidden">
    
    <!-- Background Decor -->
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[500px] h-[500px] bg-amber-50 rounded-full blur-3xl opacity-60 pointer-events-none z-0"></div>

    <div class="relative z-10 text-center max-w-lg">
      <span class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-brand-50 border border-brand-200 text-brand-700 text-xs font-bold uppercase tracking-widest mb-4">
        🌾 Lost Along The Trail
      </span>

      <h1 class="text-8xl md:text-9xl font-black text-gray-200 leading-none select-none tracking-tighter mb-2">
        404
      </h1>
      
      <div class="mb-8">
        <h2 class="text-2xl md:text-3xl font-serif font-bold text-gray-900 mb-3">Expedition Not Found</h2>
        <p class="text-base text-gray-500 font-normal leading-relaxed">
          The page or journey you are seeking may have wandered off the map, or the link has changed.
        </p>
      </div>

      <div class="flex flex-col sm:flex-row justify-center items-center gap-3">
        <a href="/" class="w-full sm:w-auto px-6 py-3.5 bg-gray-900 text-white rounded-xl font-bold text-sm hover:bg-brand-600 transition-all shadow-sm flex items-center justify-center gap-2">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path></svg>
          Return Home
        </a>
        <a href="/tours" class="w-full sm:w-auto px-6 py-3.5 bg-brand-50 text-brand-700 border border-brand-200 rounded-xl font-bold text-sm hover:bg-brand-100 transition-all">
          Explore Tours →
        </a>
      </div>

    </div>

  </div>
</BaseLayout>
