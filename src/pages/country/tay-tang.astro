---
import { env } from "cloudflare:workers";
import BaseLayout from "@/layouts/BaseLayout.astro";
import JsonLdSchema from "@/components/seo/JsonLdSchema.astro";
import { safeQueryCritical } from "@/lib/db-client";
import PortraitCenterpiece from "@/components/shortcodes/PortraitCenterpiece.astro";

const slug = "tay-tang";
const d1Db = env?.dulichcoguu_d1;

if (!d1Db) {
  return Astro.rewrite("/500");
}

let country;
try {
  country = await safeQueryCritical(
    d1Db.prepare("SELECT * FROM Country WHERE slug = ?").bind(slug).first(),
    { route: Astro.url.pathname, slug, queryType: "fetch_country_by_slug" }
  );
} catch (e) {
  return Astro.rewrite("/500");
}

if (!country) {
  return new Response("Country not found", { status: 404 });
}

const title = country.metaTitle || country.name;
const description = country.metaDescription || country.name;
let image = country.featuredImage || country.bannerImage || "";
const currentOrigin = Astro.url.origin;
const canonicalUrl = `${currentOrigin}/country/${slug}`;
const breadcrumbSchema = {
  items: [
    { name: "Trang chủ", url: `${currentOrigin}/` },
    { name: "Khám phá", url: `${currentOrigin}/v2` },
    { name: title, url: canonicalUrl }
  ]
};

Astro.response.headers.set("Cache-Control", "public, s-maxage=3600, stale-while-revalidate=86400");
---

<BaseLayout
  title={title}
  description={description}
  image={image}
  preloadImages={image ? [image] : []}
  adminEditUrl={`/admin/countries/edit?id=${country.id}`}
>
  <Fragment slot="schema">
    <JsonLdSchema type="breadcrumb" data={breadcrumbSchema} />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400;1,500&family=Inter:wght@300;400;500;600&display=swap" media="print" onload="this.media='all'">
    <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400;1,500&family=Inter:wght@300;400;500;600&display=swap"></noscript>
  </Fragment>

