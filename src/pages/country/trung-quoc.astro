---
import { env } from "cloudflare:workers";
import BaseLayout from '@/layouts/BaseLayout.astro';
import ChinaBottomMenu from '@/components/china/ChinaBottomMenu.astro';
import QuickViewModal from '@/components/china/QuickViewModal.astro';
import JsonLdSchema from "@/components/seo/JsonLdSchema.astro";
import { safeQueryCritical } from "@/lib/db-client";

const slug = "trung-quoc";
const d1Db = env?.dulichcoguu_d1;

if (!d1Db) {
  return Astro.rewrite("/500");
}

let country;
try {
  country = await safeQueryCritical(
    d1Db.prepare("SELECT * FROM Country WHERE slug = ?").bind(slug).first(),
    { route: Astro.url.pathname, slug, queryType: "fetch_country_by_slug" }
  );
} catch (e) {
  return Astro.rewrite("/500");
}

if (!country) {
  return new Response("Country not found", { status: 404 });
}

const title = country.metaTitle || "China Majestic - Theo dấu nền văn minh Trung Hoa | FIT Tour";
const description = country.metaDescription || "Theo dấu những thành phố, vùng đất và câu chuyện đã góp phần viết nên một trong những nền văn minh lâu đời nhất thế giới.";
let image = country.featuredImage || country.bannerImage || "https://media.fittour.vn/uploads/china-sereis-background.webp";

const currentOrigin = Astro.url.origin;
const canonicalUrl = `${currentOrigin}/country/${slug}`;
const breadcrumbSchema = {
  items: [
    { name: "Trang chủ", url: `${currentOrigin}/` },
    { name: "Khám phá", url: `${currentOrigin}/v2` },
    { name: country.name || "Trung Quốc", url: canonicalUrl }
  ]
};

Astro.response.headers.set("Cache-Control", "public, s-maxage=3600, stale-while-revalidate=86400");
---

<BaseLayout 
  title={title} 
  description={description} 
  image={image}
  canonical={canonicalUrl}
  adminEditUrl={`/admin/countries/edit?id=${country.id}`}
>
  <Fragment slot="schema">
    <JsonLdSchema type="breadcrumb" data={breadcrumbSchema} />
  </Fragment>

  <Fragment slot="head">
