---
import { env } from "cloudflare:workers";
import BaseLayout from '@/layouts/BaseLayout.astro';
import { safeQueryCritical } from "@/lib/db-client";

const slug = "chau-phi";
const d1Db = env?.dulichcoguu_d1;

if (!d1Db) {
  return Astro.rewrite("/500");
}

let country;
try {
  country = await safeQueryCritical(
    d1Db.prepare("SELECT * FROM Country WHERE slug = ?").bind(slug).first(),
    { route: Astro.url.pathname, slug, queryType: "fetch_country_by_slug" }
  );
} catch (e) {
  return Astro.rewrite("/500");
}

const title = country?.metaTitle || "African Bespoke Collection - Hành trình Châu Phi | FIT Tour";
const description = country?.metaDescription || "Những cuộc thám hiểm được thiết kế riêng, nơi thiên nhiên hoang dã và các nền văn minh cổ đại tạo nên trải nghiệm khác biệt.";
let image = country?.featuredImage || country?.bannerImage || "https://media.fittour.vn/uploads/chau-phi-background.webp";
---

<BaseLayout 
  title={title} 
  description={description}
  image={image}
  preloadImages={image ? [image] : []}
  adminEditUrl={country ? `/admin/countries/edit?id=${country.id}` : undefined}
>

