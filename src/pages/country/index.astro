---
import { env } from 'cloudflare:workers';
import BaseLayout from '@/layouts/BaseLayout.astro';
import JsonLdSchema from '@/components/seo/JsonLdSchema.astro';

const d1Db = env?.dulichcoguu_d1;

if (!d1Db) {
  return new Response("No DB binding", { status: 500 });
}

// Fetch all countries that have at least one active tour
const query = `
  SELECT c.slug, c.name, c.featuredImage, c.description, COUNT(tc.tour_id) as tour_count
  FROM Country c
  JOIN TourCountry tc ON c.slug = tc.country_slug
  JOIN Tour t ON tc.tour_id = t.id
  WHERE t.status = 'published'
  GROUP BY c.slug
  ORDER BY tour_count DESC, c.display_order ASC, c.name ASC
`;
const res = await d1Db.prepare(query).all<any>();
let countries = res.results || [];

// Filter out categories that don't look like specific countries if needed
// Or just show all of them. The user wants them listed.
// Let's filter out ones without images just in case, but fallback to a default if they want all.
// Actually, they want all active ones.

function cleanCountryName(name: string) {
  if (!name) return '';
  return name.replace(/^Danh sách Tour(?: du lịch)?\s*/i, '')
             .replace(/\s*[-]?\s*trọn gói.*$/i, '')
             .replace(/\s*\d{4}(?:\/\d{4})?\s*$/i, '')
             .trim();
}

function getPlainText(html: string) {
  if (!html) return '';
  const textBlocks = html.match(/<(p|ul)[\s\S]*?<\/\1>/gi);
  if (textBlocks && textBlocks.length > 0) {
    for (const block of textBlocks) {
      const textOnly = block.replace(/<[^>]*>/g, '').trim();
      if (textOnly && textOnly.length > 40 && textOnly.toLowerCase() !== 'home') {
         if (textOnly.startsWith('“') || textOnly.startsWith('"') || textOnly.startsWith('«')) break;
         return textOnly;
      }
    }
  }
  return html.replace(/<[^>]*>/g, ' ').replace(/\s+/g, ' ').trim().substring(0, 150);
}

const formattedCountries = countries.map(c => ({
  ...c,
  cleanName: cleanCountryName(c.name),
  plainTextDesc: getPlainText(c.description),
  image: c.featuredImage || 'https://media.fittour.vn/uploads/2021/08/Map-world-Journey-1.webp'
}));

const title = "Tất cả các Điểm Đến Có GUU | FIT Tour";
const description = "Danh sách tất cả các quốc gia và vùng lãnh thổ đang có lịch trình tour đang mở bán tại FIT Tour.";

const currentOrigin = Astro.url.origin;
const breadcrumbSchema = {
  items: [
    { name: "Trang chủ", url: `${currentOrigin}/` },
    { name: "Điểm Đến", url: `${currentOrigin}/country` }
  ]
};
---

<BaseLayout title={title} description={description}>
  <Fragment slot="schema">
    <JsonLdSchema type="breadcrumb" data={breadcrumbSchema} />
  </Fragment>

  <div class="w-full font-sans pb-24 bg-gray-50">
    
    <section class="site-container pt-12 pb-16">
      <nav class="flex items-center text-sm text-gray-500 mb-8" aria-label="Breadcrumb">
        <a href="/" class="hover:text-[#f27922]">Trang chủ</a>
        <svg class="w-4 h-4 mx-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
        <span class="text-gray-900 font-medium">Điểm Đến</span>
      </nav>
      
      <div class="max-w-3xl">
        <h1 class="text-3xl md:text-5xl font-extrabold text-gray-900 mb-6 leading-tight">
          Các Điểm Đến <span class="text-[#f27922]">Có GUU</span>
        </h1>
        <p class="text-lg md:text-xl text-gray-600 font-light">
          Danh sách tất cả các quốc gia đang có tour hoạt động. Chọn điểm đến bạn yêu thích và khám phá lịch trình độc quyền của chúng tôi.
        </p>
      </div>
    </section>

    <!-- Grid Section -->
    <section class="site-container not-prose">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6 md:gap-8 [&_img]:!m-0 [&_img]:!p-0 [&_img]:!border-0 [&_img]:!rounded-none [&_a]:!no-underline [&_a]:!border-0 [&_h2]:!m-0 [&_h2]:!p-0 [&_h2]:!border-0 [&_p]:!m-0 [&_p]:!p-0">
        {formattedCountries.map((dest) => (
          <div class="flex flex-col bg-white rounded-2xl overflow-hidden shadow-sm border border-gray-100 transition-all duration-300 hover:shadow-xl hover:-translate-y-1">
            <a href={`/country/${dest.slug}`} class="block aspect-video w-full overflow-hidden relative bg-gray-100">
              <img 
                src={dest.image} 
                alt={dest.cleanName} 
                class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 hover:scale-105"
                loading="lazy"
              />
            </a>
            <div class="p-6 flex flex-col flex-grow">
              <h2 class="text-xl font-bold text-gray-900 mb-1 leading-tight">
                <a href={`/country/${dest.slug}`} class="hover:text-[#f27922] transition-colors">{dest.cleanName}</a>
              </h2>
              
              <div class="mb-4 flex-grow">
                <p class="text-sm text-gray-600 font-light line-clamp-3 leading-relaxed">
                  {dest.plainTextDesc || 'Đang cập nhật mô tả cho điểm đến này...'}
                </p>
              </div>

              <div class="flex items-center justify-between mt-auto pt-4 border-t border-gray-50">
                <a href={`/country/${dest.slug}`} class="text-[#f27922] font-semibold text-sm inline-flex items-center group">
                  Xem thêm <svg class="w-4 h-4 ml-1 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
                </a>
                <span class="px-3 py-1 bg-orange-50 text-[#f27922] rounded-full text-xs font-bold border border-orange-100">
                  {dest.tour_count} Tours
                </span>
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>

  </div>
</BaseLayout>
