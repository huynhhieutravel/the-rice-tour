---
import { env } from "cloudflare:workers";
import BaseLayout from '@/layouts/BaseLayout.astro';
import { safeQueryCritical } from "@/lib/db-client";

const slug = "bac-cuc";
const d1Db = env?.dulichcoguu_d1;

if (!d1Db) {
  return Astro.rewrite("/500");
}

let country;
try {
  country = await safeQueryCritical(
    d1Db.prepare("SELECT * FROM Country WHERE slug = ?").bind(slug).first(),
    { route: Astro.url.pathname, slug, queryType: "fetch_country_by_slug" }
  );
} catch (e) {
  return Astro.rewrite("/500");
}

const title = country?.metaTitle || "Arctic Collection - Khám phá vùng Bắc Cực | FIT Tour";
const description = country?.metaDescription || "Chasing Light Across The North. Hành trình khám phá vùng đất băng giá Bắc Cực hoang dã: Iceland, Greenland, Alaska.";
let image = country?.featuredImage || country?.bannerImage || "https://media.fittour.vn/uploads/2024/04/doan-du-khach-fit-tour-don-cuc-quang-o-iceland.webp";
---

<BaseLayout 
  title={title} 
  description={description}
  image={image}
  preloadImages={image ? [image] : []}
  adminEditUrl={country ? `/admin/countries/edit?id=${country.id}` : undefined}
>
