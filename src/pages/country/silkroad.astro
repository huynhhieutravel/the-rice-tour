---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { env } from 'cloudflare:workers';
import { safeQueryCritical } from '@/lib/db-client';
import SilkRoadModal from '@/components/silkroad/SilkRoadModal.astro';

const slug = 'silkroad';
const d1Db = env?.dulichcoguu_d1;

let country;
if (d1Db) {
  try {
    country = await safeQueryCritical(
      d1Db.prepare("SELECT * FROM Country WHERE slug = ?").bind(slug).first(),
      { route: Astro.url.pathname, slug, queryType: "fetch_country_by_slug" }
    );
  } catch (e) {
    console.error(e);
  }
}


const adminEditUrl = country ? `/admin/countries/edit?id=${country.id}` : undefined;

const seoTitle = country?.metaTitle || country?.name || "Silk Road Collection - Theo dấu những nền văn minh | FIT Tour";
const seoDesc = country?.metaDescription || "Hành trình xuyên qua những sa mạc, dãy núi và thảo nguyên rộng lớn - nơi giao thoa của văn hóa, tín ngưỡng và những câu chuyện đã đi cùng lịch sử nhân loại.";
const seoImage = country?.featuredImage || country?.bannerImage || "https://media.fittour.vn/uploads/background-con-duong-to-lua-banner.webp";


