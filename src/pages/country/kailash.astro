<script>
  document.addEventListener('DOMContentLoaded', () => {
    const wrapper = document.getElementById('portrait-wrapper');
    if (!wrapper) return;

    const btns = wrapper.querySelectorAll('.portrait-tab-btn');
    const contents = wrapper.querySelectorAll('.portrait-content-item');

    btns.forEach(btn => {
      btn.addEventListener('click', () => {
        const idx = btn.getAttribute('data-tab-idx');

        // Update buttons
        btns.forEach(b => {
          if (b.getAttribute('data-tab-idx') === idx) {
            b.classList.add('border-amber-500', 'bg-amber-500/10', 'text-white', 'shadow-lg');
            b.classList.remove('border-stone-800', 'bg-stone-900/40', 'text-stone-400');
          } else {
            b.classList.remove('border-amber-500', 'bg-amber-500/10', 'text-white', 'shadow-lg');
            b.classList.add('border-stone-800', 'bg-stone-900/40', 'text-stone-400');
          }
        });

        // Update contents
        contents.forEach(content => {
          if (content.getAttribute('data-content-idx') === idx) {
            content.classList.remove('opacity-0', 'z-0', 'pointer-events-none', 'scale-95');
            content.classList.add('opacity-100', 'z-10', 'pointer-events-auto', 'scale-100');
          } else {
            content.classList.remove('opacity-100', 'z-10', 'pointer-events-auto', 'scale-100');
            content.classList.add('opacity-0', 'z-0', 'pointer-events-none', 'scale-95');
          }
        });
      });
    });
  });
</script>

