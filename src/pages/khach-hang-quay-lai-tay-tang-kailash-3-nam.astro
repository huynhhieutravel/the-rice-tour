---
import BaseLayout from '../layouts/BaseLayout.astro';
import { env } from 'cloudflare:workers';

const d1Db = env?.dulichcoguu_d1;

let seoTitle = "Khách Hàng Quay Lại Tây Tạng & Kailash 3 Năm Liên Tiếp: Vì Sao Chị Ly Luôn Chọn FIT TOUR?";
let seoDesc = "Hành trình tâm nguyện của chị Huỳnh Diễm Ly tại Kailash và Tây Tạng. Sự tin tưởng đồng hành cùng FIT TOUR suốt 3 năm liên tiếp.";
let seoImage = "https://media.fittour.vn/uploads/chi-ly-tai-deo-dolma-5600m.webp";

if (d1Db) {
  try {
    const stmt = d1Db.prepare(`SELECT title, seoTitle as metaTitle, seoDescription as metaDescription, featuredImage FROM Post WHERE slug = 'khach-hang-quay-lai-tay-tang-kailash-3-nam' LIMIT 1`);
    const postData = await stmt.first();
    if (postData) {
      if (postData.featuredImage) seoImage = postData.featuredImage;
      if (postData.metaTitle) seoTitle = postData.metaTitle;
      if (postData.metaDescription) seoDesc = postData.metaDescription;
    }
  } catch (e) {
    console.error("Lỗi lấy SEO data:", e);
  }
}
---

<BaseLayout title={seoTitle} description={seoDesc} image={seoImage}>
  <main class="bg-[#FDFCF8] text-gray-900 font-sans selection:bg-blue-200">
    
    <!-- Hero Section -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-16 pb-12">
      <div class="text-center max-w-4xl mx-auto mb-10">
        <nav aria-label="Breadcrumb" class="mb-6 inline-block py-1.5 px-6 rounded-full border border-blue-700 bg-white shadow-sm">
          <ol class="flex flex-wrap items-center justify-center space-x-2 text-xs md:text-sm font-bold tracking-widest uppercase text-blue-700">
            <li><a href="/" class="hover:text-blue-900 transition-colors">Trang chủ</a></li>
            <li><span class="text-blue-300">/</span></li>
            <li><a href="/cau-chuyen-khach-hang" class="hover:text-blue-900 transition-colors">Câu chuyện khách hàng</a></li>
          </ol>
        </nav>
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-extrabold tracking-tight text-gray-900 leading-[1.15] mb-6">
          Khách Hàng Quay Lại Tây Tạng & Kailash 3 Năm Liên Tiếp
        </h1>
        <p class="text-xl md:text-2xl text-gray-500 font-light max-w-3xl mx-auto leading-relaxed">
          Đằng sau những cung đường khắc nghiệt nhất Himalaya là một hành trình trọn vẹn của tâm nguyện, tình thân và sự tin tưởng tuyệt đối.
        </p>
      </div>
      
      <a href="https://media.fittour.vn/uploads/chi-ly-tai-deo-dolma-5600m.webp" class="glightbox block relative w-full aspect-video rounded-[2rem] overflow-hidden shadow-2xl group" aria-label="Xem ảnh phóng to">
        <img src="https://media.fittour.vn/uploads/chi-ly-tai-deo-dolma-5600m.webp" alt="Chị Ly tại đèo Dolma 5600m" class="w-full h-full object-cover transform group-hover:scale-105 transition-transform duration-1000" fetchpriority="high" / width="1200" height="800" />
        <div class="absolute inset-0 bg-gradient-to-t from-black/40 to-transparent"></div>
        <div class="absolute bottom-6 left-8 right-8 text-white">
          <p class="text-sm font-medium tracking-widest uppercase opacity-80">Đèo Dolma La, Độ cao 5.630m</p>
        </div>
      </a>
    </section>

    <!-- Content: Intro -->
    <section class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 relative pt-8 pb-24">

      <article class="prose prose-lg md:prose-xl prose-blue max-w-none prose-headings:font-bold prose-headings:tracking-tight prose-p:text-gray-700 prose-p:leading-relaxed">
        
        <p class="lead text-2xl text-gray-800 font-medium leading-relaxed">
          Có rất nhiều người mơ ước được đặt chân đến Tây Tạng một lần trong đời. Nhưng rất ít người quay trở lại lần thứ hai. Và càng hiếm hơn những người liên tục quay lại trong nhiều năm liền.
        </p>


        <p>
          Tây Tạng không phải là một điểm đến nghỉ dưỡng thông thường. Độ cao lớn, điều kiện tự nhiên khắc nghiệt cùng những hành trình kéo dài qua vùng Himalaya khiến nơi đây trở thành một trong những điểm đến thử thách nhất châu Á. Việc đối mặt với hội chứng sốc độ cao (AMS), cái lạnh thấu xương và những cung đường gập ghềnh không dành cho những ai chưa chuẩn bị sẵn sàng cả về thể lực lẫn tinh thần.
        </p>

        <div class="my-12 not-prose">
          <a href="https://media.fittour.vn/uploads/chi-ly-truoc-cung-dien-potala.webp" class="glightbox block rounded-2xl overflow-hidden shadow-xl group relative" aria-label="Xem ảnh phóng to">
            <img src="https://media.fittour.vn/uploads/chi-ly-truoc-cung-dien-potala.webp" class="w-full h-auto group-hover:scale-105 transition-transform duration-700" loading="lazy" alt="Chi Ly Truoc Cung Dien Potala" width="1200" height="800" />
            <div class="absolute bottom-0 inset-x-0 bg-gradient-to-t from-black/80 to-transparent p-6 text-white">
              <p class="text-lg font-medium">Chị Ly trước Cung điện Potala, thủ phủ Lhasa</p>
            </div>
          </a>
        </div>

        <p>Thế nhưng, chị <strong>Huỳnh Diễm Ly</strong> lại là một ngoại lệ đặc biệt. Suốt ba năm liên tiếp, chị đã đồng hành cùng FIT TOUR trong những hành trình <a href="/cam-nang-du-lich-tay-tang" title="Cẩm nang kinh nghiệm du lịch Tây Tạng">khám phá Tây Tạng</a> và Kora quanh <a href="/truyen-thuyet-va-su-that-ve-nui-kailash" title="Sự thật về ngọn núi thiêng Kailash">ngọn núi linh thiêng Kailash</a>.</p>
        
        <div class="my-16 not-prose border border-gray-200 rounded-3xl p-6 bg-white shadow-sm flex flex-col md:flex-row items-center gap-6 md:gap-8 group hover:shadow-md transition-shadow">
          <a href="/4-nam-20-hanh-trinh-cua-chi-thuy-cung-fittour" class="w-full md:w-1/2 relative block rounded-2xl overflow-hidden aspect-video flex-shrink-0">
            <img src="https://media.fittour.vn/uploads/2026/01/4-nam-20-hanh-trinh-dong-hanh-chi-thuy-cung-fittour.webp" class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" alt="4 Năm 20 Hành Trình Của Chị Thủy Cùng FIT TOUR" loading="lazy" / width="1200" height="800" />
          </a>
          <div class="w-full md:w-1/2 flex flex-col justify-center">
            <div class="inline-block px-3 py-1 bg-blue-50 text-blue-600 rounded-full text-[10px] sm:text-xs font-bold tracking-widest uppercase mb-3 self-start">Câu Chuyện Tiếp Theo</div>
            <h2 class="text-lg sm:text-xl md:text-2xl font-bold text-gray-900 mb-2 leading-snug">
              <a href="/4-nam-20-hanh-trinh-cua-chi-thuy-cung-fittour" class="hover:text-blue-600 transition-colors">4 Năm, 20 Hành Trình Cùng FIT TOUR</a>
            </h3>
            <p class="text-gray-600 mb-5 leading-relaxed text-sm line-clamp-3">Mỗi hành trình không chỉ là một chuyến đi, mà là một trải nghiệm chữa lành. Cùng đọc câu chuyện đầy cảm hứng về chị Thủy – người đã đi cùng FIT TOUR qua 20 vùng đất khác nhau.</p>
            <a href="/4-nam-20-hanh-trinh-cua-chi-thuy-cung-fittour" class="inline-flex justify-center items-center py-2 px-5 rounded-full bg-blue-600 text-white text-sm font-medium hover:bg-blue-700 transition-colors self-start shadow-sm hover:shadow-md">
              Đọc Câu Chuyện <svg class="w-4 h-4 ml-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
            </a>
          </div>
        </div>

        <h2 class="text-3xl md:text-4xl mt-16">Hành Trình Tâm Nguyện Tại Kailash</h2>
        
        <p>Với chị Ly, Tây Tạng không chỉ là những khung cảnh tráng lệ của cung điện Potala, hồ thánh Yamdrok hay những cánh đồng hoa cải vàng rực rỡ dọc quốc lộ G318. Đó còn là một hành trình rất riêng – hành trình của tình thân và tâm nguyện.</p>

        <div class="my-12 not-prose w-full">
          <a href="https://media.fittour.vn/uploads/chi-ly-kora-kailash-lan-thu-hai.webp" class="glightbox block rounded-2xl overflow-hidden shadow-xl group relative" aria-label="Xem ảnh phóng to">
            <img src="https://media.fittour.vn/uploads/chi-ly-kora-kailash-lan-thu-hai.webp" class="w-full h-auto group-hover:scale-105 transition-transform duration-500" loading="lazy" alt="Chi Ly Kora Kailash Lan Thu Hai" width="1200" height="800" />
            <div class="absolute bottom-0 inset-x-0 bg-gradient-to-t from-black/80 to-transparent p-6 text-white text-center">
              <p class="text-lg font-medium">Hành trình Kora lần thứ hai với những bước chân không mỏi</p>
            </div>
          </a>
        </div>

        <p>Đỉnh cao của thử thách Tây Tạng chính là việc đi Kora (hành hương đi bộ vòng quanh) ngọn núi thiêng Kailash. Quãng đường dài 52km trong điều kiện oxy loãng và vượt qua đèo Dolma La ở độ cao 5.630m có thể bẻ gãy ý chí của bất kỳ ai. Trong lần thứ ba thực hiện Kora, chị mang theo hình ảnh của người cha đã khuất.</p>
        
        <div class="my-12 not-prose w-full">
          <a href="https://media.fittour.vn/uploads/kora-kailash-lan-thu-ba.webp" class="glightbox block rounded-2xl overflow-hidden shadow-xl group relative" aria-label="Xem ảnh phóng to">
            <img src="https://media.fittour.vn/uploads/kora-kailash-lan-thu-ba.webp" class="w-full h-auto group-hover:scale-105 transition-transform duration-500" loading="lazy" alt="Kora Kailash Lan Thu Ba" width="1200" height="800" />
            <div class="absolute bottom-0 inset-x-0 bg-gradient-to-t from-black/80 to-transparent p-6 text-white text-center">
              <p class="text-lg font-medium">Hoàn thành Kora vòng ngoài Kailash lần thứ 3 cùng tâm nguyện dang dở</p>
            </div>
          </a>
        </div>
        
        <p>Tâm nguyện của chị rất giản dị nhưng vô cùng mãnh liệt: chỉ mong ôm hình Ba đi trọn hành trình, vượt qua đỉnh đèo cao nhất để cầu cho Ba được vãng sanh an yên nơi cõi Phật.</p>
        <div class="my-12 not-prose w-full">
          <a href="https://media.fittour.vn/uploads/ky-nguyen-cho-ba-tai-dolma-la-kailash.webp" class="glightbox block rounded-2xl overflow-hidden shadow-xl group relative" aria-label="Xem ảnh phóng to">
            <img src="https://media.fittour.vn/uploads/ky-nguyen-cho-ba-tai-dolma-la-kailash.webp" class="w-full h-auto group-hover:scale-105 transition-transform duration-500" loading="lazy" alt="Ky Nguyen Cho Ba Tai Dolma La Kailash" width="1200" height="800" />
            <div class="absolute bottom-0 inset-x-0 bg-gradient-to-t from-black/80 to-transparent p-6 text-white text-center">
              <p class="text-lg font-medium">Kỷ nguyện cho Ba tại đỉnh đèo Dolma La (5.630m)</p>
            </div>
          </a>
        </div>
        <p>Sự nỗ lực của chị đã chạm đến những điều thiêng liêng nhất.</p>

        <blockquote class="relative bg-white border border-gray-200 p-8 rounded-2xl shadow-xl italic text-gray-800 my-12 text-2xl font-medium leading-relaxed text-center">
          <svg class="w-10 h-10 text-blue-200 mx-auto mb-4" fill="currentColor" viewBox="0 0 32 32"><path d="M10 8c-3.3 0-6 2.7-6 6v10h10V14H8c0-2.2 1.8-4 4-4V8zm16 0c-3.3 0-6 2.7-6 6v10h10V14h-6c0-2.2 1.8-4 4-4V8z"></path></svg>
          "Con gái ơi Ba đang đi cùng con đây nè. Ba biết con sẽ nhìn thấy Ba. Ba đã an yên vãng sang miền cực lạc, con gái yên tâm nha con. Ba đang trên mây dõi theo từng bước chân con..."
        </blockquote>

        <p>Chính vì mang theo tâm nguyện sâu sắc ấy, chị gần như không chụp nhiều hình trong hành trình. Nhưng khi trở về và xem lại những bức ảnh hiếm hoi đã chụp, chị bất ngờ nhận ra những hình bóng đặc biệt trên mây.</p>

        <div class="my-12 not-prose w-full">
          <a href="https://media.fittour.vn/uploads/chi-ly-ben-ho-quan-am-kailash.webp" class="glightbox block rounded-2xl overflow-hidden shadow-xl group relative" aria-label="Xem ảnh phóng to">
            <img src="https://media.fittour.vn/uploads/chi-ly-ben-ho-quan-am-kailash.webp" class="w-full h-auto group-hover:scale-105 transition-transform duration-500" loading="lazy" alt="Chi Ly Ben Ho Quan Am Kailash" width="1200" height="800" />
            <div class="absolute bottom-0 inset-x-0 bg-gradient-to-t from-black/80 to-transparent p-6 text-white text-center">
              <p class="text-lg font-medium">Bên hồ Quan Âm thanh tịnh</p>
            </div>
          </a>
        </div>

        <p>Khoảnh khắc nhìn thấy dáng dấp một người cha ẩn hiện trong đám mây bao quanh đỉnh Kailash khiến chị hiểu rằng tâm nguyện của mình đã được chứng.</p>

        <div class="my-12 not-prose w-full">
          <a href="https://media.fittour.vn/uploads/chi-ly-voi-kailash-luc-binh-minh.webp" class="glightbox block rounded-2xl overflow-hidden shadow-xl group relative" aria-label="Xem ảnh phóng to">
            <img src="https://media.fittour.vn/uploads/chi-ly-voi-kailash-luc-binh-minh.webp" class="w-full h-auto group-hover:scale-105 transition-transform duration-500" loading="lazy" alt="Chi Ly Voi Kailash Luc Binh Minh" width="1200" height="800" />
            <div class="absolute bottom-0 inset-x-0 bg-gradient-to-t from-black/80 to-transparent p-6 text-white text-center">
              <p class="text-lg font-medium">Kailash lúc bình minh rực rỡ</p>
            </div>
          </a>
        </div>

        <p>Kể từ giây phút ấy, nỗi nhớ Ba không còn là nỗi đau khắc khoải, mà đã hóa thành sự bình an bất diệt trong lòng.</p>

        <div class="my-16 not-prose border border-gray-200 rounded-3xl p-6 bg-white shadow-sm flex flex-col md:flex-row items-center gap-6 md:gap-8 group hover:shadow-md transition-shadow">
          <a href="https://thericetour.com/nhat-ky-hanh-trinh-hanh-huong-nui-kailash" class="w-full md:w-1/2 relative block rounded-2xl overflow-hidden aspect-video flex-shrink-0">
            <img src="https://media.fittour.vn/uploads/2024/07/hanh-trinh-kora-kailash-fittour.webp" class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" alt="Nhật Ký Hành Trình Hành Hương Núi Kailash" loading="lazy" / width="1200" height="800" />
          </a>
          <div class="w-full md:w-1/2 flex flex-col justify-center">
            <div class="inline-block px-3 py-1 bg-blue-50 text-blue-600 rounded-full text-[10px] sm:text-xs font-bold tracking-widest uppercase mb-3 self-start">Góc Chia Sẻ</div>
            <h2 class="text-lg sm:text-xl md:text-2xl font-bold text-gray-900 mb-2 leading-snug">
              <a href="https://thericetour.com/nhat-ky-hanh-trinh-hanh-huong-nui-kailash" class="hover:text-blue-600 transition-colors">Nhật Ký Hành Trình Hành Hương Núi Kailash</a>
            </h3>
            <p class="text-gray-600 mb-5 leading-relaxed text-sm line-clamp-3">Bạn muốn biết chi tiết về hành trình 52km Kora quanh ngọn núi linh thiêng nhất thế giới diễn ra như thế nào? Cùng khám phá cảm xúc vỡ òa qua lăng kính của FIT TOUR.</p>
            <a href="https://thericetour.com/nhat-ky-hanh-trinh-hanh-huong-nui-kailash" class="inline-flex justify-center items-center py-2 px-5 rounded-full bg-blue-600 text-white text-sm font-medium hover:bg-blue-700 transition-colors self-start shadow-sm hover:shadow-md">
              Đọc Hành Trình <svg class="w-4 h-4 ml-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
            </a>
          </div>
        </div>
      </article>
    </section>

    <!-- Zanda Kingdom & Landscapes -->
    <section class="bg-gray-900 py-20 text-white w-full">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16">
          <h2 class="text-3xl md:text-5xl font-bold mb-6">Mở Rộng Giới Hạn Khám Phá</h2>
          <p class="text-gray-400 text-lg">Không chỉ Kailash, hành trình của chị Ly cùng FIT TOUR còn in dấu chân ở những vùng đất hoang sơ và huyền bí bậc nhất Tây Tạng.</p>
        </div>
        
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 items-start">
          <a href="https://media.fittour.vn/uploads/chi-ly-vuong-quoc-co-zanda.webp" class="glightbox block relative rounded-2xl overflow-hidden group shadow-lg" aria-label="Xem ảnh phóng to">
            <img src="https://media.fittour.vn/uploads/chi-ly-vuong-quoc-co-zanda.webp" class="w-full h-auto group-hover:scale-105 transition-transform duration-700" loading="lazy" alt="Chi Ly Vuong Quoc Co Zanda" width="1200" height="800" />
            <div class="absolute bottom-0 inset-x-0 bg-gradient-to-t from-black/90 to-transparent p-6">
              <p class="text-lg font-bold">Vương quốc cổ Zanda</p>
              <p class="text-sm text-gray-300">Rừng đất sét kỳ vĩ</p>
            </div>
          </a>
          <a href="https://media.fittour.vn/uploads/chi-ly-kham-pha-tan-tich-zanda.webp" class="glightbox block relative rounded-2xl overflow-hidden group shadow-lg" aria-label="Xem ảnh phóng to">
            <img src="https://media.fittour.vn/uploads/chi-ly-kham-pha-tan-tich-zanda.webp" class="w-full h-auto group-hover:scale-105 transition-transform duration-700" loading="lazy" alt="Chi Ly Kham Pha Tan Tich Zanda" width="1200" height="800" />
            <div class="absolute bottom-0 inset-x-0 bg-gradient-to-t from-black/90 to-transparent p-6">
              <p class="text-lg font-bold">Tàn tích Guge</p>
              <p class="text-sm text-gray-300">Dấu ấn thời gian vĩnh cửu</p>
            </div>
          </a>
          <a href="https://media.fittour.vn/uploads/chi-ly-tai-song-bang-karola.webp" class="glightbox block relative rounded-2xl overflow-hidden group shadow-lg" aria-label="Xem ảnh phóng to">
            <img src="https://media.fittour.vn/uploads/chi-ly-tai-song-bang-karola.webp" class="w-full h-auto group-hover:scale-105 transition-transform duration-700" loading="lazy" alt="Chi Ly Tai Song Bang Karola" width="1200" height="800" />
            <div class="absolute bottom-0 inset-x-0 bg-gradient-to-t from-black/90 to-transparent p-6">
              <p class="text-lg font-bold">Sông băng Karola</p>
              <p class="text-sm text-gray-300">Băng tuyết vĩnh cửu</p>
            </div>
          </a>
        </div>
      </div>
    </section>

    <!-- Why FIT TOUR -->
    <section class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 relative py-20">
      <article class="prose prose-lg md:prose-xl prose-blue max-w-none prose-headings:font-bold prose-headings:tracking-tight prose-p:text-gray-700">
        <h2 class="text-3xl md:text-4xl text-center mb-12">Đi Cùng FIT Như Người Nhà</h2>

        <p>Không phải một chuyến đi thành công. Mà là nhiều chuyến đi liên tiếp. Khi được hỏi điều gì khiến chị tiếp tục lựa chọn FIT TOUR cho những hành trình Tây Tạng đầy gian khổ, câu trả lời của chị rất rõ ràng:</p>

        <ul class="list-none space-y-4 my-8 p-0">
          <li class="flex items-start">
            <svg class="w-6 h-6 text-green-500 mr-3 mt-1 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
            <span><strong>Được chăm sóc tận tâm</strong> trong suốt mọi hoàn cảnh khắc nghiệt của hành trình.</span>
          </li>
          <li class="flex items-start">
