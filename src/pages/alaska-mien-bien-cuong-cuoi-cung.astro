---
import BaseLayout from '@/layouts/BaseLayout.astro';
import '@/styles/alaska-app.css';
import App from '@/components/ReactApp/AlaskaApp/App.tsx';
import TestComponent from '@/components/ReactApp/AlaskaApp/TestComponent.tsx';

import { env } from 'cloudflare:workers';
import { safeQueryCritical } from '@/lib/db-client';
import { getCanonicalMediaUrl } from '@/lib/imageOptimization';

let postData: any = null;
let adminEditUrl = "/admin/posts/edit?id=1780726584505";

try {
  const d1Db = env?.dulichcoguu_d1;
  if (d1Db) {
    postData = await safeQueryCritical(
      d1Db.prepare("SELECT * FROM Post WHERE slug = ?").bind("alaska-mien-bien-cuong-cuoi-cung").first<any>(),
      { route: Astro.url.pathname, slug: "alaska-mien-bien-cuong-cuoi-cung", queryType: "fetch_post_by_slug" }
    );
    if (postData) {
      adminEditUrl = `/admin/posts/edit?id=${postData.id}`;
    }
  }
} catch (e) {
  console.log("Could not fetch post metadata:", e);
}

const rawFeaturedImage = postData?.featuredImage || "https://images.unsplash.com/photo-1544816155-12df9643f363?auto=format&fit=crop&q=85&w=1800";
const featuredImage = rawFeaturedImage.startsWith('http') ? rawFeaturedImage : getCanonicalMediaUrl(rawFeaturedImage);
---
<BaseLayout
  title={postData?.title || "Alaska – Miền Biên Cương Cuối Cùng Của Nước Mỹ (Phần 1)"}
  description={postData?.description || "An exquisite editorial blog series about Alaska - The Last Frontier of America, featuring interactive layouts, scenic galleries, map exploration, and immersive winter reading states."}
  image={featuredImage}
  canonical="https://thericetour.com/alaska-mien-bien-cuong-cuoi-cung"
  adminEditUrl={adminEditUrl}
  preloadImages={[featuredImage]}
>
  <Fragment slot="head">
    <meta property="og:type" content="article" />
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400;1,500&family=Montserrat:wght@100;200;300;400;500;600;700&family=Space+Grotesk:wght@300;400;500;600;700&family=JetBrains+Mono:wght@300;400;500&family=Prata&display=swap">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400;1,500&family=Montserrat:wght@100;200;300;400;500;600;700&family=Space+Grotesk:wght@300;400;500;600;700&family=JetBrains+Mono:wght@300;400;500&family=Prata&display=swap" media="print" onload="this.media='all'">
    
    <style is:global>
        /* Force tailwind directives to avoid missing tailwind classes if any */
        @import "tailwindcss";
    </style>
    <style>
      /* Ensure full width and specific fonts for Alaska App if needed */
      body {
        margin: 0;
        padding: 0;
      }
    </style>
  </Fragment>

  <App client:idle featuredImage={featuredImage} />
</BaseLayout>
