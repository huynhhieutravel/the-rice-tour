---
import { env } from 'cloudflare:workers';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { safeQueryCritical } from '@/lib/db-client';
import { Info, Clock, Calendar, ChevronRight, CheckCircle2, XCircle, HelpCircle, FileCheck, Package } from 'lucide-react';

const d1Db = env?.dulichcoguu_d1;
if (!d1Db) return Astro.rewrite("/500");

// Fetch CMS Data for SEO and Metadata
let post;
try {
  post = await safeQueryCritical(
    d1Db.prepare(`
      SELECT p.*, u.url as authorUrl, u.avatar as authorAvatar 
      FROM Post p 
      LEFT JOIN "User" u ON p.authorId = u.id 
      WHERE p.slug = ? AND (p.status = 'published' OR p.status = 'publish')
    `).bind('trang-phuc-kora-kailash').first<any>(),
    { route: Astro.url.pathname, slug: 'trang-phuc-kora-kailash', queryType: "fetch_post_by_slug" }
  );
} catch (e) {
  // Graceful fallback for layout testing if not in DB yet
  post = {
    title: 'Chuẩn bị trang phục đi Kora Kailash',
    excerpt: 'Nguyên tắc Layering và danh sách trang bị thiết yếu giúp bạn vượt qua 52km quanh ngọn núi linh thiêng nhất thế giới.',
    featuredImage: 'https://media.fittour.vn/uploads/2024/07/du-khach-chuan-bi-hanh-trinh-kora-kailash.jpg',
    author: 'Huynh Hieu Travel'
  };
}

const seoTitle = post?.seoTitle || post?.title || 'Chuẩn bị trang phục đi Kora Kailash - Hướng dẫn Layering';
const seoDesc = post?.seoDesc || post?.excerpt || 'Nguyên tắc Layering và danh sách trang bị thiết yếu giúp bạn vượt qua 52km quanh ngọn núi linh thiêng Kailash. Đừng mua sai đồ!';
const seoImage = post?.seoImage || post?.featuredImage || 'https://media.fittour.vn/uploads/2024/07/du-khach-chuan-bi-hanh-trinh-kora-kailash.jpg';

// --- DATE LOGIC ---
const createdAtStr = post?.createdAt || post?.publishedAt || new Date().toISOString();
const updatedAtStr = post?.updatedAt || createdAtStr;

const createdAt = new Date(createdAtStr.replace(' ', 'T'));
const updatedAt = new Date(updatedAtStr.replace(' ', 'T'));

const isUpdated = updatedAt.getTime() - createdAt.getTime() > 86400000; 
const displayDate = isUpdated ? updatedAt : createdAt;
const datePrefix = isUpdated ? "Cập nhật:" : "Xuất bản:";

const formattedDate = displayDate.toLocaleDateString('vi-VN', { day: '2-digit', month: '2-digit', year: 'numeric' });
// ------------------

const adminEditUrl = post?.id ? `/admin/posts/edit?id=${post.id}` : '#';
---

<BaseLayout 
  title={seoTitle} 
  description={seoDesc} 
  image={seoImage}
  adminEditUrl={adminEditUrl}
>
  <div class="bg-[#F8F9FA] text-[#1E293B] font-sans antialiased selection:bg-[#c89845] selection:text-white">

    {/* ================= HERO SECTION ================= */}
    <section class="relative w-full h-[600px] lg:h-[650px] overflow-hidden">
      <div class="absolute inset-0 z-0 bg-slate-900">
        <img src={seoImage} alt="Trang phục Kora Kailash" class="w-full h-full object-cover object-center opacity-80" fetchpriority="high" loading="eager" />
        <div class="absolute inset-0 bg-gradient-to-r from-black/80 via-black/50 to-transparent"></div>
        <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-transparent to-transparent"></div>
      </div>

      <div class="relative z-10 max-w-[1600px] mx-auto px-4 sm:px-6 lg:px-12 h-full flex flex-col justify-center pt-20 pb-16">
        
        {/* Breadcrumb */}
        <div class="flex items-center gap-2 text-[13px] text-white/70 font-medium mb-6">
          <a href="/" class="hover:text-white transition-colors">Trang chủ</a>
          <ChevronRight class="w-3 h-3" />
          <a href="/blog" class="hover:text-white transition-colors">Blog</a>
          <ChevronRight class="w-3 h-3" />
          <span class="text-white">Tây Tạng</span>
        </div>

        {/* Titles */}
        <h1 class="font-serif text-4xl sm:text-5xl lg:text-6xl font-bold text-white mb-4 leading-[1.1] drop-shadow-lg max-w-4xl">
          Chuẩn bị trang phục đi Kora Kailash
        </h1>
        <h2 class="font-serif text-xl sm:text-3xl text-rose-500 italic mb-10 max-w-3xl drop-shadow-md">
          Nguyên tắc Layering & Danh sách trang bị thiết yếu
        </h2>
        <p class="text-white/90 text-base sm:text-lg max-w-2xl leading-relaxed mb-8 hidden md:block drop-shadow-md font-medium">
          Không phải cứ mặc áo thật dày là ấm. Khám phá bí quyết <strong class="text-rose-500 font-bold">mặc đồ theo lớp (Layering)</strong> giúp cơ thể luôn thoải mái trong suốt 52km hành hương khắc nghiệt.
        </p>

        {/* Author Meta */}
        <div class="flex flex-wrap items-center gap-6 text-sm text-white/80 border-t border-white/20 pt-6 max-w-3xl">
          <a href={post?.authorUrl || "/huynh-hieu"} class="flex items-center gap-3 group">
            <img src={post?.authorAvatar || "https://media.fittour.vn/uploads/huynhhieutravel.webp"} alt={post?.author || 'Huynh Hieu Travel'} class="w-10 h-10 rounded-full border-2 border-white/30 object-cover object-top group-hover:border-amber-400 transition-colors" />
            <span class="font-bold text-white group-hover:text-rose-500 transition-colors flex items-center gap-1">
              {post?.author || 'Huynh Hieu Travel'} 
              <CheckCircle2 class="w-4 h-4 text-blue-400" />
            </span>
          </a>
          <div class="flex items-center gap-2 bg-white/10 px-4 py-2 rounded-full backdrop-blur-sm border border-white/10">
            <Calendar class="w-4 h-4 opacity-70" />
            <span>{datePrefix} {formattedDate}</span>
          </div>
          <div class="flex items-center gap-2 bg-black/20 px-3 py-1.5 rounded-full backdrop-blur-sm">
            <Clock class="w-4 h-4 text-rose-500" />
            <span>8 phút đọc</span>
          </div>
        </div>

      </div>
    </section>

    {/* ================= MAIN CONTENT GRID ================= */}
    <div class="max-w-[1600px] mx-auto px-4 sm:px-6 lg:px-12 py-12 lg:py-16">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-start">

        {/* ---------------- LEFT SIDEBAR (TOC) ---------------- */}
        <aside class="hidden lg:block lg:col-span-3 sticky top-24">
          <div class="bg-white rounded-2xl shadow-sm border border-slate-200/60 p-6 overflow-hidden">
            <div class="flex items-center gap-2 font-bold text-slate-800 mb-6 border-l-4 border-amber-500 pl-3 text-sm tracking-wide uppercase">
              Mục lục bài viết
            </div>
            
            <nav class="space-y-1 text-[13.5px] font-medium max-h-[70vh] overflow-y-auto custom-scrollbar">
              <a href="#thoi-tiet" class="flex items-center gap-2 text-slate-700 hover:text-rose-600 px-3 py-2 rounded-lg transition-colors font-bold">
                <span class="text-slate-400 text-base">🌤️</span> Thời tiết Kailash
              </a>
              <a href="#layering" class="flex items-center gap-2 text-slate-700 hover:text-rose-600 px-3 py-2 rounded-lg transition-colors font-bold mt-3">
                <span class="text-slate-400 text-base">🧥</span> Nguyên tắc Layering
              </a>
              <div class="pl-9 pr-3 space-y-1.5 mt-1 border-l border-slate-100 ml-[18px]">
                  <a href="#layer-1" class="block text-slate-500 hover:text-rose-600 text-[13px] py-1 transition-colors leading-tight">Lớp 1 – Base Layer</a>
                  <a href="#layer-2" class="block text-slate-500 hover:text-rose-600 text-[13px] py-1 transition-colors leading-tight">Lớp 2 – Mid Layer</a>
                  <a href="#layer-3" class="block text-slate-500 hover:text-rose-600 text-[13px] py-1 transition-colors leading-tight">Lớp 3 – Outer Layer</a>
                  <a href="#layer-4" class="block text-slate-500 hover:text-rose-600 text-[13px] py-1 transition-colors leading-tight">Lớp 4 – Down Jacket</a>
              </div>
              <a href="#danh-sach-do" class="flex items-center gap-2 text-slate-700 hover:text-rose-600 px-3 py-2 rounded-lg transition-colors font-bold mt-3">
                <span class="text-slate-400 text-base">🎒</span> Những món đồ quan trọng nhất
              </a>
              <a href="#co-can-mua-do-dat" class="flex items-center gap-2 text-slate-700 hover:text-rose-600 px-3 py-2 rounded-lg transition-colors font-bold mt-3">
                <span class="text-slate-400 text-base">💰</span> Có cần mua đồ thật đắt?
              </a>
            </nav>
          </div>
        </aside>

        {/* ---------------- CENTER COLUMN (MAIN CONTENT) ---------------- */}
        <main class="col-span-1 lg:col-span-6 space-y-10">

          <div id="thoi-tiet" class="scroll-mt-28">
            <h2 class="font-serif text-2xl lg:text-[28px] font-bold text-slate-900 border-b-2 border-amber-500 pb-2 inline-block mb-6">1. Thời tiết Kailash thực sự như thế nào?</h2>
            
            <div class="bg-white rounded-2xl shadow-sm border border-slate-200/60 p-6 mb-8 overflow-hidden">
                <h3 class="font-bold text-slate-900 mb-4 uppercase tracking-wide text-sm border-l-4 border-blue-500 pl-2">Bảng nhiệt độ tham khảo</h3>
                <div class="overflow-x-auto">
                    <table class="w-full text-left text-sm text-slate-600 whitespace-nowrap">
                        <thead class="bg-slate-50 text-slate-700 font-bold border-b border-slate-200">
                            <tr>
                                <th class="px-4 py-3">Tháng</th>
                                <th class="px-4 py-3">Ban ngày</th>
                                <th class="px-4 py-3">Ban đêm</th>
                                <th class="px-4 py-3">Đặc điểm</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100">
                            <tr class="hover:bg-slate-50">
                                <td class="px-4 py-3 font-semibold text-slate-800">Tháng 5</td>
                                <td class="px-4 py-3 text-rose-600 font-medium">8–15°C</td>
                                <td class="px-4 py-3 text-blue-600 font-medium">-5 đến -1°C</td>
                                <td class="px-4 py-3">Đầu mùa, gió lạnh, có thể còn tuyết ở Dolma La</td>
                            </tr>
                            <tr class="hover:bg-slate-50">
                                <td class="px-4 py-3 font-semibold text-slate-800">Tháng 6</td>
                                <td class="px-4 py-3 text-rose-600 font-medium">10–18°C</td>
                                <td class="px-4 py-3 text-blue-600 font-medium">0 đến 3°C</td>
                                <td class="px-4 py-3">Thời tiết ổn định, nắng mạnh, không khí rất khô</td>
                            </tr>
                            <tr class="hover:bg-slate-50">
                                <td class="px-4 py-3 font-semibold text-slate-800">Tháng 7</td>
                                <td class="px-4 py-3 text-rose-600 font-medium">12–20°C</td>
                                <td class="px-4 py-3 text-blue-600 font-medium">2 đến 6°C</td>
                                <td class="px-4 py-3">Ấm nhất trong năm, có thể có mưa hoặc tuyết cục bộ</td>
                            </tr>
                            <tr class="hover:bg-slate-50">
                                <td class="px-4 py-3 font-semibold text-slate-800">Tháng 8</td>
                                <td class="px-4 py-3 text-rose-600 font-medium">10–18°C</td>
                                <td class="px-4 py-3 text-blue-600 font-medium">1 đến 5°C</td>
                                <td class="px-4 py-3">Ban ngày dễ chịu, chiều tối lạnh nhanh</td>
                            </tr>
                            <tr class="hover:bg-slate-50">
                                <td class="px-4 py-3 font-semibold text-slate-800">Tháng 9</td>
                                <td class="px-4 py-3 text-rose-600 font-medium">8–15°C</td>
                                <td class="px-4 py-3 text-blue-600 font-medium">-3 đến 1°C</td>
                                <td class="px-4 py-3">Mùa thu, trời trong, lạnh hơn rõ rệt, sáng sớm dễ đóng băng</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
            
            <div class="bg-blue-50 border border-blue-100 rounded-xl p-5 mb-8 flex gap-3 text-[14.5px] text-blue-900 shadow-sm">
                <Info class="w-5 h-5 shrink-0 text-blue-600 mt-0.5" />
                <p><strong>Lưu ý:</strong> Nhiệt độ thực tế có thể thay đổi tùy năm, gió và độ cao; tại đèo Dolma La (5.630 m), cảm nhận thực tế thường thấp hơn nhiệt độ đo được do gió mạnh.</p>
            </div>

            {/* Trang phục theo tháng Table */}
            <div class="bg-white rounded-2xl shadow-sm border border-slate-200/60 p-6 mb-8 overflow-hidden">
                <h3 class="font-bold text-slate-900 mb-4 uppercase tracking-wide text-sm border-l-4 border-amber-500 pl-2">Mức độ cần thiết của trang phục theo từng tháng</h3>
                <p class="text-[14px] text-slate-600 mb-4">Khách đi tháng 6 và tháng 9 cần chuẩn bị rất khác nhau. Bảng dưới đây giúp bạn ưu tiên mang đồ dựa trên kinh nghiệm thực tế của chúng tôi:</p>
                <div class="overflow-x-auto">
                    <table class="w-full text-left text-sm text-slate-600 whitespace-nowrap">
                        <thead class="bg-slate-50 text-slate-700 font-bold border-b border-slate-200">
                            <tr>
                                <th class="px-4 py-3">Tháng</th>
                                <th class="px-4 py-3">Down (Lông vũ)</th>
                                <th class="px-4 py-3">Fleece (Giữ nhiệt)</th>
                                <th class="px-4 py-3">Găng tay</th>
                                <th class="px-4 py-3">Mũ len</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100">
                            <tr class="hover:bg-slate-50">
                                <td class="px-4 py-3 font-semibold text-slate-800">Tháng 5</td>
                                <td class="px-4 py-3 text-rose-500"><span class="inline-flex gap-0.5"><svg class="w-[1.1em] h-[1.1em] inline-block fill-current -mt-0.5" viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></polygon></svg><svg class="w-[1.1em] h-[1.1em] inline-block fill-current -mt-0.5" viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></polygon></svg><svg class="w-[1.1em] h-[1.1em] inline-block fill-current -mt-0.5" viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></polygon></svg><svg class="w-[1.1em] h-[1.1em] inline-block fill-current -mt-0.5" viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></polygon></svg><svg class="w-[1.1em] h-[1.1em] inline-block fill-current -mt-0.5" viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></polygon></svg></span><span class="text-xs text-rose-600 block mt-0.5 font-bold">Không thể thiếu</span></td>
                                <td class="px-4 py-3 text-rose-500"><span class="inline-flex gap-0.5"><svg class="w-[1.1em] h-[1.1em] inline-block fill-current -mt-0.5" viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></polygon></svg><svg class="w-[1.1em] h-[1.1em] inline-block fill-current -mt-0.5" viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></polygon></svg><svg class="w-[1.1em] h-[1.1em] inline-block fill-current -mt-0.5" viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></polygon></svg><svg class="w-[1.1em] h-[1.1em] inline-block fill-current -mt-0.5" viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></polygon></svg><svg class="w-[1.1em] h-[1.1em] inline-block fill-current -mt-0.5" viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></polygon></svg></span><span class="text-xs text-rose-600 block mt-0.5 font-bold">Không thể thiếu</span></td>
                                <td class="px-4 py-3 text-amber-500"><span class="inline-flex gap-0.5"><svg class="w-[1.1em] h-[1.1em] inline-block fill-current -mt-0.5" viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></polygon></svg><svg class="w-[1.1em] h-[1.1em] inline-block fill-current -mt-0.5" viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></polygon></svg><svg class="w-[1.1em] h-[1.1em] inline-block fill-current -mt-0.5" viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></polygon></svg><svg class="w-[1.1em] h-[1.1em] inline-block fill-current -mt-0.5" viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></polygon></svg></span><span class="text-xs text-amber-700 block mt-0.5 font-bold">Nên có</span></td>
                                <td class="px-4 py-3 text-amber-500"><span class="inline-flex gap-0.5"><svg class="w-[1.1em] h-[1.1em] inline-block fill-current -mt-0.5" viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></polygon></svg><svg class="w-[1.1em] h-[1.1em] inline-block fill-current -mt-0.5" viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></polygon></svg><svg class="w-[1.1em] h-[1.1em] inline-block fill-current -mt-0.5" viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></polygon></svg><svg class="w-[1.1em] h-[1.1em] inline-block fill-current -mt-0.5" viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></polygon></svg></span><span class="text-xs text-amber-700 block mt-0.5 font-bold">Nên có</span></td>
                            </tr>
                            <tr class="hover:bg-slate-50">
