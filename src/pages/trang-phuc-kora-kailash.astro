                        </div>
                        <div class="bg-amber-50 p-4 rounded-xl flex flex-col items-center justify-center text-center shadow-sm border border-amber-100 relative">
                            <span class="bg-amber-200 text-rose-700 text-[10px] font-bold px-2 py-0.5 rounded-full absolute -top-2">LỚP 2</span>
                            <svg class="w-6 h-6 mb-2 mt-2 mx-auto" style="color: #f59e0b" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/></svg>
