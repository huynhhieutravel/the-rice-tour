                        </div>
                        <div class="bg-slate-900 p-4 rounded-xl flex flex-col items-center justify-center text-center shadow-xl border border-slate-800 relative">
                            <span class="bg-slate-700 text-white text-[10px] font-bold px-2 py-0.5 rounded-full absolute -top-2">LỚP 4</span>
                            <svg class="w-6 h-6 mb-2 mt-2 mx-auto" style="color: #22d3ee" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="2" x2="22" y1="12" y2="12"/><line x1="12" x2="12" y1="2" y2="22"/><path d="m20 16-4-4 4-4"/><path d="m4 8 4 4-4 4"/><path d="m16 4-4 4-4-4"/><path d="m8 20 4-4 4 4"/></svg>
