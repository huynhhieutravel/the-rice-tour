                        <div class="bg-slate-700 p-4 rounded-xl flex flex-col items-center justify-center text-center shadow-sm border border-slate-600 relative">
                            <span class="bg-slate-500 text-white text-[10px] font-bold px-2 py-0.5 rounded-full absolute -top-2">LỚP 3</span>
                            <svg class="w-6 h-6 mb-2 mt-2 mx-auto" style="color: #ffffff" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17.5 19H9a7 7 0 1 1 6.71-9h1.79a4.5 4.5 0 1 1 0 9Z"/></svg>
