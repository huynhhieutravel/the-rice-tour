---
import BaseLayout from '@/layouts/BaseLayout.astro';

const bg0 = 'https://media.fittour.vn/uploads/background-mong-co.webp';
const bg1 = 'https://media.fittour.vn/uploads/bg-1-mongco-trip.webp';
const bg2 = 'https://media.fittour.vn/uploads/bg-2-mongco-trip.webp';
const bg3 = 'https://media.fittour.vn/uploads/bg-3-mongco-trip.webp';
const bg4 = 'https://media.fittour.vn/uploads/bg-4-mongco-trip.webp';
const bg5 = 'https://media.fittour.vn/uploads/bg-5-mongco-trip.webp';
const bgInfo = 'https://media.fittour.vn/uploads/infographic-lich-trinh-tour-mong-co-12n11d.webp';

const sections = [
  {
    bg: bg1,
    num: "01.",
    title: "CƯỠI NGỰA<br/>XUYÊN RỪNG TAIGA",
    subtitle: "ĐỂ GẶP NGƯỜI DU MỤC TUẦN LỘC",
    desc: "Để vào làng Tsaatan, đoàn sẽ cưỡi ngựa nhiều giờ xuyên rừng Taiga Bắc Mông Cổ – băng qua những lối mòn giữa rừng lá vàng, suối lạnh và không gian gần như tách biệt hoàn toàn khỏi thế giới hiện đại.",
    quote: "“Không phải điểm đến, mà là hành trình thật sự.”",
    features: [
      { name: "HORSE RIDING EXPEDITION", icon: "M20.8 10L19 7H14L10 3H6L9 9H5L3 13H5V21H9V16H11V21H15V13L17.5 13L20.8 10Z" },
      { name: "TAIGA WILDERNESS", icon: "M12 2l8 10h-3l5 8H2l5-8H4z M10 20h4v4h-4z" },
      { name: "OFF THE GRID ADVENTURE", icon: "M3 20l6-9 4 5 5-8 3 12H3z" },
      { name: "REINDEER NOMADS", icon: "M4 20h16l-8-16z M12 4v16 M8 20l4-8 4 8" }
    ]
  },
  {
    bg: bg2,
    num: "02.",
    title: "SỐNG GIỮA NGƯỜI<br/>TSAATAN",
    subtitle: "NHỮNG NGƯỜI DU MỤC TUẦN LỘC CUỐI CÙNG",
    desc: "Trải nghiệm nhịp sống nguyên bản cùng cộng đồng Tsaatan - những người đã sống cùng đàn tuần lộc giữa rừng Taiga hàng trăm năm. Uống trà sữa mặn, nghe chuyện mùa di cư, gặp trẻ em chăn tuần lộc và cảm nhận cuộc sống không internet, không điện giữa đại ngàn.",
    quote: "“Không phải điểm đến, mà là hành trình thật sự.”",
    features: [
      { name: "LIVING WITH FAMILIES", icon: "M5 8h12v5a6 6 0 01-12 0V8z M17 10h2a2 2 0 010 4h-2 M8 3v2 M12 3v2 M16 3v2 M3 19h18" },
      { name: "REINDEER HERDING", icon: "M20.8 10L19 7H14L10 3H6L9 9H5L3 13H5V21H9V16H11V21H15V13L17.5 13L20.8 10Z" },
      { name: "STORIES AROUND FIRE", icon: "M12 22c4-2 7-6 7-10 0-4-3-8-7-10-4 2-7 6-7 10 0 4 3 8 7 10z M12 12c1.5 1.5 2.5 3 2.5 5 0 2-1 3-2.5 4-1.5-1-2.5-2-2.5-4 0-2 1-3.5 2.5-5z" },
      { name: "NOMADIC LIFE", icon: "M4 20h16l-8-16z M12 4v16 M8 20l4-8 4 8" },
      { name: "DISCONNECT TO RECONNECT", icon: "M2 2l20 20 M5 8c4-3 10-3 14 0 M8 11c2-1 4-1 6 0" }
    ]
  },
  {
    bg: bg3,
    num: "03.",
    title: "OFFROAD XUYÊN<br/>BẮC MÔNG CỔ",
    subtitle: "BẰNG XE ĐỊA HÌNH EXPEDITION",
    desc: "Hành trình sử dụng các dòng xe địa hình chuyên dụng như Land Cruiser, Lexus LX hoặc Russian UAZ để đi sâu vào vùng Taiga sát biên giới Nga. Những cung đường vượt suối, xuyên rừng, băng qua thảo nguyên hoang vắng mang đến cảm giác thật sự của một expedition.",
    quote: "“Không phải là con đường dễ nhất, nhưng là con đường đưa ta đến những nơi ít người từng chạm tới.”",
    features: [
      { name: "OFFROAD ADVENTURE", icon: "M3 12h18v6H3z M5 12V8l4-3h6l4 3v4 M7 15a2 2 0 100 4 2 2 0 000-4z M17 15a2 2 0 100 4 2 2 0 000-4z" },
      { name: "WILD LANDSCAPES", icon: "M3 20l6-9 4 5 5-8 3 12H3z" },
      { name: "RIVER CROSSING", icon: "M2 12c3-2 5-2 8 0s5 2 8 0 5-2 8 0 M2 16c3-2 5-2 8 0s5 2 8 0 5-2 8 0" },
      { name: "DEEP TAIGA", icon: "M12 2l8 10h-3l5 8H2l5-8H4z" },
      { name: "4x4 VEHICLES", icon: "M7 15a2 2 0 100 4 2 2 0 000-4z M17 15a2 2 0 100 4 2 2 0 000-4z M12 17h1" }
    ]
  },
  {
    bg: bg4,
    num: "04.",
    title: "SĂN MILKY WAY",
    subtitle: "GIỮA VÙNG TRỜI KHÔNG Ô NHIỄM ÁNH SÁNG",
    desc: "Tại hồ Khuvsgul và vùng Taiga phía Bắc, gần như không có ô nhiễm ánh sáng đô thị. Nếu thời tiết thuận lợi, đoàn sẽ có cơ hội săn Milky Way, chụp bầu trời sao phương Bắc và cảm nhận sự tĩnh lặng hiếm có.",
    quote: "“Khi màn đêm buông xuống, vũ trụ hiện ra rõ hơn chính chúng ta.”",
    features: [
      { name: "MILKY WAY HUNTING", icon: "M12 2l3 6 7 1-5 5 1 7-6-3-6 3 1-7-5-5 7-1z" },
      { name: "STARGAZING", icon: "M4 4h1v1H4z M20 4h1v1h-1z M19 19h1v1h-1z M12 2l3 6 7 1-5 5 1 7-6-3-6 3 1-7-5-5 7-1z" },
      { name: "CAMPFIRE", icon: "M12 22c4-2 7-6 7-10 0-4-3-8-7-10-4 2-7 6-7 10 0 4 3 8 7 10z" },
      { name: "NIGHT VIEW", icon: "M3 20l6-9 4 5 5-8 3 12H3z M18 8a3 3 0 110-6 3 3 0 010 6z" },
      { name: "ASTRO PHOTOGRAPHY", icon: "M4 8h3l2-2h6l2 2h3v12H4z M12 16a4 4 0 100-8 4 4 0 000 8z" }
    ]
  },
  {
    bg: bg5,
    num: "05.",
    title: "MỘT HÀNH TRÌNH<br/>\"DISCONNECT\"",
    subtitle: "KHỎI THẾ GIỚI HIỆN ĐẠI",
    desc: "Nhiều ngày không internet. Không sóng điện thoại. Không mạng xã hội. Chỉ có thiên nhiên nguyên bản, nhịp sống du mục và sự tĩnh lặng rất hiếm còn tồn tại. Đây không phải là sự thiếu thốn, đây là một dạng “luxury” mà rất ít người được trải nghiệm.",
    quote: "“Luxury không nằm ở những gì ta có, mà ở những gì ta chọn buông bỏ.”",
    features: [
      { name: "DIGITAL DETOX", icon: "M2 2l20 20 M5 8c4-3 10-3 14 0 M8 11c2-1 4-1 6 0" },
      { name: "NOMADIC LIFESTYLE", icon: "M4 20h16l-8-16z M12 4v16" },
      { name: "BACK TO NATURE", icon: "M12 2l8 10h-3l5 8H2l5-8H4z" },
      { name: "INNER CONNECTION", icon: "M12 2c5 0 9 4 9 9s-4 9-9 9-9-4-9-9 4-9 9-9z M12 7v5l3 3" },
      { name: "PURPOSEFUL JOURNEY", icon: "M12 2c5 0 9 4 9 9s-4 9-9 9-9-4-9-9 4-9 9-9z M12 17v-1 M12 8v1 M8 12h1 M15 12h1" }
    ]
  }
];
---

<BaseLayout title="Tour Mông Cổ 12N11Đ - Khám phá Làng Tuần Lộc" description="Hành trình cưỡi ngựa xuyên rừng Taiga gặp người du mục tuần lộc Tsaatan.">
  <div class="snap-y snap-mandatory h-screen overflow-y-scroll overflow-x-hidden scroll-smooth">
    
    <!-- Section 0: HERO (SEO & Intro) -->
    <section class="snap-start relative w-full h-screen min-h-[850px] overflow-hidden bg-[#0c1012] font-sans selection:bg-amber-500/30 flex items-center justify-center">
      <!-- Mờ ảnh background 1 làm nền cho Hero -->
      <div class="absolute inset-0 z-0 opacity-40">
        <img 
          src={bg0} 
          alt="Tour Mông Cổ 12 Ngày 11 Đêm" 
          class="w-full h-full object-cover object-center transform scale-105 animate-[slowZoom_30s_ease-in-out_infinite_alternate]"
        />
        <div class="absolute inset-0 bg-gradient-to-b from-[#0c1012] via-transparent to-[#0c1012]"></div>
      </div>

      <div class="relative z-10 w-full max-w-5xl mx-auto px-8 lg:px-16 text-center flex flex-col items-center pt-10">
        <!-- Badge -->
        <div class="inline-flex items-center gap-3 border border-amber-500/30 px-6 py-2 rounded-full backdrop-blur-sm bg-black/20 mb-8">
          <span class="w-2 h-2 rounded-full bg-amber-500 animate-pulse"></span>
          <span class="text-xs text-amber-500 uppercase tracking-[0.2em] font-bold">Limited Departure - Autumn 2026</span>
        </div>

        <!-- H1 chuẩn SEO -->
        <h1 class="text-6xl lg:text-8xl font-black text-white uppercase leading-[0.9] tracking-tighter drop-shadow-2xl" style="font-family: 'Inter', sans-serif;">
          TOUR MÔNG CỔ<br/>
          <span class="text-5xl lg:text-7xl text-[#d4af37]">LÀNG TUẦN LỘC</span>
        </h1>
        
        <!-- H2 phụ -->
        <h2 class="text-xl lg:text-3xl font-serif text-gray-300 mt-8 uppercase tracking-[0.3em] drop-shadow-md">
          Theo dấu chân du mục vùng Taiga
        </h2>

        <!-- Đoạn mở bài mồi SEO -->
        <p class="mt-8 text-gray-400 text-lg lg:text-xl leading-relaxed font-light max-w-3xl">
          Có những nơi trên thế giới không thể đi vào mùa hè hay mùa đông, bởi chỉ khi mùa thu chạm tới, vùng đất ấy mới hiện ra đúng với vẻ đẹp nguyên bản nhất của nó. Bắc Mông Cổ là một nơi như thế. 
        </p>
        
        <p class="mt-4 text-gray-400 text-base lg:text-lg leading-relaxed font-light max-w-3xl">
          Một hành trình 12 Ngày 11 Đêm đi sâu vào vùng lõi của rừng già Taiga sát biên giới Nga, băng qua suối lạnh, ngủ lều du mục và gặp gỡ những người Tsaatan chăn tuần lộc cuối cùng trên thế giới.
        </p>

        <!-- CTA Cuộn xuống -->
        <div class="mt-16 animate-bounce text-amber-500/70">
          <p class="text-xs uppercase tracking-widest mb-2 font-bold">Cuộn để khám phá</p>
          <svg class="w-6 h-6 mx-auto" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path></svg>
        </div>
      </div>
    </section>

    {sections.map((section, index) => (
      <section class="snap-start relative w-full h-screen min-h-[850px] overflow-hidden bg-slate-900 font-sans selection:bg-amber-500/30">
        <!-- Background Image with Parallax & Overlay -->
        <div class="absolute inset-0 z-0">
          <img 
            src={section.bg} 
            alt={`Mongolia Section ${index + 1}`} 
            class="w-full h-full object-cover object-center transform scale-105 transition-transform duration-1000 group-hover:scale-100"
          />
          <div class="absolute inset-0 bg-gradient-to-r from-black/90 via-black/60 to-transparent"></div>
          <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent"></div>
        </div>

        <!-- Top Header (Only show on first section for impact, or all) -->
        {index === 0 && (
          <header class="absolute top-0 left-0 w-full z-20 flex justify-between items-start px-8 lg:px-16 pt-10 pointer-events-none">
            <div class="flex items-center gap-4 pointer-events-auto">
              <div class="w-16 h-16 rounded-full border border-amber-500/50 flex items-center justify-center p-2">
                <svg viewBox="0 0 24 24" fill="none" stroke="#d97706" class="w-10 h-10" stroke-width="1.5"><path d="M12 21a9 9 0 100-18 9 9 0 000 18z"></path><path d="M12 17v-4"></path><path d="M12 9h.01"></path><path d="M7.5 13.5l1.5-1.5"></path><path d="M16.5 13.5l-1.5-1.5"></path></svg>
              </div>
              <div>
                <h2 class="text-xs text-amber-500 uppercase tracking-[0.2em] font-bold">Fit Tour</h2>
                <h1 class="text-3xl font-serif text-white leading-none mt-1">MONGOLIA</h1>
                <p class="text-[10px] text-gray-300 uppercase tracking-widest mt-1">Autumn Expedition</p>
              </div>
            </div>
          </header>
        )}

        <!-- Main Content -->
        <div class="relative z-10 w-full h-full max-w-7xl mx-auto px-8 lg:px-16 flex flex-col justify-center pt-20">
          <div class="max-w-xl">
            <span class="text-7xl lg:text-9xl font-black text-[#d4af37] leading-none opacity-90 block mb-2 drop-shadow-lg">{section.num}</span>
            <h2 class="text-5xl lg:text-7xl font-black text-white uppercase leading-[0.95] tracking-tight drop-shadow-xl" set:html={section.title} />
            <h3 class="text-xl lg:text-2xl text-[#d4af37] mt-6 uppercase tracking-widest drop-shadow-md">
              {section.subtitle}
            </h3>
            <p class="mt-6 text-gray-300 text-base lg:text-lg leading-relaxed font-light max-w-md">
              {section.desc}
            </p>

            <div class={`grid ${section.features.length === 5 ? 'grid-cols-5' : 'grid-cols-4'} gap-4 mt-12 max-w-2xl border-y border-white/10 py-6`}>
              {section.features.map(feat => (
                <div class="flex flex-col items-center text-center group cursor-pointer">
                  <svg class="w-12 h-12 lg:w-14 lg:h-14 text-[#d4af37] mb-2 group-hover:scale-110 transition-transform duration-300" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
                    <path d={feat.icon} />
                  </svg>
                  <span class="mt-2 text-[9px] lg:text-[10px] text-gray-400 font-bold uppercase tracking-[0.2em] group-hover:text-white transition-colors leading-tight" set:html={feat.name.replace(' ', '<br/>')} />
                </div>
              ))}
            </div>

            <blockquote class="mt-10 font-serif italic text-xl lg:text-2xl text-[#d4af37] drop-shadow-md">
              {section.quote}
            </blockquote>
          </div>
        </div>
      </section>
    ))}

    <!-- Section 6: INFOGRAPHIC -->
    <section class="snap-start relative w-full h-screen min-h-[850px] bg-[#0c1012] flex items-center justify-center overflow-hidden p-8">
      <div class="max-w-7xl w-full mx-auto relative z-10 flex flex-col items-center">
        <h2 class="text-3xl lg:text-5xl font-black text-white uppercase tracking-widest mb-10 text-center">
          5 TRẢI NGHIỆM ĐẶC BIỆT NHẤT<br/><span class="text-xl lg:text-2xl text-[#d4af37] font-serif">HÀNH TRÌNH KHÁM PHÁ VÙNG TAIGA</span>
        </h2>
        <img 
          src={bgInfo} 
          alt="Mongolia Infographic" 
          class="w-full object-contain rounded-xl shadow-2xl border border-white/10"
        />
      </div>
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,_var(--tw-gradient-stops))] from-[#d4af37]/10 via-[#0c1012]/80 to-[#0c1012] z-0"></div>
    </section>

  </div>

  <style>
    /* Hide scrollbar for smooth snap experience */
    .snap-y::-webkit-scrollbar {
      display: none;
    }
    .snap-y {
      -ms-overflow-style: none;  /* IE and Edge */
      scrollbar-width: none;  /* Firefox */
    }
  </style>
</BaseLayout>
