---
import { env } from 'cloudflare:workers';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { safeQueryCritical } from '@/lib/db-client';
import { getGlobalSettings } from '@/lib/settingsHelper';
import { MapPin, Info, Users, Clock, Calendar, Compass, Share2, Link as LinkIcon, ChevronRight, CheckCircle2 } from 'lucide-react';

const d1Db = env?.dulichcoguu_d1;
if (!d1Db) return Astro.rewrite("/500");

// Fetch CMS Data for SEO and Metadata
let post;
try {
  post = await safeQueryCritical(
    d1Db.prepare(`
      SELECT p.*, u.url as authorUrl, u.avatar as authorAvatar 
      FROM Post p 
      LEFT JOIN "User" u ON p.authorId = u.id 
      WHERE p.slug = ? AND (p.status = 'published' OR p.status = 'publish')
    `).bind('chuan-bi-suc-khoe-kora-kailash').first<any>(),
    { route: Astro.url.pathname, slug: 'chuan-bi-suc-khoe-kora-kailash', queryType: "fetch_post_by_slug" }
  );
} catch (e) {
  return Astro.rewrite("/500");
}

if (!post) {
  return Astro.rewrite("/404");
}

const { settings } = await getGlobalSettings();

const seoTitle = post.seoTitle || post.title || 'Chuẩn bị sức khỏe trước khi Kora Kailash';
const seoDesc = post.seoDesc || post.excerpt || 'Hướng dẫn chi tiết về các bài tập rèn luyện thể lực, kinh nghiệm chuẩn bị sức khoẻ, ăn uống và thích nghi độ cao trước khi đi Kora núi Kailash.';
const seoImage = post.seoImage || post.featuredImage || 'https://pub-fe90037727604a2586cc601e6a3c6575.r2.dev/wp-content/uploads/2024/07/du-khach-chuan-bi-hanh-trinh-kora-kailash.jpg';

// --- DATE LOGIC ---
const createdAtStr = post.createdAt || post.publishedAt || new Date().toISOString();
const updatedAtStr = post.updatedAt || createdAtStr;

const createdAt = new Date(createdAtStr.replace(' ', 'T'));
const updatedAt = new Date(updatedAtStr.replace(' ', 'T'));

const isUpdated = updatedAt.getTime() - createdAt.getTime() > 86400000; 
const displayDate = isUpdated ? updatedAt : createdAt;
const datePrefix = isUpdated ? "Cập nhật:" : "Xuất bản:";

const formattedDate = displayDate.toLocaleDateString('vi-VN', { day: '2-digit', month: '2-digit', year: 'numeric' });
// ------------------

const adminEditUrl = `/admin/posts/edit?id=${post.id}`;
---

<BaseLayout 
  title={seoTitle} 
  description={seoDesc} 
  image={seoImage}
  adminEditUrl={adminEditUrl}
>
  <div class="bg-[#F8F9FA] text-[#1E293B] font-sans antialiased selection:bg-[#c89845] selection:text-white">

    {/* ================= HERO SECTION ================= */}
    <section class="relative w-full h-[600px] lg:h-[650px] overflow-hidden">
      <div class="absolute inset-0 z-0 bg-slate-900">
        <img src={seoImage} alt="Núi Kailash" class="w-full h-full object-cover object-center opacity-80" fetchpriority="high" loading="eager" />
        <div class="absolute inset-0 bg-gradient-to-r from-black/80 via-black/50 to-transparent"></div>
        <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-transparent to-transparent"></div>
      </div>

      <div class="relative z-10 max-w-[1600px] mx-auto px-4 sm:px-6 lg:px-12 h-full flex flex-col justify-center pt-20 pb-16">
        
        {/* Breadcrumb */}
        <div class="flex items-center gap-2 text-[13px] text-white/70 font-medium mb-6">
          <a href="/" class="hover:text-white transition-colors">Trang chủ</a>
          <ChevronRight class="w-3 h-3" />
          <a href="/blog" class="hover:text-white transition-colors">Blog</a>
          <ChevronRight class="w-3 h-3" />
          <span class="text-white">Tây Tạng</span>
        </div>

        {/* Titles */}
        <h1 class="font-serif text-4xl sm:text-5xl lg:text-6xl font-bold text-white mb-4 leading-[1.1] drop-shadow-lg max-w-4xl">
          Chuẩn bị sức khoẻ và rèn luyện trước khi Kora Kailash
        </h1>
        <h2 class="font-serif text-xl sm:text-3xl text-amber-400 italic mb-10 max-w-3xl drop-shadow-md">
          Hành trang quan trọng nhất không nằm trong balo, mà ở cơ thể bạn
        </h2>
        <p class="text-white/90 text-base sm:text-lg max-w-2xl leading-relaxed mb-8 hidden md:block drop-shadow-md font-medium">
          Một chuyến Kora thành công không bắt đầu ở Darchen. Nó bắt đầu từ nhiều tuần, thậm chí nhiều tháng trước ngày khởi hành.
        </p>

        {/* Author Meta */}
        <div class="flex flex-wrap items-center gap-6 text-sm text-white/80 border-t border-white/20 pt-6 max-w-3xl">
          <a href={post.authorUrl || "/huynh-hieu"} class="flex items-center gap-3 group">
            <img src={post.authorAvatar || "https://media.fittour.vn/uploads/huynhhieutravel.webp"} alt={post.author || 'Huynh Hieu Travel'} class="w-10 h-10 rounded-full border-2 border-white/30 object-cover object-top group-hover:border-amber-400 transition-colors" />
            <span class="font-bold text-white group-hover:text-amber-400 transition-colors flex items-center gap-1">
              {post.author || 'Huynh Hieu Travel'} 
              <CheckCircle2 class="w-4 h-4 text-blue-400" />
            </span>
          </a>
          <div class="flex items-center gap-2 bg-white/10 px-4 py-2 rounded-full backdrop-blur-sm border border-white/10">
            <Calendar class="w-4 h-4 opacity-70" />
            <span>{datePrefix} {formattedDate}</span>
          </div>
          <div class="flex items-center gap-2 bg-black/20 px-3 py-1.5 rounded-full backdrop-blur-sm">
            <Clock class="w-4 h-4 text-amber-400" />
            <span>10 phút đọc</span>
          </div>
        </div>

        {/* Badges Line */}
        <div class="flex flex-wrap items-center gap-4 mt-8 pt-6">
          <div class="flex items-center gap-2 text-sm text-white font-medium bg-black/60 backdrop-blur-md px-4 py-2 border border-white/10 rounded-lg shadow-xl">
            <span class="text-amber-400 text-lg">🏃‍♂️</span> Rèn luyện thể lực
          </div>
          <div class="flex items-center gap-2 text-sm text-white font-medium bg-black/60 backdrop-blur-md px-4 py-2 border border-white/10 rounded-lg shadow-xl">
            <span class="text-amber-400 text-lg">🫁</span> Thích nghi độ cao
          </div>
          <div class="flex items-center gap-2 text-sm text-white font-medium bg-black/60 backdrop-blur-md px-4 py-2 border border-white/10 rounded-lg shadow-xl">
            <span class="text-amber-400 text-lg">🗓️</span> Chuẩn bị 8-12 tuần
          </div>
          <div class="flex items-center gap-2 text-sm text-white font-medium bg-black/60 backdrop-blur-md px-4 py-2 border border-white/10 rounded-lg shadow-xl">
            <span class="text-amber-400 text-lg">🩺</span> Khám sức khoẻ
          </div>
</div>
      </div>

      </div>
    </section>

    {/* ================= MAIN CONTENT GRID ================= */}
    <div class="max-w-[1600px] mx-auto px-4 sm:px-6 lg:px-12 py-12 lg:py-16">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-start">

        {/* ---------------- LEFT SIDEBAR (TOC) ---------------- */}
        
        <aside class="hidden lg:block lg:col-span-3 sticky top-24">
          <div class="bg-white rounded-2xl shadow-sm border border-slate-200/60 p-6 overflow-hidden">
            <div class="flex items-center gap-2 font-bold text-slate-800 mb-6 border-l-4 border-amber-500 pl-3 text-sm tracking-wide uppercase">
              Mục lục bài viết
            </div>
            
            <nav class="space-y-1 text-[13.5px] font-medium max-h-[70vh] overflow-y-auto custom-scrollbar">
              <a href="#vi-sao-phai-chuan-bi" class="flex items-center gap-2 text-slate-700 hover:text-amber-600 px-3 py-2 rounded-lg transition-colors font-bold">
                <span class="text-slate-400 text-base">🏔️</span> Vì sao phải chuẩn bị?
              </a>
              <a href="#chuan-bi-truoc-bao-lau" class="flex items-center gap-2 text-slate-700 hover:text-amber-600 px-3 py-2 rounded-lg transition-colors font-bold mt-1">
                <span class="text-slate-400 text-base">⏳</span> Chuẩn bị trước bao lâu?
              </a>
              <a href="#bai-tap-phu-hop" class="flex items-center gap-2 text-slate-700 hover:text-amber-600 px-3 py-2 rounded-lg transition-colors font-bold mt-1">
                <span class="text-slate-400 text-base">🏃</span> Bài tập phù hợp
              </a>
              <a href="#co-can-trekking-nhieu" class="flex items-center gap-2 text-slate-700 hover:text-amber-600 px-3 py-2 rounded-lg transition-colors font-bold mt-1">
                <span class="text-slate-400 text-base">🧗</span> Có cần trekking nhiều?
              </a>
              <a href="#kiem-tra-suc-khoe" class="flex items-center gap-2 text-slate-700 hover:text-amber-600 px-3 py-2 rounded-lg transition-colors font-bold mt-1">
                <span class="text-slate-400 text-base">🩺</span> Kiểm tra sức khỏe
              </a>
              <a href="#che-do-an-uong" class="flex items-center gap-2 text-slate-700 hover:text-amber-600 px-3 py-2 rounded-lg transition-colors font-bold mt-1">
                <span class="text-slate-400 text-base">🥗</span> Ăn uống & Sinh hoạt
              </a>
              <a href="#nhung-sai-lam-pho-bien" class="flex items-center gap-2 text-slate-700 hover:text-amber-600 px-3 py-2 rounded-lg transition-colors font-bold mt-1">
                <span class="text-slate-400 text-base">⚠️</span> Những sai lầm phổ biến
              </a>
              <a href="#chuan-bi-tam-ly" class="flex items-center gap-2 text-slate-700 hover:text-amber-600 px-3 py-2 rounded-lg transition-colors font-bold mt-1">
                <span class="text-slate-400 text-base">🧘</span> Chuẩn bị tâm lý
              </a>
              <a href="#ngay-thu-hai-dolma-la" class="flex items-center gap-2 text-slate-700 hover:text-amber-600 px-3 py-2 rounded-lg transition-colors font-bold mt-1">
                <span class="text-slate-400 text-base">🏔️</span> Ngày thứ hai Dolma La
              </a>
              <a href="#cau-hoi-thuong-gap" class="flex items-center gap-2 text-slate-700 hover:text-amber-600 px-3 py-2 rounded-lg transition-colors font-bold mt-1">
                <span class="text-slate-400 text-base">❓</span> Câu hỏi thường gặp
              </a>
              <a href="#loi-nhan" class="flex items-center gap-2 text-slate-700 hover:text-amber-600 px-3 py-2 rounded-lg transition-colors font-bold mt-1">
                <span class="text-slate-400 text-base">💌</span> Lời nhắn trước khi đi
              </a>
            </nav>
          </div>
        </aside>


        {/* ---------------- CENTER COLUMN (MAIN CONTENT) ---------------- */}
        
        
        
        <main class="col-span-1 lg:col-span-6 space-y-12">
          {/* Quick Overview Stats Bar */}
          <div class="bg-white rounded-2xl shadow-sm border border-slate-200/60 p-6 flex flex-wrap lg:flex-nowrap items-center justify-between gap-4">
            <div class="w-full flex items-center justify-between gap-4 mb-2 lg:hidden">
              <span class="font-bold text-slate-800 text-sm border-l-4 border-emerald-500 pl-2 uppercase">Tổng Quan Nhanh</span>
            </div>
            <div class="flex items-center gap-3 w-[48%] lg:w-auto">
              <div class="w-10 h-10 rounded-full bg-amber-50 flex items-center justify-center text-amber-600 text-xl border border-amber-100 shrink-0">🏃</div>
              <div>
                <div class="text-[11px] text-slate-500 font-medium uppercase tracking-wider">Hoạt động</div>
                <div class="text-[14px] font-bold text-slate-800">Đi bộ 52km</div>
              </div>
            </div>
            <div class="hidden lg:block w-px h-8 bg-slate-200"></div>
            <div class="flex items-center gap-3 w-[48%] lg:w-auto">
              <div class="w-10 h-10 rounded-full bg-rose-50 flex items-center justify-center text-rose-600 text-xl border border-rose-100 shrink-0">🏔️</div>
              <div>
                <div class="text-[11px] text-slate-500 font-medium uppercase tracking-wider">Độ cao tối đa</div>
                <div class="text-[14px] font-bold text-slate-800">5.630m</div>
              </div>
            </div>
            <div class="hidden lg:block w-px h-8 bg-slate-200"></div>
            <div class="flex items-center gap-3 w-[48%] lg:w-auto mt-2 lg:mt-0">
              <div class="w-10 h-10 rounded-full bg-emerald-50 flex items-center justify-center text-emerald-600 text-xl border border-emerald-100 shrink-0">⏳</div>
              <div>
                <div class="text-[11px] text-slate-500 font-medium uppercase tracking-wider">Thời gian chuẩn bị</div>
                <div class="text-[14px] font-bold text-slate-800">8-12 tuần</div>
              </div>
            </div>
            <div class="hidden lg:block w-px h-8 bg-slate-200"></div>
            <div class="flex items-center gap-3 w-[48%] lg:w-auto mt-2 lg:mt-0">
              <div class="w-10 h-10 rounded-full bg-blue-50 flex items-center justify-center text-blue-600 text-xl border border-blue-100 shrink-0">🩺</div>
              <div>
                <div class="text-[11px] text-slate-500 font-medium uppercase tracking-wider">Khám sức khoẻ</div>
                <div class="text-[14px] font-bold text-slate-800">Bắt buộc</div>
              </div>
            </div>
          </div>

          <div class="text-xl lg:text-2xl font-serif text-slate-600 leading-relaxed italic border-l-4 border-amber-500 pl-6 my-10">
            "Kora không được quyết định ở Dolma La. Nó được quyết định trong 8 tuần trước chuyến đi."
          </div>

          <div id="vi-sao-phai-chuan-bi" class="scroll-mt-28">
            <h2 class="font-serif text-2xl lg:text-3xl font-bold text-slate-900 border-b-2 border-amber-500 pb-2 inline-block mb-8">Vì sao phải chuẩn bị sức khỏe trước khi đi Kailash?</h2>
            
            <p class="text-[16.5px] leading-relaxed text-slate-700 font-medium mb-6">
              Ở Dolma La (5.630m), nhiều người ngạc nhiên khi chỉ đi vài chục bước đã phải dừng lại để thở. Không phải vì con dốc quá khó. Mà vì ở độ cao này, áp suất khí quyển giảm khiến lượng oxy cơ thể nhận được trong mỗi nhịp thở thấp hơn đáng kể so với đồng bằng. Ngay cả những hoạt động rất bình thường như đi bộ, leo một con dốc ngắn hay mang theo chiếc balo nhẹ cũng trở nên tốn sức hơn.
            </p>

            <div class="bg-slate-50 p-6 rounded-2xl border border-slate-100 mb-8">
              <div class="flex gap-4 items-start">
                <span class="text-3xl">👤</span>
                <div>
                  <h3 class="font-bold text-slate-900 mb-2">Chuyện của một vị khách</h3>
                  <p class="text-[15px] text-slate-600 leading-relaxed m-0">
                    Chị Ly (54 tuổi) chưa từng trekking. Điều chị làm suốt hai tháng trước chuyến đi chỉ là đi bộ 45 phút mỗi chiều và leo cầu thang ở công ty. Ba ngày Kora trôi qua chậm nhưng đều. Chị hoàn thành hành trình mà không cần thuê ngựa, trong khi một vài bạn trẻ có thành tích chạy bộ nhưng chủ quan lại bị sốc độ cao.
                  </p>
                </div>
              </div>
            </div>

            <p class="text-[16px] leading-relaxed text-slate-700 mb-6">
              <a href="/kinh-nghiem-di-tour-hanh-huong-kailash-tay-tang" title="Kinh nghiệm Kora Kailash" target="_blank" class="text-amber-800 hover:text-amber-900 font-bold underline decoration-amber-300/50 underline-offset-4">Kora Kailash</a> không phải là một cung trekking quá khó về mặt kỹ thuật. Bạn sẽ không phải leo vách đá hay vượt qua những địa hình nguy hiểm. Điều khiến hành trình này trở nên đặc biệt là độ cao trên 4.500 mét. Khi lên cao, tim phải đập nhanh hơn để đưa oxy đến các cơ quan, nhịp thở trở nên gấp hơn và cơ bắp cũng mệt mỏi nhanh hơn bình thường. Đây là phản ứng sinh lý hoàn toàn tự nhiên.
            </p>

            <div class="bg-blue-50/50 border border-blue-100 rounded-2xl p-6 mb-8 mt-2">
              <h3 class="font-bold text-blue-900 text-sm tracking-wide uppercase mb-4">Ở ĐỘ CAO TRÊN 4.500M, BẠN SẼ CẢM THẤY GÌ?</h3>
              <div class="grid grid-cols-2 gap-3 mb-4">
                <div class="flex items-center gap-2 text-blue-800 text-[15px] font-medium"><div class="text-blue-500 text-lg">✔</div> Thở nhanh hơn</div>
                <div class="flex items-center gap-2 text-blue-800 text-[15px] font-medium"><div class="text-blue-500 text-lg">✔</div> Tim đập nhanh hơn</div>
                <div class="flex items-center gap-2 text-blue-800 text-[15px] font-medium"><div class="text-blue-500 text-lg">✔</div> Mệt mỏi nhanh hơn</div>
                <div class="flex items-center gap-2 text-blue-800 text-[15px] font-medium"><div class="text-blue-500 text-lg">✔</div> Bước đi chậm lại</div>
              </div>
              <div class="flex items-center gap-2 text-blue-700 text-[14.5px] font-bold bg-blue-100/50 p-3 rounded-lg border border-blue-200/50">
                <span class="text-lg">↓</span> Đó là những phản ứng hoàn toàn bình thường để cơ thể thích nghi.
              </div>
            </div>

            <p class="text-[16px] leading-relaxed text-slate-700 mb-6">
              Một điều cần hiểu rõ là thể lực và khả năng thích nghi độ cao không hoàn toàn giống nhau. Một người chạy 10km ở thành phố chưa chắc dễ dàng đi bộ ở độ cao 5.000m. Nhưng việc rèn luyện hệ tim mạch và hô hấp trong nhiều tuần trước ngày khởi hành sẽ tạo ra một nền tảng sức khỏe vững vàng, giúp cơ thể có nhiều "dự trữ" hơn để thích nghi dễ dàng với môi trường mới. 
            </p>

            <figure class="mt-8 mb-10 relative aspect-video w-full rounded-2xl overflow-hidden shadow-sm border border-slate-200/60">
              <img src="https://media.fittour.vn/uploads/2024/07/doan-hanh-huong-di-chuyen-trong-thoi-tiet-dep.webp" alt="Đi bộ quanh Kailash" class="w-full h-full object-cover" loading="lazy" />
            </figure>
          </div>

          <div id="chuan-bi-truoc-bao-lau" class="scroll-mt-28 pt-8 border-t border-slate-100">
            <h2 class="font-serif text-2xl lg:text-3xl font-bold text-slate-900 border-b-2 border-amber-500 pb-2 inline-block mb-8">Nên bắt đầu chuẩn bị trước bao lâu?</h2>

            <p class="text-[16px] leading-relaxed text-slate-700 mb-8">
              "Em chỉ còn một tháng nữa là khởi hành, liệu bây giờ mới bắt đầu tập có kịp không?" - Đây là một trong những câu hỏi phổ biến nhất. Câu trả lời là càng sớm càng tốt, nhưng đừng cố gắng tập luyện dồn dập vào 2 tuần cuối. Bạn không thể "mua" thể lực bằng sự vội vàng. Hãy nhìn vào timeline sau:
            </p>

            <div class="space-y-6 mb-10">
              {/* Timeline Item 1 */}
              <div class="flex items-stretch gap-6">
                <div class="w-16 shrink-0 text-right">
                  <div class="font-bold text-slate-900">8-12 tuần</div>
                  <div class="text-[12px] text-slate-500">trước đi</div>
                </div>
                <div class="relative w-2 bg-slate-100 rounded-full">
                  <div class="absolute inset-x-0 top-0 h-full bg-emerald-500 rounded-full"></div>
                </div>
                <div class="pb-6">
                  <h3 class="font-bold text-lg text-slate-800 mb-1">Xây nền tảng (Giai đoạn đầu)</h3>
                  <p class="text-slate-600 text-[15px]">Hình thành thói quen đi bộ, đạp xe, bơi (30-45 phút/ngày). Điều chỉnh chế độ ăn uống và giấc ngủ.</p>
                </div>
              </div>

              {/* Timeline Item 2 */}
              <div class="flex items-stretch gap-6">
                <div class="w-16 shrink-0 text-right">
                  <div class="font-bold text-slate-900">4-8 tuần</div>
                  <div class="text-[12px] text-slate-500">trước đi</div>
                </div>
                <div class="relative w-2 bg-slate-100 rounded-full">
                  <div class="absolute inset-x-0 top-0 h-3/4 bg-amber-500 rounded-full"></div>
                </div>
                <div class="pb-6">
                  <h3 class="font-bold text-lg text-slate-800 mb-1">Tăng sức bền & Mô phỏng (Giai đoạn giữa)</h3>
                  <p class="text-slate-600 text-[15px]">Tăng thời gian lên 60 phút. Bổ sung leo cầu thang, mang balo 3-5kg, tham gia hiking nhẹ cuối tuần.</p>
                </div>
              </div>

              {/* Timeline Item 3 */}
              <div class="flex items-stretch gap-6">
                <div class="w-16 shrink-0 text-right">
                  <div class="font-bold text-slate-900">2 tuần</div>
                  <div class="text-[12px] text-slate-500">trước đi</div>
                </div>
                <div class="relative w-2 bg-slate-100 rounded-full">
                  <div class="absolute inset-x-0 top-0 h-1/3 bg-rose-500 rounded-full"></div>
                </div>
                <div>
                  <h3 class="font-bold text-lg text-slate-800 mb-1">Giảm tải & Duy trì (Giai đoạn cuối)</h3>
                  <p class="text-slate-600 text-[15px]">Giảm 50% cường độ. Không cố gắng tập nặng để bù đắp. Ưu tiên ngủ đủ giấc, tránh để cơ thể kiệt sức.</p>
                </div>
              </div>
            </div>
            
            <p class="text-[16px] leading-relaxed text-slate-700 mb-6">
              Mục tiêu của chuẩn bị là để có một cơ thể ổn định và bền bỉ. Một giờ đi bộ mỗi ngày trong nhiều tuần thường mang lại hiệu quả tốt hơn rất nhiều so với vài buổi tập quá sức vào phút cuối, dễ dẫn đến đau cơ và chấn thương sát ngày lên đường.
            </p>

            <blockquote class="bg-amber-50 border-l-4 border-amber-500 p-6 rounded-r-2xl">
              <p class="text-[16px] italic text-amber-900 font-medium m-0">"Đừng chuẩn bị cho Kailash trong hai tuần cuối. Hãy chuẩn bị để hai tuần cuối chỉ còn là khoảng thời gian chờ đợi ngày lên đường."</p>
