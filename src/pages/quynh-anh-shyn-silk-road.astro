---
import '../styles/silk-road.css';
import App from '../components/ReactApp/SilkRoad/App.tsx';
---
<html lang="vi">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Hành trình Con Đường Tơ Lụa x Quỳnh Anh Shyn | FIT Tour</title>
    <meta name="description" content="Khám phá chuyến phiêu lưu dọc Con Đường Tơ Lụa qua các quốc gia Trung Á (Kazakhstan, Kyrgyzstan) cùng đại sứ Quỳnh Anh Shyn với phong cách du lịch cá nhân hóa từ FIT Tour." />
    <meta property="og:title" content="Hành trình Con Đường Tơ Lụa x Quỳnh Anh Shyn | FIT Tour" />
    <meta property="og:description" content="Trải nghiệm tạp chí du lịch tương tác độc quyền. Cùng đại sứ Quỳnh Anh Shyn thám hiểm những kỳ quan thiên nhiên kỳ vĩ dọc Con Đường Tơ Lụa." />
    <meta property="og:image" content="https://media.fittour.vn/uploads/shyn-quynh-anh-poster.webp" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://thericetour.com/quynh-anh-shyn-silk-road" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="canonical" href="https://thericetour.com/quynh-anh-shyn-silk-road" />
  </head>
  <body>
    <!-- client:only is required because the React app heavily uses Browser APIs like window/document -->
    <App client:only="react" /> 
  </body>
</html>
