---
import BaseLayout from '@/layouts/BaseLayout.astro';
import CorporateRegistrationForm from '@/components/forms/CorporateRegistrationForm';

import { env } from 'cloudflare:workers';
const d1Db = env?.dulichcoguu_d1;

let pageTitle = "Hành Trình Doanh Nghiệp tại Nha Trang";
let seoTitle = "Tour Doanh Nghiệp Tại Nha Trang - MICE, Team Building & Gala";
let seoDesc = "Tổ chức tour doanh nghiệp Nha Trang theo yêu cầu: resort, MICE, team building, gala dinner và điều phối đoàn chuyên nghiệp cùng FIT TOUR.";
let adminEditUrl = "";

if (d1Db) {
  try {
    const stmt = d1Db.prepare(`SELECT id, title, seoTitle, seoDescription FROM Post WHERE slug = 'dia-diem-to-chuc-nha-trang' OR title LIKE '%Doanh Nghiệp Tại Nha Trang%' LIMIT 1`);
    const postData = await stmt.first();
    if (postData) {
      pageTitle = postData.title || pageTitle;
      seoTitle = postData.seoTitle || seoTitle;
      seoDesc = postData.seoDescription || seoDesc;
      
      adminEditUrl = "https://thericetour.com/admin/posts/" + postData.id + "/edit";
    }
  } catch (error) {
    console.error("D1 Error fetching page dia-diem-to-chuc-nha-trang:", error);
  }
}
---

<BaseLayout title={seoTitle} description={seoDesc} adminEditUrl={adminEditUrl} isCorporate={true}>
