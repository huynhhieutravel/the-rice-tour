  .stat-icon.b{background:#dbeafe}.stat-icon.g{background:#dcfce7}.stat-icon.p{background:#f3e8ff}.stat-icon.a{background:#fef3c7}
  .stat-num{font-size:17px;font-weight:700;color:#0f172a}
  .stat-label{font-size:11px;color:#6b7280}
  .stat-div{width:1px;background:#e5e7eb;margin:0 6px}

  .media-toolbar{display:flex;align-items:center;gap:10px;margin-bottom:16px;flex-wrap:wrap}
  .toolbar-select{padding:7px 12px;border:1px solid #d1d5db;border-radius:8px;font-size:12px;color:#374151;background:#fff}
  .toolbar-search{display:flex;margin-left:auto}
  .toolbar-search input{padding:7px 12px;border:1px solid #d1d5db;border-radius:8px 0 0 8px;font-size:12px;width:180px;outline:none}
  .toolbar-search button{padding:7px 14px;border:1px solid #2563eb;border-left:none;border-radius:0 8px 8px 0;background:#2563eb;color:#fff;font-size:12px;font-weight:600;cursor:pointer}
  .bulk-actions{display:none;align-items:center;gap:8px;padding:8px 14px;background:#eff6ff;border-radius:8px;font-size:13px;color:#2563eb;font-weight:600}
  .bulk-actions.visible{display:flex}
  .bulk-actions button{padding:5px 12px;border-radius:6px;font-size:12px;cursor:pointer;border:1px solid #bfdbfe;background:#fff;color:#2563eb;font-weight:600}
  .bulk-actions .btn-del{border-color:#fecaca;color:#ef4444;background:#fef2f2}

  /* Upload Zone / Drag Drop */
  .upload-zone{border:2px dashed #cbd5e1;border-radius:16px;padding:48px;text-align:center;margin-bottom:24px;background:#f8fafc;transition:all .2s;cursor:pointer;display:none}
  .upload-zone.visible{display:block}
  .upload-zone:hover, .upload-zone.dragover{border-color:#2563eb;background:#eff6ff}
  .upload-zone .uz-icon{font-size:40px;margin-bottom:12px;pointer-events:none}
  .upload-zone .uz-title{font-size:16px;font-weight:600;color:#0f172a;margin-bottom:6px;pointer-events:none}
  .upload-zone .uz-sub{font-size:13px;color:#6b7280;pointer-events:none}
  .upload-zone .uz-btn{display:inline-block;margin-top:14px;padding:8px 20px;background:#2563eb;color:#fff;border-radius:8px;font-size:13px;font-weight:600;pointer-events:none}
  
  /* Global Drag Overlay */
  .drag-overlay{position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(37,99,235,0.9);z-index:9999;display:none;align-items:center;justify-content:center;flex-direction:column;color:#fff;font-size:24px;font-weight:700}
  .drag-overlay.active{display:flex}
  .drag-overlay * { pointer-events: none; } /* Chống chớp tắt dragleave */

  /* Grid + Detail layout */
  .media-body{display:grid;grid-template-columns:1fr;gap:0;transition:all .2s}
  .media-body.has-detail{grid-template-columns:1fr 400px;gap:24px}

  /* Responsive Detail Panel */
  @media (max-width: 1024px) {
    .media-body.has-detail{grid-template-columns:1fr;}
    .detail-panel{position:fixed;top:0;right:0;bottom:0;width:100%;max-width:400px;height:100vh;max-height:100vh;z-index:9999;border-radius:0;box-shadow:-4px 0 24px rgba(0,0,0,0.1);border:none;}
  }

  .media-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(130px,1fr));gap:14px; align-content: start;}
  .empty-state{grid-column: 1 / -1; padding: 60px; text-align: center; color: #64748b; font-size: 15px; border: 2px dashed #e2e8f0; border-radius: 12px; background: #f8fafc;}
  .media-card{
    background: #fff;
    border-radius: 12px;
    border: 2.5px solid #e2e8f0;
    overflow: hidden;
    cursor: pointer;
    transition: all .15s cubic-bezier(0.4, 0, 0.2, 1);
    position: relative;
    user-select: none;
  }
  .media-card:hover{
    border-color: #93c5fd;
    transform: translateY(-2px);
    box-shadow: 0 6px 16px rgba(0,0,0,.08);
  }
  .media-card.selected{
    border-color: #2563eb !important;
    background: #eff6ff !important;
    box-shadow: 0 0 0 3px rgba(37,99,235,.35), 0 8px 20px rgba(37,99,235,.18) !important;
  }
  .media-card.active-edit{
    border-color: #f97316 !important;
    box-shadow: 0 0 0 3px rgba(249,115,22,.35) !important;
  }
  .media-card .thumb{
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    display: block;
    background: #f1f5f9;
  }
  .media-card.selected .thumb{
    opacity: 0.92;
  }
  .media-card .info{
    padding: 8px 10px;
    background: inherit;
  }
  .media-card .fname{
    font-size: 11px;
    font-weight: 500;
    color: #0f172a;
    white-space: nowrap;
