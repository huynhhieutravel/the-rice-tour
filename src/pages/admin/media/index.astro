---
import AdminLayout from '@/layouts/AdminLayout.astro';

import { env } from 'cloudflare:workers';

// Fetch media from D1 (works both locally via platformProxy and on Cloudflare)
let mediaList: any[] = [];
const d1Db = env?.dulichcoguu_d1;
if (d1Db) {
  try {
    const { results } = await d1Db.prepare("SELECT * FROM Media ORDER BY createdAt DESC").all();
    mediaList = results || [];
  } catch (err) {
    console.error("D1 Fetch Error:", err);
  }
} else {
  console.warn("No D1 binding found.");
}

// Format data for the client-side JS - Keep server-side operations minimal!
const initialData = mediaList.map(item => {
  const cleanFilename = item.filename ? item.filename.replace(/^uploads\//, '') : '';
  return {
    id: String(item.id),
    src: item.url,
    name: cleanFilename,
    size: item.sizeBytes ? (item.sizeBytes / 1024).toFixed(1) + ' KB' : 'Unknown',
    dim: (item.width && item.height) ? `${item.width}×${item.height}` : '',
    alt: (item.altText || '').trim(),
    title: (item.title || cleanFilename).trim(),
    caption: (item.caption || '').trim(),
    desc: (item.description || '').trim(),
    date: item.createdAt || new Date().toISOString()
  };
});
---

<AdminLayout title="Media Library" activeMenu="media">
<style is:inline>
  .media-header{display:flex;justify-content:space-between;align-items:center;margin-bottom:20px}
  .media-header h2{font-size:24px;font-weight:700}
  .media-header-right{display:flex;gap:10px}
  .btn-upload{padding:9px 20px;border-radius:8px;font-size:13px;font-weight:700;border:none;background:#2563eb;color:#fff;cursor:pointer;display:inline-flex;align-items:center;gap:6px}
  .btn-upload:hover{background:#1d4ed8}
  .btn-outline{padding:8px 16px;border-radius:8px;font-size:13px;font-weight:600;border:1px solid #d1d5db;background:#fff;color:#374151;cursor:pointer}

  .stats-bar{display:flex;gap:20px;margin-bottom:20px;padding:14px 20px;background:#fff;border-radius:12px;border:1px solid #e2e8f0}
  .stat-item{display:flex;align-items:center;gap:10px}
