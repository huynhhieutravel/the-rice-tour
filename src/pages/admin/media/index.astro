  }
  .media-card .fmeta{
    font-size: 10px;
    color: #9ca3af;
    margin-top: 2px;
  }
  .media-card .check-mark{
    position: absolute;
    top: 8px;
    right: 8px;
    width: 24px;
    height: 24px;
    border-radius: 6px;
    border: 2px solid #ffffff;
    background: rgba(15,23,42,0.45);
