---
const title = "Viết bài mới | The Rice Tour CMS";
---

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{title}</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Thêm thư viện soạn thảo văn bản Quill -->
    <link href="https://cdn.quilljs.com/1.3.6/quill.snow.css" rel="stylesheet">
    <style>
        .ql-editor { min-height: 400px; font-size: 16px; }
        .ql-toolbar { border-radius: 12px 12px 0 0; border-color: #e2e8f0 !important; }
        #editor { border-radius: 0 0 12px 12px; border-color: #e2e8f0 !important; }
    </style>
</head>
<body class="bg-gray-50 min-h-screen pb-20">
    <!-- Top Bar -->
    <header class="bg-white border-b border-slate-200 px-8 py-4 flex justify-between items-center sticky top-0 z-50">
        <div class="flex items-center gap-4">
            <a href="/admin" class="text-slate-400 hover:text-slate-800 transition">← Quay lại</a>
            <h1 class="text-xl font-bold text-slate-800">Soạn thảo bài viết Emagazine</h1>
        </div>
        <div class="flex gap-3">
            <button class="px-6 py-2 rounded-full border border-slate-200 text-slate-600 font-medium hover:bg-slate-50 transition">
                Lưu nháp
            </button>
            <button class="px-6 py-2 rounded-full bg-amber-500 text-white font-bold hover:bg-amber-600 transition shadow-lg shadow-amber-200">
                Xuất bản ngay
            </button>
        </div>
    </header>

    <main class="max-w-5xl mx-auto mt-10 px-6">
        <div class="grid grid-cols-3 gap-10">
            <!-- Left Column: Content -->
            <div class="col-span-2 space-y-8">
                <!-- Title -->
                <div>
                    <label class="block text-sm font-bold text-slate-400 uppercase mb-2">Tiêu đề bài viết</label>
                    <input type="text" placeholder="Nhập tiêu đề hấp dẫn tại đây..." 
                           class="w-full text-3xl font-bold p-0 border-none bg-transparent focus:ring-0 placeholder-slate-200 text-slate-800" />
                </div>

                <!-- Excerpt -->
                <div>
                    <label class="block text-sm font-bold text-slate-400 uppercase mb-2">Mô tả ngắn (Excerpt)</label>
                    <textarea rows="3" placeholder="Tóm tắt nội dung bài viết..." 
                              class="w-full p-4 rounded-2xl border border-slate-200 focus:border-amber-500 focus:ring-1 focus:ring-amber-500 outline-none transition"></textarea>
                </div>

                <!-- Rich Text Editor -->
                <div>
                    <label class="block text-sm font-bold text-slate-400 uppercase mb-2">Nội dung chi tiết</label>
                    <div id="editor" class="bg-white"></div>
                </div>
            </div>

            <!-- Right Column: Settings -->
            <aside class="space-y-8">
                <!-- Featured Image -->
                <div class="bg-white p-6 rounded-3xl border border-slate-100 shadow-sm">
                    <label class="block text-sm font-bold text-slate-400 uppercase mb-4">Hình ảnh đại diện</label>
                    <div class="aspect-video bg-slate-50 rounded-2xl border-2 border-dashed border-slate-200 flex flex-col items-center justify-center cursor-pointer hover:bg-slate-100 transition group">
                        <span class="text-3xl mb-2 group-hover:scale-110 transition">🖼️</span>
                        <span class="text-xs text-slate-400">Click để chọn ảnh hoặc kéo thả</span>
                    </div>
                </div>

                <!-- Categories -->
                <div class="bg-white p-6 rounded-3xl border border-slate-100 shadow-sm">
                    <label class="block text-sm font-bold text-slate-400 uppercase mb-4">Chuyên mục</label>
                    <div class="space-y-3">
                        <label class="flex items-center gap-3 cursor-pointer">
                            <input type="radio" name="cat" class="w-5 h-5 text-amber-500 focus:ring-amber-500" checked />
                            <span class="text-slate-700">Blog</span>
                        </label>
                        <label class="flex items-center gap-3 cursor-pointer">
                            <input type="radio" name="cat" class="w-5 h-5 text-amber-500 focus:ring-amber-500" />
                            <span class="text-slate-700">eMagazine</span>
                        </label>
                        <label class="flex items-center gap-3 cursor-pointer">
                            <input type="radio" name="cat" class="w-5 h-5 text-amber-500 focus:ring-amber-500" />
                            <span class="text-slate-700">Câu chuyện du lịch</span>
                        </label>
                    </div>
                </div>

                <!-- SEO Preview -->
                <div class="bg-white p-6 rounded-3xl border border-slate-100 shadow-sm">
                    <label class="block text-sm font-bold text-slate-400 uppercase mb-4">Xem trước SEO</label>
                    <div class="space-y-1">
                        <p class="text-blue-700 text-lg hover:underline cursor-pointer">Tiêu đề bài viết hiển thị trên Google...</p>
                        <p class="text-emerald-700 text-sm">fittour.vn › blog › vung-dat-caucasus</p>
                        <p class="text-slate-500 text-xs line-clamp-2">Đoạn mô tả ngắn này sẽ xuất hiện trên kết quả tìm kiếm của Google để thu hút khách hàng bấm vào...</p>
                    </div>
                </div>
            </aside>
        </div>
    </main>

    <script src="https://cdn.quilljs.com/1.3.6/quill.js"></script>
    <script>
        var quill = new Quill('#editor', {
            theme: 'snow',
            placeholder: 'Bắt đầu viết câu chuyện du lịch của bạn...',
            modules: {
                toolbar: [
                    [{ 'header': [1, 2, 3, false] }],
                    ['bold', 'italic', 'underline', 'strike'],
                    ['blockquote', 'code-block'],
                    [{ 'list': 'ordered'}, { 'list': 'bullet' }],
                    ['link', 'image'],
                    ['clean']
                ]
            }
        });
    </script>
</body>
</html>
