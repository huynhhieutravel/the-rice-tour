  <script is:inline>
    // === 1. GLightbox Integration ===
    function initTourGalleryLightbox() {
      var container = document.querySelector(".elementor-tour-wrapper");
      if (!container) return;

      var gallerySelectors = [".coguu-gallery-story", ".coguu-gallery", ".grid-fit-masonry", ".tiptap-gallery-block", ".zoomable-image", ".wp-block-gallery", ".tour-slide-img", ".tour-gallery-slider img"];
      var lightboxData = [];
      var processedGalleries = new Set();

      gallerySelectors.forEach(function(selector) {
        var galleries = container.querySelectorAll(selector);
        galleries.forEach(function(gallery) {
          if (processedGalleries.has(gallery)) return;
          processedGalleries.add(gallery);
          
          var imgs = gallery.tagName === "IMG" ? [gallery] : gallery.querySelectorAll("img.feature-image, img");
          if (imgs.length === 0) return;
          var elements = [];
          var validImgs = [];
          for (var i = 0; i < imgs.length; i++) {
            if (imgs[i].closest(".exclude-lightbox") || imgs[i].closest("a")) continue;
            elements.push({ href: imgs[i].getAttribute("src") || "", type: "image", description: imgs[i].getAttribute("alt") || "" });
            validImgs.push(imgs[i]);
          }
          if (elements.length > 0) {
            var isGrouped = elements.length > 1;
            lightboxData.push({ elements: elements, imgs: validImgs, isGrouped: isGrouped });
          }
        });
      });

      if (lightboxData.length === 0) return;

      requestAnimationFrame(function() {
        lightboxData.forEach(function(lbData) {
          for (var i = 0; i < lbData.imgs.length; i++) {
            lbData.imgs[i].style.cursor = "zoom-in";
            if (lbData.isGrouped) lbData.imgs[i].classList.add("lightbox-grouped");
          }

          var lightbox = window.GLightbox ? window.GLightbox({
            elements: lbData.elements,
            touchNavigation: true,
            loop: true,
            zoomable: true,
            descPosition: "bottom"
          }) : null;

          if (lightbox) {
            for (var j = 0; j < lbData.imgs.length; j++) {
              (function(index) {
                lbData.imgs[index].addEventListener("click", function(e) {
                  e.preventDefault();
                  e.stopPropagation();
                  lightbox.openAt(index);
                });
              })(j);
            }
          }
        });
      });
    }

    function loadGLightbox() {
      if (typeof GLightbox !== "undefined") {
        requestAnimationFrame(initTourGalleryLightbox);
        return;
      }
      var link = document.createElement("link");
      link.rel = "stylesheet";
      link.href = "https://cdn.jsdelivr.net/npm/glightbox/dist/css/glightbox.min.css";
      link.media = "print";
      link.onload = function() { link.media = "all"; };
      document.head.appendChild(link);

      var script = document.createElement("script");
      script.src = "https://cdn.jsdelivr.net/gh/mcstudios/glightbox/dist/js/glightbox.min.js";
      script.onload = function() { requestAnimationFrame(initTourGalleryLightbox); };
      document.head.appendChild(script);
    }

    // === 2. Booking Modal Popup ===
