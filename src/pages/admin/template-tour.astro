          const modalContent = document.createElement("div");
          modalContent.style.cssText = "background: #fff; padding: 32px; border-radius: 24px; max-width: 440px; width: 100%; text-align: center; box-shadow: 0 20px 50px rgba(0,0,0,0.25); transform: translateY(20px); transition: transform 0.3s ease;";
          
