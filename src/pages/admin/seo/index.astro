---
import AdminLayout from '@/layouts/AdminLayout.astro';
import { env } from 'cloudflare:workers';

const d1Db = env?.dulichcoguu_d1;

let tours: any[] = [];
let posts: any[] = [];
let settings: Record<string, string> = {};
let message = '';

if (d1Db) {
  if (Astro.request.method === 'POST') {
    try {
      const formData = await Astro.request.formData();
      const action = formData.get('action');

      if (action === 'save_global_seo') {
        const defaultTitle = formData.get('default_seo_title') as string;
        const defaultDesc = formData.get('default_seo_description') as string;
        const googleVerification = formData.get('google_verification') as string;
        const robotsTxt = formData.get('robots_txt') as string;

        const entries = [
          ['seo_default_title', defaultTitle || ''],
          ['seo_default_description', defaultDesc || ''],
          ['seo_google_verification', googleVerification || ''],
          ['seo_robots_txt', robotsTxt || 'User-agent: *\nAllow: /\nSitemap: https://thericetour.com/sitemap-index.xml']
        ];

        for (const [key, val] of entries) {
          await d1Db.prepare(`
            INSERT INTO SiteSetting (key, value, updatedAt) VALUES (?, ?, CURRENT_TIMESTAMP)
            ON CONFLICT(key) DO UPDATE SET value=excluded.value, updatedAt=CURRENT_TIMESTAMP
          `).bind(key, val).run();
        }
        message = '✓ Đã lưu cài đặt SEO thành công!';
      }
    } catch (e: any) {
      message = 'Lỗi: ' + e.message;
    }
  }

  // Fetch Settings
  try {
    const { results: setRes } = await d1Db.prepare("SELECT key, value FROM SiteSetting WHERE key LIKE 'seo_%'").all();
    if (setRes) {
      setRes.forEach((r: any) => {
        settings[r.key] = r.value;
      });
    }
  } catch (e) {}

  // Fetch Tours & Posts for SEO Health Check
  try {
    const { results: tRes } = await d1Db.prepare("SELECT id, title, slug, seoTitle, seoDescription, featuredImage, status FROM Tour WHERE status = 'published'").all();
    if (tRes) tours = tRes;

    const { results: pRes } = await d1Db.prepare("SELECT id, title, slug, seoTitle, seoDescription, featuredImage, status FROM Post WHERE status = 'published'").all();
    if (pRes) posts = pRes;
  } catch (e) {}
}

const totalItems = tours.length + posts.length;
const missingSeoTitle = tours.filter(t => !t.seoTitle).length + posts.filter(p => !p.seoTitle).length;
const missingSeoDesc = tours.filter(t => !t.seoDescription).length + posts.filter(p => !p.seoDescription).length;
const seoScore = totalItems > 0 ? Math.round(((totalItems * 2 - missingSeoTitle - missingSeoDesc) / (totalItems * 2)) * 100) : 100;
---

<AdminLayout title="SEO & Meta Audit" activeMenu="tools" activeSubmenu="seo">
  <div style="max-width: 1200px; margin: 0 auto;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;">
      <div>
        <h2 style="font-size: 24px; font-weight: 700; color: #0f172a; margin-bottom: 4px;">SEO &amp; Metadata Management</h2>
        <p style="color: #64748b; font-size: 14px;">Quản lý chỉ số SEO, Meta Tags toàn trang và kiểm tra độ chuẩn hóa dữ liệu tìm kiếm.</p>
      </div>
      <a href="/sitemap-index.xml" target="_blank" style="padding: 10px 16px; background: #0f172a; color: #ffffff; text-decoration: none; border-radius: 8px; font-size: 13px; font-weight: 600; display: inline-flex; align-items: center; gap: 8px;">
        <span>🗺️</span> Xem Sitemap XML
      </a>
    </div>

    {message && (
      <div style="padding: 14px 18px; background: #ecfdf5; border: 1px solid #6ee7b7; color: #065f46; border-radius: 10px; font-size: 14px; font-weight: 500; margin-bottom: 24px;">
        {message}
      </div>
    )}

    <!-- SEO Score Cards -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 20px; margin-bottom: 32px;">
      <div class="card" style="padding: 20px; display: flex; align-items: center; gap: 16px;">
        <div style="width: 52px; height: 52px; border-radius: 12px; background: #fef3c7; display: flex; align-items: center; justify-content: center; font-size: 24px;">
          🎯
        </div>
        <div>
          <div style="font-size: 12px; font-weight: 600; color: #64748b; text-transform: uppercase;">SEO Health Score</div>
          <div style="font-size: 28px; font-weight: 800; color: #d97706;">{seoScore}%</div>
        </div>
      </div>

      <div class="card" style="padding: 20px; display: flex; align-items: center; gap: 16px;">
        <div style="width: 52px; height: 52px; border-radius: 12px; background: #ecfdf5; display: flex; align-items: center; justify-content: center; font-size: 24px;">
          🌍
        </div>
        <div>
          <div style="font-size: 12px; font-weight: 600; color: #64748b; text-transform: uppercase;">Indexed Tours</div>
          <div style="font-size: 28px; font-weight: 800; color: #059669;">{tours.length}</div>
        </div>
      </div>

      <div class="card" style="padding: 20px; display: flex; align-items: center; gap: 16px;">
        <div style="width: 52px; height: 52px; border-radius: 12px; background: #eff6ff; display: flex; align-items: center; justify-content: center; font-size: 24px;">
          📰
        </div>
        <div>
          <div style="font-size: 12px; font-weight: 600; color: #64748b; text-transform: uppercase;">Travel Guides</div>
          <div style="font-size: 28px; font-weight: 800; color: #2563eb;">{posts.length}</div>
        </div>
      </div>

      <div class="card" style="padding: 20px; display: flex; align-items: center; gap: 16px;">
        <div style="width: 52px; height: 52px; border-radius: 12px; background: #fef2f2; display: flex; align-items: center; justify-content: center; font-size: 24px;">
          ⚠️
        </div>
        <div>
          <div style="font-size: 12px; font-weight: 600; color: #64748b; text-transform: uppercase;">Thiếu Meta Description</div>
          <div style="font-size: 28px; font-weight: 800; color: #dc2626;">{missingSeoDesc}</div>
        </div>
      </div>
    </div>

    <!-- Global SEO Settings Form -->
    <div class="card" style="padding: 24px; margin-bottom: 32px;">
      <h3 style="font-size: 18px; font-weight: 700; color: #0f172a; margin-bottom: 16px;">Cấu hình SEO Mặc Định Toàn Site</h3>
      <form method="POST">
        <input type="hidden" name="action" value="save_global_seo" />

        <div style="margin-bottom: 20px;">
          <label style="display: block; font-size: 13px; font-weight: 600; color: #334155; margin-bottom: 6px;">Tiêu đề SEO mặc định (Default Meta Title)</label>
          <input type="text" name="default_seo_title" value={settings.seo_default_title || 'The Rice Tour | Authentic Vietnam Inbound Journeys & Bespoke Expeditions'} style="width: 100%; padding: 10px 14px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 14px;" />
        </div>

        <div style="margin-bottom: 20px;">
          <label style="display: block; font-size: 13px; font-weight: 600; color: #334155; margin-bottom: 6px;">Mô tả SEO mặc định (Default Meta Description)</label>
          <textarea name="default_seo_description" rows="3" style="width: 100%; padding: 10px 14px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 14px;">{settings.seo_default_description || 'Premier inbound tour designer for international travelers seeking authentic Vietnam journeys. 100% tailor-made private tours, luxury cruises, and zero forced shopping.'}</textarea>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 20px;">
          <div>
            <label style="display: block; font-size: 13px; font-weight: 600; color: #334155; margin-bottom: 6px;">Google Search Console Verification Code</label>
            <input type="text" name="google_verification" value={settings.seo_google_verification || ''} placeholder="google-site-verification=..." style="width: 100%; padding: 10px 14px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 14px;" />
          </div>

          <div>
            <label style="display: block; font-size: 13px; font-weight: 600; color: #334155; margin-bottom: 6px;">Cấu hình Robots.txt</label>
            <textarea name="robots_txt" rows="3" style="width: 100%; padding: 10px 14px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 13px; font-family: monospace;">{settings.seo_robots_txt || 'User-agent: *\nAllow: /\nSitemap: https://thericetour.com/sitemap-index.xml'}</textarea>
          </div>
        </div>

        <button type="submit" style="padding: 12px 24px; background: #d97706; color: #ffffff; border: none; border-radius: 8px; font-size: 14px; font-weight: 700; cursor: pointer;">
          Lưu Cấu Hình SEO
        </button>
      </form>
    </div>

    <!-- Content SEO Health Table -->
    <div class="card" style="padding: 0; overflow: hidden;">
      <div style="padding: 18px 24px; border-bottom: 1px solid #e2e8f0;">
        <h3 style="font-size: 16px; font-weight: 700; color: #0f172a;">Kiểm Tra Trạng Thái SEO Từng Bài Viết &amp; Tour</h3>
      </div>
      <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 13px;">
        <thead style="background: #f8fafc; border-bottom: 1px solid #e2e8f0; color: #475569;">
          <tr>
            <th style="padding: 14px 20px;">Loại</th>
            <th style="padding: 14px 20px;">Tiêu đề</th>
            <th style="padding: 14px 20px;">Meta Title</th>
            <th style="padding: 14px 20px;">Meta Description</th>
            <th style="padding: 14px 20px; text-align: right;">Thao tác</th>
          </tr>
        </thead>
        <tbody>
          {tours.map(t => (
            <tr style="border-bottom: 1px solid #f1f5f9;">
              <td style="padding: 14px 20px;"><span style="padding: 3px 8px; background: #ecfdf5; color: #059669; border-radius: 6px; font-weight: 600; font-size: 11px;">TOUR</span></td>
              <td style="padding: 14px 20px; font-weight: 600; color: #0f172a;">{t.title}</td>
              <td style="padding: 14px 20px; color: t.seoTitle ? '#059669' : '#dc2626';">{t.seoTitle ? '✓ Đã có' : '✗ Chưa có'}</td>
              <td style="padding: 14px 20px; color: t.seoDescription ? '#059669' : '#dc2626';">{t.seoDescription ? '✓ Đã có' : '✗ Chưa có'}</td>
              <td style="padding: 14px 20px; text-align: right;">
                <a href={`/admin/tours/edit?id=${t.id}`} style="color: #2563eb; text-decoration: none; font-weight: 600;">Sửa SEO →</a>
              </td>
            </tr>
          ))}
          {posts.map(p => (
            <tr style="border-bottom: 1px solid #f1f5f9;">
              <td style="padding: 14px 20px;"><span style="padding: 3px 8px; background: #eff6ff; color: #2563eb; border-radius: 6px; font-weight: 600; font-size: 11px;">GUIDE</span></td>
              <td style="padding: 14px 20px; font-weight: 600; color: #0f172a;">{p.title}</td>
              <td style="padding: 14px 20px; color: p.seoTitle ? '#059669' : '#dc2626';">{p.seoTitle ? '✓ Đã có' : '✗ Chưa có'}</td>
              <td style="padding: 14px 20px; color: p.seoDescription ? '#059669' : '#dc2626';">{p.seoDescription ? '✓ Đã có' : '✗ Chưa có'}</td>
              <td style="padding: 14px 20px; text-align: right;">
                <a href={`/admin/posts/edit?id=${p.id}`} style="color: #2563eb; text-decoration: none; font-weight: 600;">Sửa SEO →</a>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</AdminLayout>
