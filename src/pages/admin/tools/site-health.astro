---
import AdminLayout from '@/layouts/AdminLayout.astro';
import { env } from 'cloudflare:workers';

const d1Db = env?.dulichcoguu_d1;
const sessionKV = env?.SESSION;
const mediaBucket = env?.MEDIA_BUCKET;

let dbStatus = 'Disconnected';
let tableCounts: Record<string, number> = {};
let totalTours = 0;
let totalPosts = 0;
let totalUsers = 0;
let totalSubmissions = 0;

if (d1Db) {
  try {
    const { results } = await d1Db.prepare("SELECT 1 as test").all();
    if (results && results.length > 0) dbStatus = 'Connected & Operational (✓ Healthy)';

    const tables = ['Tour', 'Post', 'users', 'FormSubmission', 'Country', 'Media', 'SiteSetting'];
    for (const tbl of tables) {
      try {
        const { results: cRes } = await d1Db.prepare(`SELECT COUNT(*) as count FROM ${tbl}`).all();
        if (cRes && cRes.length > 0) tableCounts[tbl] = cRes[0].count;
      } catch (e) {
        tableCounts[tbl] = 0;
      }
    }
    totalTours = tableCounts['Tour'] || 0;
    totalPosts = tableCounts['Post'] || 0;
    totalUsers = tableCounts['users'] || 0;
    totalSubmissions = tableCounts['FormSubmission'] || 0;
  } catch (e: any) {
    dbStatus = 'Error: ' + e.message;
  }
}

const kvStatus = sessionKV ? 'Connected & Active (✓ Healthy)' : 'Active (Local Fallback)';
const r2Status = mediaBucket ? 'Connected & Ready (✓ Healthy)' : 'Active (Local Fallback)';
---

<AdminLayout title="Site Health & System Status" activeMenu="tools" activeSubmenu="site-health">
  <div style="max-width: 1200px; margin: 0 auto;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;">
      <div>
        <h2 style="font-size: 24px; font-weight: 700; color: #0f172a; margin-bottom: 4px;">Site Health &amp; System Infrastructure</h2>
        <p style="color: #64748b; font-size: 14px;">Giám sát sức khỏe hạ tầng Cloudflare Workers, D1 Database, KV Sessions và R2 Media Storage.</p>
      </div>
      <span style="padding: 6px 14px; background: #ecfdf5; color: #059669; border-radius: 20px; font-weight: 700; font-size: 13px; display: inline-flex; align-items: center; gap: 6px;">
        <span style="width: 8px; height: 8px; border-radius: 50%; background: #10b981;"></span> All Systems Operational
      </span>
    </div>

    <!-- Infrastructure Status Cards -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 20px; margin-bottom: 32px;">
      <div class="card" style="padding: 24px;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
          <h3 style="font-size: 16px; font-weight: 700; color: #0f172a;">Cloudflare D1 Database</h3>
          <span style="font-size: 20px;">🗄️</span>
        </div>
        <div style="font-size: 13px; font-weight: 600; color: #059669; margin-bottom: 8px;">{dbStatus}</div>
        <p style="font-size: 12px; color: #64748b;">Database ID: <code style="background: #f1f5f9; padding: 2px 6px; border-radius: 4px;">3874bca8-7df1-45af-ada4-5eb609440401</code></p>
        <p style="font-size: 12px; color: #64748b; margin-top: 4px;">Binding Name: <code style="background: #f1f5f9; padding: 2px 6px; border-radius: 4px;">dulichcoguu_d1</code></p>
      </div>

      <div class="card" style="padding: 24px;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
          <h3 style="font-size: 16px; font-weight: 700; color: #0f172a;">Cloudflare KV Session Store</h3>
          <span style="font-size: 20px;">⚡</span>
        </div>
        <div style="font-size: 13px; font-weight: 600; color: #059669; margin-bottom: 8px;">{kvStatus}</div>
        <p style="font-size: 12px; color: #64748b;">Namespace: <code style="background: #f1f5f9; padding: 2px 6px; border-radius: 4px;">SESSION</code></p>
        <p style="font-size: 12px; color: #64748b; margin-top: 4px;">TTL: <code style="background: #f1f5f9; padding: 2px 6px; border-radius: 4px;">7 days rolling auth token</code></p>
      </div>

      <div class="card" style="padding: 24px;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
          <h3 style="font-size: 16px; font-weight: 700; color: #0f172a;">Cloudflare R2 Object Storage</h3>
          <span style="font-size: 20px;">🖼️</span>
        </div>
        <div style="font-size: 13px; font-weight: 600; color: #059669; margin-bottom: 8px;">{r2Status}</div>
        <p style="font-size: 12px; color: #64748b;">Bucket Name: <code style="background: #f1f5f9; padding: 2px 6px; border-radius: 4px;">MEDIA_BUCKET</code></p>
        <p style="font-size: 12px; color: #64748b; margin-top: 4px;">Auto WebP Compression: <code style="background: #f1f5f9; padding: 2px 6px; border-radius: 4px;">Enabled (Client-side)</code></p>
      </div>
    </div>

    <!-- Database Table Counts -->
    <div class="card" style="padding: 0; overflow: hidden; margin-bottom: 32px;">
      <div style="padding: 18px 24px; border-bottom: 1px solid #e2e8f0; background: #f8fafc;">
        <h3 style="font-size: 16px; font-weight: 700; color: #0f172a;">Thống Kê Dữ Liệu Bảng D1</h3>
      </div>
      <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 13px;">
        <thead style="border-bottom: 1px solid #e2e8f0; color: #475569;">
          <tr>
            <th style="padding: 14px 20px;">Tên Bảng (Table)</th>
            <th style="padding: 14px 20px;">Mục Đích Dữ Liệu</th>
            <th style="padding: 14px 20px;">Tổng Số Bản Ghi</th>
            <th style="padding: 14px 20px; text-align: right;">Trạng Thái</th>
          </tr>
        </thead>
        <tbody>
          <tr style="border-bottom: 1px solid #f1f5f9;">
            <td style="padding: 14px 20px; font-family: monospace; font-weight: 700; color: #0f172a;">Tour</td>
            <td style="padding: 14px 20px; color: #64748b;">Danh mục Tour Inbound Việt Nam</td>
            <td style="padding: 14px 20px; font-weight: 700; color: #d97706;">{totalTours}</td>
            <td style="padding: 14px 20px; text-align: right; color: #059669; font-weight: 600;">✓ Healthy</td>
          </tr>
          <tr style="border-bottom: 1px solid #f1f5f9;">
            <td style="padding: 14px 20px; font-family: monospace; font-weight: 700; color: #0f172a;">Post</td>
            <td style="padding: 14px 20px; color: #64748b;">Cẩm nang du lịch, Visa &amp; Tin tức</td>
            <td style="padding: 14px 20px; font-weight: 700; color: #2563eb;">{totalPosts}</td>
            <td style="padding: 14px 20px; text-align: right; color: #059669; font-weight: 600;">✓ Healthy</td>
          </tr>
          <tr style="border-bottom: 1px solid #f1f5f9;">
            <td style="padding: 14px 20px; font-family: monospace; font-weight: 700; color: #0f172a;">users</td>
            <td style="padding: 14px 20px; color: #64748b;">Tài khoản &amp; Phân quyền Quản trị</td>
            <td style="padding: 14px 20px; font-weight: 700; color: #7c3aed;">{totalUsers}</td>
            <td style="padding: 14px 20px; text-align: right; color: #059669; font-weight: 600;">✓ Healthy</td>
          </tr>
          <tr style="border-bottom: 1px solid #f1f5f9;">
            <td style="padding: 14px 20px; font-family: monospace; font-weight: 700; color: #0f172a;">FormSubmission</td>
            <td style="padding: 14px 20px; color: #64748b;">Leads yêu cầu tư vấn Tailor-made</td>
            <td style="padding: 14px 20px; font-weight: 700; color: #059669;">{totalSubmissions}</td>
            <td style="padding: 14px 20px; text-align: right; color: #059669; font-weight: 600;">✓ Healthy</td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
</AdminLayout>
