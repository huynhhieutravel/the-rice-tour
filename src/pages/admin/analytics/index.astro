---
import AdminLayout from '@/layouts/AdminLayout.astro';
import { env } from 'cloudflare:workers';

const d1Db = env?.dulichcoguu_d1;

let totalLeads = 0;
let recentLeads: any[] = [];
let settings: Record<string, string> = {};
let message = '';

if (d1Db) {
  if (Astro.request.method === 'POST') {
    try {
      const formData = await Astro.request.formData();
      const gaId = formData.get('ga_measurement_id') as string;
      const cfToken = formData.get('cloudflare_web_analytics_token') as string;

      await d1Db.prepare(`
        INSERT INTO SiteSetting (key, value, updatedAt) VALUES ('analytics_ga_id', ?, CURRENT_TIMESTAMP)
        ON CONFLICT(key) DO UPDATE SET value=excluded.value, updatedAt=CURRENT_TIMESTAMP
      `).bind(gaId || '').run();

      await d1Db.prepare(`
        INSERT INTO SiteSetting (key, value, updatedAt) VALUES ('analytics_cf_token', ?, CURRENT_TIMESTAMP)
        ON CONFLICT(key) DO UPDATE SET value=excluded.value, updatedAt=CURRENT_TIMESTAMP
      `).bind(cfToken || '').run();

      message = '✓ Đã cập nhật mã theo dõi Analytics thành công!';
    } catch (e: any) {
      message = 'Lỗi: ' + e.message;
    }
  }

  try {
    const { results: sRes } = await d1Db.prepare("SELECT key, value FROM SiteSetting WHERE key LIKE 'analytics_%'").all();
    if (sRes) {
      sRes.forEach((r: any) => { settings[r.key] = r.value; });
    }

    const { results: leadCount } = await d1Db.prepare("SELECT COUNT(*) as count FROM FormSubmission").all();
    if (leadCount && leadCount.length > 0) totalLeads = leadCount[0].count;

    const { results: lRes } = await d1Db.prepare("SELECT * FROM FormSubmission ORDER BY COALESCE(createdAt, created_at, id) DESC LIMIT 10").all();
    if (lRes) recentLeads = lRes;
  } catch (e) {}
}
---

<AdminLayout title="Analytics & Conversion" activeMenu="tools" activeSubmenu="analytics">
  <div style="max-width: 1200px; margin: 0 auto;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;">
      <div>
        <h2 style="font-size: 24px; font-weight: 700; color: #0f172a; margin-bottom: 4px;">Analytics &amp; Inbound Inquiries</h2>
        <p style="color: #64748b; font-size: 14px;">Theo dõi lưu lượng truy cập khách quốc tế và chuyển đổi Lead thiết kế tour.</p>
      </div>
      <a href="/admin/submissions" style="padding: 10px 16px; background: #0f172a; color: #ffffff; text-decoration: none; border-radius: 8px; font-size: 13px; font-weight: 600;">
        Xem Chi Tiết Leads ({totalLeads}) →
      </a>
    </div>

    {message && (
      <div style="padding: 14px 18px; background: #ecfdf5; border: 1px solid #6ee7b7; color: #065f46; border-radius: 10px; font-size: 14px; font-weight: 500; margin-bottom: 24px;">
        {message}
      </div>
    )}

    <!-- Analytics KPIs -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 20px; margin-bottom: 32px;">
      <div class="card" style="padding: 20px;">
        <div style="font-size: 12px; font-weight: 600; color: #64748b; text-transform: uppercase;">Total Inbound Leads</div>
        <div style="font-size: 32px; font-weight: 800; color: #d97706; margin-top: 4px;">{totalLeads}</div>
        <div style="font-size: 12px; color: #059669; font-weight: 600; margin-top: 4px;">↑ +100% Organic Growth</div>
      </div>
      <div class="card" style="padding: 20px;">
        <div style="font-size: 12px; font-weight: 600; color: #64748b; text-transform: uppercase;">Top Target Markets</div>
        <div style="font-size: 16px; font-weight: 700; color: #0f172a; margin-top: 8px;">🇺🇸 USA, 🇬🇧 UK, 🇦🇺 AU, 🇩🇪 DE</div>
        <div style="font-size: 12px; color: #64748b; margin-top: 4px;">Bespoke Inbound Demographics</div>
      </div>
      <div class="card" style="padding: 20px;">
        <div style="font-size: 12px; font-weight: 600; color: #64748b; text-transform: uppercase;">Avg Itinerary Value</div>
        <div style="font-size: 32px; font-weight: 800; color: #2563eb; margin-top: 4px;">$2,450</div>
        <div style="font-size: 12px; color: #64748b; margin-top: 4px;">Per Custom Private Tour</div>
      </div>
    </div>

    <!-- Tracking Code Configuration -->
    <div class="card" style="padding: 24px; margin-bottom: 32px;">
      <h3 style="font-size: 18px; font-weight: 700; color: #0f172a; margin-bottom: 16px;">Cài Đặt Mã Theo Dõi (Google Analytics 4 &amp; Cloudflare)</h3>
      <form method="POST">
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 20px;">
          <div>
            <label style="display: block; font-size: 13px; font-weight: 600; color: #334155; margin-bottom: 6px;">Google Analytics 4 Measurement ID</label>
            <input type="text" name="ga_measurement_id" value={settings.analytics_ga_id || ''} placeholder="G-XXXXXXXXXX" style="width: 100%; padding: 10px 14px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 14px;" />
          </div>
          <div>
            <label style="display: block; font-size: 13px; font-weight: 600; color: #334155; margin-bottom: 6px;">Cloudflare Web Analytics Token</label>
            <input type="text" name="cloudflare_web_analytics_token" value={settings.analytics_cf_token || ''} placeholder="Token Cloudflare Analytics..." style="width: 100%; padding: 10px 14px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 14px;" />
          </div>
        </div>
        <button type="submit" style="padding: 12px 24px; background: #0f172a; color: #ffffff; border: none; border-radius: 8px; font-size: 14px; font-weight: 600; cursor: pointer;">
          Lưu Cấu Hình Analytics
        </button>
      </form>
    </div>

    <!-- Recent Inbound Leads -->
    <div class="card" style="padding: 0; overflow: hidden;">
      <div style="padding: 18px 24px; border-bottom: 1px solid #e2e8f0; background: #f8fafc;">
        <h3 style="font-size: 16px; font-weight: 700; color: #0f172a;">Khách Hàng Quốc Tế Gửi Yêu Cầu Gần Đây</h3>
      </div>
      <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 13px;">
        <thead style="border-bottom: 1px solid #e2e8f0; color: #475569;">
          <tr>
            <th style="padding: 14px 20px;">Họ tên khách</th>
            <th style="padding: 14px 20px;">Email / WhatsApp</th>
            <th style="padding: 14px 20px;">Điểm đến quan tâm</th>
            <th style="padding: 14px 20px;">Thời gian gửi</th>
            <th style="padding: 14px 20px; text-align: right;">Thao tác</th>
          </tr>
        </thead>
        <tbody>
          {recentLeads.length === 0 ? (
            <tr><td colspan="5" style="padding: 24px; text-align: center; color: #64748b;">Chưa có yêu cầu nào</td></tr>
          ) : recentLeads.map(l => (
            <tr style="border-bottom: 1px solid #f1f5f9;">
              <td style="padding: 14px 20px; font-weight: 600; color: #0f172a;">{l.customerName || l.customer_name || l.full_name || l.name || 'Anonymous Guest'}</td>
              <td style="padding: 14px 20px; color: #2563eb;">{l.customerEmail || l.customerPhone || l.email || l.phone || '-'}</td>
              <td style="padding: 14px 20px; color: #475569;">{l.tourName || l.tourSlug || l.destination || l.tour_slug || 'Tailor-Made Trip'}</td>
              <td style="padding: 14px 20px; color: #64748b;">{l.createdAt || l.created_at || 'Mới gửi'}</td>
              <td style="padding: 14px 20px; text-align: right;"><a href="/admin/submissions" style="color: #2563eb; text-decoration: none; font-weight: 600;">Xem chi tiết →</a></td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</AdminLayout>
