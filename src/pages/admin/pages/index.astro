---
import AdminLayout from '@/layouts/AdminLayout.astro';
import { env } from 'cloudflare:workers';

const d1Db = env?.dulichcoguu_d1;
let pages: any[] = [];

const q = Astro.url.searchParams.get('q') || '';
const limitParam = parseInt(Astro.url.searchParams.get('limit') || '30');
const validLimits = [30, 50, 100];
const limit = validLimits.includes(limitParam) ? limitParam : 30;
const pageParam = parseInt(Astro.url.searchParams.get('page') || '1');
const page = pageParam > 0 ? pageParam : 1;
const offset = (page - 1) * limit;
const currentTab = Astro.url.searchParams.get('status') || 'all';

let counts = { all: 0, published: 0, draft: 0, trash: 0 };

if (d1Db) {
  // Ensure essential system pages exist in D1 Page table for CMS management
  const corePages = [
    {
      id: 'page_privacy_policy',
      title: 'Privacy & Data Protection Policy',
      slug: 'privacy-policy',
      status: 'published',
      seoTitle: 'Privacy Policy | The Rice Tour — Inbound Data Protection',
      seoDescription: 'Privacy Policy of The Rice Tour. Learn how we collect, protect, and process your personal and travel data in full compliance with international standards and Vietnamese law.'
    },
    {
      id: 'page_about_us',
      title: 'About Us | The Rice Tour Story & Commitments',
      slug: 'about-us',
      status: 'published',
      featuredImage: 'https://media.thericetour.com/uploads/girls-smiling-red-polka-dress-rowing-boat-mekong-canal.webp',
      seoTitle: 'About Us | The Rice Tour — Authentic Inbound Vietnam Journeys',
      seoDescription: 'Discover the story of The Rice Tour. We craft intimate, authentic, and slow-paced private travel experiences across Vietnam for discerning international travelers.'
    },
    {
      id: 'page_contact_us',
      title: 'Contact Us | 24/7 Dedicated Inbound Concierge',
      slug: 'contact',
      status: 'published',
      seoTitle: 'Contact Us | The Rice Tour — 24/7 Dedicated Inbound Concierge',
      seoDescription: 'Connect with The Rice Tour specialists. Inquire about bespoke private Vietnam tours, 24/7 WhatsApp assistance, customized itineraries, and travel advice.'
    },
    {
      id: 'page_terms_of_service',
      title: 'Terms of Service & Booking Conditions',
      slug: 'terms-of-service',
      status: 'published',
      seoTitle: 'Terms of Service & Booking Conditions | The Rice Tour',
      seoDescription: 'Terms of Service and Booking Conditions for The Rice Tour. Understand our transparent booking procedures, payment policies, cancellation terms, and travel standards.'
    }
  ];

  for (const cp of corePages) {
    try {
      const existing = await d1Db.prepare("SELECT id FROM Page WHERE slug = ?").bind(cp.slug).first();
      if (!existing) {
        await d1Db.prepare(`
          INSERT INTO Page (id, title, slug, status, featuredImage, seoTitle, seoDescription, updatedAt)
          VALUES (?, ?, ?, ?, ?, ?, ?, CURRENT_TIMESTAMP)
        `).bind(cp.id, cp.title, cp.slug, cp.status, cp.featuredImage || null, cp.seoTitle, cp.seoDescription).run();
      }
    } catch (e) {
      console.error('Error ensuring core page:', cp.slug, e);
    }
  }

  try {
    const { results: countResults } = await d1Db.prepare("SELECT status, COUNT(*) as count FROM Page GROUP BY status").all();
    if (countResults) {
      countResults.forEach((row: any) => {
        if (row.status === 'published') counts.published = row.count;
        if (row.status === 'draft') counts.draft = row.count;
        if (row.status === 'trash') counts.trash = row.count;
        counts.all += row.count;
      });
    }
  } catch(e) { console.error('Error fetching counts:', e); }
}

if (d1Db) {
  try {
    let baseWhere = `WHERE 1=1`;
    const params: any[] = [];
    
    if (currentTab === 'trash') {
      baseWhere += ` AND status = 'trash'`;
    } else if (currentTab !== 'all') {
      baseWhere += ` AND status = ?`;
      params.push(currentTab);
    } else {
      baseWhere += ` AND status != 'trash'`;
    }

    if (q) {
      const normalizeStr = (str: string) => str.normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/đ/g, 'd').replace(/Đ/g, 'D').toLowerCase();
      const keywords = q.split(' ').map(k => k.trim()).filter(k => k.length > 0);
      if (keywords.length > 0) {
        const conditions = keywords.map(() => `(title LIKE ? OR slug LIKE ?)`).join(' AND ');
        baseWhere += ` AND (${conditions})`;
        keywords.forEach(k => {
          params.push(`%${k}%`);
          params.push(`%${normalizeStr(k)}%`);
        });
      }
    }
    
    const countSql = `SELECT COUNT(*) as count FROM Page ${baseWhere}`;
    let countQuery = d1Db.prepare(countSql);
    if (params.length > 0) countQuery = countQuery.bind(...params);
    const { results: filteredCountResults } = await countQuery.all();
    let filteredTotal = counts.all;
    if (filteredCountResults && filteredCountResults.length > 0) {
      filteredTotal = filteredCountResults[0].count;
    }

    let sql = `SELECT * FROM Page ${baseWhere} ORDER BY updatedAt DESC LIMIT ? OFFSET ?`;
    let query = d1Db.prepare(sql).bind(...params, limit, offset);
    
    const { results } = await query.all();
    pages = results || [];

    const totalPages = Math.ceil(filteredTotal / limit);
    Object.assign(Astro.locals, { filteredTotal, totalPages });
  } catch (e) {
    console.error('Error fetching pages:', e);
  }
}

let filteredTotal = Astro.locals.filteredTotal !== undefined ? Astro.locals.filteredTotal : (currentTab === 'trash' ? counts.trash : currentTab === 'all' ? counts.all - counts.trash : counts[currentTab as keyof typeof counts] || counts.all);
const totalPages = Astro.locals.totalPages !== undefined ? Astro.locals.totalPages : Math.ceil(filteredTotal / limit);

function formatDate(dateStr: string) {
  if (!dateStr) return '—';
  const safeDate = typeof dateStr === 'string' ? dateStr.replace(' ', 'T') : dateStr;
  const d = new Date(safeDate);
  if (isNaN(d.getTime())) return dateStr;
  const datePart = d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
  const timePart = d.toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit' });
  return `${datePart}<br/>${timePart}`;
}
---

<AdminLayout title="Tất cả Pages" activeMenu="pages" activeSubmenu="all">
<style>
  .posts-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; }
  .posts-header h2 { font-size: 24px; font-weight: 700; }
  .posts-header-right { display: flex; gap: 12px; align-items: center; }
  .posts-header-right button, .posts-header-right a { padding: 6px 14px; border-radius: 8px; font-size: 13px; border: 1px solid #e2e8f0; background: #fff; color: #64748b; cursor: pointer; text-decoration: none; }
  .btn-primary { background: #2563eb !important; color: #fff !important; border-color: #2563eb !important; font-weight: 600; padding: 8px 20px !important; border-radius: 8px; }

  .posts-body { display: block; }
  .tabs { display: flex; gap: 0; border-bottom: 2px solid #e2e8f0; margin-bottom: 16px; }
  .tabs a { padding: 10px 16px; font-size: 13px; font-weight: 500; color: #64748b; background: none; border: none; border-bottom: 2px solid transparent; margin-bottom: -2px; cursor: pointer; text-decoration: none; display: inline-block; }
  .tabs a:hover { color: #0f172a; }
  .tabs a.active { color: #2563eb; border-bottom-color: #2563eb; }
  .tabs a.trash { color: #ef4444; border: 1px solid #fecaca; border-radius: 6px; margin-left: 8px; padding: 6px 12px; background: #fef2f2; }

  .filters { display: flex; gap: 8px; margin-bottom: 16px; flex-wrap: wrap; }
  .filters select, .filters button { padding: 7px 12px; border: 1px solid #e2e8f0; border-radius: 8px; font-size: 12px; color: #64748b; background: #fff; cursor: pointer; }
  .filters .filter-btn { background: #eff6ff; color: #2563eb; border-color: #bfdbfe; font-weight: 600; }
  .filters .search-box { display: flex; margin-left: auto; }
  .filters .search-box input { padding: 7px 12px; border: 1px solid #e2e8f0; border-radius: 8px 0 0 8px; font-size: 12px; width: 180px; outline: none; }
  .filters .search-box button { border-radius: 0 8px 8px 0; border-left: none; background: #2563eb; color: #fff; font-weight: 600; padding: 7px 14px; }

  table { width: 100%; border-collapse: collapse; table-layout: fixed; }
  thead th { text-align: left; padding: 12px 14px; font-size: 11px; text-transform: uppercase; letter-spacing: .5px; color: #94a3b8; font-weight: 600; border-bottom: 1px solid #e2e8f0; }
  th.col-check { width: 44px; }
  th.col-title { width: 60%; }
  th.col-date { width: 15%; }
  tbody td { padding: 14px; font-size: 13px; border-bottom: 1px solid #f1f5f9; vertical-align: middle; overflow: hidden; text-overflow: ellipsis; }
  tbody tr:hover { background: #f8fafc; }
  .post-cell { display: flex; align-items: center; gap: 12px; }
  .post-cell img { width: 44px; height: 44px; border-radius: 8px; object-fit: cover; flex-shrink: 0; background: #f1f5f9; }
  .post-cell .img-placeholder { width: 44px; height: 44px; border-radius: 8px; background: #e2e8f0; flex-shrink: 0; display: flex; align-items: center; justify-content: center; color: #94a3b8; font-size: 18px; }
  .post-cell a { font-weight: 600; color: #0f172a; text-decoration: none; }
  .post-cell a:hover { color: #2563eb; }
  
  .cat-badge { padding: 4px 10px; border-radius: 6px; font-size: 11px; font-weight: 600; white-space: nowrap; display: inline-block; background: #f1f5f9; color: #475569; }
  .cat-badge.published { background:#dcfce7; color:#16a34a; }
  .cat-badge.draft { background:#fef3c7; color:#d97706; }
  .cat-badge.trash { background:#fef2f2; color:#ef4444; }

  .date-cell { color: #64748b; font-size: 12px; white-space: nowrap; }
  .row-actions { display: flex; gap: 10px; align-items: center; margin-top: 5px; }
  .action-link { font-size: 12px; text-decoration: none; cursor: pointer; display: inline-block; background: none; border: none; padding: 0; font-weight: 500; }
  .action-edit { color: #2563eb; }
  .action-edit:hover { text-decoration: underline; }
  .action-delete { color: #ef4444; }
  .action-delete:hover { text-decoration: underline; }
  .action-restore { color: #16a34a; }
  .action-restore:hover { text-decoration: underline; }
  .action-view { color: #64748b; }
  .action-view:hover { text-decoration: underline; }
  td input[type="checkbox"], th input[type="checkbox"] { width: 16px; height: 16px; accent-color: #2563eb; cursor: pointer; }
  
  .page-btn { padding: 4px 10px; border: 1px solid #e2e8f0; border-radius: 6px; text-decoration: none; color: #64748b; font-size: 13px; background: #fff; line-height: 1; display: inline-flex; align-items: center; justify-content: center; min-width: 28px; font-weight: 600; }
  .page-btn:hover { border-color: #cbd5e1; color: #0f172a; }
  .page-btn.disabled { opacity: 0.5; pointer-events: none; }
  .page-input { width: 44px; padding: 4px 6px; border: 1px solid #e2e8f0; border-radius: 6px; text-align: center; font-size: 13px; outline: none; margin: 0 4px; }
  .page-input::-webkit-outer-spin-button, .page-input::-webkit-inner-spin-button { -webkit-appearance: none; margin: 0; }
  .page-input[type=number] { -moz-appearance: textfield; }
</style>

<div class="posts-header">
  <h2>Pages (Trang)</h2>
  <div class="posts-header-right">
    <select id="perPageSelect" style="padding: 6px 14px; border-radius: 8px; font-size: 13px; border: 1px solid #e2e8f0; background: #fff; color: #64748b; cursor: pointer; outline: none;" onchange="window.location.href='?limit='+this.value">
      <option value="30" selected={limit === 30}>30 items</option>
      <option value="50" selected={limit === 50}>50 items</option>
      <option value="100" selected={limit === 100}>100 items</option>
    </select>
    <a href="/admin/pages/edit" class="btn-primary">+ Tạo Page Mới</a>
  </div>
</div>

<div class="posts-body">
  <div>
    <div class="tabs">
      <a href="/admin/pages?status=all" class={currentTab === 'all' ? 'active' : ''}>Tất cả ({counts.all - counts.trash})</a>
      <a href="/admin/pages?status=published" class={currentTab === 'published' ? 'active' : ''}>Đã xuất bản ({counts.published})</a>
      <a href="/admin/pages?status=draft" class={currentTab === 'draft' ? 'active' : ''}>Bản nháp ({counts.draft})</a>
      <a href="/admin/pages?status=trash" class={`trash ${currentTab === 'trash' ? 'active' : ''}`}>Thùng rác ({counts.trash})</a>
    </div>

    <form class="filters" method="GET" action="/admin/pages" style="align-items: center;">
      {currentTab !== 'all' && <input type="hidden" name="status" value={currentTab} />}
      
      <!-- Bulk Actions Controls -->
      <select id="bulkActionSelect" style="padding: 7px 12px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 12px; background: #fff; font-weight: 500;">
        <option value="">Hành động hàng loạt</option>
        {currentTab === 'trash' ? (
          <>
            <option value="restore">♻️ Khôi phục</option>
            <option value="delete">🗑️ Xóa vĩnh viễn</option>
          </>
        ) : (
          <>
            <option value="trash">🗑️ Chuyển vào Thùng rác</option>
          </>
        )}
      </select>
      <button type="button" id="bulkApplyBtn" class="filter-btn">Áp dụng</button>

      <div style="display: flex; align-items: center; gap: 12px; margin-left: auto;">
        <span style="font-size: 12px; color: #64748b; font-weight: 600;">{filteredTotal} pages</span>
        {totalPages > 1 && (
          <div style="display: flex; gap: 4px; align-items: center;">
            <a href={`?page=1&limit=${limit}&status=${currentTab}&q=${q}`} class={`page-btn ${page === 1 ? 'disabled' : ''}`} aria-label="Trang đầu">«</a>
            <a href={`?page=${Math.max(1, page - 1)}&limit=${limit}&status=${currentTab}&q=${q}`} class={`page-btn ${page === 1 ? 'disabled' : ''}`} aria-label="Trang trước">‹</a>
            <span style="font-size: 13px; color: #64748b; font-weight: 500;">
              <input type="number" class="page-input" value={page} min="1" max={totalPages} onkeydown={`if(event.key==='Enter') window.location.href='?limit=${limit}&status=${currentTab}&q=${q}&page='+this.value`} />
              of {totalPages}
            </span>
            <a href={`?page=${Math.min(totalPages, page + 1)}&limit=${limit}&status=${currentTab}&q=${q}`} class={`page-btn ${page === totalPages ? 'disabled' : ''}`} aria-label="Trang sau">›</a>
            <a href={`?page=${totalPages}&limit=${limit}&status=${currentTab}&q=${q}`} class={`page-btn ${page === totalPages ? 'disabled' : ''}`} aria-label="Trang cuối">»</a>
          </div>
        )}
      </div>

      <div class="search-box" style="margin-left: 12px;">
        <input type="text" name="q" placeholder="Tìm tên page..." value={q} />
        <button type="submit">Tìm</button>
      </div>
    </form>

    <div class="card" style="overflow:hidden; border-radius: 12px; border: 1px solid #e2e8f0; background: #fff;">
      <table>
        <thead>
          <tr>
            <th class="col-check"><input type="checkbox" id="selectAllCheckbox" title="Chọn tất cả" /></th>
            <th class="col-title">Tên Trang</th>
            <th class="col-date">Cập nhật ⬇</th>
          </tr>
        </thead>
        <tbody>
          {pages.length === 0 && (
            <tr>
              <td colspan="3" style="text-align:center; padding: 40px; color: #94a3b8;">Không tìm thấy page nào.</td>
            </tr>
          )}
          {pages.map((p) => {
            return (
            <tr data-id={p.id}>
              <td><input type="checkbox" class="post-checkbox" value={p.id} /></td>
              <td>
                <div class="post-cell">
                  {p.featuredImage ? (
                    <img src={p.featuredImage} alt={p.title} />
                  ) : (
                    <div class="img-placeholder">📄</div>
                  )}
                  <div style="display:flex; flex-direction:column; gap:2px;">
                    <a href={`/admin/pages/edit?id=${p.id}`}>
                      {p.title || '(Chưa có tên)'} <span class={`cat-badge ${p.status}`} style="font-size: 10px; padding: 2px 6px;">{p.status}</span>
                    </a>
                    <div class="row-actions">
                      {currentTab === 'trash' ? (
                        <>
                          <button type="button" class="action-link action-restore" onclick={`handleSingleAction('restore', '${p.id}', '${(p.title || '').replace(/'/g, "\\'")}')`}>♻️ Khôi phục</button>
                          <span style="color:#cbd5e1;">|</span>
                          <button type="button" class="action-link action-delete" onclick={`handleSingleAction('delete', '${p.id}', '${(p.title || '').replace(/'/g, "\\'")}')`}>🗑️ Xóa vĩnh viễn</button>
                        </>
                      ) : (
                        <>
                          <a href={`/admin/pages/edit?id=${p.id}`} class="action-link action-edit">Sửa</a>
                          <span style="color:#cbd5e1;">|</span>
                          <a href={`/${p.slug}`} target="_blank" class="action-link action-view">Xem thử ↗</a>
                          <span style="color:#cbd5e1;">|</span>
                          <button type="button" class="action-link action-delete" onclick={`handleSingleAction('trash', '${p.id}', '${(p.title || '').replace(/'/g, "\\'")}')`}>Xoá</button>
                        </>
                      )}
                    </div>
                  </div>
                </div>
              </td>
              <td class="date-cell" set:html={formatDate(p.updatedAt)}></td>
            </tr>
          )})}
        </tbody>
      </table>

    </div>
  </div>
</div>

<script is:inline>
  // Select All Checkboxes
  const selectAll = document.getElementById('selectAllCheckbox');
  const checkboxes = document.querySelectorAll('.post-checkbox');

  if (selectAll) {
    selectAll.addEventListener('change', (e) => {
      checkboxes.forEach(cb => {
        cb.checked = e.target.checked;
      });
    });
  }

  // Handle Single Action (Trash, Restore, Permanent Delete)
  window.handleSingleAction = async function(action, id, title) {
    let confirmMsg = '';
    if (action === 'trash') confirmMsg = `Bạn có chắc muốn chuyển trang "${title}" vào Thùng rác không?`;
    else if (action === 'restore') confirmMsg = `Bạn có muốn khôi phục trang "${title}" không?`;
    else if (action === 'delete') confirmMsg = `CẢNH BÁO: Bạn có chắc muốn XÓA VĨNH VIỄN trang "${title}" không? Thao tác này không thể hoàn tác!`;

    if (!confirm(confirmMsg)) return;

    try {
      const res = await fetch('/api/admin/pages/action', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ action, ids: [id] })
      });
      const data = await res.json();
      if (res.ok && data.success) {
        window.location.reload();
      } else {
        const errMsg = data.message || (typeof data.error === 'string' ? data.error : data.error?.message) || JSON.stringify(data.error) || 'Thao tác thất bại';
        alert('Lỗi: ' + errMsg);
      }
    } catch (err) {
      alert('Lỗi kết nối máy chủ: ' + err.message);
    }
  };

  // Handle Bulk Action
  const bulkApplyBtn = document.getElementById('bulkApplyBtn');
  const bulkActionSelect = document.getElementById('bulkActionSelect');

  if (bulkApplyBtn && bulkActionSelect) {
    bulkApplyBtn.addEventListener('click', async () => {
      const action = bulkActionSelect.value;
      if (!action) {
        alert('Vui lòng chọn một hành động hàng loạt.');
        return;
      }

      const selectedIds = Array.from(document.querySelectorAll('.post-checkbox:checked')).map(cb => cb.value);
      if (selectedIds.length === 0) {
        alert('Vui lòng chọn ít nhất một trang để thực hiện.');
        return;
      }

      let confirmMsg = '';
      if (action === 'trash') confirmMsg = `Bạn có chắc muốn chuyển ${selectedIds.length} trang đã chọn vào Thùng rác?`;
      else if (action === 'restore') confirmMsg = `Khôi phục ${selectedIds.length} trang đã chọn?`;
      else if (action === 'delete') confirmMsg = `CẢNH BÁO: XÓA VĨNH VIỄN ${selectedIds.length} trang đã chọn? Thao tác này không thể hoàn tác!`;

      if (!confirm(confirmMsg)) return;

      try {
        const res = await fetch('/api/admin/pages/action', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action, ids: selectedIds })
        });
        const data = await res.json();
        if (res.ok && data.success) {
          window.location.reload();
        } else {
          const errMsg = data.message || (typeof data.error === 'string' ? data.error : data.error?.message) || JSON.stringify(data.error) || 'Thao tác thất bại';
          alert('Lỗi: ' + errMsg);
        }
      } catch (err) {
        alert('Lỗi kết nối máy chủ: ' + err.message);
      }
    });
  }
</script>
</AdminLayout>
