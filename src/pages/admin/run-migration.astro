---
import { env } from 'cloudflare:workers';

const d1Db = env?.dulichcoguu_d1;
if (!d1Db) return new Response("DB Error", { status: 500 });

let result = "";
try {
  await d1Db.prepare("ALTER TABLE Tour ADD COLUMN format TEXT DEFAULT 'elementor'").run();
  result = "Migration successful";
} catch (e: any) {
  result = "Migration failed: " + e.message;
}
---
<html>
<body>
  <h1>Migration Result</h1>
  <p>{result}</p>
</body>
</html>
