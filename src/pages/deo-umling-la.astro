---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/ladakh-co-may.css';
import '../styles/blog.css';
import '../styles/author-card.css';
import App from '../components/ReactApp/DeoUmlingLa/App.tsx';
import { env } from 'cloudflare:workers';
const d1Db = env?.dulichcoguu_d1;

let seoTitle = "Đèo Umling La, Ladakh - Con Đèo Cao Nhất Thế Giới Có Thể Đi Bằng Xe";
let seoDesc = "Đèo Umling La nằm ở Ladakh, được coi là con đèo cao nhất có thể đi qua bằng xe trên thế giới, với độ cao ấn tượng 5883m so với mực nước biển.";
let seoImage = "https://media.fittour.vn/uploads/2024/06/deo-Umling-La.webp";
let adminEditUrl = "";

if (d1Db) {
  try {
    const stmt = d1Db.prepare(`SELECT id, title, seoTitle as metaTitle, seoDescription as metaDescription, featuredImage FROM Post WHERE slug = 'deo-umling-la' LIMIT 1`);
    const postData = await stmt.first();
    if (postData) {
      // Temporarily commented out to force static SEO metadata to display
      // seoTitle = postData.metaTitle || postData.title || seoTitle;
      // seoDesc = postData.metaDescription || seoDesc;
      seoImage = postData.featuredImage || seoImage;
      if (postData.id) adminEditUrl = `/admin/posts/edit?id=${postData.id}`;
    }
  } catch (e) {
    console.error("Lỗi lấy SEO data cho trang deo-umling-la:", e);
  }
}
---
<BaseLayout
  title={seoTitle}
  description={seoDesc}
  image={seoImage}
  canonical="https://thericetour.com/deo-umling-la"
  adminEditUrl={adminEditUrl}
>
  <Fragment slot="head">
    <meta property="og:type" content="article" />
    <!-- Optimize Google Fonts Loading -->
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&family=JetBrains+Mono:wght@400;500;700&display=swap">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&family=JetBrains+Mono:wght@400;500;700&display=swap" media="print" onload="this.media='all'">
    <noscript>
      <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&family=JetBrains+Mono:wght@400;500;700&display=swap">
    </noscript>
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Article",
          "headline": seoTitle,
          "description": seoDesc,
          "image": [seoImage],
          "author": [{
            "@type": "Person",
            "name": "Huỳnh Hiếu",
            "url": "https://thericetour.com/huynh-hieu"
          }]
        },
        {
          "@type": "FAQPage",
          "mainEntity": [
            {
              "@type": "Question",
              "name": "Đèo Umling La cao bao nhiêu mét?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Đèo Umling La được coi là con đèo cao nhất có thể đi qua bằng xe trên thế giới, với độ cao ấn tượng 5,883 mét so với mực nước biển."
              }
            },
            {
              "@type": "Question",
              "name": "Thời gian lý tưởng để chinh phục đèo Umling La?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Mùa hè (từ tháng 6 đến tháng 9) là thời gian lý tưởng để chinh phục Umling La khi thời tiết ấm áp hơn và con đường ít bị tuyết phủ."
              }
            },
            {
              "@type": "Question",
              "name": "Đèo Umling La nằm ở đâu?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Umling La nằm ở phía đông nam Leh Ladakh, kết nối hai ngôi làng Chisumle và Demchok gần biên giới Ấn Độ – Trung Quốc."
              }
            }
          ]
        }
      ]
    })} />
  </Fragment>

  <!-- client:load is used to enable SSR which fixes Render Blocking and LCP issues -->
  <App client:load /> 
</BaseLayout>

