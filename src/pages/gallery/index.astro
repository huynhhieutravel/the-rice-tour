---
// src/pages/gallery/index.astro
import { env } from 'cloudflare:workers';
import BaseLayout from '@/layouts/BaseLayout.astro';
import ChinaBottomMenu from '@/components/china/ChinaBottomMenu.astro';
import { getCanonicalMediaUrl } from '@/lib/imageOptimization';

const d1Db = env?.dulichcoguu_d1;

if (!d1Db) {
  return new Response("No DB binding", { status: 500 });
}

// Fetch Category info (for SEO)
const categoryData = await d1Db.prepare("SELECT * FROM BlogCategory WHERE slug = 'gallery'").first<any>();

// Fetch all posts in gallery category
const catPostsRes = await d1Db.prepare(`
  SELECT p.id, p.slug, p.title, p.excerpt, p.featuredImage 
  FROM Post p
  JOIN PostCategory pc ON (CAST(p.id AS TEXT) = pc.postId OR p.id = pc.postId)
  JOIN BlogCategory bc ON pc.categoryId = bc.id
  WHERE bc.slug = 'gallery' AND (p.status = 'published' OR p.status = 'publish')
  ORDER BY p.createdAt DESC
`).all();

const allPosts = catPostsRes.results || [];

// Define the featured slugs and metadata
const featuredData: Record<string, { tag: string, tagColor: string }> = {
  'gallery-everest-base-camp': { tag: 'TRÊN ĐỈNH THẾ GIỚI', tagColor: 'bg-[#ff6b35] text-white' },
  'gallery-bhutan': { tag: 'VÙNG HẠNH PHÚC', tagColor: 'bg-[#ffea00] text-gray-900' },
  'gallery-tay-tang': { tag: 'VÙNG ĐẤT MẬT TÔNG', tagColor: 'bg-[#ff7b89] text-white' }
};

// Buckets mapping
const chinaSlugs = [
  'hinh-anh-mua-thu-giang-nam', 'hinh-anh-dao-thanh-a-dinh', 'hinh-anh-vu-nu-chau', 
  'hinh-anh-vong-tien-coc', 'hinh-anh-cat-tien-thon', 'hinh-anh-tho-lau-phuc-kien', 
  'hinh-anh-o-tran', 'hinh-anh-phim-truong-hoanh-diem', 'gallery-cuu-trai-cau', 
  'gallery-cap-nhi-tan'
];

const silkRoadSlugs = [
  'hinh-anh-nam-cuong', 'gallery-pakistan', 'hinh-anh-kim-tu-thap', 'gallery-ai-cap', 'hinh-anh-mong-co'
];

// Determine buckets
let featuredPosts: any[] = [];
let chinaPosts: any[] = [];
let silkRoadPosts: any[] = [];
let otherPosts: any[] = [];

// Try to grab featured in exact order
Object.keys(featuredData).forEach(featuredSlug => {
  const p = allPosts.find((p: any) => p.slug === featuredSlug);
  if (p) featuredPosts.push(p);
});

// Distribute the rest
allPosts.forEach((p: any) => {
  if (featuredData[p.slug]) return; // Already featured
  
  if (chinaSlugs.includes(p.slug)) {
    chinaPosts.push(p);
  } else if (silkRoadSlugs.includes(p.slug)) {
    silkRoadPosts.push(p);
  } else {
    otherPosts.push(p); // Himalaya, Nam Á, Châu Âu
  }
});

// Add edge caching for performance
Astro.response.headers.set('Cache-Control', 'public, s-maxage=3600, stale-while-revalidate=86400');
---

<BaseLayout 
  title={categoryData?.name || "Khám phá Gallery ảnh du lịch cùng Fit Tour"} 
  description={categoryData?.description || "Những gallery ảnh du lịch trên các chặng đường khác nhau cùng Fit Tour: thương hiệu Du lịch có Guu. Khám phá các vùng đất với hành trình cực chất."}
>
  {/* HERO SECTION */}
  <section class="pt-24 pb-16 bg-white border-b border-gray-100">
    <div class="max-w-[1200px] mx-auto px-4 md:px-8">
      <div class="flex flex-col md:flex-row items-center gap-12 lg:gap-20">
        <div class="md:w-5/12">
          <h1 class="text-4xl md:text-5xl lg:text-[54px] font-black text-gray-900 tracking-tight leading-[1.1] mb-6">
            Khám phá Gallery ảnh du lịch cùng Fit Tour
          </h1>
          <p class="text-gray-600 text-lg md:text-xl leading-relaxed mb-6">
            Những gallery ảnh du lịch trên các chặng đường khác nhau cùng Fit Tour: thương hiệu Du lịch có Guu. Khám phá các vùng đất với hành trình cực chất.
          </p>
          <p class="font-bold text-gray-900 text-lg">
            Chúng tôi có hàng ngàn bức ảnh khác nhau trên nhiều chặng đường như Ai Cập, Himalayas, Everest, Annapurna, Bhutan, Ladakh....
          </p>
        </div>
        <div class="md:w-7/12 w-full">
          <div class="rounded-xl overflow-hidden shadow-2xl shadow-gray-200/50 aspect-[16/9]">
            <img 
              src="https://media.fittour.vn/uploads/2025/08/road-trip-tan-cuong-ho-bach-sa-cap-doi-fit-tour.webp" 
              alt="Gallery du lịch Fit Tour" 
              class="w-full h-full object-cover"
              fetchpriority="high"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* FEATURED: Những hành trình ấn tượng */}
  {featuredPosts.length > 0 && (
    <section class="py-16 bg-white">
      <div class="max-w-[1200px] mx-auto px-4 md:px-8">
        <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-10 tracking-tight">Những hành trình ấn tượng</h2>
        
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          {featuredPosts.map((p: any) => {
            const meta = featuredData[p.slug];
            return (
              <div class="flex flex-col group h-full">
                <a href={`/${p.slug}`} class="block overflow-hidden mb-5">
                  <div class="aspect-[16/9] w-full">
                    <img 
                      src={p.featuredImage ? getCanonicalMediaUrl(p.featuredImage) : '/placeholder-image.jpg'} 
                      alt={p.title} 
                      class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" 
                      loading="lazy"
                    />
                  </div>
                </a>
                <a href={`/${p.slug}`} class="block mb-3">
                  <h3 class="text-2xl font-semibold text-gray-900 group-hover:text-brand-600 transition-colors line-clamp-2 leading-snug">
                    {p.title}
                  </h3>
                </a>
                {meta && (
                  <div class="mb-4">
                    <span class={`inline-block px-3 py-1 text-xs font-bold uppercase tracking-wider rounded-sm ${meta.tagColor}`}>
                      {meta.tag}
                    </span>
                  </div>
                )}
                <p class="text-gray-600 text-sm leading-relaxed line-clamp-4 mb-6 flex-grow">
                  {p.excerpt}
                </p>
                <div class="mt-auto">
                  <a href={`/${p.slug}`} class="inline-flex items-center px-4 py-2 text-sm font-medium text-gray-700 border border-gray-300 rounded hover:bg-gray-50 transition-colors">
                    <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
                    XEM CHI TIẾT
                  </a>
                </div>
              </div>
            );
          })}
        </div>
      </div>
    </section>
  )}

  {/* SILK ROAD: Con đường Tơ Lụa cổ đại */}
  {silkRoadPosts.length > 0 && (
    <section class="py-16 bg-gray-50 border-t border-gray-100">
      <div class="max-w-[1200px] mx-auto px-4 md:px-8">
        <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-10 tracking-tight">Hình ảnh chuyến đi ở Con đường Tơ lụa cổ đại</h2>
        
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          {silkRoadPosts.map((p: any) => (
            <div class="flex flex-col group h-full">
              <a href={`/${p.slug}`} class="block overflow-hidden mb-5">
                <div class="aspect-[16/9] w-full">
                  <img 
                    src={p.featuredImage ? getCanonicalMediaUrl(p.featuredImage) : '/placeholder-image.jpg'} 
                    alt={p.title} 
                    class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" 
                    loading="lazy"
                  />
                </div>
              </a>
              <a href={`/${p.slug}`} class="block mb-3">
                <h3 class="text-2xl font-semibold text-gray-900 group-hover:text-brand-600 transition-colors line-clamp-2 leading-snug">
                  {p.title}
                </h3>
              </a>
              <div class="mb-4">
                <span class="inline-block px-3 py-1 text-xs font-bold uppercase tracking-wider rounded-sm bg-[#00d4ff] text-gray-900">
                  {p.slug.includes('motor') || p.slug.includes('pakistan') ? 'MOTOR TRIP' : 'CON ĐƯỜNG TƠ LỤA'}
                </span>
              </div>
              <p class="text-gray-600 text-sm leading-relaxed line-clamp-4 mb-6 flex-grow">
                {p.excerpt}
              </p>
              <div class="mt-auto">
                <a href={`/${p.slug}`} class="inline-flex items-center px-4 py-2 text-sm font-medium text-gray-700 border border-gray-300 rounded hover:bg-gray-50 transition-colors">
                  <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
                  XEM CHI TIẾT
                </a>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  {/* CHINA: Trung Hoa rực rỡ */}
  {chinaPosts.length > 0 && (
    <section class="py-16 bg-white border-t border-gray-100">
      <div class="max-w-[1200px] mx-auto px-4 md:px-8">
        <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-10 tracking-tight">Hành trình ngắm phong cảnh Trung Hoa rực rỡ</h2>
        
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          {chinaPosts.map((p: any) => (
            <div class="flex flex-col group h-full">
              <a href={`/${p.slug}`} class="block overflow-hidden mb-5">
                <div class="aspect-[16/9] w-full bg-gray-100">
                  <img 
                    src={p.featuredImage ? getCanonicalMediaUrl(p.featuredImage) : '/placeholder-image.jpg'} 
                    alt={p.title} 
                    class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" 
                    loading="lazy"
                  />
                </div>
              </a>
              <a href={`/${p.slug}`} class="block mb-3">
                <h3 class="text-2xl font-semibold text-gray-900 group-hover:text-[#ea580c] transition-colors line-clamp-2 leading-snug">
                  {p.title}
                </h3>
              </a>
              <p class="text-gray-600 text-sm leading-relaxed line-clamp-3 mb-6 flex-grow">
                {p.excerpt}
              </p>
              <div class="mt-auto">
                <a href={`/${p.slug}`} class="inline-flex items-center px-4 py-2 text-sm font-medium text-[#ea580c] border border-[#ea580c] rounded hover:bg-orange-50 transition-colors">
                  XEM CHI TIẾT
                </a>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  {/* OTHER: Himalaya & Những vùng đất khác */}
  {otherPosts.length > 0 && (
    <section class="py-16 bg-gray-50 border-t border-gray-100">
      <div class="max-w-[1200px] mx-auto px-4 md:px-8">
        <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-10 tracking-tight">Himalaya & Những vùng đất kỳ vĩ khác</h2>
        
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8">
          {otherPosts.map((p: any) => (
            <div class="flex flex-col group h-full bg-white rounded-lg p-4 shadow-sm border border-gray-100">
              <a href={`/${p.slug}`} class="block overflow-hidden mb-4 rounded">
                <div class="aspect-[16/9] w-full bg-gray-100">
                  <img 
                    src={p.featuredImage ? getCanonicalMediaUrl(p.featuredImage) : '/placeholder-image.jpg'} 
                    alt={p.title} 
                    class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" 
                    loading="lazy"
                  />
                </div>
              </a>
              <a href={`/${p.slug}`} class="block mb-2">
                <h3 class="text-lg font-bold text-gray-900 group-hover:text-brand-600 transition-colors line-clamp-2 leading-tight">
                  {p.title}
                </h3>
              </a>
              <p class="text-gray-500 text-xs leading-relaxed line-clamp-2 mb-4 flex-grow">
                {p.excerpt}
              </p>
              <div class="mt-auto">
                <a href={`/${p.slug}`} class="text-xs font-bold text-brand-600 hover:text-brand-800 transition-colors uppercase tracking-wider inline-flex items-center">
                  Xem chi tiết <svg class="w-3 h-3 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
                </a>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}


  <ChinaBottomMenu activeTab="Thư Viện Ảnh" />
</BaseLayout>
