---
import { env } from 'cloudflare:workers';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { safeQueryCritical } from '@/lib/db-client';
import { getGlobalSettings } from '@/lib/settingsHelper';
import { Clock, Calendar, ChevronRight, CheckCircle2, Shield, Check, Info, AlertTriangle, MapPin, Ticket, Landmark, Compass, Flag, ShieldCheck, Footprints, Sun, Users, Sparkles, Navigation, Waves, Trees } from 'lucide-react';
import DataPost from '@/components/shortcodes/data/DataPost.astro';

const d1Db = env?.dulichcoguu_d1;
let post;
try {
  if (d1Db) post = await safeQueryCritical(
    d1Db.prepare("SELECT * FROM Post WHERE slug = ? AND (status = 'published' OR status = 'publish')").bind('thien-dan-bac-kinh').first<any>(),
    { route: Astro.url.pathname, slug: 'thien-dan-bac-kinh', queryType: "fetch_post_by_slug" }
  );
} catch (e) {
  // Gracefully fallback if DB error or not created yet
}

// Fallback metadata if post is not yet populated in CMS
if (!post) {
  post = {
    id: 995,
    title: 'Thiên Đàn Bắc Kinh: Giá Vé, Cách Đi Và Kinh Nghiệm Tham Quan',
    excerpt: 'Kinh nghiệm tham quan Thiên Đàn (Temple of Heaven) Bắc Kinh: Giá vé 2026, cách đi Metro Line 5, chọn cổng, tham quan Điện Kỳ Niên, Bức Tường Vọng Âm, Viên Khâu Đàn và lưu ý quan trọng.',
    featuredImage: 'https://media.fittour.vn/uploads/thien-dan-bac-kinh.webp',
    author: 'Huynh Hieu Travel',
    createdAt: '2026-08-19T08:00:00.000Z',
    updatedAt: '2026-08-19T08:00:00.000Z',
    readingTime: 13
  };
}

const { settings } = await getGlobalSettings();

const seoTitle = post.seoTitle || post.title || 'Thiên Đàn Bắc Kinh: Giá Vé, Cách Đi Và Kinh Nghiệm Tham Quan';
const seoDesc = post.seoDesc || post.excerpt || 'Kinh nghiệm tham quan Thiên Đàn (Temple of Heaven) Bắc Kinh: Giá vé 2026, cách đi Metro Line 5, chọn cổng, tham quan Điện Kỳ Niên, Bức Tường Vọng Âm, Viên Khâu Đàn và lưu ý quan trọng.';
const seoImage = post.seoImage || post.featuredImage || 'https://media.fittour.vn/uploads/thien-dan-bac-kinh.webp';

// --- DATE LOGIC ---
const createdAtStr = post.createdAt || post.publishedAt || '2026-08-19T08:00:00.000Z';
const updatedAtStr = post.updatedAt || createdAtStr;

const createdAt = new Date(createdAtStr.replace(' ', 'T'));
const updatedAt = new Date(updatedAtStr.replace(' ', 'T'));

const isUpdated = updatedAt.getTime() - createdAt.getTime() > 86400000; 
const displayDate = isUpdated ? updatedAt : createdAt;
const datePrefix = isUpdated ? "Cập nhật:" : "Xuất bản:";

const formattedDate = displayDate.toLocaleDateString('vi-VN', { day: '2-digit', month: '2-digit', year: 'numeric' });
// ------------------

// --- AUTHOR LOGIC ---
const authorMap: Record<string, any> = {
  "Max Vũ": {
    name: "Max Vũ",
    url: "/max-vu",
    img: "https://media.fittour.vn/uploads/max-vu-founder-fit-tour.webp"
  },
  "Huy Ngô": {
    name: "Huy Ngô",
    url: "/hdv-huy-ngo",
    img: "https://media.fittour.vn/uploads/hdv-huy-ngo-fittour.webp"
  },
  "Huynh Hieu Travel": {
    name: "Huynh Hieu Travel",
    url: "/huynh-hieu",
    img: "https://media.fittour.vn/uploads/huynhhieutravel.webp"
  }
};
const authorData = authorMap[post.author] || authorMap["Huynh Hieu Travel"];
// ------------------

const adminEditUrl = post.id && post.id !== 995 && post.id !== 996 && post.id !== 997 && post.id !== 998 && post.id !== 999 ? `/admin/posts/edit?id=${post.id}` : '#';

// TOC Navigation Structure
const toc = [
  { id: "gioi-thieu", title: "Giới thiệu", icon: "🏠" },
  { id: "lich-su-y-nghia", title: "Thiên Đàn Được Xây Dựng Khi Nào & Để Làm Gì?" },
  { id: "vi-sao-dac-biet", title: "Vì Sao Thiên Đàn Đặc Biệt?" },
  { id: "troi-tron-dat-vuong", title: "Ý Niệm \"Trời Tròn, Đất Vuông\" Thể Hiện Thế Nào?" },
  { id: "cong-trinh-chinh", title: "Những Công Trình Không Nên Bỏ Qua" },
  { id: "dien-ky-nien", title: "• Điện Kỳ Niên (Biểu Tượng Thiên Đàn)", indent: true },
  { id: "hoang-khung-vu", title: "• Hoàng Khung Vũ & Bức Tường Vọng Âm", indent: true },
  { id: "vien-khau-dan", title: "• Viên Khâu Đàn (Nơi Tế Trời)", indent: true },
  { id: "dan-be-kieu", title: "• Đan Bệ Kiều (Trục Nghi Lễ)", indent: true },
  { id: "diem-tham-quan-khac", title: "Những Điểm Ít Được Nhắc Đến Nhưng Đáng Xem" },
  { id: "thien-dan-buoi-sang", title: "Thiên Đàn Buổi Sáng: Nhịp Sống Công Viên Bắc Kinh" },
  { id: "co-can-dat-ve-truoc", title: "Có Cần Đặt Vé Thiên Đàn Trước Không?" },
  { id: "gia-ve-2026", title: "Bảng Giá Vé Thiên Đàn 2026 & Vé Liên Hợp" },
  { id: "gio-mo-cua", title: "Giờ Mở Cửa & Lịch Đóng Cửa" },
  { id: "chieu-sang-ban-dem", title: "Thiên Đàn Có Thể Tham Quan Ban Đêm Không?" },
  { id: "nen-vao-cong-nao", title: "Nên Vào Thiên Đàn Bằng Cổng Nào?" },
  { id: "tuyen-tham-quan", title: "Gợi Ý 2 Tuyến Tham Quan Dễ Áp Dụng" },
  { id: "phu-hop-nguoi-lon-tuoi", title: "Thiên Đàn Có Phù Hợp Người Lớn Tuổi Không?" },
  { id: "so-sanh-tu-cam-thanh", title: "Thiên Đàn Có Gì Khác Tử Cấm Thành?" },
  { id: "co-nen-di-cung-ngay", title: "Có Nên Đi Thiên Đàn Cùng Ngày Với Tử Cấm Thành?" },
  { id: "cach-di-den", title: "Cách Đi Đến Thiên Đàn Bằng Metro" },
  { id: "mua-nao-dep-nhat", title: "Mùa Nào Đẹp Nhất Để Đi Thiên Đàn?" },
  { id: "co-dang-di-khong", title: "Thiên Đàn Có Đáng Đi Không?" },
  { id: "7-dieu-can-nho", title: "7 Điều Cần Nhớ Trước Khi Đi" },
  { id: "faq", title: "Câu Hỏi Thường Gặp (FAQ)" },
  { id: "hanh-trinh-fit-tour", title: "Thiên Đàn Trong Hành Trình FIT TOUR" }
];
---

<BaseLayout 
  title={seoTitle} 
  description={seoDesc} 
  image={seoImage}
  preloadImages={[seoImage]}
  adminEditUrl={adminEditUrl}
>
  <Fragment slot="schema">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Article",
          "headline": seoTitle,
          "image": [seoImage],
          "datePublished": "2026-08-19T08:00:00+07:00",
          "dateModified": new Date().toISOString(),
          "author": {
            "@type": "Person",
            "name": authorData.name,
            "url": authorData.url
          },
          "publisher": {
            "@type": "Organization",
            "name": "FIT TOUR",
            "logo": {
              "@type": "ImageObject",
              "url": "https://media.thericetour.com/uploads/logo-the-rice.webp"
            }
          },
          "description": seoDesc
        },
        {
          "@type": "BreadcrumbList",
          "itemListElement": [
            {
              "@type": "ListItem",
              "position": 1,
              "name": "Trang chủ",
              "item": "https://thericetour.com/"
            },
            {
              "@type": "ListItem",
              "position": 2,
              "name": "Blog Du Lịch",
              "item": "https://thericetour.com/blog"
            },
            {
              "@type": "ListItem",
              "position": 3,
              "name": "Thiên Đàn Bắc Kinh",
              "item": "https://thericetour.com/thien-dan-bac-kinh"
            }
          ]
        }
      ]
    })} />
  </Fragment>

  <div class="bg-[#F8F9FA] text-[#1E293B] font-sans antialiased selection:bg-[#F7931E] selection:text-white">

    {/* ================= HERO SECTION ================= */}
    <section class="relative w-full min-h-[580px] lg:min-h-[660px] overflow-hidden flex flex-col justify-center pt-32 pb-20">
      <div class="absolute inset-0 z-0 bg-slate-950">
        <img 
          src={seoImage} 
          alt="Thiên Đàn Bắc Kinh Temple of Heaven Trung Quốc" 
          class="w-full h-full object-cover object-center opacity-75" 
          width="1920" 
          height="1080"
          fetchpriority="high" 
          loading="eager" 
          decoding="async" 
        />
        <div class="absolute inset-0 bg-gradient-to-r from-black/90 via-black/65 to-black/35"></div>
        <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-transparent to-transparent"></div>
      </div>

      <div class="relative z-10 max-w-[1600px] mx-auto px-4 sm:px-6 lg:px-12 w-full">
        
        {/* Breadcrumb */}
        <div class="flex items-center gap-2 text-[13px] text-white/70 font-medium mb-6">
          <a href="/" class="hover:text-white transition-colors">Trang chủ</a>
          <ChevronRight class="w-3 h-3" />
          <a href="/blog" class="hover:text-white transition-colors">Blog</a>
          <ChevronRight class="w-3 h-3" />
          <span class="text-white font-semibold line-clamp-1">Thiên Đàn Bắc Kinh (Temple of Heaven)</span>
        </div>

        {/* Titles */}
        <h1 class="font-serif text-3xl sm:text-4xl lg:text-5xl xl:text-6xl font-bold text-white mb-4 leading-[1.15] drop-shadow-lg max-w-5xl">
          {post.title}
        </h1>
        <h2 class="font-serif text-lg sm:text-2xl lg:text-3xl text-amber-400 italic mb-8 max-w-4xl drop-shadow-md font-medium">
          Từ đàn tế Trời của hoàng gia đến công viên thanh bình giữa lòng Bắc Kinh
        </h2>
        <p class="text-white/90 text-base sm:text-lg max-w-3xl leading-relaxed mb-8 hidden md:block drop-shadow-md font-normal">
          Thiên Đàn là quần thể đàn tế nơi các hoàng đế triều Minh và Thanh tiến hành nghi lễ cầu Trời ban mưa thuận gió hòa. Khác với sự thâm nghiêm của cung điện, nơi đây là sự đan xen giữa kiến trúc cổ và một công viên rộng lớn rợp bóng cây.
        </p>

        {/* Author Meta */}
        <div class="flex flex-wrap items-center gap-4 sm:gap-6 text-sm text-white/80 border-t border-white/20 pt-6 max-w-3xl">
          <a href={authorData.url} class="flex items-center gap-3 group">
            <img 
              src={authorData.img} 
              alt={authorData.name} 
              width="40" 
              height="40" 
              class="w-10 h-10 rounded-full border-2 border-white/30 object-cover object-top group-hover:border-amber-400 transition-colors" 
            />
            <span class="font-bold text-white group-hover:text-amber-400 transition-colors flex items-center gap-1">
              {authorData.name} 
              <CheckCircle2 class="w-4 h-4 text-blue-400" />
            </span>
          </a>
          <div class="flex items-center gap-2 bg-white/10 px-4 py-2 rounded-full backdrop-blur-sm border border-white/10">
            <Calendar class="w-4 h-4 opacity-70" />
            <span>{datePrefix} {formattedDate}</span>
          </div>
          <div class="flex items-center gap-2 bg-black/30 px-3 py-1.5 rounded-full backdrop-blur-sm">
            <Clock class="w-4 h-4 text-amber-400" />
            <span>{post.readingTime || 13} phút đọc</span>
          </div>
        </div>

        {/* Badges Line */}
        <div class="flex flex-wrap items-center gap-3 mt-8 pt-4">
          <div class="flex items-center gap-2 text-xs sm:text-sm text-white font-medium bg-black/60 backdrop-blur-md px-3.5 py-2 border border-white/10 rounded-lg shadow-xl">
            <span class="text-amber-400 text-base">📍</span> Quận Đông Thành, Nam Tử Cấm Thành
          </div>
          <div class="flex items-center gap-2 text-xs sm:text-sm text-white font-medium bg-black/60 backdrop-blur-md px-3.5 py-2 border border-white/10 rounded-lg shadow-xl">
            <span class="text-amber-400 text-base">🌲</span> Quy mô khoảng 273 ha
          </div>
          <div class="flex items-center gap-2 text-xs sm:text-sm text-white font-medium bg-black/60 backdrop-blur-md px-3.5 py-2 border border-white/10 rounded-lg shadow-xl">
            <span class="text-amber-400 text-base">🎟️</span> Đặt Online & Mua Trực Tiếp Tại Cổng
          </div>
          <div class="flex items-center gap-2 text-xs sm:text-sm text-white font-medium bg-black/60 backdrop-blur-md px-3.5 py-2 border border-white/10 rounded-lg shadow-xl">
            <span class="text-amber-400 text-base">🏛️</span> Di Sản Thế Giới UNESCO 1998
          </div>
        </div>

      </div>
    </section>

    {/* ================= MAIN CONTENT GRID ================= */}
    <div class="max-w-[1600px] mx-auto px-4 sm:px-6 lg:px-12 py-12 lg:py-16">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-start">

        {/* ---------------- LEFT SIDEBAR (TOC) ---------------- */}
        <aside class="hidden lg:block lg:col-span-3 sticky top-24">
          <div class="bg-white rounded-2xl shadow-sm border border-slate-200/60 p-6 overflow-hidden">
            <div class="flex items-center gap-2 font-bold text-slate-900 mb-5 border-l-4 border-amber-500 pl-3 text-sm tracking-wide uppercase">
              Mục lục bài viết
            </div>
            
            <nav class="space-y-1 text-[13.5px] font-medium max-h-[calc(100vh-200px)] overflow-y-auto pr-1">
              <a href="#gioi-thieu" class="flex items-center gap-2 text-amber-900 bg-amber-50/80 px-3 py-2 rounded-lg transition-colors font-bold">
                <span class="text-amber-600 text-base">🏠</span> Giới thiệu
              </a>
              
              <div class="pt-1.5 space-y-1 border-l border-slate-200 ml-3 pl-3">
                {toc.slice(1).map((item) => (
                  <a 
                    href={`#${item.id}`} 
                    class={`block transition-colors leading-tight py-1.5 text-slate-600 hover:text-amber-800 ${item.indent ? 'pl-2 text-[12.5px] border-l border-transparent hover:border-amber-400' : 'font-semibold text-[13px]'}`}
                  >
                    {item.title}
                  </a>
                ))}
              </div>
            </nav>
          </div>
        </aside>

        {/* ---------------- CENTER COLUMN (MAIN CONTENT) ---------------- */}
        <main class="col-span-1 lg:col-span-6 space-y-10">
          
          {/* Quick Overview Stats Bar */}
          <div class="bg-white rounded-2xl shadow-sm border border-slate-200/60 p-6 flex flex-wrap lg:flex-nowrap items-center justify-between gap-4">
            
            <div class="w-full flex items-center justify-between gap-4 mb-2 lg:hidden">
              <span class="font-bold text-slate-900 text-sm border-l-4 border-amber-500 pl-2 uppercase">Tổng Quan Nhanh</span>
            </div>

            <div class="flex items-center gap-3 w-[48%] lg:w-auto">
              <div class="w-10 h-10 rounded-full bg-amber-50 flex items-center justify-center text-amber-700 text-xl border border-amber-200/60 shrink-0">📍</div>
              <div>
                <div class="text-[11px] text-slate-500 font-medium">Vị trí</div>
                <div class="text-[13px] font-bold text-slate-900">Phía Nam Tử Cấm Thành</div>
              </div>
            </div>

            <div class="hidden lg:block w-px h-8 bg-slate-200"></div>

            <div class="flex items-center gap-3 w-[48%] lg:w-auto">
              <div class="w-10 h-10 rounded-full bg-amber-50 flex items-center justify-center text-amber-700 text-xl border border-amber-200/60 shrink-0">📐</div>
              <div>
                <div class="text-[11px] text-slate-500 font-medium">Quy mô</div>
                <div class="text-[13px] font-bold text-slate-900">273 ha</div>
              </div>
            </div>

            <div class="hidden lg:block w-px h-8 bg-slate-200"></div>

            <div class="flex items-center gap-3 w-[48%] lg:w-auto">
              <div class="w-10 h-10 rounded-full bg-amber-50 flex items-center justify-center text-amber-700 text-xl border border-amber-200/60 shrink-0">🎫</div>
              <div>
                <div class="text-[11px] text-slate-500 font-medium">Vé vào cửa</div>
                <div class="text-[13px] font-bold text-slate-900">15 – 34 CNY (Có vé liên hợp)</div>
              </div>
            </div>

            <div class="hidden lg:block w-px h-8 bg-slate-200"></div>

            <div class="flex items-center gap-3 w-[48%] lg:w-auto">
              <div class="w-10 h-10 rounded-full bg-amber-50 flex items-center justify-center text-amber-700 text-xl border border-amber-200/60 shrink-0">⏱️</div>
              <div>
                <div class="text-[11px] text-slate-500 font-medium">Thời gian gợi ý</div>
                <div class="text-[13px] font-bold text-slate-900">2 – 3 giờ (Ưu tiên buổi sáng)</div>
              </div>
            </div>

          </div>

          {/* Intro Text */}
          <div id="gioi-thieu" class="prose prose-slate max-w-none prose-p:leading-relaxed prose-p:text-[16px] prose-p:text-slate-700 space-y-4">
            <p>
              <strong>Thiên Đàn (天坛, Temple of Heaven)</strong> là quần thể đàn tế nơi các hoàng đế nhà Minh và nhà Thanh từng thực hiện những nghi lễ quan trọng để cầu Trời ban mưa thuận gió hòa, mùa màng bội thu và khẳng định vị thế của hoàng tộc trong trật tự vũ trụ theo quan niệm Trung Hoa cổ đại.
            </p>
            <p>
              Ngày nay, Thiên Đàn không chỉ là một di sản nổi tiếng mà còn là một công viên rộng lớn. Các công trình nghi lễ hàng trăm năm tuổi nằm đan xen giữa rừng bách cổ thụ và không gian sinh hoạt thường ngày của người dân Bắc Kinh.
            </p>
            <p>
              Đây chính là điểm tạo nên trải nghiệm rất khác biệt so với <a href="/tu-cam-thanh" class="text-brand-700 hover:text-brand-800 underline font-medium">Tử Cấm Thành</a> hay <a href="/di-hoa-vien" class="text-brand-700 hover:text-brand-800 underline font-medium">Di Hòa Viên</a>. Nếu Tử Cấm Thành kể câu chuyện về hoàng quyền và đời sống cung đình khép kín, Thiên Đàn lại mở ra câu chuyện về Trời, đất, nghi lễ và mối quan hệ giữa con người với vũ trụ.
            </p>
          </div>

          {/* Section 1: Lịch Sử & Ý Nghĩa */}
          <section id="lich-su-y-nghia" class="scroll-mt-28 space-y-4">
            <div class="border-l-4 border-amber-500 pl-4">
              <h2 class="font-serif text-2xl lg:text-[26px] font-bold text-slate-900 leading-tight">
                Thiên Đàn Được Xây Dựng Khi Nào Và Để Làm Gì?
              </h2>
            </div>
            
            <div class="text-slate-700 text-[15.5px] leading-relaxed space-y-4">
              <p>
                Thiên Đàn được xây dựng vào đầu thế kỷ XV dưới thời Hoàng đế Vĩnh Lạc nhà Minh, hoàn thành cùng thời kỳ với Tử Cấm Thành vào năm 1420. Ban đầu, quần thể mang tên <strong>Thiên Địa Đàn</strong>, bởi nghi lễ tế Trời và tế Đất được tiến hành trong cùng một khu vực.
              </p>
              <p>
                Đến năm 1530 dưới thời vua Gia Tĩnh, nghi lễ tế Trời và tế Đất được tách riêng. Viên Khâu Đàn được xây dựng ở phía Nam dành riêng cho nghi lễ tế Trời, từ đó quần thể chính thức mang tên <strong>Thiên Đàn</strong>. Bố cục ngày nay được hoàn thiện qua những đợt xây dựng và tu sửa dưới thời Minh – Thanh, đặc biệt trong thế kỷ XVIII dưới triều vua Càn Long.
              </p>
              <p>
                Trong xã hội phong kiến, hoàng đế được xem là “Thiên tử” (con của Trời), giữ vai trò trung gian giữa trần thế và thiên giới. Vì vậy, các nghi lễ tại Thiên Đàn không đơn thuần là nghi thức tôn giáo mà còn gắn trực tiếp với tính chính danh của quyền lực hoàng gia. Một trong những nghi lễ quan trọng nhất là lễ cầu mùa màng bội thu cho nền kinh tế nông nghiệp.
              </p>
              <div class="bg-amber-50/70 p-4 rounded-xl border border-amber-200 text-sm text-slate-800 space-y-1">
