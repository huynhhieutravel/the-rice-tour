---
import BaseLayout from '@/layouts/BaseLayout.astro';
import '@/styles/ladakh-co-may.css';
import '@/styles/blog.css';
import '@/styles/author-card.css';

import App from '@/components/ReactApp/SayDoCao/App.tsx';
import SayDoCaoChecklist from '@/components/ReactApp/SayDoCao/components/SayDoCaoChecklist.tsx';
import FaqSection from '@/components/ReactApp/SayDoCao/components/FaqSection.tsx';
import Guestbook from '@/components/ReactApp/SayDoCao/components/Guestbook.tsx';
import RelatedArticles from '@/components/ReactApp/SayDoCao/components/RelatedArticles.tsx';
import SignatureTour from '@/components/ReactApp/SayDoCao/components/SignatureTour.tsx';
import FooterApp from '@/components/ReactApp/SayDoCao/components/FooterApp.tsx';
import FloatingButton from '@/components/ReactApp/SayDoCao/components/FloatingButton.tsx';

import { env } from 'cloudflare:workers';
import { safeQueryCritical } from '@/lib/db-client';
import { getCanonicalMediaUrl } from '@/lib/imageOptimization';
import { FAQ } from '@/components/ReactApp/SayDoCao/data.ts';

let postData: any = null;
let adminEditUrl = "/admin/posts";

try {
  const d1Db = env?.dulichcoguu_d1;
  if (d1Db) {
    postData = await safeQueryCritical(
      d1Db.prepare("SELECT * FROM Post WHERE slug = ?").bind("say-do-cao").first<any>(),
      { route: Astro.url.pathname, slug: "say-do-cao", queryType: "fetch_post_by_slug" }
    );
    if (postData) {
      adminEditUrl = `/admin/posts/edit?id=${postData.id}`;
    }
  }
} catch (e) {
  console.log("Could not fetch post metadata:", e);
}

const rawFeaturedImage = postData?.featuredImage || "https://media.fittour.vn/uploads/route-map-tour-ladakh.webp";
const featuredImage = rawFeaturedImage.startsWith('http') ? rawFeaturedImage : getCanonicalMediaUrl(rawFeaturedImage);
---
<BaseLayout
  title={postData?.title || "Say Độ Cao Khi Du Lịch - Triệu Chứng Và Cách Phòng Tránh"}
  description={postData?.description || "Kinh nghiệm thực tế chống Say độ cao (AMS) tại Ladakh. Cẩm nang an toàn, cách nghỉ ngơi, uống thuốc từ chuyên gia."}
  image={featuredImage}
  canonical="https://thericetour.com/say-do-cao"
  adminEditUrl={adminEditUrl}
  preloadImages={[featuredImage]}
>
  <Fragment slot="head">
    <link rel="preload" as="image" href={featuredImage} fetchpriority="high" />
    <meta property="og:type" content="article" />
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400;1,500&family=Montserrat:wght@100;200;300;400;500;600;700&family=Space+Grotesk:wght@300;400;500;600;700&family=Inter:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&family=JetBrains+Mono:wght@400;500;700&display=swap">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400;1,500&family=Montserrat:wght@100;200;300;400;500;600;700&family=Space+Grotesk:wght@300;400;500;600;700&family=Inter:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&family=JetBrains+Mono:wght@400;500;700&display=swap" media="print" onload="this.media='all'">
    <noscript>
      <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400;1,500&family=Montserrat:wght@100;200;300;400;500;600;700&family=Space+Grotesk:wght@300;400;500;600;700&family=Inter:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&family=JetBrains+Mono:wght@400;500;700&display=swap">
    </noscript>

    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Article",
          "headline": postData?.title || "Say Độ Cao Khi Du Lịch - Triệu Chứng Và Cách Phòng Tránh",
          "description": postData?.description || "Kinh nghiệm thực tế chống Say độ cao (AMS) tại Ladakh. Cẩm nang an toàn, cách nghỉ ngơi, uống thuốc từ chuyên gia.",
          "image": featuredImage,
          "author": {
            "@type": "Person",
            "name": "Huy Ngô",
            "url": "https://thericetour.com/author/huy-ngo"
          },
          "publisher": {
            "@type": "Organization",
            "name": "FIT Tour",
            "logo": {
              "@type": "ImageObject",
              "url": "https://media.thericetour.com/uploads/logo-the-rice.webp"
            }
          },
          "datePublished": "2026-09-01T08:00:00+08:00",
          "dateModified": "2026-09-01T08:00:00+08:00",
          "mainEntityOfPage": {
            "@type": "WebPage",
            "@id": "https://thericetour.com/say-do-cao"
          }
        },
        {
          "@type": "FAQPage",
          "mainEntity": FAQ.map(faq => ({
            "@type": "Question",
            "name": faq.question,
            "acceptedAnswer": {
              "@type": "Answer",
              "text": faq.answer
            }
          }))
        }
      ]
    })} />
  </Fragment>

  <main class="min-h-screen bg-stone-50 text-stone-800 font-sans selection:bg-amber-150 selection:text-amber-900 overflow-x-hidden antialiased">
    <App client:load featureImage={featuredImage} title={postData?.title} /> 
    
    {/* CHECKLIST ĐƯỢC CHÈN NGAY BÊN DƯỚI CHAPTERS */}
    <div class="bg-white border-b border-stone-200">
      <div class="max-w-4xl mx-auto py-16 px-4">
        <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full border border-amber-900/15 bg-amber-50 text-amber-900 text-xs font-mono font-bold mb-6 uppercase tracking-wider mx-auto w-fit flex">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-amber-700">
            <path d="M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2 2 6.477 2 12s4.477 10 10 10z"/><path d="m9 12 2 2 4-4"/>
          </svg>
          <span>Health Check</span>
        </div>
        <h3 class="text-3xl md:text-4xl font-serif font-bold text-center mb-4 text-stone-900">Kiểm Tra Trạng Thái Sức Khỏe</h3>
        <p class="text-center text-stone-500 mb-10 max-w-[600px] mx-auto text-base md:text-lg">Hãy thử làm bài test ngắn để xem bạn đã sẵn sàng và có chuẩn bị tốt nhất để phòng tránh say độ cao chưa nhé.</p>
        <SayDoCaoChecklist client:visible />
      </div>
    </div>

    <FaqSection client:visible />
    <Guestbook client:visible />
    <RelatedArticles client:visible />
    <SignatureTour client:visible />
    <FooterApp client:visible />
    <FloatingButton client:load />
  </main>
</BaseLayout>
