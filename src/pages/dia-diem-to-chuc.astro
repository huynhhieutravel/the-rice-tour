---
import BaseLayout from '@/layouts/BaseLayout.astro';
import '@/styles/global.css';

// Tối ưu SEO cho trang
const title = "Địa Điểm Tổ Chức Tour Doanh Nghiệp & Incentive Travel | FIT Tour";
const description = "Lựa chọn điểm đến tổ chức MICE, Team Building và Corporate Retreat đẳng cấp tại Việt Nam và Quốc tế để gắn kết đội ngũ doanh nghiệp cùng FIT Tour.";

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Trang chủ",
      "item": "https://thericetour.com"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Tour Doanh Nghiệp",
      "item": "https://thericetour.com/tour-doanh-nghiep"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": "Địa Điểm Tổ Chức",
      "item": "https://thericetour.com/dia-diem-to-chuc"
    }
  ]
};

// Dữ liệu Curated Locations
const locations = [
  {
    region: "Việt Nam",
    id: "vietnam",
    description: "Biển xanh vẫy gọi và những resort nghỉ dưỡng đẳng cấp ngay tại Việt Nam, mang đến trải nghiệm thuận tiện và tối ưu chi phí cho hành trình gắn kết của doanh nghiệp.",
    coverImage: "https://media.fittour.vn/wp-content/uploads/2022/01/Gala-Dinner-Co%CC%82ng-ty-chu%CC%9B%CC%81ng-khoa%CC%81n-Mirae-Asset.jpg",
    items: [
      { name: "Phan Thiết", country: "Việt Nam", image: "https://media.fittour.vn/uploads/hanh-trinh-03-cong-tac-chuan-bi-khoi-hanh.webp", link: "/dia-diem-to-chuc-phan-thiet", hot: true },
      { name: "Phú Quốc", country: "Việt Nam", image: "https://media.fittour.vn/uploads/2022/07/doan-khach-goodride-kham-pha-chua-ho-quoc-phu-quoc.webp", link: "/dia-diem-to-chuc-phu-quoc", hot: true },
      { name: "Hồ Tràm", country: "Việt Nam", image: "https://media.fittour.vn/uploads/2022/07/nhan-vien-relia-check-in-ho-tram.webp", link: "/dia-diem-to-chuc-ho-tram", hot: true },
      { name: "Đà Nẵng", country: "Việt Nam", image: "https://media.fittour.vn/uploads/2023/04/marble-design-retreat-o-Da-Nang-fittour.webp", link: "/dia-diem-to-chuc-da-nang", hot: true },
      { name: "Nha Trang", country: "Việt Nam", image: "https://media.fittour.vn/uploads/toan-canh-vinh-vinh-hy-ninh-thuan.webp", link: "/dia-diem-to-chuc-nha-trang" },
    ]
  },
  {
    region: "Đông Nam Á",
    id: "dong-nam-a",
    description: "Đắm chìm trong văn hóa đặc sắc và thiên nhiên kỳ vĩ của Đông Nam Á, lý tưởng cho những chuyến phiêu lưu gắn kết.",
    coverImage: "https://media.fittour.vn/uploads/2025/08/nhat-ky-motor-trip-thai-lan-chiang-mai-fittour.webp",
    items: [
      { name: "Thái Lan", country: "Đông Nam Á", image: "https://media.fittour.vn/uploads/dia-diem-thai-lan.webp", link: "/dia-diem-to-chuc-thai-lan", hot: true },
      { name: "Bali", country: "Indonesia", image: "https://media.fittour.vn/uploads/dia-diem-bali.webp", link: "/dia-diem-to-chuc-bali", hot: true },
    ]
  },
  {
    region: "Châu Á & Quốc Tế",
    id: "quoc-te",
    description: "Vượt ra khỏi mọi ranh giới, khám phá những nền văn hóa lâu đời và sự phát triển vượt bậc tại Châu Á cùng thế giới.",
    coverImage: "https://media.fittour.vn/uploads/2024/12/company-trip-giang-nam-fit-tour.webp",
    items: [
      { name: "Giang Nam", country: "Trung Quốc", image: "https://media.fittour.vn/uploads/dia-diem-giang-nam.webp", link: "/dia-diem-to-chuc-giang-nam", hot: true },
      { name: "Nhật Bản", country: "Nhật Bản", image: "https://media.fittour.vn/uploads/dia-diem-nhat-ban.webp", link: "/dia-diem-to-chuc-nhat-ban", hot: true },
      { name: "Đài Loan", country: "Đài Loan", image: "https://media.fittour.vn/uploads/dia-diem-dai-loan.webp", link: "/dia-diem-to-chuc-dai-loan" }
    ]
  }
];
---

<BaseLayout title={title} description={description} isCorporate={true}>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} slot="head" />
  {/* Hero Banner Section */}
  <section class="relative w-full h-[60vh] md:h-[70vh] min-h-[500px] flex items-center justify-center overflow-hidden">
    {/* Dark Overlay for text readability */}
    <div class="absolute inset-0 bg-slate-900/60 z-10"></div>
    
    {/* Background Image */}
    <img 
      src="https://media.fittour.vn/uploads/2026/03/fit-tour-elite-operations-executive-program-briefing-bosch-nha-trang.webp" 
      alt="Corporate Retreats"
      class="absolute inset-0 w-full h-full object-cover z-0"
      fetchpriority="high"
    />
    
    {/* Hero Content */}
    <div class="relative z-20 text-center px-4 max-w-4xl mx-auto mt-16 md:mt-24">
      <h2 class="text-brand-400 font-bold tracking-widest uppercase text-sm md:text-base mb-4">Các Điểm Đến Tuyển Chọn</h2>
      <h1 class="text-4xl md:text-6xl font-bold text-white leading-tight mb-6 text-shadow-sm">
        Địa Điểm Tổ Chức Sự Kiện<br class="hidden md:block" /> & Team Building
      </h1>
      <p class="text-lg md:text-xl text-slate-200 font-light max-w-2xl mx-auto mb-10 text-shadow-sm leading-relaxed">
        Lựa chọn điểm đến hoàn hảo tại những khu nghỉ dưỡng và thành phố hàng đầu thế giới để gắn kết đội ngũ, kiến tạo những kỷ niệm khó quên.
      </p>
      
      <div class="flex flex-wrap justify-center gap-4">
        <a href="#vietnam" class="px-8 py-3.5 bg-brand-600 hover:bg-brand-700 text-white font-bold rounded-full transition-all shadow-lg hover:-translate-y-1">
          Khám Phá Ngay
        </a>
      </div>
    </div>
  </section>

  {/* Sticky Navigation Tabs */}
  <nav class="sticky top-[72px] z-40 bg-white shadow-sm hidden md:block border-b border-slate-200">
    <div class="max-w-[1200px] mx-auto px-4">
      <ul class="flex items-center justify-center gap-8 text-sm font-bold uppercase tracking-wider">
        {locations.map(region => (
          <li>
            <a href={`#${region.id}`} class="block py-4 text-slate-500 hover:text-brand-600 transition-colors border-b-2 border-transparent hover:border-brand-600">
              {region.region}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </nav>

  {/* Locations Sections */}
  <div class="bg-slate-50 pb-16 md:pb-24">
    {locations.map((region) => (
      <section id={region.id} class="relative scroll-mt-20">
        {/* Full-width Region Cover */}
        <div class="relative w-full h-[400px] md:h-[500px] flex items-center justify-center overflow-hidden">
          <div class="absolute inset-0 bg-slate-900/65 z-10"></div>
          <img 
            src={region.coverImage} 
            alt={region.region}
            class="absolute inset-0 w-full h-full object-cover z-0"
            loading="lazy"
          />
          <div class="relative z-20 text-center px-4 max-w-4xl mx-auto -mt-20">
            <h2 class="text-4xl md:text-5xl font-bold text-white mb-6 text-shadow-sm">{region.region}</h2>
            <p class="text-slate-200 text-lg md:text-xl font-light leading-relaxed max-w-3xl mx-auto text-shadow-sm">
              {region.description}
            </p>
          </div>
        </div>

        {/* Overlapping Grid Container */}
        <div class="relative z-30 w-full bg-white -mt-16 pt-12 pb-16 shadow-[0_-10px_30px_rgba(0,0,0,0.05)]">
          <div class="max-w-[1200px] mx-auto px-4 md:px-8">
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
              {region.items.map(item => (
                <a href={item.link} class="group relative block aspect-video rounded-[24px] overflow-hidden shadow-md hover:shadow-xl transition-all duration-300">
                  {/* Background Image with Zoom Effect */}
                  <div class="absolute inset-0 overflow-hidden">
                    <img 
                      src={item.image} 
                      alt={`Tổ chức tour doanh nghiệp tại ${item.name}`}
                      class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                      loading="lazy"
                    />
                  </div>
                  
                  {/* Gradient Overlay */}
                  <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent opacity-80 group-hover:opacity-90 transition-opacity"></div>
                  
                  {/* Text Content */}
                  <div class="absolute bottom-0 left-0 p-6 md:p-8 w-full transform transition-transform duration-300 group-hover:-translate-y-1">
                    <h3 class="text-white text-2xl font-bold mb-1">{item.name}, <span class="text-slate-300 text-base font-medium">{item.country}</span></h3>
                  </div>
                </a>
              ))}
            </div>

            {/* Discover More Button */}
            <div class="mt-12 flex justify-center">
              <a href="/hanh-trinh-doanh-nghiep" class="px-8 py-3.5 border border-slate-400 text-slate-700 font-medium hover:bg-slate-50 transition-colors bg-white rounded-md flex items-center gap-2">
                Khám phá thêm
              </a>
            </div>
          </div>
        </div>
      </section>
    ))}
  </div>

  {/* Truyền thông nói về FIT Tour */}
  <section class="py-16 md:py-24 bg-white">
    <div class="max-w-[1000px] mx-auto px-4 md:px-8">
      <h2 class="text-3xl md:text-4xl font-bold text-slate-900 mb-6">Truyền thông nói về FIT Tour</h2>
      <p class="text-slate-600 text-lg mb-12 leading-relaxed">
        FIT Tour với những giải thưởng (minh chứng cho năng lực thiết kế), hay Quản trị rủi ro vận hành qua các biến động chiến tranh. Tất cả tạo nên bức tranh về Năng lực mà chúng tôi tự hào. Dù thành công, hay thất bại thì FIT Tour vẫn viết tiếp câu chuyện cùng Khách hàng của mình.
      </p>

      <div class="space-y-10">
        <div>
          <h3 class="text-xl font-bold text-slate-900 mb-4">VnExpress:</h3>
          <ul class="space-y-4">
            <li class="flex items-start gap-3">
              <span class="text-brand-500 mt-1">►</span>
              <a href="https://vnexpress.net/fit-tour-hai-nam-lien-tiep-thang-giai-tour-thiet-ke-rieng-4648753.html" target="_blank" rel="nofollow" class="text-brand-600 hover:text-brand-800 transition-colors font-medium">Fit Tour hai năm liên tiếp thắng giải 'Tour thiết kế riêng'</a>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-brand-500 mt-1">►</span>
              <a href="https://vnexpress.net/doanh-nghiep-viet-dung-loat-tour-gia-100-trieu-dong-di-israel-4662990.html" target="_blank" rel="nofollow" class="text-brand-600 hover:text-brand-800 transition-colors font-medium">FIT Tour dừng loạt tour giá tới 100 triệu đồng đi Israel, Iran năm 2022</a>
            </li>
          </ul>
        </div>
        <div>
          <h3 class="text-xl font-bold text-slate-900 mb-4">Kênh 14:</h3>
          <ul class="space-y-4">
            <li class="flex items-start gap-3">
              <span class="text-brand-500 mt-1">►</span>
              <a href="https://kenh14.vn/huy-tour-hon-100-trieu-khach-viet-va-cac-don-vi-lu-hanh-uu-tien-an-toan-giua-cang-thang-trung-dong-215260301213959619.chn" target="_blank" rel="nofollow" class="text-brand-600 hover:text-brand-800 transition-colors font-medium">FIT Tour ưu tiên khách hàng khi hủy loạt Tour 100 triệu mỗi khách, dù đã book Lịch khởi hành. (2026)</a>
            </li>
          </ul>
        </div>
        <div>
          <h3 class="text-xl font-bold text-slate-900 mb-4">Tiền Phong:</h3>
          <ul class="space-y-4">
            <li class="flex items-start gap-3">
              <span class="text-brand-500 mt-1">►</span>
              <a href="https://tienphong.vn/huy-tour-du-lich-san-bay-dong-cua-khach-viet-o-trung-dong-ra-sao-post1823999.tpo" target="_blank" rel="nofollow" class="text-brand-600 hover:text-brand-800 transition-colors font-medium">FIT Tour ngưng khai thác Tour Pakistan dù đã chốt vé cùng du khách do biến động chính trị</a>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  {/* Cách thức hoạt động */}
  <section class="py-16 md:py-24 bg-slate-900 text-white">
    <div class="max-w-[1200px] mx-auto px-4 md:px-8">
      <div class="text-center mb-16">
        <div class="text-slate-400 text-sm font-bold tracking-widest uppercase mb-4">Quá trình</div>
        <h2 class="text-3xl md:text-5xl font-bold">Cách thức hoạt động</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {/* Step 1 */}
        <div class="bg-slate-800 rounded-2xl p-8 border border-slate-700/50 hover:border-slate-600 transition-colors">
          <div class="text-brand-400 text-sm font-bold tracking-wider mb-4 uppercase">Bước 1</div>
          <h3 class="text-2xl font-bold mb-4">Cuộc gọi giới thiệu</h3>
          <p class="text-slate-400 leading-relaxed text-sm lg:text-base">
            Mỗi chương trình đều bắt đầu bằng một cuộc gọi điện thoại. Chúng ta sẽ thảo luận về mục tiêu của bạn, đặt một vài câu hỏi và cùng đưa ra ý tưởng ban đầu. Chúng tôi sẽ giải thích cách thức hoạt động và cách chúng tôi có thể giúp đỡ. Sau đó, chúng tôi sẽ gửi bản tóm tắt qua email và bắt đầu lập đề xuất.
          </p>
        </div>
        
        {/* Step 2 */}
        <div class="bg-slate-800 rounded-2xl p-8 border border-slate-700/50 hover:border-slate-600 transition-colors">
          <div class="text-brand-400 text-sm font-bold tracking-wider mb-4 uppercase">Bước 2</div>
          <h3 class="text-2xl font-bold mb-1">Nghiên cứu & Đề xuất</h3>
          <div class="text-slate-400 text-sm mb-4">(Miễn phí)</div>
          <p class="text-slate-400 leading-relaxed text-sm lg:text-base">
            Chúng tôi tin rằng việc hiểu rõ đối tác trước khi chi tiền là rất quan trọng. Chúng tôi sẽ chuẩn bị một bản đề xuất miễn phí với 3-5 lựa chọn địa điểm nghỉ dưỡng, khách sạn, hoạt động. Bạn sẽ chọn ra 3 địa điểm ưng ý nhất để chúng tôi lập dự toán sơ bộ so sánh.
          </p>
        </div>

        {/* Step 3 */}
        <div class="bg-slate-800 rounded-2xl p-8 border border-slate-700/50 hover:border-slate-600 transition-colors">
          <div class="text-brand-400 text-sm font-bold tracking-wider mb-4 uppercase">Bước 3</div>
          <h3 class="text-2xl font-bold mb-4">Thư cam kết & Ý tưởng</h3>
          <p class="text-slate-400 leading-relaxed text-sm lg:text-base">
            Nếu bạn muốn tiến xa hơn, chúng ta sẽ ký một thỏa thuận đơn giản và đặt cọc một khoản nhỏ. Bạn sẽ chọn lựa chọn ưu tiên hàng đầu, sau đó chúng tôi sẽ thương lượng các điều khoản và giá cả tốt nhất có thể để hoàn thiện lịch trình cụ thể và ngân sách tương ứng.
          </p>
        </div>

        {/* Step 4 */}
        <div class="bg-slate-800 rounded-2xl p-8 border border-slate-700/50 hover:border-slate-600 transition-colors">
          <div class="text-brand-400 text-sm font-bold tracking-wider mb-4 uppercase">Bước 4</div>
          <h3 class="text-2xl font-bold mb-4">Giai đoạn hợp đồng</h3>
          <p class="text-slate-400 leading-relaxed text-sm lg:text-base">
            Hai bên sẽ thống nhất các điều khoản chi tiết, ký kết hợp đồng dịch vụ chính thức và tiến hành các thủ tục thanh toán theo tiến độ đã thỏa thuận để đảm bảo việc giữ chỗ các dịch vụ với giá và chất lượng tốt nhất.
          </p>
        </div>

        {/* Step 5 */}
        <div class="bg-slate-800 rounded-2xl p-8 border border-slate-700/50 hover:border-slate-600 transition-colors">
          <div class="text-brand-400 text-sm font-bold tracking-wider mb-4 uppercase">Bước 5</div>
          <h3 class="text-2xl font-bold mb-4">Giai đoạn lập kế hoạch</h3>
          <p class="text-slate-400 leading-relaxed text-sm lg:text-base">
            Đội ngũ điều hành của FIT Tour sẽ lên chi tiết lịch trình từng ngày, đặt dịch vụ phòng, vé máy bay, nhà hàng và chuẩn bị các kịch bản tổ chức Team Building, Gala Dinner độc đáo cho đoàn.
          </p>
        </div>

        {/* Step 6 */}
        <div class="bg-slate-800 rounded-2xl p-8 border border-slate-700/50 hover:border-slate-600 transition-colors">
          <div class="text-brand-400 text-sm font-bold tracking-wider mb-4 uppercase">Bước 6</div>
          <h3 class="text-2xl font-bold mb-4">Thi công tại chỗ</h3>
          <p class="text-slate-400 leading-relaxed text-sm lg:text-base">
            Đội ngũ hướng dẫn viên và ban tổ chức của FIT Tour sẽ trực tiếp có mặt tại điểm đến để điều hành, giám sát và đảm bảo mọi hoạt động diễn ra suôn sẻ, mang lại trải nghiệm hoàn hảo và gắn kết nhất.
          </p>
        </div>
      </div>
    </div>
  </section>

  {/* CTA Section */}
  <section class="py-16 md:py-24 bg-slate-50">
    <div class="max-w-[1080px] mx-auto px-4 md:px-8">
      <div class="bg-white rounded-[24px] lg:rounded-[32px] overflow-hidden shadow-[0_8px_30px_rgb(0,0,0,0.04)] flex flex-col lg:flex-row">
        <div class="w-full lg:w-1/2 p-8 lg:p-12 xl:p-14 flex flex-col justify-center">
          <div class="text-slate-500 text-xs font-bold tracking-widest uppercase mb-3">Lên kế hoạch cho chuyến đi nghỉ dưỡng của công ty</div>
          <p class="text-slate-600 text-[15px] leading-relaxed mb-8 font-normal">
            Bạn đang căng thẳng vì phải lên kế hoạch cho một chuyến đi nghỉ dưỡng mà không có nhiều thời gian? Tại sao bạn không để chúng tôi giúp bạn giảm bớt gánh nặng trước, và lập một bản đề xuất miễn phí bao gồm các địa điểm, hoạt động và chi phí lý tưởng cho chuyến đi sắp tới của bạn.
          </p>
          
          <div class="flex flex-col sm:flex-row gap-3">
            <a href="https://zalo.me/fittour.vn/bu3" target="_blank" class="inline-flex items-center justify-center px-6 py-3.5 bg-[#0068FF] text-white font-semibold rounded-[10px] hover:bg-blue-700 transition-all gap-2.5 shadow-sm hover:shadow-md text-[15px]">
              <div class="w-5 h-5 rounded-full bg-white flex items-center justify-center">
                <img src="/icons/zalo.svg" alt="Zalo" class="w-3.5 h-3.5" onerror="this.src='https://upload.wikimedia.org/wikipedia/commons/9/91/Icon_of_Zalo.svg'; this.style.filter='brightness(0) invert(1)'; this.parentElement.style.background='transparent'" />
              </div>
              Nhắn tin Zalo
            </a>
            <a href="mailto:info@fittour.com.vn" class="inline-flex items-center justify-center px-6 py-3.5 bg-slate-800 text-white font-semibold rounded-[10px] hover:bg-slate-900 transition-all gap-2.5 shadow-sm hover:shadow-md text-[15px]">
              <svg class="w-5 h-5 opacity-90" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
              Gửi Email
            </a>
          </div>
        </div>
        
        <div class="w-full lg:w-1/2 min-h-[300px] lg:min-h-auto">
          <img 
            src="https://media.fittour.vn/uploads/2026/03/fit-tour-elite-operations-executive-program-briefing-bosch-nha-trang.webp" 
