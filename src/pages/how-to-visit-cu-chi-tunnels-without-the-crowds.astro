---
import { env } from 'cloudflare:workers';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { safeQueryCritical } from '@/lib/db-client';
import { getGlobalSettings } from '@/lib/settingsHelper';
import JsonLdSchema from '@/components/seo/JsonLdSchema.astro';

// --- SSR D1 DATABASE QUERY ---
const currentSlug = 'how-to-visit-cu-chi-tunnels-without-the-crowds';

const d1Db = env?.dulichcoguu_d1 || (Astro.locals as any)?.runtime?.env?.dulichcoguu_d1;
let post: any = null;
try {
  if (d1Db) {
    post = await safeQueryCritical(
      d1Db.prepare("SELECT * FROM Post WHERE slug = ? AND (status = 'published' OR status = 'publish')").bind(currentSlug).first<any>(),
      { route: Astro.url.pathname, slug: currentSlug, queryType: "fetch_post_by_slug" }
    );
  }
} catch (e) {
  console.warn('[D1 Query Warning] how-to-visit-cu-chi-tunnels-without-the-crowds:', e);
}

// Fallback metadata if D1 local/remote is not yet populated
if (!post) {
  post = {
    id: 19806,
    title: 'How to Visit Cu Chi Tunnels Without the Crowds: 5 Insider Strategies',
    slug: currentSlug,
    excerpt: 'A practical guide to timing, choosing between Ben Dinh and Ben Duoc, and planning a more relaxed visit from Ho Chi Minh City.',
    featuredImage: 'https://media.thericetour.com/uploads/group-posing-secret-tunnel-entrance-leaves-cu-chi-1280x720.webp',
    readingTime: 12,
    author: 'The Rice Tour Editorial',
    createdAt: '2026-09-16T08:00:00.000Z',
    publishedAt: '2026-09-16T08:00:00.000Z',
    updatedAt: '2026-09-16T08:00:00.000Z'
  };
}

const { settings } = await getGlobalSettings();

const pageTitle = post?.title || 'How to Visit Cu Chi Tunnels Without the Crowds: 5 Insider Strategies';
const pageDesc = 'A practical guide to timing, choosing between Ben Dinh and Ben Duoc, and planning a more relaxed visit from Ho Chi Minh City.';

const seoTitle = post?.seoTitle || post?.metaTitle || post?.title || pageTitle;
const seoDesc = 'Avoid tourist buses and crowded corridors at Cu Chi Tunnels. Discover practical arrival windows, compare Ben Dinh and Ben Duoc, and plan a relaxed visit from Ho Chi Minh City.';
const seoImage = post?.ogImage || post?.featuredImage || 'https://media.thericetour.com/uploads/group-posing-secret-tunnel-entrance-leaves-cu-chi-1280x720.webp';

// --- DATE LOGIC (E-E-A-T Compliant) ---
const createdAtStr = post.createdAt || post.publishedAt || '2026-09-16T08:00:00.000Z';
const updatedAtStr = post.updatedAt || '2026-09-16T08:00:00.000Z';

const createdAt = new Date(createdAtStr.replace(' ', 'T'));
const updatedAt = new Date(updatedAtStr.replace(' ', 'T'));

const isUpdated = updatedAt.getTime() - createdAt.getTime() > 86400000;
const displayDate = isUpdated ? updatedAt : createdAt;
const datePrefix = isUpdated ? "Updated:" : "Published:";
const formattedDate = displayDate.toLocaleDateString('en-US', { day: 'numeric', month: 'long', year: 'numeric' });

// --- AUTHOR LOGIC ---
const authorMap: Record<string, any> = {
  "The Rice Tour Editorial": {
    name: "The Rice Tour Editorial",
    url: "/about-us",
    img: "https://media.thericetour.com/uploads/the-rice-tour-editorial-avatar.webp"
  },
  "Huynh Hieu Travel": {
    name: "Huynh Hieu Travel",
    url: "/about-us",
    img: "https://media.thericetour.com/uploads/huynhhieutravel.webp"
  }
};
const authorData = authorMap[post.author] || authorMap["The Rice Tour Editorial"];

const adminEditUrl = post.id && post.id !== 19806 ? `/admin/posts/edit?id=${post.id}` : '#';

// TOC Navigation Structure
const toc = [
  { id: "gioi-thieu", title: "Introduction", icon: "🏠" },
  { id: "strategy-1-early-departure", title: "1. Early Morning Timing & Route Buffers", icon: "🌅" },
  { id: "strategy-2-ben-duoc", title: "2. Choosing Between Ben Dinh & Ben Duoc", icon: "🌿" },
  { id: "strategy-3-afternoon-inversion", title: "3. A Useful Afternoon Departure Window", icon: "🌤️" },
  { id: "strategy-4-private-transport", title: "4. Transport Options & Route Flexibility", icon: "🚗" },
  { id: "strategy-5-zero-shopping", title: "5. Prioritising Direct Travel (No Shopping Stops)", icon: "🚫" },
  { id: "hour-by-hour-matrix", title: "Practical Crowd Planning Matrix", icon: "📊" },
  { id: "what-is-original", title: "What Is Actually Original at Cu Chi?", icon: "🏛️" },
  { id: "above-vs-below-ground", title: "Above vs. Below Ground & Tunnel Dimensions", icon: "🛡️" },
  { id: "visiting-without-a-tour", title: "Can You Visit Without a Tour?", icon: "🧭" },
  { id: "2026-ticket-prices-logistics", title: "Practical Information for Visiting Cu Chi", icon: "🎟️" },
  { id: "frequently-asked-questions", title: "Frequently Asked Questions (FAQ)", icon: "💡" },
  { id: "epilogue", title: "Epilogue: Preserving the Historical Experience", icon: "✨" }
];

// SSR JSON-LD Schemas
const currentOrigin = 'https://thericetour.com';
const canonicalUrl = `${currentOrigin}/${currentSlug}`;

const breadcrumbSchema = {
  items: [
    { name: "Home", url: `${currentOrigin}/` },
    { name: "Travel Guides", url: `${currentOrigin}/blog` },
    { name: pageTitle, url: canonicalUrl }
  ]
};

const faqSchema = {
  questions: [
    {
      question: "Which Cu Chi Tunnels site is genuinely less crowded: Ben Dinh or Ben Duoc?",
      answer: "Ben Duoc is consistently quieter. Located roughly 70 km northwest of Saigon (about 20 km past Ben Dinh), its greater distance discourages large 45-seat commercial tour buses. Aside from preserved multi-level tunnels, Ben Duoc features the Ben Duoc Memorial Temple and the Recreated Liberation Zone spread over peaceful riverside forest. Ben Dinh is closer (~50 km) and absorbs the bulk of budget group tours, making it noticeably crowded between 09:30 AM and midday."
    },
    {
      question: "What is the best time of day to arrive at Cu Chi Tunnels to avoid tour groups?",
      answer: "Arrive between 07:00 and 08:30 AM (gates open at 07:00 AM). Leaving central Saigon by 06:30 AM allows you to clear the highway before commuter rush hour builds up, putting you on the quiet forest trails before tour buses arrive. A secondary quiet window begins around 01:30 PM, after morning tour groups depart for lunch."
    },
    {
      question: "Is Ben Dinh a 'fake' version of the tunnels compared to Ben Duoc?",
      answer: "No. Ben Dinh is authentic wartime heritage, not a reproduction. In its July 2026 submission to the UNESCO Tentative List, Vietnam identified both Ben Dinh and Ben Duoc as the two primary sectors preserving the authentic structure, scale, and three-tier depth of the surviving network (~4 km preserved in total). Both sites have subtly reinforced and lit visitor sections. The main difference is that Ben Dinh draws far heavier tour traffic, while Ben Duoc offers a more spacious, tranquil forest setting."
    },
    {
      question: "Can you visit Cu Chi Tunnels without booking an organized tour?",
      answer: "Yes. You can travel independently by hiring a private car or booking a Grab car. Every admission ticket includes an official English-speaking on-site guide who escorts you through the outdoor displays and tunnels. The main challenge is securing a return ride back to Saigon from rural Cu Chi, so hiring a private car with round-trip waiting time is strongly recommended."
    },
    {
      question: "Can claustrophobic travelers visit Cu Chi Tunnels comfortably without going underground?",
      answer: "Yes, easily. Roughly 85 to 90 percent of the visit is entirely above ground in shaded woodland. You can examine camouflaged trapdoors, explore booby-trap displays, see the Hoang Cam smokeless kitchen, watch historical documentary film, and walk the trails without ever stepping into a tunnel. Entry into the tunnels is 100% optional."
    },
    {
      question: "What are the official admission fees for visiting Cu Chi Tunnels in 2026?",
      answer: "For international visitors, the official admission is 135,000 VND per person (effective February 1, 2026), consisting of 35,000 VND relic entrance fee plus 100,000 VND guide and service fee. Always check the official website before travelling in case of updates."
    },
    {
      question: "How long does a half-day private Cu Chi Tunnels visit take from central Ho Chi Minh City?",
      answer: "Plan on 5 to 6 hours door-to-door. Driving time is roughly 1.5 hours each way to Ben Dinh, or 1.5 to 2 hours to Ben Duoc depending on morning traffic, plus 2 to 2.5 hours on-site exploring the grounds and exhibits."
    },
    {
      question: "Can I use Grab or ride-hailing services to visit Cu Chi Tunnels?",
      answer: "You can easily catch a Grab from downtown Saigon to Cu Chi, but finding a return driver from rural Cu Chi (especially Ben Duoc, 70 km out) is notoriously unreliable. Booking a private car for the round trip with driver waiting time included avoids the risk of being stranded."
    },
    {
      question: "Is the traditional boiled cassava snack provided during the visit?",
      answer: "Yes. Every ticket includes a serving of freshly steamed cassava dipped in crushed peanuts, sesame, and salt, served alongside hot tea at the Hoang Cam kitchen pavilion."
    },
    {
      question: "What should I wear and pack for a visit to Cu Chi Tunnels?",
      answer: "Wear lightweight, breathable clothing and closed-toe walking shoes suitable for forest dirt paths. Bring mosquito repellent, sunscreen, a hat, and plenty of water. If you plan to crawl through the tunnels, wear darker clothes you don't mind getting dusty."
    },
    {
      question: "Is the Cu Chi Tunnels site suitable for seniors and young children?",
      answer: "Yes. Because going underground is completely optional, seniors and children can comfortably explore the shaded woodland trails and open-air exhibits. Ben Duoc also offers open grounds, wide paths, and on-site electric shuttle carts for visitors needing mobility assistance."
    }
  ]
};
---

<BaseLayout 
  title={seoTitle} 
  description={seoDesc} 
  image={seoImage}
  canonical={canonicalUrl}
  preloadImages={[seoImage]}
  adminEditUrl={adminEditUrl}
  lang="en"
  ogType="article"
>
  <Fragment slot="schema">
    <JsonLdSchema type="breadcrumb" data={breadcrumbSchema} />
    <JsonLdSchema type="faq" data={faqSchema} />
  </Fragment>

  <div class="bg-[#F8F9FA] text-[#1E293B] font-sans antialiased selection:bg-[#F7931E] selection:text-white">

    {/* ================= HERO SECTION ================= */}
    <section class="relative w-full min-h-[580px] lg:min-h-[660px] overflow-hidden flex flex-col justify-center pt-32 pb-20">
      <div class="absolute inset-0 z-0 bg-slate-950">
        <img 
          src={seoImage} 
          alt={pageTitle} 
          class="w-full h-full object-cover object-center opacity-85" 
          width="1280" 
          height="720"
          fetchpriority="high" 
          loading="eager" 
          decoding="async" 
        />
        <div class="absolute inset-0 bg-gradient-to-r from-black/80 via-black/55 to-black/30"></div>
        <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/30 to-transparent"></div>
      </div>

      <div class="relative z-10 max-w-[1600px] mx-auto px-4 sm:px-6 lg:px-12 w-full">
        
        {/* Breadcrumb - Standard 3-level breadcrumb */}
        <div class="flex items-center gap-2 text-[13px] text-white/70 font-medium mb-6 flex-wrap">
          <a href="/" class="hover:text-white transition-colors">Home</a>
          <svg class="w-3 h-3 text-white/40" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
          <a href="/blog" class="hover:text-white transition-colors">Travel Guides</a>
          <svg class="w-3 h-3 text-white/40" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
          <span class="text-white font-semibold line-clamp-1">{pageTitle}</span>
        </div>

        {/* Titles */}
        <h1 class="font-serif text-3xl sm:text-4xl lg:text-5xl xl:text-6xl font-bold text-white mb-4 leading-[1.15] drop-shadow-lg max-w-5xl">
          {pageTitle}
        </h1>
        <h2 class="font-serif text-lg sm:text-2xl lg:text-3xl text-amber-400 italic mb-8 max-w-4xl drop-shadow-md font-medium">
          {pageDesc}
        </h2>

        {/* Author / Date / Time Row */}
        <div class="flex flex-wrap items-center gap-4 sm:gap-6 text-sm text-white/80 border-t border-white/20 pt-6 max-w-3xl">
          <a href={authorData.url} class="flex items-center gap-3 group">
            <div class="w-10 h-10 rounded-full border-2 border-white/30 bg-amber-500/30 flex items-center justify-center font-serif text-amber-300 font-bold text-lg group-hover:border-amber-400 transition-colors">
              R
            </div>
            <span class="font-bold text-white group-hover:text-amber-400 transition-colors flex items-center gap-1.5">
              {authorData.name} 
              <svg class="w-4 h-4 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            </span>
          </a>
          
          <div class="flex items-center gap-2 bg-white/10 px-4 py-2 rounded-full backdrop-blur-sm border border-white/10">
            <svg class="w-4 h-4 opacity-70" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
            <span>{datePrefix} {formattedDate}</span>
          </div>

          <div class="flex items-center gap-2 bg-black/40 px-4 py-2 rounded-full backdrop-blur-sm border border-white/10">
            <svg class="w-4 h-4 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            <span>{post.readingTime} min read</span>
          </div>
        </div>

        {/* Badges */}
        <div class="flex flex-wrap gap-3 mt-8">
          <div class="flex items-center gap-2 text-xs sm:text-sm text-white font-medium bg-black/60 backdrop-blur-md px-3.5 py-2 border border-white/10 rounded-lg shadow-xl">
            <span class="text-amber-400 text-base">🌅</span> Early Arrival Strategy
          </div>
          <div class="flex items-center gap-2 text-xs sm:text-sm text-white font-medium bg-black/60 backdrop-blur-md px-3.5 py-2 border border-white/10 rounded-lg shadow-xl">
            <span class="text-amber-400 text-base">🌿</span> Ben Duoc Forest Sector
          </div>
          <div class="flex items-center gap-2 text-xs sm:text-sm text-white font-medium bg-black/60 backdrop-blur-md px-3.5 py-2 border border-white/10 rounded-lg shadow-xl">
            <span class="text-amber-400 text-base">🚗</span> Direct Private Travel
          </div>
          <div class="flex items-center gap-2 text-xs sm:text-sm text-white font-medium bg-black/60 backdrop-blur-md px-3.5 py-2 border border-white/10 rounded-lg shadow-xl">
            <span class="text-amber-400 text-base">🏛️</span> Preserved Heritage
          </div>
        </div>

      </div>
    </section>

    {/* ================= MAIN CONTENT GRID ================= */}
    <div class="max-w-[1600px] mx-auto px-4 sm:px-6 lg:px-12 py-12 lg:py-16">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-start">

        {/* ---------------- LEFT SIDEBAR (TOC) ---------------- */}
        <aside class="hidden lg:block lg:col-span-3 sticky top-24">
          <div class="bg-white rounded-2xl shadow-sm border border-slate-200/60 p-6 overflow-hidden">
            <div class="flex items-center gap-2 font-bold text-slate-900 mb-5 border-l-4 border-amber-500 pl-3 text-sm tracking-wide uppercase">
              Table of Contents
            </div>
            
            <nav class="space-y-1 text-[13.5px] font-medium max-h-[calc(100vh-200px)] overflow-y-auto pr-1">
              <a href="#gioi-thieu" class="flex items-center gap-2 text-amber-900 bg-amber-50/80 px-3 py-2 rounded-lg transition-colors font-bold">
                <span class="text-amber-600 text-base">🏠</span> Introduction
              </a>
              
              <div class="pt-1.5 space-y-1 border-l border-slate-200 ml-3 pl-3">
                {toc.slice(1).map((item) => (
                  <a 
                    href={`#${item.id}`} 
                    class="block transition-colors leading-tight py-1.5 text-slate-600 hover:text-amber-800 font-semibold text-[13px]"
                  >
                    {item.title}
                  </a>
                ))}
              </div>
            </nav>
          </div>
        </aside>

        {/* ---------------- CENTER COLUMN (MAIN CONTENT) ---------------- */}
        <main class="col-span-1 lg:col-span-6 space-y-10">
          
          {/* Quick Overview Stats Bar (Strictly 3 Items) */}
          <div class="bg-white rounded-2xl shadow-sm border border-slate-200/60 p-5 md:p-6 mb-8">
            <div class="grid grid-cols-1 md:grid-cols-3 divide-y md:divide-y-0 md:divide-x divide-slate-100 gap-4 md:gap-0">
              <div class="flex items-center gap-3.5 md:px-4 first:pl-0 last:pr-0">
                <div class="w-11 h-11 rounded-xl bg-amber-50 flex items-center justify-center text-amber-700 text-xl border border-amber-200/80 shrink-0 shadow-xs">📍</div>
                <div class="min-w-0 flex-1">
                  <div class="text-[10.5px] sm:text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-0.5 leading-tight">Quiet Sector</div>
                  <div class="text-[13.5px] sm:text-[14px] font-bold text-slate-900 leading-snug">Ben Duoc (An Nhơn Tây)</div>
                </div>
              </div>

              <div class="flex items-center gap-3.5 md:px-4 first:pl-0 last:pr-0 pt-3 md:pt-0">
                <div class="w-11 h-11 rounded-xl bg-blue-50 flex items-center justify-center text-blue-700 text-xl border border-blue-200/80 shrink-0 shadow-xs">⏰</div>
                <div class="min-w-0 flex-1">
                  <div class="text-[10.5px] sm:text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-0.5 leading-tight">Optimal Window</div>
                  <div class="text-[13.5px] sm:text-[14px] font-bold text-slate-900 leading-snug">Early Morning (07:00–09:00)</div>
                </div>
              </div>

              <div class="flex items-center gap-3.5 md:px-4 first:pl-0 last:pr-0 pt-3 md:pt-0">
                <div class="w-11 h-11 rounded-xl bg-emerald-50 flex items-center justify-center text-emerald-700 text-xl border border-emerald-200/80 shrink-0 shadow-xs">🚫</div>
                <div class="min-w-0 flex-1">
                  <div class="text-[10.5px] sm:text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-0.5 leading-tight">Routing Focus</div>
                  <div class="text-[13.5px] sm:text-[14px] font-bold text-slate-900 leading-snug">Direct Travel (No Detours)</div>
                </div>
              </div>
            </div>
          </div>

          {/* Section: Giới thiệu */}
          <section id="gioi-thieu" class="scroll-mt-28 space-y-4">
            <div class="prose prose-slate max-w-none prose-p:leading-relaxed prose-p:text-[16px] prose-p:text-slate-700">
              <p>
                Descending into the <strong>Cu Chi Tunnels</strong> (<em>Địa đạo Củ Chi</em>) is one of the most intense encounters with wartime history in Vietnam. Carved by hand through dense laterite clay across decades of conflict, this subterranean network once stretched for hundreds of kilometres beneath the rubber plantations and farmland north of Saigon. Today, alongside downtown wartime landmarks like the <a href="/independence-palace-saigon-guide" class="text-amber-800 hover:text-amber-900 font-semibold underline underline-offset-2 decoration-amber-300">Independence Palace</a>, it remains one of the country's defining historical sites.
              </p>
              
              <div class="font-medium text-slate-900 text-lg border-l-4 border-amber-500 pl-4 my-5 bg-amber-50/50 py-3 rounded-r-xl">
                "For many visitors, though, the day turns into an endurance test with tour crowds: rows of 45-seat buses in the gravel lot, loudspeaker briefings echoing through the trees, and long queues waiting to shuffle single-file into the muggy tunnels."
              </div>

              {/* Featured In-Article Image */}
              <div class="my-6 not-prose">
                <div class="rounded-2xl overflow-hidden shadow-md border border-slate-200">
                  <img 
                    src="https://media.thericetour.com/uploads/tourists-walking-jungle-path-cu-chi-tunnels-checkered-scarf.webp" 
                    alt="Travelers exploring the peaceful forested trail at Ben Duoc Cu Chi Tunnels - The Rice Tour" 
                    class="w-full h-auto object-cover max-h-[500px]" 
                    width="1280" 
                    height="720" 
                    loading="eager" 
                  />
                </div>
                <p class="text-center text-xs sm:text-sm text-slate-500 italic mt-2.5">
                  The forested paths of the Ben Duoc sector, where wider spacing between exhibits creates a more unhurried visit.
                </p>
              </div>

              <p>
                The visitor numbers are staggering. According to Vietnam's 2026 UNESCO submission dossier, the Cu Chi complex had welcomed <strong>over 27 million domestic and international visitors</strong> by the end of 2025. With that volume of foot traffic, visiting without a plan almost guarantees a crowded day. But with thoughtful timing and the right choice between the two main tunnel sectors, your visit can still be quiet, contemplative, and unhurried.
              </p>

              {/* UNESCO 2026 Callout Box */}
              <div class="bg-amber-50/70 border border-amber-300/80 p-5 rounded-2xl my-6 not-prose">
                <div class="flex items-center gap-2.5 text-amber-900 font-bold text-sm sm:text-base mb-2">
                  <span class="text-lg">🏛️</span> A New Heritage Milestone in 2026
                </div>
                <p class="text-xs sm:text-sm text-amber-950/90 leading-relaxed">
                  On July 15, 2026, Vietnam officially submitted the Cu Chi Tunnels to the <strong>UNESCO World Heritage Tentative List</strong>. While full inscription involves a multi-year evaluation, the newly submitted dossier is invaluable: it provides the most precise, up-to-date survey of the surviving tunnel network published in decades.
                </p>
              </div>

              <p>
                A visit here doesn't have to feel like an assembly line. Crowd patterns follow very predictable daily rhythms. By leaving Saigon at the right hour, heading to the less commercial sector, and bypassing highway tourist shops, you can experience the site on your own terms.
              </p>
              <p>
                Here are <strong>5 practical strategies</strong> to visit Cu Chi Tunnels without the crowds.
              </p>
            </div>
          </section>

          <hr class="border-slate-200" />

          {/* STRATEGY 1 */}
          <section id="strategy-1-early-departure" class="scroll-mt-28 space-y-5">
            <div class="border-l-4 border-amber-500 pl-4 mb-4">
              <h2 class="font-serif text-2xl lg:text-[26px] font-bold text-slate-900 leading-tight">
                Strategy 1: Early Morning Timing & Route Buffers
              </h2>
            </div>

            <div class="text-slate-700 text-[15.5px] leading-relaxed space-y-4">
              <p>
                Your departure time from downtown Saigon makes or breaks the morning.
              </p>
              <p>
                Most group tours advertise an "early start," but their buses spend the first 45 to 60 minutes weaving through District 1 collecting passengers from half a dozen hotels. By the time they clear city limits, they hit the morning choke point at An Sương intersection along National Route 22 (QL22), rolling into Cu Chi right alongside twenty other tour groups.
              </p>
              <p>
                To beat that wave, you need to arrive near opening time (the gates open at 07:00 AM daily). That means being on the road early with enough buffer time built into the drive.
              </p>

              {/* Info Box */}
              <div class="bg-amber-50/70 p-5 rounded-2xl border border-amber-200 my-5 space-y-2">
                <div class="flex items-center gap-2 font-bold text-amber-900 text-base">
                  <svg class="w-5 h-5 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                  The Early Morning Advantage
                </div>
                <p class="text-amber-950/90 text-sm leading-relaxed">
                  The 07:00 to 08:30 AM window gives you cool morning air under the forest canopy and quiet dirt paths. You can listen to the birds and take in the forest atmosphere before the midday heat and the tour bus caravans arrive.
                </p>
              </div>

              {/* Grid Schedule */}
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mt-6">
                <div class="bg-white p-5 rounded-xl border border-slate-200 space-y-2 shadow-xs">
                  <div class="flex items-center gap-2 font-bold text-slate-800 text-sm">
