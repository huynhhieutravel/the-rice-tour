                      <th class="p-4 font-bold text-left !text-white text-white w-3/8">Ben Duoc (Bến Dược)</th>
                    </tr>
                  </thead>
                  <tbody class="divide-y divide-slate-100 text-slate-700">
                    <tr class="hover:bg-slate-50/80 transition-colors">
                      <td class="p-4 font-bold text-slate-900">Location</td>
