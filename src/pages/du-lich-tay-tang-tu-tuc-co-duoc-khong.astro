---
import { env } from 'cloudflare:workers';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { safeQueryCritical } from '@/lib/db-client';
import { getGlobalSettings } from '@/lib/settingsHelper';
import { MapPin, Info, Users, Clock, Calendar, Compass, Share2, Link as LinkIcon, ChevronRight, CheckCircle2 } from 'lucide-react';

const d1Db = env?.dulichcoguu_d1;
if (!d1Db) return Astro.rewrite("/500");

// Fetch CMS Data for SEO and Metadata
let post;
try {
  post = await safeQueryCritical(
    d1Db.prepare("SELECT * FROM Post WHERE slug = ? AND (status = 'published' OR status = 'publish')").bind('du-lich-tay-tang-tu-tuc-co-duoc-khong').first<any>(),
    { route: Astro.url.pathname, slug: 'du-lich-tay-tang-tu-tuc-co-duoc-khong', queryType: "fetch_post_by_slug" }
  );
} catch (e) {
  return Astro.rewrite("/500");
}

if (!post) {
  return Astro.rewrite("/404");
}

const { settings } = await getGlobalSettings();

const seoTitle = post.seoTitle || post.title || 'Du Lịch Tây Tạng Tự Túc Có Được Không?';
const seoDesc = post.seoDesc || post.excerpt || 'Tìm hiểu lý do vì sao du lịch Tây Tạng không thể đi tự túc, vai trò của Tibet Travel Permit, các quy định đặc biệt dành cho du khách quốc tế và những điều quan trọng cần biết trước khi lên kế hoạch khám phá vùng đất huyền bí này.';
const seoImage = post.seoImage || post.featuredImage || 'https://media.fittour.vn/uploads/2023/04/cung-dien-Potala-tay-tang.webp';

// --- DATE LOGIC ---
const createdAtStr = post.createdAt || post.publishedAt || new Date().toISOString();
const updatedAtStr = post.updatedAt || createdAtStr;

const createdAt = new Date(createdAtStr.replace(' ', 'T'));
const updatedAt = new Date(updatedAtStr.replace(' ', 'T'));

const isUpdated = updatedAt.getTime() - createdAt.getTime() > 86400000; 
const displayDate = isUpdated ? updatedAt : createdAt;
const datePrefix = isUpdated ? "Cập nhật:" : "Xuất bản:";

const formattedDate = displayDate.toLocaleDateString('vi-VN', { day: '2-digit', month: '2-digit', year: 'numeric' });
// ------------------

const adminEditUrl = `/admin/posts/edit?id=${post.id}`;

---

<BaseLayout 
  title={seoTitle} 
  description={seoDesc} 
  image={seoImage}
  adminEditUrl={adminEditUrl}
>
  <div class="bg-[#F8F9FA] text-[#1E293B] font-sans antialiased selection:bg-[#c89845] selection:text-white">

    {/* ================= HERO SECTION ================= */}
    <section class="relative w-full h-[600px] lg:h-[650px] overflow-hidden">
      <div class="absolute inset-0 z-0 bg-slate-900">
        <img src={seoImage} alt="Du Lịch Tây Tạng Tự Túc" class="w-full h-full object-cover object-center opacity-80" width="1600" height="900" fetchpriority="high" loading="eager" decoding="sync" />
        <div class="absolute inset-0 bg-gradient-to-r from-black/80 via-black/50 to-transparent"></div>
        <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-transparent to-transparent"></div>
      </div>

      <div class="relative z-10 max-w-[1600px] mx-auto px-4 sm:px-6 lg:px-12 h-full flex flex-col justify-center pt-20 pb-16">
        
        {/* Breadcrumb */}
        <div class="flex items-center gap-2 text-[13px] text-white/70 font-medium mb-6">
          <a href="/" class="hover:text-white transition-colors">Trang chủ</a>
          <ChevronRight class="w-3 h-3" />
          <a href="/blog" class="hover:text-white transition-colors">Blog</a>
          <ChevronRight class="w-3 h-3" />
          <span class="text-white">Tây Tạng</span>
        </div>

        {/* Titles */}
        <h1 class="font-serif text-4xl sm:text-5xl lg:text-6xl font-bold text-white mb-4 leading-[1.1] drop-shadow-lg max-w-4xl">
          Du Lịch Tây Tạng Tự Túc Có Được Không?
        </h1>
        <h2 class="font-serif text-xl sm:text-3xl text-amber-400 italic mb-10 max-w-3xl drop-shadow-md">
          Giải Thích Về Giấy Phép Du Lịch Tây Tạng
        </h2>
        <p class="text-white/90 text-base sm:text-lg max-w-2xl leading-relaxed mb-8 hidden md:block drop-shadow-md font-medium">
          Tìm hiểu lý do vì sao du lịch Tây Tạng không thể đi tự túc, vai trò của <strong class="text-amber-400 font-bold">Tibet Travel Permit</strong>, các quy định đặc biệt dành cho du khách quốc tế và những điều quan trọng cần biết trước khi lên kế hoạch khám phá vùng đất huyền bí này.
        </p>

        {/* Author Meta */}
        <div class="flex flex-wrap items-center gap-6 text-sm text-white/80 border-t border-white/20 pt-6 max-w-3xl">
          <a href="/max-vu" class="flex items-center gap-3 group">
            <img src="https://media.fittour.vn/uploads/max-vu-founder-fit-tour.webp" alt="Max Vũ" class="w-10 h-10 rounded-full border-2 border-white/30 object-cover object-top group-hover:border-amber-400 transition-colors" />
            <span class="font-bold text-white group-hover:text-amber-400 transition-colors flex items-center gap-1">
              Max Vũ 
              <CheckCircle2 class="w-4 h-4 text-blue-400" />
            </span>
          </a>
          <div class="flex items-center gap-2 bg-white/10 px-4 py-2 rounded-full backdrop-blur-sm border border-white/10">
            <Calendar class="w-4 h-4 opacity-70" />
            <span>{datePrefix} {formattedDate}</span>
          </div>
          <div class="flex items-center gap-2 bg-black/20 px-3 py-1.5 rounded-full backdrop-blur-sm">
            <Clock class="w-4 h-4 text-amber-400" />
            <span>8 phút đọc</span>
          </div>
        </div>

        {/* Badges Line */}
        <div class="flex flex-wrap items-center gap-4 mt-8 pt-6">
          <div class="flex items-center gap-2 text-sm text-white font-medium bg-black/60 backdrop-blur-md px-4 py-2 border border-white/10 rounded-lg shadow-xl">
            <span class="text-amber-400 text-lg">📝</span> Giấy phép
          </div>
          <div class="flex items-center gap-2 text-sm text-white font-medium bg-black/60 backdrop-blur-md px-4 py-2 border border-white/10 rounded-lg shadow-xl">
            <span class="text-amber-400 text-lg">🧭</span> Hướng dẫn tự túc
          </div>
          <div class="flex items-center gap-2 text-sm text-white font-medium bg-black/60 backdrop-blur-md px-4 py-2 border border-white/10 rounded-lg shadow-xl">
            <span class="text-amber-400 text-lg">⚠️</span> Hiểu lầm phổ biến
          </div>
        </div>

      </div>
    </section>

    {/* ================= MAIN CONTENT GRID ================= */}
    <div class="max-w-[1600px] mx-auto px-4 sm:px-6 lg:px-12 py-12 lg:py-16">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-start">

        {/* ---------------- LEFT SIDEBAR (TOC) ---------------- */}
        <aside class="hidden lg:block lg:col-span-3 sticky top-24">
          <div class="bg-white rounded-2xl shadow-sm border border-slate-200/60 p-6 overflow-hidden">
            <div class="flex items-center gap-2 font-bold text-slate-800 mb-6 border-l-4 border-amber-500 pl-3 text-sm tracking-wide uppercase">
              Mục lục bài viết
            </div>
            
            <nav class="space-y-1 text-[13.5px] font-medium">
              <a href="#gioi-thieu" class="flex items-center gap-2 text-amber-700 bg-amber-50 px-3 py-2.5 rounded-lg transition-colors">
                <span class="text-amber-500 text-base">🏠</span> Giới thiệu
              </a>
              
              <div class="pt-2 pb-1 space-y-2">
                <a href="#cam-tu-tuc" class="flex items-center gap-2 text-slate-700 hover:text-amber-600 px-3 py-1 rounded-lg transition-colors font-bold">
                  Có Thực Sự Cấm Tự Túc?
                </a>
                <a href="#tibet-travel-permit" class="flex items-center gap-2 text-slate-700 hover:text-amber-600 px-3 py-1 rounded-lg transition-colors font-bold">
                  1. Xin Tibet Travel Permit
                </a>
                <a href="#lich-trinh" class="flex items-center gap-2 text-slate-700 hover:text-amber-600 px-3 py-1 rounded-lg transition-colors font-bold">
                  2. Đăng Ký Lịch Trình Trước
                </a>
                <a href="#giay-phep-bo-sung" class="flex items-center gap-2 text-slate-700 hover:text-amber-600 px-3 py-1 rounded-lg transition-colors font-bold">
                  3. Khu Vực Cần Phép Bổ Sung
                </a>
                <a href="#mat-tu-do" class="flex items-center gap-2 text-slate-700 hover:text-amber-600 px-3 py-1 rounded-lg transition-colors font-bold">
                  4. Có Nghĩa Là Mất Tự Do?
                </a>
                <a href="#dieu-nen-biet" class="flex items-center gap-2 text-slate-700 hover:text-amber-600 px-3 py-1 rounded-lg transition-colors font-bold">
                  5. Điều Nên Biết Trước Đi
                </a>
                <a href="#hieu-lam" class="flex items-center gap-2 text-slate-700 hover:text-amber-600 px-3 py-1 rounded-lg transition-colors font-bold">
                  Những Hiểu Lầm Phổ Biến
                </a>
                <a href="#ket-luan" class="flex items-center gap-2 text-slate-700 hover:text-amber-600 px-3 py-1 rounded-lg transition-colors font-bold">
                  Kết Luận & Câu Hỏi
                </a>
              </div>
            </nav>
          </div>
        </aside>


        {/* ---------------- CENTER COLUMN (MAIN CONTENT) ---------------- */}
        <main class="col-span-1 lg:col-span-6 space-y-10">
          
          {/* Quick Overview Stats Bar */}
          <div class="bg-white rounded-2xl shadow-sm border border-slate-200/60 p-6 flex flex-wrap lg:flex-nowrap items-center justify-between gap-4">
            <div class="absolute -top-3 left-6 bg-emerald-500 text-white text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded shadow-sm hidden">Tổng Quan Nhanh</div>
            
            <div class="w-full flex items-center justify-between gap-4 mb-2 lg:hidden">
              <span class="font-bold text-slate-800 text-sm border-l-4 border-emerald-500 pl-2 uppercase">Tổng Quan Nhanh</span>
            </div>

            <div class="flex items-center gap-3 w-[48%] lg:w-auto">
              <div class="w-10 h-10 rounded-full bg-emerald-50 flex items-center justify-center text-emerald-600 text-xl border border-emerald-100 shrink-0">⛰️</div>
              <div>
                <div class="text-[11px] text-slate-500 font-medium">Vùng đất</div>
                <div class="text-[13px] font-bold text-slate-800">Tây Tạng</div>
              </div>
            </div>

            <div class="hidden lg:block w-px h-8 bg-slate-200"></div>

            <div class="flex items-center gap-3 w-[48%] lg:w-auto">
              <div class="w-10 h-10 rounded-full bg-blue-50 flex items-center justify-center text-blue-600 text-xl border border-blue-100 shrink-0">❄️</div>
              <div>
                <div class="text-[11px] text-slate-500 font-medium">Độ cao TB</div>
                <div class="text-[13px] font-bold text-slate-800">3.500 - 4.500m</div>
              </div>
            </div>

            <div class="hidden lg:block w-px h-8 bg-slate-200"></div>

            <div class="flex items-center gap-3 w-[48%] lg:w-auto mt-2 lg:mt-0">
              <div class="w-10 h-10 rounded-full bg-rose-50 flex items-center justify-center text-rose-600 text-xl border border-rose-100 shrink-0">🎫</div>
              <div>
                <div class="text-[11px] text-slate-500 font-medium">Giấy phép</div>
                <div class="text-[13px] font-bold text-slate-800">Bắt buộc (TTP)</div>
              </div>
            </div>

            <div class="hidden lg:block w-px h-8 bg-slate-200"></div>

            <div class="flex items-center gap-3 w-[48%] lg:w-auto mt-2 lg:mt-0">
              <div class="w-10 h-10 rounded-full bg-amber-50 flex items-center justify-center text-amber-600 text-xl border border-amber-100 shrink-0">📅</div>
              <div>
                <div class="text-[11px] text-slate-500 font-medium">Thời điểm đẹp nhất</div>
                <div class="text-[13px] font-bold text-slate-800">Tháng 4 – Tháng 10</div>
              </div>
            </div>
          </div>

          <div class="prose prose-slate max-w-none prose-p:leading-relaxed prose-p:text-[15.5px] prose-p:text-slate-700 prose-headings:font-serif prose-h2:text-2xl prose-h2:text-slate-900 prose-h2:border-b-2 prose-h2:border-amber-500 prose-h2:inline-block prose-h2:pb-2 prose-h2:mb-6 prose-h3:text-xl prose-h3:text-slate-800 prose-a:text-amber-700 prose-a:no-underline hover:prose-a:underline prose-li:text-slate-700">
            
            <div id="gioi-thieu" class="scroll-mt-28">
              <p>Du lịch Tây Tạng luôn nằm trong danh sách những hành trình mơ ước của nhiều người yêu khám phá. Tuy nhiên, khác với hầu hết các điểm đến khác trên thế giới, du khách quốc tế không thể tự do du lịch Tây Tạng theo hình thức tự túc.</p>
              
              <figure class="my-8">
                <img src={seoImage} alt="Cung điện Potala - Biểu tượng của du lịch Tây Tạng" width="1200" height="800" class="rounded-xl shadow-md w-full object-cover" />
              </figure>

              <p>Vậy nguyên nhân thực sự là gì? Có phải Tây Tạng “cấm cửa” khách nước ngoài hay chỉ đơn giản là những quy định đặc thù về quản lý du lịch? Bài viết này sẽ giúp bạn hiểu rõ toàn bộ quy trình, từ Tibet Travel Permit đến các yêu cầu về lịch trình, để chuẩn bị tốt nhất cho chuyến đi.</p>
            </div>

            <hr class="my-10 border-slate-200" />

            <div id="cam-tu-tuc" class="scroll-mt-28">
              <h2>Tây Tạng Có Thực Sự Cấm Du Lịch Tự Túc?</h2>
              
              <blockquote class="bg-amber-50/50 border-l-4 border-amber-500 p-4 my-6 rounded-r-xl font-serif text-slate-700 italic">
                "Tôi đã từng tự du lịch Nhật Bản, Hàn Quốc, châu Âu, Mỹ hay nhiều quốc gia khác. Vậy tại sao riêng Tây Tạng lại bắt buộc phải đi qua công ty du lịch?"
              </blockquote>

              <p>Đây có lẽ là câu hỏi phổ biến nhất mà bất kỳ đơn vị tổ chức tour Tây Tạng nào cũng từng nhận được.</p>
              <p>Thực tế, câu trả lời không đơn giản là <strong>"vì luật quy định"</strong>.</p>
              <p>Tây Tạng không cấm du khách quốc tế. Mỗi năm vẫn có hàng chục nghìn du khách từ khắp nơi trên thế giới đến Lhasa, Everest Base Camp hay núi Kailash. Tuy nhiên, khu vực này áp dụng một cơ chế quản lý riêng đối với khách nước ngoài, khác hoàn toàn so với phần lớn các điểm đến khác tại Trung Quốc.</p>
              
              <figure class="my-8">
                <img src="https://media.fittour.vn/uploads/chi-ly-truoc-cung-dien-potala.webp" alt="Tây Tạng Có Thực Sự Cấm Du Lịch Tự Túc?" width="1200" height="800" class="rounded-xl shadow-md w-full object-cover" />
              </figure>

              <p>Điều đó cũng có nghĩa là nếu bạn đã quen với việc đặt vé máy bay, khách sạn rồi xách ba lô lên đường, Tây Tạng sẽ mang đến một trải nghiệm hoàn toàn khác ngay từ bước chuẩn bị đầu tiên. Nếu bạn chưa biết bắt đầu từ đâu, hãy tham khảo <a href="/huong-dan-du-lich-tay-tang">hướng dẫn du lịch Tây Tạng</a> để có cái nhìn tổng quan nhất.</p>
            </div>

            <div id="tibet-travel-permit" class="scroll-mt-28 mt-12">
              <h2>1. Vì Sao Không Thể Tự Xin Tibet Travel Permit?</h2>
              
              <p>Nếu Visa Trung Quốc là "chìa khóa" để nhập cảnh vào Trung Quốc, thì <strong>Tibet Travel Permit</strong> chính là "tấm vé" để bước vào Khu tự trị Tây Tạng.</p>
              <p>Đây là loại giấy phép bắt buộc đối với hầu hết du khách quốc tế khi đến Tây Tạng. Không có giấy phép này, bạn sẽ không thể làm thủ tục lên tàu hoặc máy bay đến Lhasa, đồng thời cũng gặp khó khăn khi lưu trú hoặc đi qua các trạm kiểm soát trong hành trình.</p>
              <p>Điểm đặc biệt là <strong>Tibet Travel Permit không được cấp trực tiếp cho khách du lịch cá nhân</strong>.</p>
              <p>Theo quy định hiện hành, hồ sơ phải được nộp thông qua các công ty lữ hành được cấp phép hoạt động tại Tây Tạng. Sau khi đơn vị tổ chức hoàn tất các thủ tục và giấy phép được phê duyệt, du khách mới có thể bắt đầu hành trình.</p>
              <p>Đây cũng là lý do nhiều người lầm tưởng rằng Tây Tạng "không cho phép du lịch tự túc". Thực tế, điều bị giới hạn không phải là việc khám phá Tây Tạng, mà là <strong>quy trình xin giấy phép</strong>.</p>
              
              <figure class="my-8">
                <img src="https://media.fittour.vn/uploads/2023/06/mau-giay-phep-du-lich-tay-tang.webp" alt="Tibet Travel Permit là giấy phép bắt buộc để đến Tây Tạng" width="1200" height="800" class="rounded-xl shadow-md w-full object-cover" />
                <figcaption class="text-center text-sm text-slate-500 mt-3 italic">Tibet Travel Permit là điều kiện tiên quyết để bạn có thể lên tàu hoặc máy bay đến Lhasa.</figcaption>
              </figure>

              <div class="bg-rose-50 border border-rose-200 rounded-xl p-6 my-8">
                <h3 class="flex items-center gap-2 text-rose-800 !mt-0 m-0 pb-3 border-b border-rose-200/60 mb-4">
                  <span class="text-xl">⚠️</span> Hiểu Lầm Phổ Biến
                </h3>
                <p class="m-0 text-slate-700">Nhiều người cho rằng chỉ cần có visa Trung Quốc là có thể bay đến Lhasa rồi xin giấy phép sau.</p>
                <p class="text-slate-700">Đây là một trong những hiểu lầm phổ biến nhất trên các diễn đàn du lịch quốc tế.</p>
                <p class="m-0 text-slate-700 font-medium">Trên thực tế, Tibet Travel Permit cần được hoàn tất trước khi khởi hành. Các hãng hàng không, đường sắt và cơ quan quản lý sẽ kiểm tra giấy phép này trước khi bạn có thể tiếp tục hành trình vào Tây Tạng.</p>
              </div>
            </div>

            <div id="lich-trinh" class="scroll-mt-28 mt-12">
              <h2>2. Vì Sao Lịch Trình Phải Đăng Ký Trước?</h2>
              
              <p>Sau khi biết cần Tibet Travel Permit, câu hỏi tiếp theo thường là:</p>
              
              <blockquote class="bg-amber-50/50 border-l-4 border-amber-500 p-4 my-6 rounded-r-xl font-serif text-slate-700 italic">
                "Tại sao phải khai báo cả lịch trình?"
              </blockquote>

              <p>Nhiều người nghĩ đây chỉ là một thủ tục hành chính. Thực tế, lịch trình là một phần quan trọng của quá trình cấp phép.</p>
              
              <figure class="my-8">
                <img src="https://media.fittour.vn/uploads/2023/07/du-khach-fit-tour-hung-thu-voi-mua-cai-vang-tay-tang.webp" alt="Du khách FIT TOUR hứng thú với mùa cải vàng Tây Tạng" width="1200" height="800" class="rounded-xl shadow-md w-full object-cover" />
              </figure>

              <p>Khi xin Tibet Travel Permit, đơn vị tổ chức cần cung cấp trước các thông tin như:</p>
              
              <ul class="space-y-2 mb-6">
                <li>Ngày đến và ngày rời Tây Tạng.</li>
                <li>Phương tiện nhập cảnh (tàu hoặc máy bay).</li>
                <li>Khách sạn lưu trú.</li>
                <li>Các điểm tham quan.</li>
                <li>Tuyến đường dự kiến.</li>
              </ul>

              <p>Nhờ đó, cơ quan quản lý có thể xác định loại giấy phép cần cấp cũng như những khu vực du khách được phép di chuyển. Đây cũng là lý do việc thay đổi lịch trình vào phút cuối đôi khi không đơn giản như đổi một khách sạn hay một chuyến xe.</p>

              <figure class="my-8">
                <img src="https://media.fittour.vn/uploads/2024/07/du-khach-chup-hinh-truoc-cung-dien-potala.webp" alt="Du khách chụp hình trước cung điện Potala" width="1200" height="800" class="rounded-xl shadow-md w-full object-cover" />
              </figure>

              <div class="bg-rose-50 border border-rose-200 rounded-xl p-6 my-8">
                <h3 class="flex items-center gap-2 text-rose-800 !mt-0 m-0 pb-3 border-b border-rose-200/60 mb-4">
                  <span class="text-xl">⚠️</span> Hiểu Lầm Phổ Biến
                </h3>
                <p class="m-0 text-slate-700">Một số du khách trên Reddit từng chia sẻ rằng họ dự định đến Lhasa trước rồi quyết định sau sẽ đi Shigatse, Everest Base Camp hay Kailash.</p>
                <p class="text-slate-700 mt-3 font-medium">Thực tế, nhiều khu vực ngoài Lhasa yêu cầu các loại giấy phép bổ sung. Nếu lịch trình thay đổi đáng kể, đơn vị tổ chức có thể phải điều chỉnh hồ sơ hoặc xin thêm giấy phép trước khi tiếp tục hành trình.</p>
                <p class="m-0 text-slate-700">Chính vì vậy, các công ty lữ hành thường dành khá nhiều thời gian để trao đổi với khách ngay từ đầu nhằm xây dựng một lịch trình phù hợp, thay vì thay đổi liên tục trong quá trình di chuyển.</p>
              </div>
            </div>

            <div id="giay-phep-bo-sung" class="scroll-mt-28 mt-12">
              <h2>3. Những Khu Vực Nào Cần Giấy Phép Bổ Sung?</h2>
              
              <p>Nhiều người cho rằng chỉ cần có Tibet Travel Permit là có thể khám phá toàn bộ Tây Tạng. Thực tế không hoàn toàn như vậy.</p>
              <p>Tibet Travel Permit chỉ là giấy phép cơ bản để du khách quốc tế vào Khu tự trị Tây Tạng và tham quan các điểm như Lhasa. Tuy nhiên, nếu hành trình mở rộng đến những khu vực xa hơn, bạn có thể cần thêm một hoặc nhiều loại giấy phép khác.</p>
              
              <p>Dưới đây là một số ví dụ phổ biến:</p>
              
              <figure class="my-8">
                <img src="https://media.fittour.vn/uploads/2023/07/du-khach-chup-a-o-cung-dien-lhasa-tay-tang.webp" alt="Du khách tham quan Lhasa" width="1200" height="800" class="rounded-xl shadow-md w-full object-cover" />
              </figure>
              
              <div class="overflow-x-auto my-6 rounded-xl border border-slate-200 shadow-sm">
                <table class="w-full text-sm text-left border-collapse m-0">
                  <thead class="bg-slate-50 text-slate-700 uppercase border-b border-slate-200 text-xs tracking-wider">
                    <tr>
                      <th class="px-6 py-4 font-bold">Khu vực</th>
                      <th class="px-6 py-4 font-bold">Giấy phép bổ sung</th>
                    </tr>
                  </thead>
                  <tbody class="divide-y divide-slate-100">
                    <tr class="bg-white hover:bg-slate-50 transition-colors">
                      <td class="px-6 py-4 font-medium text-slate-900">Shigatse, Gyantse</td>
                      <td class="px-6 py-4 text-slate-600">Alien's Travel Permit</td>
                    </tr>
                    <tr class="bg-white hover:bg-slate-50 transition-colors">
                      <td class="px-6 py-4 font-medium text-slate-900">Everest Base Camp</td>
                      <td class="px-6 py-4 text-slate-600">Alien's Travel Permit</td>
                    </tr>
                    <tr class="bg-white hover:bg-slate-50 transition-colors">
                      <td class="px-6 py-4 font-medium text-slate-900">Núi Kailash & Hồ Manasarovar</td>
