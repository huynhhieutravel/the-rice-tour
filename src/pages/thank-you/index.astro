---
import BaseLayout from '@/layouts/BaseLayout.astro';

const seoData = {
  title: "Cảm ơn bạn | Fit Tour",
  description: "Cảm ơn bạn đã để lại thông tin. Đội ngũ Fit Tour sẽ liên hệ với bạn trong thời gian sớm nhất.",
  noindex: true // Không cho Google index trang này vì nó là trang nội bộ sau khi điền form
};
---

<BaseLayout 
  title={seoData.title} 
  description={seoData.description} 
  noindex={seoData.noindex}
>
  <div class="min-h-[70vh] bg-slate-50 flex items-center justify-center px-4 py-20">
    <div class="max-w-xl w-full bg-white rounded-3xl shadow-xl border border-slate-100 p-10 md:p-16 text-center transform transition-all">
      
      <!-- Animated Checkmark Icon -->
      <div class="mb-8 flex justify-center">
        <div class="relative w-24 h-24 bg-green-100 rounded-full flex items-center justify-center">
          <div class="absolute inset-0 bg-green-400 rounded-full animate-ping opacity-20"></div>
          <svg class="w-12 h-12 text-green-600 relative z-10" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path>
          </svg>
        </div>
      </div>

      <!-- Content -->
      <h1 class="text-4xl md:text-5xl font-black text-slate-900 mb-6 tracking-tight">Cảm ơn bạn!</h1>
      <p class="text-lg md:text-xl text-slate-500 font-medium leading-relaxed mb-10">
        Chúng tôi đã nhận được thông tin yêu cầu tư vấn. Đội ngũ Trip Planner của <strong class="text-slate-800">Fit Tour</strong> sẽ liên hệ với bạn trong thời gian sớm nhất.
      </p>

      <!-- Action Buttons -->
      <div class="flex flex-col sm:flex-row justify-center items-center gap-4">
        <a href="/" class="w-full sm:w-auto px-8 py-4 bg-slate-900 text-white rounded-full font-bold text-lg hover:bg-slate-800 transition-all hover:-translate-y-1 hover:shadow-lg">
          Trở về Trang Chủ
        </a>
        <a href="/tours" class="w-full sm:w-auto px-8 py-4 bg-orange-50 text-[#ea580c] border border-orange-100 rounded-full font-bold text-lg hover:bg-orange-100 transition-all hover:-translate-y-1">
          Khám phá Tours
        </a>
      </div>

    </div>
  </div>
</BaseLayout>
