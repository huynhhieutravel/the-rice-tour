---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/ladakh-co-may.css';
import '../styles/blog.css';
import '../styles/author-card.css';
import App from '../components/ReactApp/HoPangongTso/App.tsx';
import { env } from 'cloudflare:workers';
const d1Db = env?.dulichcoguu_d1;

let seoTitle = "Hồ Pangong Tso - Khám phá vẻ đẹp hồ thiêng Ladakh và kinh nghiệm đi";
let seoDesc = "Nhật ký hành trình và kinh nghiệm thực tế khám phá vẻ đẹp siêu thực của hồ Pangong Tso (Ladakh) từ tác giả Huỳnh Hiếu. Hướng dẫn chi tiết cách phòng say độ cao, kinh nghiệm di chuyển và trải nghiệm cắm trại cao cấp bên bờ hồ nước mặn cao nhất thế giới.";
let seoImage = "https://media.fittour.vn/uploads/2022/06/ho-pangong-tso-va-nhung-ngon-nui-phu-tuyet-bao-quanh-tuyet-dep.webp";
let adminEditUrl = "";

if (d1Db) {
  try {
    const stmt = d1Db.prepare(`SELECT id, title, seoTitle as metaTitle, seoDescription as metaDescription, featuredImage FROM Post WHERE slug = 'ho-pangong-tso' LIMIT 1`);
    const postData = await stmt.first();
    if (postData) {
      // Temporarily commented out to force static SEO metadata to display
      // seoTitle = postData.metaTitle || postData.title || seoTitle;
      // seoDesc = postData.metaDescription || seoDesc;
      seoImage = postData.featuredImage || seoImage;
      if (postData.id) adminEditUrl = `/admin/posts/edit?id=${postData.id}`;
    }
  } catch (e) {
    console.error("Lỗi lấy SEO data cho trang ho-pangong-tso:", e);
  }
}
---
<BaseLayout
  title={seoTitle}
  description={seoDesc}
  image={seoImage}
  canonical="https://thericetour.com/ho-pangong-tso"
  adminEditUrl={adminEditUrl}
>
  <Fragment slot="head">
    <meta property="og:type" content="article" />
    <!-- Optimize Google Fonts Loading -->
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&family=JetBrains+Mono:wght@400;500;700&display=swap">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&family=JetBrains+Mono:wght@400;500;700&display=swap" media="print" onload="this.media='all'">
    <noscript>
      <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&family=JetBrains+Mono:wght@400;500;700&display=swap">
    </noscript>
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Article",
          "headline": seoTitle,
          "description": seoDesc,
          "image": [seoImage],
          "author": [{
            "@type": "Person",
            "name": "Huỳnh Hiếu",
            "url": "https://thericetour.com/huynh-hieu"
          }]
        },
        {
          "@type": "FAQPage",
          "mainEntity": [
            {
              "@type": "Question",
              "name": "Có được phép tắm ở hồ Pangong không?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Không. Pangong Tso được người dân địa phương xem là hồ nước thiêng. Ngoài ra, nước hồ quanh năm cực kỳ lạnh và vì lý do sinh thái học mỏng manh, chính quyền địa phương cấm tuyệt đối mọi hoạt động tắm rửa hay xả rác xuống hồ."
              }
            },
            {
              "@type": "Question",
              "name": "Ngủ đêm tại Pangong có lạnh không?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Có, rất lạnh! Nhiệt độ ban đêm ngay cả vào mùa hè cũng có thể rớt xuống mức đóng băng. Tuy nhiên, nếu bạn lưu trú tại các khu Luxury Glamping do FIT Tour cung cấp, lều sẽ có chăn sưởi điện và túi ngủ chuyên dụng giúp bạn ấm áp hoàn toàn."
              }
            },
            {
              "@type": "Question",
              "name": "Di chuyển từ Leh đến Pangong Tso mất bao lâu?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Quãng đường từ Leh đến Pangong dài khoảng 134km nhưng phải đi qua đèo Chang La (5.360m). Thường sẽ mất khoảng 4 đến 5 tiếng lái xe tùy thuộc vào điều kiện thời tiết và giao thông trên đèo."
              }
            },
            {
              "@type": "Question",
              "name": "Có cần xin giấy phép đặc biệt để đến hồ không?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Có. Vì Pangong nằm sát biên giới Tây Tạng (Trung Quốc), toàn bộ du khách đều phải có Giấy phép khu vực nội tuyến (Inner Line Permit). FIT Tour sẽ chuẩn bị sẵn giấy phép này cho bạn trước khi khởi hành."
              }
            }
          ]
        }
      ]
    })} />
  </Fragment>

  <!-- client:load is used to enable SSR which fixes Render Blocking and LCP issues -->
  <App client:load /> 
</BaseLayout>
