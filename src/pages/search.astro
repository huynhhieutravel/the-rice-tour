---
import BaseLayout from '@/layouts/BaseLayout.astro';
---
<BaseLayout title="Search | The Rice Tour" description="Search tours, travel guides, and destinations at The Rice Tour" noindex={true}>

<style is:global>
  /* === SEARCH PAGE === */
  .search-page {
    min-height: 70vh;
    background: var(--bg-subtle);
  }

  /* Hero */
  .search-hero {
    background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
    padding: 3rem 1.5rem 2rem;
    text-align: center;
  }
  .search-hero-label {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: rgba(255,255,255,0.5);
    font-weight: 600;
    margin-bottom: 0.75rem;
  }
  .search-hero-query {
    font-size: clamp(1.5rem, 4vw, 2.5rem);
    font-weight: 800;
    color: #fff;
    line-height: 1.2;
    margin-bottom: 0.5rem;
  }
  .search-hero-query span {
    background: linear-gradient(135deg, #fb923c, #ea580c);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  .search-hero-count {
    font-size: 0.875rem;
    color: rgba(255,255,255,0.6);
    margin-top: 0.5rem;
  }

  /* Search Input on page */
  .search-page-input-wrap {
    max-width: 560px;
    margin: 1.5rem auto 0;
    position: relative;
  }
  .search-page-input {
    width: 100%;
    padding: 14px 48px 14px 20px;
    border-radius: 12px;
    border: 1px solid rgba(255,255,255,0.15);
    background: rgba(255,255,255,0.08);
    color: #fff;
    font-size: 1rem;
    outline: none;
    transition: all 0.2s;
    backdrop-filter: blur(8px);
  }
  .search-page-input::placeholder { color: rgba(255,255,255,0.4); }
  .search-page-input:focus {
    border-color: var(--color-brand-500);
    background: rgba(255,255,255,0.12);
    box-shadow: 0 0 0 3px rgba(234, 88, 12, 0.15);
  }
  .search-page-input-icon {
    position: absolute;
    right: 16px;
    top: 50%;
    transform: translateY(-50%);
    color: rgba(255,255,255,0.4);
    pointer-events: none;
  }

  /* Tabs */
  .search-tabs {
    display: flex;
    justify-content: center;
    gap: 0;
    background: #fff;
    border-bottom: 1px solid var(--border-color);
    position: sticky;
    top: 0;
    z-index: 40;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }
  .search-tab {
    padding: 14px 24px;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-muted);
    border: none;
    background: transparent;
    cursor: pointer;
    white-space: nowrap;
    position: relative;
    transition: color 0.2s;
  }
  .search-tab:hover { color: var(--text-primary); }
  .search-tab.active {
    color: var(--color-brand-500);
  }
  .search-tab.active::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 12px;
    right: 12px;
    height: 2.5px;
    background: var(--color-brand-500);
    border-radius: 2px 2px 0 0;
  }
  .search-tab-count {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 22px;
    height: 22px;
    padding: 0 6px;
    border-radius: 11px;
    background: var(--bg-subtle);
    font-size: 0.7rem;
    font-weight: 700;
    margin-left: 6px;
    color: var(--text-muted);
  }
  .search-tab.active .search-tab-count {
    background: rgba(234, 88, 12, 0.1);
    color: var(--color-brand-500);
  }

  /* Results Container */
  .search-results-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem 1.5rem 4rem;
  }

  /* Grid */
  .search-grid {
    display: grid;
    grid-template-columns: repeat(1, 1fr);
    gap: 1.25rem;
  }
  @media (min-width: 640px) {
    .search-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 1024px) {
    .search-grid { grid-template-columns: repeat(3, 1fr); }
  }

  /* Card */
  .search-card {
    display: flex;
    flex-direction: column;
    background: #fff;
    border-radius: 16px;
    overflow: hidden;
    border: 1px solid var(--border-color);
    transition: all 0.3s;
    text-decoration: none;
    color: inherit;
  }
  .search-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 40px rgba(0,0,0,0.08);
    border-color: var(--color-brand-200, #fed7aa);
  }
  .search-card-image-wrap {
    position: relative;
    width: 100%;
    aspect-ratio: 16/9;
    overflow: hidden;
    background: var(--bg-subtle);
  }
  .search-card-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s;
  }
  .search-card:hover .search-card-image {
    transform: scale(1.06);
  }
  .search-card-badge {
    position: absolute;
    top: 12px;
    left: 12px;
    padding: 4px 10px;
    border-radius: 6px;
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }
  .search-card-badge--tour {
    background: rgba(234, 88, 12, 0.85);
    color: #fff;
  }
  .search-card-badge--post {
    background: rgba(59, 130, 246, 0.85);
    color: #fff;
  }
  .search-card-badge--emagazine {
    background: rgba(168, 85, 247, 0.85); /* Purple 500 */
    color: #fff;
  }
  .search-card-badge--country {
    background: rgba(16, 185, 129, 0.85);
    color: #fff;
  }
  .search-card-badge--page {
    background: rgba(236, 72, 153, 0.85);
    color: #fff;
  }
  .search-card-body {
    padding: 1rem 1.25rem 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    flex: 1;
  }
  .search-card-category {
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-brand-500);
  }
  .search-card-title {
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.4;
    color: var(--text-primary);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .search-card-excerpt {
    font-size: 0.8rem;
    color: var(--text-muted);
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    margin-top: auto;
  }

  /* Skeleton */
  .search-skeleton-card {
    background: #fff;
    border-radius: 16px;
    overflow: hidden;
    border: 1px solid var(--border-color);
  }
  .search-skeleton-image {
    width: 100%;
    aspect-ratio: 16/9;
    background: linear-gradient(90deg, #f1f5f9 25%, #e2e8f0 50%, #f1f5f9 75%);
    background-size: 200% 100%;
    animation: shimmer 1.5s infinite;
  }
  .search-skeleton-body {
    padding: 1rem 1.25rem 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .search-skeleton-line {
    height: 14px;
    border-radius: 6px;
    background: linear-gradient(90deg, #f1f5f9 25%, #e2e8f0 50%, #f1f5f9 75%);
    background-size: 200% 100%;
    animation: shimmer 1.5s infinite;
  }
  .search-skeleton-line--short { width: 40%; }
  .search-skeleton-line--medium { width: 75%; }

  /* Empty State */
  .search-empty {
    text-align: center;
    padding: 4rem 2rem;
  }
  .search-empty-icon {
    width: 80px;
    height: 80px;
    margin: 0 auto 1.5rem;
    border-radius: 50%;
    background: var(--bg-subtle);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-muted);
  }
  .search-empty-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 0.5rem;
  }
  .search-empty-text {
    font-size: 0.9rem;
    color: var(--text-muted);
    max-width: 400px;
    margin: 0 auto;
    line-height: 1.6;
  }

  /* Load More */
  .search-load-more {
    display: flex;
    justify-content: center;
    margin-top: 2.5rem;
  }
  .search-load-more-btn {
    padding: 12px 32px;
    border-radius: 12px;
    border: 1.5px solid var(--border-color);
    background: #fff;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--text-primary);
    cursor: pointer;
    transition: all 0.2s;
  }
  .search-load-more-btn:hover {
    border-color: var(--color-brand-500);
    color: var(--color-brand-500);
    background: rgba(234, 88, 12, 0.04);
    transform: translateY(-1px);
  }
  .search-load-more-btn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
    transform: none;
  }

  /* Initial state (no query) */
  .search-initial {
    text-align: center;
    padding: 4rem 2rem;
  }
  .search-initial-title {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 0.75rem;
  }
  .search-initial-text {
    font-size: 0.95rem;
    color: var(--text-muted);
    max-width: 500px;
    margin: 0 auto;
    line-height: 1.6;
  }
</style>

<div class="search-page">
  <!-- Hero -->
  <div class="search-hero">
    <p class="search-hero-label">TÌM KIẾM</p>
    <h1 class="search-hero-query" id="search-hero-query">Nhập từ khóa để bắt đầu...</h1>
    <p class="search-hero-count" id="search-hero-count"></p>
    
    <div class="search-page-input-wrap">
      <input 
        type="text" 
        class="search-page-input" 
        id="search-page-input" 
        placeholder="Tìm kiếm tour, nhật ký, điểm đến..." 
        autocomplete="off"
        autofocus
      />
      <svg class="search-page-input-icon w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
      </svg>
    </div>
  </div>

  <!-- Tabs -->
  <div class="search-tabs" id="search-tabs" style="display:none">
    <button class="search-tab active" data-type="all">Tất cả<span class="search-tab-count" id="tab-count-all">0</span></button>
    <button class="search-tab" data-type="tour">Tours<span class="search-tab-count" id="tab-count-tour">0</span></button>
    <button class="search-tab" data-type="post">Blog<span class="search-tab-count" id="tab-count-post">0</span></button>
    <button class="search-tab" data-type="emegazine">Emagazine<span class="search-tab-count" id="tab-count-emagazine">0</span></button>
    <button class="search-tab" data-type="page">Trang<span class="search-tab-count" id="tab-count-page">0</span></button>
    <button class="search-tab" data-type="country">Khác<span class="search-tab-count" id="tab-count-country">0</span></button>
  </div>

  <!-- Results -->
  <div class="search-results-container">
    <!-- Loading Skeleton -->
    <div id="search-loading" style="display:none">
      <div class="search-grid">
        <div class="search-skeleton-card"><div class="search-skeleton-image"></div><div class="search-skeleton-body"><div class="search-skeleton-line search-skeleton-line--short"></div><div class="search-skeleton-line"></div><div class="search-skeleton-line search-skeleton-line--medium"></div></div></div>
        <div class="search-skeleton-card"><div class="search-skeleton-image"></div><div class="search-skeleton-body"><div class="search-skeleton-line search-skeleton-line--short"></div><div class="search-skeleton-line"></div><div class="search-skeleton-line search-skeleton-line--medium"></div></div></div>
        <div class="search-skeleton-card"><div class="search-skeleton-image"></div><div class="search-skeleton-body"><div class="search-skeleton-line search-skeleton-line--short"></div><div class="search-skeleton-line"></div><div class="search-skeleton-line search-skeleton-line--medium"></div></div></div>
        <div class="search-skeleton-card"><div class="search-skeleton-image"></div><div class="search-skeleton-body"><div class="search-skeleton-line search-skeleton-line--short"></div><div class="search-skeleton-line"></div><div class="search-skeleton-line search-skeleton-line--medium"></div></div></div>
        <div class="search-skeleton-card"><div class="search-skeleton-image"></div><div class="search-skeleton-body"><div class="search-skeleton-line search-skeleton-line--short"></div><div class="search-skeleton-line"></div><div class="search-skeleton-line search-skeleton-line--medium"></div></div></div>
        <div class="search-skeleton-card"><div class="search-skeleton-image"></div><div class="search-skeleton-body"><div class="search-skeleton-line search-skeleton-line--short"></div><div class="search-skeleton-line"></div><div class="search-skeleton-line search-skeleton-line--medium"></div></div></div>
      </div>
    </div>

    <!-- Grid Results -->
    <div class="search-grid" id="search-grid"></div>

    <!-- Load More -->
    <div class="search-load-more" id="search-load-more" style="display:none">
      <button class="search-load-more-btn" id="search-load-more-btn">Tải thêm kết quả</button>
    </div>

    <!-- Empty State -->
    <div id="search-empty" style="display:none">
      <div class="search-empty">
        <div class="search-empty-icon">
          <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
        </div>
        <p class="search-empty-title">Không tìm thấy kết quả</p>
        <p class="search-empty-text">Thử sử dụng từ khóa khác hoặc ngắn hơn. Ví dụ: "Ladakh", "Nepal", "Himalaya"...</p>
      </div>
    </div>

    <!-- Initial State -->
    <div id="search-initial">
      <div class="search-initial">
        <p class="search-initial-title">Khám phá thế giới cùng FIT Tour</p>
        <p class="search-initial-text">Gõ tên điểm đến, tour hoặc bài viết bạn quan tâm vào ô tìm kiếm phía trên. Chúng tôi sẽ tìm mọi thứ liên quan cho bạn.</p>
      </div>
    </div>
  </div>
</div>

<script is:inline>
(function() {
  const LIMIT = 12;
  let currentQuery = '';
  let currentType = 'all';
  let currentOffset = 0;
  let allItems = [];
  let totalCount = 0;
  let isLoading = false;
  let debounceTimer = null;

  // DOM
  const input = document.getElementById('search-page-input');
  const heroQuery = document.getElementById('search-hero-query');
  const heroCount = document.getElementById('search-hero-count');
  const tabs = document.getElementById('search-tabs');
  const grid = document.getElementById('search-grid');
  const loading = document.getElementById('search-loading');
  const empty = document.getElementById('search-empty');
  const initial = document.getElementById('search-initial');
  const loadMoreWrap = document.getElementById('search-load-more');
  const loadMoreBtn = document.getElementById('search-load-more-btn');

  // Category counts for tabs
  let tabCounts = { all: 0, tour: 0, post: 0, country: 0, emagazine: 0, page: 0 };

  // Read query from URL on load
  const urlParams = new URLSearchParams(window.location.search);
  const initialQ = urlParams.get('q') || '';
  const initialType = urlParams.get('type') || 'all';
  if (initialQ) {
    input.value = initialQ;
    currentQuery = initialQ;
    currentType = initialType;
    setActiveTab(initialType);
    search(initialQ, initialType, 0, true);
  }

  // Input handler
  input.addEventListener('input', () => {
    const q = input.value.trim();
    if (debounceTimer) clearTimeout(debounceTimer);
    if (q.length < 2) {
      reset();
      return;
    }
    debounceTimer = setTimeout(() => {
      currentQuery = q;
      currentType = 'all';
      setActiveTab('all');
      updateURL(q, 'all');
      search(q, 'all', 0, true);
    }, 350);
  });

  // Enter key in input
  input.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') {
      e.preventDefault();
      const q = input.value.trim();
      if (q.length >= 2) {
        if (debounceTimer) clearTimeout(debounceTimer);
        currentQuery = q;
        currentType = 'all';
        setActiveTab('all');
        updateURL(q, 'all');
        search(q, 'all', 0, true);
      }
    }
  });

  // Tab clicks
  document.querySelectorAll('.search-tab').forEach(tab => {
    tab.addEventListener('click', () => {
      if (isLoading) return;
      const type = tab.dataset.type;
      if (type === currentType) return;
      currentType = type;
      setActiveTab(type);
      updateURL(currentQuery, type);
      search(currentQuery, type, 0, true);
    });
  });

  // Load More
  loadMoreBtn.addEventListener('click', () => {
    if (isLoading) return;
    search(currentQuery, currentType, currentOffset, false);
  });

  function setActiveTab(type) {
    document.querySelectorAll('.search-tab').forEach(t => {
      t.classList.toggle('active', t.dataset.type === type);
    });
  }

  function updateURL(q, type) {
    const url = new URL(window.location);
    url.searchParams.set('q', q);
    if (type && type !== 'all') {
      url.searchParams.set('type', type);
    } else {
      url.searchParams.delete('type');
    }
    history.replaceState(null, '', url);
  }

  function reset() {
    grid.innerHTML = '';
    loading.style.display = 'none';
    empty.style.display = 'none';
    loadMoreWrap.style.display = 'none';
    tabs.style.display = 'none';
    initial.style.display = 'block';
    heroQuery.innerHTML = 'Nhập từ khóa để bắt đầu...';
    heroCount.textContent = '';
    allItems = [];
    totalCount = 0;
    currentOffset = 0;
  }

  async function search(q, type, offset, isNew) {
    if (isLoading || q.length < 2) return;
    isLoading = true;

    if (isNew) {
      allItems = [];
      grid.innerHTML = '';
      currentOffset = 0;
      loading.style.display = 'block';
      empty.style.display = 'none';
      loadMoreWrap.style.display = 'none';
      initial.style.display = 'none';
    }
    loadMoreBtn.disabled = true;
    loadMoreBtn.textContent = 'Đang tải...';

    try {
      const res = await fetch(`/api/search?q=${encodeURIComponent(q)}&type=${type}&limit=${LIMIT}&offset=${offset}`);
      const json = await res.json();

      if (json.success && json.data) {
        const data = json.data;
        totalCount = data.totalCount || data.total;

        // Update hero
        heroQuery.innerHTML = 'Kết quả cho: <span>"' + escHtml(q) + '"</span>';
        heroCount.textContent = totalCount + ' kết quả được tìm thấy';

        // Tab counts — use real counts from API
        if (isNew && data.counts) {
          tabCounts = {
            all: data.totalCount,
            tour: data.counts.tour || 0,
            post: data.counts.post || 0,
            country: data.counts.country || 0,
            emagazine: data.counts.emagazine || 0,
            page: data.counts.page || 0
          };
          updateTabCounts();
        }
        tabs.style.display = 'flex';

        // Flatten items
        const newItems = [];
        if (data.groups) {
          for (const g of data.groups) {
            for (const item of g.items) {
              newItems.push({ ...item, categoryName: item.categoryName || g.label, categorySlug: item.categorySlug || g.slug });
            }
          }
        }

        allItems = allItems.concat(newItems);
        currentOffset = allItems.length;

        // Render
        loading.style.display = 'none';
        if (allItems.length === 0) {
          empty.style.display = 'block';
          loadMoreWrap.style.display = 'none';
        } else {
          empty.style.display = 'none';
          if (isNew) {
            grid.innerHTML = newItems.map(renderCard).join('');
          } else {
            grid.insertAdjacentHTML('beforeend', newItems.map(renderCard).join(''));
          }
          // Show/hide load more
          if (allItems.length < totalCount && newItems.length === LIMIT) {
            loadMoreWrap.style.display = 'flex';
          } else {
            loadMoreWrap.style.display = 'none';
          }
        }
      } else {
        loading.style.display = 'none';
        if (isNew) empty.style.display = 'block';
      }
    } catch (err) {
      console.error('[Search Page Error]', err);
      loading.style.display = 'none';
      if (isNew) empty.style.display = 'block';
    }

    isLoading = false;
    loadMoreBtn.disabled = false;
    loadMoreBtn.textContent = 'Tải thêm kết quả';
  }

  function updateTabCounts() {
    const allEl = document.getElementById('tab-count-all');
    const tourEl = document.getElementById('tab-count-tour');
    const postEl = document.getElementById('tab-count-post');
    const countryEl = document.getElementById('tab-count-country');
    const emagazineEl = document.getElementById('tab-count-emagazine');
    const pageEl = document.getElementById('tab-count-page');
    if (allEl) allEl.textContent = tabCounts.all;
    if (tourEl) tourEl.textContent = tabCounts.tour;
    if (postEl) postEl.textContent = tabCounts.post;
    if (countryEl) countryEl.textContent = tabCounts.country;
    if (emagazineEl) emagazineEl.textContent = tabCounts.emagazine;
    if (pageEl) pageEl.textContent = tabCounts.page;
  }

  function escHtml(s) {
    const d = document.createElement('div');
    d.textContent = s;
    return d.innerHTML;
  }

  function getBadgeClass(slug) {
    if (slug === 'tour') return 'search-card-badge--tour';
    if (slug === 'country') return 'search-card-badge--country';
    if (slug === 'emegazine') return 'search-card-badge--emagazine';
    if (slug === 'page') return 'search-card-badge--page';
    return 'search-card-badge--post';
  }

  function getBadgeLabel(slug) {
    if (slug === 'tour') return 'Tour';
    if (slug === 'country') return 'Điểm đến';
    if (slug === 'emegazine') return 'Emagazine';
    if (slug === 'page') return 'Trang';
    return 'Blog';
  }

  function renderCard(item) {
    const imgSrc = item.thumbnail
      ? item.thumbnail + '?w=600&h=338&fit=cover'
      : 'https://media.thericetour.com/uploads/logo-the-rice.webp';
    const badgeClass = getBadgeClass(item.categorySlug);
    const badgeLabel = getBadgeLabel(item.categorySlug);
    const title = escHtml(item.title || '');
    const excerpt = escHtml(item.excerpt || '');
    const catName = escHtml(item.categoryName || '');
    const slug = item.slug || '#';

    return `<a href="/${slug}" class="search-card">
      <div class="search-card-image-wrap">
        <img src="${imgSrc}" alt="${title}" class="search-card-image" loading="lazy" />
        <span class="search-card-badge ${badgeClass}">${badgeLabel}</span>
      </div>
      <div class="search-card-body">
        <span class="search-card-category">${catName}</span>
        <h3 class="search-card-title">${title}</h3>
        ${excerpt ? '<p class="search-card-excerpt">' + excerpt + '</p>' : ''}
      </div>
    </a>`;
  }
})();
</script>

</BaseLayout>
