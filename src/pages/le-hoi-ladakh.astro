---
import { env } from 'cloudflare:workers';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { safeQueryCritical } from '@/lib/db-client';
import { getGlobalSettings } from '@/lib/settingsHelper';
import { MapPin, Info, Users, Clock, Calendar, Compass, Share2, Link as LinkIcon, ChevronRight, CheckCircle2 } from 'lucide-react';

const d1Db = env?.dulichcoguu_d1;
if (!d1Db) return Astro.rewrite("/500");

// Fetch CMS Data for SEO and Metadata
let post;
try {
  post = await safeQueryCritical(
    d1Db.prepare("SELECT * FROM Post WHERE slug = ? AND (status = 'published' OR status = 'publish')").bind('le-hoi-ladakh').first<any>(),
    { route: Astro.url.pathname, slug: 'le-hoi-ladakh', queryType: "fetch_post_by_slug" }
  );
} catch (e) {
  return Astro.rewrite("/500");
}

if (!post) {
  return Astro.rewrite("/404");
}

const { settings } = await getGlobalSettings();

const seoTitle = post.seoTitle || post.title || 'Top 21 lễ hội Ladakh ấn tượng nhất – Lịch Lễ Hội 2026 - 2027';
const seoDesc = post.seoDesc || post.excerpt || 'Cẩm nang khám phá 21 lễ hội nổi tiếng nhất Ladakh. Cập nhật lịch lễ hội 2026 - 2027, địa điểm tổ chức và kinh nghiệm tham gia các điệu múa mặt nạ Cham truyền thống.';
const seoImage = post.seoImage || post.featuredImage || 'https://media.fittour.vn/uploads/2022/05/le-hoi-ladakh.webp';

// --- DATE LOGIC ---
const createdAtStr = post.createdAt || post.publishedAt || new Date().toISOString();
const updatedAtStr = post.updatedAt || createdAtStr;

const createdAt = new Date(createdAtStr.replace(' ', 'T'));
const updatedAt = new Date(updatedAtStr.replace(' ', 'T'));

const isUpdated = updatedAt.getTime() - createdAt.getTime() > 86400000; 
const displayDate = isUpdated ? updatedAt : createdAt;
const datePrefix = isUpdated ? "Cập nhật:" : "Xuất bản:";

const formattedDate = displayDate.toLocaleDateString('vi-VN', { day: '2-digit', month: '2-digit', year: 'numeric' });
// ------------------

const adminEditUrl = `/admin/posts/edit?id=${post.id}`;

const festivals = [
  { id: "spituk-gustor", name: "1. Lễ Hội Spituk Gustor", month: "Tháng 1", location: "Tu viện Spituk", desc: "Spituk Gustor là một trong những lễ hội Phật giáo nổi tiếng nhất tại Ladakh, được tổ chức hằng năm tại Tu viện Spituk cách trung tâm Leh khoảng 8 km.<br/><br/>Điểm nhấn của lễ hội là các điệu múa mặt nạ Cham do các nhà sư thực hiện. Những màn trình diễn mang ý nghĩa tâm linh sâu sắc, tái hiện cuộc chiến giữa thiện và ác theo quan niệm Phật giáo Tây Tạng.<br/><br/>Vào ngày cuối cùng, một hình nộm tượng trưng cho những điều tiêu cực sẽ được phá hủy nhằm cầu mong bình an, may mắn và khởi đầu thuận lợi cho năm mới.", time2026: "15 - 16/01/2026", time2027: "05 - 06/01/2027" },
  { id: "dosmochey", name: "2. Lễ Hội Dosmochey", month: "Tháng 2", location: "Leh, <a href='/tu-vien-likir' class='hover:text-amber-600 transition-colors underline decoration-slate-300 underline-offset-2'>Likir</a>, <a href='/tu-vien-diskit' class='hover:text-amber-600 transition-colors underline decoration-slate-300 underline-offset-2'>Diskit</a>", img: "https://media.fittour.vn/uploads/2022/04/tu-vien-likir.webp", desc: "Dosmochey là lễ hội cầu an truyền thống được tổ chức tại Leh, Likir và Diskit. Đây là một trong những lễ hội mùa đông quan trọng nhất của Ladakh.<br/><br/>Lễ hội được khởi xướng từ thế kỷ 17 dưới thời vua Sengge Namgyal với mục đích bảo vệ cộng đồng khỏi thiên tai, dịch bệnh và những điều không may.<br/><br/>Trong thời gian diễn ra sự kiện, các nhà sư thực hiện nhiều nghi lễ đặc biệt nhằm xua đuổi tà khí và cầu bình an cho người dân địa phương.", time2026: "17 - 18/02/2026", time2027: "04 - 05/02/2027" },
  { id: "phuktal-gustor", name: "3. Lễ Hội Phuktal Gustor", month: "Tháng 2", location: "<a href='/tu-vien-phugtal' class='hover:text-amber-600 transition-colors underline decoration-slate-300 underline-offset-2'>Tu viện Phuktal</a>", img: "https://media.fittour.vn/uploads/2023/06/du-khach-chup-anh-ben-tu-vien-Phugtal.webp", desc: "Phuktal Gustor được tổ chức tại <strong>Tu viện Phuktal</strong>, một trong những tu viện nổi tiếng nhất vùng Zanskar.<br/><br/>Trong những ngày lễ hội, các nhà sư thực hiện nghi lễ cầu nguyện, tụng kinh và các màn múa mặt nạ truyền thống nhằm truyền tải giáo lý Phật giáo Tây Tạng.<br/><br/>Không gian linh thiêng của tu viện nằm bên vách núi càng làm tăng sức hấp dẫn cho sự kiện đặc biệt này.", time2026: "06 - 07/02/2026", time2027: "Đang cập nhật" },
  { id: "yargon-tungshak", name: "4. Lễ Hội Yargon Tungshak", month: "Tháng 2 - 3", location: "Nubra Valley", desc: "Yargon Tungshak là lễ hội truyền thống nổi bật của thung lũng Nubra, phản ánh rõ nét đời sống cộng đồng của người dân địa phương.<br/><br/>Lễ hội bao gồm nhiều hoạt động văn hóa như biểu diễn âm nhạc dân gian, múa truyền thống và các chương trình giao lưu giữa các làng trong khu vực.<br/><br/>Đây là dịp để người dân gặp gỡ, cầu nguyện và tăng cường sự gắn kết cộng đồng.", time2026: "Cuối tháng 2/2026", time2027: "Đang cập nhật" },
  { id: "stok-guru-tsechu", name: "5. Lễ Hội Stok Guru Tsechu", month: "Tháng 2 - 3", location: "Cung điện Stok", desc: "Stok Guru Tsechu được tổ chức tại cung điện Stok, nơi từng là nơi ở của hoàng gia Ladakh.<br/><br/>Điểm đặc biệt của lễ hội là sự xuất hiện của các vị tiên tri được người dân địa phương tôn kính. Khác với Matho Nagrang, các vị tiên tri của Stok Guru xuất hiện tại cung điện Stok và có truyền thống riêng biệt gắn với hoàng gia Ladakh. Trong trạng thái nhập định, họ sẽ đưa ra những lời tiên đoán cho năm mới.<br/><br/>Ngoài các nghi thức tâm linh độc đáo, du khách còn được thưởng thức các màn múa Cham truyền thống đặc sắc.", time2026: "27 - 28/02/2026", time2027: "15 - 16/02/2027" },
  { id: "matho-nagrang", name: "6. Lễ Hội Matho Nagrang", month: "Tháng 3", location: "<a href='/tu-vien-matho' class='hover:text-amber-600 transition-colors underline decoration-slate-300 underline-offset-2'>Tu viện Matho</a>", img: "https://media.fittour.vn/uploads/2024/06/tu-vien-matho-ladakh.webp", desc: "Matho Nagrang là một trong những lễ hội độc đáo nhất Ladakh, được tổ chức tại <strong>Tu viện Matho</strong> thuộc dòng Sakya của Phật giáo Tây Tạng. Matho là tu viện duy nhất của dòng Sakya tại Ladakh.<br/><br/>Điểm nổi bật của lễ hội là nghi thức các vị tiên tri xuất hiện trước công chúng để đưa ra dự báo cho năm mới.<br/><br/>Bên cạnh đó, lễ hội còn có các điệu múa mặt nạ, nghi lễ cầu nguyện và nhiều hoạt động tâm linh đặc sắc.", time2026: "01 - 02/03/2026", time2027: "19 - 20/02/2027" },
  { id: "shey-doo-lhoo", name: "7. Lễ Hội Shey Doo Lhoo", month: "Tháng 7", location: "Shey", desc: "Shey Doo Lhoo diễn ra tại Shey, cố đô cũ của Ladakh và là một trong những lễ hội cộng đồng quan trọng nhất khu vực.<br/><br/>Người dân địa phương tập trung cầu nguyện cho mùa màng thuận lợi, sức khỏe và cuộc sống bình an.<br/><br/>Không khí lễ hội được tô điểm bởi các hoạt động văn hóa truyền thống cùng những bộ trang phục đặc trưng của Ladakh.", time2026: "Dự kiến tháng 7", time2027: "08/03/2027" },
  { id: "saka-dawa", name: "8. Lễ Hội Saka Dawa", month: "Tháng 5 - 6", location: "Khắp Ladakh", desc: "Saka Dawa là một trong những ngày lễ thiêng liêng nhất của Phật giáo Tây Tạng, được tổ chức trên khắp Ladakh.<br/><br/>Lễ hội kỷ niệm ngày sinh, ngày giác ngộ và ngày nhập niết bàn của Đức Phật Thích Ca Mâu Ni. Đây được xem là ngày thiêng liêng nhất trong năm của nhiều cộng đồng Phật giáo Tây Tạng.<br/><br/>Trong thời gian này, người dân thường tham gia cầu nguyện, làm việc thiện và thực hiện các nghi lễ tôn giáo quan trọng.", time2026: "30/05/2026", time2027: "18/06/2027" },
  { id: "yuru-kabgyat", name: "9. Lễ Hội Yuru Kabgyat", month: "Tháng 6 - 7", location: "<a href='/tu-vien-lamayuru' class='hover:text-amber-600 transition-colors underline decoration-slate-300 underline-offset-2'>Tu viện Lamayuru</a>", img: "https://media.fittour.vn/uploads/2024/06/toan-canh-tu-vien-lamayuru.webp", desc: "Yuru Kabgyat được tổ chức tại <strong>Tu viện Lamayuru</strong>, một trong những tu viện cổ nhất Ladakh.<br/><br/>Lễ hội nổi tiếng với các điệu múa Cham đầy màu sắc và những nghi thức mang ý nghĩa bảo vệ cộng đồng khỏi các thế lực tiêu cực.<br/><br/>Kết hợp với cảnh quan độc đáo của Lamayuru, đây là một trong những lễ hội được nhiều du khách quốc tế yêu thích.", time2026: "13 - 14/06/2026", time2027: "01 - 02/07/2027" },
  { id: "hemis-tsechu", name: "10. Lễ Hội Hemis Tsechu", month: "Tháng 6 - 7", location: "<a href='/tu-vien-giau-co-nhat-ladakh-hemis' class='hover:text-amber-600 transition-colors underline decoration-slate-300 underline-offset-2'>Tu viện Hemis</a>", img: "https://media.fittour.vn/uploads/2023/06/tu-vien-hemis-ladakh-fittour.webp", desc: "<a href='/le-hoi-hemis' class='text-amber-700 font-bold hover:underline'>Hemis Tsechu</a> là lễ hội nổi tiếng nhất Ladakh và cũng là một trong những sự kiện lớn nhất vùng Himalaya.<br/><br/>Được tổ chức tại <strong>Tu viện Hemis</strong>, lễ hội nhằm tưởng nhớ Guru Padmasambhava – người có công truyền bá Phật giáo Tây Tạng. Người Ladakh tin rằng Guru Padmasambhava đã góp phần đưa Phật giáo Kim Cương Thừa từ Ấn Độ sang Tây Tạng vào thế kỷ VIII.<br/><br/>Hàng nghìn người dân và du khách từ khắp nơi đổ về tham dự mỗi năm để chiêm ngưỡng các màn múa mặt nạ và nghi lễ truyền thống. Xem thêm <a href='/hinh-anh-le-hoi-hemis' class='text-amber-700 font-bold hover:underline'>chùm ảnh sống động về lễ hội Hemis</a>.", time2026: "24 - 25/06/2026", time2027: "13 - 14/07/2027" },
  { id: "phyang-tsedup", name: "11. Lễ Hội Phyang Tsedup", month: "Tháng 7", location: "<a href='/tu-vien-phyang' class='hover:text-amber-600 transition-colors underline decoration-slate-300 underline-offset-2'>Tu viện Phyang</a>", img: "https://media.fittour.vn/uploads/2023/01/tu-vien-Phyang-ladakh.webp", desc: "Phyang Tsedup diễn ra tại <strong>Tu viện Phyang</strong> gần Leh và là một trong những lễ hội Phật giáo quan trọng của khu vực.<br/><br/>Lễ hội nổi bật với các nghi thức cầu nguyện, múa Cham và nhiều hoạt động văn hóa truyền thống.<br/><br/>Đây là cơ hội để du khách khám phá đời sống tâm linh của cộng đồng Phật giáo tại Ladakh.", time2026: "22 - 23/07/2026", time2027: "31/07 - 01/08/2027" },
  { id: "korzok-gustor", name: "12. Lễ Hội Korzok Gustor", month: "Tháng 8", location: "Tu viện Korzok", desc: "Korzok Gustor được tổ chức tại Tu viện Korzok bên hồ Tso Moriri nổi tiếng.<br/><br/>Ngoài các nghi lễ Phật giáo và điệu múa mặt nạ truyền thống, lễ hội còn hấp dẫn bởi khung cảnh thiên nhiên tuyệt đẹp của vùng Changthang. Lễ hội còn là dịp cộng đồng du mục Changpa tụ họp sau nhiều tháng sinh sống trên cao nguyên Changthang.<br/><br/>Đây là lựa chọn lý tưởng cho những ai muốn kết hợp trải nghiệm lễ hội với khám phá hồ Tso Moriri.", time2026: "08 - 09/08/2026", time2027: "06 - 07/08/2027" },
  { id: "takthok-tsechu", name: "13. Lễ Hội Takthok Tsechu", month: "Tháng 7 - 8", location: "Tu viện Takthok", desc: "Takthok Tsechu diễn ra tại Tu viện Takthok. Takthok là tu viện duy nhất tại Ladakh được xây dựng quanh một hang động tự nhiên.<br/><br/>Lễ hội bao gồm các nghi thức tôn giáo, múa mặt nạ và các hoạt động cộng đồng mang đậm bản sắc Tây Tạng.<br/><br/>Không gian đặc biệt của tu viện khiến trải nghiệm lễ hội trở nên khác biệt và đáng nhớ hơn.", time2026: "27 - 28/07/2026", time2027: "11 - 12/08/2027" },
  { id: "ladakh-festival", name: "14. Lễ Hội Ladakh Festival", month: "Tháng 9", location: "Leh & các vùng lân cận", desc: "Ladakh Festival là lễ hội văn hóa lớn nhất dành cho du khách tại Ladakh.<br/><br/>Sự kiện quy tụ các đoàn nghệ thuật từ nhiều khu vực với các chương trình biểu diễn âm nhạc, múa truyền thống, diễu hành trang phục dân tộc và bắn cung.<br/><br/>Đây là lựa chọn hoàn hảo cho những ai muốn khám phá tổng quan văn hóa Ladakh trong thời gian ngắn.", time2026: "20 - 24/09/2026", time2027: "21 - 24/09/2027" },
  { id: "diskit-gustor", name: "15. Lễ Hội Diskit Gustor", month: "Tháng 10 - 11", location: "<a href='/tu-vien-diskit' class='hover:text-amber-600 transition-colors underline decoration-slate-300 underline-offset-2'>Tu viện Diskit</a>", img: "https://media.fittour.vn/uploads/legacy/tu-vien-diskit-gompa.webp", desc: "Diskit Gustor được tổ chức tại <strong>Tu viện Diskit</strong> nổi tiếng ở thung lũng Nubra.<br/><br/>Lễ hội nổi bật với các điệu múa Cham truyền thống và nghi thức tượng trưng cho chiến thắng của cái thiện trước cái ác.<br/><br/>Du khách có thể kết hợp tham dự lễ hội với hành trình khám phá Nubra Valley và tượng Phật Maitreya nổi tiếng.", time2026: "07 - 08/11/2026", time2027: "27 - 28/10/2027" },
  { id: "thiksey-gustor", name: "16. Lễ Hội Thiksey Gustor", month: "Tháng 11", location: "<a href='/tu-vien-thiksey' class='hover:text-amber-600 transition-colors underline decoration-slate-300 underline-offset-2'>Tu viện Thiksey</a>", img: "https://media.fittour.vn/uploads/2022/05/tu-vien-thiksey-dulichcoguu.webp", desc: "Thiksey Gustor diễn ra tại <strong>Tu viện Thiksey</strong>, một trong những tu viện đẹp nhất Ladakh.<br/><br/>Các nghi lễ cầu nguyện, múa mặt nạ và hoạt động tôn giáo được tổ chức trong không gian kiến trúc ấn tượng nhìn ra thung lũng Indus.<br/><br/>Đây là một trong những lễ hội được nhiều nhiếp ảnh gia yêu thích khi đến Ladakh.", time2026: "17 - 18/11/2026", time2027: "16 - 17/11/2027" },
  { id: "chemrey-wangchok", name: "17. Lễ Hội Chemrey Wangchok", month: "Tháng 11 - 12", location: "<a href='/tu-vien-chemrey' class='hover:text-amber-600 transition-colors underline decoration-slate-300 underline-offset-2'>Tu viện Chemrey</a>", img: "https://media.fittour.vn/uploads/2024/06/tu-vien-Chemrey-ladakh.webp", desc: "Chemrey Wangchok được tổ chức tại <strong>Tu viện Chemrey</strong> với lịch sử lâu đời.<br/><br/>Lễ hội bao gồm các nghi thức Phật giáo truyền thống, múa Cham và các hoạt động cộng đồng mang ý nghĩa cầu bình an.<br/><br/>Không khí trang nghiêm kết hợp với cảnh quan núi non hùng vĩ tạo nên trải nghiệm đặc biệt cho du khách.", time2026: "28 - 29/11/2026", time2027: "26 - 27/11/2027" },
  { id: "galdan-namchot", name: "18. Lễ Hội Galdan Namchot", month: "Tháng 12", location: "Khắp Ladakh", desc: "Galdan Namchot là lễ hội tưởng niệm Je Tsongkhapa, nhà cải cách vĩ đại – người sáng lập truyền thống Gelug của Phật giáo Tây Tạng.<br/><br/>Trong dịp này, các tu viện, nhà cửa và công trình tôn giáo được thắp sáng bằng đèn bơ truyền thống, tạo nên khung cảnh lung linh khắp Ladakh.<br/><br/>Đây là một trong những lễ hội đẹp nhất để cảm nhận không khí tâm linh của vùng đất Himalaya.", time2026: "14/12/2026", time2027: "22/12/2027" },
  { id: "losar", name: "19. Lễ Hội Losar", month: "Tháng 12", location: "Khắp Ladakh", img: "https://media.fittour.vn/uploads/2023/02/nhung-vi-su-thoi-nhung-cay-ken-chao-mung-duc-datlailatma-dip-tet-losar.webp", desc: "<a href='/tet-losar' class='text-amber-700 font-bold hover:underline'>Lễ hội Losar</a> thường được tổ chức vào khoảng tháng 12 dương lịch. Các hoạt động đón năm mới có thể kéo dài nhiều ngày tùy từng cộng đồng và khu vực tại Ladakh.<br/><br/>Người dân dọn dẹp nhà cửa, chuẩn bị các món ăn truyền thống, tham gia cầu nguyện và tổ chức nhiều hoạt động văn hóa để chào đón năm mới.<br/><br/>Nếu muốn trải nghiệm không khí lễ hội đậm chất bản địa và tìm hiểu phong tục truyền thống của người Ladakh, Losar là thời điểm không nên bỏ lỡ.", time2026: "09/12/2026", time2027: "28/12/2027" },
  { id: "sindhu-darshan", name: "20. Lễ Hội Sindhu Darshan Festival", month: "Tháng 6", location: "Bờ sông Indus, Leh", desc: "Sindhu Darshan Festival là một trong những lễ hội văn hóa lớn nhất Ladakh, được tổ chức bên bờ sông Indus – dòng sông gắn liền với sự hình thành của nền văn minh Indus cổ đại và cũng là nguồn gốc của tên gọi \"India\".<br/><br/>Lễ hội thường diễn ra vào tháng 6 hằng năm với sự tham gia của các đoàn nghệ thuật, đại diện nhiều cộng đồng tôn giáo và du khách từ khắp Ấn Độ. Các hoạt động nổi bật bao gồm nghi lễ tôn vinh sông Indus, biểu diễn âm nhạc dân gian, múa truyền thống và các chương trình giao lưu văn hóa.<br/><br/>Khác với phần lớn các lễ hội trong danh sách này mang màu sắc Phật giáo Tây Tạng, Sindhu Darshan phản ánh vai trò của Ladakh như một điểm giao thoa giữa nhiều nền văn hóa, dân tộc và tín ngưỡng tại khu vực Himalaya. Đây cũng là một trong những sự kiện được chính quyền Ladakh quảng bá mạnh mẽ nhằm giới thiệu bản sắc văn hóa địa phương đến du khách trong và ngoài nước.", time2026: "Tháng 6", time2027: "Tháng 6" },
  { id: "naropa-festival", name: "21. Lễ Hội Naropa Festival", month: "Không thường niên", location: "<a href='/tu-vien-giau-co-nhat-ladakh-hemis' class='hover:text-amber-600 transition-colors underline decoration-slate-300 underline-offset-2'>Tu viện Hemis</a>", desc: "Naropa Festival là một trong những sự kiện Phật giáo lớn nhất từng được tổ chức tại Ladakh và được nhiều người xem là lễ hội tâm linh quan trọng bậc nhất vùng Himalaya.<br/><br/>Lễ hội gắn liền với Đại thành tựu giả Naropa – một trong những bậc thầy có ảnh hưởng sâu sắc đến sự phát triển của Phật giáo Kim Cương Thừa. Điểm đặc biệt nhất của sự kiện là nghi thức trưng bày Naropa Relics tại <strong>Tu viện Hemis</strong>, những thánh tích linh thiêng chỉ được công khai trong những dịp rất hiếm, thường cách nhau nhiều năm.<br/><br/>Mỗi kỳ Naropa Festival đều thu hút hàng chục nghìn tăng ni, Phật tử và du khách hành hương từ nhiều quốc gia. Bên cạnh các nghi lễ cầu nguyện và thuyết giảng Phật pháp, lễ hội còn có các màn trình diễn nghệ thuật truyền thống, múa Cham quy mô lớn và nhiều hoạt động văn hóa đặc sắc.<br/><br/>Do không được tổ chức thường niên, Naropa Festival được xem là một sự kiện đặc biệt đối với những ai quan tâm đến văn hóa và Phật giáo Tây Tạng. Nếu có cơ hội diễn ra trong thời gian du lịch Ladakh, đây là một trong những trải nghiệm đáng giá nhất tại vùng đất Himalaya.", time2026: "Không cố định", time2027: "Không cố định" },
];

---

<BaseLayout 
  title={seoTitle} 
  description={seoDesc} 
  image={seoImage}
  adminEditUrl={adminEditUrl}
>
  <div class="bg-[#F8F9FA] text-[#1E293B] font-sans antialiased selection:bg-[#c89845] selection:text-white">

    {/* ================= HERO SECTION ================= */}
    <section class="relative w-full h-[600px] lg:h-[650px] overflow-hidden">
      <div class="absolute inset-0 z-0 bg-slate-900">
        <img src={seoImage} alt="Lễ hội Ladakh" class="w-full h-full object-cover object-center opacity-80" fetchpriority="high" loading="eager" />
        <div class="absolute inset-0 bg-gradient-to-r from-black/80 via-black/50 to-transparent"></div>
        <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-transparent to-transparent"></div>
      </div>

      <div class="relative z-10 max-w-[1600px] mx-auto px-4 sm:px-6 lg:px-12 h-full flex flex-col justify-center pt-20 pb-16">
        
        {/* Breadcrumb */}
        <div class="flex items-center gap-2 text-[13px] text-white/70 font-medium mb-6">
          <a href="/" class="hover:text-white transition-colors">Trang chủ</a>
          <ChevronRight class="w-3 h-3" />
          <a href="/blog" class="hover:text-white transition-colors">Blog</a>
          <ChevronRight class="w-3 h-3" />
          <span class="text-white">Ladakh</span>
        </div>

        {/* Titles */}
        <h1 class="font-serif text-4xl sm:text-5xl lg:text-6xl font-bold text-white mb-4 leading-[1.1] drop-shadow-lg max-w-4xl">
          21 Lễ Hội Ladakh Nổi Tiếng Nhất Không Nên Bỏ Lỡ
        </h1>
        <h2 class="font-serif text-xl sm:text-3xl text-amber-400 italic mb-10 max-w-3xl drop-shadow-md">
          Khám Phá Sắc Màu Văn Hóa & Tâm Linh Tây Tạng
        </h2>
        <p class="text-white/90 text-base sm:text-lg max-w-2xl leading-relaxed mb-8 hidden md:block drop-shadow-md font-medium">
          Hành trình khám phá <strong class="text-amber-400 font-bold">những lễ hội Ladakh</strong> đầy màu sắc – nơi lưu giữ trọn vẹn những điệu múa mặt nạ Cham huyền bí và nét đẹp văn hóa Himalaya đặc trưng.
        </p>

        {/* Author Meta */}
        <div class="flex flex-wrap items-center gap-6 text-sm text-white/80 border-t border-white/20 pt-6 max-w-3xl">
          <a href="/huynh-hieu" class="flex items-center gap-3 group">
            <img src="https://media.fittour.vn/uploads/huynhhieutravel.webp" alt="Huỳnh Hiếu Travel" class="w-10 h-10 rounded-full border-2 border-white/30 object-cover object-top group-hover:border-amber-400 transition-colors" />
            <span class="font-bold text-white group-hover:text-amber-400 transition-colors flex items-center gap-1">
              Huỳnh Hiếu Travel
              <CheckCircle2 class="w-4 h-4 text-blue-400" />
            </span>
          </a>
          <div class="flex items-center gap-2 bg-white/10 px-4 py-2 rounded-full backdrop-blur-sm border border-white/10">
            <Calendar class="w-4 h-4 opacity-70" />
            <span>{datePrefix} {formattedDate}</span>
          </div>
          <div class="flex items-center gap-2 bg-black/20 px-3 py-1.5 rounded-full backdrop-blur-sm">
            <Clock class="w-4 h-4 text-amber-400" />
            <span>15 phút đọc</span>
          </div>
        </div>

        {/* Badges Line */}
        <div class="flex flex-wrap items-center gap-4 mt-8 pt-6">
          <div class="flex items-center gap-2 text-sm text-white font-medium bg-black/60 backdrop-blur-md px-4 py-2 border border-white/10 rounded-lg shadow-xl">
            <span class="text-amber-400 text-lg">🎭</span> 21 Lễ hội
          </div>
          <div class="flex items-center gap-2 text-sm text-white font-medium bg-black/60 backdrop-blur-md px-4 py-2 border border-white/10 rounded-lg shadow-xl">
            <span class="text-amber-400 text-lg">🗓️</span> Lịch 2026 - 2027
          </div>
          <div class="flex items-center gap-2 text-sm text-white font-medium bg-black/60 backdrop-blur-md px-4 py-2 border border-white/10 rounded-lg shadow-xl">
            <span class="text-amber-400 text-lg">🪷</span> Điệu múa Cham
          </div>
        </div>

      </div>
    </section>

    {/* ================= MAIN CONTENT GRID ================= */}
    <div class="max-w-[1600px] mx-auto px-4 sm:px-6 lg:px-12 py-12 lg:py-16">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-start">

        {/* ---------------- LEFT SIDEBAR (TOC) ---------------- */}
        <aside class="hidden lg:block lg:col-span-3 sticky top-24">
          <div class="bg-white rounded-2xl shadow-sm border border-slate-200/60 p-6 overflow-hidden">
            <div class="flex items-center gap-2 font-bold text-slate-800 mb-6 border-l-4 border-amber-500 pl-3 text-sm tracking-wide uppercase">
              Mục lục bài viết
            </div>
            
            <nav class="space-y-1 text-[13.5px] font-medium">
              <a href="#gioi-thieu" class="flex items-center gap-2 text-amber-700 bg-amber-50 px-3 py-2.5 rounded-lg transition-colors">
                <span class="text-amber-500 text-base">🏠</span> Giới thiệu
              </a>
              <a href="#lich-le-hoi-ladakh" class="flex items-center gap-2 text-slate-700 hover:text-amber-600 px-3 py-2.5 rounded-lg transition-colors">
                <span class="text-slate-400 text-base">🗓️</span> Lịch Lễ Hội 2026 & 2027
              </a>
              
              <div class="pt-2 pb-1">
                <a href="#danh-sach-le-hoi" class="flex items-center gap-2 text-slate-700 hover:text-amber-600 px-3 py-2 rounded-lg transition-colors font-bold">
                  <span class="text-slate-400 text-base">🎭</span> Danh sách 21 Lễ hội
                </a>
                <div class="pl-9 pr-3 space-y-1.5 mt-1 border-l border-slate-100 ml-[18px] max-h-[500px] overflow-y-auto custom-scrollbar">
                  {festivals.map((m, i) => (
                    <a href={`#${m.id}`} class="block text-slate-500 hover:text-amber-600 text-[13px] py-1 transition-colors leading-tight">
                      {m.name}
                    </a>
                  ))}
                </div>
              </div>
            </nav>
          </div>
        </aside>

        {/* ---------------- CENTER COLUMN (MAIN CONTENT) ---------------- */}
        <main class="col-span-1 lg:col-span-6 space-y-10">
          
          {/* Quick Overview Stats Bar */}
          <div class="bg-white rounded-2xl shadow-sm border border-slate-200/60 p-6 flex flex-wrap lg:flex-nowrap items-center justify-between gap-4">
            <div class="w-full flex items-center justify-between gap-4 mb-2 lg:hidden">
              <span class="font-bold text-slate-800 text-sm border-l-4 border-emerald-500 pl-2 uppercase">Tổng Quan Nhanh</span>
            </div>

            <div class="flex items-center gap-3 w-[48%] lg:w-auto">
              <div class="w-10 h-10 rounded-full bg-emerald-50 flex items-center justify-center text-emerald-600 text-xl border border-emerald-100 shrink-0">🎭</div>
              <div>
                <div class="text-[11px] text-slate-500 font-medium">Hoạt động chính</div>
                <div class="text-[13px] font-bold text-slate-800">Múa Cham mặt nạ</div>
              </div>
            </div>

            <div class="hidden lg:block w-px h-8 bg-slate-200"></div>

            <div class="flex items-center gap-3 w-[48%] lg:w-auto">
              <div class="w-10 h-10 rounded-full bg-blue-50 flex items-center justify-center text-blue-600 text-xl border border-blue-100 shrink-0">🗓️</div>
              <div>
                <div class="text-[11px] text-slate-500 font-medium">Lễ hội lớn nhất</div>
                <div class="text-[13px] font-bold text-slate-800">Hemis Tsechu (Tháng 6)</div>
              </div>
            </div>

            <div class="hidden lg:block w-px h-8 bg-slate-200"></div>

            <div class="flex items-center gap-3 w-[48%] lg:w-auto mt-2 lg:mt-0">
              <div class="w-10 h-10 rounded-full bg-rose-50 flex items-center justify-center text-rose-600 text-xl border border-rose-100 shrink-0">🎆</div>
              <div>
                <div class="text-[11px] text-slate-500 font-medium">Tết truyền thống</div>
                <div class="text-[13px] font-bold text-slate-800">Losar (Tháng 12)</div>
              </div>
            </div>
          </div>

          {/* Intro Text */}
          <div id="gioi-thieu" class="prose prose-slate max-w-none prose-p:leading-relaxed prose-p:text-[15.5px] prose-p:text-slate-700">
            <p>Ladakh không chỉ hấp dẫn bởi <a href="/ho-pangong-tso" class="text-amber-600 font-bold hover:underline">hồ Pangong</a>, <a href="/thung-lung-nubra" class="text-amber-600 font-bold hover:underline">thung lũng Nubra</a> hay những cung đường ngoạn mục giữa dãy Himalaya, mà còn nổi tiếng với hệ thống lễ hội đặc sắc diễn ra quanh năm.</p>
            <p>Đây là nơi du khách có thể bắt gặp những điệu múa mặt nạ Cham huyền bí trong các tu viện cổ, các nghi lễ Phật giáo Tây Tạng hàng trăm năm tuổi và những lễ hội cộng đồng mang đậm bản sắc địa phương.</p>
            <p>Mỗi lễ hội tại Ladakh mang một màu sắc riêng, từ Hemis Tsechu nổi tiếng nhất vùng, Matho Nagrang với các vị tiên tri linh thiêng, Losar đón năm mới Tây Tạng cho đến Ladakh Festival đầy sắc màu văn hóa.</p>
            <p>Nếu đang lên kế hoạch <a href="/du-lich-ladakh" class="text-amber-600 font-bold hover:underline">du lịch Ladakh</a>, việc lựa chọn đúng thời điểm diễn ra lễ hội sẽ giúp chuyến đi trở nên đáng nhớ hơn rất nhiều.</p>
            <p>Trong bài viết này, FIT TOUR sẽ tổng hợp <strong class="text-amber-700">21 lễ hội Ladakh nổi tiếng nhất</strong> cùng thời gian và địa điểm tổ chức để bạn dễ dàng lên lịch khám phá vùng đất Himalaya độc đáo này.</p>
          </div>

          {/* Timeline Table */}
          <div id="lich-le-hoi-ladakh" class="mt-12 scroll-mt-28">
            <div class="font-serif text-2xl lg:text-[28px] font-bold text-slate-900 border-b-2 border-amber-500 pb-2 inline-block mb-6">Lịch Lễ Hội Ladakh (2026 - 2027)</div>
            
            <div class="bg-amber-50 border-l-4 border-amber-400 p-4 mb-6 rounded-r-lg">
              <p class="text-amber-800 text-sm italic font-medium m-0">Lưu ý: Nhiều lễ hội Ladakh được xác định theo lịch Tây Tạng âm lịch nên ngày tổ chức có thể thay đổi nhẹ mỗi năm. Bảng dưới đây cập nhật thời gian thường diễn ra hàng năm.</p>
            </div>

            <div class="overflow-x-auto rounded-xl border border-slate-200 shadow-sm">
              <table class="w-full text-left border-collapse bg-white text-sm">
                <thead>
                                    <tr class="bg-slate-50 text-slate-800 font-bold border-b border-slate-200">
                    <td class="px-4 py-4 uppercase tracking-wider text-[11px] whitespace-nowrap text-center">STT</td>
                    <td class="px-4 py-4 uppercase tracking-wider text-[11px] whitespace-nowrap border-l border-slate-200">Lễ hội</td>
                    <td class="px-4 py-4 uppercase tracking-wider text-[11px] whitespace-nowrap border-l border-slate-200">Tháng (Thường niên)</td>
                    <td class="px-4 py-4 uppercase tracking-wider text-[11px] whitespace-nowrap border-l border-slate-200 text-amber-700">Dự kiến 2026</td>
                    <td class="px-4 py-4 uppercase tracking-wider text-[11px] whitespace-nowrap border-l border-slate-200 text-emerald-700">Dự kiến 2027</td>
                    <td class="px-4 py-4 uppercase tracking-wider text-[11px] border-l border-slate-200">Địa điểm</td>
                  </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 font-medium text-slate-600">
                  {festivals.map((f, idx) => (
                                        <tr class="hover:bg-slate-50/50 transition-colors border-b border-slate-100">
                      <td class="px-4 py-3 text-center text-slate-400 font-semibold">{idx + 1}</td>
                      <td class="px-4 py-3 text-slate-900 font-bold whitespace-nowrap border-l border-slate-100"><a href={`#${f.id}`} class="hover:text-amber-600 transition-colors">{f.name.replace(/^\d+\.\s*/, '')}</a></td>
                      <td class="px-4 py-3 text-slate-500 whitespace-nowrap font-medium border-l border-slate-100">{f.month}</td>
                      <td class="px-4 py-3 text-amber-600 font-bold whitespace-nowrap border-l border-slate-100">{f.time2026}</td>
                      <td class="px-4 py-3 text-emerald-600 font-bold whitespace-nowrap border-l border-slate-100">{f.time2027}</td>
                      <td class="px-4 py-3 text-slate-600 border-l border-slate-100" set:html={f.location}></td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>

          <div class="flex items-center justify-center py-8 opacity-40">
            <div class="w-16 h-px bg-slate-400"></div>
            <span class="mx-4 text-amber-600 text-xl">🪷</span>
            <div class="w-16 h-px bg-slate-400"></div>
          </div>

          {/* Festivals List */}
          <div id="danh-sach-le-hoi" class="space-y-16">
            {festivals.map((m, i) => (
              <>
                <div id={m.id} class="scroll-mt-28">
                  
                  {/* Title */}
                  <div class="flex items-center gap-4 mb-6">
                    <div class="w-12 h-12 rounded-lg bg-gradient-to-br from-amber-400 to-amber-600 flex items-center justify-center text-white font-serif font-bold text-2xl shadow-md shrink-0">
                      {i+1}
                    </div>
                    <h3 class="font-serif text-2xl lg:text-[26px] font-bold text-slate-900">
                      {m.name.replace(/^\d+\.\s*/, '')}
                    </h3>
                  </div>

                  {/* Image */}
                  {m.img && (
                    <div class="rounded-xl overflow-hidden shadow-lg border border-slate-200/60 mb-6 bg-white">
                      <div class="aspect-[16/9] w-full overflow-hidden bg-slate-100">
                        <img src={m.img} alt={m.name} class="w-full h-full object-cover hover:scale-105 transition-transform duration-1000" loading="lazy" />
                      </div>
                    </div>
                  )}

                    {/* Info Bar */}
                    <div class="bg-[#2D333A] rounded-xl overflow-hidden shadow-md text-white/90 px-4 py-3 mb-6 flex flex-wrap lg:flex-nowrap items-center gap-y-2 gap-x-4 sm:gap-x-5 text-xs sm:text-[13px] font-medium justify-between xl:justify-start xl:gap-x-8">
                      <div class="flex items-center gap-1.5 shrink-0">
                        <MapPin class="w-3.5 h-3.5 text-amber-400" />
                        <span>Địa điểm: <span set:html={m.location} /></span>
                      </div>
                      <div class="flex items-center gap-1.5 shrink-0">
                        <Calendar class="w-3.5 h-3.5 text-amber-400" />
                        <span>Tháng tổ chức: {m.month}</span>
                      </div>
                      <div class="flex items-center gap-1.5 shrink-0">
                        <Clock class="w-3.5 h-3.5 text-amber-400" />
                      </div>
                    </div>

                  {/* Description */}
                  <div class="text-slate-700 text-[15.5px] leading-relaxed mb-6 font-medium [&>br]:mb-2" set:html={m.desc}></div>

                </div>

                {i === 9 && (
                  <div class="bg-gradient-to-br from-amber-50 to-orange-50 rounded-2xl p-6 sm:p-8 border border-amber-200 shadow-sm relative overflow-hidden group">
                    <div class="absolute right-0 top-0 w-48 h-48 bg-amber-400/20 rounded-full blur-3xl -mr-16 -mt-16 pointer-events-none"></div>
                    <div class="flex flex-col md:flex-row items-center gap-6 relative z-10">
