import { env } from 'cloudflare:workers';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { safeQueryCritical } from '@/lib/db-client';
import { getGlobalSettings } from '@/lib/settingsHelper';
import { MapPin, Info, Users, Clock, Calendar, Compass, Share2, Link as LinkIcon, ChevronRight, CheckCircle2 } from 'lucide-react';

const d1Db = env?.dulichcoguu_d1;
if (!d1Db) return Astro.rewrite("/500");

// Fetch CMS Data for SEO and Metadata
let post;
try {
  post = await safeQueryCritical(
    d1Db.prepare("SELECT * FROM Post WHERE slug = ? AND (status = 'published' OR status = 'publish')").bind('noi-o-ladakh').first<any>(),
    { route: Astro.url.pathname, slug: 'noi-o-ladakh', queryType: "fetch_post_by_slug" }
  );
} catch (e) {
  return Astro.rewrite("/500");
}

if (!post) {
  return Astro.rewrite("/404");
}

const { settings } = await getGlobalSettings();

const seoTitle = post.seoTitle || post.title || 'Top 18 Tu Viện Nổi Tiếng Nhất Ladakh';
const seoDesc = post.seoDesc || post.excerpt || 'Khám phá 18 tu viện Phật giáo Tây Tạng linh thiêng và nổi tiếng nhất tại Ladakh, Ấn Độ.';
const seoImage = post.seoImage || post.featuredImage || 'https://media.fittour.vn/uploads/thiksey-monastery-ladakh.webp';

// --- DATE LOGIC ---
const dbUpdatedAtStr = post.updatedAt || post.createdAt || post.publishedAt || new Date().toISOString();
const dbUpdatedAt = new Date(dbUpdatedAtStr.replace(' ', 'T'));

// Last time the Astro template was updated (today)
const templateUpdatedAt = new Date('2026-06-28T00:00:00.000Z');

// Lấy ngày mới nhất giữa DB và Template
const displayDate = dbUpdatedAt > templateUpdatedAt ? dbUpdatedAt : templateUpdatedAt;

const datePrefix = "Cập nhật:";

// Format date to local VN timezone
const formattedDate = new Intl.DateTimeFormat('vi-VN', {
  timeZone: 'Asia/Ho_Chi_Minh',
  day: '2-digit',
  month: '2-digit',
  year: 'numeric'
}).format(displayDate);
// ------------------

const adminEditUrl = `/admin/posts/edit?id=${post.id}`;

// List of monasteries based on the content
