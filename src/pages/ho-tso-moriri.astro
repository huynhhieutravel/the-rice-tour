---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/ladakh-co-may.css';
import '../styles/blog.css';
import '../styles/author-card.css';
import App from '../components/ReactApp/HoTsoMoriri/App.tsx';
import MemoryMap from '../components/ReactApp/HoTsoMoriri/components/MemoryMap.tsx';
import Backpack from '../components/ReactApp/HoTsoMoriri/components/Backpack.tsx';
import PhotoGallery from '../components/ReactApp/HoTsoMoriri/components/PhotoGallery.tsx';
import FaqSection from '../components/ReactApp/HoTsoMoriri/components/FaqSection.tsx';
import Guestbook from '../components/ReactApp/HoTsoMoriri/components/Guestbook.tsx';
import RelatedArticles from '../components/ReactApp/HoTsoMoriri/components/RelatedArticles.tsx';
import SignatureTour from '../components/ReactApp/HoTsoMoriri/components/SignatureTour.tsx';
import FooterApp from '../components/ReactApp/HoTsoMoriri/components/FooterApp.tsx';
import FloatingButton from '../components/ReactApp/HoTsoMoriri/components/FloatingButton.tsx';
import { env } from 'cloudflare:workers';
import { sanitizeElementorHtml } from '../lib/elementorSanitizer';
import { parseShortcodes } from '../utils/shortcodes/parser';
import ShortcodeRenderer from '../components/shortcodes/ShortcodeRenderer.astro';
import { fetchAllShortcodeData } from '../utils/shortcodes/dataLoader';

const d1Db = env?.dulichcoguu_d1;

let seoTitle = "Hồ Tso Moriri, Ladakh - Khám phá nét đẹp, hướng dẫn tham quan";
let seoDesc = "Kinh nghiệm du lịch thực tế chinh phục Hồ Tso Moriri - khu Ramsar cao nhất thế giới. Cẩm nang lịch trình Leh - Chumathang - Korzok, cách phòng tránh say núi cấp tính tại 4.595m và hướng dẫn xin giấy phép nội tuyến.";
let seoImage = "https://media.fittour.vn/uploads/2022/06/ho-pangong-tso-va-nhung-ngon-nui-phu-tuyet-bao-quanh-tuyet-dep.webp";
let adminEditUrl = "";
let rawHtml = "";

if (d1Db) {
  try {
    const stmt = d1Db.prepare(`SELECT id, title, content, seoTitle as metaTitle, seoDescription as metaDescription, featuredImage FROM Post WHERE slug = 'ho-tso-moriri' LIMIT 1`);
    const postData = await stmt.first();
    if (postData) {
      seoImage = postData.featuredImage || seoImage;
      if (postData.id) adminEditUrl = `/admin/posts/edit?id=${postData.id}`;
      rawHtml = postData.content || "";
    }
  } catch (e) {
    console.error("Lỗi lấy SEO data cho trang ho-tso-moriri:", e);
  }
}

// Prepare the old content
const cleanHtml = sanitizeElementorHtml(rawHtml, seoImage, true);
const astNodes = parseShortcodes(cleanHtml);
const dataMap = await fetchAllShortcodeData(astNodes, d1Db);

---
<BaseLayout
  title={seoTitle}
  description={seoDesc}
  image={seoImage}
  canonical="https://thericetour.com/ho-tso-moriri"
  adminEditUrl={adminEditUrl}
>
  <Fragment slot="head">
    <link rel="preload" as="image" href={seoImage} fetchpriority="high" />
    <meta property="og:type" content="article" />
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&family=JetBrains+Mono:wght@400;500;700&display=swap">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&family=JetBrains+Mono:wght@400;500;700&display=swap" media="print" onload="this.media='all'">
    <noscript>
      <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&family=JetBrains+Mono:wght@400;500;700&display=swap">
    </noscript>
    
    <!-- Using the standard blog CSS for the prose content below the React App (imported in frontmatter) -->

    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Article",
          "headline": seoTitle,
          "description": seoDesc,
          "image": seoImage,
          "author": {
            "@type": "Person",
            "name": "Huy Ngô",
            "url": "https://thericetour.com/author/huy-ngo"
          },
          "publisher": {
            "@type": "Organization",
            "name": "FIT Tour",
            "logo": {
              "@type": "ImageObject",
              "url": "https://media.thericetour.com/uploads/logo-the-rice.webp"
            }
          },
          "datePublished": "2026-09-01T08:00:00+08:00",
          "dateModified": "2026-09-01T08:00:00+08:00",
          "mainEntityOfPage": {
            "@type": "WebPage",
            "@id": "https://thericetour.com/ho-tso-moriri"
          }
        },
        {
          "@type": "FAQPage",
          "mainEntity": [
            {
              "@type": "Question",
              "name": "Có được phép tắm ở hồ Tso Moriri không?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Không. Tso Moriri là khu bảo tồn thiên nhiên và được người dân địa phương xem là hồ nước thiêng. Bạn không được phép tắm hay xả rác xuống hồ."
              }
            },
            {
              "@type": "Question",
              "name": "Ngủ đêm tại Tso Moriri có lạnh không?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Rất lạnh! Do độ cao 4.595m, nhiệt độ ban đêm có thể xuống dưới mức đóng băng. Tuy nhiên các lều trại cao cấp luôn có lò sưởi, chăn điện và túi ngủ ấm áp."
              }
            },
            {
              "@type": "Question",
              "name": "Di chuyển từ Leh đến Tso Moriri mất bao lâu?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Khoảng 6 đến 7 tiếng với quãng đường 240km, băng qua cao nguyên Changthang và những con đường gập ghềnh."
              }
            },
            {
              "@type": "Question",
              "name": "Có cần xin giấy phép đặc biệt để đến hồ không?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Có. Tso Moriri sát biên giới Tây Tạng (Trung Quốc), mọi du khách đều phải có Giấy phép khu vực nội tuyến (Inner Line Permit). FIT Tour sẽ chuẩn bị sẵn giấy phép này."
              }
            }
          ]
        }
      ]
    })} />
  </Fragment>

  <main class="min-h-screen bg-stone-50 text-stone-800 font-sans selection:bg-amber-150 selection:text-amber-900 overflow-x-hidden antialiased">
    <App client:load featureImage={seoImage} /> 
    <MemoryMap client:visible />
    <Backpack client:visible />
    <PhotoGallery client:visible />
    <FaqSection client:visible />
    <Guestbook client:visible />
    <RelatedArticles client:visible />
    <SignatureTour client:visible />
    <FooterApp client:visible />
    <FloatingButton client:load />
  </main>

</BaseLayout>
