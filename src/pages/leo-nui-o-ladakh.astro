              Chỉ Số Chinh Phục
            </div>
            
            <div class="space-y-5">
              <div class="flex gap-3">
                <div class="w-10 h-10 rounded-full bg-slate-100 text-slate-600 flex items-center justify-center shrink-0 border border-slate-200 text-lg">⛰️</div>
                <div>
                  <div class="text-[11px] text-slate-500 uppercase tracking-wide font-bold">Đỉnh cao nhất</div>
                  <div class="font-bold text-slate-800 text-[13px]">Nun Kun (7.135m)</div>
                </div>
              </div>
              <div class="flex gap-3">
                <div class="w-10 h-10 rounded-full bg-emerald-50 text-emerald-600 flex items-center justify-center shrink-0 border border-emerald-100 text-lg">⛺</div>
                <div>
                  <div class="text-[11px] text-slate-500 uppercase tracking-wide font-bold">Trekking phổ biến nhất</div>
                  <div class="font-bold text-slate-800 text-[13px]">Markha Valley Trek</div>
                </div>
              </div>
              <div class="flex gap-3">
                <div class="w-10 h-10 rounded-full bg-amber-50 text-amber-600 flex items-center justify-center shrink-0 border border-amber-100 text-lg">⏳</div>
                <div>
                  <div class="text-[11px] text-slate-500 uppercase tracking-wide font-bold">Thời gian đẹp nhất</div>
                  <div class="font-bold text-slate-800 text-[13px]">Tháng 6 - Tháng 9</div>
                </div>
              </div>
              <div class="flex gap-3">
                <div class="w-10 h-10 rounded-full bg-blue-50 text-blue-600 flex items-center justify-center shrink-0 border border-blue-100 text-lg">❄️</div>
                <div>
                  <div class="text-[11px] text-slate-500 uppercase tracking-wide font-bold">Thử thách mùa đông</div>
                  <div class="font-bold text-slate-800 text-[13px]">Chadar Trek (-30°C)</div>
                </div>
              </div>
            </div>

          </div>

          {/* Related Articles */}
          <div class="bg-white rounded-2xl shadow-sm border border-slate-200/60 p-6">
            <div class="flex items-center gap-2 font-bold text-slate-800 mb-6 border-l-4 border-rose-500 pl-3 text-sm tracking-wide uppercase">
              Bài Viết Liên Quan
            </div>
            <div class="space-y-4">
              {[
                { title: "Vì Sao Ladakh Được Gọi Là Tiểu Tây Tạng Của Ấn Độ?", img: "https://media.fittour.vn/uploads/2023/06/Dang-Thuy-Duong-kham-pha-tu-vien-Hemis.webp", link: "/vi-sao-ladakh-duoc-goi-la-tieu-tay-tang" },
                { title: "Tại sao gọi Ladakh là Vùng đất của các Lạt Ma", img: "https://media.fittour.vn/uploads/2024/06/tai-sao-ladakh-duoc-goi-la-vung-dat-cua-lat-ma.webp", link: "/tai-sao-goi-ladakh-la-vung-dat-cua-cac-lat-ma" },
                { title: "Đèo Mig La Pass – Con Đèo Cao Nhất Thế Giới Ở Ladakh", img: "https://media.fittour.vn/uploads/2025/10/dinh-deo-mig-la.webp", link: "/deo-mig-la" },
                { title: "Cột mốc 80 chuyến đi Ladakh do FIT Tour thiết kế", img: "https://media.fittour.vn/uploads/cot-moc-80-chuyen-di-ladakh-fittour.webp", link: "/cot-moc-80-chuyen-di-ladakh" }
