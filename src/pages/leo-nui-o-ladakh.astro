---
import { env } from 'cloudflare:workers';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getGlobalSettings } from '@/lib/settingsHelper';
import { MapPin, Info, Users, Clock, Calendar, Compass, Share2, Link as LinkIcon, ChevronRight, CheckCircle2, AlertTriangle, ShieldCheck } from 'lucide-react';

// Vì file này chạy tĩnh (Astro File), nó sẽ tự động ghi đè route /leo-nui-o-ladakh trong DB.
// Không cần fetch từ DB nữa.
const seoTitle = 'Leo Núi & Trekking Ở Ladakh: Hướng Dẫn & Cẩm Nang (Cập Nhật)';
const seoDesc = 'Cẩm nang toàn diện về leo núi và trekking tại Ladakh. Bao gồm hướng dẫn phòng say độ cao (AMS), xin giấy phép IMF, và phân loại các cung đường theo độ khó (Markha Valley, Nun Kun, Kang Yatze).';
const seoImage = 'https://media.fittour.vn/uploads/2022/08/trekking-o-Stok-Kangri.webp';

let adminEditUrl = "";
const d1Db = env?.dulichcoguu_d1;
if (d1Db) {
  try {
    const stmt = d1Db.prepare(`SELECT id FROM Post WHERE slug = 'leo-nui-o-ladakh' LIMIT 1`);
    const postData = await stmt.first();
    if (postData && postData.id) {
      adminEditUrl = `/admin/posts/edit?id=${postData.id}`;
    }
  } catch (e) {}
}

const formattedDate = new Date().toLocaleDateString('vi-VN', { day: '2-digit', month: '2-digit', year: 'numeric' });

// Dữ liệu cung đường và đỉnh núi được phân chia theo độ khó
const routes = [
  { 
    id: "sham-valley", 
    difficulty: "Người mới",
    badgeColor: "bg-emerald-500",
    name: "Sham Valley Trek", 
    location: "Khu vực Sham", 
    type: "Trekking", 
    time: "3 - 4 ngày", 
    alt: "3.900m", 
    img: "https://media.fittour.vn/uploads/2023/06/vung-thao-nguyen-zanskar.webp", 
    desc: "Được mệnh danh là cung 'Baby Trek' của Ladakh, Sham Valley là lựa chọn hoàn hảo cho những người mới bắt đầu làm quen với địa hình Himalaya. Đường đi ít dốc gắt và hiếm khi vượt quá độ cao 4000m, giúp cơ thể thích nghi cực tốt trước khi tiến tới các cung khó hơn.<br/><br/>Suốt dọc đường, bạn sẽ đi qua những ngôi làng trù phú và các tu viện thanh bình, trải nghiệm văn hóa địa phương một cách chậm rãi.",
    link: "/tour/tour-ladakh-roadtrip",
    buttonText: "Tham khảo Tour Roadtrip Ladakh"
  },
  { 
    id: "spangnak-ri", 
    difficulty: "Người mới",
    badgeColor: "bg-emerald-500",
    name: "Spangnak Ri", 
    location: "Khu vực Tso Moriri", 
    type: "Trekking & Peak", 
    time: "2 - 3 ngày", 
    alt: "6.390m", 
    img: "https://media.fittour.vn/uploads/2022/06/vung-nui-quanh-doan-duong-ho-thieng-ladakh.webp", 
    desc: "Nằm gần hồ Tso Moriri huyền thoại, Spangnak Ri là một trong những đỉnh núi ở độ cao hơn 6000m hiếm hoi mang tính chất 'Non-technical' (không cần kỹ năng leo núi băng tuyết phức tạp). Đây là bài kiểm tra độ bền lý tưởng dành cho những ai khao khát đặt chân lên đỉnh 6K đầu tiên trong đời.<br/><br/>Góc nhìn từ đỉnh xuống hồ nước mặn xanh thẳm Tso Moriri là một cảnh tượng vĩ đại.",
  },
  { 
    id: "markha-valley", 
    difficulty: "Trung cấp",
    badgeColor: "bg-amber-500",
    name: "Markha Valley Trek", 
    location: "Vườn quốc gia Hemis", 
    type: "Trekking", 
    time: "6 - 8 ngày", 
    alt: "5.260m", 
    img: "https://media.fittour.vn/uploads/2022/08/trekking-thung-lung-markha.webp", 
    desc: "Cung trekking biểu tượng và nổi tiếng nhất Ladakh. Markha Valley đưa bạn qua những ngôi làng nhỏ xen giữa các hẻm núi đá sâu thẳm, vượt qua hai con đèo đồ sộ là Ganda La (4.900m) và Kongmaru La (5.260m).<br/><br/>Hành trình này yêu cầu thể lực tốt và khả năng đi bộ liên tục nhiều ngày. Đổi lại, bạn sẽ được thưởng thức cảnh quan thay đổi liên tục từ sa mạc núi đá đến các thảo nguyên cỏ xanh.",
    link: "/thung-lung-markha"
  },
  { 
    id: "kang-yatze-2", 
    difficulty: "Trung cấp",
    badgeColor: "bg-amber-500",
    name: "Kang Yatze II", 
    location: "Markha Valley", 
    type: "Peak Expedition", 
    time: "9 - 11 ngày", 
    alt: "6.200m", 
    img: "https://media.fittour.vn/uploads/2023/06/vung-nui-zanskar.webp", 
    desc: "Thường được kết hợp với cung Markha Valley Trek để làm nóng cơ thể, Kang Yatze II (đỉnh vai) là một mục tiêu tuyệt vời cho dân trekker muốn nâng tầm lên Expedition. Bạn sẽ cần sử dụng kẹp móc (crampons) và rìu băng (ice axe) ở những đoạn cuối.<br/><br/>Bình minh nhìn từ đỉnh Kang Yatze chiếu rọi toàn bộ dãy Zanskar và Karakoram là trải nghiệm không thể nào quên."
  },
  { 
    id: "chadar", 
    difficulty: "Trung cấp - Khắc nghiệt",
    badgeColor: "bg-amber-500",
    name: "Chadar Trek", 
    location: "Zanskar River", 
    type: "Winter Trekking", 
    time: "8 - 9 ngày", 
    alt: "3.400m", 
    img: "https://media.fittour.vn/uploads/2022/06/vung-nui-quanh-doan-duong-ho-thieng-ladakh.webp", 
    desc: "Biểu tượng trekking mùa đông của Ladakh. Chadar có nghĩa là 'Tấm chăn', chỉ việc dòng sông Zanskar đóng băng hoàn toàn vào giữa tháng 1 và tháng 2 tạo thành một lối đi bằng kính băng xuyên qua hẻm núi sâu thẳm.<br/><br/>Độ khó của Chadar không nằm ở độ dốc, mà ở nhiệt độ có thể xuống tới -30 độ C. Đây là chuyến đi đòi hỏi sức chịu đựng cái rét cực hạn."
  },
  { 
    id: "kang-yatze-1", 
    difficulty: "Nâng cao",
    badgeColor: "bg-rose-600",
    name: "Kang Yatze I", 
    location: "Markha Valley", 
    type: "Technical Peak", 
    time: "12 - 14 ngày", 
    alt: "6.400m", 
    img: "https://media.fittour.vn/uploads/2023/06/vung-nui-zanskar.webp", 
    desc: "Nếu Kang Yatze II là đỉnh vai dễ tiếp cận, thì Kang Yatze I (đỉnh chính) là một câu chuyện hoàn toàn khác. Đường lên đỉnh rất dốc, đòi hỏi kỹ năng leo băng và đá phức tạp, cũng như biết sử dụng dây an toàn (rope work).<br/><br/>Đỉnh núi này chỉ dành cho những người leo núi đã có kinh nghiệm leo tuyết trước đó."
  },
  { 
    id: "mentok-kangri", 
    difficulty: "Nâng cao",
    badgeColor: "bg-rose-600",
    name: "Mentok Kangri", 
    location: "Khu vực Tso Moriri", 
    type: "Expedition", 
    time: "10 - 12 ngày", 
    alt: "6.250m", 
    img: "https://media.fittour.vn/uploads/2022/06/vung-nui-quanh-doan-duong-ho-thieng-ladakh.webp", 
    desc: "Sừng sững nhìn xuống hồ Tso Moriri, chuỗi đỉnh Mentok Kangri (1, 2 và 3) mang đến trải nghiệm thám hiểm đỉnh cao ở phía đông Ladakh. Hành trình yêu cầu băng qua các dải băng dài, vượt sườn dốc đá và tuyết.<br/><br/>Sự biệt lập của khu vực này đòi hỏi các đoàn phải tự chủ hoàn toàn về hậu cần và cấp cứu."
  },
  { 
    id: "nun-kun", 
    difficulty: "Chuyên nghiệp",
    badgeColor: "bg-slate-900",
    name: "Đỉnh Nun Kun", 
    location: "Suru Valley", 
    type: "Extreme Expedition", 
    time: "20+ ngày", 
    alt: "7.135m", 
    img: "https://media.fittour.vn/uploads/2023/06/vung-nui-zanskar.webp", 
    desc: "Từ đỉnh Nun Kun, người leo núi có thể quan sát những dòng sông băng rộng lớn của vùng Suru Valley. Đây là một trong những thử thách cao độ nhất tại toàn bộ vùng Ladakh, chỉ xếp sau các đỉnh 8000m ở Nepal.<br/><br/>Hành trình phù hợp tuyệt đối với các đoàn thám hiểm chuyên nghiệp đã có kinh nghiệm dày dạn trong việc leo núi tuyết, xử lý vết nứt băng (crevasse) và cắm trại sinh tồn ở cao độ khắc nghiệt (Alpine style)."
  }
];

---

<BaseLayout 
  title={seoTitle} 
  description={seoDesc} 
  image={seoImage}
  canonical="https://thericetour.com/leo-nui-o-ladakh"
  adminEditUrl={adminEditUrl}
>
  <Fragment slot="head">
    <meta property="og:type" content="article" />
    <meta property="article:author" content="Huỳnh Hiếu Travel" />
    <script type="application/ld+json" set:html={JSON.stringify([
      {
        "@context": "https://schema.org",
        "@type": "Article",
        "headline": seoTitle,
        "description": seoDesc,
        "image": seoImage,
        "author": {
          "@type": "Person",
          "name": "Huỳnh Hiếu Travel"
        },
        "publisher": {
          "@type": "Organization",
          "name": "FIT Tour",
          "logo": {
            "@type": "ImageObject",
            "url": "https://thericetour.com/favicon.png"
          }
        },
        "mainEntityOfPage": {
          "@type": "WebPage",
          "@id": "https://thericetour.com/leo-nui-o-ladakh"
        }
      },
      {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": [
          {
            "@type": "Question",
            "name": "Leo núi ở Ladakh có cần xin giấy phép không?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Có. Tùy thuộc vào cung đường, bạn sẽ cần Inner Line Permit (cho các khu vực biên giới thông thường) hoặc giấy phép từ IMF (Hội đồng leo núi Ấn Độ) đối với các hoạt động thám hiểm đỉnh núi kỹ thuật (Peak Expedition)."
            }
          },
          {
            "@type": "Question",
            "name": "Đỉnh núi 6000m nào dễ leo nhất cho người mới ở Ladakh?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Spangnak Ri (6.390m) hoặc Dzo Jongo (6.280m) thường được gợi ý vì đây là các đỉnh Non-technical (không yêu cầu kỹ năng leo băng đá bằng rìu băng chuyên nghiệp). Tuy nhiên, người leo vẫn cần có thể lực rất tốt và tuân thủ nghiêm ngặt nguyên tắc thích nghi độ cao."
            }
          },
          {
            "@type": "Question",
            "name": "Thời điểm nào tốt nhất để trekking tại Ladakh?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Mùa trekking đẹp nhất rơi vào từ tháng 6 đến giữa tháng 9. Nếu bạn muốn trải nghiệm đi bộ trên dòng sông băng, Chadar Trek chỉ diễn ra vào mùa đông (tháng 1 - tháng 2) khi nhiệt độ xuống dưới -30 độ C."
            }
          }
        ]
      },
      {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "name": "Trang chủ",
            "item": "https://thericetour.com/"
          },
          {
            "@type": "ListItem",
            "position": 2,
            "name": "Blog",
            "item": "https://thericetour.com/blog"
          },
          {
            "@type": "ListItem",
            "position": 3,
            "name": "Leo Núi & Trekking Ở Ladakh",
            "item": "https://thericetour.com/leo-nui-o-ladakh"
          }
        ]
      }
    ])} />
  </Fragment>

  <div class="bg-[#F8F9FA] text-[#1E293B] font-sans antialiased selection:bg-rose-600 selection:text-white">

    {/* ================= HERO SECTION ================= */}
    <section class="relative w-full h-[600px] lg:h-[650px] overflow-hidden">
      <div class="absolute inset-0 z-0 bg-slate-900">
        <img src={seoImage} alt="Leo núi ở Ladakh" class="w-full h-full object-cover object-center opacity-70" fetchpriority="high" loading="eager" />
        <div class="absolute inset-0 bg-gradient-to-r from-black/80 via-black/50 to-transparent"></div>
        <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-transparent to-transparent"></div>
      </div>

      <div class="relative z-10 max-w-[1600px] mx-auto px-4 sm:px-6 lg:px-12 h-full flex flex-col justify-center pt-20 pb-16">
        
        {/* Breadcrumb */}
        <div class="flex items-center gap-2 text-[13px] text-white/70 font-medium mb-6">
          <a href="/" class="hover:text-white transition-colors">Trang chủ</a>
          <ChevronRight class="w-3 h-3" />
          <a href="/blog" class="hover:text-white transition-colors">Blog</a>
          <ChevronRight class="w-3 h-3" />
          <span class="text-white">Ladakh Expedition</span>
        </div>

        {/* Titles */}
        <h1 class="font-serif text-4xl sm:text-5xl lg:text-6xl font-bold text-white mb-4 leading-[1.1] drop-shadow-lg max-w-4xl">
          Leo Núi & Trekking Ở Ladakh
        </h1>
        <h2 class="font-serif text-xl sm:text-3xl text-rose-400 italic mb-10 max-w-3xl drop-shadow-md">
          Chinh phục cực hạn nơi nóc nhà thế giới
        </h2>
        <p class="text-white/90 text-base sm:text-lg max-w-2xl leading-relaxed mb-8 hidden md:block drop-shadow-md font-medium">
          Dãy Himalaya hùng vĩ biến Ladakh thành thánh địa của những nhà thám hiểm. Dưới đây là cẩm nang sinh tồn, kinh nghiệm phòng chống say độ cao (AMS) và phân loại các cung đường trekking tốt nhất.
        </p>

        {/* Author Meta */}
        <div class="flex flex-wrap items-center gap-6 text-sm text-white/80 border-t border-white/20 pt-6 max-w-3xl">
          <a href="/huynh-hieu" class="flex items-center gap-3 group">
            <img src="https://media.fittour.vn/uploads/huynhhieutravel.webp" alt="Huynh Hieu" class="w-10 h-10 rounded-full border-2 border-white/30 object-cover object-top group-hover:border-rose-400 transition-colors" />
            <span class="font-bold text-white group-hover:text-rose-400 transition-colors flex items-center gap-1">
              Huỳnh Hiếu Travel
              <CheckCircle2 class="w-4 h-4 text-blue-400" />
            </span>
          </a>
          <div class="flex items-center gap-2 bg-white/10 px-4 py-2 rounded-full backdrop-blur-sm border border-white/10">
            <Calendar class="w-4 h-4 opacity-70" />
            <span>Cập nhật: {formattedDate}</span>
          </div>
          <div class="flex items-center gap-2 bg-black/20 px-3 py-1.5 rounded-full backdrop-blur-sm">
            <Clock class="w-4 h-4 text-rose-400" />
            <span>20 phút đọc</span>
          </div>
        </div>

        {/* Badges Line */}
        <div class="flex flex-wrap items-center gap-4 mt-8 pt-6">
          <div class="flex items-center gap-2 text-sm text-white font-medium bg-black/60 backdrop-blur-md px-4 py-2 border border-white/10 rounded-lg shadow-xl">
            <span class="text-rose-400 text-lg">⛰️</span> Nóc nhà Himalaya
          </div>
          <div class="flex items-center gap-2 text-sm text-white font-medium bg-black/60 backdrop-blur-md px-4 py-2 border border-white/10 rounded-lg shadow-xl">
            <span class="text-rose-400 text-lg">🎒</span> 12+ Cung Trekking
          </div>
          <div class="flex items-center gap-2 text-sm text-white font-medium bg-black/60 backdrop-blur-md px-4 py-2 border border-white/10 rounded-lg shadow-xl">
            <span class="text-rose-400 text-lg">⛺</span> Cẩm nang Sinh Tồn
          </div>
        </div>

      </div>
    </section>

    {/* ================= MAIN CONTENT GRID ================= */}
    <div class="max-w-[1600px] mx-auto px-4 sm:px-6 lg:px-12 py-12 lg:py-16">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-start">

        {/* ---------------- LEFT SIDEBAR (TOC) ---------------- */}
        <aside class="hidden lg:block lg:col-span-3 sticky top-24">
          <div class="bg-white rounded-2xl shadow-sm border border-slate-200/60 p-6 overflow-hidden">
            <div class="flex items-center gap-2 font-bold text-slate-800 mb-6 border-l-4 border-rose-500 pl-3 text-sm tracking-wide uppercase">
              Mục lục bài viết
            </div>
            
            <nav class="space-y-1 text-[13.5px] font-medium">
              <a href="#cam-nang-sinh-ton" class="flex items-center gap-2 text-rose-700 bg-rose-50 px-3 py-2.5 rounded-lg transition-colors font-bold">
                <span class="text-rose-500 text-base">⚠️</span> Cẩm nang sinh tồn
              </a>
              <div class="pl-9 pr-3 space-y-1.5 mt-1 border-l border-slate-100 ml-[18px]">
                <a href="#say-do-cao-ams" class="block text-slate-500 hover:text-rose-600 text-[13px] py-1 transition-colors">Hội chứng AMS</a>
                <a href="#giay-phep-imf" class="block text-slate-500 hover:text-rose-600 text-[13px] py-1 transition-colors">Giấy phép leo núi</a>
              </div>
              
              <div class="pt-4 pb-1">
                <a href="#danh-sach-cung-duong" class="flex items-center gap-2 text-slate-700 hover:text-rose-600 px-3 py-2 rounded-lg transition-colors font-bold">
                  <span class="text-slate-400 text-base">🗺️</span> Phân loại điểm đến
                </a>
                <div class="pl-9 pr-3 space-y-1.5 mt-1 border-l border-slate-100 ml-[18px] max-h-[500px] overflow-y-auto custom-scrollbar">
                  {routes.map((r, i) => (
                    <a href={`#${r.id}`} class="block text-slate-500 hover:text-rose-600 text-[13px] py-1 transition-colors leading-tight">
                      {r.name} <span class="text-[10px] text-slate-400 ml-1">({r.difficulty})</span>
                    </a>
                  ))}
                </div>
              </div>
            </nav>
          </div>
        </aside>

        {/* ---------------- CENTER COLUMN (MAIN CONTENT) ---------------- */}
        <main class="col-span-1 lg:col-span-6 space-y-12">
          
          {/* Cẩm nang sinh tồn */}
          <div id="cam-nang-sinh-ton" class="bg-white rounded-2xl shadow-sm border border-slate-200/60 p-8 prose prose-slate max-w-none prose-p:leading-relaxed prose-p:text-[15.5px]">
            <h2 class="font-serif text-3xl font-bold text-slate-900 border-b-2 border-rose-500 pb-2 inline-block mb-8">Cẩm Nang Sinh Tồn Cơ Bản</h2>
            
            {/* Say Độ Cao */}
            <div id="say-do-cao-ams" class="mb-10">
              <div class="flex items-center gap-3 mb-4">
                <div class="w-10 h-10 bg-rose-100 text-rose-600 rounded-lg flex items-center justify-center shrink-0">
                  <AlertTriangle class="w-5 h-5" />
                </div>
                <h3 class="font-bold text-xl m-0 text-slate-800">Say Độ Cao Khi Leo Núi Ở Ladakh (AMS)</h3>
              </div>
              <p>Đây là rủi ro lớn nhất và mang tính chí mạng khi trekking tại địa hình Himalaya. Với độ cao trung bình trên 3.500m, nồng độ oxy trong không khí tại Ladakh thấp hơn khoảng 30-40% so với mực nước biển.</p>
              <p><strong>Triệu chứng nhận biết:</strong> Đau đầu dội (như búa bổ), buồn nôn, chán ăn, khó ngủ, chóng mặt, và mệt mỏi cùng cực dù chỉ đi bộ nhẹ.</p>
              <div class="bg-slate-50 p-5 rounded-xl border border-slate-100 my-4">
                <h4 class="font-bold text-slate-700 m-0 mb-3 text-sm uppercase">Nguyên tắc phòng tránh vàng:</h4>
                <ul class="m-0 space-y-2 text-[14.5px]">
                  <li><strong>Thích nghi (Acclimatization):</strong> Bắt buộc phải nghỉ ngơi hoàn toàn tại Leh (3.500m) ít nhất 48 giờ trước khi bắt đầu bất kỳ hoạt động trekking nào.</li>
                  <li><strong>Leo cao, ngủ thấp:</strong> Nếu leo lên đèo 5000m vào ban ngày, hãy đảm bảo hạ trại ngủ đêm ở độ cao thấp hơn (khoảng 4000m).</li>
                  <li><strong>Uống nước liên tục:</strong> Khí hậu sa mạc lạnh khiến bạn mất nước qua hơi thở rất nhanh. Uống ít nhất 4-5 lít nước/ngày. Cháo tỏi và súp lỏng rất được dân bản địa khuyên dùng.</li>
                  <li><strong>Lắng nghe cơ thể:</strong> Tuyệt đối không giấu diếm triệu chứng với Guide. Không lạm dụng Diamox nếu chưa hỏi ý kiến chuyên gia y tế thám hiểm.</li>
                </ul>
              </div>
            </div>

            {/* Giấy Phép */}
            <div id="giay-phep-imf">
              <div class="flex items-center gap-3 mb-4">
                <div class="w-10 h-10 bg-emerald-100 text-emerald-600 rounded-lg flex items-center justify-center shrink-0">
                  <ShieldCheck class="w-5 h-5" />
                </div>
                <h3 class="font-bold text-xl m-0 text-slate-800">Thông Tin Giấy Phép (Permits)</h3>
              </div>
              <p class="mb-4">Khác với những chuyến du lịch ngắm cảnh thông thường (chỉ cần Inner Line Permit), hoạt động thám hiểm các đỉnh cao (Peak Expedition) tại Ladakh được quản lý cực kỳ gắt gao do nằm sát biên giới nhạy cảm.</p>
              <div class="border-l-4 border-emerald-500 bg-emerald-50 p-4 text-[14px] text-emerald-900 rounded-r-lg font-medium">
                Quy định giấy phép và thủ tục leo núi tại Ladakh có thể thay đổi theo từng năm. Tùy thuộc vào đỉnh núi mà bạn chọn, hồ sơ sẽ được xét duyệt bởi Hội đồng leo núi Ấn Độ (Indian Mountaineering Foundation - IMF) hoặc Liên đoàn thám hiểm địa phương. <strong>Du khách nên kiểm tra thông tin mới nhất từ IMF hoặc giao toàn quyền xử lý pháp lý cho đơn vị tổ chức (như FIT Tour) trước khi khởi hành.</strong>
              </div>
            </div>
            
            {/* Lệnh cấm Stok Kangri */}
            <div class="mt-8 bg-[#2D333A] text-white p-5 rounded-xl border border-slate-700 shadow-md">
              <div class="flex items-start gap-3">
                <Info class="w-5 h-5 text-amber-400 mt-1 shrink-0" />
                <div>
                  <h4 class="font-bold text-lg m-0 mb-1 text-white">Lưu ý về Đỉnh Stok Kangri</h4>
                  <p class="text-[14px] m-0 text-slate-300"><a href="/stok-kangri/" class="text-rose-400 hover:underline font-bold" target="_blank">Stok Kangri</a> từng là đỉnh 6000m nổi tiếng và đông đúc nhất thế giới. Tuy nhiên, <strong class="text-white font-bold">hiện tại khu vực này đã bị đóng cửa với phần lớn hoạt động leo núi từ nhiều năm nay</strong> để phục hồi sinh thái môi trường và ngăn chặn sự tan chảy của các dòng sông băng. Đừng tin vào các tour giá rẻ hứa hẹn đưa bạn lên Stok Kangri lúc này.</p>
                </div>
              </div>
            </div>

          </div>

          <div class="flex items-center justify-center py-4 opacity-40">
            <div class="w-16 h-px bg-slate-400"></div>
            <span class="mx-4 text-rose-600 text-xl">🏔️</span>
            <div class="w-16 h-px bg-slate-400"></div>
          </div>

          {/* Phân loại các cung đường */}
          <div id="danh-sach-cung-duong" class="space-y-16">
            <h2 class="font-serif text-3xl font-bold text-slate-900 text-center mb-8">Danh Sách Cung Đường & Đỉnh Núi Ladakh để leo núi<br/><span class="text-lg text-slate-500 font-sans font-normal block mt-2">Được phân loại theo cấp độ kỹ năng</span></h2>

            {routes.map((r, i) => (
              <div id={r.id} class="scroll-mt-28 group">
                
                {/* Title */}
                <div class="flex flex-wrap items-center gap-4 mb-4">
                  <h3 class="font-serif text-2xl lg:text-[26px] font-bold text-slate-900 m-0">
                    {i + 1}. {r.name}
                  </h3>
                  <div class={`text-[11px] font-bold uppercase tracking-wider text-white px-3 py-1 rounded-full shadow-sm ${r.badgeColor}`}>
                    {r.difficulty}
                  </div>
                </div>

                {/* Card */}
                <div class="bg-white rounded-2xl shadow-sm border border-slate-200/60 overflow-hidden mb-5 transition-shadow hover:shadow-md">
                  {/* Image */}
                  <div class="relative aspect-video w-full bg-slate-100 overflow-hidden">
                    <img src={r.img} alt={r.name} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-1000" loading="lazy" />
                    <div class="absolute bottom-4 right-4 bg-slate-900/80 backdrop-blur-md text-white text-xs font-bold px-3 py-1.5 rounded-full border border-white/20 flex items-center gap-1.5 shadow-lg">
                      <span>🏔️</span> {r.alt}
                    </div>
                  </div>

                  {/* Info Bar */}
                  <div class="bg-[#2D333A] text-white/90 px-4 py-3 flex flex-wrap items-center gap-y-2 gap-x-6 text-[13px] font-medium border-t border-slate-800">
                    <div class="flex items-center gap-1.5">
                      <MapPin class="w-3.5 h-3.5 text-rose-400" />
                      <span>{r.location}</span>
                    </div>
                    <div class="flex items-center gap-1.5">
                      <Compass class="w-3.5 h-3.5 text-rose-400" />
                      <span>{r.type}</span>
                    </div>
                    <div class="flex items-center gap-1.5">
                      <Clock class="w-3.5 h-3.5 text-rose-400" />
                      <span>{r.time}</span>
                    </div>
                  </div>
                </div>

                {/* Description */}
                <div class="text-slate-700 text-[15.5px] leading-relaxed mb-6 font-medium [&>br]:mb-2 bg-white p-6 rounded-2xl border border-slate-200/60 shadow-sm" set:html={r.desc}></div>

                {/* Button */}
                {r.link && (
                  <a href={r.link} class="inline-flex items-center gap-2 border border-rose-600 text-rose-700 hover:bg-rose-50 px-5 py-2.5 rounded-lg text-sm font-bold transition-colors">
                    {r.buttonText || `Đọc thêm về ${r.name}`} <ChevronRight class="w-4 h-4" />
                  </a>
                )}

              </div>
            ))}
          </div>

          <div class="flex items-center justify-center py-4 opacity-40">
            <div class="w-16 h-px bg-slate-400"></div>
            <span class="mx-4 text-rose-600 text-xl">🏔️</span>
            <div class="w-16 h-px bg-slate-400"></div>
          </div>

          {/* FAQs Section */}
          <div id="faqs" class="bg-slate-50 rounded-2xl border border-slate-200/60 p-8">
            <h2 class="font-serif text-2xl font-bold text-slate-900 mb-6 flex items-center gap-2">
              <span class="text-rose-500">❓</span> Câu Hỏi Thường Gặp (FAQs)
            </h2>
            <div class="space-y-6">
              <div>
                <h3 class="text-[16px] font-bold text-slate-800 mb-2">Leo núi ở Ladakh có cần xin giấy phép không?</h3>
                <p class="text-[14.5px] text-slate-600 leading-relaxed m-0">Có. Tùy thuộc vào cung đường, bạn sẽ cần Inner Line Permit (cho các khu vực biên giới thông thường) hoặc giấy phép từ IMF (Hội đồng leo núi Ấn Độ) đối với các hoạt động thám hiểm đỉnh núi kỹ thuật (Peak Expedition).</p>
              </div>
              <div class="h-px bg-slate-200"></div>
              <div>
                <h3 class="text-[16px] font-bold text-slate-800 mb-2">Đỉnh núi 6000m nào dễ leo nhất cho người mới ở Ladakh?</h3>
                <p class="text-[14.5px] text-slate-600 leading-relaxed m-0">Spangnak Ri (6.390m) hoặc Dzo Jongo (6.280m) thường được gợi ý vì đây là các đỉnh "Non-technical" (không yêu cầu kỹ năng leo băng đá bằng rìu băng chuyên nghiệp). Tuy nhiên, người leo vẫn cần có thể lực rất tốt và tuân thủ nghiêm ngặt nguyên tắc thích nghi độ cao.</p>
              </div>
              <div class="h-px bg-slate-200"></div>
              <div>
                <h3 class="text-[16px] font-bold text-slate-800 mb-2">Thời điểm nào tốt nhất để trekking tại Ladakh?</h3>
                <p class="text-[14.5px] text-slate-600 leading-relaxed m-0">Mùa trekking đẹp nhất rơi vào từ tháng 6 đến giữa tháng 9. Nếu bạn muốn trải nghiệm đi bộ trên dòng sông băng, Chadar Trek chỉ diễn ra vào mùa đông (tháng 1 - tháng 2) khi nhiệt độ xuống dưới -30 độ C.</p>
              </div>
            </div>
          </div>

        </main>

        {/* ---------------- RIGHT SIDEBAR ---------------- */}
        <aside class="col-span-1 lg:col-span-3">
          <div class="sticky top-24 space-y-8">
            
          {/* Quick Facts */}
          <div class="bg-white rounded-2xl shadow-sm border border-slate-200/60 p-6">
