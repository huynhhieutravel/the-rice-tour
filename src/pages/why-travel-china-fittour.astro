<script>
  document.addEventListener('DOMContentLoaded', () => {
    const tabBtns = document.querySelectorAll('.tab-btn');
    const tabContents = document.querySelectorAll('.tab-content');

    tabBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        // Reset all
        tabBtns.forEach(b => {
          b.classList.remove('text-[#c5a365]', 'active', 'bg-black/60', 'shadow-md'); b.classList.add('hover:bg-white/5');
          b.classList.add('text-white/50');
        });
        tabContents.forEach(content => {
          content.classList.add('hidden');
          content.classList.remove('animate-fade-in');
        });

        // Activate clicked
        btn.classList.add('text-[#c5a365]', 'active', 'bg-black/60', 'shadow-md'); btn.classList.remove('hover:bg-white/5');
        btn.classList.remove('text-white/50');
        
        const targetId = btn.getAttribute('data-target');
        const targetContent = document.getElementById(targetId);
        if (targetContent) {
          targetContent.classList.remove('hidden');
          // trigger reflow
          void targetContent.offsetWidth; 
          targetContent.classList.add('animate-fade-in');
        }
      });
    });
  });
</script>

