---
import BaseLayout from '../layouts/BaseLayout.astro';
import { env } from 'cloudflare:workers';
import { safeQueryCritical } from '../lib/db-client';
import SnippetBlock from '../components/shortcodes/SnippetBlock.astro';
import TourGallery from '../components/tour/TourGallery.astro';
import ChinaBottomMenu from '../components/china/ChinaBottomMenu.astro';

const seoTitle = "Why Travel China with FIT TOUR | Hơn Cả Một Chuyến Đi";
const seoDesc = "Khám phá Trung Hoa nguyên bản cùng FIT TOUR. Trải nghiệm hành trình 0 điểm shopping, tàu cao tốc 350km/h, khách sạn 4-5 sao trung tâm và những câu chuyện văn hóa sâu sắc.";
const ogImage = "https://media.fittour.vn/uploads/2023/11/thuong-hai-ve-dem.webp";

const d1Db = env?.dulichcoguu_d1;
let chinaEmagazineSnippet = null;

if (d1Db) {
  try {
    chinaEmagazineSnippet = await safeQueryCritical(
      d1Db.prepare("SELECT * FROM Snippet WHERE slug = 'china-emagazine'").first(),
      { route: Astro.url.pathname, slug: "china-emagazine", queryType: "fetch_snippet" }
    );
  } catch (e) {
    console.log("Could not fetch snippet from D1:", e);
  }
}

const dataMap = {
  snippets: {
    'china-emagazine': chinaEmagazineSnippet
  }
};
---
