<script is:inline>
  function initReveal() {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('active');
        }
      });
    }, {
      threshold: 0.1,
      rootMargin: "0px 0px -50px 0px"
    });

    document.querySelectorAll('.reveal-up').forEach(el => {
      observer.observe(el);
    });
  }
  
  if (document.readyState === 'loading') {
    document.addEventListener("DOMContentLoaded", initReveal);
  } else {
    initReveal();
  }
  document.addEventListener("astro:page-load", initReveal);

  function initSnippetSliders() {
    const emagazineSlider = document.getElementById("slider-container");
    const emagPrev = document.getElementById("slider-prev");
    const emagNext = document.getElementById("slider-next");

    if (emagazineSlider) {
      const card = emagazineSlider.firstElementChild;
      const gap = parseInt(window.getComputedStyle(emagazineSlider).gap) || 24;
      const scrollAmount = card ? card.clientWidth + gap : emagazineSlider.clientWidth * 0.5;

      if (emagPrev) {
        emagPrev.addEventListener("click", () => {
          emagazineSlider.scrollBy({ left: -scrollAmount, behavior: "smooth" });
        });
      }
      if (emagNext) {
        emagNext.addEventListener("click", () => {
          emagazineSlider.scrollBy({ left: scrollAmount, behavior: "smooth" });
        });
      }

      // Drag to scroll
      let isDown = false;
      let startX = 0;
      let scrollLeft = 0;

      emagazineSlider.addEventListener('mousedown', (e) => {
        isDown = true;
        emagazineSlider.style.cursor = 'grabbing';
        startX = e.pageX - emagazineSlider.offsetLeft;
        scrollLeft = emagazineSlider.scrollLeft;
      });
      emagazineSlider.addEventListener('mouseleave', () => {
        isDown = false;
        emagazineSlider.style.cursor = 'grab';
      });
      emagazineSlider.addEventListener('mouseup', () => {
        isDown = false;
        emagazineSlider.style.cursor = 'grab';
      });
      emagazineSlider.addEventListener('mousemove', (e) => {
        if (!isDown) return;
        e.preventDefault();
        const x = e.pageX - emagazineSlider.offsetLeft;
        const walk = (x - startX) * 2;
        emagazineSlider.scrollLeft = scrollLeft - walk;
      });
    }
  }

  document.addEventListener("DOMContentLoaded", initSnippetSliders);
  document.addEventListener("astro:page-load", initSnippetSliders);
</script>

<style is:global>
  .reveal-up {
    opacity: 0;
    transform: translateY(30px);
    transition: opacity 1s cubic-bezier(0.16, 1, 0.3, 1), transform 1s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .reveal-up.active {
    opacity: 1;
    transform: translateY(0);
  }
</style>
