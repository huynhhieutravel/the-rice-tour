---
import { env } from 'cloudflare:workers';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { safeQueryCritical } from '@/lib/db-client';
import { getGlobalSettings } from '@/lib/settingsHelper';
import JsonLdSchema from '@/components/seo/JsonLdSchema.astro';

// --- SSR D1 DATABASE QUERY ---
const currentSlug = 'is-a-cu-chi-tunnels-private-tour-worth';

const d1Db = env?.dulichcoguu_d1 || (Astro.locals as any)?.runtime?.env?.dulichcoguu_d1;
let post: any = null;
try {
  if (d1Db) {
    post = await safeQueryCritical(
      d1Db.prepare("SELECT * FROM Post WHERE slug = ? AND (status = 'published' OR status = 'publish')").bind(currentSlug).first<any>(),
      { route: Astro.url.pathname, slug: currentSlug, queryType: "fetch_post_by_slug" }
    );
  }
} catch (e) {
  console.warn('[D1 Query Warning] is-a-cu-chi-tunnels-private-tour-worth:', e);
}

// Fallback metadata if D1 is not yet populated
if (!post) {
  post = {
    id: 19809,
    title: 'Is A Cu Chi Tunnels Private Tour Worth the Extra Cost? An Honest Breakdown',
    slug: currentSlug,
    excerpt: 'An honest 2026 price and value breakdown: what a Cu Chi Tunnels private tour actually buys you, how group size affects per-person cost, and whether a dedicated guide justifies the extra expense.',
    featuredImage: 'https://media.thericetour.com/uploads/two-girls-posing-rusted-tank-cu-chi-tunnels-the-rice.webp',
    readingTime: 14,
    author: 'The Rice Tour Editorial',
    createdAt: '2026-09-16T12:00:00.000Z',
    publishedAt: '2026-09-16T12:00:00.000Z',
    updatedAt: '2026-09-16T12:00:00.000Z'
  };
}

const { settings } = await getGlobalSettings();

const pageTitle = post?.title || 'Is A Cu Chi Tunnels Private Tour Worth the Extra Cost? An Honest Breakdown';
const pageDesc = post?.excerpt || 'An honest 2026 price and value breakdown: what a Cu Chi Tunnels private tour actually buys you, how group size affects per-person cost, and whether a dedicated guide justifies the extra expense.';

const seoTitle = post?.seoTitle || post?.metaTitle || `${pageTitle} | The Rice Tour`;
const seoDesc = post?.seoDescription || 'Is a Cu Chi Tunnels private tour worth it? 2026 price comparisons, large bus vs small group vs private tour, guide value, group size formulas, and honest tips.';
const seoImage = post?.ogImage || post?.featuredImage || 'https://media.thericetour.com/uploads/two-girls-posing-rusted-tank-cu-chi-tunnels-the-rice.webp';

// --- DATE LOGIC (E-E-A-T Compliant) ---
const createdAtStr = post.createdAt || post.publishedAt || '2026-09-16T12:00:00.000Z';
const updatedAtStr = post.updatedAt || '2026-09-16T12:00:00.000Z';

const createdAt = new Date(createdAtStr.replace(' ', 'T'));
const updatedAt = new Date(updatedAtStr.replace(' ', 'T'));

const isUpdated = updatedAt.getTime() - createdAt.getTime() > 86400000;
const displayDate = isUpdated ? updatedAt : createdAt;
const datePrefix = isUpdated ? "Updated:" : "Published:";
const formattedDate = displayDate.toLocaleDateString('en-US', { day: 'numeric', month: 'long', year: 'numeric' });

// --- AUTHOR LOGIC ---
const authorMap: Record<string, any> = {
  "The Rice Tour Editorial": {
    name: "The Rice Tour Editorial",
    url: "/about-us",
    img: "https://media.thericetour.com/uploads/the-rice-tour-editorial-avatar.webp"
  },
  "Huynh Hieu Travel": {
    name: "Huynh Hieu Travel",
    url: "/about-us",
    img: "https://media.thericetour.com/uploads/huynhhieutravel.webp"
  }
};
const authorData = authorMap[post.author] || authorMap["The Rice Tour Editorial"];

// --- TABLE OF CONTENTS (TOC) ---
const tocItems = [
  { id: "gioi-thieu", title: "Introduction" },
  { id: "costs-in-2026", title: "Cu Chi Private Tour Costs in 2026" },
  { id: "car-vs-tour", title: "Private Car vs. Private Tour" },
  { id: "waiting-time", title: "Waiting Time vs. Driving Time" },
  { id: "cost-per-person", title: "How Cost Scales With Group Size" },
  { id: "comparison-matrix", title: "Matrix: Bus vs. Small Group vs. Private" },
  { id: "what-you-pay-for", title: "What Are You Actually Paying For?" },
  { id: "guide-vs-car", title: "When Is The Guide Worth More Than The Car?" },
  { id: "shopping-stops", title: "Does Private Guarantee No Shopping?" },
  { id: "ben-duoc-access", title: "Does Private Travel Make Ben Duoc Accessible?" },
  { id: "tunnel-crawl", title: "What About The Tunnel Crawl?" },
  { id: "who-benefits", title: "Who Benefits Most From Private Tours?" },
  { id: "who-should-choose-group", title: "Who Is Better Off With Group Tours?" },
  { id: "calculate-premium", title: "Tactical Formula: Calculate Your Premium" },
  { id: "pre-booking-checklist", title: "12-Question Pre-Booking Checklist" },
  { id: "recommended-tours", title: "Recommended Cu Chi Experiences" },
  { id: "frequently-asked-questions", title: "Frequently Asked Questions (FAQ)" },
  { id: "epilogue", title: "The True Value: Control Over Your Time" }
];

// SSR JSON-LD Schemas
const currentOrigin = 'https://thericetour.com';
const canonicalUrl = `${currentOrigin}/${currentSlug}`;

const breadcrumbSchema = {
  items: [
    { name: "Home", url: `${currentOrigin}/` },
    { name: "Travel Guides", url: `${currentOrigin}/blog` },
    { name: pageTitle, url: canonicalUrl }
  ]
};

const faqSchema = {
  questions: [
    {
      question: "How much does a private Cu Chi tour cost per person?",
      answer: "In 2026, private tour pricing ranges from approximately US$44 to $110+ per person. The per-person rate depends heavily on party size: solo travelers pay around US$130–$150, couples pay US$70–$85 per person, and families of four or more pay US$40–$55 per person."
    },
    {
      question: "Is a private tour faster than a shared bus?",
      answer: "A private vehicle does not bypass highway traffic, but it eliminates 45 to 60 minutes of multi-hotel pickups in District 1 and skips 30-minute commercial shopping detours. This allows you to arrive at the site well ahead of tour bus crowds and return to Saigon by lunchtime."
    },
    {
      question: "Can you visit Cu Chi Tunnels without a guide?",
      answer: "Yes. You can book a private car with driver only. When you purchase your entrance ticket at the gate (135,000 VND for international visitors), the management board assigns an on-site local guide to lead your party through the trails. However, having a dedicated licensed guide in your private vehicle provides richer historical depth throughout the entire day."
    },
    {
      question: "Which is better on a private tour: Ben Dinh or Ben Duoc?",
      answer: "For a private tour, Ben Duoc is generally the superior choice. It is situated in a larger, quieter forested park with far fewer tour buses and includes the Ben Duoc Memorial Temple. If you have limited time or are traveling with young children, Ben Dinh saves roughly 40 minutes of driving each way."
    },
    {
      question: "Is the tunnel crawl mandatory?",
      answer: "No. Entering the underground tunnels is completely optional. All walking routes take place above ground through forested trails with open-air displays, historical exhibits, and reconstructed bunkers."
    },
    {
      question: "Do private tours include the shooting range?",
      answer: "Private tours typically include a stop near the National Defense Sports Shooting Range at Cu Chi. However, ammunition is not included in the tour price and must be purchased separately on-site (minimum purchase of 10 rounds, typically ~60,000 VND / $2.40 per bullet). If you prefer a quiet visit, your private guide can easily bypass this section."
    },
    {
      question: "What should you wear on a private Cu Chi tour?",
      answer: "Wear lightweight, breathable cotton or linen clothing, comfortable walking sneakers with good grip, and mosquito repellent. If you plan to crawl through the tunnels, wear darker clothes that can tolerate reddish dirt and dust."
    },
    {
      question: "Is Cu Chi Tunnels recognized by UNESCO?",
      answer: "Not yet as an inscribed World Heritage Site. Vietnam officially submitted Cu Chi Tunnels to UNESCO's World Heritage Tentative List on July 15, 2026, under cultural criteria (iv) and (vi). Approximately 4 km of surviving tunnels are actively preserved across Ben Duoc and Ben Dinh."
    }
  ]
};

const articleSchema = {
  title: pageTitle,
  description: pageDesc,
  image: seoImage,
  datePublished: createdAtStr,
  dateModified: updatedAtStr,
  authorName: authorData.name,
  authorUrl: `${currentOrigin}${authorData.url}`,
  publisherName: "The Rice Tour",
  publisherLogo: "https://media.thericetour.com/uploads/logo-the-rice.webp",
  url: canonicalUrl
};
---

<BaseLayout title={seoTitle} description={seoDesc} image={seoImage}>
  <JsonLdSchema type="breadcrumb" data={breadcrumbSchema} />
  <JsonLdSchema type="article" data={articleSchema} />
  <JsonLdSchema type="faq" data={faqSchema} />

  <!-- HERO SECTION HEADER (Full-width, Dark Magazine Style) -->
  <header class="relative bg-slate-950 text-white pt-28 pb-20 md:pt-36 md:pb-28 overflow-hidden">
    <!-- Background Image with Multi-layer Gradients -->
    <div class="absolute inset-0 z-0">
      <img 
        src={seoImage} 
        alt={pageTitle}
        class="w-full h-full object-cover object-center brightness-75 scale-105 transform motion-safe:animate-subtle-zoom"
        loading="eager"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/75 to-slate-950/40"></div>
      <div class="absolute inset-0 bg-gradient-to-r from-slate-950/90 via-slate-950/50 to-transparent"></div>
    </div>

    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Breadcrumbs -->
      <nav class="flex items-center gap-2 text-xs sm:text-sm text-slate-300/80 mb-6" aria-label="Breadcrumb">
        <a href="/" class="hover:text-white transition-colors">Home</a>
        <span>/</span>
        <a href="/blog" class="hover:text-white transition-colors">Travel Guides</a>
        <span>/</span>
        <span class="text-amber-400 font-medium truncate max-w-xs sm:max-w-md">{pageTitle}</span>
      </nav>

      <!-- Main Title -->
      <h1 class="font-serif text-3xl sm:text-4xl lg:text-5xl xl:text-6xl font-bold text-white mb-4 leading-[1.15] drop-shadow-lg max-w-5xl">
        {pageTitle}
      </h1>

      <!-- Subtitle -->
      <h2 class="font-serif text-lg sm:text-2xl lg:text-3xl text-amber-400 italic mb-8 max-w-4xl drop-shadow-md font-medium">
        An honest 2026 cost and value comparison between standard buses, small groups, private cars, and fully guided private tours.
      </h2>

      <!-- Lead Paragraph -->
      <p class="text-white/90 text-base sm:text-lg max-w-3xl leading-relaxed mb-8 hidden md:block drop-shadow-md font-normal">
        A private tour to Cu Chi can cost several times more than a shared bus ticket. But the premium does not buy a faster highway; it buys control over your schedule, direct hotel pickup, your choice of Ben Dinh or Ben Duoc, and a dedicated guide who can answer your questions at your own walking pace.
      </p>

      <!-- Author Meta Row -->
      <div class="flex flex-wrap items-center gap-6 pt-4 border-t border-white/15 text-sm text-slate-300">
        <div class="flex items-center gap-3">
          <img 
            src={authorData.img} 
            alt={authorData.name} 
            class="w-10 h-10 rounded-full border-2 border-amber-400 object-cover shadow-sm"
          />
          <div>
            <div class="font-semibold text-white flex items-center gap-1.5">
              {authorData.name}
              <svg class="w-4 h-4 text-amber-400" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
              </svg>
            </div>
            <div class="text-xs text-slate-300/80">Inbound Travel Specialist</div>
          </div>
        </div>

        <div class="flex items-center gap-4 text-xs sm:text-sm text-slate-300/90 ml-auto">
          <span>{datePrefix} <time datetime={displayDate.toISOString()}>{formattedDate}</time></span>
          <span>•</span>
          <span>{post.readingTime || 14} min read</span>
          <span>•</span>
          <span class="inline-flex items-center gap-1 text-emerald-400 font-medium">
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span> 2026 Verified
          </span>
        </div>
      </div>

      <!-- Feature Badges -->
      <div class="flex flex-wrap gap-2.5 mt-6 pt-4 border-t border-white/10">
        <span class="bg-black/60 backdrop-blur-md px-3.5 py-2 border border-white/10 rounded-lg shadow-xl text-xs sm:text-sm text-white font-medium">
          💰 2026 Price Comparison
        </span>
        <span class="bg-black/60 backdrop-blur-md px-3.5 py-2 border border-white/10 rounded-lg shadow-xl text-xs sm:text-sm text-white font-medium">
          ⚖️ Bus vs. Small Group vs. Private
        </span>
        <span class="bg-black/60 backdrop-blur-md px-3.5 py-2 border border-white/10 rounded-lg shadow-xl text-xs sm:text-sm text-white font-medium">
          👥 Group Size Cost Scaling
        </span>
        <span class="bg-black/60 backdrop-blur-md px-3.5 py-2 border border-white/10 rounded-lg shadow-xl text-xs sm:text-sm text-white font-medium">
          🏛️ UNESCO 2026 Context
        </span>
      </div>
    </div>
  </header>

  <!-- 3-COLUMN MAGAZINE LAYOUT CONTAINER -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-16">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start">

      <!-- LEFT COLUMN: Sticky Table of Contents -->
      <aside class="hidden lg:block lg:col-span-3 sticky top-24">
        <div class="bg-white rounded-2xl shadow-sm border border-slate-200/80 p-5 max-h-[calc(100vh-7rem)] overflow-y-auto custom-scrollbar">
          <div class="flex items-center gap-2 font-bold text-slate-900 mb-4 border-l-4 border-amber-500 pl-3 text-xs tracking-wider uppercase">
            Table of Contents
          </div>
          <nav class="space-y-1 text-[13.5px] font-medium pr-1">
            <a href="#gioi-thieu" class="flex items-center gap-2 text-amber-900 bg-amber-50/80 px-3 py-2 rounded-lg transition-colors font-bold text-[13.5px]">
              <span class="text-amber-600 text-base">🏠</span> Introduction
            </a>
            
            <div class="pt-1.5 space-y-1 border-l border-slate-200 ml-3 pl-3">
              {tocItems.slice(1).map((item) => (
                <a 
                  href={`#${item.id}`} 
                  class="block transition-colors leading-snug py-1.5 text-slate-600 hover:text-amber-800 font-semibold text-[13px]"
                >
                  {item.title}
                </a>
              ))}
            </div>
          </nav>
        </div>
      </aside>

      <!-- CENTER COLUMN: Main Content Body -->
      <main class="col-span-1 lg:col-span-6 space-y-10">

        <!-- 4-Card Quick Overview Stats Bar -->
        <div class="bg-white rounded-2xl shadow-sm border border-slate-200/80 p-5 sm:p-6 grid grid-cols-2 sm:grid-cols-4 gap-4 text-center">
          <div class="p-3 rounded-xl bg-slate-50 border border-slate-100">
            <div class="text-xl sm:text-2xl mb-1">🚌</div>
            <div class="text-[11px] uppercase tracking-wider text-slate-400 font-semibold">Shared Bus</div>
            <div class="text-sm sm:text-base font-bold text-slate-900 mt-0.5">$13–$20 / pax</div>
          </div>
          <div class="p-3 rounded-xl bg-slate-50 border border-slate-100">
            <div class="text-xl sm:text-2xl mb-1">🚐</div>
            <div class="text-[11px] uppercase tracking-wider text-slate-400 font-semibold">Small Group</div>
            <div class="text-sm sm:text-base font-bold text-slate-900 mt-0.5">$18–$35 / pax</div>
          </div>
          <div class="p-3 rounded-xl bg-amber-50/80 border border-amber-200">
            <div class="text-xl sm:text-2xl mb-1">🚗</div>
            <div class="text-[11px] uppercase tracking-wider text-amber-800 font-semibold">Private Tour</div>
            <div class="text-sm sm:text-base font-bold text-amber-950 mt-0.5">$44–$110 / pax</div>
          </div>
          <div class="p-3 rounded-xl bg-slate-50 border border-slate-100">
            <div class="text-xl sm:text-2xl mb-1">🎟️</div>
            <div class="text-[11px] uppercase tracking-wider text-slate-400 font-semibold">Official Entry</div>
            <div class="text-sm sm:text-base font-bold text-slate-900 mt-0.5">135,000 VND</div>
          </div>
        </div>

        <!-- Article Content Starts -->
        <article class="space-y-12 text-slate-800 leading-relaxed font-normal">

          <!-- Section: Introduction -->
          <section id="gioi-thieu" class="scroll-mt-28 space-y-4">
            <div class="text-slate-700 text-[16px] sm:text-[17px] leading-relaxed space-y-4">
              <p>
                A Cu Chi Tunnels private tour can cost several times more than a standard group bus. In 2026, shared half-day tours typically start around <strong>US$13–$20 per person</strong>, while private options commonly range from <strong>US$50 to $110 or more</strong>, depending on group size, guide credentials, vehicle selection, and specific itinerary inclusions.
              </p>
              <p>
                That price difference naturally raises a practical question: what are you actually paying for?
              </p>
              <p>
                The answer is not simply a faster drive. A private tour uses the same highways and faces the same suburban traffic heading northwest out of Ho Chi Minh City. The premium is primarily for control: a dedicated vehicle for your traveling party, direct hotel pickup, flexible departure times, meaningful choice over which tunnel sector you explore, and—when included—a private licensed guide who can tailor historical commentary to your questions, interests, and walking pace.
              </p>
              <p>
                For a solo traveler on a tight budget, the financial gap can be difficult to justify. For a couple, family, or small group of friends, the cost-per-person equation shifts dramatically.
              </p>

              {/* Callout Quote */}
              <blockquote class="border-l-4 border-amber-500 pl-4 py-3 my-6 bg-amber-50/60 rounded-r-xl italic text-slate-800 font-serif text-[16.5px]">
                "A private tour does not buy you an empty highway, but it spares your morning from endless hotel pickups, skips commercial shopping detours, and gives you complete control over your time."
              </blockquote>

              {/* Featured Image inside Body */}
              <div class="my-6 not-prose">
                <div class="rounded-2xl overflow-hidden shadow-md border border-slate-200">
                  <img 
                    src="https://media.thericetour.com/uploads/group-posing-secret-tunnel-entrance-leaves-cu-chi-1280x720.webp" 
                    alt="Small private group exploring the forested grounds and secret tunnel entrances at Cu Chi - The Rice Tour" 
                    class="w-full h-auto object-cover max-h-[500px]"
                    width="1280"
                    height="720"
                    loading="eager"
                  />
                </div>
                <p class="text-center text-xs sm:text-sm text-slate-500 italic mt-2.5">
                  Private touring allows travelers to explore secret trapdoors and historical exhibits at an unhurried pace.
                </p>
              </div>

              {/* UNESCO 2026 Milestone Callout Box */}
              <div class="bg-amber-50/70 border border-amber-300/80 p-5 rounded-2xl my-6 not-prose">
                <div class="flex items-center gap-2.5 text-amber-900 font-bold text-sm sm:text-base mb-2">
                  <span class="text-lg">🏛️</span> UNESCO Tentative List 2026: Over 27 Million Cumulative Visitors
                </div>
                <p class="text-xs sm:text-sm text-amber-950/90 leading-relaxed">
                  On <strong>July 15, 2026</strong>, Vietnam officially submitted the Cu Chi Tunnels complex to the <strong>UNESCO World Heritage Tentative List</strong> under cultural criteria <em>(iv)</em> and <em>(vi)</em>. The nomination documents Cu Chi as an extensive subterranean defense network developed across both the <strong>First Indochina War</strong> and <strong>Second Indochina War</strong>. Official records note that by 2025, Cu Chi had welcomed <strong>more than 27 million cumulative domestic and international visitors</strong> since opening to tourism, with Ben Duoc and Ben Dinh recognized as the two primary sectors best preserving the original scale, layout, and structure (totaling roughly 4 km of conserved underground passages).
                </p>
              </div>

              <p>
                Alongside central historical landmarks like the <a href="/independence-palace-saigon-guide" class="text-amber-800 hover:text-amber-900 font-semibold underline underline-offset-2 decoration-amber-300">Independence Palace</a> in downtown Saigon, Cu Chi is vital for understanding Vietnam's modern history. Understanding how different tour formats deliver that history is key to spending your travel budget wisely.
              </p>
            </div>
          </section>

          <!-- Section: Costs in 2026 -->
          <section id="costs-in-2026" class="scroll-mt-28 space-y-5">
            <div class="border-l-4 border-amber-500 pl-4 mb-4">
              <h2 class="font-serif text-2xl lg:text-[26px] font-bold text-slate-900 leading-tight">
                What Does A Cu Chi Tunnels Private Tour Cost In 2026?
              </h2>
            </div>

            <div class="text-slate-700 text-[15.5px] leading-relaxed space-y-4">
              <p>
                There is no single uniform price for a private tour because different operators package the experience with varying levels of service.
              </p>
              <p>
                Current 2026 market offerings generally divide into four main tiers:
              </p>

              {/* Table: Pricing Tiers */}
              <div class="overflow-x-auto my-6 not-prose shadow-sm rounded-xl border border-slate-200">
                <table class="w-full text-left border-collapse text-xs sm:text-sm">
                  <thead>
                    <tr class="bg-slate-900 text-white font-serif">
                      <th class="p-3.5 sm:p-4">Tour Format</th>
                      <th class="p-3.5 sm:p-4">Typical 2026 Price</th>
                      <th class="p-3.5 sm:p-4">What You Usually Receive</th>
                    </tr>
                  </thead>
                  <tbody class="divide-y divide-slate-100 bg-white">
                    <tr class="hover:bg-slate-50/80">
                      <td class="p-3.5 sm:p-4 font-semibold text-slate-900">Standard Group Bus</td>
                      <td class="p-3.5 sm:p-4 font-medium text-amber-800">~US$13–$20 / person</td>
                      <td class="p-3.5 sm:p-4 text-slate-600">29–45 seat coach, shared guide, fixed schedule, multiple hotel pickups</td>
                    </tr>
                    <tr class="hover:bg-slate-50/80">
                      <td class="p-3.5 sm:p-4 font-semibold text-slate-900">Small Group Tour</td>
                      <td class="p-3.5 sm:p-4 font-medium text-amber-800">~US$18–$35 / person</td>
                      <td class="p-3.5 sm:p-4 text-slate-600">9–16 seat van (max 10–12 guests), more personal guide attention, semi-flexible pickup</td>
                    </tr>
                    <tr class="hover:bg-slate-50/80">
                      <td class="p-3.5 sm:p-4 font-semibold text-slate-900">Private Car (Transport Only)</td>
                      <td class="p-3.5 sm:p-4 font-medium text-amber-800">~US$40–$75 / vehicle</td>
                      <td class="p-3.5 sm:p-4 text-slate-600">Private vehicle, dedicated driver, hotel pickup, fuel and tolls included (no dedicated guide)</td>
                    </tr>
                    <tr class="hover:bg-amber-50/50 bg-amber-50/20">
                      <td class="p-3.5 sm:p-4 font-semibold text-slate-900">Fully Guided Private Tour</td>
                      <td class="p-3.5 sm:p-4 font-medium text-amber-800">~US$50–$110+ / person</td>
                      <td class="p-3.5 sm:p-4 text-slate-600">Exclusive vehicle, dedicated private licensed guide, entrance tickets, customized timing</td>
                    </tr>
                    <tr class="hover:bg-slate-50/80">
                      <td class="p-3.5 sm:p-4 font-semibold text-slate-900">VIP / Luxury Private Tour</td>
                      <td class="p-3.5 sm:p-4 font-medium text-amber-800">US$100–$150+ / person</td>
                      <td class="p-3.5 sm:p-4 text-slate-600">Limousine van or luxury SUV, top-tier multilingual guide, premium refreshments, tailored stops</td>
                    </tr>
                  </tbody>
                </table>
              </div>

              <p>
                These figures represent realistic market benchmarks rather than legally fixed tariffs. Actual quotations fluctuate based on your departure date, travel party size, pickup district in Ho Chi Minh City, chosen tunnel sector (Ben Dinh vs. Ben Duoc), vehicle classification, and meal inclusions.
              </p>
              <p>
                The essential takeaway is that "private tour" describes an entire category of personalized service rather than a standardized, off-the-shelf product. Before comparing two competing proposals, always verify exactly what each quote includes.
              </p>
            </div>
          </section>

          <!-- Section: Private Car vs Private Tour -->
          <section id="car-vs-tour" class="scroll-mt-28 space-y-5">
            <div class="border-l-4 border-amber-500 pl-4 mb-4">
