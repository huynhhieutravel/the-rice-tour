        <h3 class="text-3xl font-serif font-bold text-stone-900 mb-8 text-center">Bài Viết Liên Quan Về Ladakh</h3>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <a href="/le-hoi-purnima" class="group block bg-white rounded-2xl overflow-hidden shadow-sm hover:shadow-md transition-shadow border border-stone-200 no-underline">
            <div class="aspect-video w-full overflow-hidden">
