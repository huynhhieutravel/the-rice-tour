---
import BaseLayout from '@/layouts/BaseLayout.astro';
import JsonLdSchema from '@/components/seo/JsonLdSchema.astro';

const seoData = {
  title: "Dịch Vụ Visa Bao Đậu | Fit Tour",
  description: "Dịch vụ làm Visa chuyên nghiệp, tỷ lệ đậu cao. Chuyên Visa Mỹ, Châu Âu, Úc, Canada. Đội ngũ chuyên gia giàu kinh nghiệm từ Fit Tour.",
  canonicalUrl: `https://thericetour.com/dich-vu-visa`,
  ogImageUrl: "https://media.fittour.vn/wp-content/uploads/2023/12/Himalayas.webp",
};
---

<BaseLayout 
  title={seoData.title} 
  description={seoData.description} 
  image={seoData.ogImageUrl}
  canonical={seoData.canonicalUrl}
>

  <!-- Navigation Spacing (Assuming fixed header) -->
  <div class="pt-24 lg:pt-32 bg-white"></div>

  <!-- Hero Section (Apple Style) -->
  <section class="bg-white overflow-hidden pb-16 md:pb-24">
    <div class="max-w-[1200px] mx-auto px-4 md:px-8 text-center relative z-10">
      <h1 class="text-5xl md:text-6xl lg:text-7xl font-black text-slate-900 tracking-tight mb-8 leading-tight">
        Dịch vụ Visa <br class="hidden md:block" /> 
        <span class="text-[#ea580c]">Chuyên Nghiệp.</span>
      </h1>
      <p class="text-xl md:text-2xl text-slate-600 font-medium max-w-2xl mx-auto mb-12 leading-relaxed">
        Mở cánh cửa ra thế giới với tỷ lệ đậu cao nhất. Chúng tôi đơn giản hóa mọi thủ tục phức tạp cho bạn.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a href="#dich-vu" class="px-8 py-4 bg-slate-900 text-white rounded-full font-bold text-lg hover:bg-slate-800 transition-all hover:scale-105 hover:shadow-xl">
          Khám phá dịch vụ
        </a>
        <a href="/lien-he" class="px-8 py-4 bg-orange-50 text-[#f27922] border border-orange-200 rounded-full font-bold text-lg hover:bg-orange-100 transition-all">
          Nhận tư vấn miễn phí
        </a>
      </div>
      
      <div class="mt-16 md:mt-24 relative rounded-3xl overflow-hidden shadow-2xl border border-slate-100 max-w-5xl mx-auto">
        <img src="https://media.fittour.vn/uploads/2022/11/hanh-trinh-tren-day-himalayas-fit-tour-2022.webp" alt="Visa Services Fit Tour" class="w-full aspect-video md:aspect-[21/9] object-cover filter brightness-[0.9]" onerror="this.style.display='none'" />
      </div>
    </div>
  </section>

  <!-- Why Us Section (3 Columns) -->
  <section class="bg-slate-50 py-24 border-y border-slate-100">
    <div class="max-w-[1200px] mx-auto px-4 md:px-8">
      <div class="text-center mb-16">
        <h2 class="text-3xl md:text-5xl font-black text-slate-900 tracking-tight">Tại sao chọn Fit Tour?</h2>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 md:gap-12">
        <div class="bg-white p-10 rounded-3xl shadow-sm border border-slate-100">
          <div class="w-14 h-14 bg-orange-100 rounded-2xl flex items-center justify-center text-[#f27922] mb-6">
            <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
          </div>
          <h3 class="text-2xl font-bold text-slate-900 mb-4">Tỷ lệ đậu cao</h3>
          <p class="text-slate-500 leading-relaxed">Đội ngũ chuyên gia thẩm định hồ sơ khắt khe, tư vấn chính xác điểm mạnh yếu để tối ưu khả năng đậu Visa lên mức cao nhất.</p>
        </div>
        
        <div class="bg-white p-10 rounded-3xl shadow-sm border border-slate-100">
          <div class="w-14 h-14 bg-orange-100 rounded-2xl flex items-center justify-center text-[#f27922] mb-6">
            <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
          </div>
          <h3 class="text-2xl font-bold text-slate-900 mb-4">Tiết kiệm thời gian</h3>
          <p class="text-slate-500 leading-relaxed">Không cần mệt mỏi dịch thuật, điền form hay sắp xếp giấy tờ. Chúng tôi lo trọn gói từ A-Z, bạn chỉ cần lên Lãnh sự quán (nếu có).</p>
        </div>
        
        <div class="bg-white p-10 rounded-3xl shadow-sm border border-slate-100">
          <div class="w-14 h-14 bg-orange-100 rounded-2xl flex items-center justify-center text-[#f27922] mb-6">
            <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8h2a2 2 0 012 2v6a2 2 0 01-2 2h-2v4l-4-4H9a1.994 1.994 0 01-1.414-.586m0 0L11 14h4a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2v4l.586-.586z"></path></svg>
          </div>
          <h3 class="text-2xl font-bold text-slate-900 mb-4">Tư vấn tận tình</h3>
          <p class="text-slate-500 leading-relaxed">Giải đáp thắc mắc 24/7, đồng hành cùng bạn trước, trong và sau khi phỏng vấn để mang lại sự an tâm tuyệt đối.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Bento Grid: Visa Services -->
  <section id="dich-vu" class="bg-white py-24">
    <div class="max-w-[1200px] mx-auto px-4 md:px-8">
      <div class="text-center mb-16 max-w-3xl mx-auto">
        <h2 class="text-3xl md:text-5xl font-black text-slate-900 tracking-tight mb-6">Visa Toàn Cầu. <br class="hidden md:block"/>Mọi lúc, mọi nơi.</h2>
        <p class="text-lg text-slate-500">Bất kể điểm đến của bạn là cường quốc khó tính hay châu lục xa xôi, chúng tôi đều có giải pháp chuyên biệt.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        
        <!-- Bento 1: Visa Mỹ (Large) -->
        <div class="lg:col-span-2 bg-slate-900 rounded-3xl overflow-hidden relative group h-[400px]">
          <img src="https://media.fittour.vn/uploads/2022/11/hanh-trinh-tren-day-himalayas-fit-tour-2022.webp" alt="Visa Mỹ" class="absolute inset-0 w-full h-full object-cover opacity-50 group-hover:scale-105 transition-transform duration-700" onerror="this.style.display='none'" />
          <div class="absolute inset-0 bg-gradient-to-t from-slate-900 via-slate-900/60 to-transparent"></div>
          <div class="absolute bottom-0 left-0 p-10 w-full z-10">
            <span class="inline-block px-4 py-1.5 rounded-full bg-[#ea580c] text-white font-bold tracking-wider uppercase mb-4 text-xs">Hot</span>
            <h3 class="text-3xl md:text-4xl font-black text-white mb-3 drop-shadow-md">Visa Mỹ & Canada</h3>
            <p class="text-slate-200 max-w-md text-sm md:text-base leading-relaxed">Luyện tập phỏng vấn 1-1, khắc phục điểm yếu hồ sơ. Chinh phục quốc gia khó nhất.</p>
          </div>
        </div>

        <!-- Bento 2: Visa Châu Âu -->
        <div class="bg-orange-50 rounded-3xl p-10 relative overflow-hidden group h-[400px] flex flex-col justify-end border border-orange-100">
          <div class="absolute top-10 right-10 w-24 h-24 bg-white rounded-full flex items-center justify-center shadow-lg group-hover:-translate-y-2 transition-transform">
            <svg class="w-10 h-10 text-[#f27922]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
          </div>
          <h3 class="text-3xl font-black text-slate-900 mb-3 relative z-10">Visa Châu Âu (Schengen)</h3>
          <p class="text-slate-600 relative z-10">Xin 1 lần, đi 27 quốc gia. Đội ngũ chuyên gia xử lý chuẩn xác, xin đúng Lãnh sự quán.</p>
        </div>

        <!-- Bento 3: Visa Úc & NZ -->
        <div class="bg-slate-100 rounded-3xl overflow-hidden relative group h-[300px] flex flex-col justify-end border border-slate-200">
          <img src="https://media.fittour.vn/uploads/2022/11/buoi-trao-doi-va-tu-van-truoc-chuyen-di-trek-everest-base-camp.webp" alt="Visa Úc" class="absolute inset-0 w-full h-full object-cover opacity-20 group-hover:scale-105 transition-transform duration-700" onerror="this.style.display='none'" />
          <div class="relative z-10 p-10">
            <h3 class="text-2xl font-black text-slate-900 mb-2">Visa Úc & New Zealand</h3>
            <p class="text-slate-600">Thủ tục online tiện lợi, tư vấn chứng minh tài chính chuẩn.</p>
          </div>
        </div>

        <!-- Bento 4: Visa Châu Á -->
        <div class="lg:col-span-2 bg-slate-50 rounded-3xl overflow-hidden relative group h-[300px] flex flex-col justify-end border border-slate-200">
          <img src="https://media.fittour.vn/uploads/2022/11/doan-khach-fit-tour-check-in-diem-de-everest-base-camp.webp" alt="Visa Châu Á" class="absolute inset-0 w-full h-full object-cover opacity-20 group-hover:scale-105 transition-transform duration-700" onerror="this.style.display='none'" />
          <div class="relative z-10 p-10">
            <h3 class="text-2xl font-black text-slate-900 mb-2">Visa Nhật Bản, Hàn Quốc, Đài Loan</h3>
            <p class="text-slate-600 max-w-lg">Bao đậu cao, miễn chứng minh tài chính cho баn nhiều trường hợp. Xử lý hồ sơ trong 3-5 ngày làm việc.</p>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- 4 Steps Process -->
  <section class="bg-slate-900 py-24 text-white">
    <div class="max-w-[1200px] mx-auto px-4 md:px-8">
      <div class="text-center mb-20">
        <h2 class="text-3xl md:text-5xl font-black tracking-tight mb-6">Quy trình 4 Bước Đơn Giản</h2>
        <p class="text-xl text-slate-400 font-light">Không rườm rà, mọi thứ đều rõ ràng ngay từ đầu.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-4 gap-12 relative">
        <!-- Connecting Line (Desktop only) -->
        <div class="hidden md:block absolute top-12 left-[10%] right-[10%] h-[2px] bg-slate-800"></div>

        <!-- Step 1 -->
        <div class="relative text-center">
          <div class="w-24 h-24 mx-auto bg-slate-800 border-4 border-slate-900 rounded-full flex items-center justify-center text-3xl font-black text-[#f27922] mb-6 relative z-10">1</div>
          <h3 class="text-xl font-bold mb-3">Nhận Thông Tin</h3>
          <p class="text-slate-400 text-sm">Chuyên viên tiếp nhận nhu cầu và đánh giá sơ bộ hồ sơ của bạn hoàn toàn miễn phí.</p>
        </div>

        <!-- Step 2 -->
        <div class="relative text-center">
          <div class="w-24 h-24 mx-auto bg-slate-800 border-4 border-slate-900 rounded-full flex items-center justify-center text-3xl font-black text-[#f27922] mb-6 relative z-10">2</div>
          <h3 class="text-xl font-bold mb-3">Tối Ưu Hồ Sơ</h3>
          <p class="text-slate-400 text-sm">Hướng dẫn chuẩn bị giấy tờ, dịch thuật công chứng và sắp xếp theo đúng chuẩn Lãnh sự.</p>
        </div>

        <!-- Step 3 -->
        <div class="relative text-center">
          <div class="w-24 h-24 mx-auto bg-slate-800 border-4 border-slate-900 rounded-full flex items-center justify-center text-3xl font-black text-[#f27922] mb-6 relative z-10">3</div>
          <h3 class="text-xl font-bold mb-3">Nộp & Phỏng Vấn</h3>
          <p class="text-slate-400 text-sm">Đặt lịch hẹn, nộp hồ sơ, lấy dấu vân tay và luyện tập phỏng vấn 1-1 (nếu có).</p>
        </div>

        <!-- Step 4 -->
        <div class="relative text-center">
          <div class="w-24 h-24 mx-auto bg-slate-800 border-4 border-slate-900 rounded-full flex items-center justify-center text-3xl font-black text-[#f27922] mb-6 relative z-10">4</div>
          <h3 class="text-xl font-bold mb-3">Nhận Kết Quả</h3>
          <p class="text-slate-400 text-sm">Visa được chuyển phát an toàn về tận tay bạn. Sẵn sàng cho chuyến đi!</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Bottom CTA Banner -->
  <section class="py-16 md:py-24 bg-slate-50">
    <div class="max-w-[1200px] mx-auto px-4 md:px-8">
      <div class="relative w-full overflow-hidden rounded-3xl bg-slate-900 shadow-2xl">
        <div class="absolute inset-0">
          <img src="https://media.fittour.vn/uploads/2022/11/hanh-trinh-tren-day-himalayas-fit-tour-2022.webp" alt="CTA Background" class="w-full h-full object-cover opacity-40 mix-blend-overlay" onerror="this.style.display='none'" />
          <div class="absolute inset-0 bg-gradient-to-r from-slate-900 via-slate-900/80 to-transparent"></div>
        </div>
        
        <div class="relative z-10 px-8 py-16 md:p-20 lg:p-24 text-white flex flex-col md:flex-row items-center justify-between gap-12">
          <div class="max-w-2xl text-left">
            <span class="inline-block px-4 py-1.5 rounded-full bg-orange-500/20 text-[#f27922] font-bold tracking-wider uppercase mb-6 text-sm border border-orange-500/30">
              Chuyên nghiệp & Tận tâm
            </span>
            <h2 class="text-3xl md:text-5xl font-black mb-6 leading-tight">
              Bạn đã sẵn sàng <br/>cho chuyến đi?
            </h2>
            <p class="text-lg text-slate-300 leading-relaxed font-light">
              Hãy để những chuyên gia Visa của Fit Tour xử lý giấy tờ mệt mỏi thay bạn. Tỷ lệ đậu cao, thủ tục nhanh chóng, an tâm tuyệt đối.
            </p>
          </div>
          
          <div class="shrink-0 w-full md:w-auto">
            <a href="/lien-he" class="group relative w-full md:w-auto inline-flex items-center justify-center px-10 py-5 bg-[#f27922] text-white font-bold rounded-2xl overflow-hidden transition-all hover:scale-105 hover:shadow-[0_0_40px_-10px_rgba(242,121,34,0.6)]">
              <span class="relative z-10 flex items-center text-lg">
                Tư vấn Visa Ngay
                <svg class="w-5 h-5 ml-2 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
              </span>
              <div class="absolute inset-0 h-full w-full bg-white/20 translate-y-full group-hover:translate-y-0 transition-transform duration-300 ease-out"></div>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>
