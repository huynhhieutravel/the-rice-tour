---
import { env } from 'cloudflare:workers';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { safeQueryCritical } from '@/lib/db-client';
import { getGlobalSettings } from '@/lib/settingsHelper';
import { Clock, Calendar, ChevronRight, CheckCircle2 } from 'lucide-react';

const d1Db = env?.dulichcoguu_d1;
let post;
try {
  if (d1Db) post = await safeQueryCritical(
    d1Db.prepare("SELECT * FROM Post WHERE slug = ? AND (status = 'published' OR status = 'publish')").bind('pho-co-hutong').first<any>(),
    { route: Astro.url.pathname, slug: 'pho-co-hutong', queryType: "fetch_post_by_slug" }
  );
} catch (e) {
  // Gracefully fallback if DB error or not created yet
}

// Fallback metadata if post is not yet populated in CMS
if (!post) {
  post = {
    id: 996,
    title: 'Phố Cổ Hutong Bắc Kinh: Kinh Nghiệm Tham Quan Các Con Ngõ Lịch Sử',
    excerpt: 'Khám phá phố cổ Hutong Bắc Kinh: Từ Nanluoguxiang, Yandai Xiejie đến những con ngõ tĩnh lặng như Wudaoying và Fangjia. Lịch trình đi bộ, trải nghiệm Tứ Hợp Viện và ẩm thực địa phương.',
    featuredImage: 'https://media.fittour.vn/uploads/pho-co-hutong.webp',
    author: 'Huynh Hieu Travel',
    createdAt: '2026-08-19T08:00:00.000Z',
    updatedAt: '2026-08-19T08:00:00.000Z',
    readingTime: 12
  };
}

const { settings } = await getGlobalSettings();

const seoTitle = post.seoTitle || post.title || 'Phố Cổ Hutong Bắc Kinh: Kinh Nghiệm Tham Quan Các Con Ngõ Lịch Sử';
const seoDesc = post.seoDesc || post.excerpt || 'Khám phá phố cổ Hutong Bắc Kinh: Từ Nanluoguxiang, Yandai Xiejie đến những con ngõ tĩnh lặng như Wudaoying và Fangjia. Lịch trình đi bộ, trải nghiệm Tứ Hợp Viện và ẩm thực địa phương.';
const seoImage = post.seoImage || post.featuredImage || 'https://media.fittour.vn/uploads/pho-co-hutong.webp';

// --- DATE LOGIC ---
const createdAtStr = post.createdAt || post.publishedAt || '2026-08-19T08:00:00.000Z';
const updatedAtStr = post.updatedAt || createdAtStr;

const createdAt = new Date(createdAtStr.replace(' ', 'T'));
const updatedAt = new Date(updatedAtStr.replace(' ', 'T'));

const isUpdated = updatedAt.getTime() - createdAt.getTime() > 86400000; 
const displayDate = isUpdated ? updatedAt : createdAt;
const datePrefix = isUpdated ? "Cập nhật:" : "Xuất bản:";

const formattedDate = displayDate.toLocaleDateString('vi-VN', { day: '2-digit', month: '2-digit', year: 'numeric' });
// ------------------

// --- AUTHOR LOGIC ---
const authorMap: Record<string, any> = {
  "Max Vũ": {
    name: "Max Vũ",
    url: "/max-vu",
    img: "https://media.fittour.vn/uploads/max-vu-founder-fit-tour.webp"
  },
  "Huy Ngô": {
    name: "Huy Ngô",
    url: "/hdv-huy-ngo",
    img: "https://media.fittour.vn/uploads/hdv-huy-ngo-fittour.webp"
  },
  "Huynh Hieu Travel": {
    name: "Huynh Hieu Travel",
    url: "/huynh-hieu",
    img: "https://media.fittour.vn/uploads/huynhhieutravel.webp"
  }
};
const authorData = authorMap[post.author] || authorMap["Huynh Hieu Travel"];
// ------------------

const adminEditUrl = post.id && post.id !== 995 && post.id !== 996 && post.id !== 997 && post.id !== 998 && post.id !== 999 ? `/admin/posts/edit?id=${post.id}` : '#';

// TOC Navigation Structure
const toc = [
  { id: "gioi-thieu", title: "Giới thiệu", icon: "🏠" },
  { id: "la-gi", title: "Phố Cổ Hutong Bắc Kinh Là Gì?" },
  { id: "tu-hop-vien", title: "Tứ Hợp Viện Là Gì? Có Liên Quan Gì Đến Hutong?" },
  { id: "lich-su", title: "Lịch Sử Phố Cổ Hutong Bắc Kinh" },
  { id: "truc-trung-tam", title: "Phố Cổ Hutong Và Trục Trung Tâm Bắc Kinh" },
  { id: "vi-sao-dang-kham-pha", title: "Vì Sao Phố Cổ Hutong Đáng Khám Phá?" },
  { id: "chon-khu-nao", title: "Nên Chọn Khu Phố Cổ Hutong Nào?" },
  { id: "cac-khu-dang-di", title: "Những Khu Phố Cổ Hutong Đáng Đi Nhất" },
  { id: "shichahai", title: "• Shichahai – Houhai", indent: true },
  { id: "nanluoguxiang", title: "• Nanluoguxiang & Beiluoguxiang", indent: true },
  { id: "wudaoying", title: "• Wudaoying Hutong", indent: true },
  { id: "fangjia", title: "• Fangjia Hutong", indent: true },
  { id: "maoer-juer", title: "• Mao'er – Yu'er – Heizhima", indent: true },
  { id: "yandai-xiejie", title: "• Yandai Xiejie", indent: true },
  { id: "guozijian", title: "• Guozijian Và Yonghegong", indent: true },
  { id: "lanman-hutong", title: "• Lanman Hutong", indent: true },
  { id: "kham-pha-bang-cach-nao", title: "Khám Phá Phố Cổ Bằng Cách Nào?" },
  { id: "tuyen-goi-y", title: "Tuyến Phố Cổ Hutong Gợi Ý" },
  { id: "bao-lau-la-du", title: "Khám Phá Bao Lâu Là Đủ?" },
  { id: "sang-hay-toi", title: "Phố Cổ Hutong Nên Đi Sáng Hay Tối?" },
  { id: "an-uong", title: "Phố Cổ Hutong Bắc Kinh Có Gì Để Ăn?" },
  { id: "co-phu-hop-tre-em", title: "Phố Cổ Hutong Có Phù Hợp Trẻ Em?" },
  { id: "co-dang-di-khong", title: "Phố Cổ Hutong Có Đáng Đi Không?" },
  { id: "7-dieu-can-nho", title: "7 Điều Cần Nhớ Trước Khi Khám Phá" },
  { id: "faq", title: "Câu Hỏi Thường Gặp (FAQ)" },
  { id: "hanh-trinh-fit-tour", title: "Phố Cổ Hutong Trong Hành Trình FIT TOUR" }
];
---

<BaseLayout 
  title={seoTitle} 
  description={seoDesc} 
  image={seoImage}
  preloadImages={[seoImage]}
  adminEditUrl={adminEditUrl}
>
  <Fragment slot="schema">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Article",
          "headline": seoTitle,
          "image": [seoImage],
          "datePublished": "2026-08-19T08:00:00+07:00",
          "dateModified": new Date().toISOString(),
          "author": {
            "@type": "Person",
            "name": authorData.name,
            "url": authorData.url
          },
          "publisher": {
            "@type": "Organization",
            "name": "FIT TOUR",
            "logo": {
              "@type": "ImageObject",
              "url": "https://media.thericetour.com/uploads/logo-the-rice.webp"
            }
          },
          "description": seoDesc
        },
        {
          "@type": "BreadcrumbList",
          "itemListElement": [
            {
              "@type": "ListItem",
              "position": 1,
              "name": "Trang chủ",
              "item": "https://thericetour.com/"
            },
            {
              "@type": "ListItem",
              "position": 2,
              "name": "Blog Du Lịch",
              "item": "https://thericetour.com/blog"
            },
            {
              "@type": "ListItem",
              "position": 3,
              "name": "Phố Cổ Hutong Bắc Kinh",
              "item": "https://thericetour.com/pho-co-hutong"
            }
          ]
        }
      ]
    })} />
  </Fragment>

  <div class="bg-[#F8F9FA] text-[#1E293B] font-sans antialiased selection:bg-[#F7931E] selection:text-white">

    {/* ================= HERO SECTION ================= */}
    <section class="relative w-full min-h-[580px] lg:min-h-[660px] overflow-hidden flex flex-col justify-center pt-32 pb-20">
      <div class="absolute inset-0 z-0 bg-slate-950">
        <img 
          src={seoImage} 
          alt="Phố Cổ Hutong Bắc Kinh Ngõ Cổ Lịch Sử Trung Quốc" 
          class="w-full h-full object-cover object-center opacity-75" 
          width="1920" 
          height="1080"
          fetchpriority="high" 
          loading="eager" 
          decoding="async" 
        />
        <div class="absolute inset-0 bg-gradient-to-r from-black/90 via-black/65 to-black/35"></div>
        <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-transparent to-transparent"></div>
      </div>

      <div class="relative z-10 max-w-[1600px] mx-auto px-4 sm:px-6 lg:px-12 w-full">
        
        {/* Breadcrumb */}
        <div class="flex items-center gap-2 text-[13px] text-white/70 font-medium mb-6">
          <a href="/" class="hover:text-white transition-colors">Trang chủ</a>
          <ChevronRight class="w-3 h-3" />
          <a href="/blog" class="hover:text-white transition-colors">Blog</a>
          <ChevronRight class="w-3 h-3" />
          <span class="text-white font-semibold line-clamp-1">Phố Cổ Hutong Bắc Kinh</span>
        </div>

        {/* Titles */}
        <h1 class="font-serif text-3xl sm:text-4xl lg:text-5xl xl:text-6xl font-bold text-white mb-4 leading-[1.15] drop-shadow-lg max-w-5xl">
          {post.title}
        </h1>
        <h2 class="font-serif text-lg sm:text-2xl lg:text-3xl text-amber-400 italic mb-8 max-w-4xl drop-shadow-md font-medium">
          Khám phá một Bắc Kinh khác qua những con ngõ và nếp nhà Tứ Hợp Viện
        </h2>
        <p class="text-white/90 text-base sm:text-lg max-w-3xl leading-relaxed mb-8 hidden md:block drop-shadow-md font-normal">
          Nếu Tử Cấm Thành cho thấy Bắc Kinh của hoàng gia, Thiên Đàn cho thấy thế giới của nghi lễ tế Trời, thì Phố Cổ Hutong Bắc Kinh lại đưa du khách đến gần hơn với đời sống đô thị truyền thống của người dân nơi đây.
        </p>

        {/* Author Meta */}
        <div class="flex flex-wrap items-center gap-4 sm:gap-6 text-sm text-white/80 border-t border-white/20 pt-6 max-w-3xl">
          <a href={authorData.url} class="flex items-center gap-3 group">
            <img 
              src={authorData.img} 
              alt={authorData.name} 
              width="40" 
              height="40" 
              class="w-10 h-10 rounded-full border-2 border-white/30 object-cover object-top group-hover:border-amber-400 transition-colors" 
            />
            <span class="font-bold text-white group-hover:text-amber-400 transition-colors flex items-center gap-1">
              {authorData.name} 
              <CheckCircle2 class="w-4 h-4 text-blue-400" />
            </span>
          </a>
          <div class="flex items-center gap-2 bg-white/10 px-4 py-2 rounded-full backdrop-blur-sm border border-white/10">
            <Calendar class="w-4 h-4 opacity-70" />
            <span>{datePrefix} {formattedDate}</span>
          </div>
          <div class="flex items-center gap-2 bg-black/30 px-3 py-1.5 rounded-full backdrop-blur-sm">
            <Clock class="w-4 h-4 text-amber-400" />
            <span>{post.readingTime || 12} phút đọc</span>
          </div>
        </div>

        {/* Badges Line */}
        <div class="flex flex-wrap items-center gap-3 mt-8 pt-4">
          <div class="flex items-center gap-2 text-xs sm:text-sm text-white font-medium bg-black/60 backdrop-blur-md px-3.5 py-2 border border-white/10 rounded-lg shadow-xl">
            <span class="text-amber-400 text-base">📍</span> Khu Phố Cổ Trung Tâm Bắc Kinh
          </div>
          <div class="flex items-center gap-2 text-xs sm:text-sm text-white font-medium bg-black/60 backdrop-blur-md px-3.5 py-2 border border-white/10 rounded-lg shadow-xl">
            <span class="text-amber-400 text-base">🏡</span> Kiến Trúc Tứ Hợp Viện (Siheyuan)
          </div>
          <div class="flex items-center gap-2 text-xs sm:text-sm text-white font-medium bg-black/60 backdrop-blur-md px-3.5 py-2 border border-white/10 rounded-lg shadow-xl">
            <span class="text-amber-400 text-base">🏛️</span> Di Sản Trục Trung Tâm (Central Axis)
          </div>
          <div class="flex items-center gap-2 text-xs sm:text-sm text-white font-medium bg-black/60 backdrop-blur-md px-3.5 py-2 border border-white/10 rounded-lg shadow-xl">
            <span class="text-amber-400 text-base">🚶</span> Trải Nghiệm Đi Bộ & Xe Đạp
          </div>
        </div>

      </div>
    </section>

    {/* ================= MAIN CONTENT GRID ================= */}
    <div class="max-w-[1600px] mx-auto px-4 sm:px-6 lg:px-12 py-12 lg:py-16">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-start">

        {/* ---------------- LEFT SIDEBAR (TOC) ---------------- */}
        <aside class="hidden lg:block lg:col-span-3 sticky top-24">
          <div class="bg-white rounded-2xl shadow-sm border border-slate-200/60 p-6 overflow-hidden">
            <div class="flex items-center gap-2 font-bold text-slate-900 mb-5 border-l-4 border-amber-500 pl-3 text-sm tracking-wide uppercase">
              Mục lục bài viết
            </div>
            
            <nav class="space-y-1 text-[13.5px] font-medium max-h-[calc(100vh-200px)] overflow-y-auto pr-1">
              <a href="#gioi-thieu" class="flex items-center gap-2 text-amber-900 bg-amber-50/80 px-3 py-2 rounded-lg transition-colors font-bold">
                <span class="text-amber-600 text-base">🏠</span> Giới thiệu
              </a>
              
              <div class="pt-1.5 space-y-1 border-l border-slate-200 ml-3 pl-3">
                {toc.slice(1).map((item) => (
                  <a 
                    href={`#${item.id}`} 
                    class={`block transition-colors leading-tight py-1.5 text-slate-600 hover:text-amber-800 ${item.indent ? 'pl-2 text-[12.5px] border-l border-transparent hover:border-amber-400' : 'font-semibold text-[13px]'}`}
                  >
                    {item.title}
                  </a>
                ))}
              </div>
            </nav>
          </div>
        </aside>

        {/* ---------------- CENTER COLUMN (MAIN CONTENT) ---------------- */}
        <main class="col-span-1 lg:col-span-6 space-y-10">
          
          {/* Quick Overview Stats Bar */}
          <div class="bg-white rounded-2xl shadow-sm border border-slate-200/60 p-6 flex flex-wrap lg:flex-nowrap items-center justify-between gap-4">
            
            <div class="w-full flex items-center justify-between gap-4 mb-2 lg:hidden">
              <span class="font-bold text-slate-900 text-sm border-l-4 border-amber-500 pl-2 uppercase">Tổng Quan Nhanh</span>
            </div>

            <div class="flex items-center gap-3 w-[48%] lg:w-auto">
              <div class="w-10 h-10 rounded-full bg-amber-50 flex items-center justify-center text-amber-700 text-xl border border-amber-200/60 shrink-0">📍</div>
              <div>
                <div class="text-[11px] text-slate-500 font-medium">Vị trí</div>
                <div class="text-[13px] font-bold text-slate-900">Nội thành Bắc Kinh</div>
              </div>
            </div>

            <div class="hidden lg:block w-px h-8 bg-slate-200"></div>

            <div class="flex items-center gap-3 w-[48%] lg:w-auto">
              <div class="w-10 h-10 rounded-full bg-amber-50 flex items-center justify-center text-amber-700 text-xl border border-amber-200/60 shrink-0">🏡</div>
              <div>
                <div class="text-[11px] text-slate-500 font-medium">Đặc trưng</div>
                <div class="text-[13px] font-bold text-slate-900">Tứ Hợp Viện & Ngõ cổ</div>
              </div>
            </div>

            <div class="hidden lg:block w-px h-8 bg-slate-200"></div>

            <div class="flex items-center gap-3 w-[48%] lg:w-auto">
              <div class="w-10 h-10 rounded-full bg-amber-50 flex items-center justify-center text-amber-700 text-xl border border-amber-200/60 shrink-0">🎫</div>
              <div>
                <div class="text-[11px] text-slate-500 font-medium">Tham quan</div>
                <div class="text-[13px] font-bold text-slate-900">Miễn phí</div>
              </div>
            </div>

            <div class="hidden lg:block w-px h-8 bg-slate-200"></div>

            <div class="flex items-center gap-3 w-[48%] lg:w-auto">
              <div class="w-10 h-10 rounded-full bg-amber-50 flex items-center justify-center text-amber-700 text-xl border border-amber-200/60 shrink-0">⏱️</div>
              <div>
                <div class="text-[11px] text-slate-500 font-medium">Thời gian gợi ý</div>
                <div class="text-[13px] font-bold text-slate-900">2 – 4 giờ (Nửa ngày)</div>
              </div>
            </div>

          </div>

          {/* Intro Text */}
          <div id="gioi-thieu" class="prose prose-slate max-w-none prose-p:leading-relaxed prose-p:text-[16px] prose-p:text-slate-700 space-y-4">
            <p>
              Nếu <a href="/tu-cam-thanh" class="text-brand-700 hover:text-brand-800 underline font-medium">Tử Cấm Thành</a> cho thấy Bắc Kinh của hoàng gia, <a href="/thien-dan-bac-kinh" class="text-brand-700 hover:text-brand-800 underline font-medium">Thiên Đàn</a> cho thấy thế giới của nghi lễ tế Trời, thì <strong>Phố Cổ Hutong Bắc Kinh</strong> lại đưa du khách đến gần hơn với đời sống đô thị của người dân nơi đây.
            </p>
            <p>
              Phố cổ Hutong không phải một điểm tham quan duy nhất mà là tên gọi chung cho mạng lưới ngõ, hẻm và phố nhỏ từng tạo nên những khu dân cư truyền thống của Bắc Kinh. Phía sau những con ngõ ấy là các <strong>Tứ Hợp Viện (Siheyuan)</strong>, những khoảng sân, cổng gỗ, hàng cây và không gian sinh hoạt đã tạo nên một diện mạo rất riêng của thành phố.
            </p>
            <p>
              Ngày nay, một số khu Hutong đã trở thành những tuyến phố du lịch nổi tiếng như <strong>Nanluoguxiang</strong>, <strong>Yandai Xiejie</strong> và <strong>Shichahai</strong>; một số khác vẫn giữ vai trò khu dân cư, trong khi <strong>Wudaoying</strong>, <strong>Fangjia</strong> và các ngõ quanh <strong>Mao'er – Ju'er</strong> lại kết hợp giữa kiến trúc cũ với văn hóa, ẩm thực và đời sống hiện đại.
            </p>
            <div class="bg-amber-50/70 p-4 rounded-xl border border-amber-200 text-sm text-slate-800 space-y-1">
              💡 <strong>Lời khuyên trải nghiệm:</strong> Trải nghiệm Phố Cổ Hutong Bắc Kinh không nên dừng ở việc đi qua một con phố nổi tiếng. Cách thú vị hơn là chọn một khu, đi bộ chậm và nhìn cách Bắc Kinh cũ vẫn tồn tại bên trong thành phố hiện đại.
            </div>
          </div>

          {/* Section 1: Hutong là gì */}
          <section id="la-gi" class="scroll-mt-28 space-y-4">
            <div class="border-l-4 border-amber-500 pl-4">
              <h2 class="font-serif text-2xl lg:text-[26px] font-bold text-slate-900 leading-tight">
                Phố Cổ Hutong Bắc Kinh Là Gì?
              </h2>
            </div>
            
            <div class="text-slate-700 text-[15.5px] leading-relaxed space-y-4">
              <p>
                "Hutong" thường được dùng để chỉ những ngõ, hẻm và phố nhỏ hình thành mạng lưới khu dân cư truyền thống của Bắc Kinh. Hệ thống này phát triển mạnh từ thời Nguyên và tiếp tục mở rộng, thay đổi trong các triều Minh và Thanh.
              </p>
              
              <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-2xs space-y-3">
                <h3 class="font-bold text-slate-900 text-base">Điều quan trọng cần biết:</h3>
                <ul class="space-y-2 text-sm text-slate-700">
                  <li class="flex items-start gap-2">
                    <span class="text-amber-500 font-bold">•</span>
                    <span>Phố cổ Hutong <strong>không phải tên của một con phố cụ thể</strong>.</span>
                  </li>
                  <li class="flex items-start gap-2">
                    <span class="text-amber-500 font-bold">•</span>
                    <span>Đó là một <strong>hệ thống không gian đô thị lịch sử</strong> rộng lớn trải khắp nội thành.</span>
                  </li>
                  <li class="flex items-start gap-2">
                    <span class="text-amber-500 font-bold">•</span>
                    <span>Mỗi khu có thể có diện mạo rất khác nhau: có nơi sầm uất đầy cửa hàng và quán café, có nơi vẫn là ngõ nhỏ yên tĩnh với nhà dân, cổng Tứ Hợp Viện và hàng cây rợp bóng.</span>
                  </li>
                </ul>
              </div>

              <p>
                Chính sự đa dạng này khiến du khách không nên chỉ đi một con phố duy nhất rồi kết luận rằng đã "thấy hết Hutong Bắc Kinh".
              </p>
            </div>
          </section>

          {/* Section 2: Tứ Hợp Viện */}
          <section id="tu-hop-vien" class="scroll-mt-28 space-y-4">
            <div class="border-l-4 border-amber-500 pl-4">
              <h2 class="font-serif text-2xl lg:text-[26px] font-bold text-slate-900 leading-tight">
                Tứ Hợp Viện Là Gì? Có Liên Quan Gì Đến Hutong?
              </h2>
            </div>

