---
import { env } from 'cloudflare:workers';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { safeQueryCritical } from '@/lib/db-client';
import { getGlobalSettings } from '@/lib/settingsHelper';
import { Clock, Calendar, ChevronRight, CheckCircle2, Shield, Check, Info, AlertTriangle, MapPin, Ticket, Landmark, Compass, Flag, ShieldCheck, Footprints, Sun, Users, Sparkles, Navigation, Waves, Trees } from 'lucide-react';
import DataPost from '@/components/shortcodes/data/DataPost.astro';

const d1Db = env?.dulichcoguu_d1;
let post;
try {
  if (d1Db) post = await safeQueryCritical(
    d1Db.prepare("SELECT * FROM Post WHERE slug = ? AND (status = 'published' OR status = 'publish')").bind('di-hoa-vien').first<any>(),
    { route: Astro.url.pathname, slug: 'di-hoa-vien', queryType: "fetch_post_by_slug" }
  );
} catch (e) {
  // Gracefully fallback if DB error or not created yet
}

// Fallback metadata if post is not yet populated in CMS
if (!post) {
  post = {
    id: 996,
    title: 'Di Hòa Viên Bắc Kinh: Kinh Nghiệm Chọn Cổng, Tuyến Tham Quan & Giá Vé',
    excerpt: 'Kinh nghiệm tham quan Di Hòa Viên (Cung điện Mùa Hè) Bắc Kinh: Tuyến đi bộ đẹp nhất, kinh nghiệm chọn cổng, giá vé 2026, đi thuyền Hồ Côn Minh và lưu ý quan trọng.',
    featuredImage: 'https://media.fittour.vn/uploads/china-sereis-background.webp',
    author: 'Huynh Hieu Travel',
    createdAt: '2026-08-19T08:00:00.000Z',
    updatedAt: '2026-08-19T08:00:00.000Z',
    readingTime: 14
  };
}

const { settings } = await getGlobalSettings();

const seoTitle = post.seoTitle || post.title || 'Di Hòa Viên Bắc Kinh: Kinh Nghiệm Chọn Cổng, Tuyến Tham Quan & Giá Vé';
const seoDesc = post.seoDesc || post.excerpt || 'Kinh nghiệm tham quan Di Hòa Viên (Cung điện Mùa Hè) Bắc Kinh: Tuyến đi bộ đẹp nhất, kinh nghiệm chọn cổng, giá vé 2026, đi thuyền Hồ Côn Minh và lưu ý quan trọng.';
const seoImage = post.seoImage || post.featuredImage || 'https://media.fittour.vn/uploads/china-sereis-background.webp';

// --- DATE LOGIC ---
const createdAtStr = post.createdAt || post.publishedAt || '2026-08-19T08:00:00.000Z';
const updatedAtStr = post.updatedAt || createdAtStr;

const createdAt = new Date(createdAtStr.replace(' ', 'T'));
const updatedAt = new Date(updatedAtStr.replace(' ', 'T'));

const isUpdated = updatedAt.getTime() - createdAt.getTime() > 86400000; 
const displayDate = isUpdated ? updatedAt : createdAt;
const datePrefix = isUpdated ? "Cập nhật:" : "Xuất bản:";

const formattedDate = displayDate.toLocaleDateString('vi-VN', { day: '2-digit', month: '2-digit', year: 'numeric' });
// ------------------

// --- AUTHOR LOGIC ---
const authorMap: Record<string, any> = {
  "Max Vũ": {
    name: "Max Vũ",
    url: "/max-vu",
    img: "https://media.fittour.vn/uploads/max-vu-founder-fit-tour.webp"
  },
  "Huy Ngô": {
    name: "Huy Ngô",
    url: "/hdv-huy-ngo",
    img: "https://media.fittour.vn/uploads/hdv-huy-ngo-fittour.webp"
  },
  "Huynh Hieu Travel": {
    name: "Huynh Hieu Travel",
    url: "/huynh-hieu",
    img: "https://media.fittour.vn/uploads/huynhhieutravel.webp"
  }
};
const authorData = authorMap[post.author] || authorMap["Huynh Hieu Travel"];
// ------------------

const adminEditUrl = post.id && post.id !== 996 && post.id !== 997 && post.id !== 998 && post.id !== 999 ? `/admin/posts/edit?id=${post.id}` : '#';

// TOC Navigation Structure
const toc = [
  { id: "gioi-thieu", title: "Giới thiệu", icon: "🏠" },
  { id: "di-hoa-vien-la-gi", title: "Di Hòa Viên Là Gì?" },
  { id: "vi-sao-dang-di", title: "Vì Sao Di Hòa Viên Đáng Đi?" },
  { id: "bon-khu-vuc-chinh", title: "Bốn Khu Vực Chính Của Di Hòa Viên" },
  { id: "khu-cung-dinh", title: "• Khu Cung Đình Phía Đông", indent: true },
  { id: "tien-son-doi-truong-tho", title: "• Tiền Sơn – Đồi Trường Thọ", indent: true },
  { id: "hau-son-hau-ho", title: "• Hậu Sơn Và Hậu Hồ", indent: true },
  { id: "ho-con-minh", title: "• Hồ Côn Minh & Cầu 17 Vòm", indent: true },
  { id: "co-can-dat-ve-truoc", title: "Có Cần Đặt Vé Trước Không?" },
  { id: "gia-ve-2026", title: "Giá Vé Di Hòa Viên 2026 & Vé Liên Hợp" },
  { id: "chinh-sach-mien-ve-60-tuoi", title: "Người Từ 60 Tuổi Có Được Miễn Vé Không?" },
  { id: "gio-mo-cua", title: "Giờ Mở Cửa & Lưu Ý Thứ Hai" },
  { id: "nen-vao-cong-nao", title: "Nên Vào Cổng Nào Ở Di Hòa Viên?" },
  { id: "tuyen-tham-quan", title: "Tuyến Di Hòa Viên Cho Người Lần Đầu" },
  { id: "di-thuyen-ho-con-minh", title: "Có Nên Đi Thuyền Trên Hồ Côn Minh?" },
  { id: "ngam-sen-mua-he", title: "Di Hòa Viên Mùa Hè: Ngắm Sen Hồ Côn Minh" },
  { id: "mua-nao-dep-nhat", title: "Mùa Nào Đẹp Nhất Để Đi Di Hòa Viên?" },
  { id: "phu-hop-nguoi-lon-tuoi", title: "Di Hòa Viên Có Phù Hợp Người Lớn Tuổi Không?" },
  { id: "thue-huong-dan-vien", title: "Có Nên Thuê Hướng Dẫn Viên?" },
  { id: "cach-di-den", title: "Cách Đi Đến Di Hòa Viên (Metro Line 4)" },
  { id: "so-sanh-tu-cam-thanh", title: "Di Hòa Viên Có Gì Khác Tử Cấm Thành?" },
  { id: "ket-hop-vien-minh-vien", title: "Có Nên Kết Hợp Với Viên Minh Viên?" },
  { id: "co-dang-di-khong", title: "Di Hòa Viên Có Đáng Đi Không?" },
  { id: "7-dieu-can-nho", title: "7 Điều Cần Nhớ Trước Khi Đi" },
  { id: "faq", title: "Câu Hỏi Thường Gặp (FAQ)" },
  { id: "hanh-trinh-fit-tour", title: "Di Hòa Viên Trong Hành Trình FIT TOUR" }
];
---

<BaseLayout 
  title={seoTitle} 
  description={seoDesc} 
  image={seoImage}
  preloadImages={[seoImage]}
  adminEditUrl={adminEditUrl}
>
  <div class="bg-[#F8F9FA] text-[#1E293B] font-sans antialiased selection:bg-[#F7931E] selection:text-white">

    {/* ================= HERO SECTION ================= */}
    <section class="relative w-full min-h-[580px] lg:min-h-[660px] overflow-hidden flex flex-col justify-center pt-32 pb-20">
      <div class="absolute inset-0 z-0 bg-slate-950">
        <img 
          src={seoImage} 
          alt="Di Hòa Viên Cung Điện Mùa Hè Bắc Kinh Trung Quốc" 
          class="w-full h-full object-cover object-center opacity-75" 
          width="1920" 
          height="1080"
          fetchpriority="high" 
          loading="eager" 
          decoding="async" 
        />
        <div class="absolute inset-0 bg-gradient-to-r from-black/90 via-black/65 to-black/35"></div>
        <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-transparent to-transparent"></div>
      </div>

      <div class="relative z-10 max-w-[1600px] mx-auto px-4 sm:px-6 lg:px-12 w-full">
        
        {/* Breadcrumb */}
        <div class="flex items-center gap-2 text-[13px] text-white/70 font-medium mb-6">
          <a href="/" class="hover:text-white transition-colors">Trang chủ</a>
          <ChevronRight class="w-3 h-3" />
          <a href="/blog" class="hover:text-white transition-colors">Blog</a>
          <ChevronRight class="w-3 h-3" />
          <span class="text-white font-semibold line-clamp-1">Di Hòa Viên (Summer Palace)</span>
        </div>

        {/* Titles */}
        <h1 class="font-serif text-3xl sm:text-4xl lg:text-5xl xl:text-6xl font-bold text-white mb-4 leading-[1.15] drop-shadow-lg max-w-5xl">
          {post.title}
        </h1>
        <h2 class="font-serif text-lg sm:text-2xl lg:text-3xl text-amber-400 italic mb-8 max-w-4xl drop-shadow-md font-medium">
          Kinh nghiệm chọn cổng, tuyến tham quan, thời gian và những điều cần biết trước khi đi
        </h2>
        <p class="text-white/90 text-base sm:text-lg max-w-3xl leading-relaxed mb-8 hidden md:block drop-shadow-md font-normal">
          Di Hòa Viên là khu vườn hoàng gia nổi tiếng nhất Bắc Kinh, <a href="/country/trung-quoc" class="text-amber-400 hover:text-amber-300 underline underline-offset-4" title="Du lịch Trung Quốc">Trung Quốc</a>. Nơi đây kết hợp hài hòa giữa Đồi Trường Thọ, mặt nước Hồ Côn Minh thơ mộng và các kiến trúc cung đình đỉnh cao của triều đại nhà Thanh.
        </p>

        {/* Author Meta */}
        <div class="flex flex-wrap items-center gap-4 sm:gap-6 text-sm text-white/80 border-t border-white/20 pt-6 max-w-3xl">
          <a href={authorData.url} class="flex items-center gap-3 group">
            <img 
              src={authorData.img} 
              alt={authorData.name} 
              width="40" 
              height="40" 
              class="w-10 h-10 rounded-full border-2 border-white/30 object-cover object-top group-hover:border-amber-400 transition-colors" 
            />
            <span class="font-bold text-white group-hover:text-amber-400 transition-colors flex items-center gap-1">
              {authorData.name} 
              <CheckCircle2 class="w-4 h-4 text-blue-400" />
            </span>
          </a>
          <div class="flex items-center gap-2 bg-white/10 px-4 py-2 rounded-full backdrop-blur-sm border border-white/10">
            <Calendar class="w-4 h-4 opacity-70" />
            <span>{datePrefix} {formattedDate}</span>
          </div>
          <div class="flex items-center gap-2 bg-black/30 px-3 py-1.5 rounded-full backdrop-blur-sm">
            <Clock class="w-4 h-4 text-amber-400" />
            <span>{post.readingTime || 14} phút đọc</span>
          </div>
        </div>

        {/* Badges Line */}
        <div class="flex flex-wrap items-center gap-3 mt-8 pt-4">
          <div class="flex items-center gap-2 text-xs sm:text-sm text-white font-medium bg-black/60 backdrop-blur-md px-3.5 py-2 border border-white/10 rounded-lg shadow-xl">
            <span class="text-amber-400 text-base">📍</span> Tây Bắc Bắc Kinh (~15km)
          </div>
          <div class="flex items-center gap-2 text-xs sm:text-sm text-white font-medium bg-black/60 backdrop-blur-md px-3.5 py-2 border border-white/10 rounded-lg shadow-xl">
            <span class="text-amber-400 text-base">🏞️</span> Diện Tích ~301 Hecta (3/4 Mặt Nước)
          </div>
          <div class="flex items-center gap-2 text-xs sm:text-sm text-white font-medium bg-black/60 backdrop-blur-md px-3.5 py-2 border border-white/10 rounded-lg shadow-xl">
            <span class="text-amber-400 text-base">🎟️</span> Vé Mua Tại Cửa & Online (Không Bắt Buộc Đặt Trước)
          </div>
          <div class="flex items-center gap-2 text-xs sm:text-sm text-white font-medium bg-black/60 backdrop-blur-md px-3.5 py-2 border border-white/10 rounded-lg shadow-xl">
            <span class="text-amber-400 text-base">🏛️</span> Di Sản Thế Giới UNESCO 1998
          </div>
        </div>

      </div>
    </section>

    {/* ================= MAIN CONTENT GRID ================= */}
    <div class="max-w-[1600px] mx-auto px-4 sm:px-6 lg:px-12 py-12 lg:py-16">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-start">

        {/* ---------------- LEFT SIDEBAR (TOC) ---------------- */}
        <aside class="hidden lg:block lg:col-span-3 sticky top-24">
          <div class="bg-white rounded-2xl shadow-sm border border-slate-200/60 p-6 overflow-hidden">
            <div class="flex items-center gap-2 font-bold text-slate-900 mb-5 border-l-4 border-amber-500 pl-3 text-sm tracking-wide uppercase">
              Mục lục bài viết
            </div>
            
            <nav class="space-y-1 text-[13.5px] font-medium max-h-[calc(100vh-200px)] overflow-y-auto pr-1">
              <a href="#gioi-thieu" class="flex items-center gap-2 text-amber-900 bg-amber-50/80 px-3 py-2 rounded-lg transition-colors font-bold">
                <span class="text-amber-600 text-base">🏠</span> Giới thiệu
              </a>
              
              <div class="pt-1.5 space-y-1 border-l border-slate-200 ml-3 pl-3">
                {toc.slice(1).map((item) => (
                  <a 
                    href={`#${item.id}`} 
                    class={`block transition-colors leading-tight py-1.5 text-slate-600 hover:text-amber-800 ${item.indent ? 'pl-2 text-[12.5px] border-l border-transparent hover:border-amber-400' : 'font-semibold text-[13px]'}`}
                  >
                    {item.title}
                  </a>
                ))}
              </div>
            </nav>
          </div>
        </aside>

        {/* ---------------- CENTER COLUMN (MAIN CONTENT) ---------------- */}
        <main class="col-span-1 lg:col-span-6 space-y-10">
          
          {/* Quick Overview Stats Bar */}
          <div class="bg-white rounded-2xl shadow-sm border border-slate-200/60 p-6 flex flex-wrap lg:flex-nowrap items-center justify-between gap-4">
            
            <div class="w-full flex items-center justify-between gap-4 mb-2 lg:hidden">
              <span class="font-bold text-slate-900 text-sm border-l-4 border-amber-500 pl-2 uppercase">Tổng Quan Nhanh</span>
            </div>

            <div class="flex items-center gap-3 w-[48%] lg:w-auto">
              <div class="w-10 h-10 rounded-full bg-amber-50 flex items-center justify-center text-amber-700 text-xl border border-amber-200/60 shrink-0">📍</div>
              <div>
                <div class="text-[11px] text-slate-500 font-medium">Vị trí</div>
                <div class="text-[13px] font-bold text-slate-900">Tây Bắc Bắc Kinh (~15km)</div>
              </div>
            </div>

            <div class="hidden lg:block w-px h-8 bg-slate-200"></div>

            <div class="flex items-center gap-3 w-[48%] lg:w-auto">
              <div class="w-10 h-10 rounded-full bg-amber-50 flex items-center justify-center text-amber-700 text-xl border border-amber-200/60 shrink-0">📐</div>
              <div>
                <div class="text-[11px] text-slate-500 font-medium">Quy mô</div>
                <div class="text-[13px] font-bold text-slate-900">301 ha (3/4 mặt hồ)</div>
              </div>
            </div>

            <div class="hidden lg:block w-px h-8 bg-slate-200"></div>

            <div class="flex items-center gap-3 w-[48%] lg:w-auto">
              <div class="w-10 h-10 rounded-full bg-amber-50 flex items-center justify-center text-amber-700 text-xl border border-amber-200/60 shrink-0">🎫</div>
              <div>
                <div class="text-[11px] text-slate-500 font-medium">Đặt vé</div>
                <div class="text-[13px] font-bold text-slate-900">Tại chỗ & Online linh hoạt</div>
              </div>
            </div>

            <div class="hidden lg:block w-px h-8 bg-slate-200"></div>

            <div class="flex items-center gap-3 w-[48%] lg:w-auto">
              <div class="w-10 h-10 rounded-full bg-amber-50 flex items-center justify-center text-amber-700 text-xl border border-amber-200/60 shrink-0">⏱️</div>
              <div>
                <div class="text-[11px] text-slate-500 font-medium">Thời gian gợi ý</div>
                <div class="text-[13px] font-bold text-slate-900">3 – 5 giờ (Nửa ngày)</div>
              </div>
            </div>

          </div>

          {/* Intro Text */}
          <div id="gioi-thieu" class="prose prose-slate max-w-none prose-p:leading-relaxed prose-p:text-[16px] prose-p:text-slate-700 space-y-4">
            <p>
              Nếu <a href="/tu-cam-thanh" class="text-brand-700 hover:text-brand-800 underline font-medium">Tử Cấm Thành</a> đưa bạn vào thế giới của quyền lực tối thượng và những nghi lễ thâm nghiêm, thì <strong>Di Hòa Viên (颐和园, Yíhéyuán)</strong> lại mở ra một bầu không khí hoàn toàn trái ngược: thư thái, phóng khoáng và tràn ngập hơi thở thiên nhiên.
            </p>
            <p>
              Được mệnh danh là một trong những khu vườn hoàng gia được bảo tồn tốt nhất Trung Quốc, Di Hòa Viên là sự kết hợp tài tình giữa bàn tay con người và vẻ đẹp tạo hóa. Ở đây, bạn sẽ được trải nghiệm nhịp điệu du ngoạn chậm rãi: thả bước bên bờ <strong>Hồ Côn Minh</strong> mênh mông, ngắm nhìn hàng ngàn bức họa trên <strong>Trường Lang</strong>, phóng tầm mắt từ đỉnh <strong>Đồi Trường Thọ</strong>, hay chèo thuyền trôi bồng bềnh giữa sóng nước.
            </p>
            <p>
              Khác với <a href="/tu-cam-thanh" class="text-brand-700 hover:text-brand-800 underline font-medium">Tử Cấm Thành</a> hay <a href="/thien-an-mon" class="text-brand-700 hover:text-brand-800 underline font-medium">Quảng trường Thiên An Môn</a>, Di Hòa Viên <strong>không bắt buộc đặt vé trước</strong>. Bạn có thể linh hoạt mua vé trực tiếp tại quầy hoặc mua online.
            </p>
          </div>

          {/* Section 1: Di Hòa Viên Là Gì? */}
          <section id="di-hoa-vien-la-gi" class="scroll-mt-28 space-y-4">
            <div class="border-l-4 border-amber-500 pl-4">
              <h2 class="font-serif text-2xl lg:text-[26px] font-bold text-slate-900 leading-tight">
                Di Hòa Viên Là Gì?
              </h2>
            </div>
            
            <div class="text-slate-700 text-[15.5px] leading-relaxed space-y-4">
              <p>
                Di Hòa Viên nằm cách trung tâm Bắc Kinh khoảng 15 km về phía tây bắc, sở hữu diện tích khổng lồ lên tới <strong>khoảng 301 ha</strong>, trong đó mặt nước Hồ Côn Minh chiếm tới 3/4 diện tích toàn khu.
              </p>
              <p>
                Khởi nguyên từ năm 1750 dưới thời Hoàng đế Càn Long, khu vườn ban đầu mang tên <strong>Thanh Y Viên (清漪园)</strong>. Đây được xem như món quà hiếu thảo mà vua Càn Long dành tặng cho mẹ mình là Sùng Khánh Hoàng Thái hậu nhân dịp đại thọ 60 tuổi. Công trình hoàn thành năm 1764, trở thành nơi nghỉ dưỡng mùa hè và trung tâm điều hành chính sự ngoài hoàng cung.
              </p>
              <p>
                Trải qua nhiều biến cố lịch sử, khu vườn từng bị thiêu rụi phần lớn trong cuộc chiến năm 1860. Đến cuối thế kỷ 19, dưới thời vua Quang Tự, Từ Hi Thái hậu đã cho tái thiết toàn bộ trên nền móng cũ và chính thức đổi tên thành <strong>Di Hòa Viên</strong> ("khu vườn nuôi dưỡng sự an hòa"). Sau sự kiện Liên quân Tám nước tàn phá năm 1900, hoa viên tiếp tục được trùng tu và chính thức mở cửa cho công chúng từ năm 1924.
              </p>
              <div class="bg-amber-50/70 p-4 rounded-xl border border-amber-200 text-sm text-slate-800 space-y-1">
                🏛️ <strong><a href="https://whc.unesco.org/en/list/880/" target="_blank" rel="noopener noreferrer" class="text-brand-700 hover:text-brand-800 underline font-medium">Di Hòa Viên – Di sản Thế giới UNESCO</a> (1998):</strong> UNESCO công nhận nơi đây là một kiệt tác của nghệ thuật làm vườn phong cảnh Trung Hoa, nơi địa hình tự nhiên của đồi núi và mặt hồ hòa quyện xuất sắc với kiến trúc cung điện, chùa miếu, cầu và đình tạ.
              </div>
            </div>
          </section>

          {/* Section 2: Vì Sao Đáng Đi? */}
          <section id="vi-sao-dang-di" class="scroll-mt-28 space-y-4">
            <div class="border-l-4 border-amber-500 pl-4">
              <h2 class="font-serif text-2xl lg:text-[26px] font-bold text-slate-900 leading-tight">
                Vì Sao Di Hòa Viên Đáng Đi?
              </h2>
            </div>

            <div class="text-slate-700 text-[15.5px] leading-relaxed space-y-4">
              <p>
                Điểm thu hút của Di Hòa Viên không chỉ nằm ở các cung điện, mà là <strong>sự chuyển đổi nhịp nhàng giữa các không gian</strong>:
              </p>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 my-4">
                <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-2xs space-y-2">
                  <span class="text-2xl">👑</span>
