                <div class="text-[11px] text-slate-500">Honest price, value & guide breakdown</div>
              </a>
            </div>
          </div>

          <!-- Card 3: Share This Guide -->
          <div class="bg-white rounded-2xl shadow-sm border border-slate-200/80 p-5 space-y-3">
            <div class="font-bold text-slate-900 text-xs tracking-wider uppercase border-l-4 border-blue-500 pl-3">
              Share This Guide
            </div>
            <p class="text-xs text-slate-600 leading-relaxed">
              Planning a trip to Vietnam? Share this comprehensive guide with your travel companions.
            </p>
            <div class="flex gap-2">
              <a 
                href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(canonicalUrl)}`} 
                target="_blank" 
                rel="noopener noreferrer" 
                class="flex-1 py-2 px-3 rounded-xl bg-blue-600 text-white text-xs font-bold text-center hover:bg-blue-700 transition-colors shadow-2xs"
              >
                Facebook
              </a>
              <button 
                id="copy-link-btn"
                data-url={canonicalUrl}
                class="flex-1 py-2 px-3 rounded-xl bg-slate-100 text-slate-800 text-xs font-bold hover:bg-amber-50 hover:text-amber-700 transition-colors border border-slate-200 cursor-pointer"
              >
                Copy Link
              </button>
            </div>
            <div id="copy-toast" class="hidden text-[11px] text-emerald-700 font-bold mt-2 text-center">
              ✓ Copied to clipboard!
            </div>
          </div>

          <!-- Card 4: VIP Bespoke Concierge Card -->
          <div class="bg-slate-900 text-white rounded-2xl p-6 shadow-md space-y-4">
            <div class="text-xs text-amber-400 font-bold uppercase tracking-wider">
              Bespoke Inbound Concierge
            </div>
            <div class="font-serif text-lg font-bold">
              Need Personal Guidance?
            </div>
            <p class="text-xs text-slate-300 leading-relaxed">
              Connect with our local travel specialists to design a tailor-made private Cu Chi or Saigon itinerary suited to your pace.
            </p>
            <a 
              href="/contact" 
              class="block w-full py-2.5 rounded-xl bg-amber-500 text-white font-bold text-xs text-center hover:bg-amber-600 transition-colors"
            >
              Inquire via WhatsApp / Email
            </a>
          </div>

        </div>
      </aside>

    </div>
  </div>

  <script is:inline>
    // Copy Link Script
    const copyBtn = document.getElementById('copy-link-btn');
    const copyToast = document.getElementById('copy-toast');
    if (copyBtn && copyToast) {
      copyBtn.addEventListener('click', async () => {
        const url = copyBtn.getAttribute('data-url') || window.location.href;
        try {
          await navigator.clipboard.writeText(url);
          copyToast.classList.remove('hidden');
          setTimeout(() => {
            copyToast.classList.add('hidden');
          }, 3000);
        } catch (err) {
          console.error('Failed to copy link:', err);
        }
      });
    }

    // TOC Active ScrollSpy Script
    document.addEventListener('DOMContentLoaded', () => {
      const observerOptions = {
        root: null,
        rootMargin: '-120px 0px -60% 0px',
        threshold: 0
      };

      const sections = document.querySelectorAll('article section[id]');
      const tocLinks = document.querySelectorAll('aside nav a[href^="#"]');

      if (!sections.length || !tocLinks.length) return;

      let currentActiveId = null;

      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            const id = entry.target.id;
            if (id !== currentActiveId) {
              currentActiveId = id;
              updateActiveToc(id);
            }
          }
        });
      }, observerOptions);

      sections.forEach(section => observer.observe(section));

      function updateActiveToc(activeId) {
        tocLinks.forEach(link => {
          const href = link.getAttribute('href') || '';
          const id = href.startsWith('#') ? href.slice(1) : '';
          if (id === activeId) {
            link.classList.remove('text-slate-600', 'hover:bg-slate-50');
            link.classList.add('text-amber-900', 'bg-amber-50/80', 'font-bold');
          } else {
            link.classList.remove('text-amber-900', 'bg-amber-50/80', 'font-bold');
            link.classList.add('text-slate-600', 'hover:bg-slate-50');
          }
        });
      }
    });
  </script>
</BaseLayout>
