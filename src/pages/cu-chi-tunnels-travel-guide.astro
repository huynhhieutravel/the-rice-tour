---
import { env } from 'cloudflare:workers';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { safeQueryCritical } from '@/lib/db-client';
import { getGlobalSettings } from '@/lib/settingsHelper';
import JsonLdSchema from '@/components/seo/JsonLdSchema.astro';

export const prerender = false;

const currentSlug = 'cu-chi-tunnels-travel-guide';

// Fetch post from D1 database with fallback
const d1Db = env?.dulichcoguu_d1 || (Astro.locals as any)?.runtime?.env?.dulichcoguu_d1;
let post: any = null;
try {
  if (d1Db) {
    post = await safeQueryCritical(
      d1Db.prepare("SELECT * FROM Post WHERE slug = ? AND (status = 'published' OR status = 'publish')").bind(currentSlug).first<any>(),
      { route: Astro.url.pathname, slug: currentSlug, queryType: "fetch_post_by_slug" }
    );
  }
} catch (e) {
  console.warn('[D1 Query Warning] cu-chi-tunnels-travel-guide:', e);
}

// Fallback metadata if D1 is not yet populated
if (!post) {
  post = {
    id: 19815,
    title: 'Cu Chi Tunnels: The Complete Travel Guide',
    slug: currentSlug,
    description: 'The definitive Cu Chi Tunnels travel guide: Ben Dinh vs. Ben Duoc, realistic 2026 travel logistics, crawling realities, underground engineering, and curated tour planning from Saigon.',
    featuredImage: 'https://media.thericetour.com/uploads/tour-group-listening-briefing-underground-hall-cu-chi-tunnels.webp',
    publishedAt: '2026-09-24T08:00:00.000Z',
    updatedAt: '2026-09-24T10:15:00.000Z',
    readingTime: 26,
    author: 'The Rice Tour Editorial',
    tags: JSON.stringify(['Cu Chi Tunnels', 'Ho Chi Minh City', 'Vietnam Travel Guide', 'Ben Dinh', 'Ben Duoc', 'Saigon Tours'])
  };
}

const pageTitle = post.title || 'Cu Chi Tunnels: The Complete Travel Guide';
const pageDesc = post.description || 'The definitive Cu Chi Tunnels travel guide: Ben Dinh vs. Ben Duoc, realistic 2026 travel logistics, crawling realities, underground engineering, and curated tour planning from Saigon.';
const seoTitle = `${pageTitle} | The Rice Tour`;
const seoDesc = pageDesc;
const seoImage = post.featuredImage || 'https://media.thericetour.com/uploads/tour-group-listening-briefing-underground-hall-cu-chi-tunnels.webp';

// Author & Date Formatting
const displayDate = post.updatedAt ? new Date(post.updatedAt) : (post.publishedAt ? new Date(post.publishedAt) : new Date());
const formattedDate = displayDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
});
const datePrefix = post.updatedAt ? 'Updated on' : 'Published on';
const createdAtStr = post.publishedAt ? new Date(post.publishedAt).toISOString() : new Date().toISOString();
const updatedAtStr = post.updatedAt ? new Date(post.updatedAt).toISOString() : createdAtStr;

const authorMap: Record<string, { name: string; role: string; img: string; url: string }> = {
  "The Rice Tour Editorial": {
    name: "The Rice Tour Editorial",
    role: "Inbound Travel Specialist",
    img: "/images/the-rice-tour-editorial.webp",
    url: "/about-us"
  },
  "Hieu Huynh": {
    name: "Hieu Huynh",
    role: "Founder & Indochina Cultural Guide",
    img: "https://media.fittour.vn/uploads/huynhhieutravel.webp",
    url: "/about-us"
  }
};
const authorData = authorMap[post.author] || authorMap["The Rice Tour Editorial"];

// --- TABLE OF CONTENTS (TOC) ---
const tocItems = [
  { id: "gioi-thieu", title: "Introduction" },
  { id: "at-a-glance", title: "Cu Chi Tunnels At A Glance" },
  { id: "what-are-tunnels", title: "What Are The Cu Chi Tunnels?" },
  { id: "life-underground", title: "Life Underground Was More Than Warfare" },
  { id: "history-engineering", title: "History & Multi-Tier Architecture" },
  { id: "how-network-worked", title: "How The Underground Network Functioned" },
  { id: "original-vs-adapted", title: "Are The Visitor Tunnels Original?" },
  { id: "ben-dinh-vs-ben-duoc", title: "Ben Dinh vs. Ben Duoc: Sector Choice" },
  { id: "typical-visit-stages", title: "What Happens During A Typical Visit?" },
  { id: "do-you-have-to-crawl", title: "Do You Have To Crawl Through Tunnels?" },
  { id: "crawling-feel-realities", title: "Crawling Realities & Body Size Check" },
  { id: "reality-check", title: "Cu Chi Tunnels Reality Check" },
  { id: "why-experiences-differ", title: "Why Traveler Experiences Differ" },
  { id: "can-you-visit-without-tour", title: "Can You Visit Without A Tour?" },
  { id: "how-long-do-you-need", title: "How Long Do You Need For A Visit?" },
  { id: "transportation-options", title: "How To Get To Cu Chi Tunnels" },
  { id: "weather-and-season", title: "Weather And Season Timing" },
  { id: "best-time-crowds", title: "Best Time to Visit & Crowd Strategy" },
  { id: "wardrobe-packing", title: "What to Wear & Packing Checklist" },
  { id: "persona-matrix", title: "Persona Decision Matrix" },
  { id: "recommended-tours", title: "Curated Cu Chi Experiences" },
  { id: "frequently-asked-questions", title: "Frequently Asked Questions (FAQ)" },
  { id: "conclusion", title: "Visiting Cu Chi: Final Practical Thoughts" }
];

// SSR JSON-LD Schemas
const currentOrigin = 'https://thericetour.com';
const canonicalUrl = `${currentOrigin}/${currentSlug}`;

const breadcrumbSchema = {
  items: [
    { name: "Home", url: `${currentOrigin}/` },
    { name: "Travel Guides", url: `${currentOrigin}/blog` },
    { name: pageTitle, url: canonicalUrl }
  ]
};

const faqSchema = {
  questions: [
    {
      question: "How far are the Cu Chi Tunnels from downtown Ho Chi Minh City?",
      answer: "Cu Chi is roughly 50 to 70 kilometers northwest of central Ho Chi Minh City by road, depending on the visitor sector and route. Ben Dinh is closer (~50 km; 1.5 to 2 hours), while Ben Duoc lies farther (~70 km; 2 to 2.5 hours). Travel time matters more than headline distance because traffic along Highway 22 can significantly lengthen the journey."
    },
    {
      question: "Which site should you visit: Ben Dinh or Ben Duoc?",
      answer: "Neither site should be simplified as 'authentic' versus 'commercial'—both have been conserved and adapted for visitor safety. Ben Dinh (Nhuan Duc Commune) is closer and best suited for travelers on compact half-day schedules. Ben Duoc (Phu My Hung Commune) is farther, significantly quieter, and features the monumental Ben Duoc Memorial Temple alongside multi-level tunnel networks."
    },
    {
      question: "Are the Cu Chi Tunnels you crawl through original?",
      answer: "They are authentic historic tunnel areas, but the visitor experience is not the same as entering an untouched wartime tunnel. Sections open to tourists have been conserved, repaired, reinforced, and in places enlarged or equipped with electric lighting for safety and accessibility. The original network was far larger than the sections visitors can explore today."
    },
    {
      question: "Why does a 250 km tunnel network have only about 4 km preserved today?",
      answer: "The 250 km figure represents the estimated cumulative footprint of the wartime subterranean system at its historical peak. Over decades of conflict and post-war agricultural expansion, large portions collapsed or were reclaimed by nature. Today, the two principal conserved areas at Ben Duoc (~8.4 ha) and Ben Dinh (~6.71 ha) preserve approximately 4 km of tunnel remains for research, education, and heritage access."
    },
    {
      question: "Is Cu Chi suitable for tall or larger travelers?",
      answer: "Visitor tunnels have been enlarged compared with original wartime passages, but they can still feel extremely tight. If you are over 6 ft (183 cm), have broad shoulders, or dislike crouching in confined spaces, you can test the first short 15–20 meter section before deciding whether to continue, or choose to enjoy the above-ground exhibits entirely."
    },
    {
      question: "Can you visit Cu Chi independently without booking a tour?",
      answer: "Yes. Cu Chi can be visited independently. Travelers can arrange their own transport (via private car, taxi/Grab, or public bus), purchase admission at the gate, and utilize the on-site guiding service included in the 135,000 VND foreign visitor tariff. A private tour adds convenience with door-to-door transport, tailored departure timing, and deeper personalized interpretation."
    },
    {
      question: "Are Cu Chi and Vinh Moc Tunnels the same?",
      answer: "No. They served very different historical and geographic purposes. Cu Chi (near Saigon) was an active tactical military fortification and guerrilla combat base carved through red clay, featuring very tight passages. Vinh Moc (in Quang Tri Province along the DMZ) was an underground coastal village excavated through basalt rock where hundreds of civilians lived for months to shelter from heavy aerial bombardment."
    },
    {
      question: "Are there other wartime tunnels in Ho Chi Minh City?",
      answer: "Yes. Other tunnel heritage sites exist in the region, such as the Phu Tho Hoa tunnel relic in Tan Phu District, which dates back to the French colonial resistance. However, Cu Chi remains by far the largest, most intact, and most comprehensive wartime tunnel network open to visitors in southern Vietnam."
    },
    {
      question: "Do you have to crawl through a tunnel?",
      answer: "No. Entering the tunnels is 100% voluntary. Over 90% of the exhibits, demonstrations, bunkers, and relics are situated above ground along shaded, accessible trails."
    },
    {
      question: "How much does Cu Chi Tunnels admission cost in 2026?",
      answer: "Official foreign-visitor admission is 135,000 VND per person (comprising 35,000 VND gate admission and 100,000 VND heritage and site-guide fee). Vietnamese citizens pay 35,000 VND. Shooting range ammunition is sold separately."
    },
    {
      question: "What is the UNESCO status of Cu Chi Tunnels in 2026?",
      answer: "Cu Chi Tunnels was added to Vietnam's UNESCO World Heritage Tentative List on July 15, 2026, under cultural criteria (iv) and (vi). It is not yet an inscribed UNESCO World Heritage Site."
    },
    {
      question: "Can claustrophobic travelers enjoy Cu Chi?",
      answer: "Yes. Claustrophobic visitors can thoroughly enjoy the open-air walking tour, examine trap mechanisms, watch the introductory documentary, inspect above-ground bunkers, and skip the underground crawl entirely without feeling left out."
    },
    {
      question: "Can you combine Cu Chi Tunnels and the Mekong Delta in one day?",
      answer: "While commercially available through budget agencies, we strongly advise against it. The combined itinerary requires 6.5 to 7.5 hours inside a vehicle covering over 200 kilometers of congested highway, leaving you exhausted with minimal time at each destination. Dedicate a half-day to Cu Chi and explore the Mekong Delta on a separate day."
    }
  ]
};

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": pageTitle,
  "description": pageDesc,
  "image": seoImage,
  "datePublished": createdAtStr,
  "dateModified": updatedAtStr,
  "author": {
    "@type": "Person",
    "name": authorData.name,
    "url": `${currentOrigin}${authorData.url}`
  },
  "publisher": {
    "@type": "Organization",
    "name": "The Rice Tour",
    "logo": {
      "@type": "ImageObject",
      "url": "https://media.thericetour.com/uploads/logo-the-rice.webp"
    }
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": canonicalUrl
  }
};
---

<BaseLayout 
  title={seoTitle} 
  description={seoDesc} 
  image={seoImage}
  canonical={canonicalUrl}
  preloadImages={[seoImage]}
  adminEditUrl={post?.id ? `/admin/posts/edit/${post.id}` : undefined}
  lang="en"
  ogType="article"
>
  <Fragment slot="schema">
    <JsonLdSchema type="breadcrumb" data={breadcrumbSchema} />
    <JsonLdSchema type="custom" data={articleSchema} />
    <JsonLdSchema type="faq" data={faqSchema} />
  </Fragment>

  <!-- HERO SECTION HEADER (Full-width, Dark Magazine Style) -->
  <header class="relative bg-slate-950 text-white pt-28 pb-20 md:pt-36 md:pb-28 overflow-hidden">
    <!-- Background Image with Multi-layer Gradients -->
    <div class="absolute inset-0 z-0">
      <img 
        src={seoImage} 
        alt={pageTitle}
        class="w-full h-full object-cover object-center brightness-75 scale-105 transform motion-safe:animate-subtle-zoom"
        loading="eager"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/75 to-slate-950/40"></div>
      <div class="absolute inset-0 bg-gradient-to-r from-slate-950/90 via-slate-950/50 to-transparent"></div>
    </div>

    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Breadcrumbs -->
      <nav class="flex items-center gap-2 text-xs sm:text-sm text-slate-300/80 mb-6" aria-label="Breadcrumb">
        <a href="/" class="hover:text-white transition-colors">Home</a>
        <span>/</span>
        <a href="/blog" class="hover:text-white transition-colors">Travel Guides</a>
        <span>/</span>
        <span class="text-amber-400 font-medium truncate max-w-xs sm:max-w-md">{pageTitle}</span>
      </nav>

      <!-- Main Title -->
      <h1 class="font-serif text-3xl sm:text-4xl lg:text-5xl xl:text-6xl font-bold text-white mb-4 leading-[1.15] drop-shadow-lg max-w-5xl">
        {pageTitle}
      </h1>

      <!-- Subtitle -->
      <h2 class="font-serif text-lg sm:text-2xl lg:text-3xl text-amber-400 italic mb-8 max-w-4xl drop-shadow-md font-medium">
        The Definitive Visitor Guide to Ben Dinh, Ben Duoc, Underground Logistics, and Practical Day-Trip Planning
      </h2>

      <!-- Lead Paragraph -->
      <p class="text-white/90 text-base sm:text-lg max-w-3xl leading-relaxed mb-8 hidden md:block drop-shadow-md font-normal">
        Beneath the rubber trees and red clay northwest of Ho Chi Minh City lies the surviving core of a wartime stronghold. From choosing between Ben Dinh and Ben Duoc to what crawling really feels like, here is an honest, field-tested guide to visiting Cu Chi.
      </p>

      <!-- Author Meta Row -->
      <div class="flex flex-wrap items-center gap-6 pt-4 border-t border-white/15 text-sm text-slate-300">
        <div class="flex items-center gap-3">
          <img 
            src={authorData.img} 
            alt={authorData.name} 
            class="w-10 h-10 rounded-full border-2 border-amber-400 object-cover shadow-sm bg-slate-900"
            onerror="this.src='/favicon.png'"
            width="40"
            height="40"
            loading="eager"
          />
          <div>
            <div class="font-semibold text-white flex items-center gap-1.5">
              {authorData.name}
              <svg class="w-4 h-4 text-amber-400" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
              </svg>
            </div>
            <div class="text-xs text-slate-300/80">{authorData.role}</div>
          </div>
        </div>

        <div class="h-8 w-px bg-white/15 hidden sm:block"></div>

        <div class="text-xs sm:text-sm">
          <span class="text-slate-400">{datePrefix}:</span> {formattedDate}
        </div>

        <div class="h-8 w-px bg-white/15 hidden sm:block"></div>

        <div class="flex items-center gap-1.5 text-xs sm:text-sm">
          <span>⏱️</span>
          <span>{post.readingTime} min comprehensive read</span>
        </div>
      </div>

      <!-- Badges Line -->
      <div class="flex flex-wrap gap-2.5 sm:gap-3 mt-8">
        <div class="bg-black/60 backdrop-blur-md px-3.5 py-2 border border-white/10 rounded-lg shadow-xl text-xs sm:text-sm text-white font-medium flex items-center gap-2">
          <span>📍</span> Ben Dinh & Ben Duoc Sectors
        </div>
        <div class="bg-black/60 backdrop-blur-md px-3.5 py-2 border border-white/10 rounded-lg shadow-xl text-xs sm:text-sm text-white font-medium flex items-center gap-2">
          <span>🏛️</span> UNESCO Tentative List 2026
        </div>
        <div class="bg-black/60 backdrop-blur-md px-3.5 py-2 border border-white/10 rounded-lg shadow-xl text-xs sm:text-sm text-white font-medium flex items-center gap-2">
          <span>🛡️</span> 100% Voluntary Tunnel Crawling
        </div>
        <div class="bg-black/60 backdrop-blur-md px-3.5 py-2 border border-white/10 rounded-lg shadow-xl text-xs sm:text-sm text-white font-medium flex items-center gap-2">
          <span>🌿</span> Forest Archaeological Relic
        </div>
      </div>
    </div>
  </header>

  <!-- ================= MAIN CONTENT 3-COLUMN LAYOUT ================= -->
  <div class="max-w-[1600px] mx-auto px-4 sm:px-6 lg:px-8 py-10 lg:py-16">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start">

      <!-- LEFT COLUMN: Sticky Table of Contents -->
      <aside class="hidden lg:block lg:col-span-3 sticky top-24">
        <div class="bg-white rounded-2xl shadow-sm border border-slate-200/80 p-5 overflow-hidden">
          <div class="flex items-center gap-2 font-bold text-slate-900 mb-4 border-l-4 border-amber-500 pl-3 text-xs tracking-wider uppercase">
            <span>📑</span> Table of Contents
          </div>

          <nav class="space-y-1 text-[13px] font-medium max-h-[calc(100vh-180px)] overflow-y-auto pr-1">
            <a 
              href="#gioi-thieu" 
              class="flex items-center gap-2 py-2 px-2.5 rounded-lg text-amber-900 bg-amber-50/80 font-bold transition-colors"
            >
              <span>🏠</span> Introduction
            </a>
            
            <div class="pt-1.5 space-y-1 border-l border-slate-200 ml-3 pl-3">
              {tocItems.slice(1).map((item) => (
                <a 
                  href={`#${item.id}`} 
                  class="block py-1.5 px-2 text-slate-600 hover:text-amber-900 hover:bg-slate-50 rounded transition-colors truncate"
                  title={item.title}
                >
                  {item.title}
                </a>
              ))}
            </div>
          </nav>
        </div>
      </aside>

      <!-- CENTER COLUMN: Editorial Content -->
      <main class="col-span-1 lg:col-span-6 space-y-12">

        <!-- Quick Overview Stats Bar (Strictly 3 Items) -->
        <div class="bg-white rounded-2xl shadow-sm border border-slate-200/60 p-5 md:p-6 mb-8">
          <div class="grid grid-cols-1 md:grid-cols-3 divide-y md:divide-y-0 md:divide-x divide-slate-100 gap-4 md:gap-0">
            <div class="flex items-center gap-3.5 md:px-4 first:pl-0 last:pr-0">
              <div class="w-11 h-11 rounded-xl bg-amber-50 flex items-center justify-center text-amber-700 text-xl border border-amber-200/80 shrink-0 shadow-xs">📍</div>
              <div class="min-w-0 flex-1">
                <div class="text-[10.5px] sm:text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-0.5 leading-tight">Distance Range</div>
                <div class="text-[13.5px] sm:text-[14px] font-bold text-slate-900 leading-snug">~50 – 70 km NW</div>
              </div>
            </div>

            <div class="flex items-center gap-3.5 md:px-4 first:pl-0 last:pr-0 pt-3 md:pt-0">
              <div class="w-11 h-11 rounded-xl bg-blue-50 flex items-center justify-center text-blue-700 text-xl border border-blue-200/80 shrink-0 shadow-xs">⏱️</div>
              <div class="min-w-0 flex-1">
                <div class="text-[10.5px] sm:text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-0.5 leading-tight">Visit Pace</div>
                <div class="text-[13.5px] sm:text-[14px] font-bold text-slate-900 leading-snug">2 to 3.5 hrs</div>
              </div>
            </div>

            <div class="flex items-center gap-3.5 md:px-4 first:pl-0 last:pr-0 pt-3 md:pt-0">
              <div class="w-11 h-11 rounded-xl bg-emerald-50 flex items-center justify-center text-emerald-700 text-xl border border-emerald-200/80 shrink-0 shadow-xs">🎟️</div>
              <div class="min-w-0 flex-1">
                <div class="text-[10.5px] sm:text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-0.5 leading-tight">2026 Tariff</div>
                <div class="text-[13.5px] sm:text-[14px] font-bold text-slate-900 leading-snug">135,000 VND</div>
              </div>
            </div>
          </div>
        </div>

        <!-- Article Content -->
        <article class="space-y-12 text-slate-800 leading-relaxed font-normal">

          <!-- Section: Introduction -->
          <section id="gioi-thieu" class="scroll-mt-28 space-y-4">
            <div class="text-slate-700 text-[16px] sm:text-[17px] leading-relaxed space-y-4">
              <p>
                The Cu Chi Tunnels are often misunderstood before people set foot here. Most travelers expect an intense, claustrophobic underground trek. What you actually encounter northwest of Ho Chi Minh City is an open-air historical site set under regenerated forest canopy—the surviving core of a wartime stronghold hand-chiseled out of dense red clay that once sheltered fighters, field medics, and entire village families beneath sustained bombardment.
              </p>
              <p>
                Today, nobody wanders through 250 kilometers of tunnels. Instead, two separate visitor areas—<strong>Ben Dinh</strong> and <strong>Ben Duoc</strong>—offer preserved and adapted sections where you can see camouflaged trapdoors, examine disguised air vents, inspect reconstructed booby traps, crawl short tunnel segments, and understand how an entire community ate, slept, and worked underground for years.
              </p>
              <p>
                Most of your time is spent outdoors along shaded dirt trails. You'll walk past bomb craters, watch archival wartime briefings in open-air thatch pavilions, examine captured weaponry, and taste the steamed cassava that kept resistance fighters alive.
              </p>
              <p>
                Your main planning decision isn't whether to go—it's deciding which sector suits your pace, figuring out how early you're willing to wake up, and choosing how you want to handle the drive.
              </p>

              {/* Callout Quote */}
              <blockquote class="border-l-4 border-amber-500 pl-4 py-3 my-6 bg-amber-50/60 rounded-r-xl italic text-slate-800 font-serif text-[16.5px]">
                "The Cu Chi Tunnels were never just an escape route; they functioned as an underground combat village (làng hầm) carved by hand out of iron-rich clay to keep an entire society alive beneath the battlefield."
              </blockquote>

              {/* Featured Image inside Body */}
              <div class="my-6 not-prose">
                <div class="rounded-2xl overflow-hidden shadow-md border border-slate-200">
                  <img 
                    src="https://media.thericetour.com/uploads/tour-group-listening-briefing-underground-hall-cu-chi-tunnels.webp" 
                    alt="Tour group listening attentively to a historical briefing in an underground pavilion at Cu Chi Tunnels - The Rice Tour" 
                    class="w-full h-auto object-cover max-h-[500px]"
                    width="1280"
                    height="720"
                    loading="eager"
                  />
                </div>
                <p class="text-center text-xs sm:text-sm text-slate-500 italic mt-2.5">
                  Tour groups attending an introductory briefing in an open-air forested pavilion before exploring the historical tunnel sectors.
                </p>
              </div>

              {/* UNESCO Callout Box */}
              <div class="p-5 sm:p-6 rounded-2xl bg-amber-50/80 border border-amber-200 text-slate-800 text-sm sm:text-base leading-relaxed my-6 shadow-sm">
                <div class="font-bold text-amber-900 mb-2 flex items-center gap-2">
                  <span class="text-xl">🏛️</span> 2026 Heritage Dossier & UNESCO Update
                </div>
                <p class="text-slate-700 text-sm">
                  On July 15, 2026, Viet Nam officially submitted the Cu Chi Tunnels historical relic to the <strong>UNESCO World Heritage Tentative List</strong> under cultural criteria <em>(iv)</em> and <em>(vi)</em>. It is on the nomination roster, not yet an inscribed World Heritage Site. The official submission dossier identifies Ben Duoc (~8.4 ha in Phu My Hung Commune) and Ben Dinh (~6.71 ha in Nhuan Duc Commune) as the two primary conservation zones, creating a proposed 15.11-hectare property. Across both sectors, roughly 4 km of tunnel passages are protected and maintained for conservation and public visits.
                </p>
              </div>
            </div>
          </section>

          <!-- Section: Cu Chi Tunnels At A Glance -->
          <section id="at-a-glance" class="scroll-mt-28 space-y-4">
            <div class="border-l-4 border-amber-500 pl-4 mb-4">
              <h2 class="font-serif text-2xl lg:text-[26px] font-bold text-slate-900 leading-tight">
                Cu Chi Tunnels At A Glance
              </h2>
            </div>
            <p class="text-slate-700 text-[16px]">
              For quick planning and grounded expectations, here is the essential factual baseline for 2026:
            </p>

            <div class="overflow-x-auto my-4 not-prose">
              <table class="w-full text-left text-xs sm:text-sm border border-slate-200 rounded-xl overflow-hidden shadow-2xs">
                <thead class="bg-slate-900 text-white uppercase text-[11px] tracking-wider">
                  <tr>
                    <th class="p-3.5 sm:p-4">Dimension</th>
                    <th class="p-3.5 sm:p-4">Ground Reality</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 bg-white text-slate-700">
                  <tr class="hover:bg-slate-50">
