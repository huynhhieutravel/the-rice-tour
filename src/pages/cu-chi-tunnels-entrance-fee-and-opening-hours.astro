---
import { env } from 'cloudflare:workers';
import BaseLayout from '../layouts/BaseLayout.astro';
import JsonLdSchema from '../components/seo/JsonLdSchema.astro';
import { safeQueryCritical } from '@/lib/db-client';

export const prerender = false;

// --- DATA CONFIGURATION ---
const currentSlug = "cu-chi-tunnels-entrance-fee-and-opening-hours";

// Fetch post from D1 database with fallback
const d1Db = (env as any)?.dulichcoguu_d1 || (Astro.locals as any)?.runtime?.env?.dulichcoguu_d1;
let post: any = null;
try {
  if (d1Db) {
    post = await safeQueryCritical(
      d1Db.prepare("SELECT * FROM Post WHERE slug = ? AND (status = 'published' OR status = 'publish')").bind(currentSlug).first<any>(),
      { route: Astro.url.pathname, slug: currentSlug, queryType: "fetch_post_by_slug" }
    );
  }
} catch (e) {
  console.warn('[D1 Query Warning] cu-chi-tunnels-entrance-fee-and-opening-hours:', e);
}

// Fallback metadata if D1 query is empty or local
if (!post) {
  post = {
    id: 33743,
    title: "Cu Chi Tunnels Entrance Fee & Opening Hours 2026 — Verified Prices",
    description: "The verified guide to Cu Chi Tunnels entrance fees and opening hours in 2026: official 135,000 VND tariff, Ben Dinh vs. Ben Duoc details, guide services, and visit budgeting.",
    slug: currentSlug,
    author: "The Rice Tour Editorial",
    publishedAt: "2026-09-27T08:00:00.000Z",
    updatedAt: "2026-09-27T16:45:00.000Z",
    readingTime: 18,
    category: "Travel Guides",
    featuredImage: "https://media.thericetour.com/uploads/tourists-check-in-cu-chi-ben-dinh-historic-site-the-rice.webp",
    tags: ["Cu Chi Tunnels", "Entrance Fee", "Opening Hours", "Travel Logistics", "Ben Dinh", "Ben Duoc", "Ho Chi Minh City", "Vietnam Travel Guide"]
  };
}

const pageTitle = post?.title || "Cu Chi Tunnels Entrance Fee & Opening Hours 2026 — Verified Prices";
const pageDescription = post?.excerpt || post?.description || "The verified guide to Cu Chi Tunnels entrance fees and opening hours in 2026: official 135,000 VND tariff, Ben Dinh vs. Ben Duoc details, guide services, and visit budgeting.";
const adminEditUrl = post?.id ? `/admin/posts/edit?id=${post.id}` : '/admin/posts/edit?id=33743';

// Format dates
const pubDate = new Date(post.publishedAt);
const updDate = post.updatedAt ? new Date(post.updatedAt) : null;
const isUpdated = updDate && updDate.getTime() > pubDate.getTime();
const displayDate = isUpdated ? updDate : pubDate;
const datePrefix = isUpdated ? "Updated" : "Published";

const formattedDate = displayDate.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric"
});

// Author mapping
const authorMap: Record<string, { name: string; role: string; img: string; url: string }> = {
  "The Rice Tour Editorial": {
    name: "The Rice Tour Editorial",
    role: "Inbound Travel Specialist",
    img: "/images/the-rice-tour-editorial.webp",
    url: "/about-us"
  },
  "Hieu Huynh": {
    name: "Hieu Huynh",
    role: "Founder & Indochina Cultural Guide",
    img: "https://media.fittour.vn/uploads/huynhhieutravel.webp",
    url: "/about-us"
  }
};
const authorData = authorMap[post.author] || authorMap["The Rice Tour Editorial"];

// --- TABLE OF CONTENTS (TOC) ---
const tocItems = [
  { id: "gioi-thieu", title: "Introduction" },
  { id: "at-a-glance", title: "Entrance Fee & Hours At A Glance" },
  { id: "how-much-2026", title: "How Much Is The Entrance Fee In 2026?" },
  { id: "how-the-fee-works", title: "How The 135,000 VND Fee Works" },
  { id: "why-different-prices", title: "Why Do Older Guides Show 90k, 110k Or 125k?" },
  { id: "what-is-included", title: "What Does The 135,000 VND Fee Include?" },
  { id: "unesco-dimension-box", title: "Why The Visitor Tunnels Differ From Wartime Dimensions" },
  { id: "does-ticket-include-guide", title: "Does The Ticket Include An On-Site Guide?" },
  { id: "what-is-not-included", title: "What Is Not Included In The Fee?" },
  { id: "fee-vs-tour-price", title: "Entrance Fee vs. Tour Price" },
  { id: "check-entrance-included", title: "What To Check When A Tour Says 'Entrance Included'" },
  { id: "advance-online-booking", title: "Do You Need To Buy Tickets Online?" },
  { id: "buy-at-the-gate", title: "Can You Buy Tickets At The Entrance?" },
  { id: "ben-dinh-vs-ben-duoc-pricing", title: "Is The Fee The Same At Ben Dinh And Ben Duoc?" },
  { id: "ben-dinh-vs-ben-duoc-difference", title: "Ben Dinh vs. Ben Duoc — What Is The Difference?" },
  { id: "what-else-at-ben-duoc", title: "What Else Can You Do At Ben Duoc?" },
  { id: "opening-hours-2026", title: "Cu Chi Tunnels Opening Hours In 2026" },
  { id: "best-time-to-visit", title: "What Time Is Best To Visit?" },
  { id: "how-long-do-you-need", title: "How Long Do You Need At Cu Chi Tunnels?" },
  { id: "do-you-have-to-crawl", title: "Do You Have To Crawl Through The Tunnels?" },
  { id: "are-tunnels-original", title: "Are The Visitor Tunnels Original?" },
  { id: "what-should-you-wear", title: "What Should You Wear To Cu Chi Tunnels?" },
  { id: "what-should-you-bring", title: "What Should You Bring?" },
  { id: "children-and-seniors", title: "Suitability For Children & Older Travelers" },
  { id: "shooting-range-and-food", title: "Shooting Range & Refreshment Costs" },
  { id: "visit-independently", title: "Can You Visit Cu Chi Tunnels Independently?" },
  { id: "independent-budget", title: "Budget Breakdown For A Self-Guided Visit" },
  { id: "combining-destinations", title: "Combining Cu Chi With Saigon Or Mekong Delta" },
  { id: "frequently-asked-questions", title: "Frequently Asked Questions (FAQ)" },
  { id: "planning-your-visit", title: "Planning Your Cu Chi Tunnels Visit" }
];

// SSR JSON-LD Schemas
const currentOrigin = 'https://thericetour.com';
const canonicalUrl = `${currentOrigin}/${currentSlug}`;

const breadcrumbSchema = {
  items: [
    { name: "Home", url: `${currentOrigin}/` },
    { name: "Travel Guides", url: `${currentOrigin}/blog` },
    { name: pageTitle, url: canonicalUrl }
  ]
};

const faqSchema = {
  questions: [
    {
      question: "How Much Is The Cu Chi Tunnels Entrance Fee In 2026?",
      answer: "The current published international visitor charge is 135,000 VND per person, consisting of a 35,000 VND historical-site admission fee and a 100,000 VND service and guiding fee."
    },
    {
      question: "When Did The 135,000 VND Price Take Effect?",
      answer: "The updated tariff took effect on February 1, 2026, following the official announcement by the historical site authority on January 19, 2026."
    },
    {
      question: "What Are The Cu Chi Tunnels Opening Hours?",
      answer: "The site's published opening hours are 7:00 AM to 5:00 PM daily."
    },
    {
      question: "Do I Need To Book Cu Chi Tunnels Tickets In Advance?",
      answer: "Generally no for a standard daytime visit. Admission can be purchased directly at the ticket counter upon arrival. Booking ahead is primarily useful for arranging private transportation or a dedicated tour guide."
    },
    {
      question: "Can I Buy Tickets At The Entrance?",
      answer: "Yes. Standard daytime visitors can purchase admission directly at the site ticket counters at both Ben Dinh and Ben Duoc."
    },
    {
      question: "Does The Ticket Include A Guide?",
      answer: "The international visitor tariff includes a 100,000 VND service and guiding component, which provides an on-site guide for the historical route. Commentary from site guides is generally focused on basic orientation and safety."
    },
    {
      question: "Do I Have To Crawl Through The Cu Chi Tunnels?",
      answer: "No. The tunnel crawl is optional. Visitors can comfortably experience the above-ground exhibits, concealed trapdoors, and briefings along shaded forest paths without entering the tunnels."
    },
    {
      question: "Are The Visitor Tunnels Original?",
      answer: "The tunnel network is historically genuine, but sections open to tourists have been reinforced, illuminated, and adapted for visitor safety."
    },
    {
      question: "Is The Shooting Range Included In The Entrance Fee?",
      answer: "No. The shooting range is an optional activity where ammunition is charged separately. Published prices vary by source and weapon type."
    },
    {
      question: "Are Food And Drinks Included?",
      answer: "No. Food and drinks are separate expenses. While a traditional tasting of steamed tapioca and tea is commonly offered along the route, it is not a full meal."
    },
    {
      question: "Are Ben Dinh And Ben Duoc The Same Site?",
      answer: "No. They are separate visitor areas within the wider Cu Chi historical complex, located approximately 13 to 15 kilometers apart."
    },
    {
      question: "Which Is Closer To Ho Chi Minh City, Ben Dinh Or Ben Duoc?",
      answer: "Ben Dinh is generally closer to central Ho Chi Minh City, while Ben Duoc is located farther northwest in the countryside."
    },
    {
      question: "Which Is Quieter, Ben Dinh Or Ben Duoc?",
      answer: "Ben Duoc is generally quieter and offers a more expansive heritage setting, while Ben Dinh is often busier, particularly during peak group-tour periods."
    },
    {
      question: "Are The Old 90,000 VND And 110,000 VND Prices Still Current?",
      answer: "No. Those figures reflect earlier pricing structures and should not be used for 2026 travel budgeting."
    },
    {
      question: "Why Do Some Websites Say 125,000 VND?",
      answer: "The 125,000 VND rate corresponds to the previous tariff (35,000 VND admission + 90,000 VND guiding fee). The guiding fee increased to 100,000 VND on February 1, 2026, bringing the current total to 135,000 VND."
    },
    {
      question: "How Long Should I Spend At Cu Chi Tunnels?",
      answer: "Most travelers should allow around 2 to 3 hours on site, while the full excursion from central Ho Chi Minh City is best planned as a half-day trip."
    },
    {
      question: "Can I Visit Cu Chi Tunnels Without A Tour?",
      answer: "Yes. Independent travel is possible using a private car, ride-hailing app, or public bus."
    },
    {
      question: "What Should I Wear To Cu Chi Tunnels?",
      answer: "Wear comfortable walking shoes and lightweight, breathable clothing that can tolerate dust. Modest clothing is recommended when visiting the Ben Duoc Memorial Temple."
    },
    {
      question: "What Should I Bring To Cu Chi Tunnels?",
      answer: "Bring drinking water, insect repellent, sun protection, and a small day bag. A spare shirt can be useful if you plan to enter the tunnels."
    },
    {
      question: "Is Cu Chi Tunnels Suitable For Someone With Claustrophobia?",
      answer: "Yes. The site can still be visited comfortably because the underground crawl is optional and most exhibits are located in open-air forest areas."
    }
  ]
};

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": pageTitle,
  "description": pageDescription,
  "image": post.featuredImage,
  "datePublished": post.publishedAt,
  "dateModified": post.updatedAt || post.publishedAt,
  "author": {
    "@type": "Person",
    "name": authorData.name,
    "jobTitle": authorData.role,
    "url": `${currentOrigin}${authorData.url}`
  },
  "publisher": {
    "@type": "Organization",
    "name": "The Rice Tour",
    "logo": {
      "@type": "ImageObject",
      "url": "https://media.thericetour.com/uploads/logo-the-rice.webp"
    }
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": canonicalUrl
  }
};
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  image={post.featuredImage}
  canonical={canonicalUrl}
  preloadImages={[post.featuredImage]}
  adminEditUrl={adminEditUrl}
  ogType="article"
  lang="en"
>
  <!-- SEO & Structured Data Injection -->
  <Fragment slot="schema">
    <JsonLdSchema type="breadcrumb" data={breadcrumbSchema} />
    <JsonLdSchema type="custom" data={articleSchema} />
    <JsonLdSchema type="faq" data={faqSchema} />
  </Fragment>

  <!-- Breadcrumbs Bar -->
  <div class="bg-slate-900 border-b border-slate-800 text-slate-300 py-3 text-xs sm:text-sm">
    <div class="max-w-[1600px] mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="flex items-center gap-2 overflow-x-auto whitespace-nowrap" aria-label="Breadcrumb">
        <a href="/" class="hover:text-amber-400 transition-colors">Home</a>
        <span class="text-slate-600">/</span>
        <a href="/blog" class="hover:text-amber-400 transition-colors">Travel Guides</a>
        <span class="text-slate-600">/</span>
        <span class="text-amber-300 truncate max-w-[280px] sm:max-w-none">{post.title}</span>
      </nav>
    </div>
  </div>

  <!-- Hero Header (Cinematic Editorial Magazine Style with CMS Hero Background) -->
  <header class="relative bg-slate-950 text-white pt-20 pb-20 sm:pt-24 sm:pb-28 overflow-hidden border-b border-slate-800">
    <!-- Background Image with Multi-layer Gradients -->
    <div class="absolute inset-0 z-0">
      <img 
        src={post.featuredImage} 
        alt={post.title}
        class="w-full h-full object-cover object-center brightness-[0.32] scale-105 transform motion-safe:animate-subtle-zoom"
        width="1920"
        height="1080"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/80 to-slate-950/50"></div>
      <div class="absolute inset-0 bg-gradient-to-r from-slate-950/90 via-slate-950/60 to-transparent"></div>
    </div>

    <!-- Atmospheric Ambient Elements -->
    <div class="absolute inset-0 bg-radial-at-t from-amber-900/20 via-slate-950/40 to-slate-950 pointer-events-none"></div>
    <div class="absolute -top-32 -right-32 w-96 h-96 bg-amber-500/10 rounded-full blur-3xl pointer-events-none"></div>
    
    <div class="relative max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <!-- Title -->
      <h1 class="font-serif text-3xl sm:text-4xl md:text-5xl lg:text-[52px] font-bold text-white tracking-tight leading-[1.15] max-w-4xl mx-auto">
        Cu Chi Tunnels Entrance Fee & Opening Hours 2026
      </h1>

      <!-- Subtitle -->
      <p class="mt-5 text-base sm:text-lg md:text-xl text-amber-400 italic font-serif max-w-3xl mx-auto leading-relaxed font-normal">
        A verified guide to 2026 international visitor tariffs, official guiding fees, Ben Dinh vs. Ben Duoc pricing, and complete door-to-door visit budgeting.
      </p>

      <!-- Author & Metadata Row -->
      <div class="mt-8 flex flex-wrap items-center justify-center gap-4 sm:gap-6 text-xs sm:text-sm text-slate-300">
        <div class="flex items-center gap-3">
          <img 
            src={authorData.img} 
            alt={authorData.name} 
            class="w-10 h-10 rounded-full border border-amber-400/40 object-cover shadow-sm"
            width="40"
            height="40"
            loading="eager"
          />
          <div>
            <div class="font-semibold text-white flex items-center gap-1.5">
              <span>{authorData.name}</span>
              <span class="text-blue-400 text-xs" title="Verified Author">✓</span>
            </div>
            <div class="text-[11px] text-amber-300/90">{authorData.role}</div>
          </div>
        </div>

        <div class="h-8 w-px bg-white/15 hidden sm:block"></div>

        <div>
          <span class="text-slate-400">{datePrefix}:</span> {formattedDate}
        </div>

        <div class="h-8 w-px bg-white/15 hidden sm:block"></div>

        <div class="flex items-center gap-1.5 text-xs sm:text-sm">
          <span>⏱️</span>
          <span>{post.readingTime} min logistics read</span>
        </div>
      </div>
    </div>
  </header>

  <!-- ================= MAIN CONTENT 3-COLUMN LAYOUT ================= -->
  <div class="max-w-[1600px] mx-auto px-4 sm:px-6 lg:px-8 py-10 lg:py-16">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start">

      <!-- LEFT COLUMN: Sticky Table of Contents -->
      <aside class="hidden lg:block lg:col-span-3 sticky top-24">
        <div class="bg-white rounded-2xl shadow-sm border border-slate-200/80 p-5 overflow-hidden">
          <div class="flex items-center gap-2 font-bold text-slate-900 mb-4 border-l-4 border-amber-500 pl-3 text-xs tracking-wider uppercase">
            <span>📑</span> Table of Contents
          </div>

          <nav class="space-y-1 text-[13px] font-medium max-h-[calc(100vh-180px)] overflow-y-auto pr-1">
            <a 
              href="#gioi-thieu" 
              class="flex items-center gap-2 py-2 px-2.5 rounded-lg text-amber-900 bg-amber-50/80 font-bold transition-colors"
            >
              <span>🏠</span> Introduction
            </a>
            
            <div class="pt-1.5 space-y-1 border-l border-slate-200 ml-3 pl-3">
              {tocItems.slice(1).map((item) => (
                <a 
                  href={`#${item.id}`} 
                  class="block py-1.5 px-2 text-slate-600 hover:text-amber-900 hover:bg-slate-50 rounded transition-colors truncate"
                  title={item.title}
                >
                  {item.title}
                </a>
              ))}
            </div>
          </nav>
        </div>
      </aside>

      <!-- CENTER COLUMN: Editorial Content -->
      <main class="col-span-1 lg:col-span-6 space-y-12">

        <!-- Quick Overview Stats Bar (Strictly 3 Items) -->
        <div class="bg-white rounded-2xl shadow-sm border border-slate-200/60 p-5 md:p-6 mb-8">
          <div class="grid grid-cols-1 md:grid-cols-3 divide-y md:divide-y-0 md:divide-x divide-slate-100 gap-4 md:gap-0">
            <div class="flex items-center gap-3.5 md:px-4 first:pl-0 last:pr-0">
              <div class="w-11 h-11 rounded-xl bg-amber-50 flex items-center justify-center text-amber-700 text-xl border border-amber-200/80 shrink-0 shadow-xs">🎟️</div>
              <div class="min-w-0 flex-1">
                <div class="text-[10.5px] sm:text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-0.5 leading-tight">Official 2026 Tariff</div>
                <div class="text-[13.5px] sm:text-[14px] font-bold text-slate-900 leading-snug">135,000 VND / person</div>
              </div>
            </div>

            <div class="flex items-center gap-3.5 md:px-4 first:pl-0 last:pr-0 pt-3 md:pt-0">
              <div class="w-11 h-11 rounded-xl bg-blue-50 flex items-center justify-center text-blue-700 text-xl border border-blue-200/80 shrink-0 shadow-xs">⏰</div>
              <div class="min-w-0 flex-1">
                <div class="text-[10.5px] sm:text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-0.5 leading-tight">Operating Hours</div>
                <div class="text-[13.5px] sm:text-[14px] font-bold text-slate-900 leading-snug">7:00 AM – 5:00 PM Daily</div>
              </div>
            </div>

            <div class="flex items-center gap-3.5 md:px-4 first:pl-0 last:pr-0 pt-3 md:pt-0">
              <div class="w-11 h-11 rounded-xl bg-emerald-50 flex items-center justify-center text-emerald-700 text-xl border border-emerald-200/80 shrink-0 shadow-xs">📍</div>
              <div class="min-w-0 flex-1">
                <div class="text-[10.5px] sm:text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-0.5 leading-tight">Two Visitor Sectors</div>
                <div class="text-[13.5px] sm:text-[14px] font-bold text-slate-900 leading-snug">Ben Dinh & Ben Duoc</div>
              </div>
            </div>
          </div>
        </div>

        <!-- Article Content -->
        <article class="space-y-12 text-slate-800 leading-relaxed font-normal">

          <!-- Section: Introduction -->
          <section id="gioi-thieu" class="scroll-mt-28 space-y-4">
            <div class="text-slate-700 text-[16px] sm:text-[17px] leading-relaxed space-y-4">
              <p>
                The current <strong>Cu Chi Tunnels entrance fee for international visitors is 135,000 VND per person in 2026</strong>, consisting of a 35,000 VND historical-site admission fee and a 100,000 VND service and guiding fee. The updated tariff officially took effect on <strong>February 1, 2026</strong>. The site's published opening hours are <strong>7:00 AM to 5:00 PM daily</strong>.
              </p>
              <p>
                If you have been researching Cu Chi Tunnels online, you have almost certainly encountered conflicting figures. Older travel articles, forum posts, and outdated guidebooks still show figures such as 90,000 VND, 110,000 VND or 125,000 VND. These rates come from earlier pricing schedules and should not be confused with the current 2026 international visitor tariff.
              </p>
              <p>
                This comprehensive guide explains the current entrance fee structure, what the 135,000 VND charge includes, whether advance booking is necessary, how <a href="/ben-dinh-vs-ben-duoc" class="text-amber-800 hover:underline font-semibold">Ben Dinh and Ben Duoc differ</a>, what optional activities cost extra, and how to accurately budget for your complete visit.
              </p>
            </div>

            <!-- Lead-in Quote Box -->
            <div class="border-l-4 border-amber-500 pl-5 my-6 bg-amber-50/60 py-4 rounded-r-2xl border-y border-r border-amber-200/50">
              <p class="italic text-slate-800 text-[15px] sm:text-[16px] font-serif leading-relaxed">
                "Understanding the Cu Chi Tunnels fee structure is straightforward: 35,000 VND historical admission + 100,000 VND official site service and guiding = 135,000 VND total. The gate fee covers on-site admission, but planning door-to-door transportation from Saigon is what truly defines your day."
              </p>
            </div>
          </section>

          <!-- Section: At A Glance -->
          <section id="at-a-glance" class="scroll-mt-28 space-y-5">
            <div class="border-l-4 border-amber-500 pl-4 mb-4">
              <h2 class="font-serif text-2xl lg:text-[26px] font-bold text-slate-900 leading-tight">
                Cu Chi Tunnels Entrance Fee And Opening Hours At A Glance
              </h2>
            </div>

            <div class="overflow-x-auto my-6 rounded-2xl border border-slate-200 shadow-xs">
              <table class="w-full text-left border-collapse text-xs sm:text-sm">
                <thead>
                  <tr class="bg-slate-900 text-white font-serif">
                    <th class="p-3.5 sm:p-4 border-b border-slate-800">Information</th>
                    <th class="p-3.5 sm:p-4 border-b border-slate-800">Current 2026 Details</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 bg-white">
                  <tr class="hover:bg-slate-50/80 transition-colors">
                    <td class="p-3.5 sm:p-4 font-semibold text-slate-900">International visitor fee</td>
                    <td class="p-3.5 sm:p-4 font-bold text-amber-700">135,000 VND per person</td>
                  </tr>
                  <tr class="hover:bg-slate-50/80 transition-colors bg-slate-50/30">
                    <td class="p-3.5 sm:p-4 font-semibold text-slate-900">Historical-site admission</td>
                    <td class="p-3.5 sm:p-4 text-slate-700">35,000 VND</td>
                  </tr>
                  <tr class="hover:bg-slate-50/80 transition-colors">
                    <td class="p-3.5 sm:p-4 font-semibold text-slate-900">Service and guiding fee</td>
                    <td class="p-3.5 sm:p-4 text-slate-700">100,000 VND</td>
                  </tr>
                  <tr class="hover:bg-slate-50/80 transition-colors bg-slate-50/30">
                    <td class="p-3.5 sm:p-4 font-semibold text-slate-900">Effective date</td>
                    <td class="p-3.5 sm:p-4 text-slate-700 font-medium">February 1, 2026</td>
                  </tr>
                  <tr class="hover:bg-slate-50/80 transition-colors">
                    <td class="p-3.5 sm:p-4 font-semibold text-slate-900">Vietnamese standard admission</td>
                    <td class="p-3.5 sm:p-4 text-slate-700">35,000 VND</td>
                  </tr>
                  <tr class="hover:bg-slate-50/80 transition-colors bg-slate-50/30">
                    <td class="p-3.5 sm:p-4 font-semibold text-slate-900">Published opening hours</td>
                    <td class="p-3.5 sm:p-4 text-slate-900 font-bold">7:00 AM – 5:00 PM daily</td>
                  </tr>
