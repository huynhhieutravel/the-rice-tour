---
import BaseLayout from '../layouts/BaseLayout.astro';
import { env } from 'cloudflare:workers';

const d1Db = env?.dulichcoguu_d1;

let post: any = null;
if (d1Db) {
  try {
    // Thử lấy từ bảng Post trước
    post = await d1Db.prepare("SELECT * FROM Post WHERE slug = ? AND (status = 'published' OR status = 'publish')").bind('tuyen-dung-truong-nhom-kinh-doanh-du-lich').first();
    // Nếu không có, thử lấy từ bảng Page
    if (!post) {
      post = await d1Db.prepare("SELECT * FROM Page WHERE slug = ? AND (status = 'published' OR status = 'publish')").bind('tuyen-dung-truong-nhom-kinh-doanh-du-lich').first();
    }
  } catch (e) {
    console.error("Lỗi lấy dữ liệu tuyển dụng từ D1:", e);
  }
}

const pageTitle = post?.title || "Trưởng Nhóm Kinh Doanh | Sales Team Leader";
const seoTitle = post?.seoTitle || post?.title || "Tuyển Dụng Trưởng Nhóm Kinh Doanh Du Lịch (Sales Team Leader) | FIT TOUR";
const seoDesc = post?.seoDescription || "FIT TOUR tuyển dụng Trưởng Nhóm Kinh Doanh (Sales Team Leader) du lịch tại TP.HCM. Dẫn dắt đội ngũ, phát triển năng lực, thu nhập hấp dẫn.";
const featuredImage = post?.featuredImage || "https://media.fittour.vn/uploads/2021/08/IMG_0392.webp";
const adminEditUrl = post?.id ? `/admin/posts/edit?id=${post.id}` : "";
---

<BaseLayout
  title={seoTitle}
  description={seoDesc}
  image={featuredImage}
  canonical="https://thericetour.com/tuyen-dung-truong-nhom-kinh-doanh-du-lich"
  adminEditUrl={adminEditUrl}
>
  <main class="bg-slate-50 py-16 md:py-24">
    <div class="container mx-auto px-4 max-w-6xl">
      
      <!-- Breadcrumb -->
      <nav class="flex text-sm text-slate-500 mb-8 font-medium" aria-label="Breadcrumb">
        <ol class="flex items-center flex-wrap space-x-1 md:space-x-2">
          <li><a href="/" class="hover:text-brand-600 transition-colors">Trang chủ</a></li>
          <li><span class="mx-1 md:mx-2 text-slate-400">/</span></li>
          <li><a href="/tuyen-dung" class="hover:text-brand-600 transition-colors">Tuyển dụng</a></li>
          <li><span class="mx-1 md:mx-2 text-slate-400">/</span></li>
          <li class="text-slate-800" aria-current="page">{pageTitle}</li>
        </ol>
      </nav>

      <div class="flex flex-col lg:flex-row gap-8 items-start">
        
        <!-- Main Content -->
        <div class="flex-1 w-full max-w-4xl mx-auto bg-white rounded-2xl shadow-sm p-8 md:p-12 border border-slate-100 min-w-0">
        
        <!-- Feature Image -->
        <div class="mb-10 rounded-xl overflow-hidden shadow-sm">
          <img 
            src={featuredImage} 
            alt={pageTitle} 
            width="1280" 
            height="720" 
            class="w-full h-auto object-cover aspect-video"
            onerror="this.src='https://placehold.co/1280x720/e2e8f0/475569?text=FIT+TOUR+Team'"
          />
        </div>

        <div class="mb-8 pb-6 border-b border-slate-200">
          <h1 class="text-3xl md:text-4xl font-bold text-slate-900 mb-4">
            {pageTitle}
          </h1>
          <p class="text-brand-600 font-semibold text-lg">FIT TOUR | BEYOND ORDINARY JOURNEYS</p>
        </div>

        <div class="prose prose-slate max-w-none prose-headings:text-slate-900 prose-headings:font-bold prose-a:text-brand-600 prose-p:my-3 prose-ul:my-3 prose-li:my-1">
          
          <h3 id="thong-tin-vi-tri" class="scroll-mt-24">Thông Tin Vị Trí</h3>
          <div class="overflow-x-auto my-6">
            <table class="min-w-full text-left border-collapse border border-slate-200 text-sm md:text-base">
              <tbody>
                <tr>
                  <td class="border border-slate-200 p-3 bg-slate-50 font-semibold w-1/3">Chức danh</td>
                  <td class="border border-slate-200 p-3 font-bold">Trưởng nhóm Kinh doanh | Sales Team Leader</td>
                </tr>
                <tr>
                  <td class="border border-slate-200 p-3 bg-slate-50 font-semibold">Bộ phận</td>
                  <td class="border border-slate-200 p-3">Kinh doanh</td>
                </tr>
                <tr>
                  <td class="border border-slate-200 p-3 bg-slate-50 font-semibold">Cấp bậc</td>
                  <td class="border border-slate-200 p-3">Team Leader</td>
                </tr>
                <tr>
                  <td class="border border-slate-200 p-3 bg-slate-50 font-semibold">Loại hình làm việc</td>
                  <td class="border border-slate-200 p-3">Toàn thời gian</td>
                </tr>
                <tr>
                  <td class="border border-slate-200 p-3 bg-slate-50 font-semibold">Địa điểm làm việc</td>
                  <td class="border border-slate-200 p-3">19 Lương Hữu Khánh, Phường Phạm Ngũ Lão, Quận 1, TP. HCM</td>
                </tr>
                <tr>
                  <td class="border border-slate-200 p-3 bg-slate-50 font-semibold">Báo cáo trực tiếp</td>
                  <td class="border border-slate-200 p-3">Quản lý Kinh doanh</td>
                </tr>
                <tr>
                  <td class="border border-slate-200 p-3 bg-slate-50 font-semibold">Quản lý trực tiếp</td>
                  <td class="border border-slate-200 p-3 font-medium">Đội ngũ Sales Executive được phân công</td>
                </tr>
                <tr>
                  <td class="border border-slate-200 p-3 bg-slate-50 font-semibold">Nhu cầu tuyển dụng</td>
                  <td class="border border-slate-200 p-3">01 vị trí</td>
                </tr>
              </tbody>
            </table>
          </div>

          <!-- Single Clear Role Switcher Banner below Table -->
          <div class="not-prose bg-slate-100/90 border border-slate-200 rounded-2xl p-4 sm:p-5 my-8 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 sm:gap-4">
            <div class="flex items-start gap-3">
              <div class="p-2 bg-slate-200 text-slate-800 rounded-xl shrink-0 mt-0.5 sm:mt-0">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
              </div>
              <div>
                <p class="text-xs font-bold uppercase tracking-wider text-slate-700 mb-0.5">Dành cho ứng viên Chuyên viên (2+ năm KN)</p>
                <p class="text-sm text-slate-700 font-medium mb-0">Bạn đang tìm kiếm vị trí Chuyên viên Tư vấn & Kinh doanh?</p>
              </div>
            </div>
            <a 
              href="/tuyen-dung-nhan-vien-kinh-doanh" 
              class="w-full sm:w-auto shrink-0 inline-flex items-center justify-center gap-2 px-4 py-2.5 bg-slate-900 hover:bg-slate-800 text-white text-xs sm:text-sm font-bold rounded-xl shadow-sm transition-all active:scale-95 !no-underline"
            >
              <span>Ứng tuyển Sales Executive</span>
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </a>
          </div>

          <h3>Về FIT TOUR</h3>
          <p>
            <strong>Công ty TNHH Du lịch Quốc tế Fit Tour (FIT TOUR)</strong> hoạt động trong lĩnh vực du lịch, phát triển và cung cấp các chương trình du lịch trong nước và quốc tế theo nhu cầu thực tế của khách hàng.
          </p>
          <p>
            FIT TOUR tin rằng chất lượng của một hành trình bắt đầu từ chất lượng của người làm nghề. Vì vậy, đội ngũ Kinh doanh không chỉ có nhiệm vụ tạo ra doanh số, mà còn phải <strong>hiểu khách hàng, hiểu sản phẩm và có trách nhiệm với những gì được tư vấn và cam kết</strong>.
          </p>
          <p>
            Sales Team Leader là vị trí quản lý trực tiếp đội ngũ Sales, chịu trách nhiệm chuyển mục tiêu kinh doanh thành kế hoạch hành động, phát triển năng lực nhân sự, kiểm soát pipeline và chất lượng bán hàng, đồng thời trực tiếp hỗ trợ xử lý các cơ hội kinh doanh quan trọng.
          </p>

          <div class="bg-slate-50 border border-slate-200 p-6 rounded-xl my-8">
            <h4 class="text-slate-800 mt-0 mb-3 font-bold flex items-center gap-2">
              <svg class="w-5 h-5 text-brand-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
              Tìm hiểu thêm về môi trường làm việc của chúng tôi
            </h4>
            <p class="text-slate-600 text-sm mb-4">Khám phá câu chuyện thương hiệu, đội ngũ nhân sự và các dự án thực tế mà FIT TOUR đã thực hiện để xem bạn có phù hợp với văn hóa của chúng tôi không nhé:</p>
            <div class="grid grid-cols-2 sm:flex sm:flex-wrap gap-2.5 not-prose">
              <a href="/gioi-thieu/" class="flex items-center justify-center text-center px-4 py-3 bg-white hover:bg-brand-50 text-slate-800 hover:text-brand-700 text-sm font-semibold rounded-xl transition-all border border-slate-200 shadow-sm active:scale-95">
                Về FIT TOUR
              </a>
              <a href="/our-team/" class="flex items-center justify-center text-center px-4 py-3 bg-white hover:bg-brand-50 text-slate-800 hover:text-brand-700 text-sm font-semibold rounded-xl transition-all border border-slate-200 shadow-sm active:scale-95">
                Đội ngũ của chúng tôi
              </a>
              <a href="/portfolio/" class="flex items-center justify-center text-center px-4 py-3 bg-white hover:bg-brand-50 text-slate-800 hover:text-brand-700 text-sm font-semibold rounded-xl transition-all border border-slate-200 shadow-sm active:scale-95">
                Dự án (Portfolio)
              </a>
              <a href="/tour-doanh-nghiep/" class="flex items-center justify-center text-center px-4 py-3 bg-white hover:bg-brand-50 text-slate-800 hover:text-brand-700 text-sm font-semibold rounded-xl transition-all border border-slate-200 shadow-sm active:scale-95">
                Tour Doanh Nghiệp
              </a>
            </div>
          </div>

          <h3 id="muc-tieu" class="scroll-mt-24">Mục Tiêu Vị Trí</h3>
          <p>
            Sales Team Leader chịu trách nhiệm quản lý, phát triển và nâng cao hiệu quả của đội ngũ Sales, đảm bảo team đạt các mục tiêu về doanh thu, gross profit, conversion và chất lượng khách hàng.
          </p>
          <p>
            Vị trí này đóng vai trò kết nối giữa định hướng kinh doanh của FIT TOUR và hoạt động bán hàng hằng ngày của đội ngũ, đồng thời chịu trách nhiệm xây dựng một đội ngũ Sales có năng lực tư vấn, thiết kế sản phẩm và phát triển khách hàng một cách chuyên nghiệp.
          </p>
          <p>
            Sales Team Leader không chỉ được đánh giá bởi doanh số cá nhân, mà chủ yếu bởi <strong>kết quả của đội ngũ, năng lực của từng thành viên và khả năng xây dựng một hệ thống bán hàng có thể phát triển bền vững</strong>.
          </p>

          <hr class="my-8 border-slate-200" />

          <h3>Trách Nhiệm Chính</h3>
          
          <h4>1. Quản Lý & Điều Hành Đội Ngũ Sales</h4>
          <ul>
            <li>Quản lý trực tiếp đội ngũ Sales Executive được phân công.</li>
            <li>Phân bổ mục tiêu, khách hàng tiềm năng và cơ hội kinh doanh phù hợp với năng lực của từng thành viên.</li>
            <li>Theo dõi tiến độ công việc, pipeline và kết quả kinh doanh của từng nhân sự.</li>
            <li>Thiết lập nhịp làm việc và cơ chế follow-up phù hợp để đảm bảo các cơ hội được xử lý đúng tiến độ.</li>
            <li>Phát hiện sớm các vấn đề ảnh hưởng đến hiệu quả bán hàng và chủ động đưa ra phương án xử lý.</li>
            <li>Đảm bảo đội ngũ tuân thủ các quy trình, tiêu chuẩn và chính sách bán hàng của FIT TOUR.</li>
            <li>Là đầu mối hỗ trợ team trong các tình huống cần quyết định hoặc escalation.</li>
          </ul>

          <h4>2. Quản Lý Doanh Số & Performance</h4>
          <ul>
            <li>Chuyển mục tiêu kinh doanh của bộ phận thành mục tiêu cụ thể cho từng thành viên.</li>
            <li>Theo dõi Revenue, Gross Profit / Gross Margin, Conversion Rate và các chỉ số kinh doanh của team.</li>
            <li>Phân tích kết quả theo nhân sự, sản phẩm, nguồn khách hàng và giai đoạn của pipeline.</li>
            <li>Theo dõi forecast và khả năng hoàn thành mục tiêu theo tuần, tháng và quý.</li>
            <li>Xác định các điểm nghẽn trong funnel bán hàng và đề xuất giải pháp cải thiện.</li>
            <li>Chủ động xây dựng kế hoạch hành động khi team hoặc từng thành viên có nguy cơ không đạt mục tiêu.</li>
            <li>Báo cáo kết quả kinh doanh, tình hình pipeline và các vấn đề cần hỗ trợ cho Quản lý Kinh doanh.</li>
          </ul>

          <h4>3. Coaching & Phát Triển Nhân Sự</h4>
          <ul>
            <li>Coaching Sales Executive về kỹ năng khai thác nhu cầu, tư vấn, thiết kế chương trình, costing, báo giá, follow-up và closing.</li>
            <li>Review các cơ hội kinh doanh quan trọng cùng nhân sự để nâng cao chất lượng tư vấn và khả năng chuyển đổi.</li>
            <li>Hướng dẫn nhân sự xử lý objection, negotiation và các tình huống khó với khách hàng.</li>
            <li>Đánh giá điểm mạnh, điểm cần cải thiện và nhu cầu phát triển của từng thành viên.</li>
            <li>Xây dựng kế hoạch đào tạo và phát triển năng lực cho team.</li>
            <li>Hỗ trợ onboarding và phát triển nhân sự mới.</li>
            <li>Tạo môi trường khuyến khích nhân sự chủ động học hỏi, chia sẻ kinh nghiệm và hỗ trợ lẫn nhau.</li>
            <li>Đề xuất nhân sự có năng lực cho các cơ hội phát triển hoặc phạm vi trách nhiệm lớn hơn.</li>
          </ul>

          <h4>4. Quản Lý Pipeline & Chất Lượng Bán Hàng</h4>
          <ul>
            <li>Kiểm soát chất lượng pipeline của toàn đội.</li>
            <li>Đảm bảo các cơ hội có thông tin đầy đủ, trạng thái rõ ràng và next action cụ thể.</li>
            <li>Review các cơ hội có giá trị lớn, khách hàng quan trọng hoặc có mức độ phức tạp cao.</li>
            <li>Hỗ trợ Sales trong việc xây dựng phương án, pricing, negotiation và closing khi cần thiết.</li>
            <li>Kiểm soát chất lượng proposal, itinerary, costing và quotation trước hoặc trong các trường hợp cần review.</li>
            <li>Đảm bảo Sales không đưa ra các cam kết vượt quá khả năng cung cấp hoặc điều kiện dịch vụ thực tế.</li>
            <li>Theo dõi các cơ hội bị trì hoãn, có nguy cơ mất khách hoặc có vấn đề về giá trị thương mại để đưa ra phương án xử lý.</li>
          </ul>

          <h4>5. Phát Triển Khách Hàng & Kinh Doanh</h4>
          <ul>
            <li>Cùng team phát triển khách hàng mới và các cơ hội kinh doanh có giá trị.</li>
            <li>Khuyến khích và hỗ trợ Sales phát triển khách hàng từ referral, network cá nhân, B2B và các nguồn phù hợp.</li>
            <li>Tham gia trực tiếp vào các cơ hội khách hàng VIP, B2B, corporate hoặc các nhóm khách hàng quan trọng khi cần thiết.</li>
            <li>Phối hợp với Sales Manager trong việc phát triển các phân khúc khách hàng và thị trường tiềm năng.</li>
            <li>Theo dõi phản hồi của khách hàng và xu hướng thị trường để đề xuất cơ hội kinh doanh mới.</li>
            <li>Đóng góp insight từ thị trường vào việc phát triển và điều chỉnh sản phẩm.</li>
          </ul>

          <h4>6. Phối Hợp Với Điều Hành & Các Bộ Phận</h4>
          <ul>
            <li>Phối hợp với Điều hành để đảm bảo các chương trình được bán đúng khả năng cung cấp.</li>
            <li>Hỗ trợ giải quyết các vấn đề phát sinh liên quan đến cam kết bán hàng của team.</li>
            <li>Đảm bảo chất lượng thông tin được bàn giao từ Sales sang Điều hành.</li>
            <li>Phối hợp với Product và các bộ phận liên quan để cải thiện sản phẩm, pricing và quy trình.</li>
            <li>Ghi nhận các vấn đề lặp lại trong quá trình bán hàng và đề xuất cải tiến quy trình.</li>
            <li>Đảm bảo sự thống nhất giữa mục tiêu kinh doanh, chất lượng sản phẩm và trải nghiệm khách hàng.</li>
          </ul>

          <hr class="my-8 border-slate-200" />

          <h3 id="yeu-cau" class="scroll-mt-24">Yêu Cầu Bắt Buộc</h3>
          
          <h4>Kinh Nghiệm</h4>
          <ul>
            <li>Tối thiểu <strong>03 năm kinh nghiệm</strong> trong lĩnh vực du lịch, trong đó có kinh nghiệm thực tế về Sales / Business Development.</li>
            <li>Có kinh nghiệm bán tour hoặc các sản phẩm dịch vụ du lịch.</li>
            <li>Có kinh nghiệm xây dựng chương trình, costing, pricing và tư vấn khách hàng.</li>
            <li><strong>Có kinh nghiệm quản lý hoặc dẫn dắt đội nhóm Sales là yêu cầu quan trọng.</strong></li>
            <li>Có kinh nghiệm theo dõi doanh số, pipeline và các chỉ số hiệu quả bán hàng.</li>
            <li>Có kinh nghiệm trực tiếp xử lý các khách hàng hoặc cơ hội kinh doanh có giá trị cao là lợi thế.</li>
          </ul>

          <h4>Học Vấn</h4>
          <ul>
            <li>Không bắt buộc đúng chuyên ngành.</li>
            <li>Tốt nghiệp Cao đẳng/Đại học chuyên ngành Du lịch, Kinh doanh, Marketing, Quản trị hoặc lĩnh vực liên quan là lợi thế.</li>
          </ul>

          <h4>Năng Lực Chuyên Môn</h4>
          <p>Ứng viên cần có khả năng:</p>
          <ul>
            <li>Quản lý và phân bổ mục tiêu kinh doanh cho đội ngũ.</li>
            <li>Đọc và phân tích pipeline, conversion, revenue và gross margin.</li>
            <li>Forecast doanh số và nhận diện rủi ro không đạt mục tiêu.</li>
            <li>Coaching và phát triển năng lực Sales Executive.</li>
            <li>Review và nâng cao chất lượng proposal, costing và quotation.</li>
            <li>Xử lý các tình huống phức tạp trong bán hàng và hỗ trợ team closing.</li>
            <li>Đưa ra quyết định dựa trên dữ liệu, tình hình khách hàng và mục tiêu kinh doanh.</li>
            <li>Phối hợp hiệu quả với Điều hành, Product và các bộ phận liên quan.</li>
          </ul>

          <h3>Yêu Cầu Ưu Tiên (Lợi Thế)</h3>
          <ul>
            <li>Có kinh nghiệm quản lý team Sales từ <strong>03–10 nhân sự</strong> hoặc quy mô tương đương.</li>
            <li>Có kinh nghiệm quản lý Sales trong lĩnh vực outbound hoặc customized travel.</li>
            <li>Có kinh nghiệm với khách hàng VIP, B2B, corporate, MICE hoặc incentive travel.</li>
            <li>Có sẵn network khách hàng hoặc đối tác trong ngành du lịch.</li>
            <li>Có kinh nghiệm phát triển khách hàng mới và xây dựng nguồn doanh thu ngoài lead được phân bổ.</li>
            <li>Có kinh nghiệm sử dụng CRM và quản lý sales pipeline.</li>
            <li>Có khả năng sử dụng tiếng Anh trong giao tiếp và làm việc với khách hàng hoặc đối tác quốc tế.</li>
            <li>Có kinh nghiệm xây dựng hoặc cải tiến sales process, KPI hoặc incentive scheme.</li>
            <li>Có kinh nghiệm đào tạo hoặc coaching Sales Executive.</li>
          </ul>

          <hr class="my-8 border-slate-200" />

          <h3>Năng Lực Cốt Lõi</h3>
          <ul>
            <li><strong>Sales Leadership:</strong> Có khả năng dẫn dắt đội ngũ hướng đến mục tiêu chung, tạo động lực và duy trì accountability mà không biến quản lý thành việc chỉ theo dõi KPI.</li>
            <li><strong>Commercial Acumen:</strong> Hiểu sâu mối quan hệ giữa revenue, gross profit, gross margin, conversion, customer value và hiệu quả kinh doanh.</li>
            <li><strong>Coaching & People Development:</strong> Có khả năng quan sát, phản hồi, coaching và giúp từng nhân sự cải thiện năng lực bán hàng.</li>
            <li><strong>Consultative Selling:</strong> Hiểu sâu quy trình bán hàng và có khả năng hướng dẫn Sales xây dựng giải pháp dựa trên nhu cầu thực tế của khách hàng.</li>
            <li><strong>Data & Performance Management:</strong> Có khả năng đọc dữ liệu, nhận diện vấn đề trong funnel và chuyển dữ liệu thành hành động cụ thể.</li>
            <li><strong>Decision Making & Problem Solving:</strong> Có khả năng đưa ra quyết định trong những tình huống phức tạp, đặc biệt khi liên quan đến khách hàng, giá, dịch vụ và mục tiêu kinh doanh.</li>
            <li><strong>Ownership & Collaboration:</strong> Chịu trách nhiệm với kết quả của team, đồng thời phối hợp hiệu quả với Sales Manager, Operations, Product và các bộ phận liên quan.</li>
          </ul>

          <h3>Chỉ Số Đánh Giá Hiệu Quả (KPIs)</h3>
          <p>Hiệu quả của Sales Team Leader được đánh giá dựa trên kết quả kinh doanh của team, chất lượng vận hành sales và sự phát triển của đội ngũ.</p>
          <div class="overflow-x-auto my-6">
            <table class="min-w-full text-left border-collapse border border-slate-200 text-sm">
              <thead>
                <tr class="bg-slate-100">
                  <th class="border border-slate-200 p-3">Nhóm đánh giá</th>
                  <th class="border border-slate-200 p-3">Chỉ số tham khảo</th>
                </tr>
              </thead>
              <tbody>
                <tr><td class="border border-slate-200 p-3 font-semibold">Team Revenue</td><td class="border border-slate-200 p-3">Mức độ hoàn thành doanh số của đội ngũ</td></tr>
                <tr><td class="border border-slate-200 p-3 font-semibold">Team Gross Profit / Margin</td><td class="border border-slate-200 p-3">Hiệu quả lợi nhuận của đội ngũ</td></tr>
                <tr><td class="border border-slate-200 p-3 font-semibold">Conversion Rate</td><td class="border border-slate-200 p-3">Tỷ lệ chuyển đổi của team và theo từng Sales</td></tr>
                <tr><td class="border border-slate-200 p-3 font-semibold">Pipeline Health</td><td class="border border-slate-200 p-3">Giá trị, chất lượng, tốc độ và độ chính xác của pipeline</td></tr>
                <tr><td class="border border-slate-200 p-3 font-semibold">Forecast Accuracy</td><td class="border border-slate-200 p-3">Mức độ chính xác của dự báo doanh số</td></tr>
                <tr><td class="border border-slate-200 p-3 font-semibold">Customer Value</td><td class="border border-slate-200 p-3">Repeat, Referral và chất lượng khách hàng</td></tr>
                <tr><td class="border border-slate-200 p-3 font-semibold">Sales Productivity</td><td class="border border-slate-200 p-3">Hiệu quả hoạt động và năng suất của từng Sales</td></tr>
                <tr><td class="border border-slate-200 p-3 font-semibold">People Development</td><td class="border border-slate-200 p-3">Mức độ tiến bộ, năng lực và khả năng tự chủ của nhân sự</td></tr>
                <tr><td class="border border-slate-200 p-3 font-semibold">Handover Quality</td><td class="border border-slate-200 p-3">Chất lượng bàn giao và phối hợp với Điều hành</td></tr>
                <tr><td class="border border-slate-200 p-3 font-semibold">Customer Experience</td><td class="border border-slate-200 p-3">Phản hồi và chất lượng trải nghiệm khách hàng</td></tr>
              </tbody>
