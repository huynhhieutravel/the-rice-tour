  <script is:inline>
    // Copy Link Script
    const copyBtn = document.getElementById('copy-link-btn');
    const copyToast = document.getElementById('copy-toast');
    if (copyBtn && copyToast) {
      copyBtn.addEventListener('click', async () => {
        const url = copyBtn.getAttribute('data-url') || window.location.href;
        try {
          await navigator.clipboard.writeText(url);
          copyToast.classList.remove('hidden');
          setTimeout(() => {
            copyToast.classList.add('hidden');
          }, 3000);
        } catch (err) {
          console.error('Failed to copy link:', err);
        }
      });
    }

    // TOC Active ScrollSpy Script
    document.addEventListener('DOMContentLoaded', () => {
      const observerOptions = {
        root: null,
        rootMargin: '-120px 0px -60% 0px',
        threshold: 0
      };

      const sections = document.querySelectorAll('article section[id]');
      const tocLinks = document.querySelectorAll('aside nav a[href^="#"]');

      if (!sections.length || !tocLinks.length) return;

      let currentActiveId = null;

      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            const id = entry.target.id;
            if (id !== currentActiveId) {
              currentActiveId = id;
              updateActiveToc(id);
            }
          }
        });
      }, observerOptions);

      sections.forEach(section => observer.observe(section));

      function updateActiveToc(activeId) {
        tocLinks.forEach(link => {
          const href = link.getAttribute('href') || '';
          const id = href.startsWith('#') ? href.slice(1) : '';
          if (id === activeId) {
            link.classList.remove('text-slate-600', 'font-normal');
            link.classList.add('text-amber-900', 'bg-amber-50/80', 'font-bold');
          } else {
            link.classList.remove('text-amber-900', 'bg-amber-50/80', 'font-bold');
            link.classList.add('text-slate-600', 'font-normal');
          }
        });
      }
    });
  </script>
