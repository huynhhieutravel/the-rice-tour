---
import { env } from 'cloudflare:workers';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { safeQueryCritical } from '@/lib/db-client';
import { getGlobalSettings } from '@/lib/settingsHelper';
import JsonLdSchema from '@/components/seo/JsonLdSchema.astro';

export const prerender = false;

// --- SSR D1 DATABASE QUERY ---
const currentSlug = 'ben-dinh-vs-ben-duoc';

const d1Db = env?.dulichcoguu_d1 || (Astro.locals as any)?.runtime?.env?.dulichcoguu_d1;
let post: any = null;
try {
  if (d1Db) {
    post = await safeQueryCritical(
      d1Db.prepare("SELECT * FROM Post WHERE slug = ? AND (status = 'published' OR status = 'publish')").bind(currentSlug).first<any>(),
      { route: Astro.url.pathname, slug: currentSlug, queryType: "fetch_post_by_slug" }
    );
  }
} catch (e) {
  console.warn('[D1 Query Warning] ben-dinh-vs-ben-duoc:', e);
}

// Fallback metadata if D1 is not yet populated
if (!post) {
  post = {
    id: 19811,
    title: 'Ben Dinh Vs Ben Duoc: Which Cu Chi Tunnels Site Should You Visit?',
    slug: currentSlug,
    excerpt: 'An authoritative comparison of Ben Dinh vs. Ben Duoc Cu Chi Tunnels: transit times, depths, crowd dynamics, memorial grounds, and 2026 UNESCO heritage facts.',
    featuredImage: 'https://media.thericetour.com/uploads/guide-explaining-cu-chi-tunnel-cross-section-model-diorama.webp',
    readingTime: 22,
    author: 'The Rice Tour Editorial',
    createdAt: '2026-09-18T08:00:00.000Z',
    publishedAt: '2026-09-18T08:00:00.000Z',
    updatedAt: '2026-09-18T08:00:00.000Z'
  };
}

const { settings } = await getGlobalSettings();

const pageTitle = post?.title || 'Ben Dinh Vs Ben Duoc: Which Cu Chi Tunnels Site Should You Visit?';
const pageDesc = post?.excerpt || 'An authoritative comparison of Ben Dinh vs. Ben Duoc Cu Chi Tunnels: transit times, depths, crowd dynamics, memorial grounds, and 2026 UNESCO heritage facts.';

const seoTitle = post?.seoTitle || post?.metaTitle || `${pageTitle} | The Rice Tour`;
const seoDesc = post?.seoDescription || pageDesc;
const seoImage = post?.ogImage || post?.featuredImage || 'https://media.thericetour.com/uploads/guide-explaining-cu-chi-tunnel-cross-section-model-diorama.webp';

// --- DATE LOGIC (E-E-A-T Compliant) ---
const createdAtStr = post.createdAt || post.publishedAt || '2026-09-18T08:00:00.000Z';
const updatedAtStr = post.updatedAt || '2026-09-18T08:00:00.000Z';

const createdAt = new Date(createdAtStr.replace(' ', 'T'));
const updatedAt = new Date(updatedAtStr.replace(' ', 'T'));

const isUpdated = updatedAt.getTime() - createdAt.getTime() > 86400000;
const displayDate = isUpdated ? updatedAt : createdAt;
const datePrefix = isUpdated ? "Updated:" : "Published:";
const formattedDate = displayDate.toLocaleDateString('en-US', { day: 'numeric', month: 'long', year: 'numeric' });

// --- AUTHOR LOGIC ---
const authorMap: Record<string, any> = {
  "The Rice Tour Editorial": {
    name: "The Rice Tour Editorial",
    url: "/about-us",
    img: "https://media.thericetour.com/uploads/the-rice-tour-editorial-avatar.webp"
  },
  "Huynh Hieu Travel": {
    name: "Huynh Hieu Travel",
    url: "/about-us",
    img: "https://media.thericetour.com/uploads/huynhhieutravel.webp"
  }
};
const authorData = authorMap[post.author] || authorMap["The Rice Tour Editorial"];

const adminEditUrl = post?.id ? `/admin/posts/edit/${post.id}` : undefined;

// --- TABLE OF CONTENTS (TOC) ---
const tocItems = [
  { id: "gioi-thieu", title: "Introduction" },
  { id: "at-a-glance", title: "Ben Dinh vs. Ben Duoc At A Glance" },
  { id: "the-real-difference", title: "What Is The Real Difference?" },
  { id: "authenticity-myth", title: "Is Ben Duoc More Authentic Than Ben Dinh?" },
  { id: "ben-dinh-convenience", title: "Ben Dinh: The Practical Choice" },
  { id: "ben-dinh-tunnel-experience", title: "Inside The Ben Dinh Tunnel Experience" },
  { id: "ben-duoc-memorial", title: "Ben Duoc: Expansive Grounds & Memorial" },
  { id: "is-ben-duoc-quieter", title: "Is Ben Duoc Truly Quieter Than Ben Dinh?" },
  { id: "for-history-enthusiasts", title: "Ben Dinh vs. Ben Duoc For History Lovers" },
  { id: "which-suits-half-day", title: "Which Site Suits A Half-Day Tour?" },
  { id: "which-suits-slower-day", title: "Which Site Suits A Slower, Immersive Day?" },
  { id: "decision-matrix", title: "Decision Matrix: Traveler Profile Fit" },
  { id: "visit-independently", title: "Can You Visit Ben Duoc Independently?" },
  { id: "tunnel-dimensions", title: "Tunnel Dimensions & Crawl Realities" },
  { id: "how-much-time", title: "How Much Time Should You Allow?" },
  { id: "unesco-chronology", title: "2026 UNESCO Heritage Chronology" },
  { id: "recommended-tours", title: "Recommended Cu Chi Private Journeys" },
  { id: "frequently-asked-questions", title: "Frequently Asked Questions (FAQ)" },
  { id: "epilogue", title: "Epilogue: Choosing With Intention" }
];

// SSR JSON-LD Schemas
const currentOrigin = 'https://thericetour.com';
const canonicalUrl = `${currentOrigin}/${currentSlug}`;

const breadcrumbSchema = {
  items: [
    { name: "Home", url: `${currentOrigin}/` },
    { name: "Travel Guides", url: `${currentOrigin}/blog` },
    { name: pageTitle, url: canonicalUrl }
  ]
};

const faqSchema = {
  questions: [
    {
      question: "Which Cu Chi Tunnels site is better: Ben Dinh or Ben Duoc?",
      answer: "Neither site is universally better. Ben Dinh is closer to Ho Chi Minh City (~50 km) and better suited for time-efficient half-day tours. Ben Duoc is farther (~70 km) but offers a more peaceful setting, deeper three-level tunnels, and the Ben Duoc Martyrs Memorial Temple."
    },
    {
      question: "Is Ben Duoc really more authentic than Ben Dinh?",
      answer: "No. UNESCO's 2026 Tentative List documentation specifically identifies both Ben Dinh and Ben Duoc as the two surviving sectors that best retain the original appearance, scale, and structure of the network. Both sites have been preserved and adapted for public safety."
    },
    {
      question: "How much is the official entrance fee to Cu Chi Tunnels in 2026?",
      answer: "Official foreign-visitor admission at both Ben Dinh and Ben Duoc is 135,000 VND per person (comprising 35,000 VND entrance ticket and 100,000 VND for site guide and heritage service)."
    },
    {
      question: "How far is Ben Duoc from Ben Dinh?",
      answer: "Ben Duoc is approximately 15 to 20 km northwest of Ben Dinh. Driving between the two sites takes roughly 25 to 35 minutes along provincial rural roads."
    },
    {
      question: "Can claustrophobic travelers visit Cu Chi Tunnels comfortably without crawling?",
      answer: "Yes, absolutely. Over 85 percent of the exhibits—including the historical film pavilion, camouflaged trapdoor demonstrations, booby-trap displays, open-air trenches, tank relics, and the Hoang Cam smokeless kitchen—are entirely above ground. Entering the tunnels is 100% optional at both sites."
    },
    {
      question: "Is there a shooting range at Ben Dinh and Ben Duoc?",
      answer: "Yes, both sites feature sports national defense shooting ranges where visitors over 18 can purchase live ammunition (such as AK-47, M16, or carbines) under strict supervision of range marshals. Gunfire noise is audible in certain sections of both parks."
    },
    {
      question: "Can you visit both Ben Dinh and Ben Duoc on the same day?",
      answer: "Technically yes, but it is redundant for most travelers. Because both sites present the same underground engineering logic and wartime living exhibits, visiting one sector thoroughly provides a complete experience. A full-day itinerary is much better spent pairing one tunnel site with central Saigon landmarks."
    },
    {
      question: "Can you get a Grab car from Ben Duoc back to Ho Chi Minh City?",
      answer: "Getting a Grab ride from downtown Saigon to Ben Duoc is easy, but finding a return driver from rural Cu Chi back to the city is notoriously difficult and unreliable. We strongly recommend booking private round-trip transportation with waiting time included."
    }
  ]
};

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": pageTitle,
  "description": pageDesc,
  "image": seoImage,
  "datePublished": createdAtStr,
  "dateModified": updatedAtStr,
  "author": {
    "@type": "Person",
    "name": authorData.name,
    "url": `${currentOrigin}${authorData.url}`
  },
  "publisher": {
    "@type": "Organization",
    "name": "The Rice Tour",
    "logo": {
      "@type": "ImageObject",
      "url": "https://media.thericetour.com/uploads/logo-the-rice.webp"
    }
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": canonicalUrl
  }
};
---

<BaseLayout 
  title={seoTitle} 
  description={seoDesc} 
  image={seoImage}
  canonical={canonicalUrl}
  preloadImages={[seoImage]}
  adminEditUrl={adminEditUrl}
  lang="en"
  ogType="article"
>
  <Fragment slot="schema">
    <JsonLdSchema type="breadcrumb" data={breadcrumbSchema} />
    <JsonLdSchema type="custom" data={articleSchema} />
    <JsonLdSchema type="faq" data={faqSchema} />
  </Fragment>

  <div class="bg-[#F8F9FA] text-[#1E293B] font-sans antialiased selection:bg-[#F7931E] selection:text-white">

    {/* ================= HERO SECTION ================= */}
    <section class="relative w-full min-h-[580px] lg:min-h-[660px] overflow-hidden flex flex-col justify-center pt-32 pb-20">
      <div class="absolute inset-0 z-0 bg-slate-950">
        <img 
          src={seoImage} 
          alt={pageTitle} 
          class="w-full h-full object-cover object-center opacity-85" 
          width="1280" 
          height="720"
          fetchpriority="high" 
          loading="eager" 
          decoding="async" 
        />
        <div class="absolute inset-0 bg-gradient-to-r from-black/80 via-black/55 to-black/30"></div>
        <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/30 to-transparent"></div>
      </div>

      <div class="relative z-10 max-w-[1600px] mx-auto px-4 sm:px-6 lg:px-12 w-full">
        
        {/* Breadcrumb */}
        <div class="flex items-center gap-2 text-[13px] text-white/70 font-medium mb-6 flex-wrap">
          <a href="/" class="hover:text-white transition-colors">Home</a>
          <svg class="w-3 h-3 text-white/40" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7m0 0l-7 7m7-7H3"/></svg>
          <a href="/blog" class="hover:text-white transition-colors">Travel Guides</a>
          <svg class="w-3 h-3 text-white/40" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7m0 0l-7 7m7-7H3"/></svg>
          <span class="text-white font-semibold line-clamp-1">{pageTitle}</span>
        </div>

        {/* Titles */}
        <h1 class="font-serif text-3xl sm:text-4xl lg:text-5xl xl:text-6xl font-bold text-white mb-4 leading-[1.15] drop-shadow-lg max-w-5xl">
          {pageTitle}
        </h1>
        <h2 class="font-serif text-lg sm:text-2xl lg:text-3xl text-amber-400 italic mb-8 max-w-4xl drop-shadow-md font-medium">
          A definitive comparison of distance, depths, crowd dynamics, memorial grounds, and 2026 UNESCO heritage facts.
        </h2>
        <p class="text-white/90 text-base sm:text-lg max-w-3xl leading-relaxed mb-8 hidden md:block drop-shadow-md font-normal">
          Planning a journey to Cu Chi Tunnels brings one pivotal logistical choice: Ben Dinh or Ben Duoc? This authoritative guide unpacks driving times, crawl conditions, crowd patterns, and genuine wartime history to help you select the ideal sector.
        </p>

        {/* Author / Date / Time Row */}
        <div class="flex flex-wrap items-center gap-4 sm:gap-6 text-sm text-white/80 border-t border-white/20 pt-6 max-w-3xl">
          <a href={authorData.url} class="flex items-center gap-3 group">
            <div class="w-10 h-10 rounded-full border-2 border-white/30 bg-amber-500/30 flex items-center justify-center font-serif text-amber-300 font-bold text-lg group-hover:border-amber-400 transition-colors">
              R
            </div>
            <span class="font-bold text-white group-hover:text-amber-400 transition-colors flex items-center gap-1.5">
              {authorData.name} 
              <svg class="w-4 h-4 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            </span>
          </a>
          
          <div class="flex items-center gap-2 bg-white/10 px-4 py-2 rounded-full backdrop-blur-sm border border-white/10">
            <svg class="w-4 h-4 opacity-70" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
            <span>{datePrefix} {formattedDate}</span>
          </div>

          <div class="flex items-center gap-2 bg-black/40 px-4 py-2 rounded-full backdrop-blur-sm border border-white/10">
            <svg class="w-4 h-4 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            <span>{post.readingTime || 22} min read</span>
          </div>
        </div>

        {/* Badges Line */}
        <div class="flex flex-wrap gap-3 mt-8">
          <div class="flex items-center gap-2 text-xs sm:text-sm text-white font-medium bg-black/60 backdrop-blur-md px-3.5 py-2 border border-white/10 rounded-lg shadow-xl">
            <span class="text-amber-400 text-base">📍</span> Ben Dinh: 50 km | Ben Duoc: 70 km
          </div>
          <div class="flex items-center gap-2 text-xs sm:text-sm text-white font-medium bg-black/60 backdrop-blur-md px-3.5 py-2 border border-white/10 rounded-lg shadow-xl">
            <span class="text-amber-400 text-base">🏛️</span> Ben Duoc Martyrs Memorial Temple
          </div>
          <div class="flex items-center gap-2 text-xs sm:text-sm text-white font-medium bg-black/60 backdrop-blur-md px-3.5 py-2 border border-white/10 rounded-lg shadow-xl">
            <span class="text-amber-400 text-base">🛡️</span> UNESCO 2026 Tentative List Facts
          </div>
          <div class="flex items-center gap-2 text-xs sm:text-sm text-white font-medium bg-black/60 backdrop-blur-md px-3.5 py-2 border border-white/10 rounded-lg shadow-xl">
            <span class="text-amber-400 text-base">🚫</span> Debunking "Real vs. Fake"
          </div>
        </div>

      </div>
    </section>

    {/* ================= MAIN CONTENT GRID (3 COLUMNS) ================= */}
    <div class="max-w-[1600px] mx-auto px-4 sm:px-6 lg:px-12 py-12 lg:py-16">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-start">

        {/* ---------------- LEFT SIDEBAR (TOC) ---------------- */}
        <aside class="hidden lg:block lg:col-span-3 sticky top-24">
          <div class="bg-white rounded-2xl shadow-sm border border-slate-200/60 p-6 overflow-hidden">
            <div class="flex items-center gap-2 font-bold text-slate-900 mb-5 border-l-4 border-amber-500 pl-3 text-sm tracking-wide uppercase">
              Table of Contents
            </div>
            
            <nav class="space-y-1 text-[13.5px] font-medium max-h-[calc(100vh-200px)] overflow-y-auto pr-1 custom-scrollbar">
              <a href="#gioi-thieu" class="flex items-center gap-2 text-amber-900 bg-amber-50/80 px-3 py-2 rounded-lg transition-colors font-bold">
                <span class="text-amber-600 text-base">🏠</span> Introduction
              </a>
              
              <div class="pt-1.5 space-y-1 border-l border-slate-200 ml-3 pl-3">
                {tocItems.slice(1).map((item) => (
                  <a 
                    href={`#${item.id}`} 
                    class="block transition-colors leading-tight py-1.5 text-slate-600 hover:text-amber-800 font-semibold text-[13px] truncate"
                    title={item.title}
                  >
                    {item.title}
                  </a>
                ))}
              </div>
            </nav>
          </div>
        </aside>

        {/* ---------------- CENTER COLUMN (MAIN CONTENT) ---------------- */}
        <main class="col-span-1 lg:col-span-6 space-y-10">

          {/* Quick Overview Stats Bar (4 Curated Dimensions) */}
          <div class="bg-white rounded-2xl shadow-sm border border-slate-200/60 p-6 flex flex-wrap lg:flex-nowrap items-center justify-between gap-4">
            <div class="flex items-center gap-3 w-[48%] lg:w-auto">
              <div class="w-10 h-10 rounded-full bg-amber-50 flex items-center justify-center text-amber-700 text-xl border border-amber-200/60 shrink-0">📍</div>
              <div>
                <div class="text-[11px] text-slate-500 font-medium">Ben Dinh</div>
                <div class="text-[13px] font-bold text-slate-900">~50 km (~1.5h)</div>
              </div>
            </div>

            <div class="hidden lg:block w-px h-8 bg-slate-200"></div>

            <div class="flex items-center gap-3 w-[48%] lg:w-auto">
              <div class="w-10 h-10 rounded-full bg-blue-50 flex items-center justify-center text-blue-700 text-xl border border-blue-200/60 shrink-0">🌲</div>
              <div>
                <div class="text-[11px] text-slate-500 font-medium">Ben Duoc</div>
                <div class="text-[13px] font-bold text-slate-900">~70 km (~2.2h)</div>
              </div>
            </div>

            <div class="hidden lg:block w-px h-8 bg-slate-200"></div>

            <div class="flex items-center gap-3 w-[48%] lg:w-auto mt-2 lg:mt-0">
              <div class="w-10 h-10 rounded-full bg-emerald-50 flex items-center justify-center text-emerald-700 text-xl border border-emerald-200/60 shrink-0">🏛️</div>
              <div>
                <div class="text-[11px] text-slate-500 font-medium">Memorial Temple</div>
                <div class="text-[13px] font-bold text-slate-900">Ben Duoc Only</div>
              </div>
            </div>

            <div class="hidden lg:block w-px h-8 bg-slate-200"></div>

            <div class="flex items-center gap-3 w-[48%] lg:w-auto mt-2 lg:mt-0">
              <div class="w-10 h-10 rounded-full bg-rose-50 flex items-center justify-center text-rose-700 text-xl border border-rose-200/60 shrink-0">🎟️</div>
              <div>
                <div class="text-[11px] text-slate-500 font-medium">Foreign Tariff</div>
                <div class="text-[13px] font-bold text-slate-900">135,000 VND</div>
              </div>
            </div>
          </div>

          {/* Article Content Starts */}
          <article class="space-y-12 text-slate-800 leading-relaxed font-normal">

            {/* Section: Introduction */}
            <section id="gioi-thieu" class="scroll-mt-28 space-y-4">
              <div class="text-slate-700 text-[16px] sm:text-[17px] leading-relaxed space-y-4">
                <p>
                  If you are planning a visit to the Cu Chi Tunnels from Ho Chi Minh City, one decision makes a noticeable difference to your day: <strong>Ben Dinh or Ben Duoc?</strong>
                </p>
                <p>
                  The two sites are frequently portrayed online as if one were a commercial "tourist" imitation and the other were the "authentic" wartime relic. The historical reality is far more nuanced. UNESCO’s 2026 World Heritage Tentative List documentation specifically identifies both Ben Dinh and Ben Duoc as the two surviving sectors that best retain the original appearance, scale, and structure of the Cu Chi tunnel network. Both have been protected, conserved, and adapted for visitors over the decades.
                </p>
                <div class="font-medium text-slate-900 text-lg border-l-4 border-amber-500 pl-4 my-5 bg-amber-50/50 py-3 rounded-r-xl">
                  "The question is not which site is 'real', but which sector aligns with your transit preferences, travel party, and desired depth of exploration."
                </div>
                <p>
                  <strong>Ben Dinh is closer to Ho Chi Minh City and serves as the standard stop for organized coach tours. Ben Duoc is roughly 15 km farther out, set in a tranquil riverside forest, and encompasses an expansive commemorative complex centered around the Ben Duoc Martyrs Memorial Temple.</strong>
                </p>
                <p>
                  So which should a traveler choose? The answer depends on your priorities: <strong>saving road transit time to pair Cu Chi with city sightseeing, or dedicating extra time to explore the broader historical setting of Cu Chi.</strong>
                </p>
              </div>

              {/* First Image Inside Body: Diorama Explanation */}
              <div class="my-6 not-prose">
                <div class="rounded-2xl overflow-hidden shadow-md border border-slate-200">
                  <img 
                    src="https://media.thericetour.com/uploads/guide-explaining-cu-chi-tunnel-cross-section-model-diorama.webp" 
                    alt="Licensed tour guide explaining the three-tiered underground network using a detailed cross-section model diorama at Cu Chi" 
                    class="w-full h-auto object-cover max-h-[500px]"
                    width="1280"
                    height="720"
                    loading="lazy"
                  />
                </div>
                <p class="text-center text-xs sm:text-sm text-slate-500 italic mt-2.5">
                  An experienced licensed guide uses an architectural diorama to decode Cu Chi's three-tiered underground defense levels.
                </p>
              </div>
            </section>

            {/* Section: At A Glance */}
            <section id="at-a-glance" class="scroll-mt-28 space-y-5">
              <div class="border-l-4 border-amber-500 pl-4 mb-4">
                <h2 class="font-serif text-2xl lg:text-[26px] font-bold text-slate-900 leading-tight">
                  Ben Dinh Vs Ben Duoc At A Glance
                </h2>
              </div>

              <div class="text-slate-700 text-[15.5px] leading-relaxed space-y-4">
                <p>
                  To help you make an immediate comparison, here is how both preserved sectors stack up side-by-side:
                </p>

                {/* Comparison Table */}
                <div class="overflow-x-auto my-6 border border-slate-200 rounded-xl shadow-xs">
                  <table class="w-full text-left text-xs sm:text-sm border-collapse">
                    <thead>
                      <tr class="bg-slate-900 text-white font-serif">
                        <th class="p-3.5 sm:p-4 font-semibold">Comparison Factor</th>
                        <th class="p-3.5 sm:p-4 font-semibold">Ben Dinh</th>
                        <th class="p-3.5 sm:p-4 font-semibold bg-amber-900/80 text-amber-100">Ben Duoc</th>
                      </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                      <tr class="hover:bg-slate-50/80">
                        <td class="p-3.5 sm:p-4 font-semibold text-slate-900">Distance from Saigon</td>
                        <td class="p-3.5 sm:p-4 text-emerald-700 font-medium">~50 km northwest (~1.5–2 hours)</td>
                        <td class="p-3.5 sm:p-4 text-slate-700 bg-amber-50/30">~65–70 km northwest (~2–2.5 hours)</td>
                      </tr>
                      <tr class="hover:bg-slate-50/80">
                        <td class="p-3.5 sm:p-4 font-semibold text-slate-900">Organized Group Tours</td>
                        <td class="p-3.5 sm:p-4 text-slate-700">Standard arrival point for large coach tours</td>
                        <td class="p-3.5 sm:p-4 text-emerald-700 font-medium bg-amber-50/30">Infrequently included on standard bus itineraries</td>
                      </tr>
                      <tr class="hover:bg-slate-50/80">
                        <td class="p-3.5 sm:p-4 font-semibold text-slate-900">Wartime Role</td>
                        <td class="p-3.5 sm:p-4 text-slate-700">Base of Cu Chi District Party Committee (1961–1975)</td>
                        <td class="p-3.5 sm:p-4 text-slate-700 bg-amber-50/30">Headquarters of Saigon–Gia Dinh Regional Command</td>
                      </tr>
                      <tr class="hover:bg-slate-50/80">
                        <td class="p-3.5 sm:p-4 font-semibold text-slate-900">Site Atmosphere</td>
                        <td class="p-3.5 sm:p-4 text-slate-700">Dynamic, compact, fast-paced, high visitor density</td>
                        <td class="p-3.5 sm:p-4 text-emerald-700 font-medium bg-amber-50/30">Spacious, contemplative, quiet forest canopy</td>
                      </tr>
