---
import BaseLayout from '@/layouts/BaseLayout.astro';
import JsonLdSchema from '@/components/seo/JsonLdSchema.astro';

// Editorial Metadata
const pageTitle = "Ben Dinh Vs Ben Duoc: Which Cu Chi Tunnels Site Should You Visit?";
const pageDesc = "An authoritative comparison of Ben Dinh vs. Ben Duoc Cu Chi Tunnels: transit times, depths, crowds, memorial grounds, and 2026 UNESCO heritage facts.";
const seoTitle = `${pageTitle} | The Rice Tour`;
const seoDesc = pageDesc;
const seoImage = "https://media.thericetour.com/uploads/guide-explaining-cu-chi-tunnel-cross-section-model-diorama.webp";
const currentSlug = "ben-dinh-vs-ben-duoc";

const authorData = {
  name: "The Rice Tour Editorial",
  url: "/about-us",
  img: "https://media.thericetour.com/uploads/the-rice-tour-editorial-avatar.webp"
};

const displayDate = new Date("2026-09-18T08:00:00Z");
const formattedDate = "September 18, 2026";
const datePrefix = "Published on";
const createdAtStr = displayDate.toISOString();
const updatedAtStr = displayDate.toISOString();

// 19 Interactive Table of Contents items
const tocItems = [
  { id: "gioi-thieu", title: "Introduction" },
  { id: "at-a-glance", title: "Ben Dinh vs. Ben Duoc At A Glance" },
  { id: "the-real-difference", title: "What Is The Real Difference?" },
  { id: "authenticity-myth", title: "Is Ben Duoc More Authentic Than Ben Dinh?" },
  { id: "ben-dinh-convenience", title: "Ben Dinh: The Practical Choice" },
  { id: "ben-dinh-tunnel-experience", title: "Inside The Ben Dinh Tunnel Experience" },
  { id: "ben-duoc-memorial", title: "Ben Duoc: Expansive Grounds & Memorial" },
  { id: "is-ben-duoc-quieter", title: "Is Ben Duoc Truly Quieter Than Ben Dinh?" },
  { id: "for-history-enthusiasts", title: "Ben Dinh vs. Ben Duoc For History Lovers" },
  { id: "which-suits-half-day", title: "Which Site Suits A Half-Day Tour?" },
  { id: "which-suits-slower-day", title: "Which Site Suits A Slower, Immersive Day?" },
  { id: "decision-matrix", title: "Decision Matrix: Traveler Profile Fit" },
  { id: "visit-independently", title: "Can You Visit Ben Duoc Independently?" },
  { id: "tunnel-dimensions", title: "Tunnel Dimensions & Crawl Realities" },
  { id: "how-much-time", title: "How Much Time Should You Allow?" },
  { id: "unesco-chronology", title: "2026 UNESCO Heritage Chronology" },
  { id: "recommended-tours", title: "Recommended Cu Chi Private Journeys" },
  { id: "frequently-asked-questions", title: "Frequently Asked Questions (FAQ)" },
  { id: "final-verdict", title: "Final Verdict: Which Should You Choose?" }
];

// SSR JSON-LD Schemas
const currentOrigin = 'https://thericetour.com';
const canonicalUrl = `${currentOrigin}/${currentSlug}`;

const breadcrumbSchema = {
  items: [
    { name: "Home", url: `${currentOrigin}/` },
    { name: "Travel Guides", url: `${currentOrigin}/blog` },
    { name: pageTitle, url: canonicalUrl }
  ]
};

const faqSchema = {
  questions: [
    {
      question: "Which Cu Chi Tunnels site is better: Ben Dinh or Ben Duoc?",
      answer: "Neither site is universally better. Ben Dinh is closer to Ho Chi Minh City (~50 km) and better suited for time-efficient half-day tours. Ben Duoc is farther (~70 km) but offers a more peaceful setting, deeper three-level tunnels, and the Ben Duoc Martyrs Memorial Temple."
    },
    {
      question: "Is Ben Duoc really more authentic than Ben Dinh?",
      answer: "No. UNESCO's 2026 Tentative List documentation specifically identifies both Ben Dinh and Ben Duoc as the two surviving sectors that best retain the original appearance, scale, and structure of the network. Both sites have been preserved and adapted for public safety."
    },
    {
      question: "How much is the official entrance fee to Cu Chi Tunnels in 2026?",
      answer: "Official foreign-visitor admission at both Ben Dinh and Ben Duoc is 135,000 VND per person (comprising 35,000 VND entrance ticket and 100,000 VND for site guide and heritage service)."
    },
    {
      question: "How far is Ben Duoc from Ben Dinh?",
      answer: "Ben Duoc is located approximately 15 km northwest of Ben Dinh. Traveling between the two sites takes roughly 20 to 25 minutes by car along rural roads."
    },
    {
      question: "Do I have to crawl underground at either site?",
      answer: "No. Entering the underground tunnels is completely optional at both Ben Dinh and Ben Duoc. Visitors who prefer to avoid cramped spaces can explore open-air surface trails, traps, bunkers, and video halls."
    },
    {
      question: "Can you visit Ben Duoc independently by Grab?",
      answer: "Yes. You can book a GrabCar from central Saigon to Ben Duoc for approximately 650,000 to 850,000 VND each way. However, securing a return ride from Ben Duoc can be difficult, so arranging a round-trip wait with your driver is advised."
    },
    {
      question: "What is the Ben Duoc Memorial Temple?",
      answer: "Inaugurated in 1995, the Ben Duoc Martyrs Memorial Temple is a monumental commemorative site honoring over 44,000 soldiers and civilians who died in the Saigon–Gia Dinh region during the war. It features traditional Vietnamese architecture, lotus ponds, and a nine-story tower."
    },
    {
      question: "Are the Cu Chi Tunnels recognized by UNESCO?",
      answer: "On July 15, 2026, Viet Nam submitted the Cu Chi Tunnels to the UNESCO World Heritage Tentative List under criteria (iv) and (vi). It is actively seeking full inscription as a World Heritage Site."
    }
  ]
};

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": pageTitle,
  "description": pageDesc,
  "image": seoImage,
  "datePublished": createdAtStr,
  "dateModified": updatedAtStr,
  "author": {
    "@type": "Person",
    "name": authorData.name,
    "url": `${currentOrigin}${authorData.url}`
  },
  "publisher": {
    "@type": "Organization",
    "name": "The Rice Tour",
    "url": currentOrigin,
    "logo": {
      "@type": "ImageObject",
      "url": "https://media.thericetour.com/uploads/logo-the-rice.webp"
    }
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": canonicalUrl
  }
};
---

<BaseLayout 
  title={seoTitle} 
  description={seoDesc} 
  image={seoImage}
  canonical={canonicalUrl}
  preloadImages={[seoImage]}
  lang="en"
  ogType="article"
>
  <Fragment slot="schema">
    <JsonLdSchema type="breadcrumb" data={breadcrumbSchema} />
    <JsonLdSchema type="custom" data={articleSchema} />
    <JsonLdSchema type="faq" data={faqSchema} />
  </Fragment>

  <!-- HERO SECTION HEADER (Full-width, Dark Magazine Style) -->
  <header class="relative bg-slate-950 text-white pt-28 pb-20 md:pt-36 md:pb-28 overflow-hidden">
    <!-- Background Image with Multi-layer Gradients -->
    <div class="absolute inset-0 z-0">
      <img 
        src={seoImage} 
        alt={pageTitle}
        class="w-full h-full object-cover object-center brightness-75 scale-105 transform motion-safe:animate-subtle-zoom"
        loading="eager"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/75 to-slate-950/40"></div>
      <div class="absolute inset-0 bg-gradient-to-r from-slate-950/90 via-slate-950/50 to-transparent"></div>
    </div>

    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Breadcrumbs -->
      <nav class="flex items-center gap-2 text-xs sm:text-sm text-slate-300/80 mb-6" aria-label="Breadcrumb">
        <a href="/" class="hover:text-white transition-colors">Home</a>
        <span>/</span>
        <a href="/blog" class="hover:text-white transition-colors">Travel Guides</a>
        <span>/</span>
        <span class="text-amber-400 font-medium truncate max-w-xs sm:max-w-md">{pageTitle}</span>
      </nav>

      <!-- Main Title -->
      <h1 class="font-serif text-3xl sm:text-4xl md:text-5xl lg:text-[52px] font-bold text-white tracking-tight leading-[1.15] max-w-4xl drop-shadow-sm">
        {pageTitle}
      </h1>

      <!-- Editorial Deck / Subheading -->
      <p class="mt-5 text-lg sm:text-xl text-slate-200/95 font-sans font-light leading-relaxed max-w-3xl">
        A practical, on-the-ground comparison between Ben Dinh and Ben Duoc: road distance, underground depths, crowd dynamics, memorial grounds, and 2026 UNESCO heritage facts.
      </p>

      <!-- Author and Metadata Card -->
      <div class="flex flex-wrap items-center gap-4 mt-8 pt-6 border-t border-white/15 max-w-3xl">
        <div class="flex items-center gap-3">
          <img 
            src={authorData.img} 
            alt={authorData.name} 
            class="w-10 h-10 rounded-full border-2 border-amber-400 object-cover shadow-sm"
          />
          <div>
            <div class="font-semibold text-white flex items-center gap-1.5">
              {authorData.name}
              <svg class="w-4 h-4 text-amber-400" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
              </svg>
            </div>
            <div class="text-xs text-slate-300/80">Inbound Travel Specialist</div>
          </div>
        </div>

        <div class="flex items-center gap-4 text-xs sm:text-sm text-slate-300/90 ml-auto">
          <span>{datePrefix} <time datetime={displayDate.toISOString()}>{formattedDate}</time></span>
          <span>•</span>
          <span>22 min read</span>
          <span>•</span>
          <span class="inline-flex items-center gap-1 text-emerald-400 font-medium">
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span> 2026 Verified
          </span>
        </div>
      </div>

      <!-- Feature Badges -->
      <div class="flex flex-wrap gap-2.5 mt-6 pt-4 border-t border-white/10">
        <span class="bg-black/60 backdrop-blur-md px-3.5 py-2 border border-white/10 rounded-lg shadow-xl text-xs sm:text-sm text-white font-medium">
          📍 Ben Dinh: 50 km | Ben Duoc: 70 km
        </span>
        <span class="bg-black/60 backdrop-blur-md px-3.5 py-2 border border-white/10 rounded-lg shadow-xl text-xs sm:text-sm text-white font-medium">
          🏛️ Ben Duoc Martyrs Memorial Temple
        </span>
        <span class="bg-black/60 backdrop-blur-md px-3.5 py-2 border border-white/10 rounded-lg shadow-xl text-xs sm:text-sm text-white font-medium">
          🛡️ UNESCO 2026 Tentative List Facts
        </span>
        <span class="bg-black/60 backdrop-blur-md px-3.5 py-2 border border-white/10 rounded-lg shadow-xl text-xs sm:text-sm text-white font-medium">
          🚫 Debunking "Real vs. Fake"
        </span>
      </div>
    </div>
  </header>

  <!-- 3-COLUMN MAGAZINE LAYOUT CONTAINER -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-16">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start">

      <!-- LEFT COLUMN: Sticky Table of Contents -->
      <aside class="hidden lg:block lg:col-span-3 sticky top-24">
        <div class="bg-white rounded-2xl shadow-sm border border-slate-200/80 p-5 max-h-[calc(100vh-7rem)] overflow-y-auto custom-scrollbar">
          <div class="flex items-center gap-2 font-bold text-slate-900 mb-4 border-l-4 border-amber-500 pl-3 text-xs tracking-wider uppercase">
            Table of Contents
          </div>
          <nav class="space-y-1 text-[13px] font-medium pr-1">
            <a href="#gioi-thieu" class="block text-amber-900 bg-amber-50/80 px-3 py-2 rounded-lg transition-colors font-bold text-[13.5px]">
              Introduction
            </a>
            
            <div class="pt-1.5 space-y-1 border-l border-slate-200 ml-3 pl-3">
              {tocItems.slice(1).map((item) => (
                <a 
                  href={`#${item.id}`} 
                  class="block py-1.5 px-2 text-slate-600 hover:text-amber-900 hover:bg-slate-50 rounded transition-colors truncate"
                  title={item.title}
                >
                  {item.title}
                </a>
              ))}
            </div>
          </nav>
        </div>
      </aside>

      <!-- CENTER COLUMN: Editorial Content -->
      <main class="col-span-1 lg:col-span-6 space-y-12">

        <!-- Executive Summary Cards -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
          <div class="p-3 rounded-xl bg-slate-50 border border-slate-100">
            <div class="text-xl sm:text-2xl mb-1">📍</div>
            <div class="text-[11px] uppercase tracking-wider text-slate-400 font-semibold">Ben Dinh</div>
            <div class="text-sm sm:text-base font-bold text-slate-900 mt-0.5">~50 km (~1.5h)</div>
          </div>
          <div class="p-3 rounded-xl bg-slate-50 border border-slate-100">
            <div class="text-xl sm:text-2xl mb-1">🌲</div>
            <div class="text-[11px] uppercase tracking-wider text-slate-400 font-semibold">Ben Duoc</div>
            <div class="text-sm sm:text-base font-bold text-slate-900 mt-0.5">~70 km (~2.2h)</div>
          </div>
          <div class="p-3 rounded-xl bg-slate-50 border border-slate-100">
            <div class="text-xl sm:text-2xl mb-1">🏛️</div>
            <div class="text-[11px] uppercase tracking-wider text-slate-400 font-semibold">Memorial Temple</div>
            <div class="text-sm sm:text-base font-bold text-slate-900 mt-0.5">Ben Duoc Only</div>
          </div>
          <div class="p-3 rounded-xl bg-slate-50 border border-slate-100">
            <div class="text-xl sm:text-2xl mb-1">🎟️</div>
            <div class="text-[11px] uppercase tracking-wider text-slate-400 font-semibold">Foreign Tariff</div>
            <div class="text-sm sm:text-base font-bold text-slate-900 mt-0.5">135,000 VND</div>
          </div>
        </div>

        <!-- Article Content Starts -->
        <article class="space-y-12 text-slate-800 leading-relaxed font-normal">

          <!-- Section: Introduction -->
          <section id="gioi-thieu" class="scroll-mt-28 space-y-4">
            <div class="text-slate-700 text-[16px] sm:text-[17px] leading-relaxed space-y-4">
              <p>
                If you are planning a visit to the Cu Chi Tunnels from Ho Chi Minh City, one decision makes a noticeable difference to your day: <strong>Ben Dinh or Ben Duoc?</strong>
              </p>
              <p>
                The two sites are frequently portrayed online as if one were a commercial "tourist" imitation and the other were the "authentic" wartime relic. The historical reality is far more nuanced. UNESCO’s 2026 World Heritage Tentative List documentation specifically identifies both Ben Dinh and Ben Duoc as the two surviving sectors that best retain the original appearance, scale, and structure of the Cu Chi tunnel network. Both have been protected, conserved, and adapted for visitors over the decades.
              </p>
              <p>
                The more useful difference comes down to practical logistics and atmosphere.
              </p>
              <p>
                <strong>Ben Dinh is closer to Ho Chi Minh City and serves as the standard stop for organized coach tours. Ben Duoc is roughly 15 km farther out, set in a tranquil riverside forest, and encompasses an expansive commemorative complex centered around the Ben Duoc Martyrs Memorial Temple.</strong>
              </p>
              <p>
                So which should a traveler choose? The answer depends on your priorities: <strong>saving road transit time to pair Cu Chi with city sightseeing, or dedicating extra time to explore the broader historical setting of Cu Chi.</strong>
              </p>
            </div>

            <!-- First Image Inside Body: Diorama Explanation -->
            <div class="my-6 not-prose">
              <div class="rounded-2xl overflow-hidden shadow-md border border-slate-200">
                <img 
                  src="https://media.thericetour.com/uploads/guide-explaining-cu-chi-tunnel-cross-section-model-diorama.webp" 
                  alt="Licensed tour guide explaining the three-tiered underground network using a detailed cross-section model diorama at Cu Chi" 
                  class="w-full h-auto object-cover max-h-[500px]"
                  width="1280"
                  height="720"
                  loading="lazy"
                />
              </div>
              <p class="text-center text-xs sm:text-sm text-slate-500 italic mt-2.5">
                An experienced licensed guide uses an architectural diorama to decode Cu Chi's three-tiered underground defense levels.
              </p>
            </div>
          </section>

          <!-- Section: At A Glance -->
          <section id="at-a-glance" class="scroll-mt-28 space-y-5">
            <div class="border-l-4 border-amber-500 pl-4 mb-4">
              <h2 class="font-serif text-2xl lg:text-[26px] font-bold text-slate-900 leading-tight">
                Ben Dinh Vs Ben Duoc At A Glance
              </h2>
            </div>

            <div class="text-slate-700 text-[15.5px] leading-relaxed space-y-4">
              <p>
                To help you make an immediate comparison, here is how both preserved sectors stack up side-by-side:
              </p>

              <!-- Comparison Table -->
              <div class="overflow-x-auto my-6 border border-slate-200 rounded-xl shadow-xs">
                <table class="w-full text-left text-xs sm:text-sm border-collapse">
                  <thead>
                    <tr class="bg-slate-900 text-white font-serif">
                      <th class="p-3.5 sm:p-4 font-semibold">Comparison Factor</th>
                      <th class="p-3.5 sm:p-4 font-semibold">Ben Dinh</th>
                      <th class="p-3.5 sm:p-4 font-semibold bg-amber-900/80 text-amber-100">Ben Duoc</th>
                    </tr>
                  </thead>
                  <tbody class="divide-y divide-slate-100">
                    <tr class="hover:bg-slate-50/80">
                      <td class="p-3.5 sm:p-4 font-semibold text-slate-900">Distance from Saigon</td>
                      <td class="p-3.5 sm:p-4 text-emerald-700 font-medium">~50 km northwest (~1.5–2 hours)</td>
                      <td class="p-3.5 sm:p-4 text-slate-700 bg-amber-50/30">~65–70 km northwest (~2–2.5 hours)</td>
                    </tr>
                    <tr class="hover:bg-slate-50/80">
                      <td class="p-3.5 sm:p-4 font-semibold text-slate-900">Organized Group Tours</td>
                      <td class="p-3.5 sm:p-4 text-slate-700">Standard arrival point for large coach tours</td>
                      <td class="p-3.5 sm:p-4 text-emerald-700 font-medium bg-amber-50/30">Infrequently included on standard bus itineraries</td>
                    </tr>
                    <tr class="hover:bg-slate-50/80">
                      <td class="p-3.5 sm:p-4 font-semibold text-slate-900">Wartime Role</td>
                      <td class="p-3.5 sm:p-4 text-slate-700">Base of Cu Chi District Party Committee (1961–1975)</td>
                      <td class="p-3.5 sm:p-4 text-slate-700 bg-amber-50/30">Headquarters of Saigon–Gia Dinh Regional Command</td>
                    </tr>
                    <tr class="hover:bg-slate-50/80">
                      <td class="p-3.5 sm:p-4 font-semibold text-slate-900">Preserved Tunnel Levels</td>
                      <td class="p-3.5 sm:p-4 text-slate-700">Three-level defensive system</td>
                      <td class="p-3.5 sm:p-4 text-slate-700 bg-amber-50/30">Three-level deeper defensive system</td>
                    </tr>
                    <tr class="hover:bg-slate-50/80">
                      <td class="p-3.5 sm:p-4 font-semibold text-slate-900">Principal Depth</td>
                      <td class="p-3.5 sm:p-4 text-slate-700">Approx. 3.4 m, 4 m, and 5.15 m</td>
                      <td class="p-3.5 sm:p-4 text-slate-700 bg-amber-50/30">Approx. 4 m, 6 m, and 7–10 m</td>
                    </tr>
                    <tr class="hover:bg-slate-50/80">
                      <td class="p-3.5 sm:p-4 font-semibold text-slate-900">Atmosphere & Crowds</td>
                      <td class="p-3.5 sm:p-4 text-slate-700">Busy, compact, higher group density</td>
                      <td class="p-3.5 sm:p-4 text-emerald-700 font-semibold bg-amber-50/30">Quieter, spacious, contemplative forest setting</td>
                    </tr>
                    <tr class="hover:bg-slate-50/80">
                      <td class="p-3.5 sm:p-4 font-semibold text-slate-900">Memorial Complex</td>
                      <td class="p-3.5 sm:p-4 text-slate-600">Focused historical visitor pavilion</td>
                      <td class="p-3.5 sm:p-4 text-amber-900 font-semibold bg-amber-50/30">Ben Duoc Martyrs Memorial Temple (44,000+ names)</td>
                    </tr>
                    <tr class="hover:bg-slate-50/80">
                      <td class="p-3.5 sm:p-4 font-semibold text-slate-900">Surroundings</td>
                      <td class="p-3.5 sm:p-4 text-slate-600">Road 15 corridor, dense secondary woodland</td>
                      <td class="p-3.5 sm:p-4 text-slate-700 bg-amber-50/30">Shaded forest near Saigon River and Thai Thai stream</td>
                    </tr>
                    <tr class="hover:bg-slate-50/80">
                      <td class="p-3.5 sm:p-4 font-semibold text-slate-900">Best Suited For</td>
                      <td class="p-3.5 sm:p-4 text-emerald-700 font-medium">Shorter morning visits, families with young kids</td>
                      <td class="p-3.5 sm:p-4 text-amber-900 font-semibold bg-amber-50/30">History enthusiasts, slower unhurried exploration</td>
                    </tr>
                    <tr class="hover:bg-slate-50/80">
                      <td class="p-3.5 sm:p-4 font-semibold text-slate-900">Private Transport</td>
                      <td class="p-3.5 sm:p-4 text-slate-700">Convenient for rapid half-day turnarounds</td>
                      <td class="p-3.5 sm:p-4 text-emerald-700 font-semibold bg-amber-50/30">Essential for schedule control and flexible pacing</td>
                    </tr>
                  </tbody>
                </table>
              </div>

              <p class="text-sm text-slate-600 italic">
                Neither sector is a universal winner. The table describes two distinct ways of experiencing the same monumental underground guerrilla system.
              </p>
            </div>
          </section>

          <!-- Section: The Real Difference -->
          <section id="the-real-difference" class="scroll-mt-28 space-y-5">
            <div class="border-l-4 border-amber-500 pl-4 mb-4">
              <h2 class="font-serif text-2xl lg:text-[26px] font-bold text-slate-900 leading-tight">
                What Is The Real Difference Between Ben Dinh And Ben Duoc?
              </h2>
            </div>

            <div class="text-slate-700 text-[15.5px] leading-relaxed space-y-4">
              <p>
                Ben Dinh and Ben Duoc are not separate attractions operated by competing companies. Both belong to the unified <strong>Cu Chi Tunnels Historical Relic Site</strong>, representing different functional sectors of a subterranean guerrilla network that once stretched over 250 km across the Iron Triangle.
              </p>
              <p>
                Their wartime roles were distinct:
              </p>
              <ul class="list-disc pl-5 space-y-2 text-slate-600 text-sm">
                <li><strong>Ben Dinh</strong> operated from 1961 to 1975 as the operational base for the Cu Chi District Party Committee. Partisans here directed frontline operations, defended local villages, and mounted ambushes against neighboring military installations.</li>
                <li><strong>Ben Duoc</strong> served as the regional headquarters for the Saigon–Gia Dinh Military Command and Party Committee during the Second Indochina War. It held strategic command functions, housing regional leadership, planning rooms, printing presses, and field infirmaries.</li>
              </ul>
              <p>
                Their subterranean architecture also differs in depth:
              </p>
              <p>
                Both systems feature a sophisticated three-tiered structural design, but UNESCO’s 2026 archival survey notes that Ben Dinh is shallower than Ben Duoc:
              </p>
              <ul class="list-disc pl-5 space-y-2 text-slate-600 text-sm">
                <li>At <strong>Ben Duoc</strong>, the three principal levels descend to approximately <strong>4 meters</strong>, <strong>6 meters</strong>, and <strong>7 to 10 meters</strong> beneath the forest surface.</li>
                <li>At <strong>Ben Dinh</strong>, the three tiers sit at approximately <strong>3.4 meters</strong>, <strong>4 meters</strong>, and <strong>5.15 meters</strong>.</li>
              </ul>
              <p>
                Understanding these structural differences gives travelers a grounded perspective rather than accepting the simplistic claim that Ben Duoc is "real" while Ben Dinh is "manufactured."
              </p>
            </div>
          </section>

          <!-- Section: Authenticity Myth -->
          <section id="authenticity-myth" class="scroll-mt-28 space-y-5">
            <div class="border-l-4 border-amber-500 pl-4 mb-4">
              <h2 class="font-serif text-2xl lg:text-[26px] font-bold text-slate-900 leading-tight">
                Is Ben Duoc More Authentic Than Ben Dinh?
              </h2>
            </div>

            <div class="text-slate-700 text-[15.5px] leading-relaxed space-y-4">
              <p>
                Not necessarily. Debunking this persistent online rumor is essential before booking.
              </p>
              <p>
                UNESCO's official 2026 World Heritage Tentative List submission specifically designates <strong>Ben Duoc and Ben Dinh as the two core sectors that best preserve the authentic scale, architectural logic, and defensive structure of the Cu Chi tunnel network</strong>. Together, the two protected zones safeguard approximately 4 km of intact underground passages.
              </p>
              <p>
                Neither site is an untouched, raw wartime trench.
              </p>
              <p>
                Both sectors underwent systematic conservation starting in 1978, followed by continuing stabilization from 1980 onward. In 1991, roughly 4 km of passages across both sites were reinforced, equipped with electrical lighting and ventilation ducts, and formally opened to international visitors.
              </p>
              <p>
                Lonely Planet correctly describes both public sections as enlarged and reinforced adaptations of the original guerrilla tunnels.
              </p>
              <p>
                That distinction matters:
              </p>
              <ul class="list-disc pl-5 space-y-2 text-slate-600 text-sm">
                <li>The <strong>historical subterranean monument</strong> represents the protected archaeological system.</li>
                <li>The <strong>visitor-accessible crawl circuit</strong> represents a reinforced safety zone engineered to prevent cave-ins and accommodate modern travelers.</li>
              </ul>
              <p>
                The question is not <em>"Which sector is genuine?"</em> Both are historic. The real question is: <strong>"Which environment delivers the atmosphere and travel pace you want?"</strong>
              </p>
            </div>

