---
import BaseLayout from '../layouts/BaseLayout.astro';
import { env } from 'cloudflare:workers';

const d1Db = env?.dulichcoguu_d1;

let post: any = null;
if (d1Db) {
  try {
    // Thử lấy từ bảng Post trước
    post = await d1Db.prepare("SELECT * FROM Post WHERE slug = ? AND (status = 'published' OR status = 'publish')").bind('tuyen-dung-nhan-vien-kinh-doanh').first();
    // Nếu không có, thử lấy từ bảng Page
    if (!post) {
      post = await d1Db.prepare("SELECT * FROM Page WHERE slug = ? AND (status = 'published' OR status = 'publish')").bind('tuyen-dung-nhan-vien-kinh-doanh').first();
    }
  } catch (e) {
    console.error("Lỗi lấy dữ liệu tuyển dụng từ D1:", e);
  }
}

const pageTitle = post?.title || "Nhân Viên Kinh Doanh | Sales Executive";
const seoTitle = post?.seoTitle || post?.title || "Tuyển dụng Nhân Viên Kinh Doanh (Sales Executive) | FIT TOUR";
const seoDesc = post?.seoDescription || "FIT TOUR tuyển dụng Nhân viên Kinh doanh (Sales Executive) du lịch tại TP.HCM. Cơ hội phát triển chuyên nghiệp, thu nhập hấp dẫn.";
const featuredImage = post?.featuredImage || "https://media.fittour.vn/uploads/2021/08/IMG_0392.webp";
const adminEditUrl = post?.id ? `/admin/posts/edit?id=${post.id}` : "";
---

<BaseLayout
  title={seoTitle}
  description={seoDesc}
  image={featuredImage}
  canonical="https://thericetour.com/tuyen-dung-nhan-vien-kinh-doanh"
  adminEditUrl={adminEditUrl}
>
  <main class="bg-slate-50 py-16 md:py-24">
    <div class="container mx-auto px-4 max-w-6xl">
      
      <!-- Breadcrumb -->
      <nav class="flex text-sm text-slate-500 mb-8 font-medium" aria-label="Breadcrumb">
        <ol class="flex items-center flex-wrap space-x-1 md:space-x-2">
          <li><a href="/" class="hover:text-brand-600 transition-colors">Trang chủ</a></li>
          <li><span class="mx-1 md:mx-2 text-slate-400">/</span></li>
          <li><a href="/tuyen-dung" class="hover:text-brand-600 transition-colors">Tuyển dụng</a></li>
          <li><span class="mx-1 md:mx-2 text-slate-400">/</span></li>
          <li class="text-slate-800" aria-current="page">{pageTitle}</li>
        </ol>
      </nav>

      <div class="flex flex-col lg:flex-row gap-8 items-start">
        
        <!-- Main Content -->
        <div class="flex-1 w-full max-w-4xl mx-auto bg-white rounded-2xl shadow-sm p-8 md:p-12 border border-slate-100 min-w-0">
        
        <!-- Feature Image -->
        <div class="mb-10 rounded-xl overflow-hidden shadow-sm">
          <img 
            src={featuredImage} 
            alt={pageTitle} 
            width="1280" 
            height="720" 
            class="w-full h-auto object-cover aspect-video"
            onerror="this.src='https://placehold.co/1280x720/e2e8f0/475569?text=FIT+TOUR+Team'"
          />
        </div>

        <div class="mb-8 pb-6 border-b border-slate-200">
          <h1 class="text-3xl md:text-4xl font-bold text-slate-900 mb-4">
            {pageTitle}
          </h1>
          <p class="text-brand-600 font-semibold text-lg">FIT TOUR | BEYOND ORDINARY JOURNEYS</p>
        </div>

        <div class="prose prose-slate max-w-none prose-headings:text-slate-900 prose-headings:font-bold prose-a:text-brand-600 prose-p:my-3 prose-ul:my-3 prose-li:my-1">
          
          <h3 id="thong-tin-vi-tri" class="scroll-mt-24">Thông Tin Vị Trí</h3>
          <div class="overflow-x-auto my-6">
            <table class="min-w-full text-left border-collapse border border-slate-200 text-sm md:text-base">
              <tbody>
                <tr>
                  <td class="border border-slate-200 p-3 bg-slate-50 font-semibold w-1/3">Chức danh</td>
                  <td class="border border-slate-200 p-3 font-bold">Nhân viên Kinh doanh | Sales Executive</td>
                </tr>
                <tr>
                  <td class="border border-slate-200 p-3 bg-slate-50 font-semibold">Bộ phận</td>
                  <td class="border border-slate-200 p-3">Kinh doanh</td>
                </tr>
                <tr>
                  <td class="border border-slate-200 p-3 bg-slate-50 font-semibold">Cấp bậc</td>
                  <td class="border border-slate-200 p-3">Executive</td>
                </tr>
                <tr>
                  <td class="border border-slate-200 p-3 bg-slate-50 font-semibold">Loại hình làm việc</td>
                  <td class="border border-slate-200 p-3">Toàn thời gian</td>
                </tr>
                <tr>
                  <td class="border border-slate-200 p-3 bg-slate-50 font-semibold">Địa điểm làm việc</td>
                  <td class="border border-slate-200 p-3">19 Lương Hữu Khánh, Phường Phạm Ngũ Lão, Quận 1, TP. HCM</td>
                </tr>
                <tr>
                  <td class="border border-slate-200 p-3 bg-slate-50 font-semibold">Báo cáo trực tiếp</td>
                  <td class="border border-slate-200 p-3">Trưởng nhóm Kinh doanh / Quản lý Kinh doanh</td>
                </tr>
                <tr>
                  <td class="border border-slate-200 p-3 bg-slate-50 font-semibold">Nhu cầu tuyển dụng</td>
                  <td class="border border-slate-200 p-3">02 vị trí</td>
                </tr>
              </tbody>
            </table>
          </div>

          <!-- Single Clear Role Switcher Banner below Table -->
          <div class="not-prose bg-amber-50/80 border border-amber-200/80 rounded-2xl p-4 sm:p-5 my-8 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 sm:gap-4">
            <div class="flex items-start gap-3">
              <div class="p-2 bg-amber-100 text-amber-800 rounded-xl shrink-0 mt-0.5 sm:mt-0">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/></svg>
              </div>
              <div>
                <p class="text-xs font-bold uppercase tracking-wider text-amber-800 mb-0.5">Dành cho ứng viên cấp Quản lý (3+ năm KN)</p>
                <p class="text-sm text-slate-700 font-medium mb-0">Bạn đã có kinh nghiệm dẫn dắt đội ngũ Sales du lịch?</p>
              </div>
            </div>
            <a 
              href="/tuyen-dung-truong-nhom-kinh-doanh-du-lich" 
              class="w-full sm:w-auto shrink-0 inline-flex items-center justify-center gap-2 px-4 py-2.5 bg-[#F7931E] hover:bg-amber-600 text-white text-xs sm:text-sm font-bold rounded-xl shadow-sm transition-all active:scale-95 !no-underline"
            >
              <span>Ứng tuyển Sales Team Leader</span>
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </a>
          </div>

          <h3>Về FIT TOUR</h3>
          <p>
            <strong>Công ty TNHH Du lịch Quốc tế Fit Tour (FIT TOUR)</strong> hoạt động trong lĩnh vực du lịch, phát triển và cung cấp các chương trình du lịch trong nước và quốc tế theo nhu cầu thực tế của khách hàng.
          </p>
          <p>
            FIT TOUR tin rằng chất lượng của một hành trình bắt đầu từ chất lượng của người làm nghề. Vì vậy, đội ngũ Sales không chỉ có nhiệm vụ bán sản phẩm, mà cần <strong>hiểu khách hàng, hiểu sản phẩm và có trách nhiệm với những gì mình tư vấn và cam kết</strong>.
          </p>
          <p>
            Sales tại FIT TOUR được kỳ vọng có khả năng khai thác nhu cầu, tư vấn, thiết kế chương trình, tính giá, xây dựng phương án thương mại và phối hợp với Điều hành để chuyển giao chính xác chương trình đã bán.
          </p>

          <div class="bg-slate-50 border border-slate-200 p-6 rounded-xl my-8">
            <h4 class="text-slate-800 mt-0 mb-3 font-bold flex items-center gap-2">
              <svg class="w-5 h-5 text-brand-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
              Tìm hiểu thêm về môi trường làm việc của chúng tôi
            </h4>
            <p class="text-slate-600 text-sm mb-4">Khám phá câu chuyện thương hiệu, đội ngũ nhân sự và các dự án thực tế mà FIT TOUR đã thực hiện để xem bạn có phù hợp với văn hóa của chúng tôi không nhé:</p>
            <div class="grid grid-cols-2 sm:flex sm:flex-wrap gap-2.5 not-prose">
              <a href="/gioi-thieu/" class="flex items-center justify-center text-center px-4 py-3 bg-white hover:bg-brand-50 text-slate-800 hover:text-brand-700 text-sm font-semibold rounded-xl transition-all border border-slate-200 shadow-sm active:scale-95">
                Về FIT TOUR
              </a>
              <a href="/our-team/" class="flex items-center justify-center text-center px-4 py-3 bg-white hover:bg-brand-50 text-slate-800 hover:text-brand-700 text-sm font-semibold rounded-xl transition-all border border-slate-200 shadow-sm active:scale-95">
                Đội ngũ của chúng tôi
              </a>
              <a href="/portfolio/" class="flex items-center justify-center text-center px-4 py-3 bg-white hover:bg-brand-50 text-slate-800 hover:text-brand-700 text-sm font-semibold rounded-xl transition-all border border-slate-200 shadow-sm active:scale-95">
                Dự án (Portfolio)
              </a>
              <a href="/tour-doanh-nghiep/" class="flex items-center justify-center text-center px-4 py-3 bg-white hover:bg-brand-50 text-slate-800 hover:text-brand-700 text-sm font-semibold rounded-xl transition-all border border-slate-200 shadow-sm active:scale-95">
                Tour Doanh Nghiệp
              </a>
            </div>
          </div>

          <h3 id="muc-tieu" class="scroll-mt-24">Mục Tiêu Vị Trí</h3>
          <p>
            Sales Executive chịu trách nhiệm phát triển và chuyển đổi các cơ hội kinh doanh thành booking thông qua hoạt động tư vấn, thiết kế và kinh doanh các chương trình du lịch trong nước và quốc tế.
          </p>
          <p>
            Vị trí này quản lý toàn bộ quy trình bán hàng trong phạm vi trách nhiệm của Sales, từ:
            <br/>
            <span class="inline-block bg-slate-100 rounded px-2 py-1 mt-2 text-sm text-slate-700 font-mono">
              Tiếp nhận nhu cầu → Phân tích nhu cầu → Tư vấn → Thiết kế chương trình → Costing & Báo giá → Follow-up → Đàm phán → Chốt booking → Bàn giao cho Điều hành → Duy trì quan hệ khách hàng
            </span>
          </p>
          <p>
            Sales Executive được kỳ vọng tạo ra doanh thu và lợi nhuận bền vững, đồng thời đảm bảo tính chính xác, phù hợp và chuyên nghiệp của những gì đã tư vấn cho khách hàng.
          </p>

          <hr class="my-8 border-slate-200" />

          <h3>Trách Nhiệm Chính</h3>
          
          <h4>1. Kinh Doanh & Phát Triển Khách Hàng</h4>
          <ul>
            <li>Tiếp nhận, phân loại và quản lý các khách hàng tiềm năng được phân bổ.</li>
            <li>Chủ động khai thác nhu cầu, mục đích chuyến đi, ngân sách, thời gian, sở thích và các yêu cầu đặc biệt của khách hàng.</li>
            <li>Tư vấn giải pháp du lịch phù hợp với từng phân khúc khách hàng.</li>
            <li>Chủ động phát triển khách hàng mới và cơ hội kinh doanh thông qua nguồn lead, khách hàng giới thiệu, network cá nhân và các kênh được công ty phân công.</li>
            <li>Xây dựng và quản lý pipeline bán hàng; đảm bảo từng cơ hội được theo dõi và xử lý đúng tiến độ.</li>
            <li>Thực hiện follow-up có hệ thống đối với báo giá, đề xuất và các cơ hội đang chờ quyết định.</li>
            <li>Đảm bảo mục tiêu doanh số, gross profit và các chỉ tiêu kinh doanh được giao.</li>
          </ul>

          <h4>2. Tư Vấn & Bán Hàng Theo Nhu Cầu</h4>
          <ul>
            <li>Đóng vai trò là Travel Consultant, tập trung vào việc hiểu nhu cầu và xây dựng giải pháp thay vì chỉ giới thiệu sản phẩm có sẵn.</li>
            <li>Đề xuất điểm đến, tuyến, phong cách du lịch, thời gian và dịch vụ phù hợp với mục tiêu chuyến đi.</li>
            <li>Trình bày rõ giá trị, phạm vi dịch vụ, điều kiện áp dụng và các hạng mục bao gồm hoặc không bao gồm.</li>
            <li>Tư vấn dựa trên mức độ phù hợp và giá trị thực tế, không chỉ dựa trên giá bán.</li>
            <li>Xử lý câu hỏi, phản đối và thương lượng với khách hàng một cách chuyên nghiệp.</li>
            <li>Đảm bảo thông tin tư vấn minh bạch, chính xác và nhất quán trong toàn bộ quá trình bán hàng.</li>
            <li><strong>Không đưa ra cam kết vượt quá khả năng cung cấp hoặc điều kiện dịch vụ thực tế.</strong></li>
          </ul>

          <h4>3. Thiết Kế Chương Trình & Costing</h4>
          <ul>
            <li>Xây dựng chương trình du lịch trong nước và quốc tế theo yêu cầu của khách hàng.</li>
            <li>Ưu tiên phát triển các chương trình outbound và customized travel theo định hướng sản phẩm của FIT TOUR.</li>
            <li>Đề xuất tuyến điểm, lịch trình, lưu trú, vận chuyển, tham quan, trải nghiệm và các dịch vụ bổ trợ phù hợp.</li>
            <li>Làm việc với nhà cung cấp và các bộ phận liên quan để xác nhận tình trạng dịch vụ, điều kiện cung cấp và chi phí.</li>
            <li>Thực hiện costing, tính giá bán và lập báo giá theo quy định của công ty.</li>
            <li>Kiểm soát sự phù hợp giữa nhu cầu khách hàng, giá thành, giá bán, gross margin và chất lượng dịch vụ.</li>
            <li>Điều chỉnh chương trình và báo giá theo phản hồi của khách hàng nhưng vẫn đảm bảo tính khả thi và hiệu quả kinh doanh.</li>
            <li>Chủ động đề xuất phương án thay thế khi ngân sách, tình trạng dịch vụ hoặc yêu cầu khách hàng thay đổi.</li>
          </ul>

          <h4>4. Quản Lý Quan Hệ Khách Hàng</h4>
          <ul>
            <li>Duy trì giao tiếp chuyên nghiệp và phản hồi trong thời gian cam kết.</li>
            <li>Quản lý đầy đủ thông tin khách hàng, nhu cầu, lịch sử trao đổi, báo giá và trạng thái cơ hội.</li>
            <li>Theo sát khách hàng trong toàn bộ chu kỳ bán hàng.</li>
            <li>Duy trì quan hệ sau booking và sau chuyến đi nhằm phát triển khách hàng quay lại và khách hàng giới thiệu.</li>
            <li>Tiếp nhận phản hồi và phối hợp với các bộ phận liên quan khi có vấn đề phát sinh.</li>
            <li>Bảo vệ chất lượng quan hệ khách hàng và hình ảnh FIT TOUR trong toàn bộ quá trình làm việc.</li>
          </ul>

          <h4>5. Bàn Giao & Phối Hợp Triển Khai</h4>
          <ul>
            <li>Bàn giao đầy đủ và chính xác thông tin booking cho bộ phận Điều hành sau khi khách hàng xác nhận.</li>
            <li>Đảm bảo các yêu cầu đặc biệt, dịch vụ, điều kiện thương mại và nội dung đã cam kết được thể hiện rõ trong quá trình bàn giao.</li>
            <li>Phối hợp với Điều hành, Product và nhà cung cấp để đảm bảo chương trình được triển khai đúng với phương án đã bán.</li>
            <li>Theo dõi quá trình bàn giao trong phạm vi trách nhiệm của Sales và chủ động làm rõ các nội dung liên quan khi cần thiết.</li>
            <li>Phối hợp xử lý các vấn đề phát sinh liên quan đến nội dung đã tư vấn hoặc cam kết với khách hàng.</li>
            <li>Ghi nhận phản hồi thực tế từ khách hàng và thị trường để đóng góp cho việc cải thiện sản phẩm và quy trình bán hàng.</li>
          </ul>

          <hr class="my-8 border-slate-200" />

          <h3 id="yeu-cau" class="scroll-mt-24">Yêu Cầu Bắt Buộc</h3>
          
          <h4>Kinh Nghiệm</h4>
          <ul>
            <li>Tối thiểu <strong>02 năm kinh nghiệm</strong> làm việc trong lĩnh vực du lịch.</li>
            <li>Có kinh nghiệm thực tế trong tư vấn và kinh doanh tour hoặc các sản phẩm dịch vụ du lịch.</li>
            <li>Ưu tiên ứng viên có kinh nghiệm outbound, customized travel hoặc tour thiết kế riêng.</li>
            <li>Có hiểu biết thực tế về tuyến điểm, dịch vụ và quy trình tổ chức chương trình du lịch.</li>
            <li>Có kinh nghiệm xây dựng chương trình, costing và báo giá.</li>
            <li>Có kinh nghiệm trực tiếp làm việc với khách hàng và quản lý quá trình bán hàng.</li>
          </ul>

          <h4>Học Vấn</h4>
          <ul>
            <li>Không bắt buộc đúng chuyên ngành.</li>
            <li>Tốt nghiệp Cao đẳng/Đại học chuyên ngành Du lịch, Kinh doanh, Marketing, Quản trị hoặc lĩnh vực liên quan là lợi thế.</li>
          </ul>

          <h4>Năng Lực Chuyên Môn</h4>
          <p>Ứng viên cần có khả năng:</p>
          <ul>
            <li>Khai thác và phân tích nhu cầu khách hàng.</li>
            <li>Chuyển nhu cầu thành chương trình hoặc giải pháp du lịch cụ thể.</li>
            <li>Xây dựng lịch trình phù hợp với tuyến điểm, thời gian và ngân sách.</li>
            <li>Thực hiện hoặc kiểm tra costing và lập báo giá.</li>
            <li>Trình bày phương án rõ ràng, logic và thuyết phục.</li>
            <li>Quản lý pipeline và follow-up theo từng giai đoạn của cơ hội.</li>
            <li>Xử lý phản đối, thay đổi yêu cầu và các tình huống phát sinh trong quá trình tư vấn.</li>
            <li>Phối hợp hiệu quả với Điều hành và nhà cung cấp để kiểm tra tính khả thi của chương trình.</li>
          </ul>

          <h3>Yêu Cầu Ưu Tiên (Lợi Thế)</h3>
          <ul>
            <li>Có sẵn tệp khách hàng cá nhân cao cấp (VIP).</li>
            <li>Có sẵn tệp khách hàng doanh nghiệp (B2B).</li>
            <li>Có network khách hàng hoặc đối tác trong ngành du lịch.</li>
            <li>Có kinh nghiệm bán tour quốc tế, outbound hoặc customized travel.</li>
            <li>Có kinh nghiệm với khách đoàn, khách doanh nghiệp, MICE hoặc incentive travel.</li>
            <li>Có kinh nghiệm phục vụ khách hàng trung và cao cấp.</li>
