            "name": "Huy Ngô",
            "url": "https://thericetour.com/hdv-huy-ngo",
            "jobTitle": "Travel Curator",
            "worksFor": { "@id": "https://thericetour.com/#organization" },
            "sameAs": ["https://www.facebook.com/huyngo.fittour"]
          },
          "datePublished": datePublished,
          "dateModified": dateModified,
          "about": { "@id": "https://thericetour.com/tu-vien-phugtal#place" },
          "mentions": [
            { "@id": "https://thericetour.com/kinh-nghiem-du-lich-zanskar#place" },
