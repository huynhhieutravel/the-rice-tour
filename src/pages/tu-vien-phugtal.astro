---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/ladakh-co-may.css';
import '../styles/blog.css';
import '../styles/author-card.css';
import App from '../components/ReactApp/TuVienPhugtal/App.tsx';
import { env } from 'cloudflare:workers';
const d1Db = env?.dulichcoguu_d1;

let seoTitle = "Tu viện Phuktal: Trái tim của Zanskar";
let seoDesc = "Khám phá Tu viện Phugtal (Phuktal Monastery) - tu viện cổ nằm lọt thỏm trên vách đá dựng đứng của vùng Zanskar hoang sơ, một trong những trải nghiệm trekking và tâm linh độc đáo nhất ở Ladakh.";
let seoImage = "https://media.fittour.vn/uploads/2023/06/tu-vien-Phugtal.webp";
let adminEditUrl = "";

let datePublished = "2023-06-15T08:00:00+08:00";
let dateModified = "2026-07-14T08:00:00+08:00";

if (d1Db) {
  try {
    const stmt = d1Db.prepare(`SELECT id, title, seoTitle as metaTitle, seoDescription as metaDescription, featuredImage, createdAt, updatedAt FROM Post WHERE slug = 'tu-vien-phugtal' LIMIT 1`);
    const postData = await stmt.first();
    if (postData) {
      seoImage = postData.featuredImage || seoImage;
      if (postData.id) adminEditUrl = `/admin/posts/edit?id=${postData.id}`;
      if (postData.createdAt) datePublished = new Date(postData.createdAt).toISOString();
      if (postData.updatedAt) dateModified = new Date(postData.updatedAt).toISOString();
    }
  } catch (e) {
    console.error("Lỗi lấy SEO data cho trang tu-vien-phugtal:", e);
  }
}
---
<BaseLayout
  title={seoTitle}
  description={seoDesc}
  image={seoImage}
  canonical="https://thericetour.com/tu-vien-phugtal"
  adminEditUrl={adminEditUrl}
>
  <Fragment slot="head">
    <meta property="og:type" content="article" />
    <!-- Optimize Google Fonts Loading -->
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&family=JetBrains+Mono:wght@400;500;700&display=swap">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&family=JetBrains+Mono:wght@400;500;700&display=swap" media="print" onload="this.media='all'">
    <noscript>
      <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&family=JetBrains+Mono:wght@400;500;700&display=swap">
    </noscript>
    <script type="application/ld+json" set:html={JSON.stringify({
