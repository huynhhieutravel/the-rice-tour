          "inLanguage": "vi-VN",
          "mainEntity": { "@id": "https://thericetour.com/tu-vien-phugtal#article" }
        },
        {
          "@type": "ImageObject",
          "@id": "https://thericetour.com/tu-vien-phugtal#primaryimage",
          "url": seoImage,
          "contentUrl": seoImage,
