          "@id": "https://thericetour.com/tu-vien-phugtal#article",
          "isPartOf": { "@id": "https://thericetour.com/tu-vien-phugtal#webpage" },
          "mainEntityOfPage": { "@id": "https://thericetour.com/tu-vien-phugtal#webpage" },
          "headline": seoTitle,
          "description": seoDesc,
          "image": { "@id": "https://thericetour.com/tu-vien-phugtal#primaryimage" },
          "inLanguage": "vi-VN",
