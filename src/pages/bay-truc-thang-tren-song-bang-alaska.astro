---
import { env } from 'cloudflare:workers';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { safeQueryCritical } from '@/lib/db-client';
import { getGlobalSettings } from '@/lib/settingsHelper';
import { MapPin, Info, Users, Clock, Calendar, Compass, Share2, Link as LinkIcon, ChevronRight, CheckCircle2 } from 'lucide-react';
import DataPost from '@/components/shortcodes/data/DataPost.astro';
import TourFAQItem from '@/components/tour/TourFAQItem.astro';
const d1Db = env?.dulichcoguu_d1;
if (!d1Db) return Astro.rewrite("/500");

// Fetch CMS Data for SEO and Metadata
let post;
try {
  post = await safeQueryCritical(
    d1Db.prepare("SELECT * FROM Post WHERE id = ? AND (status = 'published' OR status = 'publish')").bind('1781570000033').first<any>(),
    { route: Astro.url.pathname, slug: '1781570000033', queryType: "fetch_post_by_slug" }
  );
} catch (e) {
  return Astro.rewrite("/500");
}

if (!post) {
  return Astro.rewrite("/404");
}

const { settings } = await getGlobalSettings();

const seoTitle = post.seoTitle || post.title || 'Bay Trực Thăng Trên Sông Băng Alaska – Chạm Tay Vào Lịch Sử Địa Chất';
const seoDesc = post.seoDesc || post.excerpt || 'Khám phá Alaska bằng trực thăng, bay qua rừng taiga, sông băng hùng vĩ và hạ cánh trực tiếp trên bề mặt băng hà hàng nghìn năm tuổi.';
const seoImage = post.seoImage || post.featuredImage || 'https://media.fittour.vn/uploads/truc-thang-temsco-alaska-helicopter-tour.webp'; // Placeholder Alaska image

// --- DATE LOGIC ---
const createdAtStr = post.createdAt || post.publishedAt || new Date().toISOString();
const updatedAtStr = post.updatedAt || createdAtStr;

const createdAt = new Date(createdAtStr.replace(' ', 'T'));
const updatedAt = new Date(updatedAtStr.replace(' ', 'T'));

const isUpdated = updatedAt.getTime() - createdAt.getTime() > 86400000; 
const displayDate = isUpdated ? updatedAt : createdAt;
const datePrefix = isUpdated ? "Cập nhật:" : "Xuất bản:";

const formattedDate = displayDate.toLocaleDateString('vi-VN', { day: '2-digit', month: '2-digit', year: 'numeric' });
// ------------------

// --- AUTHOR LOGIC ---
const authorMap: Record<string, any> = {
  "Max Vũ": {
    name: "Max Vũ",
    url: "/max-vu",
    img: "https://media.fittour.vn/uploads/max-vu-founder-fit-tour.webp"
  },
  "Huy Ngô": {
    name: "Huy Ngô",
    url: "/hdv-huy-ngo",
    img: "https://media.fittour.vn/uploads/hdv-huy-ngo-fittour.webp"
  },
  "Huynh Hieu Travel": {
    name: "Huynh Hieu Travel",
    url: "/huynh-hieu",
    img: "https://media.fittour.vn/uploads/huynhhieutravel.webp"
  }
};
const authorData = authorMap[post.author] || authorMap["Huynh Hieu Travel"];
// ------------------

const adminEditUrl = `/admin/posts/edit?id=${post.id}`;

const tips = [
  {
    id: "khong-phai-denali",
    name: "Không Phải Denali, Mà Chính Talkeetna Mới Là Nơi Hành Trình Bắt Đầu",
    desc: `<p>Nhiều người nghĩ rằng muốn khám phá những sông băng hùng vĩ của Alaska thì phải đến <a href="/alaska-denali-dinh-nui-cao-nhat-bac-my" class="text-sky-600 hover:text-sky-800 underline font-medium">Denali</a>. Thực tế, <a href="/talkeetna" class="text-sky-600 hover:text-sky-800 underline font-medium">Talkeetna</a> mới là nơi khởi đầu của rất nhiều chuyến bay vào dãy Alaska Range.</p>
<p>Thị trấn nhỏ này từ lâu đã trở thành trung tâm của các chuyến bay ngắm cảnh, các đoàn leo núi và những phi công chuyên bay vào vùng hoang dã. Từ đây, chỉ mất chưa đầy nửa giờ để rời khỏi thế giới của đường sá và bước vào không gian gần như không còn dấu vết của con người.</p>
<p>Đó cũng là điều khiến Talkeetna khác biệt. Nếu Denali là biểu tượng của thiên nhiên Alaska, thì Talkeetna chính là cánh cửa dẫn vào thiên nhiên ấy.</p>
<p>Buổi chiều hôm đó, sau khi kết thúc hành trình khám phá Vườn quốc gia Denali và quay trở lại Talkeetna, cả đoàn gần như không có nhiều thời gian nghỉ ngơi. Ai cũng háo hức cho trải nghiệm đã được mong chờ từ nhiều ngày trước: bay trực thăng và hạ cánh trên sông băng.</p>
<figure class="my-6"><img src="https://media.fittour.vn/uploads/thung-lung-rung-taiga-alaska-tu-truc-thang.webp" alt="Thung lũng rừng taiga nhìn từ trực thăng" class="w-full rounded-xl shadow-md"><figcaption class="text-center text-sm text-slate-500 italic mt-3">Thung lũng rừng taiga bạt ngàn hiện ra ngay sau khi trực thăng cất cánh từ Talkeetna.</figcaption></figure>
<p>Ở sân bay nhỏ nằm bên rìa thị trấn, những chiếc trực thăng lần lượt cất cánh rồi lại hạ xuống trong tiếng động cơ vang vọng giữa thung lũng. Khung cảnh ấy khác hẳn những sân bay đông đúc mà chúng ta thường thấy. Không có những nhà ga khổng lồ hay dòng người tấp nập, chỉ có phi công, vài nhóm du khách và phía xa là những dãy núi phủ tuyết đang dần hiện rõ khi mây tan.</p>
<p>Ngay từ lúc ấy, mọi người đều hiểu rằng chuyến bay này sẽ không giống bất kỳ trải nghiệm hàng không nào trước đó.</p>`
  },
  {
    id: "alaska-hien-ra-theo-cach-khac",
    name: "Khi Alaska Hiện Ra Theo Một Cách Hoàn Toàn Khác",
    desc: `<p>Chiếc trực thăng nhấc khỏi mặt đất nhẹ đến mức nhiều người gần như không nhận ra khoảnh khắc bánh đáp rời khỏi đường băng.</p>
<p>Chỉ trong vài phút, toàn bộ Talkeetna thu nhỏ lại dưới chân. Những con đường vốn tưởng dài nay chỉ còn là những vệt mảnh giữa rừng cây. Các dòng sông uốn lượn quanh thị trấn dần hợp thành một mạng lưới bạc trải dài đến tận đường chân trời.</p>
<p>Rồi cảnh quan bắt đầu thay đổi.</p>
<p>Những cánh rừng taiga bất tận xuất hiện, xen kẽ là các hồ nước xanh ngọc và những đồng bằng rộng lớn gần như không có dấu chân người. Xa hơn nữa là những dãy núi của Alaska Range, nơi các đỉnh núi phủ tuyết quanh năm tạo thành bức tường khổng lồ ngăn cách vùng nội địa với miền nam Alaska.</p>
<figure class="my-6"><img src="https://media.fittour.vn/uploads/ho-bang-va-day-nui-alaska-nhin-tu-truc-thang.webp" alt="Hồ băng và dãy núi Alaska nhìn từ trực thăng" class="w-full rounded-xl shadow-md"><figcaption class="text-center text-sm text-slate-500 italic mt-3">Hồ băng và dãy núi Alaska hùng vĩ nhìn từ trực thăng.</figcaption></figure>
<p>Từ mặt đất, chúng chúng ta thường nhìn từng ngọn núi, từng dòng sông hay từng khu rừng như những điểm đến riêng lẻ. Nhưng từ trên cao, tất cả kết nối lại thành một hệ sinh thái khổng lồ, nơi mọi thứ đều liên quan đến nhau: băng tạo nên sông, sông nuôi dưỡng rừng và rừng lại trở thành môi trường sống của vô số loài động vật hoang dã.</p>
<p>Có lẽ đó là điều đầu tiên khiến cả đoàn gần như quên mất việc chụp ảnh.</p>
<p>Mọi ánh mắt đều hướng ra ô cửa kính. Không ai nói gì.</p>
<p>Bởi trước khung cảnh ấy, đôi khi sự im lặng lại là cách cảm nhận trọn vẹn nhất.</p>`
  },
  {
    id: "the-gioi-kien-tao-boi-bang",
    name: "Một Thế Giới Được Kiến Tạo Bởi Băng",
    desc: `<p>Càng tiến sâu vào vùng núi, khung cảnh bên dưới càng trở nên kỳ lạ.</p>
<p>Những dòng sông không còn chảy thành một nhánh duy nhất mà tách ra thành hàng chục, thậm chí hàng trăm dòng nhỏ đan xen như những mạch máu khổng lồ trên mặt đất. Xen giữa chúng là các hồ nước mang màu xanh ngọc nổi bật, trong khi phía xa là những khối băng trắng khổng lồ đang ôm lấy cả thung lũng.</p>
<figure class="my-6"><img src="https://media.fittour.vn/uploads/dia-hinh-song-bang-va-bang-ha-alaska.webp" alt="Địa hình sông băng và băng hà Alaska" class="w-full rounded-xl shadow-md"><figcaption class="text-center text-sm text-slate-500 italic mt-3">Sự vĩ đại của địa hình được kiến tạo bởi băng hà hàng chục nghìn năm.</figcaption></figure>
<p>Đó không phải là sự sắp đặt ngẫu nhiên của thiên nhiên. Mà là kết quả của hàng chục nghìn năm băng hà liên tục bào mòn núi đá, nghiền chúng thành lớp bột khoáng cực mịn rồi mang theo trong dòng nước tan mỗi mùa hè. Chính quá trình ấy đã tạo nên những đồng bằng phù sa rộng lớn, những dòng sông bện đặc trưng và màu xanh gần như phát sáng của các hồ băng mà chỉ những vùng có sông băng mới sở hữu.</p>
<p>Đứng dưới mặt đất, rất khó để hình dung quy mô của quá trình ấy.</p>
<p>Nhưng từ trực thăng, mọi dấu vết của băng hà hiện lên rõ ràng như những nét vẽ trên một tấm bản đồ địa chất khổng lồ.</p>`
  },
  {
    id: "nhung-dong-song-ben",
    name: "Những Dòng Sông Không Bao Giờ Chảy Theo Một Lối",
    desc: `<p>Khi trực thăng bắt đầu bay sâu hơn vào vùng băng hà, điều khiến nhiều người trong đoàn ngạc nhiên nhất lại không phải những đỉnh núi phủ tuyết. Mà là những dòng sông.</p>
<p>Từ trên cao, chúng không chảy thành một dòng duy nhất như hầu hết các con sông chúng ta từng thấy. Thay vào đó, nước liên tục tách ra thành vô số nhánh nhỏ rồi lại nhập vào nhau, tạo thành những hoa văn khổng lồ trải dài trên đồng bằng.</p>
<figure class="my-6"><img src="https://media.fittour.vn/uploads/dong-song-bang-dan-xen-braided-river-alaska.webp" alt="Dòng sông bện (braided river) từ băng tan" class="w-full rounded-xl shadow-md"><figcaption class="text-center text-sm text-slate-500 italic mt-3">Hiện tượng dòng sông bện (braided river) – khi sông băng tan chảy, dòng nước mang theo phù sa khiến con sông liên tục tách nhánh.</figcaption></figure>
<p>Nếu nhìn từ cửa sổ trực thăng, khung cảnh ấy giống như một mạng lưới mạch máu đang lan khắp mặt đất. Đó là hiện tượng dòng sông bện (braided river) – một dạng địa hình đặc trưng của những vùng chịu ảnh hưởng mạnh từ băng hà.</p>
<p>Mỗi mùa hè, khi nhiệt độ tăng lên, các <a href="/alaska-glacier-nhung-dong-song-bang" class="text-sky-600 hover:text-sky-800 underline font-medium">sông băng</a> bắt đầu tan chảy. Dòng nước mang theo khối lượng khổng lồ cát, sỏi và đá vụn được nghiền nát trong suốt hàng nghìn năm. Khi chảy xuống vùng đồng bằng, tốc độ dòng nước giảm dần, lượng vật liệu này lắng đọng liên tục, buộc con sông phải đổi hướng và tự chia thành nhiều nhánh mới.</p>
<p>Chính vì vậy, không có dòng sông nào ở đây giữ nguyên hình dạng quá lâu. Chỉ sau một mùa tan băng, bản đồ dòng chảy có thể đã khác hoàn toàn năm trước. Đó là một Alaska luôn thay đổi, dù sự thay đổi ấy diễn ra chậm rãi và gần như không thể nhận ra nếu chỉ đứng dưới mặt đất.</p>`
  },
  {
    id: "vi-sao-ho-nuoc-co-mau-xanh-ngoc",
    name: "Vì Sao Hồ Nước Ở Alaska Có Màu Xanh Ngọc?",
    desc: `<p>Khi trực thăng lướt qua những thung lũng, bên dưới hiện ra hàng loạt hồ nước mang màu xanh ngọc trong đến khó tin.</p>
<p>Đó là màu xanh rất đặc biệt. Không đậm như biển nhiệt đới. Không xanh thẫm như hồ trên núi. Mà là một sắc xanh gần như phát sáng dưới ánh nắng mùa hè. Nếu chỉ nhìn ảnh, nhiều người sẽ nghĩ màu nước đã được chỉnh sửa. Nhưng thực tế, đó là màu sắc hoàn toàn tự nhiên.</p>
<div class="grid grid-cols-1 sm:grid-cols-2 gap-4 my-6"><figure><img src="https://media.fittour.vn/uploads/ho-bang-xanh-ngoc-tren-song-bang-alaska.webp" alt="Hồ băng xanh ngọc trên bề mặt sông băng" class="w-full rounded-xl shadow-sm"><figcaption class="text-center text-sm text-slate-500 italic mt-2">Hồ băng xanh ngọc hình thành trên bề mặt sông băng</figcaption></figure><figure><img src="https://media.fittour.vn/uploads/ho-bang-xanh-ngoc-nhin-tu-truc-thang-alaska.webp" alt="Hồ băng xanh ngọc ở thung lũng Alaska" class="w-full rounded-xl shadow-sm"><figcaption class="text-center text-sm text-slate-500 italic mt-2">Màu xanh đặc trưng từ "bột đá băng hà" (glacial flour)</figcaption></figure></div>
<p>Nguồn gốc của màu xanh ấy nằm ở những hạt khoáng cực mịn, thường được các nhà địa chất gọi là bột đá băng hà (glacial flour).</p>
<p>Trong quá trình di chuyển, khối băng khổng lồ liên tục nghiền nát nền đá phía dưới thành những hạt nhỏ đến mức mắt thường gần như không nhìn thấy. Khi băng tan, các hạt khoáng này theo dòng nước chảy vào hồ. Dưới ánh sáng mặt trời, chúng phản xạ mạnh dải ánh sáng xanh và hấp thụ phần lớn các màu còn lại. Kết quả là mặt hồ hiện lên với màu xanh ngọc đặc trưng mà du khách thường chỉ bắt gặp ở những vùng băng hà trên thế giới như Alaska, Patagonia hay New Zealand.</p>
<p>Điều thú vị là màu nước cũng thay đổi theo mùa. Vào cuối mùa hè, khi lượng bột đá trong nước nhiều hơn, màu xanh thường trở nên đậm và rực rỡ hơn. Có lẽ vì thế mà mỗi hồ nước nhìn từ trực thăng đều mang một sắc thái riêng, không hồ nào hoàn toàn giống hồ nào.</p>`
  },
  {
    id: "dai-mau-den-khong-phai-dat",
    name: "Những Dải Màu Đen Không Phải Là Đất Bẩn",
    desc: `<p>Càng tiến gần sông băng, khung cảnh bên dưới càng trở nên kỳ lạ.</p>
<p>Giữa những khối băng trắng khổng lồ xuất hiện các dải màu xám và đen kéo dài hàng kilomet, uốn lượn theo dòng băng như những nét vẽ khổng lồ. Nhiều người trong đoàn ban đầu đều nghĩ đó là đất hoặc bụi bám trên bề mặt tuyết. Phi công mỉm cười rồi giải thích. Đó là medial moraine – những dải đá hình thành khi hai dòng sông băng nhập lại với nhau.</p>
<figure class="my-6"><img src="https://media.fittour.vn/uploads/song-bang-va-thung-lung-alaska-tu-tren-cao.webp" alt="Các dải medial moraine trên bề mặt sông băng" class="w-full rounded-xl shadow-md"><figcaption class="text-center text-sm text-slate-500 italic mt-3">Các dải medial moraine giống như những đường vằn khổng lồ trên dòng chảy của dòng sông băng.</figcaption></figure>
<p>Mỗi nhánh sông băng trong quá trình di chuyển đều cuốn theo đá từ sườn núi. Khi hai nhánh hợp nhất, các lớp đá này cũng nhập vào nhau, tạo nên một dải màu đen chạy dọc giữa khối băng. Nhìn từ trên cao, chúng giống như những đường chỉ tay khổng lồ, ghi lại lịch sử chuyển động của sông băng qua hàng nghìn năm.</p>
<p>Đó là điều rất khó quan sát nếu chỉ đứng dưới mặt đất. Nhưng từ trực thăng, mọi dấu vết đều hiện ra rõ ràng như một cuốn sách địa chất mở rộng giữa thiên nhiên.</p>`
  },
  {
    id: "song-bang-khong-dung-yen",
    name: "Sông Băng Không Đứng Yên",
    desc: `<p>Nhìn từ xa, sông băng luôn tạo cảm giác bất động. Khổng lồ. Lạnh lẽo. Và dường như không thay đổi theo thời gian. Thực tế lại hoàn toàn ngược lại.</p>
<figure class="my-6"><img src="https://media.fittour.vn/uploads/dia-hinh-song-bang-alaska-nhin-tu-truc-thang.webp" alt="Địa hình nứt nẻ và chuyển động của dòng sông băng" class="w-full rounded-xl shadow-md"><figcaption class="text-center text-sm text-slate-500 italic mt-3">Địa hình nứt nẻ là minh chứng rõ nhất cho thấy sông băng vẫn đang liên tục dịch chuyển dưới sức ép của chính nó.</figcaption></figure>
<p>Sông băng là một "dòng sông" đặc biệt được tạo thành từ băng. Dưới sức nặng của chính mình, khối băng vẫn âm thầm dịch chuyển xuống thấp từng ngày, dù tốc độ chỉ tính bằng vài chục centimet đến vài mét mỗi ngày tùy từng khu vực.</p>
<p>Chính sự chuyển động chậm chạp ấy đã bào mòn núi đá, tạo nên những thung lũng hình chữ U, những hồ băng mới và vô số địa hình đặc trưng của Alaska ngày nay. Đứng trên trực thăng nhìn xuống, thật khó tin rằng khung cảnh tưởng như bất biến ấy vẫn đang thay đổi từng giờ. Có lẽ đó cũng là điều khiến Alaska trở nên đặc biệt.</p>
<p>Thiên nhiên ở đây không phải một bức tranh tĩnh. Mà là một thế giới vẫn đang tiếp tục được kiến tạo.</p>`
  },
  {
    id: "khoanh-khac-cham-xuong",
    name: "Khoảnh Khắc Trực Thăng Chạm Xuống Sông Băng",
    desc: `<p>Sau gần nửa giờ bay, phi công bắt đầu giảm độ cao.</p>
<p>Chiếc trực thăng không còn hướng về những đỉnh núi phía trước mà lượn một vòng rộng trên thung lũng băng. Từ trên cao, mặt sông băng hiện ra như một đại dương trắng khổng lồ với những đường nứt xanh thẫm, các dải đá đen và vô số gợn sóng được tạo nên bởi quá trình băng dịch chuyển suốt hàng nghìn năm.</p>
<figure class="my-6"><img src="https://media.fittour.vn/uploads/truc-thang-ha-canh-tren-song-bang-alaska.webp" alt="Trực thăng đang chuẩn bị hạ cánh trên sông băng" class="w-full rounded-xl shadow-md"><figcaption class="text-center text-sm text-slate-500 italic mt-3">Chiếc trực thăng nhẹ nhàng tiếp đất ngay trên mặt băng khổng lồ giữa thung lũng.</figcaption></figure>
<p>Không ai còn mải mê chụp ảnh. Tất cả đều hướng mắt xuống phía dưới, cố gắng ghi nhớ từng khoảnh khắc khi chiếc trực thăng từ từ tiến gần mặt băng.</p>
<p>Rồi một cú chạm rất nhẹ. Cánh quạt vẫn quay. Nhưng Alaska lúc ấy gần như hoàn toàn im lặng.</p>`
  },
  {
    id: "dung-tren-lop-bang",
    name: "Đứng Trên Lớp Băng Được Hình Thành Từ Hàng Nghìn Năm Trước",
    desc: `<p>Khi cánh cửa trực thăng mở ra, luồng không khí lạnh lập tức tràn vào khoang.</p>
<p>Đó không phải cái lạnh buốt của mùa đông, mà là cảm giác mát lạnh rất đặc trưng của băng hà – khô, trong và gần như không mang theo bất kỳ mùi vị nào. Chỉ vài bước chân đầu tiên, cả đoàn đều vô thức nhìn xuống dưới chân mình.</p>
<figure class="my-6"><img src="https://media.fittour.vn/uploads/doan-fit-tour-tren-song-bang-alaska.webp" alt="Đoàn khách FIT TOUR chụp ảnh lưu niệm trên bề mặt sông băng" class="w-full rounded-xl shadow-md"><figcaption class="text-center text-sm text-slate-500 italic mt-3">Đoàn khách FIT TOUR đặt những bước chân đầu tiên lên dải băng hà hàng nghìn năm tuổi.</figcaption></figure>
<p>Lớp băng ấy không phải mới hình thành sau một mùa đông. Nó là kết quả của hàng nghìn năm tuyết rơi, nén chặt dưới sức nặng của chính mình rồi dần biến thành băng. Mỗi lớp tuyết mới phủ lên sẽ ép lớp cũ đặc hơn, cho đến khi tạo thành khối băng dày hàng trăm mét đang âm thầm dịch chuyển qua từng năm.</p>
<p>Nghĩ đến điều đó, cảm giác đứng trên sông băng trở nên đặc biệt hơn rất nhiều. Không chỉ vì đây là một nơi đẹp. Mà bởi bạn đang đứng trên một phần lịch sử địa chất của Trái Đất.</p>`
  },
  {
    id: "thien-nhien-khong-hoan-hao",
    name: "Thiên Nhiên Không Hoàn Hảo, Nhưng Chính Vì Thế Mà Đẹp",
    desc: `<p>Nếu tưởng tượng sông băng sẽ trắng tinh như trong phim, nhiều người có lẽ sẽ bất ngờ. Ở khoảng cách gần, mặt băng hiện lên với đủ loại màu sắc và kết cấu. Có nơi trắng xóa, có nơi ánh lên màu xanh lam, cũng có những vùng phủ đầy sỏi đá hay xuất hiện các khe nứt sâu.</p>
<p>Chính những "vết xước" ấy mới kể nên câu chuyện thật của băng hà.</p>
<figure class="my-6"><img src="https://media.fittour.vn/uploads/thac-nuoc-giua-rung-nui-alaska-tu-truc-thang.webp" alt="Cảnh quan hoang sơ với những vách đá và thác nước từ băng tan" class="w-full rounded-xl shadow-md"><figcaption class="text-center text-sm text-slate-500 italic mt-3">Những dòng thác nước từ băng tan chảy róc rách qua các vách đá xù xì.</figcaption></figure>
<p>Mỗi viên đá nằm trên mặt băng đều từng được khối băng mang đi từ một sườn núi xa xôi. Mỗi khe nứt là dấu hiệu cho thấy khối băng vẫn đang chịu áp lực và tiếp tục chuyển động. Ngay cả những vũng nước nhỏ trên bề mặt cũng phản ánh mùa hè đang dần làm tan lớp băng phía trên.</p>
<p>Thiên nhiên ở Alaska chưa bao giờ hoàn hảo theo nghĩa bóng bẩy. Nhưng chính sự nguyên sơ ấy lại khiến nơi đây trở nên chân thực đến kinh ngạc.</p>`
  },
  {
    id: "mot-gio-bay",
    name: "Một Giờ Bay Để Hiểu Hàng Chục Nghìn Năm Lịch Sử",
    desc: `<p>Có một điều khá thú vị. Trước khi đến Alaska, nhiều người trong đoàn nghĩ sông băng chỉ đơn giản là "một khối băng rất lớn". Sau chuyến bay, cách nhìn ấy hoàn toàn thay đổi.</p>
<figure class="my-6"><img src="https://media.fittour.vn/uploads/ben-trong-truc-thang-kham-pha-song-bang-alaska.webp" alt="Góc nhìn từ bên trong buồng lái trực thăng ngắm cảnh Alaska" class="w-full rounded-xl shadow-md"><figcaption class="text-center text-sm text-slate-500 italic mt-3">Một giờ bay để được tận mắt chứng kiến quá trình thay đổi của Trái Đất.</figcaption></figure>
<p>Sông băng không chỉ là băng. Đó là lực lượng đã tạo nên những thung lũng hình chữ U, bào mòn các dãy núi, vận chuyển hàng tỷ tấn đá và quyết định hình dạng của rất nhiều dòng sông tại Alaska ngày nay.</p>
<p>Những hồ xanh ngọc, những đồng bằng rộng lớn hay các dòng sông bện mà chúng tôi nhìn thấy từ trực thăng đều có chung một điểm khởi đầu: băng hà. Nói cách khác, muốn hiểu Alaska, trước hết phải hiểu những dòng sông băng của vùng đất này.</p>`
  },
  {
    id: "vi-sao-fit-tour-chon",
    name: "Vì Sao FIT TOUR Luôn Chọn Trải Nghiệm Này?",
    desc: `<p>Một <a href="/dieu-can-biet-truoc-khi-bay-truc-thang-alaska" class="text-sky-600 hover:text-sky-800 underline font-medium">chuyến bay trực thăng</a> chắc chắn không phải hoạt động rẻ nhất trong hành trình. Nhưng sau khi trực tiếp trải nghiệm, chúng tôi hiểu vì sao rất nhiều du khách quốc tế vẫn xem đây là khoản đầu tư xứng đáng nhất khi đến Alaska.</p>
<p>Bởi những gì nhìn thấy từ trên cao không thể thay thế bằng bất kỳ cung đường nào.</p>
<figure class="my-6"><img src="https://media.fittour.vn/uploads/fit-tour-chinh-phuc-song-bang-bang-truc-thang-alaska.webp" alt="Khách hàng FIT TOUR trải nghiệm trực thăng trên sông băng Alaska" class="w-full rounded-xl shadow-md"><figcaption class="text-center text-sm text-slate-500 italic mt-3">Đây luôn được xem là một trong những trải nghiệm đắt giá nhất khi đến Alaska.</figcaption></figure>
<p>Bạn có thể lái xe hàng nghìn kilomet, đi tàu xuyên bang hay trekking nhiều ngày, nhưng vẫn không thể quan sát trọn vẹn cách rừng, sông, hồ, núi và băng hà kết nối với nhau. Chỉ khi chiếc trực thăng nâng bạn lên khỏi mặt đất, bức tranh ấy mới thật sự hoàn chỉnh.</p>
<p>Đó cũng là lý do FIT TOUR luôn dành thời gian cho trải nghiệm này trong hành trình Alaska. Không phải để "thêm một hoạt động", mà để mỗi du khách có cơ hội nhìn thấy vùng đất phương Bắc bằng đúng góc nhìn mà thiên nhiên xứng đáng có.</p>`
  }
];


---

<BaseLayout 
  title={seoTitle} 
  description={seoDesc} 
  image={seoImage}
  preloadImages={[seoImage]}
  adminEditUrl={adminEditUrl}
>
  <div class="bg-[#F8F9FA] text-[#1E293B] font-sans antialiased selection:bg-[#0ea5e9] selection:text-white">

    {/* ================= HERO SECTION ================= */}
    <section class="relative w-full min-h-[600px] lg:min-h-[700px] overflow-hidden flex flex-col justify-center pt-32 pb-20">
      <div class="absolute inset-0 z-0 bg-slate-900">
        <img src={seoImage} alt="Trực thăng khám phá sông băng Alaska" class="w-full h-full object-cover object-center opacity-80" fetchpriority="high" loading="eager" decoding="async" />
        <div class="absolute inset-0 bg-gradient-to-r from-black/80 via-black/50 to-transparent"></div>
        <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-transparent to-transparent"></div>
      </div>

      <div class="relative z-10 max-w-[1600px] mx-auto px-4 sm:px-6 lg:px-12 w-full">
        
        {/* Breadcrumb */}
        <div class="flex items-center gap-2 text-[13px] text-white/70 font-medium mb-6">
          <a href="/" class="hover:text-white transition-colors">Trang chủ</a>
          <ChevronRight class="w-3 h-3" />
          <a href="/blog" class="hover:text-white transition-colors">Blog</a>
          <ChevronRight class="w-3 h-3" />
          <span class="text-white">Alaska</span>
        </div>

        {/* Titles */}
        <h1 class="font-serif text-4xl sm:text-5xl lg:text-6xl font-bold text-white mb-4 leading-[1.1] drop-shadow-lg max-w-4xl">
          {post.title || "Bay Trực Thăng Trên Sông Băng Alaska – Chạm Tay Vào Lịch Sử Địa Chất"}
        </h1>
        <h2 class="font-serif text-xl sm:text-3xl text-sky-400 italic mb-10 max-w-3xl drop-shadow-md">
          Chuyến Bay Thay Đổi Góc Nhìn Về Alaska
        </h2>
        <p class="text-white/90 text-base sm:text-lg max-w-2xl leading-relaxed mb-8 hidden md:block drop-shadow-md font-medium">
          Có những hành trình khiến người ta nhớ vì phong cảnh. Có những trải nghiệm khiến người ta nhớ vì cảm xúc. Nhưng cũng có những khoảnh khắc đủ sức thay đổi hoàn toàn cách chúng ta nhìn về một vùng đất. Với Alaska, khoảnh khắc ấy đến khi chiếc trực thăng rời khỏi đường băng nhỏ ở Talkeetna.
        </p>

        {/* Author Meta */}
        <div class="flex flex-wrap items-center gap-6 text-sm text-white/80 border-t border-white/20 pt-6 max-w-3xl">
          <a href={authorData.url} class="flex items-center gap-3 group">
            <img src={authorData.img} alt={authorData.name} class="w-10 h-10 rounded-full border-2 border-white/30 object-cover object-top group-hover:border-sky-400 transition-colors" />
            <span class="font-bold text-white group-hover:text-sky-400 transition-colors flex items-center gap-1">
              {authorData.name} 
              <CheckCircle2 class="w-4 h-4 text-blue-400" />
            </span>
          </a>
          <div class="flex items-center gap-2 bg-white/10 px-4 py-2 rounded-full backdrop-blur-sm border border-white/10">
            <Calendar class="w-4 h-4 opacity-70" />
            <span>{datePrefix} {formattedDate}</span>
          </div>
          <div class="flex items-center gap-2 bg-black/20 px-3 py-1.5 rounded-full backdrop-blur-sm">
            <Clock class="w-4 h-4 text-sky-400" />
            <span>{post.readingTime || 12} phút đọc</span>
          </div>
        </div>

        {/* Badges Line */}
        <div class="flex flex-wrap items-center gap-4 mt-8 pt-6">
          <div class="flex items-center gap-2 text-sm text-white font-medium bg-black/60 backdrop-blur-md px-4 py-2 border border-white/10 rounded-lg shadow-xl">
            <span class="text-sky-400 text-lg">⛰️</span> Thiên Nhiên
          </div>
          <div class="flex items-center gap-2 text-sm text-white font-medium bg-black/60 backdrop-blur-md px-4 py-2 border border-white/10 rounded-lg shadow-xl">
            <span class="text-sky-400 text-lg">🦌</span> Động Vật Hoang Dã
          </div>
          <div class="flex items-center gap-2 text-sm text-white font-medium bg-black/60 backdrop-blur-md px-4 py-2 border border-white/10 rounded-lg shadow-xl">
            <span class="text-sky-400 text-lg">🏕️</span> Văn Hóa Bản Địa
          </div>
        </div>

      </div>
    </section>

    {/* ================= MAIN CONTENT GRID ================= */}
    <div class="max-w-[1600px] mx-auto px-4 sm:px-6 lg:px-12 py-12 lg:py-16">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-start">

        {/* ---------------- LEFT SIDEBAR (TOC) ---------------- */}
        <aside class="hidden lg:block lg:col-span-3 sticky top-24">
          <div class="bg-white rounded-2xl shadow-sm border border-slate-200/60 p-6 overflow-hidden">
            <div class="flex items-center gap-2 font-bold text-slate-800 mb-6 border-l-4 border-sky-500 pl-3 text-sm tracking-wide uppercase">
              Mục lục bài viết
            </div>
            
            <nav class="space-y-1 text-[13.5px] font-medium">
              <a href="#gioi-thieu" class="flex items-center gap-2 text-sky-700 bg-sky-50 px-3 py-2.5 rounded-lg transition-colors">
                <span class="text-sky-500 text-base">🏠</span> Giới thiệu
              </a>
              <a href="#nhung-dieu-chua-biet" class="flex items-center gap-2 text-slate-600 hover:text-sky-700 hover:bg-slate-50 px-3 py-2.5 rounded-lg transition-colors group">
                <span class="w-1.5 h-1.5 rounded-full bg-slate-300 group-hover:bg-sky-400 transition-colors"></span>
                Những Điều Chưa Biết
              </a>
              {tips.map((m) => (
                <a href={"#" + m.id} class="flex items-center gap-2 text-slate-600 hover:text-sky-700 hover:bg-slate-50 px-3 py-2.5 rounded-lg transition-colors group">
                  <span class="w-1.5 h-1.5 rounded-full bg-slate-300 group-hover:bg-sky-400 transition-colors"></span>
                  {m.name}
                </a>
              ))}
              <a href="#ket-luan" class="flex items-center gap-2 text-slate-600 hover:text-sky-700 hover:bg-slate-50 px-3 py-2.5 rounded-lg transition-colors group">
                <span class="w-1.5 h-1.5 rounded-full bg-slate-300 group-hover:bg-sky-400 transition-colors"></span>
                Tổng Kết
              </a>
            </nav>
          </div>
        </aside>

        {/* ---------------- CENTER COLUMN (MAIN CONTENT) ---------------- */}
        <main class="col-span-1 lg:col-span-6 space-y-10">
          
          {/* Quick Overview Stats Bar */}
          <div class="bg-white rounded-2xl shadow-sm border border-slate-200/60 p-6 flex flex-wrap lg:flex-nowrap items-center justify-between gap-4">
            
            <div class="w-full flex items-center justify-between gap-4 mb-2 lg:hidden">
              <span class="font-bold text-slate-800 text-sm border-l-4 border-emerald-500 pl-2 uppercase">Tổng Quan Nhanh</span>
            </div>

            <div class="flex items-center gap-3 w-[48%] lg:w-auto">
              <div class="w-10 h-10 rounded-full bg-emerald-50 flex items-center justify-center text-emerald-600 text-xl border border-emerald-100 shrink-0">🌎</div>
              <div>
                <div class="text-[11px] text-slate-500 font-medium">Vị trí</div>
                <div class="text-[13px] font-bold text-slate-800">Dãy núi Alaska (Alaska Range)</div>
              </div>
            </div>

            <div class="hidden lg:block w-px h-8 bg-slate-200"></div>

            <div class="flex items-center gap-3 w-[48%] lg:w-auto">
              <div class="w-10 h-10 rounded-full bg-blue-50 flex items-center justify-center text-blue-600 text-xl border border-blue-100 shrink-0">🚁</div>
              <div>
                <div class="text-[11px] text-slate-500 font-medium">Phương tiện</div>
                <div class="text-[13px] font-bold text-slate-800">Trực thăng ngắm cảnh</div>
              </div>
            </div>

            <div class="hidden lg:block w-px h-8 bg-slate-200"></div>

            <div class="flex items-center gap-3 w-[48%] lg:w-auto mt-2 lg:mt-0">
              <div class="w-10 h-10 rounded-full bg-rose-50 flex items-center justify-center text-rose-600 text-xl border border-rose-100 shrink-0">🏔️</div>
              <div>
                <div class="text-[11px] text-slate-500 font-medium">Đặc trưng</div>
                <div class="text-[13px] font-bold text-slate-800">Hạ cánh trên sông băng</div>
              </div>
            </div>

            <div class="hidden lg:block w-px h-8 bg-slate-200"></div>

            <div class="flex items-center gap-3 w-[48%] lg:w-auto mt-2 lg:mt-0">
              <div class="w-10 h-10 rounded-full bg-amber-50 flex items-center justify-center text-amber-600 text-xl border border-amber-100 shrink-0">⏱️</div>
              <div>
                <div class="text-[11px] text-slate-500 font-medium">Thời gian khám phá</div>
                <div class="text-[13px] font-bold text-slate-800">Khoảng 1 - 2 tiếng</div>
              </div>
            </div>
          </div>

          {/* Intro Text */}
          <div id="gioi-thieu" class="prose prose-slate max-w-none prose-p:leading-relaxed prose-p:text-[15.5px] prose-p:text-slate-700">
    <p>Chỉ vài phút trước, cả đoàn vẫn còn đứng giữa một thị trấn yên bình với những ngôi nhà gỗ, quán cà phê và ga tàu cổ kính. Vậy mà khi cánh quạt bắt đầu tăng tốc, mọi thứ nhanh chóng lùi lại phía sau. Những con đường biến mất giữa rừng taiga, các dòng sông bắt đầu chia thành vô số nhánh nhỏ và trước mắt mở ra một thế giới chỉ còn núi, băng và thiên nhiên nguyên sơ.</p>
    <p>Nếu <a href="/seward-highway" class="text-sky-600 hover:text-sky-800 underline font-medium">Seward Highway</a> giúp chúng tôi cảm nhận vẻ đẹp của Alaska từ mặt đất, thì chuyến bay trực thăng lại cho thấy bức tranh hoàn chỉnh của vùng đất này. Chỉ từ trên cao mới có thể hiểu vì sao Alaska vẫn được gọi là "<a href="/alaska-mien-bien-cuong-cuoi-cung" class="text-sky-600 hover:text-sky-800 underline font-medium">vùng đất hoang dã cuối cùng của nước Mỹ</a>", nơi thiên nhiên vẫn chiếm ưu thế tuyệt đối trước dấu ấn của con người.</p>
    <p>Đó cũng là lý do, sau khi hành trình kết thúc, nhiều thành viên trong đoàn FIT TOUR đều có chung một nhận xét: đây là trải nghiệm đáng nhớ nhất của cả chuyến đi.</p>
    <figure class="my-6"><img src="https://media.fittour.vn/uploads/truc-thang-temsco-alaska-helicopter-tour.webp" alt="Trực thăng bay ngắm cảnh Alaska" class="w-full rounded-xl shadow-md"><figcaption class="text-center text-sm text-slate-500 italic mt-3">Trực thăng bắt đầu cất cánh từ sân bay nhỏ, mở ra hành trình khám phá Alaska từ một góc nhìn hoàn toàn khác.</figcaption></figure>
  </div>

          <div id="nhung-dieu-chua-biet" class="scroll-mt-28 bg-sky-50/70 border border-sky-200/80 p-6 md:p-8 rounded-2xl my-10 shadow-sm">
    <h2 class="font-serif text-2xl font-bold text-sky-900 mb-5">
      Bạn Có Biết?
    </h2>
    <ul class="space-y-3 text-slate-800 text-[15.5px] leading-relaxed marker:text-sky-500 list-disc pl-5">
      <li><strong>Một Khối Băng Có Thể Dày Gần Một Kilomet:</strong> Một số sông băng lớn ở Alaska có độ dày lên tới hàng trăm mét, thậm chí gần 1.000 mét ở một số khu vực. Đó là lý do chúng đủ sức nghiền nát đá, thay đổi dòng sông và định hình cả cảnh quan trong suốt hàng chục nghìn năm.</li>
      <li><strong>Alaska Có Hơn 100.000 Sông Băng:</strong> Alaska sở hữu số lượng sông băng nhiều hơn bất kỳ bang nào của Hoa Kỳ. Chúng bao phủ khoảng 75.000 km², tạo thành một trong những hệ thống băng hà lớn nhất ngoài hai vùng cực.</li>
      <li><strong>Không Có Hai Chuyến Bay Nào Hoàn Toàn Giống Nhau:</strong> Mây, ánh sáng, lượng băng tan và thời tiết thay đổi liên tục khiến khung cảnh nhìn từ trực thăng mỗi ngày đều khác nhau. Ngay cả các phi công địa phương cũng cho rằng mỗi chuyến bay là một trải nghiệm mới.</li>
    </ul>
  </div>
