---
import { env } from 'cloudflare:workers';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { safeQueryCritical } from '@/lib/db-client';
import { getGlobalSettings } from '@/lib/settingsHelper';
import { MapPin, Info, Users, Clock, Calendar, Compass, Share2, Link as LinkIcon, ChevronRight, CheckCircle2 } from 'lucide-react';
import TourFAQItem from '@/components/tour/TourFAQItem.astro';

const d1Db = env?.dulichcoguu_d1;

// Fetch CMS Data for SEO and Metadata
let post = null;
if (d1Db) {
  try {
    post = await safeQueryCritical(
      d1Db.prepare("SELECT * FROM Post WHERE slug = ? AND (status = 'published' OR status = 'publish')").bind('vi-sao-cac-pharaoh-chon-bo-dong-de-song-va-bo-tay-de-yen-nghi').first<any>(),
      { route: Astro.url.pathname, slug: 'vi-sao-cac-pharaoh-chon-bo-dong-de-song-va-bo-tay-de-yen-nghi', queryType: "fetch_post_by_slug" }
    );
  } catch (e) {
    console.error(e);
  }
}

if (!post) {
  post = {
    title: "Vì sao các pharaoh chọn bờ Đông để sống và bờ Tây để yên nghỉ?",
    excerpt: "Có một cách rất đẹp để nhìn Luxor, thành phố từng là Thebes của Ai Cập cổ đại: bờ Đông là nơi của người sống, còn bờ Tây là nơi của người chết. Khám phá vũ trụ quan Ai Cập cổ đại qua hai bờ sông Nile.",
    featuredImage: "https://media.fittour.vn/uploads/2023/12/Karnak-Temple-Luxor-Ai-Cap-FIT-Tour.webp", // Mock image, you can change
    seoTitle: "Vì sao các pharaoh chọn bờ Đông để sống và bờ Tây để yên nghỉ?",
    seoDesc: "Khám phá lý do thực sự đằng sau việc người Ai Cập cổ đại chọn bờ Đông và bờ Tây sông Nile cho thế giới người sống và người chết.",
    id: 9999,
    author: "Huynh Hieu Travel"
  };
}

const { settings } = await getGlobalSettings();

const seoTitle = post.seoTitle || post.title;
const seoDesc = post.seoDesc || post.excerpt;
const seoImage = post.seoImage || post.featuredImage || 'https://media.fittour.vn/uploads/2023/12/Karnak-Temple-Luxor-Ai-Cap-FIT-Tour.webp';

// --- DATE LOGIC ---
const createdAtStr = post.createdAt || post.publishedAt || new Date().toISOString();
const updatedAtStr = post.updatedAt || createdAtStr;

const createdAt = new Date(createdAtStr.replace(' ', 'T'));
const updatedAt = new Date(updatedAtStr.replace(' ', 'T'));

// Nếu ngày cập nhật sau ngày tạo hơn 1 ngày (86400000ms), coi như là bài được update
const isUpdated = updatedAt.getTime() - createdAt.getTime() > 86400000; 
const displayDate = isUpdated ? updatedAt : createdAt;
const datePrefix = isUpdated ? "Cập nhật:" : "Xuất bản:";

const formattedDate = displayDate.toLocaleDateString('vi-VN', { day: '2-digit', month: '2-digit', year: 'numeric' });
// ------------------

const adminEditUrl = `/admin/posts/edit?id=${post.id}`;

const sections = [
  { id: "bo-tay-khong-chi-danh-cho-nguoi-chet", title: "Bờ Tây Không Hề “Chỉ Dành Cho Người Chết”" },
  { id: "he-thong-vu-tru-quan", title: "“Đông – Tây” Và Vũ Trụ Quan Ai Cập Cổ Đại" },
  { id: "ly-do-tay-quan-trong", title: "Lý Do “Tây” Quan Trọng Hơn Cả Lăng Mộ" },
  { id: "pharaoh-khong-chet-xong-moi-sang-tay", title: "Pharaoh Không “Chết Xong Mới Sang Tây”" },
  { id: "mo-kin-dao-den-hoanh-trang", title: "Bước Ngoặt Lịch Sử: “Mộ Kín Đáo” Và “Đền Hoành Tráng”" },
  { id: "hatshepsut", title: "Đền Hatshepsut: Công Trình Kéo Ra Từ Trong Núi" },
  { id: "ngoai-le-amenhotep-iii", title: "Những Ngoại Lệ Thú Vị Về Quy Tắc \"Đông - Tây\"" },
  { id: "deir-el-medina", title: "Deir el-Medina: Những Người Lặng Lẽ Xây “Đời Sau”" },
  { id: "nguoi-chet-va-song-qua-lai", title: "Sự Giao Thoa Giữa Hai Thế Giới" },
  { id: "tutankhamun", title: "Sự Tình Cờ Của Lịch Sử: Tutankhamun Và Ramesses II" },
  { id: "osiris-ra", title: "Hành Trình Tiếp Diễn Dưới Dòng Sông Nile" },
  { id: "co-that-la-pharaoh", title: "Pharaoh Sống Ở Đông Và An Nghỉ Ở Tây?" },
  { id: "faq", title: "Các Câu Hỏi Thường Gặp (FAQ)" }
];
---

<BaseLayout 
  title={seoTitle} 
  description={seoDesc} 
  image={seoImage}
  adminEditUrl={adminEditUrl}
>
  <div class="bg-[#F8F9FA] text-[#1E293B] font-sans antialiased selection:bg-[#c89845] selection:text-white">

    {/* ================= HERO SECTION ================= */}
    <section class="relative w-full h-[600px] lg:h-[650px] overflow-hidden">
      <div class="absolute inset-0 z-0 bg-slate-900">
        <img src={seoImage} alt={seoTitle} class="w-full h-full object-cover object-center opacity-80" fetchpriority="high" loading="eager" />
        <div class="absolute inset-0 bg-gradient-to-r from-black/80 via-black/60 to-transparent"></div>
        <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-transparent to-transparent"></div>
      </div>

      <div class="relative z-10 max-w-[1600px] mx-auto px-4 sm:px-6 lg:px-12 h-full flex flex-col justify-center pt-20 pb-16">
        
        {/* Breadcrumb */}
        <div class="flex items-center gap-2 text-[13px] text-white/70 font-medium mb-6">
          <a href="/" class="hover:text-white transition-colors">Trang chủ</a>
          <ChevronRight class="w-3 h-3" />
          <a href="/blog" class="hover:text-white transition-colors">Blog</a>
          <ChevronRight class="w-3 h-3" />
          <span class="text-white">Ai Cập Cổ Đại</span>
        </div>

        {/* Titles */}
        <h1 class="font-serif text-4xl sm:text-5xl lg:text-6xl font-bold text-white mb-4 leading-[1.1] drop-shadow-lg max-w-4xl">
          Vì sao các pharaoh chọn bờ Đông để sống và bờ Tây để yên nghỉ?
        </h1>
        <h2 class="font-serif text-xl sm:text-3xl text-amber-400 italic mb-10 max-w-3xl drop-shadow-md">
          Hai Bờ Nile Và Sự Sống Tiếp Diễn Sau Cái Chết
        </h2>
        <p class="text-white/90 text-base sm:text-lg max-w-2xl leading-relaxed mb-8 hidden md:block drop-shadow-md font-medium">
          Khám phá thế giới quan độc đáo của người Ai Cập cổ đại, nơi <strong class="text-amber-400 font-bold">bờ Đông</strong> là nơi hiện diện của sự sống và <strong class="text-amber-400 font-bold">bờ Tây</strong> là sự khởi đầu cho hành trình tái sinh.
        </p>

        {/* Author Meta */}
        <div class="flex flex-wrap items-center gap-6 text-sm text-white/80 border-t border-white/20 pt-6 max-w-3xl">
          <a href="/huynh-hieu" class="flex items-center gap-3 group">
            <img src="https://media.fittour.vn/uploads/huynhhieutravel.webp" alt="Huynh Hieu" class="w-10 h-10 rounded-full border-2 border-white/30 object-cover object-top group-hover:border-amber-400 transition-colors" />
            <span class="font-bold text-white group-hover:text-amber-400 transition-colors flex items-center gap-1">
              {post.author || 'Huynh Hieu Travel'} 
              <CheckCircle2 class="w-4 h-4 text-blue-400" />
            </span>
          </a>
          <div class="flex items-center gap-2 bg-white/10 px-4 py-2 rounded-full backdrop-blur-sm border border-white/10">
            <Calendar class="w-4 h-4 opacity-70" />
            <span>{datePrefix} {formattedDate}</span>
          </div>
          <div class="flex items-center gap-2 bg-black/20 px-3 py-1.5 rounded-full backdrop-blur-sm">
            <Clock class="w-4 h-4 text-amber-400" />
            <span>15 phút đọc</span>
          </div>
        </div>

        {/* Badges Line */}
        <div class="flex flex-wrap items-center gap-4 mt-8 pt-6">
          <div class="flex items-center gap-2 text-sm text-white font-medium bg-black/60 backdrop-blur-md px-4 py-2 border border-white/10 rounded-lg shadow-xl">
            <span class="text-amber-400 text-lg">🏜️</span> Thebes cổ đại
          </div>
          <div class="flex items-center gap-2 text-sm text-white font-medium bg-black/60 backdrop-blur-md px-4 py-2 border border-white/10 rounded-lg shadow-xl">
            <span class="text-amber-400 text-lg">⚱️</span> Lăng mộ Pharaoh
          </div>
          <div class="flex items-center gap-2 text-sm text-white font-medium bg-black/60 backdrop-blur-md px-4 py-2 border border-white/10 rounded-lg shadow-xl">
            <span class="text-amber-400 text-lg">☀️</span> Thần thoại Mặt Trời
          </div>
        </div>

      </div>
    </section>

    {/* ================= MAIN CONTENT GRID ================= */}
    <div class="max-w-[1600px] mx-auto px-4 sm:px-6 lg:px-12 py-12 lg:py-16">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-start">

        {/* ---------------- LEFT SIDEBAR (TOC) ---------------- */}
        <aside class="hidden lg:block lg:col-span-3 sticky top-24">
          <div class="bg-white rounded-2xl shadow-sm border border-slate-200/60 p-6 overflow-hidden">
            <div class="flex items-center gap-2 font-bold text-slate-800 mb-6 border-l-4 border-amber-500 pl-3 text-sm tracking-wide uppercase">
              Mục lục bài viết
            </div>
            
            <nav class="space-y-1 text-[13.5px] font-medium">
              <a href="#gioi-thieu" class="flex items-center gap-2 text-amber-700 bg-amber-50 px-3 py-2.5 rounded-lg transition-colors">
                <span class="text-amber-500 text-base">🏠</span> Giới thiệu
              </a>
              
              <div class="pt-2 pb-1">
                <div class="pl-3 pr-3 space-y-2 max-h-[600px] overflow-y-auto custom-scrollbar">
                  {sections.map((s, i) => (
                    <a href={`#${s.id}`} class="block text-slate-600 hover:text-amber-600 text-[13px] py-1 transition-colors leading-tight">
                      {s.title}
                    </a>
                  ))}
                </div>
              </div>
            </nav>
          </div>
        </aside>

        {/* ---------------- CENTER COLUMN (MAIN CONTENT) ---------------- */}
        <main class="col-span-1 lg:col-span-6 space-y-10">
          
          {/* Quick Overview Stats Bar */}
          <div class="bg-white rounded-2xl shadow-sm border border-slate-200/60 p-6 flex flex-wrap lg:flex-nowrap items-center justify-between gap-4">
            <div class="w-full flex items-center justify-between gap-4 mb-2 lg:hidden">
              <span class="font-bold text-slate-800 text-sm border-l-4 border-amber-500 pl-2 uppercase">Góc Nhìn Khảo Cổ</span>
            </div>

            <div class="flex items-center gap-3 w-[48%] lg:w-auto">
              <div class="w-10 h-10 rounded-full bg-amber-50 flex items-center justify-center text-amber-600 text-xl border border-amber-100 shrink-0">🏛️</div>
              <div>
                <div class="text-[11px] text-slate-500 font-medium">Địa điểm</div>
                <div class="text-[13px] font-bold text-slate-800">Thebes (Luxor)</div>
              </div>
            </div>

            <div class="hidden lg:block w-px h-8 bg-slate-200"></div>

            <div class="flex items-center gap-3 w-[48%] lg:w-auto">
              <div class="w-10 h-10 rounded-full bg-orange-50 flex items-center justify-center text-orange-600 text-xl border border-orange-100 shrink-0">🌅</div>
              <div>
                <div class="text-[11px] text-slate-500 font-medium">Thế giới quan</div>
                <div class="text-[13px] font-bold text-slate-800">Đông Sống - Tây Chết</div>
              </div>
            </div>

            <div class="hidden lg:block w-px h-8 bg-slate-200"></div>

            <div class="flex items-center gap-3 w-[100%] lg:w-auto mt-2 lg:mt-0">
              <div class="w-10 h-10 rounded-full bg-slate-100 flex items-center justify-center text-slate-600 text-xl border border-slate-200 shrink-0">📖</div>
              <div>
                <div class="text-[11px] text-slate-500 font-medium">Chủ đề</div>
                <div class="text-[13px] font-bold text-slate-800">Tôn giáo & Kiến trúc Ai Cập</div>
              </div>
            </div>
          </div>

          {/* Intro Text */}
          <div id="gioi-thieu" class="prose prose-slate max-w-none prose-p:leading-relaxed prose-p:text-[15.5px] prose-p:text-slate-700">
            <p>Có một cách rất đẹp để nhìn Luxor, thành phố từng là Thebes của <a href="/emagazine-ai-cap" class="text-brand-700 hover:text-brand-800 underline font-semibold">Ai Cập cổ đại</a>: bờ Đông là nơi của người sống, còn bờ Tây là nơi của người chết. Đứng bên <a href="/den-tho-kom-ombo" class="text-brand-700 hover:text-brand-800 underline font-semibold">sông Nile</a>, sự tương phản ấy gần như hoàn hảo: một bên là Karnak, Luxor Temple và những trung tâm nghi lễ lớn; bên kia là sa mạc, núi đá, Valley of the Kings, Valley of the Queens và những ngôi mộ nằm sâu trong lòng đất.</p>
            <p>Vậy tại sao phần lớn nghĩa địa hoàng gia lại nằm ở phía Tây? Vì sao người Ai Cập lại chọn chính vùng sa mạc ấy để đào những lăng mộ sâu vào núi? Và tại sao một nền văn minh lại dành nhiều thế hệ để chuẩn bị cho một ngày mà Pharaoh chắc chắn sẽ chết?</p>
            <p>Muốn hiểu điều đó, phải bắt đầu từ thứ mà người Ai Cập nhìn thấy mỗi ngày: <strong>Mặt Trời.</strong></p>
          </div>

          <div class="flex items-center justify-center py-4 opacity-40">
            <div class="w-16 h-px bg-slate-400"></div>
            <span class="mx-4 text-amber-600 text-xl">☥</span>
            <div class="w-16 h-px bg-slate-400"></div>
          </div>

          {/* Content Sections */}
          <div class="prose prose-slate max-w-none prose-p:leading-relaxed prose-p:text-[15.5px] prose-p:text-slate-700 prose-headings:font-serif prose-h2:text-2xl prose-h2:font-bold prose-h2:text-slate-900 prose-h2:border-l-4 prose-h2:border-amber-500 prose-h2:pl-4 prose-h2:mt-12 prose-h2:mb-6 prose-strong:text-slate-900 prose-blockquote:border-l-4 prose-blockquote:border-amber-400 prose-blockquote:bg-amber-50 prose-blockquote:px-4 prose-blockquote:py-2 prose-blockquote:rounded-r-lg prose-blockquote:text-slate-700 prose-blockquote:italic">
            
            <h2 id="bo-tay-khong-chi-danh-cho-nguoi-chet" class="scroll-mt-28">Bờ Tây Không Hề “Chỉ Dành Cho Người Chết”</h2>
            <p>Thebes (hay Waset theo tiếng Ai Cập cổ) phát triển dọc theo hai bờ Nile. Nếu bờ Đông sầm uất với các khu đô thị và đền thờ khổng lồ như Karnak, Luxor, thì bờ Tây lại vắng vẻ, tĩnh lặng, nổi bật với hệ thống nghĩa địa hoàng gia, lăng mộ quý tộc và đền tang lễ.</p>
            <p>Sự phân chia này trước hết xuất phát từ địa hình. Bờ Đông là dải đất phù sa màu mỡ, rất lý tưởng để cư trú và canh tác. Ngược lại, đi về phía Tây, màu xanh nhanh chóng nhường chỗ cho sa mạc khô cằn và núi đá. Địa hình khô ráo, cách biệt khiến phía Tây trở thành nơi hoàn hảo để bảo quản xác ướp và đục lăng mộ sâu vào vách đá.</p>
            <figure class="my-8">
              <img src="https://media.fittour.vn/uploads/2023/01/doan-khach-fit-tour-tham-quan-luxor.webp" alt="Đoàn khách tham quan Luxor" width="1200" height="800" class="w-full rounded-xl object-cover shadow-sm" loading="lazy" />
              <figcaption class="text-center text-[13.5px] text-slate-500 mt-3 italic">Bờ Đông của Luxor xanh tươi đầy sức sống, nơi tập trung phần lớn dân cư.</figcaption>
            </figure>
            <p>Dù vậy, gọi bờ Tây là “đất của người chết” theo nghĩa đen thì chưa hẳn đúng.</p>
            <p>Bằng chứng rõ nhất là <strong>Deir el-Medina</strong>, khu làng của những thợ xây lăng mộ. Họ sống ngay giữa lòng nghĩa trang, có nhà cửa, gia đình, công việc và một cộng đồng gắn kết. Hay như Pharaoh Amenhotep III còn xây hẳn cung điện Malqata tại bờ Tây để phục vụ đời sống, chứ không phải để làm tang lễ.</p>
            <p>Nói một cách chính xác hơn: Bờ Đông là trung tâm sinh hoạt của cộng đồng; còn bờ Tây là không gian tập trung đặc biệt cho các hoạt động tưởng niệm người đã khuất.</p>

            <h2 id="he-thong-vu-tru-quan" class="scroll-mt-28">“Đông – Tây” Và Vũ Trụ Quan Ai Cập Cổ Đại</h2>
            <p>Nhiều người thường giải thích đơn giản rằng: <em>“Mặt trời lặn ở phía Tây nên họ xây mộ ở phía Tây.”</em></p>
            <p>Sự thật sâu xa hơn thế. Người Ai Cập quan niệm hành trình của Mặt Trời mỗi ngày là: <strong>mọc → đi qua bầu trời → lặn → bước vào thế giới bên kia → tái sinh vào bình minh hôm sau.</strong></p>
            <p>Chúng ta hay quên mất giai đoạn giữa: Mặt Trời lặn không có nghĩa là biến mất hoàn toàn. Nó chỉ đang thực hiện một hành trình khác dưới cõi âm, trước khi rực rỡ trở lại vào sáng hôm sau. Vì vậy, cái chết cũng không phải là dấu chấm hết, mà chỉ là <strong>một chu kỳ chuyển tiếp</strong>.</p>
            <figure class="my-8">
              <img src="https://media.fittour.vn/uploads/2023/01/du-khach-viet-di-thuyen-kham-pha-song-nile-ai-cap.webp" alt="Du thuyền trên sông Nile" width="1200" height="800" class="w-full rounded-xl object-cover shadow-sm" loading="lazy" />
              <figcaption class="text-center text-[13.5px] text-slate-500 mt-3 italic">Hành trình của Mặt Trời băng qua bầu trời và dòng sông Nile là trung tâm của vũ trụ quan Ai Cập.</figcaption>
            </figure>
            <p>Đó là lý do người Ai Cập không chỉ “chôn xác”. Họ xây mộ, chuẩn bị đồ tùy táng, viết các văn bản chỉ dẫn đường đi nước bước để giúp người chết tiếp tục tồn tại và tái sinh. Với họ, phương Tây không đơn giản là nơi Mặt Trời lặn, mà là <strong>nơi Mặt Trời bắt đầu hành trình tái sinh.</strong> Và các Pharaoh cũng cần một hành trình như vậy.</p>

            <h2 id="ly-do-tay-quan-trong" class="scroll-mt-28">Lý Do “Tây” Quan Trọng Hơn Cả Lăng Mộ</h2>
            <p>Khi hiểu theo cách đó, bờ Tây Thebes hiện lên với một ý nghĩa lớn lao hơn. Ở đó không chỉ có mộ phần, mà còn có cả một <em>cảnh quan nghi lễ (ritual landscape)</em> kết nối chặt chẽ với các đền thờ ở bờ Đông.</p>
            <p>Karnak và Luxor ở bờ Đông là nơi vương quyền gắn kết với thần linh. Còn đền tang lễ ở bờ Tây giúp duy trì quyền lực đó sau khi nhà vua băng hà.</p>
            <p>Hai bờ sông Nile không hề bị chia cắt. Người sống, tư tế, và lễ vật liên tục di chuyển từ Đông sang Tây. Ngay cả các vị thần cũng thường xuyên “qua sông” trong những dịp lễ hội. Cả hai là những mảnh ghép của cùng một cỗ máy tôn giáo và chính trị khổng lồ.</p>
            <p class="text-[14px] text-slate-500 italic mt-2">(Xem thêm: <a href="https://academic.oup.com/book/47221/chapter-abstract/422374227" target="_blank" rel="noopener noreferrer" class="hover:text-amber-700 underline underline-offset-2">Nghiên cứu kiến trúc đền tang lễ Thebes - UCL</a> & <span class="hover:text-amber-700 underline underline-offset-2 cursor-help" title="University of Heidelberg - Temples of Millions of Years">Cảnh quan nghi lễ Thebes - ĐH Heidelberg</span>)</p>

            <h2 id="pharaoh-khong-chet-xong-moi-sang-tay" class="scroll-mt-28">Pharaoh Không “Chết Xong Mới Sang Tây”</h2>
            <p>Có một chi tiết hay bị nhầm lẫn: các đền tang lễ ở bờ Tây không phải là nơi đặt thi hài Pharaoh. Lăng mộ (nơi giấu xác) và đền tang lễ (nơi thờ cúng) là hai công trình tách biệt.</p>
            <p>Khi một Pharaoh qua đời, công việc dành cho ông chưa hề kết thúc. Lăng mộ có thể được giấu kín sâu trong núi đá, nhưng đền tang lễ vẫn sừng sững bên rìa sa mạc. Tại đó, các tư tế vẫn hoạt động, lễ vật vẫn được dâng lên, và tên tuổi nhà vua vẫn được xướng lên mỗi ngày.</p>
            <p>Bờ Tây không phải là thành phố chết, mà là nơi người sống miệt mài làm việc để duy trì sự tồn tại cho người đã khuất.</p>

            <h2 id="mo-kin-dao-den-hoanh-trang" class="scroll-mt-28">Bước Ngoặt Lịch Sử: “Mộ Kín Đáo” Và “Đền Hoành Tráng”</h2>
            <p>Vào thời Tân Vương quốc, cách xây lăng mộ thay đổi hoàn toàn. Thay vì gom chung mọi thứ vào một <a href="/kim-tu-thap-giza" class="text-brand-700 hover:text-brand-800 underline font-semibold">kim tự tháp khổng lồ</a>, các Pharaoh bắt đầu tách riêng nơi chôn cất và đền thờ. Thutmose I được xem là vị vua tiên phong đục lăng mộ sâu vào Thung lũng các vị Vua (Valley of the Kings).</p>
            <p>Sự phân tách này mang ý nghĩa cực kỳ thú vị: <strong>Xác của Pharaoh phải được giấu thật kín, nhưng quyền uy và tên tuổi thì phải được phô bày thật hoành tráng.</strong></p>
            <figure class="my-8">
              <img src="https://media.fittour.vn/uploads/2023/01/du-khach-chup-anh-o-thung-lung-cua-cac-vi-vua-o-luxor.webp" alt="Thung lũng các vị Vua ở Luxor" width="1200" height="800" class="w-full rounded-xl object-cover shadow-sm" loading="lazy" />
              <figcaption class="text-center text-[13.5px] text-slate-500 mt-3 italic">Thung lũng các vị Vua (Valley of the Kings) – nơi cất giấu lăng mộ sâu trong những khe núi khô cằn để tránh nạn trộm mộ.</figcaption>
            </figure>
            <p>Nguyên nhân thực tế nhất đương nhiên là nạn trộm mộ. Một kim tự tháp to lớn chẳng khác nào tấm biển "ở đây có vàng". Việc giấu lăng mộ vào sâu trong khe núi giúp bảo vệ thi hài và kho báu tốt hơn. Nhưng càng giấu kín xác bao nhiêu, họ lại càng phải xây đền tang lễ to lớn bấy nhiêu để đảm bảo tên tuổi nhà vua không bị lãng quên.</p>

            <h2 id="hatshepsut" class="scroll-mt-28">Đền Hatshepsut: Công Trình Kéo Ra Từ Trong Núi</h2>
            <p>Ví dụ điển hình nhất cho sự kết hợp giữa kiến trúc và cảnh quan chính là đền tang lễ của nữ Pharaoh Hatshepsut tại Deir el-Bahari.</p>
            <p>Với các thềm bậc thang và hàng cột tạc thẳng vào vách núi, ngôi đền như hòa làm một với địa hình tự nhiên. Nó không giống một công trình được xây cạnh núi, mà giống như <strong>được kéo ra từ lòng núi</strong>.</p>
            <p>Cách quy hoạch này minh chứng cho việc người Ai Cập không xây cất ngẫu nhiên. Lăng mộ, đền thờ, sa mạc và núi đá được tính toán kỹ lưỡng để cùng nhau tạo ra một không gian thiêng liêng, phục vụ cho đời sống vĩnh hằng của nhà vua.</p>

            <h2 id="ngoai-le-amenhotep-iii" class="scroll-mt-28">Những Ngoại Lệ Thú Vị Về Quy Tắc "Đông - Tây"</h2>
            <p>Nếu cứ đinh ninh "Pharaoh sống ở Đông, chết ở Tây", chúng ta sẽ bỏ lỡ những ngoại lệ lịch sử khá đặc biệt.</p>
            <p>Đầu tiên là <strong>Amenhotep III</strong>. Việc ông xây cung điện Malqata ở ngay bờ Tây chứng tỏ đây không phải là "vùng cấm" đối với người sống. Bờ Tây vẫn có cư dân, thợ thủ công, hoạt động kinh tế bình thường; chỉ là quy mô của các công trình tang lễ ở đây quá lớn, làm lu mờ đi những thứ khác.</p>
            <p>Tiếp đến, Thebes không phải lúc nào cũng là thủ đô. Vào cuối thời Tân Vương quốc, trung tâm chính trị dịch chuyển về phía Bắc (gần vùng Delta). Dù các Pharaoh không còn trực tiếp sống và trị vì tại Thebes, họ vẫn chọn nơi đây để xây đền tang lễ. Điều này cho thấy Thebes đóng vai trò đặc biệt quan trọng đối với đời sống <em>sau khi chết</em> của nhà vua, bất kể thủ đô hành chính đang nằm ở đâu.</p>
            <p class="text-[14px] text-slate-500 italic mt-2">(Xem thêm: <a href="https://www.metmuseum.org/essays/egyptian-tombs-life-along-the-nile" target="_blank" rel="noopener noreferrer" class="hover:text-amber-700 underline underline-offset-2">Lịch sử lăng mộ và đời sống Tân Vương quốc - The Met</a>)</p>

            <h2 id="deir-el-medina" class="scroll-mt-28">Deir el-Medina: Những Người Lặng Lẽ Xây “Đời Sau”</h2>
            <p>Khu làng Deir el-Medina là minh chứng rõ nhất cho mối liên kết giữa người sống và người chết. Những thợ xây tại đây đã dành cả đời để đục đá, vẽ bích họa, tạc tượng cho các lăng mộ hoàng gia.</p>
            <p>Điều đáng nói là họ không chỉ làm việc cho vua, mà còn tự xây mộ cho chính mình. Họ để lại nhà cửa, vật dụng, giấy tờ ghi chép sinh hoạt thường ngày. Nhờ những con người lao động thầm lặng này, chúng ta mới có được bức tranh chân thực nhất về đời sống xã hội Ai Cập cổ đại, nằm ngay giữa lòng một nghĩa địa hoàng gia.</p>
            <figure class="my-8">
              <img src="https://media.fittour.vn/uploads/2023/01/nhung-hinh-ve-ky-tu-co-dai-ai-cap.webp" alt="Hình vẽ ký tự cổ đại Ai Cập" width="1200" height="800" class="w-full rounded-xl object-cover shadow-sm" loading="lazy" />
              <figcaption class="text-center text-[13.5px] text-slate-500 mt-3 italic">Những bức bích họa trong lăng mộ trở thành kho tàng tư liệu chân thực nhất về đời sống Ai Cập.</figcaption>
            </figure>
            <p>Hơn thế nữa, bờ Tây không chỉ ưu ái riêng Pharaoh. Các quý tộc, quan chức, tư tế đều có lăng mộ riêng. Bức tường trong mộ họ vẽ lại cảnh làm nông, săn bắn, dự tiệc... Vô tình, <em>những ngôi mộ dành cho người chết lại trở thành kho tư liệu quý giá nhất về cách người Ai Cập đã sống.</em></p>
            <p class="text-[14px] text-slate-500 italic mt-2">(Xem thêm: <a href="https://www.britishmuseum.org/sites/default/files/2020-10/R61_Egyptian_life_and_death_large_print_guide.pdf" target="_blank" rel="noopener noreferrer" class="hover:text-amber-700 underline underline-offset-2">Tư liệu về đời sống quanh lăng mộ Nebamun - British Museum</a>)</p>

            <h2 id="nguoi-chet-va-song-qua-lai" class="scroll-mt-28">Sự Giao Thoa Giữa Hai Thế Giới</h2>
            <p>Đông và Tây không hề đóng kín. Người Ai Cập có những nghi lễ vượt sông vô cùng nhộn nhịp, điển hình là <strong>Lễ hội Thung lũng Đẹp (Beautiful Festival of the Valley)</strong>. Trong dịp này, tượng thần từ đền Karnak (bờ Đông) được rước sang bờ Tây để thực hiện các nghi thức tưởng niệm và tụ họp cộng đồng.</p>
            <figure class="my-8">
              <img src="https://media.fittour.vn/uploads/2023/01/du-khach-chup-anh-check-in-o-den-karnak.webp" alt="Đền Karnak" width="1200" height="800" class="w-full rounded-xl object-cover shadow-sm" loading="lazy" />
              <figcaption class="text-center text-[13.5px] text-slate-500 mt-3 italic">Đền Karnak sừng sững ở bờ Đông, điểm xuất phát của những chuyến rước tượng thần vượt sông Nile sang bờ Tây.</figcaption>
            </figure>
            <p>Thần linh, tư tế, và người dân tấp nập qua lại. Các nghi lễ đã xóa nhòa ranh giới giữa sự sống và cái chết, nối liền hai bên bờ sông thành một chu trình khép kín.</p>

            <h2 id="tutankhamun" class="scroll-mt-28">Sự Tình Cờ Của Lịch Sử: Tutankhamun Và Ramesses II</h2>
            <p>Trong số các Pharaoh nằm lại Thebes, <strong>Tutankhamun</strong> nổi tiếng nhất với thế giới hiện đại nhờ lăng mộ nguyên vẹn do Howard Carter phát hiện năm 1922. Tuy nhiên, vị vua trẻ này không nắm nhiều thực quyền lúc sinh thời. Lăng mộ của ông cũng khá khiêm tốn. Sự vĩ đại của ông trong mắt hậu thế lại đến từ một sự may mắn của khảo cổ học.</p>
            <p>Ở một thái cực khác, <strong>Ramesses II</strong> lại chọn cách phô trương để bất tử. Tên ông xuất hiện ở mọi nơi, những pho tượng khổng lồ sừng sững, và đền Ramesseum ở bờ Tây Thebes là một trong những công trình đồ sộ nhất lịch sử. Ramesses II hiểu rõ một nguyên tắc cốt lõi: <em>Bất tử không chỉ là giữ lại thể xác. Chỉ cần tên tuổi còn được xướng lên, hình ảnh còn được nhìn thấy, thì người đó vẫn chưa thực sự chết đi.</em></p>

            <h2 id="osiris-ra" class="scroll-mt-28">Hành Trình Tiếp Diễn Dưới Dòng Sông Nile</h2>
            <p>Câu chuyện lại xoay về Mặt Trời. Thần Ra tượng trưng cho chu kỳ ngày đêm, còn thần Osiris đại diện cho sự phục sinh. Sự kết hợp này mang một thông điệp mạnh mẽ: Sống và chết không hề đối lập, mà là hai nửa của vòng tuần hoàn.</p>
            <p>Đó là lý do những văn bản cổ trong lăng mộ không chỉ để trang trí. Chúng là cẩm nang dẫn đường, giúp người chết vượt qua thử thách dưới cõi âm. Lăng mộ không phải căn phòng yên nghỉ cuối cùng, mà là cánh cửa bước vào hành trình mới.</p>
            <p>Vì vậy, sẽ khá phiến diện nếu chỉ gọi bờ Tây là "thành phố của người chết". Nó thực chất là một <strong>hệ thống hạ tầng khổng lồ phục vụ cho sự bất tử</strong> – bao gồm lăng mộ, đền thờ, tư tế, thợ thủ công, và những nghi thức tưởng nhớ không ngừng nghỉ.</p>

            <h2 id="co-that-la-pharaoh" class="scroll-mt-28">Pharaoh Sống Ở Đông Và An Nghỉ Ở Tây?</h2>
            <p>Câu nói ấy là một phép ẩn dụ đẹp về thế giới quan Thebes, chứ không phải quy tắc quy hoạch đô thị. Bờ Đông là nơi phô diễn quyền uy trước thần linh và bá tánh. Còn bờ Tây là bến đỗ để cơ thể nhà vua đi vào lòng núi, và cũng là nơi duy trì sự hiện diện của ông mãi mãi về sau.</p>
            <p>Hai bờ sông Nile phản chiếu trọn vẹn một chu trình sống. Giống như Mặt Trời mọc đằng Đông, lặn đằng Tây rồi lại hồi sinh. Người Ai Cập muốn Pharaoh của họ cũng thế: Băng hà nhưng không lu mờ.</p>
            <p>Bờ Tây sông Nile trở nên thiêng liêng không phải vì nó là điểm dừng chân cuối cùng, mà bởi người Ai Cập tin rằng, <strong>đó là bến đỗ để bắt đầu một đời sống khác.</strong></p>


