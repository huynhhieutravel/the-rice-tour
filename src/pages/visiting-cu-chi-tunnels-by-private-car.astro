                      <td class="p-4 font-bold text-slate-900">9-Seat Limousine Van</td>
                      <td class="p-4 text-center font-medium">4–7 guests</td>
                      <td class="p-4">Larger families, additional space</td>
                      <td class="p-4 text-right font-medium text-slate-700">Per vehicle</td>
                    </tr>
                    <tr class="hover:bg-slate-50/80 transition-colors">
