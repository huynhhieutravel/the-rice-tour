---
import { env } from 'cloudflare:workers';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { safeQueryCritical } from '@/lib/db-client';
import { getGlobalSettings } from '@/lib/settingsHelper';
import JsonLdSchema from '@/components/seo/JsonLdSchema.astro';

// --- SSR D1 DATABASE QUERY ---
const currentSlug = 'visiting-cu-chi-tunnels-by-private-car';

const d1Db = env?.dulichcoguu_d1 || (Astro.locals as any)?.runtime?.env?.dulichcoguu_d1;
let post: any = null;
try {
  if (d1Db) {
    post = await safeQueryCritical(
      d1Db.prepare("SELECT * FROM Post WHERE slug = ? AND (status = 'published' OR status = 'publish')").bind(currentSlug).first<any>(),
      { route: Astro.url.pathname, slug: currentSlug, queryType: "fetch_post_by_slug" }
    );
  }
} catch (e) {
  console.warn('[D1 Query Warning] visiting-cu-chi-tunnels-by-private-car:', e);
}

// Fallback metadata if D1 is not yet populated
if (!post) {
  post = {
    id: 19808,
    title: 'Visiting Cu Chi Tunnels By Private Car: Costs, Routes & What To Expect',
    slug: currentSlug,
    excerpt: 'A comprehensive 2026 guide to private car costs, routes, Grab options, vehicle choices, and choosing between Ben Dinh and Ben Duoc from Saigon.',
    featuredImage: 'https://media.thericetour.com/uploads/two-girls-posing-rusted-tank-cu-chi-tunnels-the-rice.webp',
    readingTime: 12,
    author: 'The Rice Tour Editorial',
    createdAt: '2026-09-16T08:00:00.000Z',
    publishedAt: '2026-09-16T08:00:00.000Z',
    updatedAt: '2026-09-16T08:00:00.000Z'
  };
}

const { settings } = await getGlobalSettings();

const pageTitle = post?.title || 'Visiting Cu Chi Tunnels By Private Car: Costs, Routes & What To Expect';
const pageDesc = post?.excerpt || 'A comprehensive 2026 guide to private car costs, routes, Grab options, vehicle choices, and choosing between Ben Dinh and Ben Duoc from Saigon.';

const seoTitle = post?.seoTitle || post?.metaTitle || `${pageTitle} | The Rice Tour`;
const seoDesc = post?.seoDescription || 'Private car to Cu Chi Tunnels: 2026 price ranges, route planning, Grab feasibility, vehicle choices, Ben Dinh vs Ben Duoc, and practical visitor tips.';
const seoImage = post?.ogImage || post?.featuredImage || 'https://media.thericetour.com/uploads/two-girls-posing-rusted-tank-cu-chi-tunnels-the-rice.webp';

// --- DATE LOGIC (E-E-A-T Compliant) ---
const createdAtStr = post.createdAt || post.publishedAt || '2026-09-16T08:00:00.000Z';
const updatedAtStr = post.updatedAt || '2026-09-16T08:00:00.000Z';

const createdAt = new Date(createdAtStr.replace(' ', 'T'));
const updatedAt = new Date(updatedAtStr.replace(' ', 'T'));

const isUpdated = updatedAt.getTime() - createdAt.getTime() > 86400000;
const displayDate = isUpdated ? updatedAt : createdAt;
const datePrefix = isUpdated ? "Updated:" : "Published:";
const formattedDate = displayDate.toLocaleDateString('en-US', { day: 'numeric', month: 'long', year: 'numeric' });

// --- AUTHOR LOGIC ---
const authorMap: Record<string, any> = {
  "The Rice Tour Editorial": {
    name: "The Rice Tour Editorial",
    url: "/about-us",
    img: "https://media.thericetour.com/uploads/the-rice-tour-editorial-avatar.webp"
  },
  "Huynh Hieu Travel": {
    name: "Huynh Hieu Travel",
    url: "/about-us",
    img: "https://media.thericetour.com/uploads/huynhhieutravel.webp"
  }
};
const authorData = authorMap[post.author] || authorMap["The Rice Tour Editorial"];

const adminEditUrl = post.id && post.id !== 19808 ? `/admin/posts/edit?id=${post.id}` : '#';

// TOC Navigation Structure
const toc = [
  { id: "gioi-thieu", title: "Introduction", icon: "🏠" },
  { id: "is-a-private-car-worth-it", title: "Is A Private Car Worth It?", icon: "💎" },
  { id: "private-car-costs-2026", title: "How Much Does A Private Car Cost in 2026?", icon: "💵" },
  { id: "which-vehicle-should-you-choose", title: "Choosing The Right Vehicle", icon: "🚗" },
  { id: "route-from-hcmc-to-cu-chi", title: "How Far Is Cu Chi From Saigon?", icon: "🗺️" },
  { id: "what-time-should-you-leave", title: "What Time Should You Leave? (Crowd Strategies)", icon: "⏰" },
  { id: "ben-dinh-or-ben-duoc", title: "Ben Dinh vs. Ben Duoc: Neither Is Fake", icon: "🌿" },
  { id: "are-tunnels-original", title: "Is Cu Chi Actually Authentic? (Preserved vs. Untouched)", icon: "🏛️" },
  { id: "underground-village", title: "What Is The Cu Chi 'Underground Village'?", icon: "🏘️" },
  { id: "wartime-cassava-experience", title: "What Did People Eat? (Cassava Tasting)", icon: "🍠" },
  { id: "how-tight-are-the-tunnels", title: "What To Expect Inside: Optional Crawl & Size", icon: "🛡️" },
  { id: "can-you-go-by-grab", title: "Can You Visit Cu Chi Without A Tour? (Grab & Independent)", icon: "🧭" },
  { id: "what-is-usually-included", title: "What Is Included In A Private Car?", icon: "📋" },
  { id: "what-to-wear-and-bring", title: "What Should You Wear & Bring?", icon: "🎒" },
  { id: "shooting-range-context", title: "Note on the On-Site Shooting Range", icon: "🎯" },
  { id: "combine-with-another-attraction", title: "Can You Combine Cu Chi With Other Attractions?", icon: "🚫" },
  { id: "private-car-vs-shared-tour", title: "Private Car vs. Shared Tour Comparison", icon: "⚖️" },
  { id: "practical-private-car-checklist", title: "Practical Booking Checklist", icon: "✅" },
  { id: "frequently-asked-questions", title: "Frequently Asked Questions (FAQ)", icon: "💡" },
  { id: "epilogue", title: "Epilogue: Control Over Speed", icon: "✨" }
];

// SSR JSON-LD Schemas
const currentOrigin = 'https://thericetour.com';
const canonicalUrl = `${currentOrigin}/${currentSlug}`;

const breadcrumbSchema = {
  items: [
    { name: "Home", url: `${currentOrigin}/` },
    { name: "Travel Guides", url: `${currentOrigin}/blog` },
    { name: pageTitle, url: canonicalUrl }
  ]
};

const faqSchema = {
  questions: [
    {
      question: "How much does a private car to Cu Chi Tunnels cost in 2026?",
      answer: "Private-car pricing is quoted per vehicle round-trip. Typical 2026 market ranges are approximately 1.0M–1.7M VND (~$40–$68 USD) for a 4-seat sedan, 1.1M–2.0M VND (~$44–$80 USD) for a 7-seat SUV/MPV, and 1.2M–2.2M+ VND (~$48–$88+ USD) for a 9-seat VIP limousine van. Rates vary based on pickup district, waiting time, tolls, and destination sector."
    },
    {
      question: "Can I go to Cu Chi Tunnels by Grab?",
      answer: "Yes, independent travel by Grab is possible. Outbound rides from downtown Ho Chi Minh City are readily available. Grab can also work for the return journey, but availability depends on time and location; while some travelers report booking a return car within 4 to 10 minutes even from Ben Duoc, others prefer arranging a waiting driver for predictability and peace of mind."
    },
    {
      question: "Can you visit Cu Chi Tunnels without a tour?",
      answer: "Yes. You can visit independently by private car, taxi, Grab, or public bus. For international visitors, the official ticket total is 135,000 VND per person (35,000 VND for site admission plus 100,000 VND for the guide/service fee). On-site English-speaking guides are provided upon arrival to escort visitors along designated trails and tunnels."
    },
    {
      question: "Do I need a guide at Cu Chi Tunnels?",
      answer: "Having a guide is strongly recommended because Cu Chi is an archaeological and historical relic where physical structures require narrative context. The standard international entrance ticket includes on-site guiding service upon arrival. If you book a dedicated private tour with a licensed guide in your vehicle, you receive continuous historical commentary throughout the drive and visit."
    },
    {
      question: "Ben Dinh or Ben Duoc: which one should I choose?",
      answer: "Ben Dinh is the more convenient choice for a first visit, especially if your priority is a shorter drive from central Ho Chi Minh City (~50 km). Ben Duoc takes longer to reach (~70 km) but offers a larger heritage setting, including the Ben Duoc Memorial Temple and additional reconstructed spaces. Neither site should simply be labelled 'authentic' or 'fake'—both preserve three-tier vertical structures and have been conserved for visitor safety."
    },
    {
      question: "Are Cu Chi Tunnels authentic or adapted for tourists?",
      answer: "The historical Cu Chi network once extended for hundreds of kilometres; today, approximately 4 km are preserved across Ben Duoc and Ben Dinh. Passageways open to visitors have been stabilized, repaired, and widened in places for safety. This does not make the site inauthentic—it represents the natural difference between a conserved heritage monument and an untouched, collapsing wartime trench."
    },
    {
      question: "How narrow are Cu Chi Tunnels? (Do I have to crawl?)",
      answer: "Constricted sections can be as narrow as 40 cm wide and 73 cm high. However, crawling underground is completely optional. Much of the visit takes place above ground along shaded forest paths with historical exhibits, traps, and reconstructed buildings. If you are tall (6 ft+), broad-shouldered, or claustrophobic, you can easily walk alongside without going underground."
    },
    {
      question: "How long does Cu Chi Tunnels take door-to-door?",
      answer: "Plan around 5 to 6 hours for a typical half-day visit from central Ho Chi Minh City. This typically comprises 1.5 to 2 hours of road travel each way and 2 to 3 hours exploring the historical grounds."
    },
    {
      question: "What should I wear and bring to Cu Chi Tunnels?",
      answer: "Wear comfortable walking shoes with good grip and lightweight, breathable clothing that allows you to bend or squat easily. Choose darker clothes that won't easily stain from dusty clay if you plan to crawl. Bring drinking water, sunscreen, and insect repellent for the outdoor jungle paths."
    },
    {
      question: "Is Cu Chi Tunnels worth visiting by private car?",
      answer: "A private car is worthwhile if you value schedule control, privacy, and direct hotel-to-site travel. It allows you to leave early (06:30–07:00 AM) to arrive ahead of tour bus crowds, skip commercial handicraft detours, and return at your own pace. For groups of 2 to 7 people, the cost per person is often comparable to or only slightly higher than joining a shared tour."
    },
    {
      question: "Is Cu Chi Tunnels a UNESCO World Heritage Site?",
      answer: "Not yet. Vietnam officially submitted the Cu Chi Tunnels to UNESCO's World Heritage Tentative List on July 15, 2026, under cultural criteria (iv) and (v). The Tentative List is a formal inventory of properties an authority intends to consider for future nomination."
    }
  ]
};
---

<BaseLayout 
  title={seoTitle} 
  description={seoDesc} 
  image={seoImage}
  canonical={canonicalUrl}
  preloadImages={[seoImage]}
  adminEditUrl={adminEditUrl}
  lang="en"
  ogType="article"
>
  <Fragment slot="schema">
    <JsonLdSchema type="breadcrumb" data={breadcrumbSchema} />
    <JsonLdSchema type="faq" data={faqSchema} />
  </Fragment>

  <div class="bg-[#F8F9FA] text-[#1E293B] font-sans antialiased selection:bg-[#F7931E] selection:text-white">

    {/* ================= HERO SECTION ================= */}
    <section class="relative w-full min-h-[580px] lg:min-h-[660px] overflow-hidden flex flex-col justify-center pt-32 pb-20">
      <div class="absolute inset-0 z-0 bg-slate-950">
        <img 
          src={seoImage} 
          alt={pageTitle} 
          class="w-full h-full object-cover object-center opacity-85" 
          width="1280" 
          height="720"
          fetchpriority="high" 
          loading="eager" 
          decoding="async" 
        />
        <div class="absolute inset-0 bg-gradient-to-r from-black/80 via-black/55 to-black/30"></div>
        <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/30 to-transparent"></div>
      </div>

      <div class="relative z-10 max-w-[1600px] mx-auto px-4 sm:px-6 lg:px-12 w-full">
        
        {/* Breadcrumb - Standard 3-level breadcrumb */}
        <div class="flex items-center gap-2 text-[13px] text-white/70 font-medium mb-6 flex-wrap">
          <a href="/" class="hover:text-white transition-colors">Home</a>
          <svg class="w-3 h-3 text-white/40" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
          <a href="/blog" class="hover:text-white transition-colors">Travel Guides</a>
          <svg class="w-3 h-3 text-white/40" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
          <span class="text-white font-semibold line-clamp-1">{pageTitle}</span>
        </div>

        {/* Titles */}
        <h1 class="font-serif text-3xl sm:text-4xl lg:text-5xl xl:text-6xl font-bold text-white mb-4 leading-[1.15] drop-shadow-lg max-w-5xl">
          {pageTitle}
        </h1>
        <h2 class="font-serif text-lg sm:text-2xl lg:text-3xl text-amber-400 italic mb-8 max-w-4xl drop-shadow-md font-medium">
          {pageDesc}
        </h2>

        {/* Author / Date / Time Row */}
        <div class="flex flex-wrap items-center gap-4 sm:gap-6 text-sm text-white/80 border-t border-white/20 pt-6 max-w-3xl">
          <a href={authorData.url} class="flex items-center gap-3 group">
            <div class="w-10 h-10 rounded-full border-2 border-white/30 bg-amber-500/30 flex items-center justify-center font-serif text-amber-300 font-bold text-lg group-hover:border-amber-400 transition-colors">
              R
            </div>
            <span class="font-bold text-white group-hover:text-amber-400 transition-colors flex items-center gap-1.5">
              {authorData.name} 
              <svg class="w-4 h-4 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            </span>
          </a>
          
          <div class="flex items-center gap-2 bg-white/10 px-4 py-2 rounded-full backdrop-blur-sm border border-white/10">
            <svg class="w-4 h-4 opacity-70" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
            <span>{datePrefix} {formattedDate}</span>
          </div>

          <div class="flex items-center gap-2 bg-black/40 px-4 py-2 rounded-full backdrop-blur-sm border border-white/10">
            <svg class="w-4 h-4 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            <span>{post.readingTime || 12} min read</span>
          </div>
        </div>

        {/* Badges */}
        <div class="flex flex-wrap gap-3 mt-8">
          <div class="flex items-center gap-2 text-xs sm:text-sm text-white font-medium bg-black/60 backdrop-blur-md px-3.5 py-2 border border-white/10 rounded-lg shadow-xl">
            <span class="text-amber-400 text-base">🚗</span> Direct Hotel Transfer
          </div>
          <div class="flex items-center gap-2 text-xs sm:text-sm text-white font-medium bg-black/60 backdrop-blur-md px-3.5 py-2 border border-white/10 rounded-lg shadow-xl">
            <span class="text-amber-400 text-base">⏱️</span> Flexible Departure
          </div>
          <div class="flex items-center gap-2 text-xs sm:text-sm text-white font-medium bg-black/60 backdrop-blur-md px-3.5 py-2 border border-white/10 rounded-lg shadow-xl">
            <span class="text-amber-400 text-base">🌿</span> Ben Dinh & Ben Duoc
          </div>
          <div class="flex items-center gap-2 text-xs sm:text-sm text-white font-medium bg-black/60 backdrop-blur-md px-3.5 py-2 border border-white/10 rounded-lg shadow-xl">
            <span class="text-amber-400 text-base">🛡️</span> Waiting Driver Available
          </div>
        </div>

      </div>
    </section>

    {/* ================= MAIN CONTENT GRID ================= */}
    <div class="max-w-[1600px] mx-auto px-4 sm:px-6 lg:px-12 py-12 lg:py-16">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-start">

        {/* ---------------- LEFT SIDEBAR (TOC) ---------------- */}
        <aside class="hidden lg:block lg:col-span-3 sticky top-24">
          <div class="bg-white rounded-2xl shadow-sm border border-slate-200/60 p-6 overflow-hidden">
            <div class="flex items-center gap-2 font-bold text-slate-900 mb-5 border-l-4 border-amber-500 pl-3 text-sm tracking-wide uppercase">
              Table of Contents
            </div>
            
            <nav class="space-y-1 text-[13.5px] font-medium max-h-[calc(100vh-200px)] overflow-y-auto pr-1">
              <a href="#gioi-thieu" class="flex items-center gap-2 text-amber-900 bg-amber-50/80 px-3 py-2 rounded-lg transition-colors font-bold">
                <span class="text-amber-600 text-base">🏠</span> Introduction
              </a>
              
              <div class="pt-1.5 space-y-1 border-l border-slate-200 ml-3 pl-3">
                {toc.slice(1).map((item) => (
                  <a 
                    href={`#${item.id}`} 
                    class="block transition-colors leading-tight py-1.5 text-slate-600 hover:text-amber-800 font-semibold text-[13px]"
                  >
                    {item.title}
                  </a>
                ))}
              </div>
            </nav>
          </div>
        </aside>

        {/* ---------------- CENTER COLUMN (MAIN CONTENT) ---------------- */}
        <main class="col-span-1 lg:col-span-6 space-y-10">
          
          {/* Quick Overview Stats Bar (Strictly 3 Items) */}
          <div class="bg-white rounded-2xl shadow-sm border border-slate-200/60 p-5 md:p-6 mb-8">
            <div class="grid grid-cols-1 md:grid-cols-3 divide-y md:divide-y-0 md:divide-x divide-slate-100 gap-4 md:gap-0">
              <div class="flex items-center gap-3.5 md:px-4 first:pl-0 last:pr-0">
                <div class="w-11 h-11 rounded-xl bg-amber-50 flex items-center justify-center text-amber-700 text-xl border border-amber-200/80 shrink-0 shadow-xs">🚗</div>
                <div class="min-w-0 flex-1">
                  <div class="text-[10.5px] sm:text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-0.5 leading-tight">Cost Range</div>
                  <div class="text-[13.5px] sm:text-[14px] font-bold text-slate-900 leading-snug">~1.0M – 2.0M+ VND</div>
                </div>
              </div>

              <div class="flex items-center gap-3.5 md:px-4 first:pl-0 last:pr-0 pt-3 md:pt-0">
                <div class="w-11 h-11 rounded-xl bg-blue-50 flex items-center justify-center text-blue-700 text-xl border border-blue-200/80 shrink-0 shadow-xs">📍</div>
                <div class="min-w-0 flex-1">
                  <div class="text-[10.5px] sm:text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-0.5 leading-tight">Distance Range</div>
                  <div class="text-[13.5px] sm:text-[14px] font-bold text-slate-900 leading-snug">~50 – 70 km NW</div>
                </div>
              </div>

              <div class="flex items-center gap-3.5 md:px-4 first:pl-0 last:pr-0 pt-3 md:pt-0">
                <div class="w-11 h-11 rounded-xl bg-emerald-50 flex items-center justify-center text-emerald-700 text-xl border border-emerald-200/80 shrink-0 shadow-xs">⏰</div>
                <div class="min-w-0 flex-1">
                  <div class="text-[10.5px] sm:text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-0.5 leading-tight">Recommended Window</div>
                  <div class="text-[13.5px] sm:text-[14px] font-bold text-slate-900 leading-snug">06:30 – 07:00 AM</div>
                </div>
              </div>
            </div>
          </div>

          {/* SECTION: INTRODUCTION */}
          <section id="gioi-thieu" class="scroll-mt-28 space-y-4">
            <div class="prose prose-slate max-w-none prose-p:leading-relaxed prose-p:text-[16px] prose-p:text-slate-700">
              <p>
                Visiting the <strong>Cu Chi Tunnels</strong> (<em>Địa đạo Củ Chi</em>) by private car gives travelers more control over departure time, hotel pickup, vehicle choice, and the pace of the day. Instead of joining a fixed group itinerary, travelers can arrange a direct transfer to Ben Dinh or Ben Duoc, spend the time they need at the historical site, and return to Ho Chi Minh City on a schedule that suits their group.
              </p>

              <div class="font-medium text-slate-900 text-lg border-l-4 border-amber-500 pl-4 my-5 bg-amber-50/50 py-3 rounded-r-xl">
                "The trade-off is straightforward: a private car normally costs more than a shared tour, but the additional cost buys flexibility and privacy rather than simply a faster journey."
              </div>

              {/* Featured In-Article Image */}
              <div class="my-6 not-prose">
                <div class="rounded-2xl overflow-hidden shadow-md border border-slate-200">
                  <img 
                    src="https://media.thericetour.com/uploads/group-posing-secret-tunnel-entrance-leaves-cu-chi-1280x720.webp" 
                    alt="Small private group exploring the forested grounds and secret tunnel entrances at Cu Chi - The Rice Tour" 
                    class="w-full h-auto object-cover max-h-[500px]" 
                    width="1280" 
                    height="720" 
                    loading="eager" 
                  />
                </div>
                <p class="text-center text-xs sm:text-sm text-slate-500 italic mt-2.5">
                  Private transportation gives you the flexibility to explore secret entrances and historical exhibits at your own pace without large tour groups.
                </p>
              </div>

              {/* UNESCO 2026 Milestone & 27M Visitors Callout Box */}
              <div class="bg-amber-50/70 border border-amber-300/80 p-5 rounded-2xl my-6 not-prose">
                <div class="flex items-center gap-2.5 text-amber-900 font-bold text-sm sm:text-base mb-2">
                  <span class="text-lg">🏛️</span> UNESCO Tentative List 2026: Over 27 Million Cumulative Visitors
                </div>
                <p class="text-xs sm:text-sm text-amber-950/90 leading-relaxed">
                  On <strong>July 15, 2026</strong>, Vietnam officially submitted the Cu Chi Tunnels complex to the <strong>UNESCO World Heritage Tentative List</strong> under cultural criteria <em>(iv)</em> and <em>(v)</em>. The dossier describes the system as an extraordinary subterranean defense network forged across both the <strong>First Indochina War</strong> and <strong>Second Indochina War</strong>. UNESCO records note that by 2025, Cu Chi had welcomed <strong>more than 27 million cumulative domestic and international visitors</strong> since opening to tourism, with Ben Duoc and Ben Dinh recognized as the two primary sectors best preserving the original scale, layout, and structure (totaling roughly 4 km of conserved underground passages).
                </p>
              </div>

              <p>
                Alongside central historical landmarks like the <a href="/independence-palace-saigon-guide" class="text-amber-800 hover:text-amber-900 font-semibold underline underline-offset-2 decoration-amber-300">Independence Palace</a>, the Cu Chi complex remains one of southern Vietnam's defining historical encounters. For couples, families, small groups, and travelers who prefer a direct hotel-to-site transfer, a private car can be a practical way to visit without being tied to multiple hotel pickups or a fixed group schedule.
              </p>
            </div>
          </section>

          <hr class="border-slate-200" />

          {/* SECTION 1: IS A PRIVATE CAR WORTH IT */}
          <section id="is-a-private-car-worth-it" class="scroll-mt-28 space-y-5">
            <div class="border-l-4 border-amber-500 pl-4 mb-4">
              <h2 class="font-serif text-2xl lg:text-[26px] font-bold text-slate-900 leading-tight">
                Is A Private Car Worth It For Cu Chi Tunnels?
              </h2>
            </div>

            <div class="text-slate-700 text-[15.5px] leading-relaxed space-y-4">
              <p>
                The answer depends mainly on group size, priorities, and how much flexibility matters.
              </p>
              <p>
                A shared tour is usually designed around a fixed departure time and a common itinerary. Pickup may involve several hotels, and the group follows the same schedule throughout the excursion. This can be convenient for solo travelers or visitors primarily concerned with keeping transportation costs low.
              </p>
              <p>
                A private car works differently. The vehicle is reserved for one party, so the departure time can be arranged around the travelers' hotel location and preferred visit window. The group can also request a direct itinerary rather than adding stops that are not part of the main visit.
              </p>
              <p>
                This does not mean a private car eliminates traffic or makes the journey dramatically shorter. Its main advantage is <strong>control</strong>.
              </p>

              {/* Callout Box */}
              <div class="bg-amber-50/70 border border-amber-300/80 p-5 rounded-2xl my-6 not-prose">
