---
import { env } from 'cloudflare:workers';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { safeQueryCritical } from '@/lib/db-client';
import { getGlobalSettings } from '@/lib/settingsHelper';
import JsonLdSchema from '@/components/seo/JsonLdSchema.astro';

// --- SSR D1 DATABASE QUERY ---
const currentSlug = 'visiting-cu-chi-tunnels-by-private-car';

const d1Db = env?.dulichcoguu_d1 || (Astro.locals as any)?.runtime?.env?.dulichcoguu_d1;
let post: any = null;
try {
  if (d1Db) {
    post = await safeQueryCritical(
      d1Db.prepare("SELECT * FROM Post WHERE slug = ? AND (status = 'published' OR status = 'publish')").bind(currentSlug).first<any>(),
      { route: Astro.url.pathname, slug: currentSlug, queryType: "fetch_post_by_slug" }
    );
  }
} catch (e) {
  console.warn('[D1 Query Warning] visiting-cu-chi-tunnels-by-private-car:', e);
}

// Fallback metadata if D1 local/remote is not yet populated
if (!post) {
  post = {
    id: 19807,
    title: 'Visiting Cu Chi Tunnels By Private Car: Costs, Routes & What To Expect',
    slug: currentSlug,
    excerpt: 'A practical guide to hiring a private vehicle from Ho Chi Minh City, calculating per-person costs, choosing between SUVs and limousine vans, and planning routes to Ben Dinh and Ben Duoc.',
    featuredImage: 'https://media.thericetour.com/uploads/two-girls-posing-rusted-tank-cu-chi-tunnels-the-rice.webp',
    readingTime: 14,
    author: 'The Rice Tour Editorial',
    createdAt: '2026-09-16T08:00:00.000Z',
    publishedAt: '2026-09-16T08:00:00.000Z',
    updatedAt: '2026-09-16T08:00:00.000Z'
  };
}

// Check draftSnapshot if exists
let draftData: any = null;
if (post?.draftSnapshot) {
  try {
    draftData = typeof post.draftSnapshot === 'string' 
      ? JSON.parse(post.draftSnapshot) 
      : post.draftSnapshot;
  } catch (e) {
    console.log("Could not parse draftSnapshot:", e);
  }
}

const rawTitle = draftData?.title || post?.title;
const rawSeoTitle = draftData?.seoTitle || post?.seoTitle;
const rawSeoDesc = draftData?.seoDescription || post?.seoDescription || draftData?.excerpt || post?.excerpt;
const rawFeaturedImage = draftData?.featuredImage || post?.featuredImage || post?.ogImage;

const cleanText = (str?: string) => str ? String(str).replace(/<[^>]*>/g, '').replace(/[\t\r\n]+/g, ' ').replace(/\s{2,}/g, ' ').trim() : '';

const pageTitle = cleanText(rawTitle) || 'Visiting Cu Chi Tunnels By Private Car: Costs, Routes & What To Expect';
const pageDesc = cleanText(rawSeoDesc) || 'A practical guide to hiring a private vehicle from Ho Chi Minh City, calculating per-person costs, choosing between SUVs and limousine vans, and planning routes to Ben Dinh and Ben Duoc.';

let resolvedSeoTitle = cleanText(rawSeoTitle);
if (!resolvedSeoTitle || resolvedSeoTitle === '%title%' || resolvedSeoTitle === '%%title%%') {
  resolvedSeoTitle = rawTitle ? `${cleanText(rawTitle)} | The Rice Tour` : "Visiting Cu Chi Tunnels By Private Car: Costs, Routes & What To Expect";
} else if (resolvedSeoTitle.includes('%title%')) {
  resolvedSeoTitle = resolvedSeoTitle.replace(/%title%/gi, cleanText(rawTitle) || "Cu Chi Tunnels Private Car");
} else if (resolvedSeoTitle.includes('%%title%%')) {
  resolvedSeoTitle = resolvedSeoTitle.replace(/%%title%%/gi, cleanText(rawTitle) || "Cu Chi Tunnels Private Car");
}

const seoTitle = resolvedSeoTitle;
const seoDesc = 'Hiring a private car to Cu Chi Tunnels: compare SUV, MPV & limousine costs, avoid hidden fees, choose between Ben Dinh & Ben Duoc, and plan an unhurried day from Saigon.';
const seoImage = rawFeaturedImage || 'https://media.thericetour.com/uploads/two-girls-posing-rusted-tank-cu-chi-tunnels-the-rice.webp';

// --- DATE LOGIC ---
const createdAtStr = post.createdAt || post.publishedAt || '2026-09-16T08:00:00.000Z';
const updatedAtStr = post.updatedAt || '2026-09-16T08:00:00.000Z';

const createdAt = new Date(createdAtStr.replace(' ', 'T'));
const updatedAt = new Date(updatedAtStr.replace(' ', 'T'));

const isUpdated = updatedAt.getTime() - createdAt.getTime() > 86400000;
const displayDate = isUpdated ? updatedAt : createdAt;
const datePrefix = isUpdated ? "Updated:" : "Published:";
const formattedDate = displayDate.toLocaleDateString('en-US', { day: 'numeric', month: 'long', year: 'numeric' });

// --- AUTHOR LOGIC ---
const authorMap: Record<string, any> = {
  "The Rice Tour Editorial": {
    name: "The Rice Tour Editorial",
    url: "/about-us",
    img: "https://media.thericetour.com/uploads/the-rice-tour-editorial-avatar.webp"
  },
  "Huynh Hieu Travel": {
    name: "Huynh Hieu Travel",
    url: "/about-us",
    img: "https://media.thericetour.com/uploads/huynhhieutravel.webp"
  }
};
const authorData = authorMap[post.author] || authorMap["The Rice Tour Editorial"];
const author = draftData?.author || post?.author || "The Rice Tour Editorial";
const publishedTime = post?.publishedAt || post?.createdAt;
const modifiedTime = post?.updatedAt;

const adminEditUrl = post.id && post.id !== 19807 ? `/admin/posts/edit?id=${post.id}` : '#';

// TOC Navigation Structure
const toc = [
  { id: "introduction", title: "Introduction", icon: "🏠" },
  { id: "is-a-private-car-worth-it", title: "1. Is A Private Car Worth It?", icon: "💎" },
  { id: "costs-and-pricing-2026", title: "2. 2026 Private Car Costs & Pricing", icon: "💵" },
  { id: "vehicle-options", title: "3. Choosing The Right Vehicle", icon: "🚐" },
  { id: "route-and-traffic", title: "4. The Route From Saigon To Cu Chi", icon: "🗺️" },
  { id: "departure-timing", title: "5. What Time Should You Leave?", icon: "⏰" },
  { id: "ben-dinh-vs-ben-duoc", title: "6. Ben Dinh vs. Ben Duoc By Car", icon: "🌿" },
  { id: "private-car-vs-group-tour", title: "7. Private Car vs. Group Tour", icon: "⚖️" },
  { id: "included-services", title: "8. What Is Included in the Service?", icon: "📋" },
  { id: "visiting-without-a-tour", title: "9. Can You Visit Without A Tour?", icon: "🧭" },
  { id: "what-to-expect-on-site", title: "10. What To Expect (Optional Crawl)", icon: "🛡️" },
  { id: "families-and-seniors", title: "11. Families & Senior Travelers", icon: "👨‍👩‍👧‍👦" },
  { id: "combining-destinations", title: "12. Combining With Other Sights?", icon: "🚫" },
  { id: "booking-checklist", title: "13. 10-Point Booking Checklist", icon: "✅" },
  { id: "faq", title: "Frequently Asked Questions", icon: "💡" },
  { id: "epilogue", title: "Epilogue: Control Over Convenience", icon: "✨" }
];

// SSR JSON-LD Schemas
const currentOrigin = 'https://thericetour.com';
const canonicalUrl = draftData?.canonicalUrl || post?.canonicalUrl || `${currentOrigin}/${currentSlug}`;

const breadcrumbSchema = {
  items: [
    { name: "Home", url: `${currentOrigin}/` },
    { name: "Travel Guides", url: `${currentOrigin}/blog` },
    { name: pageTitle, url: canonicalUrl }
  ]
};

const faqSchema = {
  questions: [
    {
      question: "How much does a private car to Cu Chi Tunnels cost in 2026?",
      answer: "Private-car rates typically range from $65 to $95 USD for a comfortable SUV or 7-seat MPV (2–4 passengers) and $110 to $150 USD for a luxury 9-seat limousine van. These rates cover round-trip door-to-door transfer, driver waiting time, highway tolls, and fuel. Because pricing is per vehicle, it is exceptionally economical per person for families and small groups."
    },
    {
      question: "Is traveling by private car faster than joining a bus tour?",
      answer: "Not necessarily on the highway, because all vehicles share the same road network. However, a private car saves 45 to 60 minutes in central Saigon by eliminating multi-hotel passenger pickups and avoiding 45-minute commercial stops at roadside handicraft factories."
    },
    {
      question: "Which tunnel site should I visit by private car: Ben Dinh or Ben Duoc?",
      answer: "If your schedule is tight and you want to keep total travel time under 5 hours, Ben Dinh (~50 km) is the practical choice. If you prefer a spacious riverside forest setting with far fewer tour buses and wish to see the Ben Duoc Memorial Temple and Liberation Zone, Ben Duoc (~70 km) is well worth the extra 40 minutes of driving."
    },
    {
      question: "Do I need to book a separate tour guide with my private car?",
      answer: "Every admission ticket purchased at Cu Chi includes the services of an official English-speaking site guide who walks you through the exhibits and trapdoors. However, for seamless storytelling and assistance from hotel pickup to return drop-off, booking a private licensed tour guide to travel in the vehicle elevates the experience significantly."
    },
    {
      question: "Can travelers with claustrophobia or limited mobility visit comfortably?",
      answer: "Yes. Roughly 85 to 90 percent of the exhibits are entirely outdoors on shaded woodland footpaths. Nobody is forced to go underground. Ben Duoc also features paved trails and on-site electric carts for visitors requiring mobility support."
    },
    {
      question: "What are the official opening hours and ticket prices in 2026?",
      answer: "Cu Chi Tunnels open daily from 07:00 AM to 05:00 PM. Effective February 1, 2026, the official entrance fee for international visitors is 135,000 VND per person (comprising 35,000 VND relic admission + 100,000 VND guide and service fee)."
    },
    {
      question: "Is Cu Chi Tunnels on the UNESCO World Heritage List?",
      answer: "On July 15, 2026, Vietnam officially submitted the Cu Chi Tunnels complex to the UNESCO World Heritage Tentative List. It is currently under evaluation and represents one of Southeast Asia's premier wartime military heritage sites."
    },
    {
      question: "Can I book a Grab car to Cu Chi and take another Grab back?",
      answer: "While taking a Grab to Cu Chi is easy, securing a return ride from rural Cu Chi (especially Ben Duoc) is notoriously difficult and unreliable. Booking a private round-trip car with driver waiting time included avoids the stress of being stranded."
    }
  ]
};
---

<BaseLayout 
  title={seoTitle} 
  description={seoDesc} 
  image={seoImage}
  canonical={canonicalUrl}
  preloadImages={[seoImage]}
  adminEditUrl={adminEditUrl}
  lang="en"
  ogType="article"
  publishedTime={publishedTime}
  modifiedTime={modifiedTime}
  author={author}
>
  <Fragment slot="schema">
    <JsonLdSchema type="breadcrumb" data={breadcrumbSchema} />
    <JsonLdSchema type="faq" data={faqSchema} />
  </Fragment>

  <Fragment slot="head">
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    <meta property="article:author" content={author} />
    <meta property="article:section" content="Heritage & Travel Guides" />
  </Fragment>

  <div class="bg-[#F8F9FA] text-[#1E293B] font-sans antialiased selection:bg-[#F7931E] selection:text-white">

    {/* ================= HERO SECTION ================= */}
    <section class="relative w-full min-h-[560px] lg:min-h-[640px] overflow-hidden flex flex-col justify-center pt-32 pb-20">
      <div class="absolute inset-0 z-0 bg-slate-950">
        <img 
          src={seoImage} 
          alt={pageTitle} 
          width="1280"
          height="720"
          class="w-full h-full object-cover object-center opacity-85" 
          loading="eager"
          fetchpriority="high"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-[#0B132B] via-[#0B132B]/75 to-transparent"></div>
        <div class="absolute inset-0 bg-radial-at-c from-transparent via-[#0B132B]/30 to-[#0B132B]/80"></div>
      </div>

      <div class="relative z-10 max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 w-full text-center lg:text-left flex flex-col items-center lg:items-start">
        
        {/* Breadcrumb Navigation */}
        <nav class="flex items-center gap-2 text-xs sm:text-sm text-slate-300 mb-6 backdrop-blur-md bg-white/10 px-3.5 py-1.5 rounded-full border border-white/15 shadow-sm">
          <a href="/" class="hover:text-amber-400 transition-colors">Home</a>
          <span class="text-slate-400">/</span>
          <a href="/blog" class="hover:text-amber-400 transition-colors">Travel Guides</a>
          <span class="text-slate-400">/</span>
          <span class="text-amber-400 font-medium truncate max-w-[200px] sm:max-w-none">Cu Chi By Private Car</span>
        </nav>

        {/* Category Badge & Meta */}
        <div class="flex flex-wrap items-center justify-center lg:justify-start gap-3 mb-4">
          <span class="px-3 py-1 text-xs font-semibold uppercase tracking-wider text-amber-900 bg-amber-400 rounded-full shadow-sm">
            Practical Logistics Guide
          </span>
          <span class="text-xs text-slate-300 flex items-center gap-1 font-medium">
            <svg class="w-4 h-4 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            14 Min Read
          </span>
          <span class="text-xs text-slate-300 flex items-center gap-1 font-medium">
            <svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            Updated for 2026 Season
          </span>
        </div>

        {/* Main H1 Title */}
        <h1 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-bold text-white tracking-tight leading-tight lg:leading-[1.15] mb-6 max-w-4xl text-balance">
          Visiting Cu Chi Tunnels By Private Car: Costs, Routes & What To Expect
        </h1>

        {/* Subtitle / Excerpt */}
        <p class="text-base sm:text-lg lg:text-xl text-slate-200 font-light max-w-3xl mb-8 leading-relaxed text-balance">
          A practical guide to hiring a private vehicle from Ho Chi Minh City, calculating per-person costs, choosing between SUVs and luxury limousine vans, and planning direct routes to Ben Dinh and Ben Duoc.
        </p>

        {/* Author Bio Bar */}
        <div class="flex flex-wrap items-center justify-center lg:justify-start gap-4 pt-4 border-t border-white/15 w-full max-w-2xl">
          <div class="flex items-center gap-3">
            <img 
              src={authorData.img} 
              alt={authorData.name} 
              width="44"
              height="44"
              class="w-11 h-11 rounded-full border-2 border-amber-400 object-cover shadow-sm" 
            />
            <div class="text-left">
              <div class="text-white text-sm font-semibold flex items-center gap-1.5">
                {authorData.name}
                <svg class="w-4 h-4 text-sky-400 fill-sky-400" viewBox="0 0 20 20"><path d="M6.267 3.455a3.066 3.066 0 001.745-.723 3.066 3.066 0 013.976 0 3.066 3.066 0 001.745.723 3.066 3.066 0 012.812 2.812c.051.643.304 1.254.723 1.745a3.066 3.066 0 010 3.976 3.066 3.066 0 00-.723 1.745 3.066 3.066 0 01-2.812 2.812 3.066 3.066 0 00-1.745.723 3.066 3.066 0 01-3.976 0 3.066 3.066 0 00-1.745-.723 3.066 3.066 0 01-2.812-2.812 3.066 3.066 0 00-.723-1.745 3.066 3.066 0 010-3.976 3.066 3.066 0 00.723-1.745 3.066 3.066 0 012.812-2.812zm7.44 5.252a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"/></svg>
              </div>
              <div class="text-xs text-slate-300">{datePrefix} {formattedDate}</div>
            </div>
          </div>

          <div class="hidden sm:block h-7 w-[1px] bg-white/20"></div>

          {/* Social / Sharing */}
          <div class="flex items-center gap-2">
            <a 
              href={`https://twitter.com/intent/tweet?url=${encodeURIComponent(canonicalUrl)}&text=${encodeURIComponent(pageTitle)}`}
              target="_blank" 
              rel="noopener noreferrer"
              class="w-9 h-9 rounded-full bg-white/10 hover:bg-white/20 text-slate-200 hover:text-white flex items-center justify-center transition-colors"
              aria-label="Share on Twitter"
            >
              <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
            </a>
            <a 
              href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(canonicalUrl)}`}
              target="_blank" 
              rel="noopener noreferrer"
              class="w-9 h-9 rounded-full bg-white/10 hover:bg-white/20 text-slate-200 hover:text-white flex items-center justify-center transition-colors"
              aria-label="Share on Facebook"
            >
              <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
            </a>
            <button 
              id="copy-link-btn"
              class="px-3 py-1.5 rounded-full bg-white/10 hover:bg-white/20 text-slate-200 hover:text-white text-xs font-medium flex items-center gap-1.5 transition-colors"
              aria-label="Copy article link"
            >
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3"/></svg>
              <span>Copy Link</span>
            </button>
          </div>
        </div>

      </div>
    </section>

    {/* ================= 3-COLUMN EDITORIAL CONTAINER ================= */}
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-16">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10">
        
        {/* LEFT COLUMN: STICKY TABLE OF CONTENTS */}
        <aside class="hidden lg:block lg:col-span-3">
          <div class="sticky top-24 bg-white rounded-2xl p-5 border border-slate-200/90 shadow-sm space-y-4">
            <div class="flex items-center gap-2 font-bold text-slate-900 pb-3 border-b border-slate-100 text-sm tracking-wide uppercase">
              <svg class="w-4 h-4 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7"/></svg>
              Guide Outline
            </div>
            <nav class="space-y-1 text-sm max-h-[calc(100vh-210px)] overflow-y-auto pr-1 text-slate-600 font-sans custom-scrollbar">
              {toc.map(item => (
                <a 
                  href={`#${item.id}`} 
                  class="flex items-start gap-2 py-1.5 px-2 rounded-lg hover:bg-amber-50 hover:text-amber-900 transition-colors leading-snug group"
                >
                  <span class="text-sm shrink-0 opacity-80 group-hover:opacity-100">{item.icon}</span>
                  <span class="text-xs font-medium line-clamp-1">{item.title}</span>
                </a>
              ))}
            </nav>
            <div class="pt-3 border-t border-slate-100">
              <a 
                href="/tour/half-day-cu-chi-tunnels-tour" 
                class="w-full flex items-center justify-center gap-1.5 py-2.5 px-3 rounded-xl bg-amber-500 hover:bg-amber-600 text-white font-semibold text-xs transition-colors shadow-xs"
              >
                <span>Book Private Cu Chi Car</span>
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
              </a>
            </div>
          </div>
        </aside>

        {/* MIDDLE COLUMN: MAIN ARTICLE CONTENT */}
        <main class="lg:col-span-6 space-y-10">

          {/* QUICK STATS CARDS */}
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-3.5 p-5 bg-white rounded-2xl border border-slate-200/90 shadow-sm">
            <div class="space-y-1 text-center sm:text-left">
              <div class="text-xs uppercase tracking-wider text-slate-400 font-semibold">Typical Car Rate</div>
              <div class="text-lg font-bold text-slate-900 font-serif">$65 – $95 <span class="text-xs font-sans font-normal text-slate-500">SUV/MPV</span></div>
              <div class="text-[11px] text-slate-500">Round-trip door-to-door</div>
            </div>
            <div class="space-y-1 text-center sm:text-left border-y sm:border-y-0 sm:border-x border-slate-100 py-3 sm:py-0 sm:px-4">
              <div class="text-xs uppercase tracking-wider text-slate-400 font-semibold">Drive Distance</div>
              <div class="text-lg font-bold text-slate-900 font-serif">50 – 70 <span class="text-xs font-sans font-normal text-slate-500">km</span></div>
              <div class="text-[11px] text-slate-500">Ben Dinh vs Ben Duoc</div>
            </div>
            <div class="space-y-1 text-center sm:text-left sm:pl-2">
              <div class="text-xs uppercase tracking-wider text-slate-400 font-semibold">Best Departure</div>
              <div class="text-lg font-bold text-emerald-700 font-serif">06:30 – 07:00 AM</div>
              <div class="text-[11px] text-slate-500">Clears An Suong early</div>
            </div>
          </div>

          {/* SECTION: INTRODUCTION */}
          <section id="introduction" class="scroll-mt-28 space-y-5">
            <div class="prose prose-slate max-w-none text-slate-700 text-[16px] sm:text-[16.5px] leading-relaxed space-y-4 font-normal">
              <p class="text-lg sm:text-xl font-light text-slate-800 leading-relaxed">
                Visiting the <strong>Cu Chi Tunnels</strong> (<em>Địa đạo Củ Chi</em>) by private car gives travelers complete control over departure time, hotel pickup, vehicle choice, and the pace of the day. Instead of joining a rigid group itinerary with multiple hotel stops, travelers can arrange a direct, door-to-door transfer to either Ben Dinh or Ben Duoc, spend the exact time they need at the historical site, and return to central Ho Chi Minh City on a schedule that fits their group.
              </p>

              <blockquote class="p-4 sm:p-5 my-6 border-l-4 border-amber-500 bg-amber-50/60 rounded-r-xl italic font-serif text-slate-800 text-[15.5px]">
                "The trade-off is straightforward: a private car normally costs more than a shared tour, but that additional investment buys flexibility, comfort, and privacy rather than simply a faster journey."
              </blockquote>

              <p>
                Alongside downtown landmarks like the <a href="/independence-palace-saigon-guide" class="text-amber-800 hover:text-amber-900 font-semibold underline underline-offset-2 decoration-amber-300">Independence Palace</a>, the Cu Chi complex remains one of southern Vietnam's defining historical encounters. For couples, families, multi-generational groups, and travelers who value direct travel, private transportation is the most comfortable and reliable way to experience this iconic wartime landmark without feeling rushed.
              </p>
            </div>
          </section>

          <hr class="border-slate-200" />

          {/* SECTION 1: IS A PRIVATE CAR WORTH IT */}
          <section id="is-a-private-car-worth-it" class="scroll-mt-28 space-y-5">
            <div class="border-l-4 border-amber-500 pl-4 mb-4">
              <h2 class="font-serif text-2xl lg:text-[26px] font-bold text-slate-900 leading-tight">
                1. Is A Private Car Worth It For Cu Chi Tunnels?
              </h2>
