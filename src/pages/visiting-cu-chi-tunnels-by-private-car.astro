---
import { env } from 'cloudflare:workers';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { safeQueryCritical } from '@/lib/db-client';
import { getGlobalSettings } from '@/lib/settingsHelper';
import JsonLdSchema from '@/components/seo/JsonLdSchema.astro';

// --- SSR D1 DATABASE QUERY ---
const currentSlug = 'visiting-cu-chi-tunnels-by-private-car';

const d1Db = env?.dulichcoguu_d1 || (Astro.locals as any)?.runtime?.env?.dulichcoguu_d1;
let post: any = null;
try {
  if (d1Db) {
    post = await safeQueryCritical(
      d1Db.prepare("SELECT * FROM Post WHERE slug = ? AND (status = 'published' OR status = 'publish')").bind(currentSlug).first<any>(),
      { route: Astro.url.pathname, slug: currentSlug, queryType: "fetch_post_by_slug" }
    );
  }
} catch (e) {
  console.warn('[D1 Query Warning] visiting-cu-chi-tunnels-by-private-car:', e);
}

// Fallback metadata if D1 is not yet populated
if (!post) {
  post = {
    id: 19808,
    title: 'Visiting Cu Chi Tunnels By Private Car: Costs, Routes & What To Expect',
    slug: currentSlug,
    excerpt: 'A practical guide to vehicle options, 2026 costs, route planning, and choosing between Ben Dinh and Ben Duoc from Ho Chi Minh City.',
    featuredImage: 'https://media.thericetour.com/uploads/two-girls-posing-rusted-tank-cu-chi-tunnels-the-rice.webp',
    readingTime: 14,
    author: 'The Rice Tour Editorial',
    createdAt: '2026-09-16T08:00:00.000Z',
    publishedAt: '2026-09-16T08:00:00.000Z',
    updatedAt: '2026-09-16T08:00:00.000Z'
  };
}

const { settings } = await getGlobalSettings();

const pageTitle = post?.title || 'Visiting Cu Chi Tunnels By Private Car: Costs, Routes & What To Expect';
const pageDesc = post?.excerpt || 'A practical guide to vehicle options, 2026 costs, route planning, and choosing between Ben Dinh and Ben Duoc from Ho Chi Minh City.';

const seoTitle = post?.seoTitle || post?.metaTitle || `${pageTitle} | The Rice Tour`;
const seoDesc = post?.seoDescription || 'Hiring a private car to Cu Chi Tunnels: compare SUV, MPV & limousine costs, avoid hidden fees, choose between Ben Dinh & Ben Duoc, and plan an unhurried day from Saigon.';
const seoImage = post?.ogImage || post?.featuredImage || 'https://media.thericetour.com/uploads/two-girls-posing-rusted-tank-cu-chi-tunnels-the-rice.webp';

// --- DATE LOGIC (E-E-A-T Compliant) ---
const createdAtStr = post.createdAt || post.publishedAt || '2026-09-16T08:00:00.000Z';
const updatedAtStr = post.updatedAt || '2026-09-16T08:00:00.000Z';

const createdAt = new Date(createdAtStr.replace(' ', 'T'));
const updatedAt = new Date(updatedAtStr.replace(' ', 'T'));

const isUpdated = updatedAt.getTime() - createdAt.getTime() > 86400000;
const displayDate = isUpdated ? updatedAt : createdAt;
const datePrefix = isUpdated ? "Updated:" : "Published:";
const formattedDate = displayDate.toLocaleDateString('en-US', { day: 'numeric', month: 'long', year: 'numeric' });

// --- AUTHOR LOGIC ---
const authorMap: Record<string, any> = {
  "The Rice Tour Editorial": {
    name: "The Rice Tour Editorial",
    url: "/about-us",
    img: "https://media.thericetour.com/uploads/the-rice-tour-editorial-avatar.webp"
  },
  "Huynh Hieu Travel": {
    name: "Huynh Hieu Travel",
    url: "/about-us",
    img: "https://media.thericetour.com/uploads/huynhhieutravel.webp"
  }
};
const authorData = authorMap[post.author] || authorMap["The Rice Tour Editorial"];

const adminEditUrl = post.id && post.id !== 19808 ? `/admin/posts/edit?id=${post.id}` : '#';

// TOC Navigation Structure
const toc = [
  { id: "gioi-thieu", title: "Introduction", icon: "🏠" },
  { id: "is-a-private-car-worth-it", title: "1. Is A Private Car Worth It?", icon: "💎" },
  { id: "private-car-costs-2026", title: "2. 2026 Private Car Costs & Pricing Basis", icon: "💵" },
  { id: "which-vehicle-should-you-choose", title: "3. Choosing The Right Vehicle", icon: "🚗" },
  { id: "route-from-hcmc-to-cu-chi", title: "4. The Route From Saigon To Cu Chi", icon: "🗺️" },
  { id: "what-time-should-you-leave", title: "5. What Time Should You Leave?", icon: "⏰" },
  { id: "ben-dinh-or-ben-duoc", title: "6. Ben Dinh vs. Ben Duoc By Private Car", icon: "🌿" },
  { id: "private-car-vs-group-tour", title: "7. Private Car vs. Shared Group Tour", icon: "⚖️" },
  { id: "what-is-usually-included", title: "8. What Is Included in the Quoted Price?", icon: "📋" },
  { id: "can-you-visit-without-a-tour", title: "9. Can You Visit Without An Organized Tour?", icon: "🧭" },
  { id: "what-to-expect-at-the-tunnels", title: "10. What To Expect (Underground Crawl Is Optional)", icon: "🛡️" },
  { id: "is-private-car-suitable-for-families", title: "11. Families & Senior Travelers", icon: "👨‍👩‍👧‍👦" },
  { id: "combine-with-another-attraction", title: "12. Combining Cu Chi With Other Destinations", icon: "🚫" },
  { id: "practical-private-car-checklist", title: "13. 10-Point Booking Checklist", icon: "✅" },
  { id: "frequently-asked-questions", title: "Frequently Asked Questions (FAQ)", icon: "💡" },
  { id: "epilogue", title: "Epilogue: Control Over Speed", icon: "✨" }
];

// SSR JSON-LD Schemas
const currentOrigin = 'https://thericetour.com';
const canonicalUrl = `${currentOrigin}/${currentSlug}`;

const breadcrumbSchema = {
  items: [
    { name: "Home", url: `${currentOrigin}/` },
    { name: "Travel Guides", url: `${currentOrigin}/blog` },
    { name: pageTitle, url: canonicalUrl }
  ]
};

const faqSchema = {
  questions: [
    {
      question: "How much does a private car to Cu Chi Tunnels cost in 2026?",
      answer: "Private-car rates typically range from $65 to $95 USD for a comfortable SUV or 7-seat MPV (2–4 passengers) and $110 to $150 USD for a luxury 9-seat limousine van. These rates cover round-trip door-to-door transfer, driver waiting time, highway tolls, and fuel. Because pricing is per vehicle, it is exceptionally economical per person for families and small groups."
    },
    {
      question: "Is traveling by private car faster than joining a bus tour?",
      answer: "Not necessarily on the open highway, because all vehicles share the same road network. However, a private car saves 45 to 60 minutes in central Saigon by eliminating multi-hotel passenger pickups and avoiding 45-minute commercial stops at roadside handicraft factories."
    },
    {
      question: "Which tunnel site should I visit by private car: Ben Dinh or Ben Duoc?",
      answer: "If your schedule is tight and you want to keep total travel time under 5 hours, Ben Dinh (~50 km) is the practical choice. If you prefer a spacious riverside forest setting with far fewer tour buses and wish to see the Ben Duoc Memorial Temple and Liberation Zone, Ben Duoc (~70 km) is well worth the extra 40 minutes of driving."
    },
    {
      question: "Do I need to book a separate tour guide with my private car?",
      answer: "Every admission ticket purchased at Cu Chi includes the services of an official English-speaking site guide who walks you through the exhibits and trapdoors. However, for seamless storytelling and assistance from hotel pickup to return drop-off, booking a private licensed tour guide to travel in the vehicle elevates the experience significantly."
    },
    {
      question: "Can travelers with claustrophobia or limited mobility visit comfortably?",
      answer: "Yes. Roughly 85 to 90 percent of the exhibits are entirely outdoors on shaded woodland footpaths. Nobody is forced to go underground. Ben Duoc also features paved trails and on-site electric carts for visitors requiring mobility support."
    },
    {
      question: "What are the official opening hours and ticket prices in 2026?",
      answer: "Cu Chi Tunnels open daily from 07:00 AM to 05:00 PM. Effective February 1, 2026, the official entrance fee for international visitors is 135,000 VND per person (comprising 35,000 VND relic admission + 100,000 VND guide and service fee)."
    },
    {
      question: "Is Cu Chi Tunnels on the UNESCO World Heritage List?",
      answer: "On July 15, 2026, Vietnam officially submitted the Cu Chi Tunnels complex to the UNESCO World Heritage Tentative List. It is currently under evaluation and represents one of Southeast Asia's premier wartime military heritage sites."
    },
    {
      question: "Can I book a Grab car to Cu Chi and take another Grab back?",
      answer: "While taking a Grab to Cu Chi is easy, securing a return ride from rural Cu Chi (especially Ben Duoc) is notoriously difficult and unreliable. Booking a private round-trip car with driver waiting time included avoids the stress of being stranded."
    }
  ]
};
---

<BaseLayout 
  title={seoTitle} 
  description={seoDesc} 
  image={seoImage}
  canonical={canonicalUrl}
  preloadImages={[seoImage]}
  adminEditUrl={adminEditUrl}
  lang="en"
  ogType="article"
>
  <Fragment slot="schema">
    <JsonLdSchema type="breadcrumb" data={breadcrumbSchema} />
    <JsonLdSchema type="faq" data={faqSchema} />
  </Fragment>

  <div class="bg-[#F8F9FA] text-[#1E293B] font-sans antialiased selection:bg-[#F7931E] selection:text-white">

    {/* ================= HERO SECTION ================= */}
    <section class="relative w-full min-h-[580px] lg:min-h-[660px] overflow-hidden flex flex-col justify-center pt-32 pb-20">
      <div class="absolute inset-0 z-0 bg-slate-950">
        <img 
          src={seoImage} 
          alt={pageTitle} 
          class="w-full h-full object-cover object-center opacity-85" 
          width="1280" 
          height="720"
          fetchpriority="high" 
          loading="eager" 
          decoding="async" 
        />
        <div class="absolute inset-0 bg-gradient-to-r from-black/80 via-black/55 to-black/30"></div>
        <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/30 to-transparent"></div>
      </div>

      <div class="relative z-10 max-w-[1600px] mx-auto px-4 sm:px-6 lg:px-12 w-full">
        
        {/* Breadcrumb - Standard 3-level breadcrumb */}
        <div class="flex items-center gap-2 text-[13px] text-white/70 font-medium mb-6 flex-wrap">
          <a href="/" class="hover:text-white transition-colors">Home</a>
          <svg class="w-3 h-3 text-white/40" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
          <a href="/blog" class="hover:text-white transition-colors">Travel Guides</a>
          <svg class="w-3 h-3 text-white/40" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
          <span class="text-white font-semibold line-clamp-1">{pageTitle}</span>
        </div>

        {/* Titles */}
        <h1 class="font-serif text-3xl sm:text-4xl lg:text-5xl xl:text-6xl font-bold text-white mb-4 leading-[1.15] drop-shadow-lg max-w-5xl">
          {pageTitle}
        </h1>
        <h2 class="font-serif text-lg sm:text-2xl lg:text-3xl text-amber-400 italic mb-8 max-w-4xl drop-shadow-md font-medium">
          {pageDesc}
        </h2>

        {/* Author / Date / Time Row */}
        <div class="flex flex-wrap items-center gap-4 sm:gap-6 text-sm text-white/80 border-t border-white/20 pt-6 max-w-3xl">
          <a href={authorData.url} class="flex items-center gap-3 group">
            <div class="w-10 h-10 rounded-full border-2 border-white/30 bg-amber-500/30 flex items-center justify-center font-serif text-amber-300 font-bold text-lg group-hover:border-amber-400 transition-colors">
              R
            </div>
            <span class="font-bold text-white group-hover:text-amber-400 transition-colors flex items-center gap-1.5">
              {authorData.name} 
              <svg class="w-4 h-4 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            </span>
          </a>
          
          <div class="flex items-center gap-2 bg-white/10 px-4 py-2 rounded-full backdrop-blur-sm border border-white/10">
            <svg class="w-4 h-4 opacity-70" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
            <span>{datePrefix} {formattedDate}</span>
          </div>

          <div class="flex items-center gap-2 bg-black/40 px-4 py-2 rounded-full backdrop-blur-sm border border-white/10">
            <svg class="w-4 h-4 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            <span>{post.readingTime || 14} min read</span>
          </div>
        </div>

        {/* Badges */}
        <div class="flex flex-wrap gap-3 mt-8">
          <div class="flex items-center gap-2 text-xs sm:text-sm text-white font-medium bg-black/60 backdrop-blur-md px-3.5 py-2 border border-white/10 rounded-lg shadow-xl">
            <span class="text-amber-400 text-base">🚗</span> Direct Hotel Transfer
          </div>
          <div class="flex items-center gap-2 text-xs sm:text-sm text-white font-medium bg-black/60 backdrop-blur-md px-3.5 py-2 border border-white/10 rounded-lg shadow-xl">
            <span class="text-amber-400 text-base">⏱️</span> Flexible Schedule
          </div>
          <div class="flex items-center gap-2 text-xs sm:text-sm text-white font-medium bg-black/60 backdrop-blur-md px-3.5 py-2 border border-white/10 rounded-lg shadow-xl">
            <span class="text-amber-400 text-base">🌿</span> Ben Dinh & Ben Duoc Choice
          </div>
          <div class="flex items-center gap-2 text-xs sm:text-sm text-white font-medium bg-black/60 backdrop-blur-md px-3.5 py-2 border border-white/10 rounded-lg shadow-xl">
            <span class="text-amber-400 text-base">🛡️</span> Driver Waiting Included
          </div>
        </div>

      </div>
    </section>

    {/* ================= MAIN CONTENT GRID ================= */}
    <div class="max-w-[1600px] mx-auto px-4 sm:px-6 lg:px-12 py-12 lg:py-16">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-start">

        {/* ---------------- LEFT SIDEBAR (TOC) ---------------- */}
        <aside class="hidden lg:block lg:col-span-3 sticky top-24">
          <div class="bg-white rounded-2xl shadow-sm border border-slate-200/60 p-6 overflow-hidden">
            <div class="flex items-center gap-2 font-bold text-slate-900 mb-5 border-l-4 border-amber-500 pl-3 text-sm tracking-wide uppercase">
              Table of Contents
            </div>
            
            <nav class="space-y-1 text-[13.5px] font-medium max-h-[calc(100vh-200px)] overflow-y-auto pr-1">
              <a href="#gioi-thieu" class="flex items-center gap-2 text-amber-900 bg-amber-50/80 px-3 py-2 rounded-lg transition-colors font-bold">
                <span class="text-amber-600 text-base">🏠</span> Introduction
              </a>
              
              <div class="pt-1.5 space-y-1 border-l border-slate-200 ml-3 pl-3">
                {toc.slice(1).map((item) => (
                  <a 
                    href={`#${item.id}`} 
                    class="block transition-colors leading-tight py-1.5 text-slate-600 hover:text-amber-800 font-semibold text-[13px]"
                  >
                    {item.title}
                  </a>
                ))}
              </div>
            </nav>
          </div>
        </aside>

        {/* ---------------- CENTER COLUMN (MAIN CONTENT) ---------------- */}
        <main class="col-span-1 lg:col-span-6 space-y-10">
          
          {/* Quick Overview Stats Bar (Strictly 3 Items) */}
          <div class="bg-white rounded-2xl shadow-sm border border-slate-200/60 p-5 md:p-6 mb-8">
            <div class="grid grid-cols-1 md:grid-cols-3 divide-y md:divide-y-0 md:divide-x divide-slate-100 gap-4 md:gap-0">
              <div class="flex items-center gap-3.5 md:px-4 first:pl-0 last:pr-0">
                <div class="w-11 h-11 rounded-xl bg-amber-50 flex items-center justify-center text-amber-700 text-xl border border-amber-200/80 shrink-0 shadow-xs">🚗</div>
                <div class="min-w-0 flex-1">
                  <div class="text-[10.5px] sm:text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-0.5 leading-tight">Typical Rate</div>
                  <div class="text-[13.5px] sm:text-[14px] font-bold text-slate-900 leading-snug">$65 – $95 (Per Car)</div>
                </div>
              </div>

              <div class="flex items-center gap-3.5 md:px-4 first:pl-0 last:pr-0 pt-3 md:pt-0">
                <div class="w-11 h-11 rounded-xl bg-blue-50 flex items-center justify-center text-blue-700 text-xl border border-blue-200/80 shrink-0 shadow-xs">📍</div>
                <div class="min-w-0 flex-1">
                  <div class="text-[10.5px] sm:text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-0.5 leading-tight">Drive Distance</div>
                  <div class="text-[13.5px] sm:text-[14px] font-bold text-slate-900 leading-snug">50 km (Ben Dinh) / 70 km (Ben Duoc)</div>
                </div>
              </div>

              <div class="flex items-center gap-3.5 md:px-4 first:pl-0 last:pr-0 pt-3 md:pt-0">
                <div class="w-11 h-11 rounded-xl bg-emerald-50 flex items-center justify-center text-emerald-700 text-xl border border-emerald-200/80 shrink-0 shadow-xs">⏰</div>
                <div class="min-w-0 flex-1">
                  <div class="text-[10.5px] sm:text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-0.5 leading-tight">Optimal Departure</div>
                  <div class="text-[13.5px] sm:text-[14px] font-bold text-slate-900 leading-snug">06:30 – 07:00 AM</div>
                </div>
              </div>
            </div>
          </div>

          {/* SECTION: INTRODUCTION */}
          <section id="gioi-thieu" class="scroll-mt-28 space-y-4">
            <div class="prose prose-slate max-w-none prose-p:leading-relaxed prose-p:text-[16px] prose-p:text-slate-700">
              <p>
                Visiting the <strong>Cu Chi Tunnels</strong> (<em>Địa đạo Củ Chi</em>) by private car gives travelers complete control over departure time, hotel pickup, vehicle choice, and the pace of the day. Instead of joining a fixed group itinerary, travelers can arrange a direct transfer to Ben Dinh or Ben Duoc, spend the exact time they need at the historical site, and return to Ho Chi Minh City on a schedule that suits their group.
              </p>

              <div class="font-medium text-slate-900 text-lg border-l-4 border-amber-500 pl-4 my-5 bg-amber-50/50 py-3 rounded-r-xl">
                "The trade-off is straightforward: a private car normally costs more than a shared tour, but the additional cost buys flexibility and privacy rather than simply a faster journey."
              </div>

              {/* Featured In-Article Image */}
              <div class="my-6 not-prose">
                <div class="rounded-2xl overflow-hidden shadow-md border border-slate-200">
                  <img 
                    src="https://media.thericetour.com/uploads/two-girls-posing-rusted-tank-cu-chi-tunnels-the-rice.webp" 
                    alt="Travelers exploring the tranquil open-air grounds at Cu Chi Tunnels - The Rice Tour" 
                    class="w-full h-auto object-cover max-h-[500px]" 
                    width="1280" 
                    height="720" 
                    loading="eager" 
                  />
                </div>
                <p class="text-center text-xs sm:text-sm text-slate-500 italic mt-2.5">
                  Private transportation gives you the flexibility to spend more time exploring quiet woodland historical exhibits at your own pace.
                </p>
              </div>

              <p>
                Alongside central wartime landmarks like the <a href="/independence-palace-saigon-guide" class="text-amber-800 hover:text-amber-900 font-semibold underline underline-offset-2 decoration-amber-300">Independence Palace</a>, the Cu Chi complex remains one of southern Vietnam's defining historical encounters. For couples, families, small groups, and travelers who prefer a direct hotel-to-site transfer, a private car can be a practical way to visit the Cu Chi Tunnels without being tied to multiple hotel pickups or a fixed group schedule.
              </p>
            </div>
          </section>

          <hr class="border-slate-200" />

          {/* SECTION 1: IS A PRIVATE CAR WORTH IT */}
          <section id="is-a-private-car-worth-it" class="scroll-mt-28 space-y-5">
            <div class="border-l-4 border-amber-500 pl-4 mb-4">
              <h2 class="font-serif text-2xl lg:text-[26px] font-bold text-slate-900 leading-tight">
                1. Is A Private Car Worth It For Cu Chi Tunnels?
              </h2>
            </div>

            <div class="text-slate-700 text-[15.5px] leading-relaxed space-y-4">
              <p>
                The answer depends mainly on group size, priorities, and how much flexibility matters.
              </p>
              <p>
                A shared tour is usually designed around a fixed departure time and a common itinerary. Pickup may involve several hotels across District 1, and the group follows the same schedule throughout the excursion. This can be convenient for solo travelers or visitors primarily concerned with keeping transportation costs low.
              </p>
              <p>
                A private car works differently. The vehicle is reserved for one party, so the departure time can be arranged around the travelers' hotel location and preferred visit window. The group can also request a direct itinerary rather than adding stops that are not part of the main visit.
              </p>
              <p>
                This does not mean a private car eliminates traffic or makes the journey dramatically shorter. Its main advantage is <strong>control</strong>.
              </p>

              {/* Callout Box */}
              <div class="bg-amber-50/70 border border-amber-300/80 p-5 rounded-2xl my-6 not-prose">
                <div class="flex items-center gap-2.5 text-amber-900 font-bold text-sm sm:text-base mb-2">
                  <span class="text-lg">💡</span> When Is Private Transportation Most Useful?
                </div>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs sm:text-sm text-amber-950/90 leading-relaxed pt-1">
                  <div class="flex items-center gap-2">• Traveling as a couple or family</div>
                  <div class="flex items-center gap-2">• Traveling with children or seniors</div>
                  <div class="flex items-center gap-2">• Staying outside the central tourist district</div>
                  <div class="flex items-center gap-2">• Wanting an early departure (06:30 AM)</div>
                  <div class="flex items-center gap-2">• Carrying luggage between destinations</div>
                  <div class="flex items-center gap-2">• Preferring direct hotel-to-hotel travel</div>
                  <div class="flex items-center gap-2">• Avoiding multiple group hotel pickups</div>
                  <div class="flex items-center gap-2">• Wanting control over the return hour</div>
                </div>
              </div>

              <p>
                For solo travelers or visitors whose main priority is minimizing transportation costs, a shared tour may remain a simpler option. But for groups of two or more, private hire is often far more practical.
              </p>
            </div>
          </section>

          <hr class="border-slate-200" />

          {/* SECTION 2: 2026 COSTS */}
          <section id="private-car-costs-2026" class="scroll-mt-28 space-y-5">
            <div class="border-l-4 border-amber-500 pl-4 mb-4">
              <h2 class="font-serif text-2xl lg:text-[26px] font-bold text-slate-900 leading-tight">
                2. How Much Does A Private Car To Cu Chi Tunnels Cost In 2026?
              </h2>
            </div>

            <div class="text-slate-700 text-[15.5px] leading-relaxed space-y-4">
              <p>
                Private-car pricing is normally calculated per vehicle rather than per passenger. The final amount depends on the vehicle category, pickup location, number of passengers, itinerary, and whether the service is one-way or round-trip.
              </p>
              <p>
                A useful way to compare quotations is to look at both the <strong>total vehicle price</strong> and the <strong>estimated cost per person</strong>.
              </p>

              {/* Vehicle Pricing Table */}
              <div class="overflow-x-auto my-6">
                <table class="w-full border-collapse bg-white rounded-2xl overflow-hidden shadow-xs border border-slate-200/80 text-sm">
                  <thead>
                    <tr class="bg-slate-900 text-white font-serif">
                      <th class="p-4 font-bold text-left !text-white text-white">Vehicle Option</th>
                      <th class="p-4 font-bold text-center !text-white text-white">Typical Group</th>
                      <th class="p-4 font-bold text-left !text-white text-white">Best Suited To</th>
