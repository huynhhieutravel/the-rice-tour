---
import { env } from 'cloudflare:workers';
import BaseLayout from '../layouts/BaseLayout.astro';
import JsonLdSchema from '../components/seo/JsonLdSchema.astro';
import { safeQueryCritical } from '@/lib/db-client';

export const prerender = false;

// --- DATA CONFIGURATION ---
const currentSlug = "how-far-are-the-cu-chi-tunnels-from-ho-chi-minh-city";

// Fetch post from D1 database with fallback
const d1Db = (env as any)?.dulichcoguu_d1 || (Astro.locals as any)?.runtime?.env?.dulichcoguu_d1;
let post: any = null;
try {
  if (d1Db) {
    post = await safeQueryCritical(
      d1Db.prepare("SELECT * FROM Post WHERE slug = ? AND (status = 'published' OR status = 'publish')").bind(currentSlug).first<any>(),
      { route: Astro.url.pathname, slug: currentSlug, queryType: "fetch_post_by_slug" }
    );
  }
} catch (e) {
  console.warn('[D1 Query Warning] how-far-are-the-cu-chi-tunnels-from-ho-chi-minh-city:', e);
}

// Fallback metadata if D1 query is empty or local
if (!post) {
  post = {
    id: 33742,
    title: "How Far Are The Cu Chi Tunnels From Ho Chi Minh City? Distance & Travel Times (2026)",
    description: "A realistic guide to road distances, travel times, transport options, and door-to-door itinerary planning from Ho Chi Minh City to the Cu Chi Tunnels.",
    slug: currentSlug,
    author: "The Rice Tour Editorial",
    publishedAt: "2026-09-27T08:00:00.000Z",
    updatedAt: "2026-09-27T13:45:00.000Z",
    readingTime: 20,
    category: "Travel Guides",
    featuredImage: "https://media.thericetour.com/uploads/tour-group-listening-briefing-underground-hall-cu-chi-tunnels.webp",
    tags: ["Cu Chi Tunnels", "Ho Chi Minh City", "Vietnam Travel Guide", "Ben Dinh", "Ben Duoc", "Travel Logistics", "Saigon Day Trips"]
  };
}

const pageTitle = post?.title || "How Far Are The Cu Chi Tunnels From Ho Chi Minh City? Distance & Travel Times (2026)";
const pageDescription = post?.excerpt || post?.description || "A realistic guide to road distances, travel times, transport options, and door-to-door itinerary planning from Ho Chi Minh City to the Cu Chi Tunnels.";
const adminEditUrl = post?.id ? `/admin/posts/edit?id=${post.id}` : '/admin/posts/edit?id=33742';

// Format dates
const pubDate = new Date(post.publishedAt);
const updDate = post.updatedAt ? new Date(post.updatedAt) : null;
const isUpdated = updDate && updDate.getTime() > pubDate.getTime();
const displayDate = isUpdated ? updDate : pubDate;
const datePrefix = isUpdated ? "Updated" : "Published";

const formattedDate = displayDate.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric"
});

// Author mapping
const authorMap: Record<string, { name: string; role: string; img: string; url: string }> = {
  "The Rice Tour Editorial": {
    name: "The Rice Tour Editorial",
    role: "Inbound Travel Specialist",
    img: "/images/the-rice-tour-editorial.webp",
    url: "/about-us"
  },
  "Hieu Huynh": {
    name: "Hieu Huynh",
    role: "Founder & Indochina Cultural Guide",
    img: "https://media.fittour.vn/uploads/huynhhieutravel.webp",
    url: "/about-us"
  }
};
const authorData = authorMap[post.author] || authorMap["The Rice Tour Editorial"];

// --- TABLE OF CONTENTS (TOC) ---
const tocItems = [
  { id: "gioi-thieu", title: "Introduction" },
  { id: "at-a-glance", title: "Cu Chi Tunnels Distance At A Glance" },
  { id: "where-located", title: "Where Are The Cu Chi Tunnels Located?" },
  { id: "why-different-distances", title: "Why Do Different Websites Give Different Cu Chi Distances?" },
  { id: "distance-vs-travel-time", title: "Distance vs. Travel Time vs. Tour Duration" },
  { id: "transport-modes", title: "How Long Does It Take From Ho Chi Minh City To Cu Chi?" },
  { id: "why-longer-than-map", title: "Why Cu Chi Takes Longer Than It Looks on a Map" },
  { id: "what-to-do-on-site", title: "What Do You Actually Do During A Cu Chi Visit?" },
  { id: "time-underground", title: "How Long Do You Actually Spend Underground?" },
  { id: "are-tunnels-original", title: "Are The Cu Chi Tunnels You Crawl Through Original?" },
  { id: "tall-travelers", title: "Are The Tunnels Suitable for Tall, Larger, or Senior Travelers?" },
  { id: "ben-dinh-vs-ben-duoc", title: "Ben Dinh vs. Ben Duoc: Which Site Takes Less Time?" },
  { id: "day-budget-breakdown", title: "How Much of Your Day Does a Cu Chi Trip Take?" },
  { id: "visit-without-tour", title: "Can You Visit Cu Chi Tunnels Without a Tour?" },
  { id: "ticket-prices-explained", title: "Why Do Older Websites Show Different Ticket Prices?" },
  { id: "best-departure-time", title: "Best Time to Depart Ho Chi Minh City" },
  { id: "hotel-location-impact", title: "What If Your Hotel Is Not in Central Ho Chi Minh City?" },
  { id: "combining-destinations", title: "Can You Combine Cu Chi with Other Destinations?" },
  { id: "pre-booking-checklist", title: "Pre-Booking Tour Checklist" },
  { id: "frequently-asked-questions", title: "Frequently Asked Questions (FAQ)" },
  { id: "recommended-tours", title: "Curated Cu Chi Journeys from The Rice Tour" },
  { id: "conclusion", title: "Final Planning Takeaway" }
];

// SSR JSON-LD Schemas
const currentOrigin = 'https://thericetour.com';
const canonicalUrl = `${currentOrigin}/${currentSlug}`;

const breadcrumbSchema = {
  items: [
    { name: "Home", url: `${currentOrigin}/` },
    { name: "Travel Guides", url: `${currentOrigin}/blog` },
    { name: pageTitle, url: canonicalUrl }
  ]
};

const faqSchema = {
  questions: [
    {
      question: "How far are the Cu Chi Tunnels from Ho Chi Minh City?",
      answer: "The Cu Chi Tunnels are approximately 70 km northwest of central Ho Chi Minh City, according to Vietnam's official UNESCO World Heritage nomination dossier. Actual road distance varies depending on whether you visit Ben Dinh (~50–55 km) or Ben Duoc (~60–70 km)."
    },
    {
      question: "How long does it take to drive from Ho Chi Minh City to Cu Chi Tunnels?",
      answer: "Allow approximately 1.5 to 2.5 hours each way by road, depending on traffic conditions, your starting district, and whether you visit Ben Dinh or Ben Duoc."
    },
    {
      question: "Is Ben Dinh closer than Ben Duoc?",
      answer: "Yes. Ben Dinh (Nhuan Duc Commune) is roughly 13 to 15 kilometers closer to central Ho Chi Minh City than Ben Duoc (An Nhon Tay Commune). Choosing Ben Dinh typically saves 40 to 60 minutes of round-trip driving time."
    },
    {
      question: "How far apart are Ben Dinh and Ben Duoc?",
      answer: "Ben Dinh and Ben Duoc are separate conserved areas located roughly 13–15 km apart by road across local rural routes. They are not two gates of the same park."
    },
    {
      question: "Can you visit the Cu Chi Tunnels in only 3–4 hours?",
      answer: "A 3–4 hour window is too tight for a road trip from central Ho Chi Minh City. Even with private transport, road traffic makes the journey unpredictable. If your schedule is limited, allow at least half a day (5–6 hours door-to-door) rather than trying to fit Cu Chi between fixed morning and afternoon appointments."
    },
    {
      question: "Can I visit Cu Chi after 10 AM?",
      answer: "Yes. Independent visitors can arrive later in the morning or early afternoon, but the later you leave central Ho Chi Minh City, the less predictable the road journey becomes. If you depart after 10 AM, allow enough time for the visit and return journey rather than planning another fixed activity immediately afterward."
    },
    {
      question: "Can I visit Cu Chi Tunnels without a tour?",
      answer: "Yes. You do not need to book a packaged tour. Independent visitors can travel by private car, Grab, or public bus and join the site's included guided orientation upon arrival."
    },
    {
      question: "Do I have to crawl through the Cu Chi Tunnels?",
      answer: "No. Entering the underground tunnels is completely voluntary. Visitors can comfortably experience Cu Chi by walking the forest trails, viewing concealed trapdoors, and learning from the guide above ground."
    },
    {
      question: "Are the tunnels suitable for tall, larger, or senior travelers?",
      answer: "Visitor-accessible tunnel sections can feel very narrow and restrictive for taller, larger-framed, or elderly travelers. The crawl is optional, and travelers who feel uncomfortable can remain above ground, where most demonstrations and historical briefings take place."
    },
    {
      question: "Are the Cu Chi Tunnels you crawl through original?",
      answer: "The visitor tunnels are preserved historical sections, but they have been restored, reinforced, and widened for visitor safety. They provide an authentic physical impression of guerrilla living conditions rather than an untouched underground network."
    }
  ]
};

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": pageTitle,
  "description": pageDescription,
  "image": post.featuredImage,
  "datePublished": post.publishedAt,
  "dateModified": post.updatedAt || post.publishedAt,
  "author": {
    "@type": "Person",
    "name": authorData.name,
    "jobTitle": authorData.role,
    "url": `${currentOrigin}${authorData.url}`
  },
  "publisher": {
    "@type": "Organization",
    "name": "The Rice Tour",
    "logo": {
      "@type": "ImageObject",
      "url": "https://media.thericetour.com/uploads/logo-the-rice.webp"
    }
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": canonicalUrl
  }
};
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  image={post.featuredImage}
  canonical={canonicalUrl}
  preloadImages={[post.featuredImage]}
  adminEditUrl={adminEditUrl}
  ogType="article"
  lang="en"
>
  <!-- SEO & Structured Data Injection -->
  <Fragment slot="schema">
    <JsonLdSchema type="breadcrumb" data={breadcrumbSchema} />
    <JsonLdSchema type="custom" data={articleSchema} />
    <JsonLdSchema type="faq" data={faqSchema} />
  </Fragment>

  <!-- Breadcrumbs Bar -->
  <div class="bg-slate-900 border-b border-slate-800 text-slate-300 py-3 text-xs sm:text-sm">
    <div class="max-w-[1600px] mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="flex items-center gap-2 overflow-x-auto whitespace-nowrap" aria-label="Breadcrumb">
        <a href="/" class="hover:text-amber-400 transition-colors">Home</a>
        <span class="text-slate-600">/</span>
        <a href="/blog" class="hover:text-amber-400 transition-colors">Travel Guides</a>
        <span class="text-slate-600">/</span>
        <span class="text-amber-300 truncate max-w-[280px] sm:max-w-none">{post.title}</span>
      </nav>
    </div>
  </div>

  <!-- Hero Header (Cinematic Editorial Magazine Style with CMS Hero Background) -->
  <header class="relative bg-slate-950 text-white pt-20 pb-20 sm:pt-24 sm:pb-28 overflow-hidden border-b border-slate-800">
    <!-- Background Image with Multi-layer Gradients -->
    <div class="absolute inset-0 z-0">
      <img 
        src={post.featuredImage} 
        alt={post.title}
        class="w-full h-full object-cover object-center brightness-[0.35] scale-105 transform motion-safe:animate-subtle-zoom"
        width="1920"
        height="1080"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/80 to-slate-950/50"></div>
      <div class="absolute inset-0 bg-gradient-to-r from-slate-950/90 via-slate-950/60 to-transparent"></div>
    </div>

    <!-- Atmospheric Ambient Elements -->
    <div class="absolute inset-0 bg-radial-at-t from-amber-900/20 via-slate-950/40 to-slate-950 pointer-events-none"></div>
    <div class="absolute -top-32 -right-32 w-96 h-96 bg-amber-500/10 rounded-full blur-3xl pointer-events-none"></div>
    
    <div class="relative max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <!-- Title -->
      <h1 class="font-serif text-3xl sm:text-4xl md:text-5xl lg:text-[54px] font-bold text-white tracking-tight leading-[1.15] max-w-4xl mx-auto">
        How Far Are The Cu Chi Tunnels From Ho Chi Minh City?
      </h1>

      <!-- Subtitle -->
      <p class="mt-5 text-base sm:text-lg md:text-xl text-slate-300 max-w-3xl mx-auto leading-relaxed font-light">
        A realistic guide to road distances, travel times, transport options, and door-to-door itinerary planning from Ho Chi Minh City to the Cu Chi Tunnels.
      </p>

      <!-- Author & Metadata Row -->
      <div class="mt-8 flex flex-wrap items-center justify-center gap-4 sm:gap-6 text-xs sm:text-sm text-slate-300">
        <div class="flex items-center gap-3">
          <img 
            src={authorData.img} 
            alt={authorData.name} 
            class="w-10 h-10 rounded-full border border-amber-400/40 object-cover shadow-sm"
            width="40"
            height="40"
            loading="eager"
          />
          <div>
            <div class="font-semibold text-white flex items-center gap-1.5">
              <span>{authorData.name}</span>
              <span class="text-blue-400 text-xs" title="Verified Author">✓</span>
            </div>
            <div class="text-[11px] text-amber-300/90">{authorData.role}</div>
          </div>
        </div>

        <div class="h-8 w-px bg-white/15 hidden sm:block"></div>

        <div>
          <span class="text-slate-400">{datePrefix}:</span> {formattedDate}
        </div>

        <div class="h-8 w-px bg-white/15 hidden sm:block"></div>

        <div class="flex items-center gap-1.5 text-xs sm:text-sm">
          <span>⏱️</span>
          <span>{post.readingTime} min logistics read</span>
        </div>
      </div>
    </div>
  </header>

  <!-- ================= MAIN CONTENT 3-COLUMN LAYOUT ================= -->
  <div class="max-w-[1600px] mx-auto px-4 sm:px-6 lg:px-8 py-10 lg:py-16">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start">

      <!-- LEFT COLUMN: Sticky Table of Contents -->
      <aside class="hidden lg:block lg:col-span-3 sticky top-24">
        <div class="bg-white rounded-2xl shadow-sm border border-slate-200/80 p-5 overflow-hidden">
          <div class="flex items-center gap-2 font-bold text-slate-900 mb-4 border-l-4 border-amber-500 pl-3 text-xs tracking-wider uppercase">
            <span>📑</span> Table of Contents
          </div>

          <nav class="space-y-1 text-[13px] font-medium max-h-[calc(100vh-180px)] overflow-y-auto pr-1">
            <a 
              href="#gioi-thieu" 
              class="flex items-center gap-2 py-2 px-2.5 rounded-lg text-amber-900 bg-amber-50/80 font-bold transition-colors"
            >
              <span>🏠</span> Introduction
            </a>
            
            <div class="pt-1.5 space-y-1 border-l border-slate-200 ml-3 pl-3">
              {tocItems.slice(1).map((item) => (
                <a 
                  href={`#${item.id}`} 
                  class="block py-1.5 px-2 text-slate-600 hover:text-amber-900 hover:bg-slate-50 rounded transition-colors truncate"
                  title={item.title}
                >
                  {item.title}
                </a>
              ))}
            </div>
          </nav>
        </div>
      </aside>

      <!-- CENTER COLUMN: Editorial Content -->
      <main class="col-span-1 lg:col-span-6 space-y-12">

        <!-- Quick Overview Stats Bar (Strictly 3 Items) -->
        <div class="bg-white rounded-2xl shadow-sm border border-slate-200/60 p-5 md:p-6 mb-8">
          <div class="grid grid-cols-1 md:grid-cols-3 divide-y md:divide-y-0 md:divide-x divide-slate-100 gap-4 md:gap-0">
            <div class="flex items-center gap-3.5 md:px-4 first:pl-0 last:pr-0">
              <div class="w-11 h-11 rounded-xl bg-amber-50 flex items-center justify-center text-amber-700 text-xl border border-amber-200/80 shrink-0 shadow-xs">📍</div>
              <div class="min-w-0 flex-1">
                <div class="text-[10.5px] sm:text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-0.5 leading-tight">Geographic Reference</div>
                <div class="text-[13.5px] sm:text-[14px] font-bold text-slate-900 leading-snug">~70 km Northwest</div>
              </div>
            </div>

            <div class="flex items-center gap-3.5 md:px-4 first:pl-0 last:pr-0 pt-3 md:pt-0">
              <div class="w-11 h-11 rounded-xl bg-blue-50 flex items-center justify-center text-blue-700 text-xl border border-blue-200/80 shrink-0 shadow-xs">⏱️</div>
              <div class="min-w-0 flex-1">
                <div class="text-[10.5px] sm:text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-0.5 leading-tight">Road Travel Time</div>
                <div class="text-[13.5px] sm:text-[14px] font-bold text-slate-900 leading-snug">Around 1.5 – 2.5 hrs</div>
              </div>
            </div>

            <div class="flex items-center gap-3.5 md:px-4 first:pl-0 last:pr-0 pt-3 md:pt-0">
              <div class="w-11 h-11 rounded-xl bg-emerald-50 flex items-center justify-center text-emerald-700 text-xl border border-emerald-200/80 shrink-0 shadow-xs">📅</div>
              <div class="min-w-0 flex-1">
                <div class="text-[10.5px] sm:text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-0.5 leading-tight">Door-to-Door Day</div>
                <div class="text-[13.5px] sm:text-[14px] font-bold text-slate-900 leading-snug">Roughly 5 – 8 hrs</div>
              </div>
            </div>
          </div>
        </div>

        <!-- Article Content -->
        <article class="space-y-12 text-slate-800 leading-relaxed font-normal">

          <!-- Section: Introduction -->
          <section id="gioi-thieu" class="scroll-mt-28 space-y-4">
            <div class="text-slate-700 text-[16px] sm:text-[17px] leading-relaxed space-y-4">
              <p>
                Pull up a map on your phone from a hotel lobby in central Ho Chi Minh City, and the Cu Chi Tunnels look deceptively close—a straight line of about 50 to 70 kilometers pointing into the northwestern countryside.
              </p>
              <p>
                Yet ask seasoned local guides how long it takes to get there, and the answer is rarely measured in kilometers. It is measured in highway traffic lights, container truck convoys on National Route 22, and whether you are heading to the bustling entrance at <strong>Ben Dinh</strong> or the quieter historical park at <strong>Ben Duoc</strong>.
              </p>
              <p>
                Vietnam's official heritage nomination files describe the Cu Chi historical complex as sitting roughly <strong>70 km northwest of central Ho Chi Minh City</strong>. But on the ground, your actual odometer reading and travel time depend on three practical factors: where you start in the city, which of the two separate visitor sites you choose (they sit <strong>13 to 15 kilometers apart</strong> from each other), and how early you hit the road.
              </p>
              <p>
                For realistic day planning, forget the straight-line map distance. Plan on spending <strong>1.5 to 2.5 hours in transit each way by car</strong>, and setting aside <strong>5 to 8 hours for the entire door-to-door excursion</strong>.
              </p>

              <!-- Callout Box: Reality Check -->
              <div class="p-5 sm:p-6 rounded-2xl bg-amber-50/80 border border-amber-300 text-slate-800 text-sm sm:text-base leading-relaxed my-6 shadow-xs">
                <div class="font-bold text-amber-950 text-base sm:text-lg mb-2 flex items-center gap-2">
                  <span class="text-xl">💡</span> A Quick Reality Check on Travel Time
                </div>
                <p class="text-slate-800 leading-relaxed">
                  Road mileage in southern Vietnam rarely translates to high speed. Ben Dinh and Ben Duoc are two entirely separate visitor locations, and suburban bottle-necks along Highway 22 can easily stretch a 50-kilometer drive past two hours. Don't build your day around distance—build it around the total door-to-door hours you need from hotel pickup to return drop-off.
                </p>
              </div>

              <!-- Featured Image Inside Body -->
              <div class="my-6 not-prose">
                <div class="rounded-2xl overflow-hidden shadow-md border border-slate-200">
                  <img 
                    src="https://media.thericetour.com/uploads/tour-group-listening-briefing-underground-hall-cu-chi-tunnels.webp" 
                    alt="Tour group listening to a historical guide in an open-air forested pavilion at Cu Chi Tunnels - The Rice Tour" 
                    class="w-full h-auto object-cover max-h-[500px]"
                    width="1280"
                    height="720"
                    loading="eager"
                  />
                </div>
                <p class="text-center text-xs sm:text-sm text-slate-500 italic mt-2.5">
                  Travelers attending an introductory briefing in an open-air forest clearing before exploring the preserved tunnel sectors.
                </p>
              </div>
            </div>
          </section>

          <!-- Section: At a Glance -->
          <section id="at-a-glance" class="scroll-mt-28 space-y-4">
            <div class="border-l-4 border-amber-500 pl-4 mb-4">
              <h2 class="font-serif text-2xl lg:text-[26px] font-bold text-slate-900 leading-tight">
                Cu Chi Tunnels Distance At A Glance
              </h2>
            </div>
            <p class="text-slate-700 text-[16px]">
              Here is a quick snapshot of the practical ground logistics before we look at the specific routes and visitor sites:
            </p>

            <div class="overflow-x-auto my-6">
              <table class="w-full text-left text-sm text-slate-700 border-collapse border border-slate-200 rounded-xl overflow-hidden shadow-2xs">
                <thead class="bg-slate-900 text-white font-serif">
                  <tr>
                    <th class="p-3.5 sm:p-4 font-bold border-b border-slate-800 w-1/3">Planning Question</th>
                    <th class="p-3.5 sm:p-4 font-bold border-b border-slate-800">Practical Ground Reality</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 bg-white">
                  <tr class="hover:bg-slate-50">
                    <td class="p-3.5 sm:p-4 font-semibold text-slate-900">Where are the Cu Chi Tunnels?</td>
                    <td class="p-3.5 sm:p-4">In the rural northwestern countryside of Ho Chi Minh City</td>
                  </tr>
                  <tr class="hover:bg-slate-50">
                    <td class="p-3.5 sm:p-4 font-semibold text-slate-900">Official Heritage Reference</td>
                    <td class="p-3.5 sm:p-4">Roughly 70 km northwest of central Ho Chi Minh City</td>
                  </tr>
                  <tr class="hover:bg-slate-50">
                    <td class="p-3.5 sm:p-4 font-semibold text-slate-900">Ben Dinh vs. Ben Duoc Distance</td>
                    <td class="p-3.5 sm:p-4">Two separate visitor entrances roughly 13–15 km apart by road</td>
                  </tr>
                  <tr class="hover:bg-slate-50">
                    <td class="p-3.5 sm:p-4 font-semibold text-slate-900">Ben Dinh Road Range</td>
                    <td class="p-3.5 sm:p-4">50–55 km from District 1 (closer to the city)</td>
                  </tr>
                  <tr class="hover:bg-slate-50">
                    <td class="p-3.5 sm:p-4 font-semibold text-slate-900">Ben Duoc Road Range</td>
                    <td class="p-3.5 sm:p-4">60–70 km from District 1 (farther northwest into the countryside)</td>
                  </tr>
                  <tr class="hover:bg-slate-50">
                    <td class="p-3.5 sm:p-4 font-semibold text-slate-900">Typical One-Way Drive Time</td>
                    <td class="p-3.5 sm:p-4">1.5–2 hours by private car; 2–2.5+ hours by tour bus</td>
                  </tr>
                  <tr class="hover:bg-slate-50">
                    <td class="p-3.5 sm:p-4 font-semibold text-slate-900">Time Spent on Site</td>
                    <td class="p-3.5 sm:p-4">1.5–2 hours at Ben Dinh; 2.5–3 hours at Ben Duoc (including the memorial)</td>
                  </tr>
                  <tr class="hover:bg-slate-50">
                    <td class="p-3.5 sm:p-4 font-semibold text-slate-900">Actual Time Underground</td>
                    <td class="p-3.5 sm:p-4">3–10 minutes total; crawling is 100% voluntary</td>
                  </tr>
                  <tr class="hover:bg-slate-50">
                    <td class="p-3.5 sm:p-4 font-semibold text-slate-900">Door-to-Door Half-Day Trip</td>
                    <td class="p-3.5 sm:p-4">5–6 hours with a private car; 6–8 hours with a group tour coach</td>
                  </tr>
                  <tr class="hover:bg-slate-50">
                    <td class="p-3.5 sm:p-4 font-semibold text-slate-900">Private Car</td>
                    <td class="p-3.5 sm:p-4">Fastest and most flexible (~1.5h drive each way outside peak rush)</td>
                  </tr>
                  <tr class="hover:bg-slate-50">
