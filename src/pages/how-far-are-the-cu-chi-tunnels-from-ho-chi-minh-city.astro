---
import { env } from 'cloudflare:workers';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { safeQueryCritical } from '@/lib/db-client';
import { getGlobalSettings } from '@/lib/settingsHelper';
import JsonLdSchema from '@/components/seo/JsonLdSchema.astro';

export const prerender = false;

const currentSlug = 'how-far-are-the-cu-chi-tunnels-from-ho-chi-minh-city';

// Fetch post from D1 database with fallback
const d1Db = env?.dulichcoguu_d1 || (Astro.locals as any)?.runtime?.env?.dulichcoguu_d1;
let post: any = null;
try {
  if (d1Db) {
    post = await safeQueryCritical(
      d1Db.prepare("SELECT * FROM Post WHERE slug = ? AND (status = 'published' OR status = 'publish')").bind(currentSlug).first<any>(),
      { route: Astro.url.pathname, slug: currentSlug, queryType: "fetch_post_by_slug" }
    );
  }
} catch (e) {
  console.warn('[D1 Query Warning] how-far-are-the-cu-chi-tunnels-from-ho-chi-minh-city:', e);
}

// Fallback metadata if D1 is not yet populated
if (!post) {
  post = {
    id: 19820,
    title: 'How Far Are The Cu Chi Tunnels From Ho Chi Minh City? Distance & Travel Times',
    slug: currentSlug,
    description: 'Realistic distance and travel times from Ho Chi Minh City to Cu Chi Tunnels: Ben Dinh vs. Ben Duoc road kilometers, transit times, traffic bottlenecks, and door-to-door itinerary planning.',
    featuredImage: 'https://media.thericetour.com/uploads/tour-group-listening-briefing-underground-hall-cu-chi-tunnels.webp',
    publishedAt: '2026-09-27T08:00:00.000Z',
    updatedAt: '2026-09-27T10:00:00.000Z',
    readingTime: 22,
    author: 'The Rice Tour Editorial',
    tags: JSON.stringify(['Cu Chi Tunnels', 'Ho Chi Minh City', 'Vietnam Travel Guide', 'Ben Dinh', 'Ben Duoc', 'Travel Logistics', 'Saigon Day Trips'])
  };
}

const pageTitle = post.title || 'How Far Are The Cu Chi Tunnels From Ho Chi Minh City? Distance & Travel Times';
const pageDesc = post.description || 'Realistic distance and travel times from Ho Chi Minh City to Cu Chi Tunnels: Ben Dinh vs. Ben Duoc road kilometers, transit times, traffic bottlenecks, and door-to-door itinerary planning.';
const seoTitle = `${pageTitle} | The Rice Tour`;
const seoDesc = pageDesc;
const seoImage = post.featuredImage || 'https://media.thericetour.com/uploads/tour-group-listening-briefing-underground-hall-cu-chi-tunnels.webp';

// Author & Date Formatting
const displayDate = post.updatedAt ? new Date(post.updatedAt) : (post.publishedAt ? new Date(post.publishedAt) : new Date());
const formattedDate = displayDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
});
const datePrefix = post.updatedAt ? 'Updated on' : 'Published on';
const createdAtStr = post.publishedAt ? new Date(post.publishedAt).toISOString() : new Date().toISOString();
const updatedAtStr = post.updatedAt ? new Date(post.updatedAt).toISOString() : createdAtStr;

const authorMap: Record<string, { name: string; role: string; img: string; url: string }> = {
  "The Rice Tour Editorial": {
    name: "The Rice Tour Editorial",
    role: "Inbound Travel Specialist",
    img: "/images/the-rice-tour-editorial.webp",
    url: "/about-us"
  },
  "Hieu Huynh": {
    name: "Hieu Huynh",
    role: "Founder & Indochina Cultural Guide",
    img: "https://media.fittour.vn/uploads/huynhhieutravel.webp",
    url: "/about-us"
  }
};
const authorData = authorMap[post.author] || authorMap["The Rice Tour Editorial"];

// --- TABLE OF CONTENTS (TOC) ---
const tocItems = [
  { id: "gioi-thieu", title: "Introduction" },
  { id: "at-a-glance", title: "Cu Chi Tunnels Distance & Travel Times At A Glance" },
  { id: "where-located", title: "Where Are The Cu Chi Tunnels Located?" },
  { id: "why-different-distances", title: "Why Travel Websites List Different Distances" },
  { id: "tripartite-rule", title: "Distance vs. Travel Time vs. Tour Duration" },
  { id: "transport-modes", title: "Travel Times by Transport Mode" },
  { id: "why-longer-than-map", title: "Why Cu Chi Takes Longer Than It Looks on Google Maps" },
  { id: "ben-dinh-vs-ben-duoc", title: "Ben Dinh vs. Ben Duoc: Which Site Takes Less Time?" },
  { id: "day-budget-breakdown", title: "How Much of Your Day Will a Cu Chi Trip Actually Take?" },
  { id: "visit-without-tour", title: "Can You Visit Cu Chi Tunnels Without a Tour?" },
  { id: "best-departure-time", title: "Best Time to Depart Ho Chi Minh City" },
  { id: "hotel-location-impact", title: "What If Your Hotel Is Not in District 1?" },
  { id: "combining-destinations", title: "Can You Combine Cu Chi with Other Destinations?" },
  { id: "pre-booking-checklist", title: "Pre-Booking Tour Checklist" },
  { id: "frequently-asked-questions", title: "Frequently Asked Questions (FAQ)" },
  { id: "recommended-tours", title: "Curated Cu Chi Journeys from The Rice Tour" },
  { id: "conclusion", title: "Final Planning Takeaway" }
];

// SSR JSON-LD Schemas
const currentOrigin = 'https://thericetour.com';
const canonicalUrl = `${currentOrigin}/${currentSlug}`;

const breadcrumbSchema = {
  items: [
    { name: "Home", url: `${currentOrigin}/` },
    { name: "Travel Guides", url: `${currentOrigin}/blog` },
    { name: pageTitle, url: canonicalUrl }
  ]
};

const faqSchema = {
  questions: [
    {
      question: "How far are the Cu Chi Tunnels from downtown Ho Chi Minh City?",
      answer: "The Cu Chi Tunnels are located approximately 50 to 70 kilometers northwest of central Ho Chi Minh City depending on the gate. Ben Dinh is roughly 50 km from District 1, while Ben Duoc is approximately 70 km away. According to Vietnam's 2026 UNESCO Tentative List dossier, the wider heritage area sits approximately 70 km northwest of central Saigon."
    },
    {
      question: "How long does the drive to Cu Chi Tunnels actually take?",
      answer: "A private car or taxi takes approximately 1.5 to 2 hours to reach Ben Dinh, and 2 to 2.5 hours to reach Ben Duoc under standard morning conditions. Shared tourist buses taking multiple passenger pickups often require 2 to 3 hours each way."
    },
    {
      question: "Is Ben Dinh closer than Ben Duoc?",
      answer: "Yes. Ben Dinh is approximately 15 to 20 kilometers closer to central Ho Chi Minh City than Ben Duoc. Choosing Ben Dinh saves approximately 40 to 60 minutes of round-trip driving time."
    },
    {
      question: "How far apart are Ben Dinh and Ben Duoc from each other?",
      answer: "Ben Dinh and Ben Duoc are separate conserved historical sites located roughly 13 kilometers apart across rural district roads. They are not adjacent gates of the same park."
    },
    {
      question: "Can I visit the Cu Chi Tunnels on a half-day trip?",
      answer: "Yes. A half-day trip is the most common format. If you leave early (around 07:30 AM) in a private car to Ben Dinh, you can complete the site tour and return to central District 1 by 01:00 to 01:30 PM, consuming around 5.5 to 6 hours door-to-door."
    },
    {
      question: "Can I take a Grab to the Cu Chi Tunnels?",
      answer: "Yes, booking an outbound Grab from central Saigon is easy and costs approximately 600,000 to 900,000 VND one-way. However, getting an on-demand Grab driver to accept a return ride from rural Cu Chi back to the city can be extremely difficult. If taking Grab, negotiate a waiting fee with your driver to ensure your return transport."
    },
    {
      question: "Is taking the public bus to Cu Chi practical?",
      answer: "The public bus is very affordable (less than 30,000 VND each way) but takes 2.5 to 3.5 hours in each direction. You must board Bus #13 from Ben Thanh Station to Cu Chi Bus Station, then transfer to Bus #79 to reach Ben Duoc. It is practical only for budget backpackers with flexible, unstructured schedules."
    },
    {
      question: "What is the best departure time from Saigon to avoid traffic?",
      answer: "Departing between 07:00 and 07:30 AM is ideal. This window allows your vehicle to pass the An Suong highway interchange before morning rush hour builds, arriving at the tunnels right as the forest opens."
    },
    {
      question: "Do I have to crawl through the tunnels during the visit?",
      answer: "No. Entering the subterranean crawl tunnels is completely voluntary. The majority of the experience consists of shaded walking trails through forest clearings, examining bomb craters, booby-trap demonstrations, and open-air thatch briefing pavilions."
    },
    {
      question: "How much time do you actually spend at the Cu Chi Tunnels site?",
      answer: "A thorough guided visit of either Ben Dinh or Ben Duoc takes roughly 2 to 2.5 hours on the ground. The remaining time of your half-day excursion is consumed by road travel."
    }
  ]
};

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": pageTitle,
  "description": pageDesc,
  "image": seoImage,
  "datePublished": createdAtStr,
  "dateModified": updatedAtStr,
  "author": {
    "@type": "Person",
    "name": authorData.name,
    "url": `${currentOrigin}${authorData.url}`
  },
  "publisher": {
    "@type": "Organization",
    "name": "The Rice Tour",
    "logo": {
      "@type": "ImageObject",
      "url": "https://media.thericetour.com/uploads/logo-the-rice.webp"
    }
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": canonicalUrl
  }
};
---

<BaseLayout 
  title={seoTitle} 
  description={seoDesc} 
  image={seoImage}
  canonical={canonicalUrl}
  preloadImages={[seoImage]}
  adminEditUrl={post?.id ? `/admin/posts/edit/${post.id}` : undefined}
  lang="en"
  ogType="article"
>
  <Fragment slot="schema">
    <JsonLdSchema type="breadcrumb" data={breadcrumbSchema} />
    <JsonLdSchema type="custom" data={articleSchema} />
    <JsonLdSchema type="faq" data={faqSchema} />
  </Fragment>

  <!-- HERO SECTION HEADER (Full-width, Dark Magazine Style) -->
  <header class="relative bg-slate-950 text-white pt-28 pb-20 md:pt-36 md:pb-28 overflow-hidden">
    <!-- Background Image with Multi-layer Gradients -->
    <div class="absolute inset-0 z-0">
      <img 
        src={seoImage} 
        alt={pageTitle}
        class="w-full h-full object-cover object-center brightness-75 scale-105 transform motion-safe:animate-subtle-zoom"
        loading="eager"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/75 to-slate-950/40"></div>
      <div class="absolute inset-0 bg-gradient-to-r from-slate-950/90 via-slate-950/50 to-transparent"></div>
    </div>

    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Breadcrumbs -->
      <nav class="flex items-center gap-2 text-xs sm:text-sm text-slate-300/80 mb-6" aria-label="Breadcrumb">
        <a href="/" class="hover:text-white transition-colors">Home</a>
        <span>/</span>
        <a href="/blog" class="hover:text-white transition-colors">Travel Guides</a>
        <span>/</span>
        <span class="text-amber-400 font-medium truncate max-w-xs sm:max-w-md">{pageTitle}</span>
      </nav>

      <!-- Main Title -->
      <h1 class="font-serif text-3xl sm:text-4xl lg:text-5xl xl:text-6xl font-bold text-white mb-4 leading-[1.15] drop-shadow-lg max-w-5xl">
        {pageTitle}
      </h1>

      <!-- Subtitle -->
      <h2 class="font-serif text-lg sm:text-2xl lg:text-3xl text-amber-400 italic mb-8 max-w-4xl drop-shadow-md font-medium">
        The Ground Reality of Road Kilometers, Highway 22 Traffic Bottlenecks, and Real Door-to-Door Travel Times
      </h2>

      <!-- Lead Paragraph -->
      <p class="text-white/90 text-base sm:text-lg max-w-3xl leading-relaxed mb-8 hidden md:block drop-shadow-md font-normal">
        The Cu Chi Tunnels are often assumed to be a quick suburban taxi ride outside Ho Chi Minh City. In reality, a nominal 50-kilometer distance requires budgeting 1.5 to 2.5 hours each way across suburban trunk roads. Here is the definitive logistical breakdown of distances, transit modes, and door-to-door time commitments for 2026.
      </p>

      <!-- Author Meta Row -->
      <div class="flex flex-wrap items-center gap-4 sm:gap-6 text-xs sm:text-sm text-slate-300 border-t border-white/15 pt-6 max-w-4xl">
        <div class="flex items-center gap-2.5">
          <img 
            src={authorData.img} 
            alt={authorData.name} 
            class="w-9 h-9 rounded-full object-cover border border-amber-400/50 shadow-xs" 
            onerror="this.src='/favicon.png'"
          />
          <div>
            <div class="font-semibold text-white flex items-center gap-1.5">
              <span>{authorData.name}</span>
              <span class="text-blue-400 text-xs" title="Verified Author">✓</span>
            </div>
            <div class="text-[11px] text-amber-300/90">{authorData.role}</div>
          </div>
        </div>

        <div class="h-8 w-px bg-white/15 hidden sm:block"></div>

        <div>
          <span class="text-slate-400">{datePrefix}:</span> {formattedDate}
        </div>

        <div class="h-8 w-px bg-white/15 hidden sm:block"></div>

        <div class="flex items-center gap-1.5 text-xs sm:text-sm">
          <span>⏱️</span>
          <span>{post.readingTime} min logistics read</span>
        </div>
      </div>

      <!-- Badges Line -->
      <div class="flex flex-wrap gap-2.5 sm:gap-3 mt-8">
        <div class="bg-black/60 backdrop-blur-md px-3.5 py-2 border border-white/10 rounded-lg shadow-xl text-xs sm:text-sm text-white font-medium flex items-center gap-2">
          <span>📍</span> ~50 to 70 km Northwest
        </div>
        <div class="bg-black/60 backdrop-blur-md px-3.5 py-2 border border-white/10 rounded-lg shadow-xl text-xs sm:text-sm text-white font-medium flex items-center gap-2">
          <span>⏱️</span> 1.5 to 2.5h Road Travel
        </div>
        <div class="bg-black/60 backdrop-blur-md px-3.5 py-2 border border-white/10 rounded-lg shadow-xl text-xs sm:text-sm text-white font-medium flex items-center gap-2">
          <span>🚗</span> Highway 22 Route Logistics
        </div>
        <div class="bg-black/60 backdrop-blur-md px-3.5 py-2 border border-white/10 rounded-lg shadow-xl text-xs sm:text-sm text-white font-medium flex items-center gap-2">
          <span>🏛️</span> Ben Dinh vs. Ben Duoc
        </div>
      </div>
    </div>
  </header>

  <!-- ================= MAIN CONTENT 3-COLUMN LAYOUT ================= -->
  <div class="max-w-[1600px] mx-auto px-4 sm:px-6 lg:px-8 py-10 lg:py-16">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start">

      <!-- LEFT COLUMN: Sticky Table of Contents -->
      <aside class="hidden lg:block lg:col-span-3 sticky top-24">
        <div class="bg-white rounded-2xl shadow-sm border border-slate-200/80 p-5 overflow-hidden">
          <div class="flex items-center gap-2 font-bold text-slate-900 mb-4 border-l-4 border-amber-500 pl-3 text-xs tracking-wider uppercase">
            <span>📑</span> Table of Contents
          </div>

          <nav class="space-y-1 text-[13px] font-medium max-h-[calc(100vh-180px)] overflow-y-auto pr-1">
            <a 
              href="#gioi-thieu" 
              class="flex items-center gap-2 py-2 px-2.5 rounded-lg text-amber-900 bg-amber-50/80 font-bold transition-colors"
            >
              <span>🏠</span> Introduction
            </a>
            
            <div class="pt-1.5 space-y-1 border-l border-slate-200 ml-3 pl-3">
              {tocItems.slice(1).map((item) => (
                <a 
                  href={`#${item.id}`} 
                  class="block py-1.5 px-2 text-slate-600 hover:text-amber-900 hover:bg-slate-50 rounded transition-colors truncate"
                  title={item.title}
                >
                  {item.title}
                </a>
              ))}
            </div>
          </nav>
        </div>
      </aside>

      <!-- CENTER COLUMN: Editorial Content -->
      <main class="col-span-1 lg:col-span-6 space-y-12">

        <!-- Quick Overview Stats Bar (Strictly 3 Items) -->
        <div class="bg-white rounded-2xl shadow-sm border border-slate-200/60 p-5 md:p-6 mb-8">
          <div class="grid grid-cols-1 md:grid-cols-3 divide-y md:divide-y-0 md:divide-x divide-slate-100 gap-4 md:gap-0">
            <div class="flex items-center gap-3.5 md:px-4 first:pl-0 last:pr-0">
              <div class="w-11 h-11 rounded-xl bg-amber-50 flex items-center justify-center text-amber-700 text-xl border border-amber-200/80 shrink-0 shadow-xs">📍</div>
              <div class="min-w-0 flex-1">
                <div class="text-[10.5px] sm:text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-0.5 leading-tight">Distance Range</div>
                <div class="text-[13.5px] sm:text-[14px] font-bold text-slate-900 leading-snug">~50 – 70 km NW</div>
              </div>
            </div>

            <div class="flex items-center gap-3.5 md:px-4 first:pl-0 last:pr-0 pt-3 md:pt-0">
              <div class="w-11 h-11 rounded-xl bg-blue-50 flex items-center justify-center text-blue-700 text-xl border border-blue-200/80 shrink-0 shadow-xs">⏱️</div>
              <div class="min-w-0 flex-1">
                <div class="text-[10.5px] sm:text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-0.5 leading-tight">Road Transit</div>
                <div class="text-[13.5px] sm:text-[14px] font-bold text-slate-900 leading-snug">1.5 to 2.5 hrs</div>
              </div>
            </div>

            <div class="flex items-center gap-3.5 md:px-4 first:pl-0 last:pr-0 pt-3 md:pt-0">
              <div class="w-11 h-11 rounded-xl bg-emerald-50 flex items-center justify-center text-emerald-700 text-xl border border-emerald-200/80 shrink-0 shadow-xs">📅</div>
              <div class="min-w-0 flex-1">
                <div class="text-[10.5px] sm:text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-0.5 leading-tight">Day Impact</div>
                <div class="text-[13.5px] sm:text-[14px] font-bold text-slate-900 leading-snug">5 to 8 hrs total</div>
              </div>
            </div>
          </div>
        </div>

        <!-- Article Content -->
        <article class="space-y-12 text-slate-800 leading-relaxed font-normal">

          <!-- Section: Introduction -->
          <section id="gioi-thieu" class="scroll-mt-28 space-y-4">
            <div class="text-slate-700 text-[16px] sm:text-[17px] leading-relaxed space-y-4">
              <p>
                The Cu Chi Tunnels are one of the most popular day trips from Ho Chi Minh City, but the answer to "how far are the Cu Chi Tunnels from Ho Chi Minh City?" is never just a single number.
              </p>
              <p>
                Vietnam's 2026 UNESCO World Heritage Tentative List submission places the Cu Chi Tunnels approximately <strong>70 km northwest of central Ho Chi Minh City</strong>. However, actual road distance varies depending on your hotel neighborhood, which visitor sector you select, and the highway route your driver takes.
              </p>
              <p>
                For practical day planning, the far more critical metric is <strong>travel time</strong>. Because of urban traffic choke points along Highway 22, travelers should generally budget <strong>1.5 to 3 hours each way</strong> by road.
              </p>
              <p>
                The two main public visitor areas—<strong>Ben Dinh</strong> and <strong>Ben Duoc</strong>—are distinct, physically separate sites within the wider historical relic zone. Ben Dinh is closer to downtown Saigon (~50 km), while Ben Duoc sits farther northwest (~70 km).
              </p>

              <!-- Callout Quote -->
              <blockquote class="border-l-4 border-amber-500 pl-4 py-3 my-6 bg-amber-50/60 rounded-r-xl italic text-slate-800 font-serif text-[16.5px]">
                "The real planning question is not simply how many kilometers lie between Saigon and Cu Chi. It is how much of your waking day the door-to-door transit will actually consume."
              </blockquote>

              <!-- Featured Image Inside Body -->
              <div class="my-6 not-prose">
                <div class="rounded-2xl overflow-hidden shadow-md border border-slate-200">
                  <img 
                    src="https://media.thericetour.com/uploads/tour-group-listening-briefing-underground-hall-cu-chi-tunnels.webp" 
                    alt="Tour group listening to a historical guide in an open-air forested pavilion at Cu Chi Tunnels - The Rice Tour" 
                    class="w-full h-auto object-cover max-h-[500px]"
                    width="1280"
                    height="720"
                    loading="eager"
                  />
                </div>
                <p class="text-center text-xs sm:text-sm text-slate-500 italic mt-2.5">
                  Travelers attending an introductory briefing in an open-air forest clearing before exploring the preserved tunnel sectors.
                </p>
              </div>
            </div>
          </section>

          <!-- Section: At a Glance -->
          <section id="at-a-glance" class="scroll-mt-28 space-y-4">
            <div class="border-l-4 border-amber-500 pl-4 mb-4">
              <h2 class="font-serif text-2xl lg:text-[26px] font-bold text-slate-900 leading-tight">
                Cu Chi Tunnels Distance & Travel Times At A Glance
              </h2>
            </div>
            <p class="text-slate-700 text-[16px]">
              Before unpacking the geography, review the practical planning metrics summarized below:
            </p>

            <div class="overflow-x-auto my-6">
              <table class="w-full text-left text-sm text-slate-700 border-collapse border border-slate-200 rounded-xl overflow-hidden shadow-2xs">
                <thead class="bg-slate-900 text-white font-serif">
                  <tr>
                    <th class="p-3.5 sm:p-4 font-bold border-b border-slate-800 w-1/3">Planning Question</th>
                    <th class="p-3.5 sm:p-4 font-bold border-b border-slate-800">Practical Ground Reality</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 bg-white">
                  <tr class="hover:bg-slate-50">
                    <td class="p-3.5 sm:p-4 font-semibold text-slate-900">Geographic Direction</td>
                    <td class="p-3.5 sm:p-4">Northwest of central Ho Chi Minh City along the Saigon River basin</td>
                  </tr>
                  <tr class="hover:bg-slate-50">
                    <td class="p-3.5 sm:p-4 font-semibold text-slate-900">UNESCO Reference Distance</td>
                    <td class="p-3.5 sm:p-4">~70 km northwest of central District 1</td>
                  </tr>
                  <tr class="hover:bg-slate-50">
                    <td class="p-3.5 sm:p-4 font-semibold text-slate-900">Actual Road Distance</td>
                    <td class="p-3.5 sm:p-4">~50 km to Ben Dinh; ~70 km to Ben Duoc</td>
                  </tr>
                  <tr class="hover:bg-slate-50">
                    <td class="p-3.5 sm:p-4 font-semibold text-slate-900">Road Travel Time (One Way)</td>
                    <td class="p-3.5 sm:p-4">1.5 to 2 hours for Ben Dinh; 2 to 2.5+ hours for Ben Duoc</td>
                  </tr>
                  <tr class="hover:bg-slate-50">
                    <td class="p-3.5 sm:p-4 font-semibold text-slate-900">Time Spent On-Site</td>
                    <td class="p-3.5 sm:p-4">2 to 2.5 hours of guided walking and exploration</td>
                  </tr>
                  <tr class="hover:bg-slate-50">
                    <td class="p-3.5 sm:p-4 font-semibold text-slate-900">Total Door-to-Door Commitment</td>
                    <td class="p-3.5 sm:p-4">5 to 7 hours for a half-day; 8 to 10 hours for a full-day</td>
                  </tr>
                  <tr class="hover:bg-slate-50">
                    <td class="p-3.5 sm:p-4 font-semibold text-slate-900">Private Car Transit</td>
                    <td class="p-3.5 sm:p-4">1.5 to 2 hours in normal traffic; direct hotel pickup</td>
                  </tr>
                  <tr class="hover:bg-slate-50">
                    <td class="p-3.5 sm:p-4 font-semibold text-slate-900">Group Tour Bus Transit</td>
                    <td class="p-3.5 sm:p-4">2 to 3 hours each way due to multiple hotel pickups and rest stops</td>
                  </tr>
                  <tr class="hover:bg-slate-50">
                    <td class="p-3.5 sm:p-4 font-semibold text-slate-900">Grab / App Taxi</td>
                    <td class="p-3.5 sm:p-4">Viable outbound (~600k–900k VND); return pickup can be difficult</td>
                  </tr>
                  <tr class="hover:bg-slate-50">
                    <td class="p-3.5 sm:p-4 font-semibold text-slate-900">Public Bus Option</td>
                    <td class="p-3.5 sm:p-4">2.5 to 3.5 hours each way (Bus 13 + Bus 79); requires transfers</td>
