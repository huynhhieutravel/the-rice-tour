---
import { env } from 'cloudflare:workers';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { safeQueryCritical } from '@/lib/db-client';
import { getGlobalSettings } from '@/lib/settingsHelper';
import { MapPin, Info, Users, Clock, Calendar, Compass, Share2, Link as LinkIcon, ChevronRight, CheckCircle2 } from 'lucide-react';
import DataPost from '@/components/shortcodes/data/DataPost.astro';

const d1Db = env?.dulichcoguu_d1;
if (!d1Db) return Astro.rewrite("/500");

// Fetch CMS Data for SEO and Metadata
let post;
try {
  post = await safeQueryCritical(
    d1Db.prepare("SELECT * FROM Post WHERE slug = ? AND (status = 'published' OR status = 'publish')").bind('anchorage').first<any>(),
    { route: Astro.url.pathname, slug: 'anchorage', queryType: "fetch_post_by_slug" }
  );
} catch (e) {
  return Astro.rewrite("/500");
}

if (!post) {
  return Astro.rewrite("/404");
}

const { settings } = await getGlobalSettings();

const seoTitle = post.seoTitle || post.title || 'Anchorage Có Gì? Khám Phá Thành Phố Lớn Nhất Alaska';
const seoDesc = post.seoDesc || post.excerpt || 'Anchorage có gì hấp dẫn? Khám phá trọn vẹn thành phố lớn nhất Alaska với cảnh sắc thiên nhiên ngoạn mục, thiên nhiên hoang dã và nền văn hóa bản địa độc đáo.';
const seoImage = post.seoImage || post.featuredImage || 'https://media.fittour.vn/uploads/cang-port-of-alaska-nhin-tu-may-bay.webp'; // Placeholder Alaska image

// --- DATE LOGIC ---
const createdAtStr = post.createdAt || post.publishedAt || new Date().toISOString();
const updatedAtStr = post.updatedAt || createdAtStr;

const createdAt = new Date(createdAtStr.replace(' ', 'T'));
const updatedAt = new Date(updatedAtStr.replace(' ', 'T'));

const isUpdated = updatedAt.getTime() - createdAt.getTime() > 86400000; 
const displayDate = isUpdated ? updatedAt : createdAt;
const datePrefix = isUpdated ? "Cập nhật:" : "Xuất bản:";

const formattedDate = displayDate.toLocaleDateString('vi-VN', { day: '2-digit', month: '2-digit', year: 'numeric' });
// ------------------

// --- AUTHOR LOGIC ---
const authorMap: Record<string, any> = {
  "Max Vũ": {
    name: "Max Vũ",
    url: "/max-vu",
    img: "https://media.fittour.vn/uploads/max-vu-founder-fit-tour.webp"
  },
  "Huy Ngô": {
    name: "Huy Ngô",
    url: "/hdv-huy-ngo",
    img: "https://media.fittour.vn/uploads/hdv-huy-ngo-fittour.webp"
  },
  "Huynh Hieu Travel": {
    name: "Huynh Hieu Travel",
    url: "/huynh-hieu",
    img: "https://media.fittour.vn/uploads/huynhhieutravel.webp"
  }
};
const authorData = authorMap[post.author] || authorMap["Huynh Hieu Travel"];
// ------------------

const adminEditUrl = `/admin/posts/edit?id=${post.id}`;

const tips = [
  {
    "id": "vi-sao-bat-dau-tu-anchorage",
    "name": "Vì Sao Hầu Hết Hành Trình Đều Bắt Đầu Từ Anchorage?",
    "desc": "<p>Anchorage nằm ở phía nam bang Alaska và là thành phố lớn nhất của bang, nơi sinh sống của gần 40% dân số toàn Alaska.</p><p>Đây cũng là nơi đặt <a href=\"https://dot.alaska.gov/anc/\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"font-semibold text-sky-600 hover:text-sky-800\">sân bay quốc tế Ted Stevens Anchorage International Airport</a> – cửa ngõ quan trọng kết nối Alaska với phần còn lại của Hoa Kỳ. Từ đây, du khách dễ dàng tiếp tục hành trình đến Seward, Kenai Fjords National Park, Talkeetna hay <a href=\"/alaska-denali-dinh-nui-cao-nhat-bac-my\" class=\"font-semibold text-sky-600 hover:text-sky-800\" target=\"_blank\">Denali National Park</a>.</p><p>Với nhiều người, Anchorage đơn giản là điểm dừng đầu tiên. Nhưng cũng chính nơi đây giúp bạn làm quen với nhịp sống của Alaska trước khi bước vào những hành trình dài hơn.</p>"
  },
  {
    "id": "dieu-khien-anchorage-khac-biet",
    "name": "Điều Khiến Anchorage Khác Với Nhiều Thành Phố Khác",
    "desc": "<p>Điều khiến Anchorage được yêu thích không nằm ở những công trình nổi tiếng hay khu mua sắm sầm uất.</p><p>Thành phố này mang đến cảm giác rất gần với thiên nhiên.</p><p>Chỉ mất khoảng 15–20 phút từ trung tâm, bạn đã có thể đứng trước Cook Inlet, đi bộ giữa rừng vân sam hoặc nhìn về dãy Chugach Mountains phủ tuyết. Mùa hè, ánh sáng kéo dài đến tận tối muộn khiến việc dạo bộ sau bữa tối trở thành một trải nghiệm rất đặc biệt.</p><p>Đó cũng là lý do nhiều người sau khi rời Anchorage đều nhớ về bầu không khí hơn là những điểm check-in.</p><img src=\"https://media.fittour.vn/uploads/khach-san-highliner-hotel.webp\" alt=\"Khách sạn Highliner Hotel\" class=\"w-full rounded-xl shadow-md my-6\">"
  },
  {
    "id": "di-bo-tren-tony-knowles-coastal-trail",
    "name": "Đi Bộ Trên Tony Knowles Coastal Trail",
    "desc": "<p>Nếu chỉ có vài giờ để khám phá Anchorage, Tony Knowles Coastal Trail là nơi rất đáng ghé.</p><p>Cung đường ven biển dài khoảng 18 km này chạy dọc theo Cook Inlet, đi qua rừng cây, bãi triều và nhiều khoảng không gian mở với tầm nhìn hướng về dãy Chugach Mountains.</p><p>Đi bộ hoặc đạp xe là hai cách phổ biến nhất để khám phá cung đường này. Vào những ngày thời tiết đẹp, bạn có thể bắt gặp đại bàng đầu trắng, nhiều loài chim biển và đôi khi cả <a href=\"/alaska-moose-nai-sung-tam\" class=\"font-semibold text-sky-600 hover:text-sky-800\" target=\"_blank\">nai sừng tấm</a> xuất hiện gần khu vực ven đường.</p><div class=\"grid grid-cols-1 sm:grid-cols-2 gap-4 my-6\"><img src=\"https://media.fittour.vn/uploads/duong-mon-tony-knowles-coastal-trail-cook-inlet.webp\" alt=\"Đường mòn Tony Knowles Coastal Trail\" class=\"w-full rounded-xl shadow-sm\"><img src=\"https://media.fittour.vn/uploads/hai-au-westchester-lagoon.webp\" alt=\"Hải âu trên Westchester Lagoon\" class=\"w-full rounded-xl shadow-sm\"></div>",
    "note": "<p>Trong các đoàn của FIT TOUR, HDV thường sắp xếp ghé Tony Knowles vào buổi chiều đầu tiên sau khi hạ cánh. Sau chuyến bay kéo dài từ Việt Nam, một quãng đi bộ nhẹ giữa không khí mát lạnh của Alaska giúp mọi người thích nghi nhanh hơn trước khi bắt đầu những ngày di chuyển liên tục.</p>"
  },
  {
    "id": "alaska-native-heritage-center",
    "name": "Alaska Native Heritage Center – Văn Hóa Bản Địa",
    "desc": "<p>Thiên nhiên là điều khiến nhiều người tìm đến Alaska, nhưng <a href=\"/alaska-nguoi-ban-dia\" class=\"font-semibold text-sky-600 hover:text-sky-800\" target=\"_blank\">văn hóa bản địa</a> mới là phần tạo nên bản sắc của vùng đất này.</p><p>Alaska Native Heritage Center giới thiệu đời sống của các cộng đồng bản địa thông qua những ngôi nhà truyền thống, cột Totem, hiện vật lịch sử và các hoạt động trình diễn văn hóa.</p><img src=\"https://media.fittour.vn/uploads/cot-totem-alaska-native-heritage-center.webp\" alt=\"Cột Totem tại Alaska Native Heritage Center\" class=\"w-full rounded-xl shadow-md my-4\"><p>Đi dạo quanh khuôn viên, bạn sẽ bắt gặp những ngôi nhà của <a href=\"https://en.wikipedia.org/wiki/Alaskan_Athabaskans\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"font-semibold text-sky-600 hover:text-sky-800\">người Athabascan</a>, bộ xương cá voi, những chiếc thuyền truyền thống và nhiều câu chuyện về cách con người thích nghi với điều kiện tự nhiên khắc nghiệt suốt hàng nghìn năm.</p><div class=\"grid grid-cols-1 sm:grid-cols-2 gap-4 my-6\"><img src=\"https://media.fittour.vn/uploads/nha-go-athabascan-alaska-native-heritage-center.webp\" alt=\"Nhà gỗ Athabascan\" class=\"w-full rounded-xl shadow-sm\"><img src=\"https://media.fittour.vn/uploads/xuong-ca-voi-alaska-native-heritage-center.webp\" alt=\"Xương cá voi trưng bày\" class=\"w-full rounded-xl shadow-sm\"></div>",
    "note": "<p>Theo kinh nghiệm của HDV FIT TOUR, nhiều du khách thường dự tính dành khoảng 30 phút cho địa điểm này. Tuy nhiên, nếu muốn xem các chương trình biểu diễn và khám phá đầy đủ từng khu nhà, bạn nên dành ít nhất 2 giờ.</p>"
  },
  {
    "id": "dao-quanh-downtown-anchorage",
    "name": "Dạo Quanh Downtown Anchorage",
    "desc": "<p>Downtown Anchorage không quá rộng nhưng đủ để dành một buổi chiều thong thả khám phá.</p><p>Những quán cà phê địa phương, cửa hàng lưu niệm, nhà hàng hải sản và các tác phẩm nghệ thuật công cộng tạo nên một không gian rất dễ chịu.</p><p>Một điểm dừng quen thuộc là Anchorage Mushing District, nơi tôn vinh truyền thống đua chó kéo xe – môn thể thao đã trở thành một phần văn hóa của Alaska.</p><img src=\"https://media.fittour.vn/uploads/cong-anchorage-mushing-district.webp\" alt=\"Cổng Anchorage Mushing District\" class=\"w-full rounded-xl shadow-md my-6\"><p>Nếu đến Anchorage vào mùa hè, đây cũng là khu vực thích hợp để tản bộ sau bữa tối khi trời vẫn còn sáng.</p>"
  },
  {
    "id": "nhung-diem-den-dang-ghe-quanh-anchorage",
    "name": "Những Điểm Đến Đáng Ghé Quanh Anchorage",
    "desc": "<p>Nếu có thêm thời gian, từ Anchorage bạn có thể dễ dàng khám phá nhiều điểm đến nổi tiếng chỉ cách trung tâm khoảng 30–90 phút lái xe.</p><h3 class=\"font-serif text-[19px] font-bold text-slate-900 mt-10 mb-4 border-l-[3.5px] border-sky-500 pl-3 leading-snug\">1. Alyeska Aerial Tram</h3><p>Chuyến cáp treo dài khoảng 7 phút đưa du khách lên đỉnh núi Alyeska, nơi có thể ngắm toàn cảnh Turnagain Arm và dãy Chugach Mountains.</p><p>Vào cuối thu hoặc đầu đông, tuyết thường đã phủ trắng khu vực trên cao, tạo nên khung cảnh rất khác so với trung tâm Anchorage.</p><h3 class=\"font-serif text-[19px] font-bold text-slate-900 mt-10 mb-4 border-l-[3.5px] border-sky-500 pl-3 leading-snug\">2. Portage Glacier</h3><p>Portage Glacier là một trong những <a href=\"/alaska-glacier-nhung-dong-song-bang\" class=\"font-semibold text-sky-600 hover:text-sky-800\" target=\"_blank\">sông băng</a> nổi tiếng và dễ tiếp cận nhất gần Anchorage.</p><p>Đây là lựa chọn phù hợp nếu muốn chiêm ngưỡng sông băng nhưng không có nhiều thời gian trekking hoặc tham gia các chuyến tham quan kéo dài.</p><h3 class=\"font-serif text-[19px] font-bold text-slate-900 mt-10 mb-4 border-l-[3.5px] border-sky-500 pl-3 leading-snug\">3. Potter Marsh</h3><p>Potter Marsh là điểm đến được nhiều người yêu thích nếu muốn quan sát chim và động vật hoang dã.</p><p>Lối đi bằng gỗ xuyên qua vùng đầm lầy giúp du khách dễ dàng ngắm đại bàng đầu trắng, chim nước và vào một số thời điểm trong năm còn có cơ hội bắt gặp nai sừng tấm.</p><p>Hoàng hôn là thời điểm đẹp nhất để ghé Potter Marsh.</p><h3 class=\"font-serif text-[19px] font-bold text-slate-900 mt-10 mb-4 border-l-[3.5px] border-sky-500 pl-3 leading-snug\">4. Alaska Wildlife Conservation Center</h3><p>Thay vì một sở thú truyền thống, Alaska Wildlife Conservation Center hoạt động như một trung tâm cứu hộ và bảo tồn động vật hoang dã.</p><p><a href=\"/alaska-gau-nau-alaska\" class=\"font-semibold text-sky-600 hover:text-sky-800\" target=\"_blank\">Gấu nâu</a>, bò xạ, nai sừng tấm, tuần lộc hay sói được chăm sóc trong những khu vực rộng lớn, gần với môi trường sống tự nhiên.</p><p>Nếu muốn quan sát các loài động vật biểu tượng của Alaska ở khoảng cách gần, đây là một trong những địa điểm đáng cân nhắc nhất.</p>"
  },
  {
    "id": "nen-danh-bao-nhieu-ngay-cho-anchorage",
    "name": "Nên Dành Bao Nhiêu Ngày Cho Anchorage?",
    "desc": "<p>Nếu chỉ khám phá trung tâm thành phố, một ngày là đủ.</p><p>Tuy nhiên, nếu muốn kết hợp Tony Knowles Coastal Trail, Alaska Native Heritage Center cùng các điểm lân cận như Alyeska, Portage Glacier hoặc Alaska Wildlife Conservation Center, bạn nên dành từ hai đến ba ngày.</p><p>Đây cũng là khoảng thời gian phù hợp để cơ thể <a href=\"/jet-lag-khi-du-lich-alaska\" class=\"font-semibold text-sky-600 hover:text-sky-800\" target=\"_blank\">thích nghi sau chuyến bay dài</a> trước khi tiếp tục hành trình đến Seward, Kenai Fjords hay Denali.</p>"
  }
];


---

<BaseLayout 
  title={seoTitle} 
  description={seoDesc} 
  image={seoImage}
  preloadImages={[seoImage]}
  adminEditUrl={adminEditUrl}
>
  <div class="bg-[#F8F9FA] text-[#1E293B] font-sans antialiased selection:bg-[#0ea5e9] selection:text-white">

    {/* ================= HERO SECTION ================= */}
    <section class="relative w-full min-h-[600px] lg:min-h-[700px] overflow-hidden flex flex-col justify-center pt-32 pb-20">
      <div class="absolute inset-0 z-0 bg-slate-900">
        <img src={seoImage} alt="Alaska Glacier Landing" class="w-full h-full object-cover object-center opacity-80" fetchpriority="high" loading="eager" decoding="async" />
        <div class="absolute inset-0 bg-gradient-to-r from-black/80 via-black/50 to-transparent"></div>
        <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-transparent to-transparent"></div>
      </div>

      <div class="relative z-10 max-w-[1600px] mx-auto px-4 sm:px-6 lg:px-12 w-full">
        
        {/* Breadcrumb */}
        <div class="flex items-center gap-2 text-[13px] text-white/70 font-medium mb-6">
          <a href="/" class="hover:text-white transition-colors">Trang chủ</a>
          <ChevronRight class="w-3 h-3" />
          <a href="/blog" class="hover:text-white transition-colors">Blog</a>
          <ChevronRight class="w-3 h-3" />
          <span class="text-white">Alaska</span>
        </div>

        {/* Titles */}
        <h1 class="font-serif text-4xl sm:text-5xl lg:text-6xl font-bold text-white mb-4 leading-[1.1] drop-shadow-lg max-w-4xl">
          Anchorage Có Gì? Khám Phá Thành Phố Lớn Nhất Alaska
        </h1>
        <h2 class="font-serif text-xl sm:text-3xl text-sky-400 italic mb-10 max-w-3xl drop-shadow-md">
          Điểm dừng chân lý tưởng trước những hành trình dài tại băng đảo
        </h2>
        <p class="text-white/90 text-base sm:text-lg max-w-2xl leading-relaxed mb-8 hidden md:block drop-shadow-md font-medium">
          Nhắc đến Alaska, nhiều người sẽ nghĩ ngay đến Denali hay những dòng sông băng. Nhưng hầu hết mọi hành trình đều bắt đầu từ Anchorage - nơi giao thoa tuyệt vời giữa thiên nhiên hoang dã và nhịp sống hiện đại.
        </p>

        {/* Author Meta */}
        <div class="flex flex-wrap items-center gap-6 text-sm text-white/80 border-t border-white/20 pt-6 max-w-3xl">
          <a href={authorData.url} class="flex items-center gap-3 group">
            <img src={authorData.img} alt={authorData.name} class="w-10 h-10 rounded-full border-2 border-white/30 object-cover object-top group-hover:border-sky-400 transition-colors" />
            <span class="font-bold text-white group-hover:text-sky-400 transition-colors flex items-center gap-1">
              {authorData.name} 
              <CheckCircle2 class="w-4 h-4 text-blue-400" />
            </span>
          </a>
          <div class="flex items-center gap-2 bg-white/10 px-4 py-2 rounded-full backdrop-blur-sm border border-white/10">
            <Calendar class="w-4 h-4 opacity-70" />
            <span>{datePrefix} {formattedDate}</span>
          </div>
          <div class="flex items-center gap-2 bg-black/20 px-3 py-1.5 rounded-full backdrop-blur-sm">
            <Clock class="w-4 h-4 text-sky-400" />
            <span>{post.readingTime || 12} phút đọc</span>
          </div>
        </div>

        {/* Badges Line */}
        <div class="flex flex-wrap items-center gap-4 mt-8 pt-6">
          <div class="flex items-center gap-2 text-sm text-white font-medium bg-black/60 backdrop-blur-md px-4 py-2 border border-white/10 rounded-lg shadow-xl">
            <span class="text-sky-400 text-lg">⛰️</span> Thiên Nhiên
          </div>
          <div class="flex items-center gap-2 text-sm text-white font-medium bg-black/60 backdrop-blur-md px-4 py-2 border border-white/10 rounded-lg shadow-xl">
            <span class="text-sky-400 text-lg">🦌</span> Động Vật Hoang Dã
          </div>
          <div class="flex items-center gap-2 text-sm text-white font-medium bg-black/60 backdrop-blur-md px-4 py-2 border border-white/10 rounded-lg shadow-xl">
            <span class="text-sky-400 text-lg">🏕️</span> Văn Hóa Bản Địa
          </div>
        </div>

      </div>
    </section>

    {/* ================= MAIN CONTENT GRID ================= */}
    <div class="max-w-[1600px] mx-auto px-4 sm:px-6 lg:px-12 py-12 lg:py-16">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-start">

        {/* ---------------- LEFT SIDEBAR (TOC) ---------------- */}
        <aside class="hidden lg:block lg:col-span-3 sticky top-24">
          <div class="bg-white rounded-2xl shadow-sm border border-slate-200/60 p-6 overflow-hidden">
            <div class="flex items-center gap-2 font-bold text-slate-800 mb-6 border-l-4 border-sky-500 pl-3 text-sm tracking-wide uppercase">
              Mục lục bài viết
            </div>
            
            <nav class="space-y-1 text-[13.5px] font-medium">
              <a href="#gioi-thieu" class="flex items-center gap-2 text-sky-700 bg-sky-50 px-3 py-2.5 rounded-lg transition-colors">
                <span class="text-sky-500 text-base">🏠</span> Giới thiệu
              </a>
              
              <div class="pt-2 pb-1">
                <a href="#danh-sach-12-dieu" class="flex items-center gap-2 text-slate-700 hover:text-sky-800 px-3 py-2 rounded-lg transition-colors font-bold">
                  <span class="text-slate-400 text-base">📋</span> Các nội dung chính
                </a>
                <div class="pl-9 pr-3 space-y-1.5 mt-1 border-l border-slate-100 ml-[18px] max-h-[500px] overflow-y-auto custom-scrollbar">
                  <a href="#nhung-dieu-chua-biet" class="block text-slate-500 hover:text-sky-800 text-[13px] py-1 transition-colors leading-tight">
                    Những Điều Bạn Chưa Biết Về Anchorage
                  </a>
                  {tips.map((m, i) => (
                    <a href={`#${m.id}`} class="block text-slate-500 hover:text-sky-800 text-[13px] py-1 transition-colors leading-tight">
                      {m.name}
                    </a>
                  ))}
                  <a href="#ket-luan" class="block text-slate-500 hover:text-sky-800 text-[13px] py-1 transition-colors leading-tight">
                    Kết Luận
                  </a>
                </div>
              </div>
            </nav>
          </div>
        </aside>

        {/* ---------------- CENTER COLUMN (MAIN CONTENT) ---------------- */}
        <main class="col-span-1 lg:col-span-6 space-y-10">
          
          {/* Quick Overview Stats Bar */}
          <div class="bg-white rounded-2xl shadow-sm border border-slate-200/60 p-6 flex flex-wrap lg:flex-nowrap items-center justify-between gap-4">
            
            <div class="w-full flex items-center justify-between gap-4 mb-2 lg:hidden">
              <span class="font-bold text-slate-800 text-sm border-l-4 border-emerald-500 pl-2 uppercase">Tổng Quan Nhanh</span>
            </div>

