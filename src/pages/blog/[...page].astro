---
import { env } from 'cloudflare:workers';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Pagination from '@/components/ui/Pagination.astro';
import { safeQueryCritical } from '@/lib/db-client';
import { getCanonicalMediaUrl } from '@/lib/imageOptimization';

let { page } = Astro.params;

let currentPage = 1;
if (page) {
  const match = page.match(/^(?:page\/)?(\d+)$/);
  if (match) {
    currentPage = parseInt(match[1], 10);
  } else {
    // If a post slug was accessed under /blog/:slug, 301 redirect to canonical root /:slug
    return Astro.redirect(`/${page}`, 301);
  }
}

const d1Db = env?.dulichcoguu_d1;
if (!d1Db) {
  return Astro.rewrite("/500");
}

const POSTS_PER_PAGE = 12;
const offset = (currentPage - 1) * POSTS_PER_PAGE;
let posts: any[] = [];
let totalPages = 1;

try {
  const countRes = await safeQueryCritical(
    d1Db.prepare("SELECT COUNT(*) as total FROM Post WHERE status = 'published' OR status = 'publish'").first<any>(),
    { route: Astro.url.pathname, queryType: "count_all_posts" }
  );
  
  const totalPosts = countRes?.total || 0;
  totalPages = Math.ceil(totalPosts / POSTS_PER_PAGE);

  const postsRes = await safeQueryCritical(
    d1Db.prepare(`
      SELECT id, slug, title, excerpt, featuredImage 
      FROM Post 
      WHERE status = 'published' OR status = 'publish'
      ORDER BY createdAt DESC
      LIMIT ? OFFSET ?
    `).bind(POSTS_PER_PAGE, offset).all<any>(),
    { route: Astro.url.pathname, queryType: "fetch_all_posts" }
  );
  
  posts = postsRes.results || [];
} catch (e) {
  return Astro.rewrite("/500");
}

const title = `Vietnam Travel Guides & Insights | The Rice Tour ${currentPage > 1 ? `- Page ${currentPage}` : ''}`;
const description = "Discover insider travel guides, cultural nuances, and Vietnam itinerary planning essentials from The Rice Tour destination architects.";
---

<BaseLayout 
  title={title}
  description={description}
>
  <section class="py-16 md:py-24 bg-gray-50 min-h-[60vh]">
    <div class="max-w-[1200px] mx-auto px-4 md:px-8">
      <div class="text-center mb-12 lg:mb-16">
        <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-brand-50 text-brand-700 border border-brand-200 text-xs font-bold uppercase tracking-widest mb-3 shadow-sm">
          Vietnam Travel Journal
        </div>
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-serif font-bold text-gray-900 tracking-tight mb-4">Vietnam Travel Guides</h1>
        <p class="text-gray-600 text-lg max-w-2xl mx-auto font-light leading-relaxed">
          Insider practical advice, cultural nuances, and itinerary planning essentials penned by our in-house destination architects.
        </p>
      </div>

      {posts.length > 0 ? (
        <>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-8 lg:gap-10">
            {posts.map((p: any) => (
              <a href={`/${p.slug}`} class="group bg-white rounded-3xl overflow-hidden border border-gray-200 shadow-sm hover:shadow-xl hover:border-brand-200 transition-all duration-300 flex flex-col justify-between">
                <div>
                  <div class="overflow-hidden bg-gray-100 relative aspect-[16/10]">
                    <img src={p.featuredImage ? getCanonicalMediaUrl(p.featuredImage) : 'https://images.unsplash.com/photo-1528127269322-539801943592?auto=format&fit=crop&w=800&q=80'} alt={p.title} class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" loading="lazy" />
                  </div>
                  <div class="p-6">
                    <h2 class="text-lg md:text-xl font-serif font-bold text-gray-900 mb-3 group-hover:text-brand-600 transition-colors leading-snug line-clamp-2">{p.title}</h2>
                    <p class="text-gray-600 text-sm leading-relaxed line-clamp-3 font-normal">{p.excerpt}</p>
                  </div>
                </div>
                <div class="p-6 pt-0">
                  <span class="inline-flex items-center gap-1 text-xs font-bold text-brand-600 uppercase tracking-wider group-hover:underline">
                    Read Guide →
                  </span>
                </div>
              </a>
            ))}
          </div>
          
          <div class="mt-12">
            <Pagination 
              currentPage={currentPage} 
              totalPages={totalPages} 
              baseUrl="/blog" 
            />
          </div>
        </>
      ) : (
        <div class="text-center py-12 bg-white rounded-3xl border border-gray-200 shadow-sm p-8 max-w-md mx-auto">
          <span class="text-4xl block mb-2">✍️</span>
          <h3 class="font-serif text-lg font-bold text-gray-900 mb-1">Guides Coming Soon</h3>
          <p class="text-gray-500 text-sm">We are crafting new editorial travel guides. Please check back shortly.</p>
        </div>
      )}
    </div>
  </section>
</BaseLayout>
