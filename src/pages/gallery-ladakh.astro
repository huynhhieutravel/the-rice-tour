  <script is:inline>
    document.addEventListener('DOMContentLoaded', function() {
      const loadMoreBtn = document.getElementById('loadMoreBtn');
      const loadMoreContainer = document.getElementById('loadMoreContainer');
      
      if (loadMoreBtn) {
        loadMoreBtn.addEventListener('click', function() {
          const hiddenBoxes = Array.from(document.querySelectorAll('.feature-box.hidden'));
          const boxesToReveal = hiddenBoxes.slice(0, 15);
          
          boxesToReveal.forEach(box => {
            box.classList.remove('hidden');
            const img = box.querySelector('img[data-src]');
            if (img) {
              img.src = img.getAttribute('data-src');
              img.removeAttribute('data-src');
            }
          });

          if (hiddenBoxes.length <= 15) {
            loadMoreContainer.style.display = 'none';
          }
        });
      }
    });
  </script>

