---
import { env } from 'cloudflare:workers';
import { getOptimizedImageUrl } from '@/lib/imageOptimization';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { safeQueryCritical } from '@/lib/db-client';
import CtaBlock from '@/components/ui/CtaBlock.astro';
import SnippetBlock from '@/components/shortcodes/SnippetBlock.astro';
import LadakhTours from '@/components/ladakh/LadakhTours.astro';

const slug = 'gallery-ladakh';
const d1Db = env?.dulichcoguu_d1;

if (!d1Db) {
  return Astro.rewrite("/500");
}

let post;
try {
  post = await safeQueryCritical(
    d1Db.prepare("SELECT * FROM Post WHERE slug = ? AND status = 'published'").bind(slug).first(),
    { route: Astro.url.pathname, slug, queryType: "fetch_post_by_slug" }
  );
} catch (e) {
  return Astro.rewrite("/500");
}

if (!post) {
  return new Response("Post not found", { status: 404 });
}

// Fetch Category
let category = null;
try {
  const catRef = await safeQueryCritical(
    d1Db.prepare("SELECT categoryId FROM PostCategory WHERE postId = ?").bind(post.id).first(),
    { route: Astro.url.pathname, slug, queryType: "fetch_category_ref" }
  );
  if (catRef && catRef.categoryId) {
    category = await safeQueryCritical(
      d1Db.prepare("SELECT * FROM Category WHERE id = ?").bind(catRef.categoryId).first(),
      { route: Astro.url.pathname, slug, queryType: "fetch_category" }
    );
  }
} catch(e) {
  console.error("Error fetching category", e);
}

let anDoSnippet = null;
try {
  anDoSnippet = await safeQueryCritical(
    d1Db.prepare("SELECT * FROM Snippet WHERE slug = 'testimonial-an-do'").first(),
    { route: Astro.url.pathname, slug: "testimonial-an-do", queryType: "fetch_snippet" }
  );
} catch (e) {
  console.error("Failed to fetch snippet", e);
}

const dataMap = {
  snippets: {
    'testimonial-an-do': anDoSnippet
  }
};

const title = post.seoTitle || post.title;
const description = post.seoDescription || post.excerpt || post.title;
const image = post.ogImage || post.featuredImage || '';

Astro.response.headers.set('Cache-Control', 'public, s-maxage=3600, stale-while-revalidate=86400');
