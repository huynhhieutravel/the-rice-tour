---
import { env } from 'cloudflare:workers';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { safeQueryCritical } from '@/lib/db-client';
import { getGlobalSettings } from '@/lib/settingsHelper';
import { MapPin, Info, Users, Clock, Calendar, Compass, Share2, Link as LinkIcon, ChevronRight, CheckCircle2, Star, ThumbsUp, AlertTriangle } from 'lucide-react';
import { foods, foodSummary, vietnameseTaste, restaurants, faqs } from '@/data/am-thuc-ladakh';

const d1Db = env?.dulichcoguu_d1;
if (!d1Db) return Astro.rewrite("/500");

// Fetch CMS Data for SEO and Metadata
let post;
try {
  post = await safeQueryCritical(
    d1Db.prepare("SELECT * FROM Post WHERE slug = ? AND (status = 'published' OR status = 'publish')").bind('am-thuc-ladakh').first<any>(),
    { route: Astro.url.pathname, slug: 'am-thuc-ladakh', queryType: "fetch_post_by_slug" }
  );
} catch (e) {
  return Astro.rewrite("/500");
}

if (!post) {
  return Astro.rewrite("/404");
}

const { settings } = await getGlobalSettings();

const seoTitle = 'Ăn Gì Ở Ladakh? Cẩm Nang Ẩm Thực Từ Đội Ngũ FIT TOUR Sau Hàng Chục Mùa Khảo Sát Himalaya';
const seoDesc = post.seoDesc || post.excerpt || 'Khám phá 10 món ăn đặc sản truyền thống và hấp dẫn nhất của vùng đất Ladakh, Ấn Độ.';
const seoImage = post.seoImage || post.featuredImage || 'https://media.fittour.vn/wp-media/8076-Ladakh-Mien-Chan-Troi-Lang-Thang-O-Himalayas.jpg';

// --- DATE LOGIC ---
const createdAtStr = post.createdAt || post.publishedAt || new Date().toISOString();
const updatedAtStr = "2026-07-12T13:00:00.000Z";

const createdAt = new Date(createdAtStr.replace(' ', 'T'));
const updatedAt = new Date(updatedAtStr.replace(' ', 'T'));

// Nếu ngày cập nhật sau ngày tạo hơn 1 ngày (86400000ms), coi như là bài được update
const isUpdated = updatedAt.getTime() - createdAt.getTime() > 86400000; 
const displayDate = isUpdated ? updatedAt : createdAt;
const datePrefix = isUpdated ? "Cập nhật:" : "Xuất bản:";

const formattedDate = displayDate.toLocaleDateString('vi-VN', { day: '2-digit', month: '2-digit', year: 'numeric' });
// ------------------

const adminEditUrl = `/admin/posts/edit?id=${post.id}`;

// List of monasteries based on the content

// Foods imported from data
;

---

<BaseLayout 
  title={seoTitle} 
  description={seoDesc} 
  image={seoImage}
  adminEditUrl={adminEditUrl}
  preloadImages={[seoImage]}
>
  <div class="bg-[#F8F9FA] text-[#1E293B] font-sans antialiased selection:bg-[#c89845] selection:text-white">

    {/* ================= HERO SECTION ================= */}
    <section class="relative w-full h-[600px] lg:h-[650px] overflow-hidden">
      <div class="absolute inset-0 z-0 bg-slate-900">
        <img src={seoImage} alt={seoTitle} class="w-full h-full object-cover object-center opacity-80" fetchpriority="high" loading="eager" />
        <div class="absolute inset-0 bg-gradient-to-r from-black/80 via-black/50 to-transparent"></div>
        <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-transparent to-transparent"></div>
      </div>

      {/* Removed Torn Paper Effect because of 404 and low contrast skew */}
      <div class="relative z-10 max-w-[1600px] mx-auto px-4 sm:px-6 lg:px-12 h-full flex flex-col justify-center pt-20 pb-16">
        
        {/* Breadcrumb */}
        <!-- IGNORE LINKS -->
        <div class="flex items-center gap-2 text-[13px] text-white/70 font-medium mb-6">
          <a href="/" class="hover:text-white transition-colors">Trang chủ</a>
          <ChevronRight className="w-3 h-3" />
          <a href="/blog" class="hover:text-white transition-colors">Blog</a>
          <ChevronRight className="w-3 h-3" />
          <span class="text-white">Ladakh</span>
        </div>
        <!-- END IGNORE LINKS -->

        {/* Titles */}
        <h1 class="font-serif text-4xl sm:text-5xl lg:text-6xl font-bold text-white mb-4 leading-[1.1] drop-shadow-lg max-w-4xl">
          Top 10 món ăn ẩm thực Ladakh tuyệt vời bạn nên thử
        </h1>
        <h2 class="font-serif text-xl sm:text-3xl text-amber-400 italic mb-10 max-w-3xl drop-shadow-md">
          Khám Phá Tinh Hoa Ẩm Thực Vùng Đất 'Tiểu Tây Tạng'
        </h2>
        <p class="text-white/90 text-base sm:text-lg max-w-2xl leading-relaxed mb-8 hidden md:block drop-shadow-md font-medium">
          Hành trình khám phá <strong class="text-amber-400 font-bold">ẩm thực Ladakh</strong> – nơi giao thoa của hương vị truyền thống, văn hóa Tây Tạng và sự ấm áp của người dân địa phương giữa khí hậu khắc nghiệt của dãy Himalaya.
        </p>

        {/* Author Meta */}
        <div class="flex flex-wrap items-center gap-6 text-sm text-white/80 border-t border-white/20 pt-6 max-w-3xl">
          <a href="/huynh-hieu" class="flex items-center gap-3 group">
            <img src="https://media.fittour.vn/uploads/huynhhieutravel.webp" alt="Huynh Hieu" class="w-10 h-10 rounded-full border-2 border-white/30 object-cover object-top group-hover:border-amber-400 transition-colors" />
            <span class="font-bold text-white group-hover:text-amber-400 transition-colors flex items-center gap-1">
              {post.author || 'Huynh Hieu Travel'} 
              <CheckCircle2 className="w-4 h-4 text-blue-400" />
            </span>
          </a>
          <div class="flex items-center gap-2 bg-white/10 px-4 py-2 rounded-full backdrop-blur-sm border border-white/10">
            <Calendar className="w-4 h-4 opacity-70" />
            <span>{datePrefix} {formattedDate}</span>
          </div>
          <div class="flex items-center gap-2 bg-black/20 px-3 py-1.5 rounded-full backdrop-blur-sm">
            <Clock className="w-4 h-4 text-amber-400" />
            <span>12 phút đọc</span>
          </div>
        </div>

        {/* Badges Line */}
        <div class="flex flex-wrap items-center gap-4 mt-8 pt-6">
          <div class="flex items-center gap-2 text-sm text-white font-medium bg-black/60 backdrop-blur-md px-4 py-2 border border-white/10 rounded-lg shadow-xl">
            <span class="text-amber-400 text-lg">⛰️</span> 10 Món ăn
          </div>
          <div class="flex items-center gap-2 text-sm text-white font-medium bg-black/60 backdrop-blur-md px-4 py-2 border border-white/10 rounded-lg shadow-xl">
            <span class="text-amber-400 text-lg">🪷</span> Đặc sản truyền thống
          </div>
          <div class="flex items-center gap-2 text-sm text-white font-medium bg-black/60 backdrop-blur-md px-4 py-2 border border-white/10 rounded-lg shadow-xl">
            <span class="text-amber-400 text-lg">🎭</span> Hương vị độc đáo
          </div>
          <div class="flex items-center gap-2 text-sm text-white font-medium bg-black/60 backdrop-blur-md px-4 py-2 border border-white/10 rounded-lg shadow-xl">
            <span class="text-amber-400 text-lg">🧭</span> Đậm đà bản sắc
          </div>
        </div>

      </div>
    </section>

    {/* ================= MAIN CONTENT GRID ================= */}
    <div class="max-w-[1600px] mx-auto px-4 sm:px-6 lg:px-12 py-12 lg:py-16">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-start">

        {/* ---------------- LEFT SIDEBAR (TOC) ---------------- */}
        <aside class="hidden lg:block lg:col-span-3 sticky top-24">
          <div class="bg-white rounded-2xl shadow-sm border border-slate-200/60 p-6 overflow-hidden">
            <div class="flex items-center gap-2 font-bold text-slate-800 mb-6 border-l-4 border-amber-500 pl-3 text-sm tracking-wide uppercase">
              Mục lục bài viết
            </div>
            
            <nav class="space-y-1 text-[13.5px] font-medium">
              <a href="#gioi-thieu" class="flex items-center gap-2 text-amber-700 bg-amber-50 px-3 py-2.5 rounded-lg transition-colors">
                <span class="text-amber-500 text-base">🏠</span> Giới thiệu
              </a>
              
              <div class="pt-2 pb-1">
                <a href="#danh-sach-18-tu-vien" class="flex items-center gap-2 text-slate-700 hover:text-amber-600 px-3 py-2 rounded-lg transition-colors font-bold">
                  <span class="text-slate-400 text-base">📋</span> Danh sách 10 món ăn
                </a>
                <div class="pl-9 pr-3 space-y-1.5 mt-1 border-l border-slate-100 ml-[18px] max-h-[500px] overflow-y-auto custom-scrollbar">

                  {foods.map((m: any, i: number) => (
                    <a href={`#${m.id}`} class="block text-slate-500 hover:text-amber-600 text-[13px] py-1 transition-colors leading-tight">
                      {i+1}. {m.name}
                    </a>
                  ))}
                </div>
              </div>
            </nav>
          </div>


        </aside>


        {/* ---------------- CENTER COLUMN (MAIN CONTENT) ---------------- */}
        <main class="col-span-1 lg:col-span-6 space-y-10">
          
          {/* Quick Overview Stats Bar */}
          <div class="bg-white rounded-2xl shadow-sm border border-slate-200/60 p-6 flex flex-wrap lg:flex-nowrap items-center justify-between gap-4">
            <div class="absolute -top-3 left-6 bg-emerald-500 text-white text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded shadow-sm hidden">Tổng Quan Nhanh</div>
            
            <div class="w-full flex items-center justify-between gap-4 mb-2 lg:hidden">
              <span class="font-bold text-slate-800 text-sm border-l-4 border-emerald-500 pl-2 uppercase">Tổng Quan Nhanh</span>
            </div>

            <div class="flex items-center gap-3 w-[48%] lg:w-auto">
              <div class="w-10 h-10 rounded-full bg-emerald-50 flex items-center justify-center text-emerald-600 text-xl border border-emerald-100 shrink-0">⛰️</div>
              <div>
                <div class="text-[11px] text-slate-500 font-medium">Vùng đất</div>
                <div class="text-[13px] font-bold text-slate-800">Ladakh</div>
              </div>
            </div>

            <div class="hidden lg:block w-px h-8 bg-slate-200"></div>

            <div class="flex items-center gap-3 w-[48%] lg:w-auto">
              <div class="w-10 h-10 rounded-full bg-blue-50 flex items-center justify-center text-blue-600 text-xl border border-blue-100 shrink-0">❄️</div>
              <div>
                <div class="text-[11px] text-slate-500 font-medium">Độ cao TB</div>
                <div class="text-[13px] font-bold text-slate-800">3.000 - 4.000m</div>
              </div>
            </div>

            <div class="hidden lg:block w-px h-8 bg-slate-200"></div>

            <div class="flex items-center gap-3 w-[48%] lg:w-auto mt-2 lg:mt-0">
              <div class="w-10 h-10 rounded-full bg-rose-50 flex items-center justify-center text-rose-600 text-xl border border-rose-100 shrink-0">🪷</div>
              <div>
                <div class="text-[11px] text-slate-500 font-medium">Phong cách ẩm thực</div>
                <div class="text-[13px] font-bold text-slate-800">Đậm chất Tây Tạng</div>
              </div>
            </div>

            <div class="hidden lg:block w-px h-8 bg-slate-200"></div>

            <div class="flex items-center gap-3 w-[48%] lg:w-auto mt-2 lg:mt-0">
              <div class="w-10 h-10 rounded-full bg-amber-50 flex items-center justify-center text-amber-600 text-xl border border-amber-100 shrink-0">📅</div>
              <div>
                <div class="text-[11px] text-slate-500 font-medium">Thời điểm đẹp nhất</div>
                <div class="text-[13px] font-bold text-slate-800">Tháng 5 – Tháng 10</div>
              </div>
            </div>
          </div>

          {/* Intro Text */}
          
          <div id="gioi-thieu" class="prose prose-lg max-w-none text-slate-700 mb-10">
            <h2 class="font-serif text-2xl lg:text-[28px] font-bold text-slate-900 border-b-2 border-amber-500 pb-2 inline-block mb-6">Giới Thiệu</h2>
            <p>Bữa ăn đầu tiên ở Leh thường khiến khách Việt bất ngờ. Không phải vì cay, mà vì quá nhạt. Sau gần 10 giờ bay và vừa thích nghi với độ cao hơn 3.500m, nhiều người mong một bát phở nóng. Nhưng thứ chờ họ lại là Thukpa, Butter Tea hay Skyu – những món ăn được tạo ra để giúp con người sống giữa Himalaya lạnh giá.</p>
            <p>Qua hơn 80 chuyến đi và dẫn hơn 700 khách, FIT TOUR đúc kết lại cẩm nang ẩm thực này không chỉ để liệt kê món ăn, mà để giúp bạn chuẩn bị một cái dạ dày thật tốt cho chuyến đi <a href="https://thericetour.com/du-lich-ladakh" target="_blank" class="text-amber-700 font-medium hover:underline" title="Kinh nghiệm du lịch Ladakh">du lịch Ladakh</a> sắp tới.</p>
            <p>Một trong những điều tuyệt vời nhất khi khám phá vùng đất Tiểu Tây Tạng này là trải nghiệm ẩm thực đa dạng do chính người dân địa phương chế biến.</p>
            <figure>
              <img src="https://media.fittour.vn/uploads/mon-an-tai-the-tibetan-kitchen-leh-ladakh.webp" alt="Món ăn tại The Tibetan Kitchen Leh Ladakh" class="w-full rounded-xl shadow-md" />
              <figcaption class="text-center text-sm text-slate-500 italic mt-2">Món ăn truyền thống tại <a href="https://thericetour.com/the-tibetan-kitchen-leh-ladakh" target="_blank" class="text-amber-600 hover:underline">nhà hàng The Tibetan Kitchen, Leh</a></figcaption>
            </figure>
            <p><strong><em>Xem thêm:</em></strong> <a href="/tu-vien-ladakh/" target="_blank" rel="noreferrer noopener">Khám phá các tu viện cổ kính ở Ladakh</a>.</p>
          </div>

          <!-- Bảng Tổng Hợp -->
          <div class="mb-12 bg-white border border-slate-200 rounded-2xl overflow-hidden shadow-sm">
            <div class="bg-amber-50 px-6 py-4 border-b border-amber-100">
              <h3 class="text-lg font-bold text-amber-900">Bảng Tóm Tắt Món Ăn Ladakh</h3>
            </div>
            <div class="overflow-x-auto">
              <table class="w-full text-left text-sm text-slate-700">
                <thead class="bg-slate-50 text-slate-500 font-medium">
                  <tr>
                    <th class="px-6 py-4">Món</th>
                    <th class="px-6 py-4">Nên thử</th>
                    <th class="px-6 py-4">Vị / Ghi chú</th>
                    <th class="px-6 py-4">Giá tham khảo</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                  {foodSummary.map((item: any) => (
                    <tr class="hover:bg-slate-50 transition-colors">
                      <td class="px-6 py-4 font-bold text-slate-900">{item.name}</td>
                      <td class="px-6 py-4 text-amber-500">{item.rating}</td>
                      <td class="px-6 py-4">{item.taste}</td>
                      <td class="px-6 py-4 text-slate-500">{item.price}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>

          <!-- Khẩu vị người Việt -->
          <div class="mb-12 grid grid-cols-1 md:grid-cols-3 gap-6">
            <div class="bg-emerald-50 rounded-2xl p-6 border border-emerald-100">
              <div class="flex items-center gap-3 mb-4">
                <div class="w-10 h-10 rounded-full bg-emerald-100 flex items-center justify-center text-emerald-600">
                  <ThumbsUp className="w-5 h-5" />
                </div>
                <h3 class="font-bold text-emerald-900">Nên ăn ngay</h3>
              </div>
              <ul class="space-y-3">
                {vietnameseTaste.nenAn.map((item: string) => (
                  <li class="flex items-start gap-2 text-emerald-800 text-sm">
                    <CheckCircle2 className="w-4 h-4 mt-0.5 shrink-0 text-emerald-500" />
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </div>
            <div class="bg-amber-50 rounded-2xl p-6 border border-amber-100">
              <div class="flex items-center gap-3 mb-4">
                <div class="w-10 h-10 rounded-full bg-amber-100 flex items-center justify-center text-amber-600">
                  <Info className="w-5 h-5" />
                </div>
                <h3 class="font-bold text-amber-900">Chuẩn bị tinh thần</h3>
              </div>
              <ul class="space-y-3">
                {vietnameseTaste.chuanBiTinhThan.map((item: string) => (
                  <li class="flex items-start gap-2 text-amber-800 text-sm">
                    <Info className="w-4 h-4 mt-0.5 shrink-0 text-amber-500" />
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </div>
            <div class="bg-rose-50 rounded-2xl p-6 border border-rose-100">
              <div class="flex items-center gap-3 mb-4">
                <div class="w-10 h-10 rounded-full bg-rose-100 flex items-center justify-center text-rose-600">
                  <AlertTriangle className="w-5 h-5" />
                </div>
                <h3 class="font-bold text-rose-900">Tránh lúc say độ cao</h3>
              </div>
              <ul class="space-y-3">
                {vietnameseTaste.tranhKhiVuaLen.map((item: string) => (
                  <li class="flex items-start gap-2 text-rose-800 text-sm">
                    <AlertTriangle className="w-4 h-4 mt-0.5 shrink-0 text-rose-500" />
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
  

<div class="flex items-center justify-center py-4 opacity-40">
            <div class="w-16 h-px bg-slate-400"></div>
            <span class="mx-4 text-amber-600 text-xl">🪷</span>
            <div class="w-16 h-px bg-slate-400"></div>
          </div>

          {/* Monasteries List */}
          <div id="danh-sach-18-tu-vien" class="space-y-16">

            
            {foods.map((m: any, index: number) => (
              <div id={m.id} class="bg-white rounded-2xl border border-slate-200 p-8 shadow-sm hover:shadow-md transition-shadow mb-12 scroll-mt-28">
                
                <div class="flex items-center gap-4 mb-8">
                  <div class="w-14 h-14 bg-gradient-to-br from-amber-500 to-amber-600 text-white font-serif font-bold text-2xl flex items-center justify-center rounded-xl shadow-lg shrink-0">
                    {index + 1}
                  </div>
                  <h2 class="font-serif text-2xl lg:text-[28px] font-bold text-slate-900 m-0">{m.name}</h2>
                </div>

                {/* Main Content Area */}
                <div class="space-y-8">
                  {/* Instagram Embed (Full Width) */}
                  {m.embed && (
                    <div class="flex justify-center w-full max-w-[540px] mx-auto overflow-hidden rounded-xl">
                      <div set:html={m.embed} class="w-full"></div>
                    </div>
                  )}

                  {/* Description */}
                  <div class="prose prose-lg max-w-none text-slate-700 prose-p:leading-relaxed prose-a:text-amber-700 hover:prose-a:text-amber-800 prose-img:rounded-xl prose-img:shadow-md" set:html={m.desc}></div>
                  
                  {/* EEAT Block (Grid 3 cols) */}
                  {m.origin && (
                    <div class="mt-8 grid grid-cols-1 md:grid-cols-3 gap-4 border-t border-slate-100 pt-8">
                      <div class="bg-slate-50 p-5 rounded-xl border border-slate-100">
                        <h4 class="font-bold text-slate-800 flex items-center gap-2 mb-3"><Compass className="w-4 h-4 text-amber-600"/> Nguồn gốc</h4>
                        <p class="text-[14.5px] text-slate-600">{m.origin}</p>
                      </div>
                      <div class="bg-slate-50 p-5 rounded-xl border border-slate-100">
                        <h4 class="font-bold text-slate-800 flex items-center gap-2 mb-3"><Users className="w-4 h-4 text-amber-600"/> Khẩu vị Việt Nam</h4>
                        <p class="text-[14.5px] text-slate-600">{m.vietnamese_taste}</p>
                      </div>
                      <div class="bg-amber-50 p-5 rounded-xl border border-amber-100/60 shadow-inner">
                        <h4 class="font-bold text-amber-900 flex items-center gap-2 mb-3"><Star className="w-4 h-4 text-amber-600"/> FIT TOUR Nhận xét</h4>
                        <p class="text-[14.5px] text-amber-800">{m.fittour_recommend}</p>
                      </div>
                    </div>
                  )}
                </div>

              </div>
            ))}
            
            {/* CTA Box */}
            <div class="mt-12 mb-8 bg-gradient-to-r from-amber-500 to-amber-600 rounded-2xl p-8 text-white shadow-lg relative overflow-hidden">
              <div class="relative z-10">
                <h3 class="text-2xl font-bold mb-4">Trải nghiệm ẩm thực thực tế cùng FIT TOUR</h3>
                <p class="text-amber-50 mb-6 max-w-2xl">Với hơn 80 chuyến đi và 700 khách hàng đã đồng hành, FIT TOUR không chỉ thiết kế lịch trình hợp lý mà còn đặc biệt chú trọng đến bữa ăn để đảm bảo sức khỏe cho du khách Việt khi đến vùng đất khắc nghiệt như Ladakh.</p>
                <a href="/country/ladakh/" class="inline-flex bg-white text-amber-700 font-bold px-6 py-3 rounded-lg hover:bg-slate-50 transition-colors shadow-sm">
                  Xem các Tour Ladakh <ChevronRight className="w-4 h-4 ml-1 mt-0.5" />
                </a>
              </div>
              <Compass className="absolute -right-10 -bottom-10 w-64 h-64 text-white/10" />
            </div>
            
            {/* FAQ Section */}
            <div class="mt-16">
              <h3 class="font-serif text-2xl lg:text-[28px] font-bold text-slate-900 border-b-2 border-amber-500 pb-2 inline-block mb-8">Câu hỏi thường gặp</h3>
              <div class="space-y-4">
                {faqs.map((faq: any) => (
                  <details class="group bg-white border border-slate-200 rounded-xl overflow-hidden [&_summary::-webkit-details-marker]:hidden">
                    <summary class="flex items-center justify-between cursor-pointer p-5 font-bold text-slate-800 hover:text-amber-600 transition-colors">
                      <span>{faq.question}</span>
                      <span class="transition group-open:rotate-180">
