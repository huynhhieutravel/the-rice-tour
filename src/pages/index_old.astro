---
import { env } from 'cloudflare:workers';
import BaseLayout from '@/layouts/BaseLayout.astro';
import JsonLdSchema from '@/components/seo/JsonLdSchema.astro';
import OptimizedImage from '@/components/ui/OptimizedImage.astro';
import { getCanonicalMediaUrl } from '@/lib/imageOptimization';
import RelatedEmagazine from '@/components/RelatedEmagazine.astro';
import RelatedBlog from '@/components/RelatedBlog.astro';

const seoData = {
  title: "FIT TOUR | Du lịch có Guu - Hành trình Bespoke",
  description: "FIT TOUR là đơn vị thiết kế hành trình Bespoke chuyên nghiệp. Ưu tiên trải nghiệm nguyên bản, an toàn và trách nhiệm đến cùng. Xem ngay lịch khởi hành!",
  canonicalUrl: `https://thericetour.com/`,
  ogImageUrl: "https://media.fittour.vn/uploads/2022/09/binh-minh-tren-day-nui-himalayas.webp",
};

// Add Link header for AI Agent discovery (RFC 8288 / RFC 9727)
Astro.response.headers.set('Link', '</sitemap-index.xml>; rel="describedby", </llms.txt>; rel="service-doc", </.well-known/api-catalog>; rel="api-catalog"');

// --- DATA FETCHING ---
import { safeQueryOptional } from '@/lib/db-client';
const d1Db = env?.dulichcoguu_d1;

// Mock data as fallback for local dev when DB is not bound
const mockTours = [
  { slug: 'tour-ladakh-roadtrip', title: 'Tour du lịch Ladakh (Ấn Độ) 8N7Đ - Chạm tay vào mây trời', featuredImage: 'https://media.fittour.vn/wp-content/uploads/2023/06/z4408643196947_1ab880e66d5b03f0b2f0a1d4715f36df.jpg', price_number: 38990000, days: '8 Ngày 7 Đêm' },
  { slug: 'tour-trung-quoc-giang-nam', title: 'Hành trình Giang Nam: Thượng Hải - Hàng Châu - Tô Châu', featuredImage: 'https://media.fittour.vn/wp-content/uploads/2024/02/tour-du-lich-giang-nam-trung-quoc.jpg', price_number: 18990000, days: '5 Ngày 4 Đêm' },
  { slug: 'roadtrip-mong-co-12n9d', title: 'Roadtrip Mông Cổ 12N9Đ: Thảo nguyên bao la & Sa mạc Gobi', featuredImage: 'https://media.fittour.vn/wp-content/uploads/2023/12/tour-du-lich-mong-co-fit-tour-2.jpg', price_number: 59990000, days: '12 Ngày 9 Đêm' },
  { slug: 'tour-dao-thanh-a-dinh', title: 'Khám phá Đạo Thành Á Đính - Thiên đường hạ giới', featuredImage: 'https://media.fittour.vn/wp-content/uploads/2023/08/dao-thanh-a-dinh-mua-thu.jpg', price_number: 28990000, days: '8 Ngày 7 Đêm' },
  { slug: 'tour-bhutan-5n4d', title: 'Du lịch Bhutan 5N4Đ: Vương quốc hạnh phúc nhất thế giới', featuredImage: 'https://media.fittour.vn/wp-content/uploads/2022/10/Tiger-Nest.jpg', price_number: 45990000, days: '5 Ngày 4 Đêm' },
  { slug: 'tour-bromo-6n5d', title: 'Chinh phục Bromo & Ijen 6N5Đ - Tuyệt tác núi lửa Indonesia', featuredImage: 'https://media.fittour.vn/wp-content/uploads/2023/02/nui-lua-bromo-indonesia.jpg', price_number: 15990000, days: '6 Ngày 5 Đêm' },
  { slug: 'tour-mong-co-8n7d', title: 'Tour Mông Cổ 8N7Đ: Ngủ Lều Ger, Cưỡi Ngựa Thảo Nguyên', featuredImage: 'https://media.fittour.vn/wp-content/uploads/2023/12/tour-du-lich-mong-co-fit-tour-1.jpg', price_number: 49990000, days: '8 Ngày 7 Đêm' },
  { slug: 'tour-alaska-8n7d', title: 'Hành trình Alaska 8N7Đ: Khám phá sông băng ngoạn mục', featuredImage: 'https://media.fittour.vn/wp-content/uploads/2023/04/alaska.jpg', price_number: 129990000, days: '8 Ngày 7 Đêm' }
];

let signatureTours = mockTours;

if (d1Db) {
  const slugs = mockTours.map(t => t.slug);
  const placeholders = slugs.map(() => '?').join(',');
  const query = `
    SELECT id, slug, title, featuredImage, price_number, price_text, days
    FROM Tour 
    WHERE slug IN (${placeholders})
  `;
  
  const res = await safeQueryOptional(
    d1Db.prepare(query).bind(...slugs).all<any>(),
    { results: [] },
    { route: Astro.url.pathname, queryType: "fetch_signature_tours" }
  );

  if (res && res.results && res.results.length > 0) {
    // Sort to maintain requested order
    signatureTours = res.results.sort((a: any, b: any) => slugs.indexOf(a.slug) - slugs.indexOf(b.slug));
  }
}

// Note: Emagazine and Blog sections are now handled by their respective components.
---

<BaseLayout 
  title={seoData.title} 
  description={seoData.description} 
  image={seoData.ogImageUrl}
  canonical={seoData.canonicalUrl}
>

  <!-- Hero Section -->
  <section class="relative min-h-[90vh] overflow-hidden pt-[20vh] md:pt-[25vh] pb-12">
    <!-- Background Image -->
    <div class="absolute inset-0 z-0">
      <OptimizedImage 
        src="https://media.fittour.vn/uploads/2022/09/binh-minh-tren-day-nui-himalayas.webp" 
        alt="Bình minh trên dãy Himalayas" 
        class="w-full h-full object-cover"
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
        qualityRole="hero"
      />
      <!-- Subtle overlay to ensure readability if needed -->
      <div class="absolute inset-0 bg-black/10"></div>
    </div>

    <!-- Content Container -->
    <div class="max-w-[1440px] w-full mx-auto px-4 md:px-8 relative z-10 py-12 md:py-24">
      <div class="w-full lg:w-1/2 max-w-[720px] bg-[#eaddcf]/95 backdrop-blur-sm rounded-2xl p-8 md:p-10 shadow-2xl border border-white/20">
        <h1 class="text-2xl md:text-[32px] font-black text-slate-900 mb-5 tracking-tight leading-tight">FIT TOUR: Du lịch có Guu</h1>
        
        <div class="space-y-3.5 text-slate-800 leading-relaxed font-medium text-[15px]">
          <p>FIT TOUR là đơn vị thiết kế hành trình Bespoke, sinh ra từ <strong>trải nghiệm thực địa</strong> và tinh thần <strong>làm nghề cẩn trọng</strong>.</p>
          
          <p><strong>Hai năm liên tiếp (2024–2025)</strong>, FIT TOUR được ghi nhận ở hạng mục Bespoke Tour tại HOTLIST Travellive Editors' Pick. Mỗi hành trình được xây dựng dựa trên hồ sơ, nhịp trải nghiệm và chiều sâu mong muốn của từng nhóm khách, với ưu tiên cốt lõi là <strong>an toàn</strong>, trải nghiệm nguyên bản và <strong>trách nhiệm đến cùng</strong>.</p>
          
          <p>Từ những tuyến đường đòi hỏi chiều sâu tổ chức, FIT TOUR chọn <strong>đi chậm, đi kỹ</strong> — để mỗi chuyến đi không chỉ đúng kế hoạch, mà còn chạm đến <strong>giá trị bản địa</strong>.</p>
        </div>

        <div class="mt-6 flex flex-col items-start gap-4">
          <!-- NO Shopping Badge -->
          <div class="inline-flex items-center px-3.5 py-2 bg-[#5c5c5c] text-white rounded-md font-medium text-[13px] shadow-sm">
            <!-- Diamond SVG Icon (Outline) -->
            <svg class="w-3.5 h-3.5 mr-2 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 2l-5.5 8.5 5.5 11.5 5.5-11.5z"></path>
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 2v20"></path>
              <path stroke-linecap="round" stroke-linejoin="round" d="M6.5 10.5h11"></path>
            </svg>
            NO Shopping - Go Deeper
          </div>
          
          <!-- CTA Button -->
          <a href="/tours" class="inline-flex items-center px-6 py-3 bg-[#f99d45] text-white rounded-lg font-bold text-[15px] hover:bg-[#e68a32] transition-all hover:-translate-y-0.5 hover:shadow-md w-full sm:w-auto justify-center">
            Xem Ngay Lịch Khởi Hành
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Signature Tours Section -->
  <section class="py-20 bg-slate-50 border-t border-slate-100">
    <div class="max-w-[1440px] mx-auto px-4 md:px-8">
      
      <!-- Section Header -->
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 gap-4">
        <div>
          <h2 class="text-3xl md:text-4xl font-black text-slate-900 tracking-tight mb-2">Signature Tours</h2>
          <p class="text-slate-500 text-lg">Những hành trình đặc trưng mang dấu ấn làm nghề của FIT TOUR.</p>
        </div>
        <a href="/tours" class="inline-flex items-center text-[#ea580c] font-bold hover:text-[#c2410c] transition-colors group">
          Xem tất cả hành trình
          <svg class="w-5 h-5 ml-1.5 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
          </svg>
        </a>
      </div>
      
      <!-- Grid Layout (TourRadar Style) -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {signatureTours.map((tour: any) => (
          <div class="group relative flex flex-col bg-white rounded-2xl shadow-sm border border-slate-100 hover:shadow-xl transition-all duration-300 overflow-hidden">
            
            <!-- Thumbnail Image -->
            <div class="relative w-full aspect-video overflow-hidden bg-slate-100">
              <OptimizedImage 
                src={tour.featuredImage || ''} 
                alt={tour.title} 
                class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" 
                sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 25vw"
                loading="eager"
                qualityRole="card"
              />
              
              <!-- Hot Badge -->
              <div class="absolute top-3 left-3 bg-[#e84142] text-white text-[11px] font-bold px-2.5 py-1 rounded shadow-sm">
                HOT DEAL
              </div>

            </div>
            
            <!-- Content Area -->
            <div class="p-5 flex flex-col flex-grow relative">
              <a href={`/tour/${tour.slug}`} class="absolute inset-0 z-10" aria-label={`Xem chi tiết tour ${tour.title}`}></a>
              
              <h3 class="text-base font-bold text-slate-900 mb-3 line-clamp-2 leading-snug group-hover:text-[#ea580c] transition-colors">
                {tour.title}
              </h3>
              
              <!-- Meta (Duration) -->
              {tour.days && (
                <div class="flex items-center text-[13px] text-slate-500 mb-5 mt-auto">
                  <svg class="w-4 h-4 mr-1.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                  <span class="font-medium text-slate-600">{tour.days}</span>
                </div>
              )}
              {!tour.days && <div class="mb-5 mt-auto"></div>}
              
              <!-- Price Footer -->
              <div class="flex flex-col border-t border-slate-100 pt-3">
                <span class="text-[12px] text-slate-400 font-medium uppercase tracking-wider mb-0.5">Giá từ</span>
                <div class="flex items-baseline gap-2">
                  <span class="text-lg font-black text-[#e84142]">
                    {tour.price_number ? new Intl.NumberFormat('vi-VN').format(tour.price_number) + ' VNĐ' : tour.price_text || 'Liên hệ'}
                  </span>
                </div>
              </div>
            </div>
            
          </div>
        ))}
      </div>
      
    </div>
  </section>

  <!-- Awards CTA Section -->
  <section class="py-16 bg-white">
    <div class="max-w-[1200px] mx-auto px-4 md:px-8">
      <div class="relative rounded-[2rem] overflow-hidden shadow-2xl bg-[#a01a1a] p-10 md:p-16 flex flex-col items-center text-center">
        <!-- Background Gradient -->
        <div class="absolute inset-0 bg-gradient-to-br from-[#851111] via-[#aa1b1b] to-[#dc2626] opacity-90"></div>
        <!-- Decorative elements -->
        <div class="absolute top-0 left-0 w-64 h-64 bg-white opacity-5 rounded-full blur-3xl -translate-x-1/2 -translate-y-1/2"></div>
        <div class="absolute bottom-0 right-0 w-64 h-64 bg-white opacity-10 rounded-full blur-3xl translate-x-1/3 translate-y-1/3"></div>
        
        <div class="relative z-10 flex flex-col items-center">
          <div class="text-white/80 font-semibold tracking-[0.2em] uppercase mb-4 text-sm md:text-base">Travellive Editor's Pick</div>
          
          <img src="https://media.fittour.vn/uploads/2021/08/fit-tour-best-bespoke-tour-hotlist-white-3.webp" alt="FIT Tour Best Bespoke Tour Hotlist" class="h-16 md:h-20 mb-8 object-contain drop-shadow-xl hover:scale-105 transition-transform duration-500" />
          
          <div class="w-20 h-1 bg-white/40 mb-8 rounded-full"></div>
          
          <p class="text-xl md:text-3xl text-white font-bold mb-4 drop-shadow-md">FIT Tour 2 năm liền đạt Best of Bespoke Tour</p>
          <p class="text-base md:text-lg text-white/90 mb-10 max-w-2xl mx-auto leading-relaxed">Khẳng định "Thương Hiệu" Thiết kế Tour Độc Đáo hàng đầu (2024-2025).</p>
          
          <a href="/gioi-thieu" class="inline-flex items-center px-8 py-4 bg-white text-[#a01a1a] rounded-full font-bold text-[15px] hover:bg-slate-50 hover:-translate-y-1 transition-all shadow-xl uppercase tracking-wide">
            Điều đặc biệt là gì? Xem ngay nào!
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Favorite Destinations Section -->
  <section class="py-20 bg-slate-50 border-t border-slate-100">
    <div class="max-w-[1440px] mx-auto px-4 md:px-8">
      <h2 class="text-3xl md:text-4xl font-black text-slate-900 tracking-tight mb-12 text-center md:text-left">Điểm Đến Được Yêu Thích</h2>
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-12">
        <!-- Himalayas Block -->
        <div>
          <a href="/tours?country=himalayas" class="block relative rounded-[2rem] overflow-hidden aspect-[21/9] mb-6 group shadow-md bg-slate-200">
            <OptimizedImage 
              src="https://media.fittour.vn/uploads/2024/06/nhom-du-khach-tai-ho-pangong-motor-adventures-ladakh-fit-tour.webp" 
              alt="Himalayas" 
              class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" 
              sizes="(max-width: 768px) 100vw, 50vw"
              loading="lazy"
              qualityRole="card"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent"></div>
            <div class="absolute inset-0 p-6 md:p-8 flex items-end justify-between">
              <h3 class="text-2xl md:text-3xl font-bold text-white tracking-wide">Himalayas</h3>
              <span class="px-5 py-2 rounded-full border border-white/40 text-white text-xs md:text-sm font-bold tracking-wider backdrop-blur-sm group-hover:bg-white group-hover:text-black transition-colors">TẤT CẢ</span>
            </div>
          </a>
          <div class="grid grid-cols-2 sm:grid-cols-3 gap-y-4 gap-x-6 px-2">
            <a href="/country/ladakh" class="text-[#ea580c] text-lg font-semibold hover:text-[#c2410c] transition-colors">Ladakh</a>
            <a href="/country/nepal" class="text-[#ea580c] text-lg font-semibold hover:text-[#c2410c] transition-colors">Nepal</a>
            <a href="/country/bhutan" class="text-[#ea580c] text-lg font-semibold hover:text-[#c2410c] transition-colors">Bhutan</a>
            <a href="/country/tay-tang" class="text-slate-700 text-lg font-semibold hover:text-[#ea580c] transition-colors">Tây Tạng</a>
            <a href="/country/sikkim" class="text-slate-700 text-lg font-semibold hover:text-[#ea580c] transition-colors">Sikkim</a>
          </div>
        </div>

        <!-- Trung Đông & Châu Phi Block -->
        <div>
          <a href="/tours?country=trung-dong" class="block relative rounded-[2rem] overflow-hidden aspect-[21/9] mb-6 group shadow-md bg-slate-200">
            <OptimizedImage 
              src="https://media.fittour.vn/uploads/2023/01/du-khach-cuoi-lac-da-ngam-kim-tu-thap-ai-cap.webp" 
              alt="Trung Đông" 
              class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" 
              sizes="(max-width: 768px) 100vw, 50vw"
              loading="lazy"
              qualityRole="card"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent"></div>
            <div class="absolute inset-0 p-6 md:p-8 flex items-end justify-between gap-4">
              <h3 class="text-2xl md:text-3xl font-bold text-white tracking-wide">Trung Đông</h3>
              <div class="flex gap-2">
                <span class="px-4 md:px-5 py-2 rounded-full border border-white/40 text-white text-xs md:text-sm font-bold tracking-wider backdrop-blur-sm group-hover:bg-white group-hover:text-black transition-colors whitespace-nowrap">TRUNG ĐÔNG</span>
                <span class="px-4 md:px-5 py-2 rounded-full border border-white/40 text-white text-xs md:text-sm font-bold tracking-wider backdrop-blur-sm group-hover:bg-white group-hover:text-black transition-colors whitespace-nowrap hidden sm:inline-block">CHÂU PHI</span>
              </div>
            </div>
          </a>
          <div class="grid grid-cols-2 sm:grid-cols-3 gap-y-4 gap-x-6 px-2">
            <a href="/country/ai-cap" class="text-[#ea580c] text-lg font-semibold hover:text-[#c2410c] transition-colors">Ai Cập</a>
            <a href="/country/pakistan" class="text-slate-700 text-lg font-semibold hover:text-[#ea580c] transition-colors">Pakistan</a>
            <a href="/country/ma-roc" class="text-[#ea580c] text-lg font-semibold hover:text-[#c2410c] transition-colors">Ma Rốc</a>
            <a href="/country/iran" class="text-slate-700 text-lg font-semibold hover:text-[#ea580c] transition-colors">Iran</a>
            <a href="/country/qatar" class="text-slate-700 text-lg font-semibold hover:text-[#ea580c] transition-colors">Qatar</a>
          </div>
        </div>

        <!-- Châu Á Block -->
        <div>
          <a href="/tours?country=chau-a" class="block relative rounded-[2rem] overflow-hidden aspect-[21/9] mb-6 group shadow-md bg-slate-200">
            <OptimizedImage 
              src="https://media.fittour.vn/uploads/2024/05/nhung-doa-hoa-no-ro-ven-cac-ngoi-nha-co-kinh-tao-nen-khung-canh-nen-tho-tai-o-tran.webp" 
              alt="Châu Á" 
              class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" 
              sizes="(max-width: 768px) 100vw, 50vw"
              loading="lazy"
              qualityRole="card"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent"></div>
            <div class="absolute inset-0 p-6 md:p-8 flex items-end justify-between">
              <h3 class="text-2xl md:text-3xl font-bold text-white tracking-wide">Châu Á</h3>
              <span class="px-5 py-2 rounded-full border border-white/40 text-white text-xs md:text-sm font-bold tracking-wider backdrop-blur-sm group-hover:bg-white group-hover:text-black transition-colors">TẤT CẢ</span>
            </div>
          </a>
          <div class="grid grid-cols-2 sm:grid-cols-3 gap-y-4 gap-x-6 px-2">
            <a href="/country/mong-co" class="text-[#ea580c] text-lg font-semibold hover:text-[#c2410c] transition-colors">Mông Cổ</a>
            <a href="/country/trung-quoc" class="text-[#ea580c] text-lg font-semibold hover:text-[#c2410c] transition-colors">Trung Quốc</a>
            <a href="/country/indonesia" class="text-[#ea580c] text-lg font-semibold hover:text-[#c2410c] transition-colors">Indonesia</a>
            <a href="/country/nhat-ban" class="text-slate-700 text-lg font-semibold hover:text-[#ea580c] transition-colors">Nhật Bản</a>
            <a href="/country/han-quoc" class="text-slate-700 text-lg font-semibold hover:text-[#ea580c] transition-colors">Hàn Quốc</a>
          </div>
        </div>

        <!-- Châu Âu & Châu Mỹ Block -->
        <div>
          <a href="/tours?country=chau-my" class="block relative rounded-[2rem] overflow-hidden aspect-[21/9] mb-6 group shadow-md bg-slate-200">
            <OptimizedImage 
              src="https://media.fittour.vn/uploads/2021/08/danh-sach-tour-chau-au-fit-tour.webp" 
              alt="Châu Âu & Châu Mỹ" 
              class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" 
              sizes="(max-width: 768px) 100vw, 50vw"
              loading="lazy"
              qualityRole="card"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent"></div>
            <div class="absolute inset-0 p-6 md:p-8 flex items-end justify-between gap-4">
              <h3 class="text-2xl md:text-3xl font-bold text-white tracking-wide">Châu Mỹ & Châu Âu</h3>
              <div class="flex gap-2">
                <span class="px-4 md:px-5 py-2 rounded-full border border-white/40 text-white text-xs md:text-sm font-bold tracking-wider backdrop-blur-sm group-hover:bg-white group-hover:text-black transition-colors whitespace-nowrap">CHÂU MỸ</span>
                <span class="px-4 md:px-5 py-2 rounded-full border border-white/40 text-white text-xs md:text-sm font-bold tracking-wider backdrop-blur-sm group-hover:bg-white group-hover:text-black transition-colors whitespace-nowrap hidden sm:inline-block">CHÂU ÂU</span>
              </div>
            </div>
          </a>
          <div class="grid grid-cols-2 sm:grid-cols-3 gap-y-4 gap-x-6 px-2">
            <a href="/country/alaska" class="text-[#ea580c] text-lg font-semibold hover:text-[#c2410c] transition-colors">Alaska</a>
            <a href="/country/nam-my" class="text-slate-700 text-lg font-semibold hover:text-[#ea580c] transition-colors">Nam Mỹ</a>
            <a href="/country/bac-au" class="text-[#ea580c] text-lg font-semibold hover:text-[#c2410c] transition-colors">Bắc Âu</a>
            <a href="/country/tay-ban-nha" class="text-slate-700 text-lg font-semibold hover:text-[#ea580c] transition-colors">Tây Ban Nha</a>
