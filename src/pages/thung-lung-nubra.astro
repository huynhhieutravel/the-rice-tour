---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/ladakh-co-may.css';
import '../styles/blog.css';
import '../styles/author-card.css';
import App from '../components/ReactApp/ThungLungNubra/App.tsx';
import MemoryMap from '../components/ReactApp/ThungLungNubra/components/MemoryMap.tsx';
import Backpack from '../components/ReactApp/ThungLungNubra/components/Backpack.tsx';
import PhotoGallery from '../components/ReactApp/ThungLungNubra/components/PhotoGallery.tsx';
import FaqSection from '../components/ReactApp/ThungLungNubra/components/FaqSection.tsx';
import Guestbook from '../components/ReactApp/ThungLungNubra/components/Guestbook.tsx';
import RelatedArticles from '../components/ReactApp/ThungLungNubra/components/RelatedArticles.tsx';
import SignatureTour from '../components/ReactApp/ThungLungNubra/components/SignatureTour.tsx';
import FooterApp from '../components/ReactApp/ThungLungNubra/components/FooterApp.tsx';
import FloatingButton from '../components/ReactApp/ThungLungNubra/components/FloatingButton.tsx';
import { env } from 'cloudflare:workers';
import { sanitizeElementorHtml } from '../lib/elementorSanitizer';
import { parseShortcodes } from '../utils/shortcodes/parser';
import ShortcodeRenderer from '../components/shortcodes/ShortcodeRenderer.astro';
import { fetchAllShortcodeData } from '../utils/shortcodes/dataLoader';

const d1Db = env?.dulichcoguu_d1;

let seoTitle = "Thung lũng Nubra Ladakh – Hình ảnh và hướng dẫn du lịch";
let seoDesc = "Thung lũng Nubra là một trong những nơi PHẢI THAM QUAN ở Ladakh, đặc biệt nếu bạn đến thăm lần đầu tiên. Cẩm nang lịch trình Leh - Khardung La - Diskit - Hunder.";
let seoImage = "https://media.fittour.vn/uploads/2022/06/cuoi-lac-da-o-thung-lung-nubra-ladakh.webp";
let adminEditUrl = "";
let rawHtml = "";

if (d1Db) {
  try {
    const stmt = d1Db.prepare(`SELECT id, title, content, seoTitle as metaTitle, seoDescription as metaDescription, featuredImage FROM Post WHERE slug = 'thung-lung-nubra' LIMIT 1`);
    const postData = await stmt.first();
    if (postData) {
      seoImage = postData.featuredImage || seoImage;
      if (postData.id) adminEditUrl = `/admin/posts/edit?id=${postData.id}`;
      rawHtml = postData.content || "";
    }
  } catch (e) {
    console.error("Lỗi lấy SEO data cho trang thung-lung-nubra:", e);
  }
}

// Prepare the old content
const cleanHtml = sanitizeElementorHtml(rawHtml, seoImage, true);
const astNodes = parseShortcodes(cleanHtml);
const dataMap = await fetchAllShortcodeData(astNodes, d1Db);

---
<BaseLayout
  title={seoTitle}
  description={seoDesc}
  image={seoImage}
  canonical="https://thericetour.com/thung-lung-nubra"
  adminEditUrl={adminEditUrl}
>
  <Fragment slot="head">
    <link rel="preload" as="image" href={seoImage} fetchpriority="high" />
    <meta property="og:type" content="article" />
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&family=JetBrains+Mono:wght@400;500;700&display=swap">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&family=JetBrains+Mono:wght@400;500;700&display=swap" media="print" onload="this.media='all'">
    <noscript>
      <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&family=JetBrains+Mono:wght@400;500;700&display=swap">
    </noscript>
    
    <!-- Using the standard blog CSS for the prose content below the React App (imported in frontmatter) -->

    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Article",
          "headline": seoTitle,
          "description": seoDesc,
          "image": seoImage,
          "author": {
            "@type": "Person",
            "name": "Huy Ngô",
            "url": "https://thericetour.com/author/huy-ngo"
          },
          "publisher": {
            "@type": "Organization",
            "name": "FIT Tour",
            "logo": {
              "@type": "ImageObject",
              "url": "https://media.thericetour.com/uploads/logo-the-rice.webp"
            }
          },
          "datePublished": "2026-09-01T08:00:00+08:00",
          "dateModified": "2026-09-01T08:00:00+08:00",
          "mainEntityOfPage": {
            "@type": "WebPage",
            "@id": "https://thericetour.com/thung-lung-nubra"
          }
        },
        {
          "@type": "FAQPage",
          "mainEntity": [
            {
              "@type": "Question",
              "name": "Nubra hay Pangong nên đi trước?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Bạn nên đi Nubra trước. Nubra có độ cao trung bình khoảng 3.000m (thấp hơn Leh). Việc ngủ đêm tại một nơi thấp như Nubra sau khi vượt đèo Khardung La sẽ giúp cơ thể thích nghi độ cao (acclimatization) cực kỳ hiệu quả."
              }
            },
            {
              "@type": "Question",
              "name": "Có nên ở Nubra 1 hay 2 đêm?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Nên ở 2 đêm. Thung lũng rất rộng và có nhiều điểm đến khác biệt. Nếu chỉ đi 1 đêm, bạn sẽ phải di chuyển liên tục trên xe, không đủ thời gian tận hưởng sự tương phản tuyệt đẹp của thiên nhiên và văn hóa nơi đây."
              }
            },
            {
              "@type": "Question",
              "name": "Có nên ngủ Hunder hay Diskit?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Đa số du khách ưu tiên ngủ tại Hunder hơn vì có nhiều resort lều trại cao cấp nằm giữa rừng dương hoặc ngay gần đồi cát sa mạc lạnh, yên tĩnh và lãng mạn hơn."
              }
            },
            {
              "@type": "Question",
              "name": "Thung lũng Nubra nằm ở đâu?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Thung lũng Nubra nằm ở phía đông bắc của Ladakh, Ấn Độ, cách thị trấn Leh khoảng 120 km. Trung tâm của thung lũng là làng Diskit."
              }
            }
          ]
        }
      ]
    })} />
  </Fragment>

  <main class="min-h-screen bg-stone-50 text-stone-800 font-sans selection:bg-amber-150 selection:text-amber-900 overflow-x-hidden antialiased">
    <App client:load featureImage={seoImage} /> 
    <MemoryMap client:visible />
    <Backpack client:visible />
    <PhotoGallery client:visible />
    <FaqSection client:visible />
    <Guestbook client:visible />
    <RelatedArticles client:visible />
    <SignatureTour client:visible />
    <FooterApp client:visible />
    <FloatingButton client:load />
  </main>

</BaseLayout>
