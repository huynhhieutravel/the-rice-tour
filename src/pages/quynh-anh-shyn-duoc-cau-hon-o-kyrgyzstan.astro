---
import BaseLayout from '../layouts/BaseLayout.astro';
import RelatedArticles from '../components/ReactApp/HoTsoMoriri/components/RelatedArticles.tsx';
import { env } from 'cloudflare:workers';

const d1Db = env?.dulichcoguu_d1;

let seoTitle = "Quỳnh Anh Shyn Được Cầu Hôn Ở Kyrgyzstan";
let seoDesc = "Vì Sao Những Khoảnh Khắc Đẹp Nhất Thường Xảy Ra Ở Những Nơi Ít Người Biết Đến?";
let seoImage = "https://media.fittour.vn/uploads/anh-quynh-anh-shyn-duoc-cau-hon-kyrgyzstan.webp";

if (d1Db) {
  try {
    const stmt = d1Db.prepare(`SELECT title, seoTitle as metaTitle, seoDescription as metaDescription, featuredImage FROM Post WHERE slug = 'quynh-anh-shyn-duoc-cau-hon-o-kyrgyzstan' LIMIT 1`);
    const postData = await stmt.first();
    if (postData) {
      if (postData.featuredImage) seoImage = postData.featuredImage;
      if (postData.metaTitle) seoTitle = postData.metaTitle;
      if (postData.metaDescription) seoDesc = postData.metaDescription;
    }
  } catch (e) {
    console.error("Lỗi lấy SEO data:", e);
  }
}

const centralAsiaArticles = [
  {
    title: 'Chân dung cụ bà U80 khám phá Con đường tơ lụa Trung Á',
    excerpt: 'Cụ bà U80 khám phá Con Đường Tơ Lụa Trung Á đầy kỳ diệu cùng Fit Tour, vượt giới hạn tuổi tác, truyền cảm hứng sống trọn vẹn và phiêu lưu.',
    url: '/cu-ba-u80-kham-pha-con-duong-to-lua',
    image: 'https://media.fittour.vn/uploads/2024/11/cu-ba-u80-va-hanh-trinh-kham-pha-con-duong-to-lua-trung-a-cung-fit-tour.webp',
    date: 'Tháng 11, 2024',
    readTime: '8 phút đọc'
  },
  {
    title: 'Cô Hằng – U70 Và Hành Trình Chạm Vào Con Đường Tơ Lụa',
    excerpt: 'Cô Đỗ Thu Hằng, gần 70 tuổi, cùng FIT Tour khám phá Con Đường Tơ Lụa qua Pakistan và Iran, hành trình sống trọn đam mê ở tuổi không còn trẻ.',
    url: '/co-hang-u70-va-hanh-trinh-cham-vao-con-duong-to-lua',
    image: 'https://media.fittour.vn/uploads/2025/07/co-hang-va-hanh-trinh-cham-vao-con-duong-to-lua.webp',
    date: 'Tháng 7, 2025',
    readTime: '9 phút đọc'
  },
  {
    title: 'Emagazine: Đặng Thùy Dương và những ngày du mục Zanskar',
    excerpt: 'Emagazine Đặng Thùy Dương và những ngày du mục Zanskar kể về câu chuyện khám phá vẻ đẹp tuyệt vời, cũng những hình ảnh siêu đẹp.',
    url: '/emagazine-dang-thuy-duong-o-zanskar',
    image: 'https://media.fittour.vn/uploads/2023/06/emagazine-nhung-ngay-du-muc-zanskar.webp',
    date: 'Tháng 6, 2023',
    readTime: '15 phút đọc'
  },
  {
    title: 'Cầu nối văn hóa giữa Đông và Tây trên Con đường tơ lụa cổ',
    excerpt: 'Khám phá tác động Con đường tơ lụa đối với trao đổi văn hóa, ảnh hưởng sâu sắc của nó đối với nghệ thuật, tôn giáo, ngôn ngữ và công nghệ.',
    url: '/tac-dong-con-duong-to-lua-den-van-hoa',
    image: 'https://media.fittour.vn/uploads/2023/07/con-duong-to-lua-la-cau-noi-van-hoa-giua-dong-va-tay.webp',
    date: 'Tháng 7, 2023',
    readTime: '12 phút đọc'
  }
];

let adminEditUrl = "/admin/posts/edit?id=99996";

---

<BaseLayout
  title={seoTitle}
  description={seoDesc}
  image={seoImage}
  canonical="https://thericetour.com/quynh-anh-shyn-kyrgyzstan"
  adminEditUrl={adminEditUrl}
>
  <Fragment slot="head">
    <link rel="preload" as="image" href="https://media.fittour.vn/uploads/quynh-anh-shyn-kham-pha-kyrgyzstan.webp" fetchpriority="high" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&family=Inter:wght@300;400;500;600&display=swap">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Article",
          "headline": seoTitle,
          "description": seoDesc,
          "image": seoImage,
          "author": {
            "@type": "Organization",
            "name": "FIT Tour",
            "url": "https://thericetour.com"
          },
          "publisher": {
            "@type": "Organization",
            "name": "FIT Tour",
            "logo": {
              "@type": "ImageObject",
              "url": "https://media.thericetour.com/uploads/logo-the-rice.webp"
            }
          },
          "datePublished": "2026-06-22T08:00:00+08:00",
          "dateModified": "2026-06-22T08:00:00+08:00",
          "mainEntityOfPage": {
            "@type": "WebPage",
            "@id": "https://thericetour.com/quynh-anh-shyn-duoc-cau-hon-o-kyrgyzstan"
          }
        },
        {
          "@type": "BreadcrumbList",
          "itemListElement": [
            {
              "@type": "ListItem",
              "position": 1,
              "name": "Trang chủ",
              "item": "https://thericetour.com"
            },
            {
              "@type": "ListItem",
              "position": 2,
              "name": "Tin Tức & Blog",
              "item": "https://thericetour.com/blog"
            },
            {
              "@type": "ListItem",
              "position": 3,
              "name": "Quỳnh Anh Shyn Được Cầu Hôn Ở Kyrgyzstan"
            }
          ]
        }
      ]
    })} />
  </Fragment>

  <main class="min-h-screen bg-[#F9F6F0] text-stone-800 font-sans antialiased overflow-x-hidden selection:bg-stone-300">
    
    <!-- Hero Section -->
    <section class="relative h-[100svh] w-full flex items-center justify-center overflow-hidden">
      <!-- Breadcrumb Overlay -->
      <div class="absolute top-28 md:top-36 left-0 right-0 z-20 px-6 max-w-7xl mx-auto">
        <nav class="flex text-sm text-white/70 font-sans tracking-wide" aria-label="Breadcrumb">
          <ol class="inline-flex items-center space-x-1 md:space-x-3">
            <li class="inline-flex items-center">
              <a href="/" class="inline-flex items-center hover:text-white transition-colors">
                Trang chủ
              </a>
            </li>
            <li>
              <div class="flex items-center">
                <svg class="w-3 h-3 mx-1 text-white/50" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 6 10">
                  <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 9 4-4-4-4"/>
                </svg>
                <a href="/blog" class="ml-1 md:ml-2 hover:text-white transition-colors">Blog</a>
              </div>
            </li>
            <li aria-current="page">
              <div class="flex items-center">
                <svg class="w-3 h-3 mx-1 text-white/50" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 6 10">
                  <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 9 4-4-4-4"/>
                </svg>
                <span class="ml-1 md:ml-2 text-white font-medium">Kỳ quan thế giới</span>
              </div>
            </li>
          </ol>
        </nav>
      </div>

      <div class="absolute inset-0 w-full h-full">
        <img src={seoImage} alt={seoTitle} class="w-full h-full object-cover object-center scale-105 animate-slow-zoom" />
        <div class="absolute inset-0 bg-black/40"></div>
      </div>
      
      <div class="relative z-10 text-center px-4 max-w-5xl mx-auto mt-20">
        <h1 class="font-serif text-5xl md:text-6xl lg:text-8xl text-white font-bold leading-tight mb-6 drop-shadow-lg reveal-up">
          Quỳnh Anh Shyn Được Cầu Hôn Ở Kyrgyzstan
        </h1>
        <p class="text-white/90 text-xl md:text-2xl font-light max-w-3xl mx-auto tracking-wide drop-shadow reveal-up" style="transition-delay: 200ms;">
          Vì sao những khoảnh khắc đẹp nhất thường xảy ra ở những nơi ít người biết đến?
        </p>
      </div>
      
      <!-- Scroll indicator -->
      <div class="absolute bottom-10 left-1/2 -translate-x-1/2 text-white/70 animate-bounce">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path></svg>
      </div>
    </section>

    <!-- Intro -->
    <section class="py-16 md:py-20 px-6 max-w-3xl mx-auto text-center reveal-up mt-8">
      <p class="text-xl md:text-2xl leading-relaxed text-stone-600 font-light mb-8">
        Những ngày qua, mạng xã hội ngập tràn hình ảnh <a href="https://www.facebook.com/qashyn212" target="_blank" rel="noopener noreferrer" class="text-stone-800 border-b border-stone-800 font-medium hover:text-amber-700 hover:border-amber-700 transition-colors">Quỳnh Anh Shyn</a> được bạn trai cầu hôn giữa khung cảnh thiên nhiên hùng vĩ của Kyrgyzstan. Hàng trăm nghìn lượt yêu thích, hàng chục nghìn bình luận cùng vô số lời chúc phúc được gửi đến cặp đôi.
      </p>
      <p class="text-xl md:text-2xl leading-relaxed text-stone-800 font-medium italic font-serif my-12">
        Nhưng điều khiến tôi chú ý không phải là chiếc nhẫn. <br/>
        Cũng không phải màn cầu hôn. <br/>
        Mà là địa điểm họ đã chọn. <br/>
        Kyrgyzstan.
      </p>
      <p class="text-lg md:text-xl leading-relaxed text-stone-600 font-light mt-8">
        Một cái tên vẫn còn khá xa lạ với nhiều du khách Việt Nam, nhưng lại là vùng đất khiến không ít người từng đi khắp thế giới muốn quay trở lại lần thứ hai, thứ ba, thậm chí nhiều hơn thế.
      </p>
    </section>

    <!-- Section 1: Asymmetrical Grid -->
    <section class="py-12 px-6 max-w-7xl mx-auto">
      <div class="grid grid-cols-1 md:grid-cols-12 gap-12 md:gap-20 items-center">
        <div class="md:col-span-7 reveal-up">
          <div class="relative overflow-hidden rounded-sm shadow-2xl group">
            <img src="https://media.fittour.vn/uploads/om-nhau-ben-ho-song-kul.webp" alt="Ôm nhau bên hồ Song Kul" class="w-full h-auto object-cover group-hover:scale-105 transition-transform duration-[2000ms] ease-out" />
          </div>
        </div>
        <div class="md:col-span-5 space-y-6 reveal-up" style="transition-delay: 200ms;">
          <h2 class="font-serif text-4xl md:text-5xl font-bold text-stone-800 leading-tight">
            Kyrgyzstan Không Nổi Tiếng, Nhưng Rất Đáng Nhớ
          </h2>
          <div class="space-y-5 text-lg text-stone-600 font-light">
            <p>
              Kyrgyzstan nằm giữa lòng Trung Á. Nơi đây không có những biểu tượng du lịch nổi tiếng như tháp Eiffel của Paris, không có những đại lộ mua sắm xa hoa như Dubai hay những bãi biển nghỉ dưỡng nổi tiếng như Maldives.
            </p>
            <p>
              Thoạt nhìn, Kyrgyzstan dường như thiếu mọi thứ mà ngành du lịch hiện đại thường dùng để thu hút du khách.
            </p>
            <div class="pt-6 border-t border-stone-300/50 mt-6">
              <p class="text-2xl font-serif italic text-stone-800 mb-6">
                Nhưng đổi lại, nơi đây sở hữu thứ ngày càng hiếm trong thế giới hôm nay: sự nguyên bản.
              </p>
              <ul class="space-y-3 text-stone-700">
                <li class="flex items-center gap-3"><span class="w-1.5 h-1.5 bg-stone-400 rounded-full"></span> Nguyên bản trong cảnh quan.</li>
                <li class="flex items-center gap-3"><span class="w-1.5 h-1.5 bg-stone-400 rounded-full"></span> Nguyên bản trong văn hóa.</li>
                <li class="flex items-center gap-3"><span class="w-1.5 h-1.5 bg-stone-400 rounded-full"></span> Nguyên bản trong cách con người sống cùng thiên nhiên.</li>
                <li class="flex items-center gap-3"><span class="w-1.5 h-1.5 bg-stone-400 rounded-full"></span> Và nguyên bản trong cảm xúc mà vùng đất ấy mang lại.</li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Cinematic Break -->
    <div class="relative w-full mt-32">
      <!-- Sticky Image Background -->
      <div class="sticky top-0 h-screen w-full z-0 overflow-hidden">
        <img src="https://media.fittour.vn/uploads/quynh-anh-shyn-thao-nguyen-kyrgyzstan.webp" alt="Thảo nguyên Kyrgyzstan" class="w-full h-full object-cover" />
        <div class="absolute inset-0 bg-stone-900/40"></div>
      </div>
      
      <!-- Scrolling Text Content -->
      <div class="relative z-10 -mt-[100vh] min-h-screen flex items-center justify-center px-6 py-20">
        <div class="bg-white/10 backdrop-blur-md p-8 md:p-14 border border-white/20 max-w-4xl text-center reveal-up shadow-2xl">
          <h2 class="font-serif text-3xl md:text-5xl text-white font-bold leading-tight mb-8">
            Vì Sao Kyrgyzstan Là Nơi Hoàn Hảo Cho Một Lời Cầu Hôn?
          </h2>
          <p class="text-white/95 text-xl font-light leading-relaxed mb-6">
            Có những nơi đẹp để chụp ảnh.<br/>
            Có những nơi đẹp để check-in.<br/>
            Có những nơi đẹp để đăng lên mạng xã hội.
          </p>
          <p class="font-serif italic text-2xl md:text-3xl mt-8 text-white">
            Nhưng cũng có những nơi khiến con người muốn ngồi lại lâu hơn một chút, nói ít đi một chút và cảm nhận nhiều hơn một chút.
          </p>
        </div>
      </div>
    </div>

    <!-- Prose Content section (Requires background color and relative z-index to cover the sticky image) -->
    <section class="relative z-20 bg-[#F9F6F0] py-16 px-6">
      <div class="max-w-3xl mx-auto space-y-16">
        <div class="reveal-up text-center">
          <p class="text-2xl leading-relaxed text-stone-800 font-serif italic mb-10">
            Kyrgyzstan thuộc nhóm thứ hai.
          </p>
          <p class="text-xl leading-relaxed text-stone-600 font-light mb-8 text-left">
            Giữa những thảo nguyên rộng đến tận chân trời, những hồ nước xanh nằm dưới chân núi tuyết và những cung đường gần như không có dấu vết của du lịch đại trà, con người bỗng trở nên nhỏ bé hơn. Và cũng chính lúc đó, những cảm xúc chân thật nhất lại dễ xuất hiện hơn.
          </p>
          <p class="text-xl leading-relaxed text-stone-800 font-medium text-left">
            Có lẽ vì vậy mà một lời cầu hôn giữa thiên nhiên Trung Á lại chạm đến nhiều người đến thế.
          </p>
        </div>

        <div class="reveal-up">
          <h2 class="font-serif text-4xl md:text-5xl font-bold text-stone-800 mb-10 text-center">
            Vẻ Đẹp Không Đến Từ <br/><span class="text-stone-500 italic font-light">Những Điều Hào Nhoáng</span>
          </h2>
          <div class="space-y-6 text-lg text-stone-600 font-light leading-relaxed">
            <p>Những ai từng đặt chân đến Trung Á đều hiểu rằng vẻ đẹp của Kyrgyzstan không phải kiểu khiến bạn trầm trồ ngay từ phút đầu tiên.</p>
            <p>Nó không cố gắng gây ấn tượng. Nó không phô trương. Nó không cần những biểu tượng nổi tiếng để chứng minh giá trị của mình.</p>
            
            <div class="my-12 py-8 border-y border-stone-200">
              <p class="text-2xl md:text-3xl font-serif text-stone-800 italic text-center leading-relaxed">
                "Thay vào đó, Kyrgyzstan chinh phục du khách bằng sự rộng lớn gần như vô tận của thiên nhiên."
              </p>
            </div>
            
            <p>Đó là những thảo nguyên trải dài tới chân trời. Là những hồ nước xanh thẳm nằm giữa các dãy núi tuyết. Là những đàn ngựa tự do gặm cỏ dưới bầu trời xanh sâu hun hút. Và là những đêm đầy sao khiến bạn nhận ra rằng đã rất lâu rồi mình chưa thực sự ngước nhìn bầu trời.</p>
            <p>Có những ngày trên đường, bạn đi hàng giờ đồng hồ mà không gặp một chiếc xe nào. Điều tưởng như nhàm chán ấy lại trở thành thứ khiến người ta nhớ mãi sau khi trở về.</p>
          </div>
        </div>

        <div class="reveal-up">
          <h2 class="font-serif text-3xl md:text-4xl font-bold text-stone-800 mb-10 text-center">
            Khi Du Khách Không Còn Tìm Kiếm <br/>Những Điểm Đến Nổi Tiếng
          </h2>
          <div class="space-y-6 text-lg text-stone-600 font-light leading-relaxed">
            <p>Trong hơn 15 năm thiết kế và vận hành các hành trình khám phá từ Himalaya, <a href="/tour-tay-tang" class="text-amber-800 font-medium hover:underline underline-offset-4 decoration-amber-300">Tây Tạng</a>, <a href="/country/ladakh/" class="text-amber-800 font-medium hover:underline underline-offset-4 decoration-amber-300">Ladakh</a>, Bhutan cho đến <a href="/tour-con-duong-to-lua" class="text-amber-800 font-medium hover:underline underline-offset-4 decoration-amber-300">Con Đường Tơ Lụa</a> và <a href="/tour-trung-a" class="text-amber-800 font-medium hover:underline underline-offset-4 decoration-amber-300">Trung Á</a>, chúng tôi nhận thấy một sự thay đổi rất rõ.</p>
            
            <div class="bg-stone-800 p-10 md:p-12 rounded-sm my-12 font-serif text-xl md:text-2xl text-stone-300 text-center shadow-xl">
              <p class="mb-4">Mười năm trước, mọi người tìm kiếm những điểm đến nổi tiếng.</p>
              <p class="mb-4 opacity-80">Năm năm trước, mọi người tìm kiếm những điểm đến đẹp.</p>
              <p class="text-white mt-8 italic text-2xl md:text-3xl">Còn hôm nay, ngày càng nhiều người tìm kiếm những điểm đến mang lại cảm xúc.</p>
            </div>
            
            <p>Họ không chỉ muốn đi du lịch. Họ muốn được trải nghiệm. Muốn được kết nối với thiên nhiên. Muốn được chạm vào những nền văn hóa còn giữ nguyên bản sắc.</p>
            <p>Và quan trọng hơn, họ muốn có những câu chuyện để kể thay vì chỉ có những bức ảnh để đăng.</p>
            <p>Đó cũng là lý do Trung Á đang trở thành một trong những khu vực được yêu thích nhất của những người từng đi rất nhiều nơi trên thế giới.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Final Story Block -->
    <section class="py-16 bg-stone-900 text-stone-100">
      <div class="max-w-7xl mx-auto px-6 grid grid-cols-1 md:grid-cols-2 gap-16 items-center">
        <div class="space-y-10 reveal-up">
          <h2 class="font-serif text-4xl md:text-5xl font-bold text-stone-100 leading-tight">
            Hành Trình Kyrgyzstan Của Quỳnh Anh Shyn Và Một Góc Nhìn Khác Về Du Lịch
          </h2>
          <div class="space-y-6 text-lg text-stone-400 font-light leading-relaxed">
            <p>Ít người biết rằng hành trình Kyrgyzstan mà Quỳnh Anh Shyn tham gia được tổ chức bởi FIT TOUR.</p>
