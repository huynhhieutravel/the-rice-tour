---
import { env } from 'cloudflare:workers';
import BaseLayout from '@/layouts/BaseLayout.astro';
import JsonLdSchema from '@/components/seo/JsonLdSchema.astro';

const d1Db = env?.dulichcoguu_d1;

if (!d1Db) {
  return new Response("Database binding not available", { status: 500 });
}

// 1. Get URL search params for filtering and pagination
const searchParams = Astro.url.searchParams;
const selectedCountry = searchParams.get('country') || '';
const sortBy = searchParams.get('sort') || '';
const keyword = searchParams.get('q') || '';

// Parse Min and Max Price (in USD)
const minPriceVal = parseInt(searchParams.get('minPrice') || '0') || 0;
const maxPriceVal = parseInt(searchParams.get('maxPrice') || '5000') || 5000;

const pageParam = searchParams.get('page') || '1';
const page = parseInt(pageParam) > 0 ? parseInt(pageParam) : 1;
const limit = 12;
const offset = (page - 1) * limit;

// 2. Fetch distinct destinations
const countriesRes = await d1Db.prepare(`
  SELECT DISTINCT c.slug, c.name 
  FROM Country c 
  ORDER BY c.display_order ASC, c.name ASC
`).all<any>();
const filterCountries = countriesRes.results || [];

// 3. Build SQL Where Clauses
const whereClauses = ["t.status = 'published'"];
const queryParams: any[] = [];

if (selectedCountry) {
  whereClauses.push("t.country_slug = ?");
  queryParams.push(selectedCountry);
}

if (keyword) {
  whereClauses.push("(t.title LIKE ? OR t.excerpt LIKE ?)");
  queryParams.push(`%${keyword}%`);
  queryParams.push(`%${keyword}%`);
}

if (minPriceVal > 0) {
  whereClauses.push("t.price_number >= ?");
  queryParams.push(minPriceVal);
}

if (maxPriceVal < 5000) {
  whereClauses.push("t.price_number <= ?");
  queryParams.push(maxPriceVal);
}

const whereSql = whereClauses.join(" AND ");

// 4. Fetch Total Count for Pagination
let totalTours = 0;
try {
  let countStmt = d1Db.prepare(`SELECT COUNT(*) as total FROM Tour t WHERE ${whereSql}`);
  if (queryParams.length > 0) countStmt = countStmt.bind(...queryParams);
  const countRes = await countStmt.first<{total: number}>();
  totalTours = countRes?.total || 0;
} catch (e) {
  console.error("Error fetching count:", e);
}

const totalPages = Math.ceil(totalTours / limit);

// 5. Fetch Filtered & Paginated Tours
let tourQuery = `
  SELECT t.id, t.slug, t.title, t.featuredImage, t.price_number, t.price_text, t.days, t.excerpt, t.country_slug, c.name as country_name
  FROM Tour t
  LEFT JOIN Country c ON t.country_slug = c.slug
  WHERE ${whereSql}
`;

if (sortBy === 'price-asc') {
  tourQuery += ` ORDER BY t.price_number ASC, t.createdAt DESC`;
} else if (sortBy === 'price-desc') {
  tourQuery += ` ORDER BY t.price_number DESC, t.createdAt DESC`;
} else {
  tourQuery += ` ORDER BY t.createdAt DESC`;
}

tourQuery += ` LIMIT ? OFFSET ?`;
const finalQueryParams = [...queryParams, limit, offset];

let tours: any[] = [];
try {
  let statement = d1Db.prepare(tourQuery).bind(...finalQueryParams);
  const toursRes = await statement.all<any>();
  tours = toursRes.results || [];
} catch (error) {
  console.error("Error fetching tours:", error);
}

// Utils
function formatPriceUSD(priceNumber: number | null, priceText: string | null): string {
  if (priceText && priceText.includes('$')) return priceText;
  if (priceNumber) return `$${priceNumber.toLocaleString('en-US')} USD`;
  return "Inquire for Pricing";
}

function getPaginationUrl(newPage: number) {
  const url = new URL(Astro.url);
  url.searchParams.set('page', newPage.toString());
  return url.toString();
}

const hasActiveFilters = selectedCountry || sortBy || keyword || minPriceVal > 0 || maxPriceVal < 5000;

const seoData = {
  title: "Curated Vietnam Inbound Tours & Expeditions | The Rice Tour",
  description: "Browse our private tailor-made itineraries across Vietnam: Sapa rice terraces, Ha Long luxury cruises, ancient Hoi An, and Mekong waterways.",
  canonicalUrl: `https://thericetour.com/tours`,
  ogImageUrl: "https://images.unsplash.com/photo-1528127269322-539801943592?auto=format&fit=crop&w=1200&q=80",
  schemaType: "custom" as const
};
---

<BaseLayout 
  title={seoData.title} 
  description={seoData.description} 
  image={seoData.ogImageUrl}
  canonical={seoData.canonicalUrl}
>
  <Fragment slot="head">
    <JsonLdSchema type={seoData.schemaType} data={{
      "@context": "https://schema.org",
      "@type": "CollectionPage",
      "name": seoData.title,
      "description": seoData.description,
      "url": seoData.canonicalUrl
    }} />
  </Fragment>

  <!-- Hero Section -->
  <div class="relative w-full bg-slate-950 overflow-hidden">
    <div class="absolute inset-0 opacity-40">
      <img 
        src="https://images.unsplash.com/photo-1528127269322-539801943592?auto=format&fit=crop&w=1920&q=80" 
        alt="Vietnam Expeditions" 
        class="w-full h-full object-cover"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/60 to-transparent"></div>
    </div>
    
    <div class="relative z-10 max-w-[1200px] mx-auto px-4 md:px-8 py-20 lg:py-28 text-center text-white">
      <div class="inline-flex items-center gap-2 px-4 py-1 rounded-full bg-amber-500/20 border border-amber-400/30 mb-4">
        <span class="text-xs uppercase tracking-[0.2em] font-semibold text-amber-300">Curated Vietnam Journeys</span>
      </div>
      <h1 class="font-serif text-4xl md:text-5xl lg:text-6xl font-bold mb-4 tracking-tight">
        Signature Vietnam Expeditions
      </h1>
      <p class="text-base md:text-lg font-light max-w-2xl mx-auto leading-relaxed text-slate-300">
        Private guided adventures, boutique luxury stays, authentic culinary encounters, and 100% tailor-made flexibility.
      </p>
    </div>
  </div>

  <!-- Main Content & Filters -->
  <div class="bg-slate-50 min-h-screen py-12 lg:py-20">
    <div class="max-w-[1440px] mx-auto px-4 md:px-8 lg:px-12">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12">
        
        <!-- Sidebar Filters -->
        <aside class="lg:col-span-3">
          <div class="bg-white rounded-3xl p-6 shadow-sm border border-slate-200 sticky top-24">
            <h2 class="text-lg font-bold text-slate-900 mb-6 flex items-center gap-2">
              <span>🎯</span> Filter Expeditions
            </h2>
            
            <form method="GET" action="/tours" class="space-y-6" id="filterForm">
              
              <!-- Keyword Filter -->
              <div>
                <label for="q" class="block text-xs font-bold uppercase tracking-wider text-slate-500 mb-2">Search Keyword</label>
                <input 
                  type="text" 
                  name="q" 
                  id="q"
                  value={keyword}
                  placeholder="e.g. Sapa, Cruise..."
                  class="block w-full rounded-xl border border-slate-200 bg-slate-50 py-3 px-4 text-slate-900 text-sm font-medium focus:border-amber-500 focus:ring-1 focus:ring-amber-500"
                />
              </div>

              <!-- Region Filter -->
              <div>
                <label for="country" class="block text-xs font-bold uppercase tracking-wider text-slate-500 mb-2">Destination Region</label>
                <div class="relative">
                  <select 
                    name="country" 
                    id="country"
                    onchange="this.form.submit()"
                    class="block w-full rounded-xl border border-slate-200 bg-slate-50 py-3 pl-4 pr-10 text-slate-900 text-sm font-medium focus:border-amber-500 focus:ring-1 focus:ring-amber-500 appearance-none cursor-pointer"
                  >
                    <option value="">All Vietnam Destinations</option>
                    {filterCountries.map((c: any) => (
                      <option value={c.slug} selected={selectedCountry === c.slug}>
                        {c.name}
                      </option>
                    ))}
                  </select>
                  <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-4 text-slate-500">
                    <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                  </div>
                </div>
              </div>

              <!-- Price Filter -->
              <div>
                <label class="block text-xs font-bold uppercase tracking-wider text-slate-500 mb-2">Budget (USD per person)</label>
                <div class="grid grid-cols-2 gap-2">
                  <div>
                    <span class="text-[11px] text-slate-400">Min ($)</span>
                    <input 
                      type="number" 
                      name="minPrice" 
                      value={minPriceVal > 0 ? minPriceVal : ''} 
                      placeholder="0"
                      class="w-full bg-slate-50 border border-slate-200 rounded-lg p-2 text-sm text-slate-800" 
                    />
                  </div>
                  <div>
                    <span class="text-[11px] text-slate-400">Max ($)</span>
                    <input 
                      type="number" 
                      name="maxPrice" 
                      value={maxPriceVal < 5000 ? maxPriceVal : ''} 
                      placeholder="5000"
                      class="w-full bg-slate-50 border border-slate-200 rounded-lg p-2 text-sm text-slate-800" 
                    />
                  </div>
                </div>
              </div>

              <!-- Sort Filter -->
              <div>
                <label for="sort" class="block text-xs font-bold uppercase tracking-wider text-slate-500 mb-2">Sort By</label>
                <select 
                  name="sort" 
                  id="sort"
                  onchange="this.form.submit()"
                  class="block w-full rounded-xl border border-slate-200 bg-slate-50 py-3 pl-4 pr-10 text-slate-900 text-sm font-medium focus:border-amber-500 appearance-none cursor-pointer"
                >
                  <option value="">Newest Expeditions</option>
                  <option value="price-asc" selected={sortBy === 'price-asc'}>Price: Low to High</option>
                  <option value="price-desc" selected={sortBy === 'price-desc'}>Price: High to Low</option>
                </select>
              </div>

              <div class="pt-2 flex flex-col gap-2">
                <button type="submit" class="w-full py-3 bg-amber-500 hover:bg-amber-600 text-slate-950 font-bold text-xs uppercase tracking-wider rounded-xl transition-all shadow-sm">
                  Apply Filters
                </button>
                {hasActiveFilters && (
                  <a href="/tours" class="text-center text-xs text-slate-500 hover:text-amber-600 font-semibold py-1">
                    Reset All Filters ✕
                  </a>
                )}
              </div>

            </form>

            <!-- Custom Tour Banner in Sidebar -->
            <div class="mt-8 p-5 bg-gradient-to-br from-slate-900 to-slate-800 text-white rounded-2xl">
              <h3 class="font-bold text-sm text-amber-400 mb-1">Need a Custom Tour?</h3>
              <p class="text-xs text-slate-300 leading-relaxed mb-4">Let our destination specialists build your tailor-made itinerary.</p>
              <a href="/tailor-made" class="block text-center py-2.5 bg-amber-500 hover:bg-amber-600 text-slate-950 text-xs font-bold uppercase rounded-lg transition-all">
                Design Trip →
              </a>
            </div>

          </div>
        </aside>

        <!-- Tour Grid Area -->
        <main class="lg:col-span-9">
          
          <div class="flex items-center justify-between mb-8 pb-4 border-b border-slate-200">
            <p class="text-sm font-semibold text-slate-600">
              Showing <span class="text-slate-900 font-bold">{tours.length}</span> of <span class="text-slate-900 font-bold">{totalTours}</span> signature journeys
            </p>
          </div>

          {tours.length === 0 ? (
            <div class="bg-white rounded-3xl p-12 text-center border border-slate-200">
              <div class="text-4xl mb-3">🔍</div>
              <h3 class="text-xl font-bold text-slate-800 mb-2">No Expeditions Found</h3>
              <p class="text-slate-500 text-sm max-w-md mx-auto mb-6">We couldn't find any tours matching your active filter criteria. Try resetting filters or request a bespoke trip.</p>
              <a href="/tours" class="inline-block px-6 py-3 bg-amber-500 text-slate-950 font-bold text-xs uppercase tracking-wider rounded-xl shadow">
                View All Tours
              </a>
            </div>
          ) : (
            <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6">
              {tours.map((t: any) => (
                <div class="group bg-white rounded-3xl overflow-hidden border border-slate-200 shadow-sm hover:shadow-xl transition-all duration-300 flex flex-col">
                  
                  <!-- Thumbnail -->
                  <div class="relative aspect-[16/10] overflow-hidden bg-slate-100">
                    <img 
                      src={t.featuredImage || "https://images.unsplash.com/photo-1528127269322-539801943592?auto=format&fit=crop&w=800&q=80"} 
                      alt={t.title} 
                      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" 
                      loading="lazy"
                    />
                    {t.days && (
                      <span class="absolute top-3 left-3 bg-slate-950/80 backdrop-blur-md text-white text-[11px] font-bold px-3 py-1 rounded-full">
                        ⏱️ {t.days}
                      </span>
                    )}
                    {t.country_name && (
                      <span class="absolute bottom-3 left-3 bg-amber-500 text-slate-950 text-[10.5px] font-extrabold px-2.5 py-0.5 rounded-md shadow-sm">
                        {t.country_name}
                      </span>
                    )}
                  </div>

                  <!-- Info -->
                  <div class="p-6 flex-1 flex flex-col justify-between">
                    <div>
                      <h3 class="font-serif text-lg font-bold text-slate-900 group-hover:text-amber-600 transition-colors line-clamp-2 mb-2 leading-snug">
                        <a href={`/tour/${t.slug}`}>
                          {t.title}
                        </a>
                      </h3>
                      {t.excerpt && (
                        <p class="text-xs text-slate-500 line-clamp-2 leading-relaxed mb-4">
                          {t.excerpt}
                        </p>
                      )}
                    </div>

                    <div class="pt-4 border-t border-slate-100 flex items-center justify-between">
                      <div>
                        <span class="block text-[10px] uppercase font-bold text-slate-400">From</span>
                        <span class="font-bold text-base text-amber-700">
                          {formatPriceUSD(t.price_number, t.price_text)}
                        </span>
                      </div>
                      <a 
                        href={`/tour/${t.slug}`} 
                        class="px-4 py-2 bg-slate-900 hover:bg-amber-500 hover:text-slate-950 text-white font-bold text-xs rounded-xl transition-all shadow-sm"
                      >
                        Explore →
                      </a>
                    </div>

                  </div>

                </div>
              ))}
            </div>
          )}

          <!-- Pagination -->
          {totalPages > 1 && (
            <div class="flex justify-center items-center gap-2 mt-12">
              {Array.from({ length: totalPages }, (_, i) => i + 1).map((p) => (
                <a 
                  href={getPaginationUrl(p)} 
                  class={`w-10 h-10 rounded-xl flex items-center justify-center font-bold text-sm transition-all ${p === page ? 'bg-amber-500 text-slate-950 shadow' : 'bg-white text-slate-700 border border-slate-200 hover:border-amber-500'}`}
                >
                  {p}
                </a>
              ))}
            </div>
          )}

        </main>

      </div>
    </div>
  </div>

</BaseLayout>
