---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/ladakh-co-may.css';
import '../styles/blog.css';
import '../styles/author-card.css';
import App from '../components/ReactApp/ThungLungZanskar/App.tsx';
import { env } from 'cloudflare:workers';
const d1Db = env?.dulichcoguu_d1;

let seoTitle = "Thung Lũng Zanskar – Album ảnh du lịch và thông tin cần biết";
let seoDesc = "Một trong những nơi ít được khám phá, Thung lũng Zanskar là một viên ngọc ẩn nằm gần Leh, Ladakh, nơi có tầm nhìn tuyệt đẹp ra dãy Himalaya phủ đầy tuyết với dòng sông xanh lấp lánh chảy dưới chân núi. Nó thậm chí còn cung cấp một trải nghiệm đi bộ kỳ lạ, 'Chadar Trek', trên một lớp băng dày trên sông trong mùa đông.";
let seoImage = "https://media.fittour.vn/uploads/2022/10/nguoi-dan-dia-phuong-o-thung-lung-zanskar.webp";
let adminEditUrl = "";

if (d1Db) {
  try {
    const stmt = d1Db.prepare(`SELECT id, title, seoTitle as metaTitle, seoDescription as metaDescription, featuredImage FROM Post WHERE slug = 'thung-lung-zanskar' LIMIT 1`);
    const postData = await stmt.first();
    if (postData) {
      // seoTitle = postData.metaTitle || postData.title || seoTitle;
      // seoDesc = postData.metaDescription || seoDesc;
      seoImage = postData.featuredImage || seoImage;
      if (postData.id) adminEditUrl = `/admin/posts/edit?id=${postData.id}`;
    }
  } catch (e) {
    console.error("Lỗi lấy SEO data cho trang thung-lung-zanskar:", e);
  }
}
---
<BaseLayout
  title={seoTitle}
  description={seoDesc}
  image={seoImage}
  canonical="https://thericetour.com/thung-lung-zanskar"
  adminEditUrl={adminEditUrl}
>
  <Fragment slot="head">
    <meta property="og:type" content="article" />
    <!-- Optimize Google Fonts Loading -->
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&family=JetBrains+Mono:wght@400;500;700&display=swap">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&family=JetBrains+Mono:wght@400;500;700&display=swap" media="print" onload="this.media='all'">
    <noscript>
      <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&family=JetBrains+Mono:wght@400;500;700&display=swap">
    </noscript>
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Article",
          "headline": seoTitle,
          "description": seoDesc,
          "image": [seoImage],
          "author": [{
            "@type": "Person",
            "name": "Huỳnh Hiếu",
            "url": "https://thericetour.com/huynh-hieu"
          }]
        },
        {
          "@type": "FAQPage",
          "mainEntity": [
            {
              "@type": "Question",
              "name": "Thung lũng Zanskar nằm ở đâu?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Thung lũng Zanskar nằm ở phía tây nam của Ladakh, thuộc huyện Kargil, Ấn Độ, cách thành phố Leh khoảng 230-240 km tùy tuyến đường di chuyển."
              }
            },
            {
              "@type": "Question",
              "name": "Thời điểm nào lý tưởng để tham quan Thung lũng Zanskar?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Thời gian tốt nhất để ghé thăm Thung lũng Zanskar là từ tháng 6 đến tháng 9, khi thời tiết ôn hòa và các con đường đều thông thoáng. Vào mùa đông, khu vực này thường bị tuyết bao phủ, gây khó khăn cho việc di chuyển."
              }
            },
            {
              "@type": "Question",
              "name": "Những hoạt động nào phổ biến tại Thung lũng Zanskar?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Du khách có thể tham gia các hoạt động như trekking trên các tuyến đường như Lugnak Trail Trek, Padum-Darcha Trek và Zanskar-Sham Valley Trek. Ngoài ra, vào mùa đông, sông Zanskar đóng băng tạo điều kiện cho chuyến đi bộ trên băng nổi tiếng mang tên 'Chadar Trek'."
              }
            },
            {
              "@type": "Question",
              "name": "Có những điểm tham quan nào nổi bật trong Thung lũng Zanskar?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Thung lũng Zanskar nổi tiếng với cảnh quan hùng vĩ của dãy Himalaya, các tu viện Phật giáo cổ kính và dòng sông Zanskar xanh biếc. Đây là điểm đến lý tưởng cho những ai yêu thích thiên nhiên và muốn khám phá văn hóa địa phương."
              }
            }
          ]
        }
      ]
    })} />
  </Fragment>

  <!-- client:load is used to enable SSR which fixes Render Blocking and LCP issues -->
  <App client:load /> 
</BaseLayout>
