---
import { env } from 'cloudflare:workers';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { safeQueryCritical } from '@/lib/db-client';
import { getGlobalSettings } from '@/lib/settingsHelper';
import { Clock, Calendar, ChevronRight, CheckCircle2, Shield, Check, Info, AlertTriangle, MapPin, Ticket, Landmark, Compass } from 'lucide-react';
import DataPost from '@/components/shortcodes/data/DataPost.astro';

const d1Db = env?.dulichcoguu_d1;
let post;
try {
  if (d1Db) post = await safeQueryCritical(
    d1Db.prepare("SELECT * FROM Post WHERE slug = ? AND (status = 'published' OR status = 'publish')").bind('tu-cam-thanh').first<any>(),
    { route: Astro.url.pathname, slug: 'tu-cam-thanh', queryType: "fetch_post_by_slug" }
  );
} catch (e) {
  // Gracefully fallback if DB error or not created yet
}

// Fallback metadata if post is not yet populated in CMS
if (!post) {
  post = {
    id: 998,
    title: 'Tử Cấm Thành Bắc Kinh: Cẩm Nang Tham Quan, Giá Vé & Kinh Nghiệm Khám Phá Cố Cung',
    excerpt: 'Khám phá Tử Cấm Thành (Bảo tàng Cung điện) Bắc Kinh: Lịch sử hơn 500 năm của 24 vị hoàng đế, cấu trúc Ngoại Triều – Nội Đình, giá vé, giờ mở cửa, quy định đặt vé 2026 và kinh nghiệm tham quan trọn vẹn.',
    featuredImage: 'https://media.fittour.vn/uploads/han-phuc-hanh-lang-tu-cam-thanh-bac-kinh.webp',
    author: 'Huynh Hieu Travel',
    createdAt: '2026-08-19T08:00:00.000Z',
    updatedAt: '2026-08-19T08:00:00.000Z',
    readingTime: 15
  };
}

const { settings } = await getGlobalSettings();

const seoTitle = post.seoTitle || post.title || 'Tử Cấm Thành Bắc Kinh: Cẩm Nang Tham Quan, Giá Vé & Kinh Nghiệm Cố Cung';
const seoDesc = post.seoDesc || post.excerpt || 'Kinh nghiệm tham quan Tử Cấm Thành (Palace Museum) Bắc Kinh: Cấu trúc Ngoại Triều - Nội Đình, giá vé 2026, hướng dẫn đặt vé tên thật và lịch trình tham quan chi tiết.';
const seoImage = post.seoImage || post.featuredImage || 'https://media.fittour.vn/uploads/han-phuc-hanh-lang-tu-cam-thanh-bac-kinh.webp';

// --- DATE LOGIC ---
const createdAtStr = post.createdAt || post.publishedAt || '2026-08-19T08:00:00.000Z';
const updatedAtStr = post.updatedAt || createdAtStr;

const createdAt = new Date(createdAtStr.replace(' ', 'T'));
const updatedAt = new Date(updatedAtStr.replace(' ', 'T'));

const isUpdated = updatedAt.getTime() - createdAt.getTime() > 86400000; 
const displayDate = isUpdated ? updatedAt : createdAt;
const datePrefix = isUpdated ? "Cập nhật:" : "Xuất bản:";

const formattedDate = displayDate.toLocaleDateString('vi-VN', { day: '2-digit', month: '2-digit', year: 'numeric' });
// ------------------

// --- AUTHOR LOGIC ---
const authorMap: Record<string, any> = {
  "Max Vũ": {
    name: "Max Vũ",
    url: "/max-vu",
    img: "https://media.fittour.vn/uploads/max-vu-founder-fit-tour.webp"
  },
  "Huy Ngô": {
    name: "Huy Ngô",
    url: "/hdv-huy-ngo",
    img: "https://media.fittour.vn/uploads/hdv-huy-ngo-fittour.webp"
  },
  "Huynh Hieu Travel": {
    name: "Huynh Hieu Travel",
    url: "/huynh-hieu",
    img: "https://media.fittour.vn/uploads/huynhhieutravel.webp"
  }
};
const authorData = authorMap[post.author] || authorMap["Huynh Hieu Travel"];
// ------------------

const adminEditUrl = post.id && post.id !== 998 && post.id !== 999 ? `/admin/posts/edit?id=${post.id}` : '#';

// TOC Navigation Structure
const toc = [
  { id: "gioi-thieu", title: "Giới thiệu", icon: "🏠" },
  { id: "tu-cam-thanh-la-gi", title: "Tử Cấm Thành Là Gì?" },
  { id: "tu-cam-thanh-rong-bao-nhieu", title: "Tử Cấm Thành Rộng Bao Nhiêu?" },
  { id: "phan-chia-khu-vuc", title: "Tử Cấm Thành Được Chia Thành Những Khu Vực Nào?" },
  { id: "cong-trinh-quan-trong", title: "Những Công Trình Quan Trọng Nhất" },
  { id: "ngo-mon", title: "• Ngọ Môn (Lối Vào Chính)", indent: true },
  { id: "thai-hoa-mon", title: "• Thái Hòa Môn (Lưu Ý 2026)", indent: true },
  { id: "dien-thai-hoa", title: "• Điện Thái Hòa", indent: true },
  { id: "dien-trung-hoa", title: "• Điện Trung Hòa", indent: true },
  { id: "dien-bao-hoa", title: "• Điện Bảo Hòa", indent: true },
  { id: "cung-can-thanh", title: "• Cung Càn Thanh", indent: true },
  { id: "dien-giao-thai", title: "• Điện Giao Thái", indent: true },
  { id: "cung-khon-ninh", title: "• Cung Khôn Ninh", indent: true },
  { id: "ngu-hoa-vien", title: "• Ngự Hoa Viên", indent: true },
  { id: "khu-vuc-dong-tay", title: "• Các Cung Điện Phía Đông & Phía Tây", indent: true },
  { id: "dac-biet-kien-truc", title: "Tử Cấm Thành Có Gì Đặc Biệt Về Kiến Trúc?" },
  { id: "bao-tang-hien-vat", title: "Bảo Tàng Cung Điện Có Bao Nhiêu Hiện Vật?" },
  { id: "trien-lam-2026", title: "Triển Lãm Tử Cấm Thành Năm 2026" },
  { id: "gio-mo-cua", title: "Giờ Mở Cửa Tử Cấm Thành 2026" },
  { id: "gia-ve", title: "Giá Vé Tử Cấm Thành 2026" },
  { id: "cach-dat-ve", title: "Cách Đặt Vé Tử Cấm Thành (Bắt Buộc)" },
  { id: "nguoi-viet-nam-can-mang-gi", title: "Người Việt Nam Cần Mang Gì Khi Đi?" },
  { id: "cach-di-den", title: "Cách Đi Đến Tử Cấm Thành" },
  { id: "ket-hop-thien-an-mon", title: "Kết Hợp Với Quảng Trường Thiên An Môn" },
  { id: "huong-dan-chon-tuyen", title: "Hướng Dẫn Chọn Tuyến (Theo Thời Gian & Đối Tượng)" },
  { id: "phong-trung-bay-kho-bau", title: "Phòng Trưng Bày Kho Báu Có Đáng Xem?" },
  { id: "phong-trung-bay-dong-ho", title: "Phòng Trưng Bày Đồng Hồ Có Đáng Xem?" },
  { id: "cong-tac-bao-ton", title: "Bảo Tàng Cung Điện & Công Tác Bảo Tồn" },
  { id: "kinh-nghiem-thuc-te", title: "Kinh Nghiệm Thực Tế (Người Đã Đi Sẽ Nói Gì?)" },
  { id: "faq", title: "Câu Hỏi Thường Gặp (FAQ)" },
  { id: "co-dang-di-khong", title: "Tử Cấm Thành Có Đáng Đi Không?" },
  { id: "7-dieu-can-nho", title: "7 Điều Cần Nhớ Trước Khi Đi" },
  { id: "hanh-trinh-fit-tour", title: "Hành Trình Bắc Kinh Cùng FIT TOUR" }
];
---

<BaseLayout 
  title={seoTitle} 
  description={seoDesc} 
  image={seoImage}
  preloadImages={[seoImage]}
  adminEditUrl={adminEditUrl}
>
  <div class="bg-[#F8F9FA] text-[#1E293B] font-sans antialiased selection:bg-[#F7931E] selection:text-white">

    {/* ================= HERO SECTION ================= */}
    <section class="relative w-full min-h-[600px] lg:min-h-[700px] overflow-hidden flex flex-col justify-center pt-32 pb-20">
      <div class="absolute inset-0 z-0 bg-slate-950">
        <img 
          src={seoImage} 
          alt="Tử Cấm Thành Bắc Kinh Trung Quốc - Cố Cung Hoàng Gia" 
          class="w-full h-full object-cover object-center opacity-80" 
          width="1920" 
          height="1080"
          fetchpriority="high" 
          loading="eager" 
          decoding="async" 
        />
        <div class="absolute inset-0 bg-gradient-to-r from-black/85 via-black/60 to-black/30"></div>
        <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-transparent to-transparent"></div>
      </div>

      <div class="relative z-10 max-w-[1600px] mx-auto px-4 sm:px-6 lg:px-12 w-full">
        
        {/* Breadcrumb */}
        <div class="flex items-center gap-2 text-[13px] text-white/70 font-medium mb-6">
          <a href="/" class="hover:text-white transition-colors">Trang chủ</a>
          <ChevronRight class="w-3 h-3" />
          <a href="/blog" class="hover:text-white transition-colors">Blog</a>
          <ChevronRight class="w-3 h-3" />
          <span class="text-white font-semibold line-clamp-1">Tử Cấm Thành Bắc Kinh</span>
        </div>

        {/* Titles */}
        <h1 class="font-serif text-3xl sm:text-4xl lg:text-5xl xl:text-6xl font-bold text-white mb-4 leading-[1.15] drop-shadow-lg max-w-5xl">
          {post.title}
        </h1>
        <h2 class="font-serif text-lg sm:text-2xl lg:text-3xl text-amber-400 italic mb-8 max-w-4xl drop-shadow-md font-medium">
          Kinh nghiệm tham quan cung điện 500 năm tuổi của triều Minh – Thanh
        </h2>
        <p class="text-white/90 text-base sm:text-lg max-w-3xl leading-relaxed mb-8 hidden md:block drop-shadow-md font-normal">
          Tử Cấm Thành là một trong những biểu tượng quan trọng nhất của Bắc Kinh và là quần thể cung điện hoàng gia nổi tiếng nhất <a href="/country/trung-quoc" class="text-amber-400 hover:text-amber-300 underline underline-offset-4" title="Du lịch Trung Quốc">Trung Quốc</a>. Trong hơn 500 năm, nơi đây là trung tâm quyền lực của hai triều đại Minh – Thanh và là Di sản Thế giới UNESCO từ năm 1987.
        </p>

        {/* Author Meta */}
        <div class="flex flex-wrap items-center gap-4 sm:gap-6 text-sm text-white/80 border-t border-white/20 pt-6 max-w-3xl">
          <a href={authorData.url} class="flex items-center gap-3 group">
            <img 
              src={authorData.img} 
              alt={authorData.name} 
              width="40" 
              height="40" 
              class="w-10 h-10 rounded-full border-2 border-white/30 object-cover object-top group-hover:border-amber-400 transition-colors" 
            />
            <span class="font-bold text-white group-hover:text-amber-400 transition-colors flex items-center gap-1">
              {authorData.name} 
              <CheckCircle2 class="w-4 h-4 text-blue-400" />
            </span>
          </a>
          <div class="flex items-center gap-2 bg-white/10 px-4 py-2 rounded-full backdrop-blur-sm border border-white/10">
            <Calendar class="w-4 h-4 opacity-70" />
            <span>{datePrefix} {formattedDate}</span>
          </div>
          <div class="flex items-center gap-2 bg-black/30 px-3 py-1.5 rounded-full backdrop-blur-sm">
            <Clock class="w-4 h-4 text-amber-400" />
            <span>{post.readingTime || 15} phút đọc</span>
          </div>
        </div>

        {/* Badges Line */}
        <div class="flex flex-wrap items-center gap-3 mt-8 pt-4">
          <div class="flex items-center gap-2 text-xs sm:text-sm text-white font-medium bg-black/60 backdrop-blur-md px-3.5 py-2 border border-white/10 rounded-lg shadow-xl">
            <span class="text-amber-400 text-base">🏛️</span> Di Sản Thế Giới UNESCO (1987)
          </div>
          <div class="flex items-center gap-2 text-xs sm:text-sm text-white font-medium bg-black/60 backdrop-blur-md px-3.5 py-2 border border-white/10 rounded-lg shadow-xl">
            <span class="text-amber-400 text-base">👑</span> 24 Vị Hoàng Đế Minh – Thanh
          </div>
          <div class="flex items-center gap-2 text-xs sm:text-sm text-white font-medium bg-black/60 backdrop-blur-md px-3.5 py-2 border border-white/10 rounded-lg shadow-xl">
            <span class="text-amber-400 text-base">🏺</span> Hơn 1,8 Triệu Hiện Vật
          </div>
          <div class="flex items-center gap-2 text-xs sm:text-sm text-white font-medium bg-black/60 backdrop-blur-md px-3.5 py-2 border border-white/10 rounded-lg shadow-xl">
            <span class="text-amber-400 text-base">🎫</span> Đặt Vé Tên Thật Trước 7 Ngày
          </div>
        </div>

      </div>
    </section>

    {/* ================= MAIN CONTENT GRID ================= */}
    <div class="max-w-[1600px] mx-auto px-4 sm:px-6 lg:px-12 py-12 lg:py-16">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-start">

        {/* ---------------- LEFT SIDEBAR (TOC) ---------------- */}
        <aside class="hidden lg:block lg:col-span-3 sticky top-24">
          <div class="bg-white rounded-2xl shadow-sm border border-slate-200/60 p-6 overflow-hidden">
            <div class="flex items-center gap-2 font-bold text-slate-900 mb-5 border-l-4 border-amber-500 pl-3 text-sm tracking-wide uppercase">
              Mục lục bài viết
            </div>
            
            <nav class="space-y-1 text-[13.5px] font-medium max-h-[calc(100vh-200px)] overflow-y-auto pr-1">
              <a href="#gioi-thieu" class="flex items-center gap-2 text-amber-900 bg-amber-50/80 px-3 py-2 rounded-lg transition-colors font-bold">
                <span class="text-amber-600 text-base">🏠</span> Giới thiệu
              </a>
              
              <div class="pt-1.5 space-y-1 border-l border-slate-200 ml-3 pl-3">
                {toc.slice(1).map((item) => (
                  <a 
                    href={`#${item.id}`} 
                    class={`block transition-colors leading-tight py-1.5 text-slate-600 hover:text-amber-800 ${item.indent ? 'pl-2 text-[12.5px] border-l border-transparent hover:border-amber-400' : 'font-semibold text-[13px]'}`}
                  >
                    {item.title}
                  </a>
                ))}
              </div>
            </nav>
          </div>
        </aside>

        {/* ---------------- CENTER COLUMN (MAIN CONTENT) ---------------- */}
        <main class="col-span-1 lg:col-span-6 space-y-10">
          
          {/* Quick Overview Stats Bar */}
          <div class="bg-white rounded-2xl shadow-sm border border-slate-200/60 p-6 flex flex-wrap lg:flex-nowrap items-center justify-between gap-4">
            
            <div class="w-full flex items-center justify-between gap-4 mb-2 lg:hidden">
              <span class="font-bold text-slate-900 text-sm border-l-4 border-amber-500 pl-2 uppercase">Tổng Quan Nhanh</span>
            </div>

            <div class="flex items-center gap-3 w-[48%] lg:w-auto">
              <div class="w-10 h-10 rounded-full bg-amber-50 flex items-center justify-center text-amber-700 text-xl border border-amber-200/60 shrink-0">📍</div>
              <div>
                <div class="text-[11px] text-slate-500 font-medium">Vị trí</div>
                <div class="text-[13px] font-bold text-slate-900">Trung tâm Bắc Kinh</div>
              </div>
            </div>

            <div class="hidden lg:block w-px h-8 bg-slate-200"></div>

            <div class="flex items-center gap-3 w-[48%] lg:w-auto">
              <div class="w-10 h-10 rounded-full bg-blue-50 flex items-center justify-center text-blue-700 text-xl border border-blue-200/60 shrink-0">📐</div>
              <div>
                <div class="text-[11px] text-slate-500 font-medium">Quy mô diện tích</div>
                <div class="text-[13px] font-bold text-slate-900">Khoảng 720.000 m²</div>
              </div>
            </div>

            <div class="hidden lg:block w-px h-8 bg-slate-200"></div>

            <div class="flex items-center gap-3 w-[48%] lg:w-auto mt-2 lg:mt-0">
              <div class="w-10 h-10 rounded-full bg-emerald-50 flex items-center justify-center text-emerald-700 text-xl border border-emerald-200/60 shrink-0">👑</div>
              <div>
                <div class="text-[11px] text-slate-500 font-medium">Hoàng gia cư ngụ</div>
                <div class="text-[13px] font-bold text-slate-900">24 vị hoàng đế</div>
              </div>
            </div>

            <div class="hidden lg:block w-px h-8 bg-slate-200"></div>

            <div class="flex items-center gap-3 w-[48%] lg:w-auto mt-2 lg:mt-0">
              <div class="w-10 h-10 rounded-full bg-rose-50 flex items-center justify-center text-rose-700 text-xl border border-rose-200/60 shrink-0">🏆</div>
              <div>
                <div class="text-[11px] text-slate-500 font-medium">UNESCO</div>
                <div class="text-[13px] font-bold text-slate-900">Di sản Thế giới (1987)</div>
              </div>
            </div>
          </div>

          {/* Intro Text */}
          <div id="gioi-thieu" class="prose prose-slate max-w-none prose-p:leading-relaxed prose-p:text-[16px] prose-p:text-slate-700 space-y-4">
            <p>
              <strong>Tử Cấm Thành</strong> là một trong những biểu tượng quan trọng nhất của Bắc Kinh và là quần thể cung điện hoàng gia nổi tiếng nhất Trung Quốc. Trong hơn 500 năm, nơi đây là trung tâm quyền lực của triều đình nhà Minh và nhà Thanh, nơi ở của 24 vị hoàng đế cùng hoàng gia, đồng thời diễn ra những nghi lễ và sự kiện chính trị quan trọng của đế quốc Trung Hoa.
            </p>
            <p>
              Ngày nay, Tử Cấm Thành không còn là một “thành phố cấm” như tên gọi lịch sử. Quần thể này trở thành <strong><a href="https://intl.dpm.org.cn/" target="_blank" rel="noopener noreferrer" class="text-brand-700 hover:text-brand-800 underline underline-offset-2">Bảo tàng Cung điện Bắc Kinh (Palace Museum)</a></strong>, mở cửa cho du khách khám phá hệ thống cung điện, sân trong, vườn ngự uyển và bộ sưu tập đồ sộ của hoàng gia Trung Hoa.
            </p>
            <p>
              Tuy nhiên, Tử Cấm Thành rộng hơn nhiều so với cảm giác khi nhìn trên bản đồ. Nếu chỉ đi theo trục trung tâm, du khách có thể mất khoảng <strong>2–3 giờ</strong>; nếu muốn khám phá thêm các khu vực phía Đông, phía Tây và các phòng trưng bày, một buổi <strong>nửa ngày hoặc gần cả ngày</strong> sẽ phù hợp hơn. Bảo tàng Cung điện cũng chính thức cung cấp các tuyến tham quan 2 giờ, nửa ngày và một ngày để du khách lựa chọn.
            </p>
          </div>

          {/* Image Highlight */}
          <div class="my-8 space-y-4">
            <figure>
              <img 
                src="https://media.fittour.vn/uploads/hai-du-khach-mac-han-phuc-tu-cam-thanh.webp" 
                alt="Du khách FIT TOUR trải nghiệm Hán phục tại Tử Cấm Thành Bắc Kinh" 
                class="w-full h-auto rounded-2xl shadow-md border border-slate-200 object-cover" 
                width="1280" 
                height="720" 
                loading="lazy" 
              />
            </figure>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
              <img src="https://media.fittour.vn/uploads/han-phuc-hanh-lang-tu-cam-thanh-bac-kinh.webp" alt="Hành lang Tử Cấm Thành" class="w-full h-48 md:h-56 object-cover rounded-xl shadow-sm border border-slate-200" loading="lazy" />
              <img src="https://media.fittour.vn/uploads/han-phuc-tu-cam-thanh-bac-kinh.webp" alt="Chụp ảnh Hán phục" class="w-full h-48 md:h-56 object-cover rounded-xl shadow-sm border border-slate-200" loading="lazy" />
              <img src="https://media.fittour.vn/uploads/han-phuc-tu-cam-thanh-check-in-bac-kinh.webp" alt="Check-in Tử Cấm Thành" class="w-full h-48 md:h-56 object-cover rounded-xl shadow-sm border border-slate-200" loading="lazy" />
            </div>
            <div class="text-center text-sm text-slate-500 mt-2 italic">
              Không gian nguy nga, cổ kính với tường đỏ mái ngói vàng là bối cảnh lý tưởng để trải nghiệm Hán phục
            </div>
          </div>

          {/* Section 1: Tử Cấm Thành Là Gì */}
          <section id="tu-cam-thanh-la-gi" class="scroll-mt-28 space-y-4">
            <div class="border-l-4 border-amber-500 pl-4 mb-4">
              <h2 class="font-serif text-2xl lg:text-[26px] font-bold text-slate-900 leading-tight">
                Tử Cấm Thành Là Gì?
              </h2>
            </div>
            
            <div class="text-slate-700 text-[15.5px] leading-relaxed space-y-4">
              <p>
                Tử Cấm Thành, tiếng Trung là <strong>故宫 (Gùgōng)</strong> hoặc <strong>紫禁城 (Zǐjìnchéng)</strong>, nằm ở trung tâm Bắc Kinh, ngay phía bắc Quảng trường Thiên An Môn. Tên tiếng Anh phổ biến là <em>Forbidden City</em>, trong khi tên chính thức của bảo tàng hiện nay là <em>Palace Museum</em> – Bảo tàng Cung điện.
              </p>
              <p>
                Công trình được xây dựng dưới thời <strong>Hoàng đế Vĩnh Lạc</strong>, bắt đầu từ năm 1406 và hoàn thành cơ bản vào năm 1420. Trong hơn năm thế kỷ tiếp theo, Tử Cấm Thành là nơi ở và trung tâm quyền lực của <strong>14 hoàng đế nhà Minh và 10 hoàng đế nhà Thanh, tổng cộng 24 vị hoàng đế</strong>. Sau khi chế độ quân chủ kết thúc, Tử Cấm Thành trở thành bảo tàng và chính thức mở cửa cho công chúng vào năm 1925.
              </p>
              <p>
                Năm 1987, Tử Cấm Thành được UNESCO ghi danh vào Danh sách Di sản Thế giới với tên gọi <em><a href="https://whc.unesco.org/en/list/439" target="_blank" rel="noopener noreferrer" class="text-brand-700 hover:text-brand-800 underline underline-offset-2">Imperial Palaces of the Ming and Qing Dynasties in Beijing and Shenyang</a></em>. UNESCO đánh giá đây là một trong những quần thể cung điện hoàng gia tiêu biểu nhất thế giới, đồng thời là hình mẫu quan trọng trong sự phát triển của kiến trúc cung điện Trung Hoa.
              </p>
              <p>
                Ngày nay, phần Bắc Kinh của di sản này chính là Bảo tàng Cung điện mà du khách thường gọi là Tử Cấm Thành.
              </p>
            </div>
          </section>

