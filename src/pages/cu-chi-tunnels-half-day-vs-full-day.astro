---
import { env } from 'cloudflare:workers';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { safeQueryCritical } from '@/lib/db-client';
import { getGlobalSettings } from '@/lib/settingsHelper';
import JsonLdSchema from '@/components/seo/JsonLdSchema.astro';

export const prerender = false;

const currentSlug = 'cu-chi-tunnels-half-day-vs-full-day';

// Fetch post from D1 database with fallback
const d1Db = env?.dulichcoguu_d1 || (Astro.locals as any)?.runtime?.env?.dulichcoguu_d1;
let post: any = null;
try {
  if (d1Db) {
    post = await safeQueryCritical(
      d1Db.prepare("SELECT * FROM Post WHERE slug = ? AND (status = 'published' OR status = 'publish')").bind(currentSlug).first<any>(),
      { route: Astro.url.pathname, slug: currentSlug, queryType: "fetch_post_by_slug" }
    );
  }
} catch (e) {
  console.warn('[D1 Query Warning] cu-chi-tunnels-half-day-vs-full-day:', e);
}

// Fallback metadata
if (!post) {
  post = {
    id: 19810,
    title: 'Cu Chi Tunnels Half-Day Vs Full-Day: Which Tour Should You Choose?',
    slug: currentSlug,
    description: 'Compare half-day and full-day Cu Chi Tunnels tours: realistic 2026 durations, physical effort, combination options with Saigon landmarks, and an honest decision framework.',
    featuredImage: 'https://media.thericetour.com/uploads/tour-group-listening-briefing-underground-hall-cu-chi-tunnels.webp',
    publishedAt: '2026-09-17T12:00:00.000Z',
    updatedAt: '2026-09-17T15:15:00.000Z',
    readingTime: 24,
    author: 'The Rice Tour Editorial',
    tags: JSON.stringify(['Cu Chi Tunnels', 'Ho Chi Minh City', 'Vietnam Travel Guide', 'Half Day vs Full Day', 'Saigon Tours'])
  };
}

const pageTitle = post.title || 'Cu Chi Tunnels Half-Day Vs Full-Day: Which Tour Should You Choose?';
const pageDesc = post.description || 'Compare half-day and full-day Cu Chi Tunnels tours: realistic 2026 durations, physical effort, combination options with Saigon landmarks, and an honest decision framework.';
const seoTitle = `${pageTitle} | The Rice Tour`;
const seoDesc = pageDesc;
const seoImage = post.featuredImage || 'https://media.thericetour.com/uploads/tour-group-listening-briefing-underground-hall-cu-chi-tunnels.webp';

// Author & Date Formatting
const displayDate = post.updatedAt ? new Date(post.updatedAt) : (post.publishedAt ? new Date(post.publishedAt) : new Date());
const formattedDate = displayDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
});
const datePrefix = post.updatedAt ? 'Updated on' : 'Published on';
const createdAtStr = post.publishedAt ? new Date(post.publishedAt).toISOString() : new Date().toISOString();
const updatedAtStr = post.updatedAt ? new Date(post.updatedAt).toISOString() : createdAtStr;

const authorMap: Record<string, { name: string; role: string; img: string; url: string }> = {
  "The Rice Tour Editorial": {
    name: "The Rice Tour Editorial",
    role: "Inbound Travel Specialist",
    img: "https://media.thericetour.com/uploads/the-rice-tour-editorial.webp",
    url: "/author/the-rice-tour-editorial"
  },
  "Hieu Huynh": {
    name: "Hieu Huynh",
    role: "Founder & Indochina Cultural Guide",
    img: "https://media.thericetour.com/uploads/author-hieu-huynh.webp",
    url: "/author/hieu-huynh"
  }
};
const authorData = authorMap[post.author] || authorMap["The Rice Tour Editorial"];

// --- TABLE OF CONTENTS (TOC) ---
const tocItems = [
  { id: "gioi-thieu", title: "Introduction" },
  { id: "quick-decision", title: "Half-Day vs. Full-Day: The Quick Decision" },
  { id: "three-formats", title: "The Three Ways to Experience Cu Chi" },
  { id: "tour-durations", title: "How Long Does A Cu Chi Tour Actually Take?" },
  { id: "full-day-underground-fallacy", title: "A Full Day Does Not Mean More Time Underground" },
  { id: "what-happens-half-day", title: "What Do You Do On A Half-Day Visit?" },
  { id: "why-choose-half-day", title: "Why Choose A Half-Day Cu Chi Tour?" },
  { id: "what-is-full-day", title: "What Is A Full-Day Cu Chi Itinerary?" },
  { id: "is-full-day-worth-it", title: "Is A Full-Day Tour Worth It?" },
  { id: "what-to-combine", title: "What Can You Combine With Cu Chi?" },
  { id: "decision-matrix", title: "Half-Day vs. Full-Day Comparison Overview" },
  { id: "what-you-pay-for", title: "What Are You Paying For With Full-Day?" },
  { id: "physical-effort", title: "Physical Effort & Who Should Skip The Crawl?" },
  { id: "why-guide-matters", title: "Why The Guide Can Matter More Than Tour Length" },
  { id: "ben-dinh-vs-ben-duoc", title: "Ben Dinh vs. Ben Duoc: History, Not Real vs. Fake" },
  { id: "morning-vs-afternoon", title: "Half-Day Morning vs. Half-Day Afternoon" },
  { id: "combining-with-mekong", title: "Should You Combine Cu Chi & Mekong Delta?" },
  { id: "shared-vs-diy", title: "Tour Formats: Shared, Small Group, Grab & Bus" },
  { id: "decision-tree", title: "A Simple 7-Question Decision Tree" },
  { id: "sample-schedules", title: "Sample Half-Day & Full-Day Schedules" },
  { id: "heritage-update-2026", title: "2026 Heritage Update & UNESCO Chronology" },
  { id: "recommended-tours", title: "Recommended Cu Chi Experiences" },
  { id: "frequently-asked-questions", title: "Frequently Asked Questions (FAQ)" },
  { id: "conclusion", title: "The Verdict: Main Event Or One Chapter?" }
];

// SSR JSON-LD Schemas
const currentOrigin = 'https://thericetour.com';
const canonicalUrl = `${currentOrigin}/${currentSlug}`;

const breadcrumbSchema = {
  items: [
    { name: "Home", url: `${currentOrigin}/` },
    { name: "Travel Guides", url: `${currentOrigin}/blog` },
    { name: pageTitle, url: canonicalUrl }
  ]
};

const faqSchema = {
  questions: [
    {
      question: "How long does a half-day Cu Chi Tunnels tour take door-to-door?",
      answer: "A typical half-day tour requires approximately 5 to 6 hours door-to-door from central Ho Chi Minh City. This includes roughly 1.5 to 2 hours of driving each way and 2 to 2.5 hours on-site exploring the historical grounds."
    },
    {
      question: "Is a full-day Cu Chi tour worth the extra hours?",
      answer: "A full-day tour is worth it if you specifically want to pair Cu Chi with major downtown landmarks like the Independence Palace or War Remnants Museum with transportation arranged for the entire day. It is not worth it if you only want to see the tunnels, as actual time spent at Cu Chi is virtually identical on both formats."
    },
    {
      question: "Should I visit Cu Chi in the morning or the afternoon?",
      answer: "Arriving close to opening time (around 07:30–08:00 AM) is one of the more reliable ways to reduce exposure to later-arriving tour groups and avoid midday heat. Afternoon visits can be quieter after some morning groups leave, but crowd levels vary by day and season, and the return drive coincides with peak evening rush hour."
    },
    {
      question: "Can you combine Cu Chi Tunnels and the Mekong Delta in one day?",
      answer: "While commercially advertised, combining Cu Chi and the Mekong Delta in one day requires 6.5 to 7.5 hours of driving across 200+ km of congested roads. We strongly recommend dedicating Cu Chi to a half-day morning trip and exploring the Mekong Delta on a separate day."
    },
    {
      question: "How much is official admission to Cu Chi Tunnels in 2026?",
      answer: "The official foreign-visitor tariff is 135,000 VND per person (comprising 35,000 VND gate admission and 100,000 VND for site guide and heritage service)."
    },
    {
      question: "Do I have to crawl through the tunnels?",
      answer: "No. Entering the underground tunnels is completely optional. Taller or larger travelers may find the adapted tunnels surprisingly restrictive, while anyone uncomfortable with confined spaces or strenuous movement can simply remain above ground to view open-air exhibits, trapdoor demonstrations, and reconstructed bunkers."
    },
    {
      question: "Which sector should I choose: Ben Dinh or Ben Duoc?",
      answer: "Ben Dinh is closer to Saigon (~50 km) and is the more commonly visited site due to easier tour bus access. Ben Duoc is located further away (~70 km) and offers a different historical presentation, including the Ben Duoc Memorial Temple and former regional military command headquarters. Both sites feature visitor tunnels adapted for tourism, and UNESCO recognizes both as the two sections that best preserve the original appearance, scale, and structure of the network."
    },
    {
      question: "Is Cu Chi Tunnels recognized by UNESCO?",
      answer: "On July 15, 2026, Viet Nam submitted Cu Chi Tunnels to the UNESCO World Heritage Tentative List under criteria (iv) and (vi). It is not currently inscribed on the UNESCO World Heritage List. By 2025, the site had received more than 27 million domestic and international visitors."
    }
  ]
};

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": pageTitle,
  "description": pageDesc,
  "image": seoImage,
  "datePublished": createdAtStr,
  "dateModified": updatedAtStr,
  "author": {
    "@type": "Person",
    "name": authorData.name,
    "url": `${currentOrigin}${authorData.url}`
  },
  "publisher": {
    "@type": "Organization",
    "name": "The Rice Tour",
    "logo": {
      "@type": "ImageObject",
      "url": "https://media.thericetour.com/uploads/logo-the-rice.webp"
    }
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": canonicalUrl
  }
};
---

<BaseLayout 
  title={seoTitle} 
  description={seoDesc} 
  image={seoImage}
  canonical={canonicalUrl}
  preloadImages={[seoImage]}
  adminEditUrl={post?.id ? `/admin/posts/edit/${post.id}` : undefined}
  lang="en"
  ogType="article"
>
  <Fragment slot="schema">
    <JsonLdSchema type="breadcrumb" data={breadcrumbSchema} />
    <JsonLdSchema type="custom" data={articleSchema} />
    <JsonLdSchema type="faq" data={faqSchema} />
  </Fragment>

  <!-- HERO SECTION HEADER (Full-width, Dark Magazine Style) -->
  <header class="relative bg-slate-950 text-white pt-28 pb-20 md:pt-36 md:pb-28 overflow-hidden">
    <!-- Background Image with Multi-layer Gradients -->
    <div class="absolute inset-0 z-0">
      <img 
        src={seoImage} 
        alt={pageTitle}
        class="w-full h-full object-cover object-center brightness-75 scale-105 transform motion-safe:animate-subtle-zoom"
        loading="eager"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/75 to-slate-950/40"></div>
      <div class="absolute inset-0 bg-gradient-to-r from-slate-950/90 via-slate-950/50 to-transparent"></div>
    </div>

    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Breadcrumbs -->
      <nav class="flex items-center gap-2 text-xs sm:text-sm text-slate-300/80 mb-6" aria-label="Breadcrumb">
        <a href="/" class="hover:text-white transition-colors">Home</a>
        <span>/</span>
        <a href="/blog" class="hover:text-white transition-colors">Travel Guides</a>
        <span>/</span>
        <span class="text-amber-400 font-medium truncate max-w-xs sm:max-w-md">{pageTitle}</span>
      </nav>

      <!-- Main Title -->
      <h1 class="font-serif text-3xl sm:text-4xl lg:text-5xl xl:text-6xl font-bold text-white mb-4 leading-[1.15] drop-shadow-lg max-w-5xl">
        {pageTitle}
      </h1>

      <!-- Subtitle -->
      <h2 class="font-serif text-lg sm:text-2xl lg:text-3xl text-amber-400 italic mb-8 max-w-4xl drop-shadow-md font-medium">
        An honest comparison of door-to-door transit times, on-site pacing, city landmark pairings, and travel effort.
      </h2>

      <!-- Lead Paragraph -->
      <p class="text-white/90 text-base sm:text-lg max-w-3xl leading-relaxed mb-8 hidden md:block drop-shadow-md font-normal">
        A visit to the Cu Chi Tunnels can take half a day or become part of a full day of sightseeing in and around Ho Chi Minh City. The decision is not about which format is universally superior, but whether you want Cu Chi to be the main experience of your day or one part of a broader Ho Chi Minh City itinerary.
      </p>

      <!-- Author Meta Row -->
      <div class="flex flex-wrap items-center gap-6 pt-4 border-t border-white/15 text-sm text-slate-300">
        <div class="flex items-center gap-3">
          <img 
            src={authorData.img} 
            alt={authorData.name} 
            class="w-10 h-10 rounded-full border-2 border-amber-400 object-cover shadow-sm"
          />
          <div>
            <div class="font-semibold text-white flex items-center gap-1.5">
              {authorData.name}
              <svg class="w-4 h-4 text-amber-400" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
              </svg>
            </div>
            <div class="text-xs text-slate-300/80">Inbound Travel Specialist</div>
          </div>
        </div>

        <div class="flex items-center gap-4 text-xs sm:text-sm text-slate-300/90 ml-auto">
          <span>{datePrefix} <time datetime={displayDate.toISOString()}>{formattedDate}</time></span>
          <span>•</span>
          <span>{post.readingTime || 24} min read</span>
          <span>•</span>
          <span class="inline-flex items-center gap-1 text-emerald-400 font-medium">
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span> 2026 Verified
          </span>
        </div>
      </div>

      <!-- Feature Badges -->
      <div class="flex flex-wrap gap-2.5 mt-6 pt-4 border-t border-white/10">
        <span class="bg-black/60 backdrop-blur-md px-3.5 py-2 border border-white/10 rounded-lg shadow-xl text-xs sm:text-sm text-white font-medium">
          ⏱️ Half-Day (5–6 hrs) vs. Full-Day (8–10 hrs)
        </span>
        <span class="bg-black/60 backdrop-blur-md px-3.5 py-2 border border-white/10 rounded-lg shadow-xl text-xs sm:text-sm text-white font-medium">
          🏛️ City Landmark Combinations
        </span>
        <span class="bg-black/60 backdrop-blur-md px-3.5 py-2 border border-white/10 rounded-lg shadow-xl text-xs sm:text-sm text-white font-medium">
          ⚖️ Pacing & Physical Demands
        </span>
        <span class="bg-black/60 backdrop-blur-md px-3.5 py-2 border border-white/10 rounded-lg shadow-xl text-xs sm:text-sm text-white font-medium">
          🚫 Mekong Combo Reality Check
        </span>
      </div>
    </div>
  </header>

  <!-- 3-COLUMN MAGAZINE LAYOUT CONTAINER -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-16">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start">

      <!-- LEFT COLUMN: Sticky Table of Contents -->
      <aside class="hidden lg:block lg:col-span-3 sticky top-24">
        <div class="bg-white rounded-2xl shadow-sm border border-slate-200/80 p-5 max-h-[calc(100vh-7rem)] overflow-y-auto custom-scrollbar">
          <div class="flex items-center gap-2 font-bold text-slate-900 mb-4 border-l-4 border-amber-500 pl-3 text-xs tracking-wider uppercase">
            Table of Contents
          </div>
          <nav class="space-y-1 text-[13px] font-medium pr-1">
            <a href="#gioi-thieu" class="block text-amber-900 bg-amber-50/80 px-3 py-2 rounded-lg transition-colors font-bold text-[13.5px]">
              Introduction
            </a>
            
            <div class="pt-1.5 space-y-1 border-l border-slate-200 ml-3 pl-3">
              {tocItems.slice(1).map((item) => (
                <a 
                  href={`#${item.id}`} 
                  class="block py-1.5 px-2 text-slate-600 hover:text-amber-900 hover:bg-slate-50 rounded transition-colors truncate"
                  title={item.title}
                >
                  {item.title}
                </a>
              ))}
            </div>
          </nav>
        </div>
      </aside>

      <!-- CENTER COLUMN: Editorial Content -->
      <main class="col-span-1 lg:col-span-6 space-y-12">

        <!-- Executive Summary Cards -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
          <div class="p-3 rounded-xl bg-slate-50 border border-slate-100">
            <div class="text-xl sm:text-2xl mb-1">⏱️</div>
            <div class="text-[11px] uppercase tracking-wider text-slate-400 font-semibold">Half-Day</div>
            <div class="text-sm sm:text-base font-bold text-slate-900 mt-0.5">5 to 6 hrs</div>
          </div>
          <div class="p-3 rounded-xl bg-slate-50 border border-slate-100">
            <div class="text-xl sm:text-2xl mb-1">🏛️</div>
            <div class="text-[11px] uppercase tracking-wider text-slate-400 font-semibold">Full-Day</div>
            <div class="text-sm sm:text-base font-bold text-slate-900 mt-0.5">8 to 10 hrs</div>
          </div>
          <div class="p-3 rounded-xl bg-slate-50 border border-slate-100">
            <div class="text-xl sm:text-2xl mb-1">🎯</div>
            <div class="text-[11px] uppercase tracking-wider text-slate-400 font-semibold">Tunnel Site Time</div>
            <div class="text-sm sm:text-base font-bold text-slate-900 mt-0.5">2 to 2.5 hrs</div>
          </div>
          <div class="p-3 rounded-xl bg-slate-50 border border-slate-100">
            <div class="text-xl sm:text-2xl mb-1">🎟️</div>
            <div class="text-[11px] uppercase tracking-wider text-slate-400 font-semibold">Foreign Tariff</div>
            <div class="text-sm sm:text-base font-bold text-slate-900 mt-0.5">135,000 VND</div>
          </div>
        </div>

        <!-- Article Content Starts -->
        <article class="space-y-12 text-slate-800 leading-relaxed font-normal">

          <!-- Section: Introduction -->
          <section id="gioi-thieu" class="scroll-mt-28 space-y-4">
            <div class="text-slate-700 text-[16px] sm:text-[17px] leading-relaxed space-y-4">
              <p>
                A visit to the Cu Chi Tunnels can take half a day or become part of a full day of sightseeing in and around Ho Chi Minh City.
              </p>
              <p>
                For many travelers, the most practical approach is to visit Cu Chi in the early morning and return to the city with the entire afternoon free to relax or explore independently. For others, it makes more sense to consolidate their sightseeing by pairing Cu Chi with central metropolitan landmarks like the <a href="/independence-palace-saigon-guide" class="text-amber-800 hover:text-amber-900 font-semibold underline underline-offset-2 decoration-amber-300">Independence Palace</a>, the War Remnants Museum, or the historic Saigon Central Post Office.
              </p>
              <p>
                Neither format is universally superior.
              </p>
              <p>
                The real question is how much time you have, how much road travel you are comfortable with, who you are traveling with, and whether you want Cu Chi to be the main experience of the day or one part of a broader Ho Chi Minh City itinerary.
              </p>
              <p>
                This comprehensive guide evaluates half-day and full-day Cu Chi itineraries across real-world door-to-door transit times, on-site pacing, physical demands, logistics, and day-trip combination feasibility.
              </p>

              {/* Callout Quote */}
              <blockquote class="border-l-4 border-amber-500 pl-4 py-3 my-6 bg-amber-50/60 rounded-r-xl italic text-slate-800 font-serif text-[16.5px]">
                "A private tour does not eliminate the highway miles between District 1 and Cu Chi, but choosing between a half-day and full-day itinerary determines whether your day feels like an immersive morning excursion or an exhaustive 10-hour marathon."
              </blockquote>

              {/* Featured Image inside Body */}
              <div class="my-6 not-prose">
                <div class="rounded-2xl overflow-hidden shadow-md border border-slate-200">
                  <img 
                    src="https://media.thericetour.com/uploads/tour-group-listening-briefing-underground-hall-cu-chi-tunnels.webp" 
                    alt="Tour group listening attentively to a historical briefing in an underground pavilion at Cu Chi Tunnels - The Rice Tour" 
                    class="w-full h-auto object-cover max-h-[500px]"
                    width="1280"
                    height="720"
                    loading="eager"
                  />
                </div>
                <p class="text-center text-xs sm:text-sm text-slate-500 italic mt-2.5">
                  Tour groups attending an introductory briefing in an open-air forested pavilion before exploring the historical tunnel sectors.
                </p>
              </div>

              {/* UNESCO Milestone Callout Box */}
              <div class="bg-amber-50/70 border border-amber-300/80 p-5 rounded-2xl my-6 not-prose">
                <div class="flex items-center gap-2.5 text-amber-900 font-bold text-sm sm:text-base mb-2">
                  <span class="text-lg">🏛️</span> UNESCO World Heritage Milestone: Over 27 Million Visitors
                </div>
                <p class="text-xs sm:text-sm text-amber-950/90 leading-relaxed mb-3">
                  On July 15, 2026, Viet Nam officially submitted the Cu Chi Tunnels complex to the <strong>UNESCO World Heritage Tentative List</strong> under cultural criteria <em>(iv)</em> and <em>(vi)</em>. It is not currently inscribed on the UNESCO World Heritage List. By 2025, the site had received more than 27 million domestic and international visitors. UNESCO identifies Ben Duoc and Ben Dinh as the two sectors that best retain the original appearance, scale, and structure of the wider tunnel system.
                </p>
                <div class="bg-white/85 border border-amber-200/80 rounded-xl p-3.5 space-y-1.5 text-xs text-amber-950">
                  <div class="font-bold text-slate-900 uppercase tracking-wider text-[11px] mb-1">Key Chronological Milestones:</div>
                  <div class="grid sm:grid-cols-2 gap-2 text-[11.5px]">
                    <div><strong>• 1946 onward:</strong> Early tunnel and shelter systems emerged in Cu Chi</div>
                    <div><strong>• 1961–1965:</strong> Network significantly expanded into multi-level defenses</div>
                    <div><strong>• 1975 onward:</strong> Surviving sections protected and conserved</div>
                    <div><strong>• 1991:</strong> ~4 km restored, enhanced and opened to public presentation</div>
                  </div>
                </div>
              </div>
            </div>
          </section>

          <!-- Section: Quick Decision -->
          <section id="quick-decision" class="scroll-mt-28 space-y-5">
            <div class="border-l-4 border-amber-500 pl-4 mb-4">
              <h2 class="font-serif text-2xl lg:text-[26px] font-bold text-slate-900 leading-tight">
                Half-Day Or Full-Day: The Quick Decision
              </h2>
            </div>

            <div class="text-slate-700 text-[15.5px] leading-relaxed space-y-4">
              <p>
                If you are pressed for time, use this diagnostic summary to identify the format that best fits your travel party:
              </p>

              <div class="grid sm:grid-cols-2 gap-4 my-6 not-prose">
                <div class="p-5 rounded-2xl border border-amber-200 bg-amber-50/50 shadow-xs space-y-3">
                  <div class="font-bold text-amber-950 text-base flex items-center gap-2">
                    <span>⚡</span> Choose A Half-Day Tour If You:
                  </div>
                  <ul class="text-xs sm:text-[13px] text-amber-900 space-y-2 list-disc pl-4 leading-relaxed">
                    <li><strong>Want Cu Chi to be the main destination:</strong> You prefer dedicating focused energy to the tunnels without cramming secondary stops into the afternoon.</li>
                    <li><strong>Value having your afternoon free:</strong> You want time to rest at your hotel, explore cafés, or browse <a href="/things-to-do-near-ben-thanh-market" class="font-semibold underline underline-offset-2">things to do near Ben Thanh Market</a>.</li>
                    <li><strong>Are traveling with young kids or elderly relatives:</strong> Half-day itineraries significantly reduce heat fatigue and vehicle time.</li>
                    <li><strong>Prefer a flexible, spontaneous pace:</strong> You dislike rigid schedules and want the freedom to decide your afternoon on a whim.</li>
                    <li><strong>Have only 2 to 3 days in Saigon:</strong> A morning excursion leaves the afternoon open for independent urban exploration.</li>
                  </ul>
                </div>

                <div class="p-5 rounded-2xl border border-slate-200 bg-white shadow-xs space-y-3">
                  <div class="font-bold text-slate-900 text-base flex items-center gap-2">
                    <span>🏛️</span> Choose A Full-Day Tour If You:
                  </div>
                  <ul class="text-xs sm:text-[13px] text-slate-600 space-y-2 list-disc pl-4 leading-relaxed">
                    <li><strong>Want an all-inclusive sightseeing day:</strong> You have exactly one day for touring and want private transport arranged from morning to late afternoon.</li>
                    <li><strong>Want to combine war history perspectives:</strong> Pairing Cu Chi with the War Remnants Museum and Independence Palace creates a broader historical context connecting rural guerrilla warfare with downtown political history.</li>
                    <li><strong>Are comfortable with longer road time:</strong> You understand that crossing metropolitan Ho Chi Minh City involves 3 to 4+ hours in the car.</li>
                    <li><strong>Want an evening river experience:</strong> You want to conclude your day with dinner or an evening cruise along the Saigon River.</li>
                  </ul>
                </div>
              </div>
            </div>
          </section>

