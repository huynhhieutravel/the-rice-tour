# Cloudflare Cache Strategy

# Cache static assets (images, fonts, CSS, JS) for 1 year by default
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/images/*
  Cache-Control: public, max-age=31536000, immutable

/scripts/*
  Cache-Control: public, max-age=31536000, immutable

/brand-fittour/*
  Cache-Control: public, max-age=31536000, immutable

# Do not aggressively cache text configuration files
/robots.txt
  Cache-Control: public, max-age=3600

/llms.txt
  Cache-Control: public, max-age=3600

# Dynamic pages (SSR) should have different caching depending on their logic
# But for SSG pages, we can let Cloudflare cache them.
/
  Cache-Control: public, max-age=3600, s-maxage=86400

/blog/*
  Cache-Control: public, max-age=3600, s-maxage=86400

/tour/*
  Cache-Control: public, max-age=3600, s-maxage=86400

# Do not cache admin panel and preview modes
/admin/*
  Cache-Control: no-store, no-cache, must-revalidate, proxy-revalidate

/preview-post/*
  Cache-Control: no-store, no-cache, must-revalidate, proxy-revalidate
